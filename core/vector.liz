import "../dev/common";
v4 : struct
{
	x : f32,
	y : f32,
	z : f32,
	w : f32,
}
v3 : struct
{
	x : f32,
	y : f32,
	z : f32,
}
mat4x4 : struct
{
	vals : [4 * 4] f32,
}
quaternion : struct
{
	v : _vec
}
// Finds a perpendicular vector using swap-negate-smallest-components
findPerpendicularVector::fn(n : *_vec) ! _vec
{
    // Step 1: Find the two smallest absolute components
    max_axis:u8 = 0
	max_val:= n.x


    if absf(*ptr_offset(n, 1, f32)) > max_val
	{
		max_val = n.y
		max_axis = 1
    }
    if absf(*ptr_offset(n, 2, f32)) > max_val
	{
		max_val = n.z
		max_axis = 2
    }


	ret : _vec
	on max_axis
	{
	0
	{
		ret.x = -n.z
		ret.z = n.x
	}
	1
	{
		ret.y = -n.x
		ret.x = n.y
	}
	2
	{
		ret.z = -n.y
		ret.y = n.z
	}
	}
	return ret
}
normalize_quaternion::fn(out : *_vec, q : *_vec) {

    mag := sqrt(q.w*q.w + q.x*q.x + q.y*q.y + q.z*q.z)
	if mag == 0.0
	{
		out.x = 1.0
		out.y = 0.0
		out.z = 0.0
		out.w = 0.0
	}
	else
	{
		out.x = q.x/mag
		out.y = q.y/mag
		out.z = q.z/mag
		out.w = q.w/mag
	}
}

quaternion_conjugate::fn(out : *_vec, q : *_vec) { 
    out.x = -q.x
	out.y = -q.y
	out.z = -q.z
	out.w = q.w
}

multiply_quaternions::fn x64(out : *_vec, q1 : *_vec, q2 : *_vec) {
	out.x = q1.w*q2.x + q1.x*q2.w + q1.y*q2.z - q1.z*q2.y
	out.y = q1.w*q2.y - q1.x*q2.z + q1.y*q2.w + q1.z*q2.x
	out.z = q1.w*q2.z + q1.x*q2.y - q1.y*q2.x + q1.z*q2.w
	out.w = q1.w*q2.w - q1.x*q2.x - q1.y*q2.y - q1.z*q2.z 
}

rotate_vector::fn(out : *_vec, v : *_vec, q : *_vec) {
	aux : _vec
    normalize_quaternion(&aux, q)
    p :_vec
	p.x = v.x
	p.y = v.y
	p.z = v.z
	p.w = 0.0
    q_conj:_vec
    rotated:_vec
    mul:_vec
	quaternion_conjugate(&q_conj, q);

	multiply_quaternions(&mul, q, &p)

    multiply_quaternions(&rotated, &mul, &q_conj);
    out.x = rotated.x
	out.y = rotated.y
	out.z = rotated.z

}
PI :const f32= 3.141592
// Helper function to convert degrees to radians
RAD_TO_DEG :const f32= 57.295779
radians_to_degree::fn macro(x : _expr)
{
    (x * RAD_TO_DEG)
}
degrees_to_radians::fn macro(x : _expr)
{
    (x * PI / 180.0)
}

quaternion_to_euler::fn(q : *_vec) ! _vec
{
    angles : _vec=?;

    // roll (x-axis rotation)
    sinr_cosp := 2.0 * (q.w * q.x + q.y * q.z);
    cosr_cosp:= 1.0 - 2.0 * (q.x * q.x + q.y * q.y);
    angles.x = atan2(sinr_cosp, cosr_cosp);

    // pitch (y-axis rotation)
    sinp := sqrt(1.0 + 2.0 * (q.w * q.y - q.x * q.z));
    cosp := sqrt(1.0 - 2.0 * (q.w * q.y - q.x * q.z));
    angles.y = 2.0 * atan2(sinp, cosp) - PI / 2.0;

    // yaw (z-axis rotation)
    siny_cosp := 2.0 * (q.w * q.z + q.x * q.y);
    cosy_cosp := 1.0 - 2.0 * (q.y * q.y + q.z * q.z);
    angles.z = atan2(siny_cosp, cosy_cosp);

    return angles;
}

euler_to_quaternion::fn(x:f32, y:f32, z:f32) !quaternion
{
	x = degrees_to_radians(x)
	y = degrees_to_radians(y)
	z = degrees_to_radians(z)
	ret : quaternion
    cr := cos(x * 0.5);
    sr := sin(x * 0.5);
    cp := cos(y * 0.5);
    sp := sin(y * 0.5);
    cy := cos(z * 0.5);
    sy := sin(z * 0.5);

	//__dbg_break
    q:= &ret.v;
    q.x = sr * cp * cy - cr * sp * sy;
    q.y = cr * sp * cy + sr * cp * sy;
    q.z = cr * cp * sy - sr * sp * cy;
    q.w = cr * cp * cy + sr * sp * sy;
    
    return ret;
}
sign ::fn(f : f32) ! f32
{
	if f < 0.0 return -1.0;
	return 1.0;
}
create_from_axis_angle::fn(xx:f32, yy:f32, zz:f32, a:f32) ! quaternion
{
	q : quaternion=?
    // Here we calculate the sin( theta / 2) once for optimization
    factor:f32 = sin( a / 2.0 );

    // Calculate the x, y and z of the quaternion
    q.v.x = xx * factor;
    q.v.y = yy * factor;
    q.v.z = zz * factor;

    // Calcualte the w value by cos( theta / 2 )
    q.v.w = cos( a / 2.0 );
	normalize_quaternion(&q.v, &q.v)
    return q
}
angle_on_axis::fn(a : *_vec, b : *_vec, ref_up : *_vec) ! f32
{
	from := *a
	to := *b

	from -= *ref_up * dot_vec(ref_up, &from)
	if dot_vec(&from, &from) < 0.00001
	{
		return 0.0
	}
	to -= *ref_up * dot_vec(ref_up, &to)

	from = normalize_vec(&from)
	to = normalize_vec(&to)
	 

	up := cross_vec(&from, &to)
	lenght := dot_vec(&up, &up)

	dot := dot_vec(&to, &from)
	if lenght <= 0.00001
	{
		if dot <= -0.99999
		{
			return -PI;
		}
		else
			return 0.0;
	}

	right := cross_vec(&from, ref_up)
	dir := dot_vec(&to, &right)

	return acos(dot) * -sign(dir)
}
look_at_quaternion::fn(a : *_vec, b : *_vec, ref_up : *_vec) ! quaternion
{
	ret : quaternion
	ret.v.w = 1.0


	// General case
    axis := cross_vec(a, b)
    axis_len := len_vec(&axis)
    
    if axis_len < 0.0001 {
        // Vectors are parallel (handled above) or invalid
        return ret
    }
    
    // Normalize axis
    axis = normalize_vec(&axis)
    
    // Calculate angle
    cos_theta := dot_vec(a, b)
    angle := acos(cos_theta)
    
    // Build quaternion
    half_angle := angle * 0.5
    s := sin(half_angle)
	ret.v.w = cos(half_angle);
	ret.v.x = axis.x * s
	ret.v.y = axis.y * s
	ret.v.z = axis.z * s

	return ret
}
build_model_matrix ::fn x64(out_matrix : *f32, position : *_vec, q : *f32, scale : *_vec) 
{
	// Extract quaternion components using ptr_offset
    x := *ptr_offset(q, 0, f32)
    y := *ptr_offset(q, 1, f32)
    z := *ptr_offset(q, 2, f32)
    w := *ptr_offset(q, 3, f32)
    
    // Calculate quaternion products
    x2 := x + x
    y2 := y + y
    z2 := z + z
    xx := x * x2
    xy := x * y2
    xz := x * z2
    yy := y * y2
    yz := y * z2
    zz := z * z2
    wx := w * x2
    wy := w * y2
    wz := w * z2
    
    // Apply scale
    sx := scale.x
    sy := scale.y
    sz := scale.z
    
    // First column (becomes first row in row-major)
    *ptr_offset(out_matrix, 0, f32) = (1.0 - (yy + zz)) * sx
    *ptr_offset(out_matrix, 1, f32) = (xy - wz) * sy
    *ptr_offset(out_matrix, 2, f32) = (xz + wy) * sz
    *ptr_offset(out_matrix, 3, f32) = position.x
    
    // Second column (becomes second row in row-major)
    *ptr_offset(out_matrix, 4, f32) = (xy + wz) * sx
    *ptr_offset(out_matrix, 5, f32) = (1.0 - (xx + zz)) * sy
    *ptr_offset(out_matrix, 6, f32) = (yz - wx) * sz
    *ptr_offset(out_matrix, 7, f32) = position.y
    
    // Third column (becomes third row in row-major)
    *ptr_offset(out_matrix, 8, f32) = (xz - wy) * sx
    *ptr_offset(out_matrix, 9, f32) = (yz + wx) * sy
    *ptr_offset(out_matrix, 10, f32) = (1.0 - (xx + yy)) * sz
    *ptr_offset(out_matrix, 11, f32) = position.z
    
    // Fourth column (becomes fourth row in row-major)
    *ptr_offset(out_matrix, 12, f32) = 0.0
    *ptr_offset(out_matrix, 13, f32) = 0.0
    *ptr_offset(out_matrix, 14, f32) = 0.0
    *ptr_offset(out_matrix, 15, f32) = 1.0
}
operator * x64(self : *quaternion, rhs : *quaternion) !quaternion
{
	ret : quaternion = ?

	multiply_quaternions(&ret.v, &self.v, &rhs.v)
	return ret
}
operator *(self : *quaternion, vec : *_vec) !_vec
{
	ret :_vec
	rotate_vector(&ret, vec, &self.v)
	return ret
}
__sqrt::fn intrinsic(a : f32) !f32;
sqrt::fn x64(a : f32) !f32
{
	return __sqrt(a);
}
mix::fn(a : f32, b : f32, t: f32) ! f32
{
	return a *(1.0 - t) + b * t
}
mix::fn(a : *_vec, b : *_vec, t: f32) ! _vec
{
	ret : _vec=?
	ret.x = a.x *(1.0 - t) + b.x * t
	ret.y = a.y *(1.0 - t) + b.y * t
	ret.z = a.z *(1.0 - t) + b.z * t
	ret.w = a.w *(1.0 - t) + b.w * t
	return ret
}
floor::fn(x:f32) ! f32
 {
    i := cast(s32)x;
	if x < 0.0 && x != cast(f32)i
	{
		return cast(f32)i - 1.0
	}
	return cast(f32)i
}

clampu64::fn x64(val :u64, min : u64, max : u64) !u64
{
	if val <= min return min;
	if val >= max return max;
	return val
}
clampu32::fn x64(val :u32, min : u32, max : u32) !u32
{
	if val <= min return min;
	if val >= max return max;
	return val
}
clampi::fn x64(val :s32, min : s32, max : s32) !s32
{
	if val <= min return min;
	if val >= max return max;
	return val
}
clampf::fn x64(val :f32, min : f32, max : f32) !f32
{
	if val <= min return min;
	if val >= max return max;
	return val
}
// Row-major 4x4 matrix multiplication (A * B = C)
operator * x64(a : *mat4x4, b : *mat4x4) !mat4x4 
{
    result : mat4x4=?;
    
    for row_S in 0..4
	{
		row := cast(u64)row_S
        for col_S in 0..4
		{
			col := cast(u64)col_S
            sum := 0.0;
            for k_S in 0..4
			{
				k := cast(u64)k_S
                // Row-major access: [row][col] = row*4 + col
                sum += *a.vals[row*4 + k] * *b.vals[k*4 + col];
            }
            result.vals[row*4 + col] = sum;
        }
    }
    
    return result;
}

mul_mat_vec::fn x64(self : *mat4x4, vec : *_vec) !_vec
{
    ret: _vec;
	aux := *cast(*_vec)self.vals[0]
	ret.x = dot_vec(vec, &aux)

	aux = *cast(*_vec)self.vals[4]
	ret.y = dot_vec(vec, &aux)

	aux = *cast(*_vec)self.vals[8]
	ret.z = dot_vec(vec, &aux)
			
	aux = *cast(*_vec)self.vals[12]
	ret.w = dot_vec(vec, &aux)
	return ret;
}

operator *(self : *mat4x4, vec : *_vec) !_vec
{
    ret: _vec;
	aux := *cast(*_vec)self.vals[0]
	ret.x = dot_vec(vec, &aux)

	aux = *cast(*_vec)self.vals[4]
	ret.y = dot_vec(vec, &aux)

	aux = *cast(*_vec)self.vals[8]
	ret.z = dot_vec(vec, &aux)
			
	aux = *cast(*_vec)self.vals[12]
	ret.w = dot_vec(vec, &aux)
	return ret;
}


operator *(self : *v4, f : f32) !v4
{
	ret:v4;
	ret.x = self.x * f;
	ret.y = self.y * f;
	ret.z = self.z * f;
	ret.w = self.w * f;
	return ret;
}
operator -(self : *v4, rhs : *v4) !v4
{
	ret:v4;
	ret.x = self.x - rhs.x;
	ret.y = self.y - rhs.y;
	ret.z = self.z - rhs.z;
	ret.w = self.w - rhs.w;
	return ret;
}
operator +(self : *v4, rhs : *v4) !v4
{
	ret:v4;
	ret.x = self.x + rhs.x;
	ret.y = self.y + rhs.y;
	ret.z = self.z + rhs.z;
	ret.w = self.w + rhs.w;
	return ret;
}


operator * x64(self : *v3, f : f32) !v3
{
	ret:v3;
	ret.x = self.x * f;
	ret.y = self.y * f;
	ret.z = self.z * f;
	return ret;
}
operator - x64(self : *v3, rhs : *v3) !v3
{
	ret:v3;
	ret.x = self.x - rhs.x;
	ret.y = self.y - rhs.y;
	ret.z = self.z - rhs.z;
	return ret;
}
operator + x64(self : *v3, rhs : *v3) !v3
{
	ret:v3;
	ret.x = self.x + rhs.x;
	ret.y = self.y + rhs.y;
	ret.z = self.z + rhs.z;
	return ret;
}

ASSIGN_V3::fn macro(dst : _expr, a : _expr)
{
	dst.x = a.x;
	dst.y = a.y;
	dst.z = a.z;

}
square_normalize::fn(a : *v3) !v3
{
	aux: = *a;
	epsilon: = 0.01;
	if aux.x > epsilon
		aux.x = 1.0;
	else if aux.x <= -epsilon
		aux.x = -1.0;

	if aux.y > epsilon
		aux.y = 1.0;
	else if aux.y <= -epsilon
		aux.y = -1.0;
	return aux;
}
mul_v3::fn(a : *v3, b : *v3) !v3
{
	aux:v3;
	aux.x = a.x * b.x;
	aux.y = a.y * b.y;
	aux.z = a.z * b.z;

	return aux;
}
sign_v3::fn(a : *v3) !v3
{
	aux: = *a;
	aux.x = if a.x > 0.0 1.0 else - 1.0;
	aux.y = if a.y > 0.0 1.0 else - 1.0;
	aux.z = if a.z > 0.0 1.0 else - 1.0;

	return aux;
}
len_v4::fn(a : *v4) !f32
{
	return sqrt(dot_v4(a, a));
}
len_vec::fn x64(a : *_vec) !f32
{
	return sqrt(dot_vec(a, a));
}
len_v3::fn x64(a : *v3) !f32
{
	return sqrt(dot_v3(a, a));
}
normalize_v4::fn(a : *v4) !v4
{
	len: = sqrt(dot_v4(a, a));
	ret:v4;
	ret.x = a.x / len;
	ret.y = a.y / len;
	ret.z = a.z / len;
	ret.w = a.w / len;
	return ret;
}
normalize_vec::fn x64(a : *_vec) ! _vec
{
	dot: = dot_vec(a, a);
	len: = sqrt(dot);
	//__dbg_break
	ret:_vec = *a / len;
	return ret;
}
normalize_v3::fn(a : *v3) !v3
{
	dot: = dot_v3(a, a);
	len: = sqrt(dot);
	ret:v3;
	ret.x = a.x / len;
	ret.y = a.y / len;
	ret.z = a.z / len;
	return ret;
}
dot_v4::fn(a : *v4, b : *v4) !f32
{
	ret: = a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w;
	return ret;
}
//dot_v3::fn outsider(a : *v3, b : *v3) !f32;
dot_vec::fn x64(a : *_vec, b : *_vec) !f32
{
	ret := a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w;
	return ret;
}
print_vec::fn(v : *_vec)
{
	printf("x {v.x}, y {v.y}, z {v.z}, w {v.w}\n")
	//printf("ang %, dt %\n", cast(s32)(ang * 100.0), cast(s32)(dt * 100.0))
}
cross_vec::fn x64(a : *_vec, b : *_vec) !_vec
{

	ret :_vec= ?
	ret.x = a.y * b.z - a.z * b.y
	ret.y = a.z * b.x - a.x * b.z
	ret.z = a.x * b.y - a.y * b.x
	ret.w = 0.0
	/*
	printf("\ton cross\n\t")
	print_vec(a)
	printf("\t")
	print_vec(b)
	print_vec(&ret)
	printf("\ton cross\n")
	*/
	return ret;
}
raycast_info :struct
{
	ray_origin : _vec,
    ray_dir : _vec,
    v0 : _vec,
    v1 : _vec,
    v2 : _vec,
    t_out : f32,
    u_out : f32,
    v_out : f32
}

f32_approximate ::fn macro(f : _expr, val : _expr)
{
	(f >= (val - 0.1) && f <= (val + 0.1))
}
ray_triangle_intersect_x64_test :: fn x64(rinfo : *raycast_info) ! u8
{
	ray_origin := rinfo.ray_origin
    ray_dir := rinfo.ray_dir
    v0 := rinfo.v0
    v1 := rinfo.v1
    v2 := rinfo.v2
    t_out := rinfo.t_out
    u_out := rinfo.u_out
    v_out := rinfo.v_out

    epsilon : f32 = 0.000001;
    
    edge1 := v1 - v0
    edge1.w = 0.0;

    edge2 := v2 - v0
    edge2.w = 0.0;
	if f32_approximate(edge1.x, 1.0) == false || 
		f32_approximate(edge2.x, 1.0) == false || 
		f32_approximate(edge2.z, -1.0) == false

	{
		return 0
	}

    h : _vec = ?;
    s : _vec = ?;
    q : _vec = ?;

    
    // Calculate triangle edges
    

    // Cross product: h = ray_dir × edge2
    h = cross_vec(&ray_dir, &edge2);
	if f32_approximate(h.x, 1.0) == false || 
		f32_approximate(h.z, 1.0) == false

	{
		return 1
	}
    
    // Determinant: a = edge1 • h
    a : f32 = dot_vec(&edge1, &h);
	if f32_approximate(a, 1.0) == false
	{
		return 2
	}
    
    // Check if ray is parallel to triangle
    if (a > -epsilon && a < epsilon) {
        return 3;
    }
    
	//__dbg_break
    f : f32 = 1.0 / a;
    s = ray_origin - v0;
    s.w = 0.0;
    
	if f32_approximate(f, 1.0) == false
	{
		return 4
	}
	if f32_approximate(s.x, 0.5) == false || 
		f32_approximate(s.y, 1.0) == false || 
		f32_approximate(s.z, -0.5) == false
	{
		return 5
	}
    
    // Barycentric u coordinate
    u : f32 = f * dot_vec(&s, &h);
	if f32_approximate(u, 0.0) == false
	{
		return 6
	}
    if (u < 0.0 || u > 1.0) {
        return 7;
    }
	//__dbg_break
    
    // Cross product: q = s × edge1
    q = cross_vec(&s, &edge1);
	if f32_approximate(q.x, 0.0) == false || 
		f32_approximate(q.y, -0.5) == false || 
		f32_approximate(q.z, -1.0) == false
	{
		return 8
	}
    
    // Barycentric v coordinate
    v : f32 = f * dot_vec(&ray_dir, &q);
	if f32_approximate(v, 0.5) == false
	{
		return 9
	}
    if (v < 0.0 || u + v > 1.0) {
        return 10;
    }
    
    // Calculate t parameter (distance along ray)
    t : f32 = f * dot_vec(&edge2, &q);
    
	if f32_approximate(t, 1.0) == false
	{
		return 11
	}
    // Only accept intersections in front of ray
    if (t > epsilon) {
        //if (t_out != nil) { *t_out = t; }
        //if (u_out != nil) { *u_out = u; }
        //if (v_out != nil) { *v_out = v; }
        return 12;
    }
    
    return 13;
}
ray_triangle_intersect :: fn x64(rinfo : *raycast_info) ! bool
{
	ray_origin := rinfo.ray_origin
    ray_dir := rinfo.ray_dir
    v0 := rinfo.v0
    v1 := rinfo.v1
    v2 := rinfo.v2

    epsilon : f32 = 0.000001;
    
    edge1 := v1 - v0
    edge1.w = 0.0;

    edge2 := v2 - v0
    edge2.w = 0.0;
    h : _vec = ?;
    s : _vec = ?;
    q : _vec = ?;

    
    // Calculate triangle edges
    

    // Cross product: h = ray_dir × edge2
    h = cross_vec(&ray_dir, &edge2);
    
    // Determinant: a = edge1 • h
    a : f32 = dot_vec(&edge1, &h);
    
    // Check if ray is parallel to triangle
    if (a > -epsilon && a < epsilon) {
        return false;
    }
    
	//__dbg_break
    f : f32 = 1.0 / a;
    s = ray_origin - v0;
    s.w = 0.0;
    
    // Barycentric u coordinate
    u : f32 = f * dot_vec(&s, &h);
    if (u < 0.0 || u > 1.0) {
        return false;
    }
	//__dbg_break
    
    // Cross product: q = s × edge1
    q = cross_vec(&s, &edge1);
    
    // Barycentric v coordinate
    v : f32 = f * dot_vec(&ray_dir, &q);
    if (v < 0.0 || u + v > 1.0) {
        return false;
    }
    
    // Calculate t parameter (distance along ray)
    t : f32 = f * dot_vec(&edge2, &q);
    
    // Only accept intersections in front of ray
    if (t > epsilon) {
        rinfo.t_out = t;
        rinfo.u_out = u;
        rinfo.v_out = v;
        return true;
    }
    
    return false;
}
dot_v3::fn x64(a : *v3, b : *v3) !f32
{
	ret := a.x * b.x + a.y * b.y + a.z * b.z;
	return ret;
}
DOT_V3::fn macro(dst : _expr, a : _expr, b : _expr)

{
	
	dst = a.x * b.x + a.y * b.y + a.z * b.z;
}
MUL_V3::fn macro(dst : _expr, a : _expr, b : _expr)
{
	dst.x = a.x * b.x;
	dst.y = a.y * b.y;
	dst.z = a.z * b.z;
}
MUL_V3_F32::fn macro(dst : _expr, a : _expr, b : _expr)
{
	dst.x = a.x * b;
	dst.y = a.y * b;
	dst.z = a.z * b;
}
SUB_V3::fn macro(dst : _expr, a : _expr, b : _expr)
{
	dst.x = a.x - b.x;
	dst.y = a.y - b.y;
	dst.z = a.z - b.z;
}
SUM_V3::fn macro(dst : _expr, a : _expr, b : _expr)
{
	dst.x = a.x + b.x;
	dst.y = a.y + b.y;
	dst.z = a.z + b.z;
}
DoTwoLinesIntersect::fn x64(startA : *_vec, endA : *_vec, startB : *_vec, endB : *_vec, p : *_vec) !bool
{
	x1:f32;
	x2:f32; 
	y1:f32; 
	y2:f32; 
	x3:f32;
	x4:f32;
	y3:f32; 
	y4:f32;

	x1 = startA.x;
	x2 = endA.x;
	y1 = startA.y;
	y2 = endA.y;

	x3 = startB.x;
	x4 = endB.x;
	y3 = startB.y;
	y4 = endB.y;

	den:= (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4);
	if (den == 0.0)
	{
		return false;
	}

	t := ((x1 - x3) * (y3 - y4) - (y1 - y3) * (x3 - x4)) / den;

	u := ((x2 - x1) * (y1 - y3) - (y2 - y1) * (x1 - x3)) / den;

	if (t > 0.0 && t < 1.0 && u > 0.0 && u < 1.0)
	{
		//*p = *startA + (*endA - *startA) * t;
		p.x = startA.x + (endA.x - startA.x) * t;
		p.y = startA.y + (endA.y - startA.y) * t;
		return true;
	}
	return false;
}

lerp::fn(a : *_vec, b : *_vec, t : f32) ! _vec
{
	return *a * (1.0 - t)  + *b * t
}

