import "../typedefs/"
import "../render/"
import "../opengl/"
import "../memory/"
TOTAL_ASSETS:const s32= 32
ASSET_MAT_START:const s32= 8
texture_info :struct
{
  tex_id : u32
}
shader_mesh_contract:struct
{
#if RENDER_API == OPENGL
{
  vao : u32
}
}
model_info :struct
{
  asset_idx : u32
  mesh : *mesh_info
  contract : shader_mesh_contract
}
attribute_desc_shader:struct
{
  loc  : u32
  desc : attribute_desc
}
shader_info:struct
{
#if RENDER_API == OPENGL
{
 id : u32
}
}
material_info :struct
{
  asset_idx : u32
  offscreen_shader : shader_info
  depth_shader     : shader_info

  depth_only_id : u32
  model_uniform : uniform_buffer

  attrs : *attribute_desc_shader
  total_attrs : u8
}

create_shader_mesh_contract::fn(mesh : *mesh_info, mat : *material_info, out : *shader_mesh_contract)
{
//#if RENDER_API == OPENGL
{
  glGenVertexArrays(1, &out.vao)
  glBindVertexArray(out.vao)
  glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, mesh.index_buffer.gl.id);


  for mesh_at in mesh.attrs
  {
    if mesh_at.data == nil continue;

    glBindBuffer(GL_ARRAY_BUFFER, mesh_at.buffer.gl.id);
    ASSERT(mesh_at.buffer.gl.id != 0)

    for a in 0..cast(s64)mat.total_attrs
    {
      cur_sh_attr := ptr_offset(mat.attrs, a, attribute_desc_shader)

      if cur_sh_attr.desc.sem != mesh_at.sem continue;

      
      type : u32
      elements : u32
      tp_sz :u32= 0

      on cur_sh_attr.desc.format
      {
      vertex_format.F32x1
      {
        type = GL_FLOAT
        elements = 1
      }
      vertex_format.F32x2
      {
        type = GL_FLOAT
        elements = 2
      }
      vertex_format.F32x3
      {
        type = GL_FLOAT
        elements = 3
        tp_sz = 12
      }
      default
      {
        __dbg_break;
      }
      }


      glVertexAttribPointer(cast(u32)cur_sh_attr.loc, cast(s32)elements, type, GL_FALSE, tp_sz, nil);
      glEnableVertexAttribArray(cast(u32)cur_sh_attr.loc);
    }
  }
  glBindVertexArray(0)
}
}
asset_type:etruct
{
    IMAGE(
        img : image
    ),
    MESH(
        m : mesh_info
    ),
    MODEL(
        mod : model_info
    ),
    MATERIAL(
        mat : material_info
    ),
}
asset_info:struct
{
  in_use : bool,
  idx : u64
  name : [16]char
  using type : asset_type
}
