import "../typedefs/"
import "../render/"
TOTAL_ASSETS:const s32= 16
ASSET_MAT_START:const s32= 8
texture_info :struct
{
  tex_id : u32
}
model_info :struct
{
  asset_idx : u32
  mesh : mesh_info

#if RENDER_API == OPENGL
{
  model_id : u32
}
}
material_info :struct
{
  asset_idx : u32
#if RENDER_API == OPENGL
{
	shader_id : u32
  depth_only_id : u32
  model_uniform : uniform_buffer
}
}
asset_type:etruct
{
    TEXTURE(
        id : texture_info
    ),
    MESH(
        m : mesh_info
    ),
    MODEL(
        mod : model_info
    ),
    MATERIAL(
        mat : material_info
    ),
}
asset_info:struct
{
  in_use : bool,
  name : [16]char
  using type : asset_type
}
