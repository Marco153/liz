import "../render/"
import "../memory/"
import "../os/"
import "../buffer/"

aiVector3D : struct
{
  x : f32;
  y : f32;
  z : f32;
}

aiColor4D : struct
{
  r : f32;
  g : f32;
  b : f32;
  a : f32;
}

aiMatrix4x4 : struct
{
  a1 : f32; a2 : f32; a3 : f32; a4 : f32;
  b1 : f32; b2 : f32; b3 : f32; b4 : f32;
  c1 : f32; c2 : f32; c3 : f32; c4 : f32;
  d1 : f32; d2 : f32; d3 : f32; d4 : f32;
}
aiFace : struct
{
  mNumIndices : u32;
  mIndices    : *u32;
}
aiMesh : struct
{
  mPrimitiveTypes : u32;

  mNumVertices    : u32;
  mNumFaces       : u32;
  mVertices       : *aiVector3D;
  mNormals        : *aiVector3D;
  mTangents       : *aiVector3D;
  mBitangents     : *aiVector3D;

  mColors         : [8]*aiColor4D;
  mTextureCoords  : [8]*aiVector3D;
  mNumUVComponents: [8]u32;

  mFaces          : *aiFace;

  mNumBones       : u32;
  mBones          : **aiBone;

  mMaterialIndex  : u32;

  mName           : str_lit;
}
aiNode : struct
{
  mName           : str_lit;

  mTransformation : aiMatrix4x4;

  mParent         : *aiNode;

  mNumChildren    : u32;
  mChildren       : *aiNode;

  mNumMeshes      : u32;
  mMeshes         : *u32;
}
aiMaterialProperty : struct
{
  mKey      : str_lit;
  mSemantic : u32;
  mIndex    : u32;

  mDataLength : u32;
  mType       : u32;
  mData       : *u8;
}
aiVertexWeight : struct
{
  mVertexId : u32;
  mWeight   : f32;
}
aiBone : struct
{
  mName           : str_lit;

  mNumWeights     : u32;
  mWeights        : *aiVertexWeight;

  mOffsetMatrix   : aiMatrix4x4;
}

aiMaterial : struct
{
  mNumProperties : u32;
  mProperties    : *aiMaterialProperty;

  mNumAllocated  : u32;
}
aiScene : struct
{
  mFlags           : u32;

  mRootNode        : *aiNode;

  mNumMeshes       : u32;
  mMeshes          : **aiMesh;

  mNumMaterials    : u32;
  mMaterials       : *aiMaterial;

  mNumAnimations   : u32;
  mAnimations      : *void;

  mNumTextures     : u32;
  mTextures        : *void;

  mNumLights       : u32;
  mLights          : *void;

  mNumCameras      : u32;
  mCameras         : *void;
}
aiPrimitiveType_POINT    : const u32 = 0x1;
aiPrimitiveType_LINE     : const u32 = 0x2;
aiPrimitiveType_TRIANGLE : const u32 = 0x4;

aiProcess_Triangulate    : const u32 = 0x8;
aiProcess_FlipUVs        : const u32 = 0x800000;
aiProcess_JoinIdenticalVertices : const u32 = 0x00000001;
aiProcess_GenNormals            : const u32 = 0x00000020;
aiProcess_ImproveCacheLocality  : const u32 = 0x00008000;

aiImportFile::fn outsider(path: str_lit, flags: u32) ! *aiScene;
aiReleaseImport::fn outsider(scene: *aiScene) ! void;


load_model::fn(path : str_lit, out : *mesh_info, rman : *render_manager, alloc : *generic_allocator)
{
  scene := aiImportFile(path, aiProcess_Triangulate | aiProcess_JoinIdenticalVertices |
                       aiProcess_ImproveCacheLocality)

  if scene == nil
  {
    printf("failed to load model {path}\n")
    __dbg_break
    __dbg_break
    __dbg_break
  }
  a := 2

  index_count:u32= 0;
  vert_count :u32= 0;
  for m in 0..cast(s64)scene.mNumMeshes
  {
    _cur := ptr_offset(scene.mMeshes, m, *aiMesh)
    index_count += _cur.mNumFaces;
    vert_count  += _cur.mNumVertices;
  }

  memset(&out.attrs[0], 0, TOTAL_MESH_ATTRS * sizeof(out.attrs[0]))
  assign_v_format_and_sem(&out.attrs[0], vertex_format.F32x3, vertex_semantic.POSITION, vert_count, alloc)

  indices := cast(*u32)get_buffer_from_generic_alloc(alloc, index_count * 3 * sizeof(u32))


  pos_voffset :u32= 0
  pos_ioffset :u32= 0

  cur_vert :u32= 0
  printf("total meshes {scene.mNumMeshes}\n")
  for m in 0..cast(s64)scene.mNumMeshes
  {
    cur := ptr_offset(scene.mMeshes, m, *aiMesh)
    cp_sz   := cur.mNumVertices * sizeof(f32) * 3


    for t in 0..cast(s64)cur.mNumVertices
    {
      src := ptr_offset(cur.mVertices, t * 3, f32)
      idx := pos_voffset + cast(u32)t * 3 * sizeof(f32)

      dst := ptr_offset(out.attrs[0].data, idx, u8)
      v := *ptr_offset(src, 0, _vec)

      *ptr_offset(dst, 0, f32) = v.x
      *ptr_offset(dst, 1, f32) = v.z
      *ptr_offset(dst, 2, f32) = -v.y


    }

    cur_i := ptr_offset(indices, pos_ioffset, u8)

    cp_i_sz := cur.mNumFaces * sizeof(u32) * 3

    printf("total faces {cur.mNumFaces}\n")
    printf("total vertices {cur.mNumVertices}\n")

    for t in 0..cast(s64)cur.mNumFaces
    {
      f := ptr_offset(cur.mFaces, t, aiFace)

      if  f.mNumIndices != 3 continue

      src_i := ptr_offset(f.mIndices, 0, u32)

      *ptr_offset(cur_i, t * 3, u32) = *ptr_offset(f.mIndices, 0, u32) + cur_vert
      *ptr_offset(cur_i, t * 3 + 1, u32) = *ptr_offset(f.mIndices, 1, u32) + cur_vert
      *ptr_offset(cur_i, t * 3 + 2, u32) = *ptr_offset(f.mIndices, 2, u32) + cur_vert
    }
    pos_voffset += cp_sz
    pos_ioffset += cp_i_sz

    cur_vert += cur.mNumVertices
  }

  desc:buffer_desc
  desc.size  = vert_count * 3 * sizeof(f32)
  desc.usage = buffer_usage.VERTEX
  desc.memory = memory_usage.GPU_ONLY
  desc.initial_data = out.attrs[0].data

  out.attrs[0].buffer = create_buffer(&desc, rman, alloc)

  id := out.attrs[0].buffer.gl.id


  desc.size  = index_count * 3 * sizeof(u32)
  desc.usage = buffer_usage.INDEX
  desc.memory = memory_usage.GPU_ONLY
  desc.initial_data = indices

  out.index_buffer = create_buffer(&desc, rman, alloc)
}
