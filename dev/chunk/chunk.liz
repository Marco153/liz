import "../render/"
import "../typedefs/"
import "../math/"
import "../os/"
import "../work/"
FACE_RIGHT:const s32= 0
FACE_LEFT:const s32= 1
FACE_UP:const s32= 2
FACE_DOWN:const s32= 3
FACE_FORWARD:const s32= 4
FACE_BACK:const s32= 5
//face
//0-4 bits   = posx
//4-7 bits   = posy
//8-11 bits   = posz
//12-16 bits  = light
//16-18 bits = face direction(0=+x, 1=-x, 2=+y, 3=-y, 4=+z, 5=-z)
//20-23 bits = light
//24-31 bits = texture idx

make_face_val::fn macro(assign_to : _expr, x : _expr, y: _expr, z : _expr, face_dir : _expr, light : _expr, tex_x : _expr, tex_y : _expr)
{
  assign_to = cast(u32)x
  assign_to = assign_to | cast(u32)(y << 4)
  assign_to = assign_to | cast(u32)(z << 8)
  assign_to = assign_to | cast(u32)((light) << 12)
  assign_to = assign_to | cast(u32)((face_dir) << 16)
  assign_to = assign_to | cast(u32)((light) << 20)
  assign_to = assign_to | cast(u32)((tex_x) << 24)
  assign_to = assign_to | cast(u32)((tex_y) << 30)
}


chunk_info:struct
{
  pos : vector
  lod : u8

  imgs : [TEX_GRID_SIZE_SQRD]*image
}

TERRAIN_SIZE :const s32= 8192

TEX_GRID_SIZE:const s32=3
TEX_GRID_SIZE_SQRD:const s32= TEX_GRID_SIZE * TEX_GRID_SIZE
MIP_LEVELS:const s32=1

CHUNK_WIDTH:const s32=7
TOTAL_CHUNKS:const s32=CHUNK_WIDTH*CHUNK_WIDTH

CHUNK_SIZE:const s32=128
HEIGHTMAP_BYTES_PER_PIXEL:const s32=2

CHUNK_SIZE_HALF:const s32=CHUNK_SIZE/2


mip_texture:struct
{
  x : u32
  y : u32

  tex : texture
}
mip_info:struct
{
  texs :[5]mip_texture
}


TOTAL_TEXS_IN_MAP :const s32= 512

texture_map:struct
{
  in_use : bool

  x : s32
  y : s32
  img : *image
}
terrain_info:struct
{
  ubo : storage_buffer

  chunks : [TOTAL_CHUNKS]chunk_info

  mips : [MIP_LEVELS]mip_info

  prev_player_pos : vector

  tex_map : [TOTAL_TEXS_IN_MAP]texture_map

  page_table : [5500] u32
}

update_terrain_chunks::fn(trn : *terrain_info, player_pos : vector)
{
  p := trn.prev_player_pos - player_pos
  l := len_vec(p)
  if l > cast(f64)(CHUNK_SIZE / 4)
  {

    trn.prev_player_pos.x = cast(f64)cast(s64)player_pos.x
    trn.prev_player_pos.z = cast(f64)cast(s64)player_pos.z
    trn.prev_player_pos.y = 0.0
  }

}
