import "../../core";

ANIM_TICKS_PER_SEC:const f32= 24.0
timeline_type: enum
{
	MOV,
	CHANGE,
	TEXTURE,
	CALLBACK,
}
activate_type:enum
{
	ENTITY,
	CAN_MOVE,
	ACTIVATE_ATTACK_TRIGGER,
	CAN_START_COMBO,
}


anim_callback_info:struct
{
	time_since_stopped : f32,
	ent : *entity,
	end_anim : bool,
	
}
keyframe: struct
{
	time : f32,
	using u :: union
	{
		mov :: struct
		{
			pos: _vec
		};
		tex_id : u32,
		anim_callback : fn(*anim_callback_info)!bool,
		
		activate::struct
		{
			type : activate_type,
			val : bool,
		};

	}
}
timeline : struct
{
	type : timeline_type,
	kfs : dyn_array(keyframe),
	prev_callback_kf : *keyframe,
	ent : *entity,
	time_since_stopped : f32,
}
clip3d: struct
{
	start : f32
	end : f32

  start_kf :u64

	vel : f32

  bones_start_kf_pos :dyn_array(u32)
  bones_start_kf_rot :dyn_array(u32)
  bones_start_kf_scale :dyn_array(u32)
}
clip2: struct
{
	tms : dyn_array(timeline),
	vel : f32,
	len : f32,
	pause : bool,
	loop : bool,
}





