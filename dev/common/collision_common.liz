import "../../core";

in_col_ent:struct
{
	ent : *entity,
	in_col : bool,
	col : collision,
}
contact_col:struct
{
	ent_a : *entity,
	ent_b : *entity,
	col : collision,
}
collision:struct
{
	normal:_vec,
	depth : f32,
    contacts: dyn_array(_vec),
	contact_point:_vec,
	col_it : u64,
	ent : *entity,
	ignore_trigger_do_collision : bool,
	ignore_collision : bool,
}
collision_res : struct
{
	e1 : *entity
	e2 : *entity
	mtv : _vec
	col : collision
}
col_info:struct
{
    a_pos: _vec,
    a_pivot: _vec,
    a_size: _vec,
    a_vel: _vec,
    a_rot: _vec,
	a_ent : *entity,

    b_pos: _vec,
    b_pivot: _vec,
    b_size: _vec,
    b_vel: _vec,
    b_rot: _vec,
	b_ent : *entity,
}

verts_and_tris:struct
{
	verts : *_vec
	verts_count : u32
	tris : *u32
	tris_count : u32
	model_idx : u64
}

col_type : etruct
{
	SPHERE(
		radius : f32
		
	),
	CAPSULE(
		radius : f32,
		height : f32
	),
	MESH(
		info : verts_and_tris
	),
	TRIANGLE(
		normal :_vec
		verts : [3]_vec
	),
	CUBE(
		verts : [8]_vec
	)
}
collider : struct
{
	using type : col_type
	ent : * entity
	pos : _vec
	size : _vec
	_min : _vec
	_max : _vec
	rel_chunk_min : _vec
	rel_chunk_max : _vec
	data_ready : bool
	no_rotation_ent : bool

	in_chunks : dyn_array(*collision_chunk),

	ents_of_gotten_chunks : dyn_array(*entity),
	//children : dyn_array(*collider),
}

triangle_info:struct
{
	ent : *entity
	info : *verts_and_tris
	tri_idx : u32
}
collision_chunk:struct
{
	entities : dyn_array(*entity)
	tris : dyn_array(triangle_info)

}