GetShaderUniform::fn(m : *material_info, name : str_lit) ! u64
{
	idx:u64
	found := false
	for u in m.uniforms
	{
		if u.name == name
		{
			found =true
			break;
		}
		idx++
	}
	ASSERT(found)
	return idx

}


