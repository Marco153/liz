rel_string : struct
{
	offset : u32,
	count : u32,
}
AppendStr::fn(self: *string, ch : char)
{
	dyn_add_data(&self.data, &ch, 1)
}
operator ==(self: *rel_string, str : *rel_string) !bool
{
	ln := str.count
	if ln != self.count
		return false

	start := cast(*u8)(cast(u64)self + self.offset)
	start2 := cast(*u8)(cast(u64)str + str.offset)

	for i in 0..ln
	{
		lhs := ptr_offset(start, i, u8);
		rhs := ptr_offset(start2, i, u8);
		if *lhs != *rhs
			return false
	}

	return true
}
operator ==(self: *rel_string, str : str_lit) !bool
{
	ln := str_ln(str)
	if ln != self.count
		return false

	start := cast(*u8)(cast(u64)self + self.offset)

	for i in 0..ln
	{
		lhs := ptr_offset(start, i, u8);
		rhs := ptr_offset(str, i, u8);
		if *lhs != *rhs
		{
			return false
		}
	}

	return true
}
string : struct
{
	data : dyn_array(char)
}
operator ==(self: *string, str : *rel_string) !bool
{
	ln: = cast(u64)str.count
	if ln != self.data.count
		return false
	
	str_offset := ptr_offset(str, str.offset, u8)

	for i in 0..ln
	{
		lhs := ptr_offset(self.data.data, i, u8);
		rhs := ptr_offset(str_offset, i, u8);
		if *lhs != *rhs
			return false
	}

	return true
	
}
operator ==(self: *string, str : *string) !bool
{
	ln: = str.data.count
	if ln != self.data.count
		return false
	

	for i in 0..ln
	{
		lhs := ptr_offset(self.data.data, i, u8);
		rhs := ptr_offset(str.data.data, i, u8);
		if *lhs != *rhs
			return false
	}

	return true
	
}
operator ==(self : *string, str : str_lit) ! bool
{
	ln := str_ln(str)
	if ln != self.data.count
		return false
	

	for i in 0..ln
	{
		lhs := ptr_offset(self.data.data, i, u8);
		rhs := ptr_offset(str, i, u8);
		if *lhs != *rhs
			return false
	}

	return true
	
}

AssignStr::fn(str : *string, buffer : *u8, bsz : u32)
{
	str.data.count = 0
	dyn_add_data(&str.data, buffer, bsz);
}

saved_regs : struct
{
	//regs : [34]u64,
	rip : u64,

};

coroutine_func_saved:struct
{
	name : str_lit,
	from_func_ret_addr : u64,

	regs : saved_regs,
	stack : dyn_array(u8),
	cur_time_wait : f32,
	time_to_wait : f32

};
coroutine_ctx:struct
{
	funcs: dyn_array(coroutine_func_saved),
	alloc : *mem_alloc,
}

CorMoveVecTo::fn macro(vec : _expr, dst_x : _expr, dst_y : _expr, dst_z : _expr, speed : _expr, extra_break_cond : _expr)
{
	while true
	{
		dir_x := dst_x - vec.x;
		dir_y := dst_y - vec.y;
		vec.x += *dt * sign(dir_x) * speed;
		vec.y += *dt * sign(dir_y) * speed;
		
		//OpenLocalsWindow(1205);
		if absf(dst_x - vec.x) < 0.1 && absf(dst_y - vec.y) < 0.1 || (extra_break_cond)
		{
			break;
		}
		return;
	}

}
CorWait::fn macro(time : _expr)
{
	
	_found.time_to_wait = time;
	_found.cur_time_wait = 0.0;
	while true
	{
		_found.cur_time_wait += *dt;
		if _found.cur_time_wait >= _found.time_to_wait
			break;
		return;
	}
}

CoroutineEnding::fn macro(label_name : _expr)
{
	_lab_addr = cast(u64)label_name;
	_found.regs.rip = GetInstRealAddr(_lab_addr - 1);
	memcpy(_found.stack.data, cast(*void)_top_stack, _fsz);
	return;
	$label_name;
}
ResetCoroutine::fn macro()
{
	_found.regs.rip = 0;
}
CoroutinePrologue::fn macro()
{

	_test := cor_ctx;
	_fsz: = GetFuncStackSize();
	_fname := __FUNC_NAME__;
	_lab_addr:u64;
	_top_stack: = cast(u64)GetTopStackPtr();
	_ret_addr: = *cast(*u64)ptr_offset(_top_stack, _fsz, u8);
	_found :*coroutine_func_saved= GetSavedCoroutine(cor_ctx, _fname, _ret_addr, cast(u32)_fsz);


	_rip := cast(*u64)(34 * 8);
	if (_found.regs.rip != 0)
	{
		memcpy(cast(*void)_top_stack, _found.stack.data, _fsz);
		*_rip = _found.regs.rip;
	}
	else
	{
		//_lab_addr = cast(u64)label1;
		//_found.regs.rip = GetInstRealAddr(_lab_addr - 1);
		//memcpy(_found.stack.data, cast(*void)_top_stack, _fsz);
	}
}

GetSavedCoroutine::fn(ctx : *coroutine_ctx, name : str_lit, ret_addr : u64, stack_sz : u32) !*coroutine_func_saved
{
	for f in ctx.funcs
	{
		if str_cmp(name, f.name) && ret_addr == f.from_func_ret_addr
			return f;
	}
	new_f:coroutine_func_saved;
	new_f.name = name;
	new_f.regs.rip = 0;
	new_f.from_func_ret_addr = ret_addr;
	dyn_init2(&new_f.stack, stack_sz, ctx.alloc);
	dyn_add(&ctx.funcs, &new_f);
	return ctx.funcs[ctx.funcs.count - 1];
}

stencil_func_enum : enum
{
	EQUAL,
