GetCharTextureIdx::fn(ch : char ) ! u32
{
	ch_idx := cast(u8)ch - 'a;
	if (cast(char)ch) == ',
		ch_idx = 26;
	else if (cast(char)ch) == '.
		ch_idx = 27;
	else if (cast(char)ch) == '?
		ch_idx = 28;
	else if (cast(char)ch) == '!
		ch_idx = 29;
	else if ch >= '0 && ch <= '9
	{
		ch_idx = 30 + cast(u8)ch - '0;
	}

	return ch_idx;
}
min3::fn(a :f32, b :f32, c : f32)!f32
{
	ret :=a
	if ret > b
		ret = b;
	if ret > c
		ret = c;
    return ret;
}
max3::fn(a :f32, b :f32, c : f32)!f32
{
	ret :=a
	if ret < b
		ret = b;
	if ret < c
		ret = c;
    return ret;
}
maxf::fn x64(a :f32, b :f32)!f32
{
	if a > b return a;
    return b;

}
absf::fn x64(a :f32) !f32
{
	if a < 0.0 return -a;
    return a;

}
abss32::fn(a :s32)!s32
{
	if a < 0 return -a;
    return a;

}
minf::fn x64(a :f32, b :f32)!f32
{
	if a > b return b;
    return a;
}

cmpf::fn macro(a : _expr, b : _expr)
{
	absf(a - b) < 0.0001
}
equal_vec::fn(a : *_vec, b : *_vec) ! bool
{
	return cmpf(a.x, b.x) && cmpf(a.y, b.y) && cmpf(a.z, b.z) && cmpf(a.w, b.w)
}
builtin_type_to_string::fn(tp : *lang_type)!str_lit
{
	on tp.type
	{
	lang_type_type.SAMPLER2D
	{
		return "sampler2D"
	}
	lang_type_type.V2
	{
		return "vec2"
	}
	lang_type_type.S32
	{
		return "int"
	}
	lang_type_type.U32
	{
		return "uint"
	}
	lang_type_type.V3
	{
		return "vec3"
	}
	lang_type_type.IV4
	{
		return "ivec4"
	}
	lang_type_type.V4
	{
		return "vec4"
	}
	lang_type_type.F32
	{
		return "float"
	}
	lang_type_type.MAT4
	{
		return "mat4"
	}
	default
	{
		__dbg_break
	}
	}
}