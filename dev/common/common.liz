	aux_buffer : [64]char;
	sprintf(cast(*u8)aux_buffer[0], 64, "%%", "../scenes/", name);
	fl_sz: = GetFileSize(cast(str_lit) aux_buffer[0]);
	file: = heap_alloc(alloc, cast(u32)fl_sz + 1);
	ReadFile(cast(str_lit) aux_buffer[0], file);

	lang_stat : lang_state
	scp := new_scope(nil)
	tkns : dyn_array(token)
	pinfo : parse_info
	pinfo.tkns = &tkns
	
	Tokenize(&tkns, cast(str_lit)file)
	n := parse(&pinfo, 999, parser_op.GREATER_THAN)
