	str_tbl_sz : u32,
	cell_sz : u32,

};
aux_cell_info:struct
{
	version : u64,
	using u :: union
	{
		col:col_cell,
		obj: obj_cell,
		sp:sp_cell;
	};
	masked : masked_info,
};


get_tex_pixel_stride::fn(tex : *texture_info)!u32
{
	return cast(u32)tex.channels * (cast(u32)1 <<(cast(u32)tex.channel_size))
}
NewEntSpriteSheet::fn(alloc: *mem_alloc, grid_x : u32, grid_y : u32, pixels_per_width : u32, out : *layer_sprites) 
{
	ASSERT(out)
	out.grid_x = grid_x;
	out.grid_y = grid_y;
	out.pixels_per_width = cast(u8)pixels_per_width;
	out.tex_id = GenRawTexture(grid_x * pixels_per_width, grid_y * pixels_per_width, gen_texture_type.RGBA, gen_texture_filter.NEAREST, gen_texture_size.BYTE);
	sz: = grid_x * grid_y;
	dyn_init2(&out.cells, sz, alloc);
	out.cells.count = sz;
}

CreateSpriteSheetFromLayer::fn(alloc : *mem_alloc, cur_layer : *aux_layer_info_struct, str_tbl : *u8, textures : *dyn_array(texture_info)) ! *layer_sprites
{
	cur_ptr := cast(*u8)ptr_offset(cur_layer, 1, aux_layer_info_struct);

	ar_layer := cast(*layer_sprites)heap_alloc(alloc, sizeof(layer_sprites));
	ar_layer.type = cur_layer.type;
	ar_layer.obj_type = cur_layer.obj_type;
	ar_layer.pixels_per_width = cur_layer.pixels_per_width;
	//NewEntSpriteSheet(alloc, 8, 8, cur_layer.pixels_per_width, ar_layer);
	sz: = cur_layer.grid_x * cur_layer.grid_y;
	dyn_init2(&ar_layer.cells, sz, alloc);

	regrow(&ar_layer.cells, cur_layer.grid_x * cur_layer.grid_y);
	
	ar_layer.tex_id = LoadSheetFromLayer(cur_layer, str_tbl);

	if cur_layer.cell_sz != sizeof(sp_cell)
		__dbg_break;

	ar_layer.pos = cur_layer.pos;
	ar_layer.sz = cur_layer.sz;
	ar_layer.grid_x = cur_layer.grid_x;
	ar_layer.grid_y = cur_layer.grid_y;

	for c in 0..cur_layer.total_of_used_cells
	{
		cur_cell: = ptr_offset(cur_ptr, cast(u64)c, sp_cell);
		x_grid: = cur_cell.grid_x;
		y_grid: = cur_cell.grid_y;

		cell_tex_name: = cast(str_lit)ptr_offset(str_tbl, cur_cell.tex_name, u8);

		tex_found:*texture_info = nil;
		for t in* textures
		{
			if str_cmp(t.name, cell_tex_name)
			{
				tex_found = t;
				break;
			}
		}
		ASSERT(tex_found != nil);

		cur_dst_cell: = ptr_offset(ar_layer.cells.data, x_grid + y_grid * cur_layer.grid_x, cell);


		cur_dst_cell.tp.SPRITE.x_offset = cur_cell.src_tex_offset_x;
		cur_dst_cell.tp.SPRITE.y_offset = cur_cell.src_tex_offset_y;
		cur_dst_cell.tp.SPRITE.tex = tex_found;
		cur_dst_cell.used = true;

		//cur_ptr = cast(*u8)ptr_offset(cur_ptr, 1, sp_cell);
	}
	return ar_layer;
}

is_ast_word::fn(n : *ast_rep, str : str_lit) ! bool
{
	return n.type == ast_type.WORD && n.WORD.str == str
}
is_ast_num::fn(n : *ast_rep, num : s32) ! bool
{
	return n.type == ast_type.INT && n.INT.num == num
}
WrapCoord::fn(coord:s32, size:s32)!s32
{
	aux := ((coord % size) + size)
	return  aux % size;
}

get_pixel_idx::fn(thispx:s32, thispy:s32, thistex : *texture_info)! u32
{
	channels_size:=cast(s32)get_tex_pixel_stride(thistex)
	return cast(u32)((thispy * cast(s32)thistex.width + thispx) * channels_size)
}
GetPixel::fn(thispx:s32, thispy:s32, thistex : *texture_info)! _vec
{
	ret:_vec=?
	idx:= get_pixel_idx(thispx, thispy, thistex)

	on thistex.channels
	{
	1
	{
		on thistex.channel_size
		{
		gen_texture_size.BYTE
		{
			ptr := cast(u32)*ptr_offset(thistex.data, idx, u8)
			ret.x = cast(f32)ptr / 255.0
		}
		gen_texture_size.WORD
		{
			ptr := cast(u32)*cast(*u16)ptr_offset(thistex.data, idx, u8)
			ret.x = cast(f32)ptr / 65000.0
		}
		default
		{
			__dbg_break
		}
		}
	}
	default
	{
		__dbg_break
	}
	}
	return ret
}
sample_texture_bilinear::fn(tex : *texture_info, u : f32, v : f32) ! _vec
{
	width:=cast(f32)tex.width
	height:=cast(f32)tex.height
	 // Normalize UV (wrap repeat)
    u = u - floor(u);
    v = v - floor(v);

    // Scale to texture space
    x := u * (width  - 1.0);
    y := v * (height - 1.0);

    x0 := cast(s32)floor(x);
    y0 := cast(s32)floor(y);
    x1 := x0 + 1;
    y1 := y0 + 1;

    // Wrap or clamp coordinates
    x0 = WrapCoord(x0, cast(s32)width)
    x1 = WrapCoord(x1, cast(s32)width)
    y0 = WrapCoord(y0, cast(s32)height)
    y1 = WrapCoord(y1, cast(s32)height)

    tx := cast(f32)(x - floor(x))
    ty := cast(f32)(y - floor(y))


    c00 := GetPixel(x0, y0, tex);
    c10 := GetPixel(x1, y0, tex);
    c01 := GetPixel(x0, y1, tex);
    c11 := GetPixel(x1, y1, tex);

    // Bilinear interpolation
    c0:= mix(&c00, &c10, tx);
    c1:= mix(&c01, &c11, tx);
    return mix(&c0, &c1, ty);

}



OpenScene::fn(alloc : *mem_alloc, name : str_lit, layers : *dyn_array(*layer_sprites), textures : *dyn_array(texture_info))! *u8
{
	for l in *layers
