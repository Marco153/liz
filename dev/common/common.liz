linear_alloc :struct(T)
{
	start : *T,
	cur : u32,
	max : u32,
	#make_ptr_len(start, cur)
}
toggle_flag::fn(out : *u32, flag : u32)
{
	val_aux := *out & flag
	*out = *out & ~flag

	val_aux = (~val_aux) & flag

	*out = *out | val_aux
}
LinearInit::fn{T}(linear_al : *linear_alloc(T), alloc : *mem_alloc, max : u32)
{
	linear_al.start = cast(*T)heap_alloc(alloc, max * sizeof(T))
	printf("init addr %\n", cast(u32)cast(u64)linear_al.start)
	linear_al.max = max
}
LinearSub::fn{T}(alloc : *linear_alloc(T), count : u32)
{
	ASSERT(((cast(s32)alloc.cur) - cast(s32)count) >= 0)
	alloc.cur -= count;
}
LinearGet::fn{T}(alloc : *linear_alloc(T), count : u32) ! *T
{
	ASSERT(cast(s32)alloc.cur >= 0)
	ASSERT((alloc.cur + 1) < alloc.max)
	ret := ptr_offset(alloc.start, alloc.cur, T)
	alloc.cur += count;
	return ret
}
