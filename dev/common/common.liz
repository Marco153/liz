}
IsTerminalCharater::fn(c : char) ! bool
{
	return c == ' || c == '$ || c == '@ || c == '* || c == '- || c == '/ || c == '. || c == ', || c == '+ || c == '? || c == '! || c == '= || c == ': || c == '[ || c == '] || c == '( || c == ')  || c == '} || c == '{ || c == '* || c == '\n || c == cast(char)0xd;
}

