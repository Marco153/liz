FreeSheet::fn(alloc : *mem_alloc,l : *layer_sprites)
{
	heap_free(l.cells.alloc, l.cells.data);
	heap_free(l.cells.alloc, l);
	FreeTexture(l.tex_id);
}
texture_info: struct
{
	name : str_lit,
	data : *u8,
	width : u32,
	height : u32,
	channels : u8,
	id : u64,
}
masked_info : struct
{
	is_masked : bool,
	using u :: union
	{
		stencil_val : u8,
		max_size : u64,
	}
}
layer_sprites:struct
{
	VERSION:const s32=0,
	version : u64,
	type: layer_enum,
	pixels_per_width : u8,
	obj_type : u8,
	
	pos : _vec,
	sz : _vec,
	grid_x : u32,
	grid_y : u32,
	tex_id : u64,
	cur_preview_x : u32,
	cur_preview_y : u32,
	cells: dyn_array(cell),

	preview_cells : dyn_array(cell),
	preview_grid_x : u32,
	preview_grid_y : u32,
	masked : masked_info,

	#serializable(type, pixels_per_width, pos, sz, grid_x, grid_y, cells)
}

col_cell:struct
{
	VERSION:const s32=0,
	version : u64,
	pos : _vec,
	sz : _vec,
	masked : masked_info,
}
sp_cell:struct
{
	VERSION:const s32=0;
	version : u64,
	tex_name: u64,
	grid_x : u32,
	grid_y : u32,

	src_tex_offset_x : u32,
	src_tex_offset_y : u32,
	masked : masked_info,
	#serializable(grid_x, grid_y, src_tex_offset_x, src_tex_offset_y)
}
obj_cell:struct
{
	VERSION:const s32=0,
	version : u64,
	type : layer_obj_enum,
	using u::union
	{
		enemy_type : enemy_enum,
		interact_idx : u32,
		scene_character_start_idx : u32,
	};
	add_info : str_lit,
		
	using u2:: union
	{
		using st::struct
		{
			pos : _vec,
			sz : _vec,
		};
	}
	masked : masked_info,
}

layer_enum_cell:etruct
{
	SPRITE(
		x_offset : u32,
		y_offset : u32,
		sheet : *layer_sprites,
		tex: *texture_info,
		#serializable(x_offset, y_offset, sheet)
	),
	TEST(
		val : u32
		#serializable(val)
	),
	COL(
		pos : _vec,
		sz : _vec,
		#serializable(pos, sz)
	),
	OBJ(

		pos : _vec,
		sz : _vec,
		using type : layer_obj_enum2,
		#serializable(pos, sz, type)
	),
}
cell: struct
{
	sheet_idx: u32,
	used : bool,
	tp : layer_enum_cell,
	using tp,
	/*
	using u ::union
	{
		tex: *texture_info,
		col : col_cell,
		obj:obj_cell,
		sheet : *layer_sprites,
	};
	using u2::union
	{
		max_sz : u64,
		using pos_::struct
		{
			x_offset : u32,
			y_offset : u32,
		}
	}
	*/
	masked : masked_info,
	#serializable(tp, masked)
}
sheet_file_header:struct
{
	total_layers : u32,
	str_tbl_offset : u32,
	str_tbl_sz : u32,
	cell_sz : u32,

};
aux_cell_info:struct
{
	version : u64,
	using u :: union
	{
		col:col_cell,
		obj: obj_cell,
		sp:sp_cell;
	};
	masked : masked_info,
};


NewEntSpriteSheet::fn(alloc: *mem_alloc, grid_x : u32, grid_y : u32, pixels_per_width : u32, out : *layer_sprites) 
{
	ASSERT(out)
	out.grid_x = grid_x;
	out.grid_y = grid_y;
	out.pixels_per_width = cast(u8)pixels_per_width;
	out.tex_id = GenRawTexture(grid_x * pixels_per_width, grid_y * pixels_per_width);
	sz: = grid_x * grid_y;
	dyn_init2(&out.cells, sz, alloc);
	out.cells.count = sz;
}

CreateSpriteSheetFromLayer::fn(alloc : *mem_alloc, cur_layer : *aux_layer_info_struct, str_tbl : *u8, textures : *dyn_array(texture_info)) ! *layer_sprites
{
	cur_ptr := cast(*u8)ptr_offset(cur_layer, 1, aux_layer_info_struct);

	ar_layer := cast(*layer_sprites)heap_alloc(alloc, sizeof(layer_sprites));
	ar_layer.type = cur_layer.type;
	ar_layer.obj_type = cur_layer.obj_type;
	ar_layer.pixels_per_width = cur_layer.pixels_per_width;
	//NewEntSpriteSheet(alloc, 8, 8, cur_layer.pixels_per_width, ar_layer);
	sz: = cur_layer.grid_x * cur_layer.grid_y;
	dyn_init2(&ar_layer.cells, sz, alloc);

	regrow(&ar_layer.cells, cur_layer.grid_x * cur_layer.grid_y);
	
	ar_layer.tex_id = LoadSheetFromLayer(cur_layer, str_tbl);

	if cur_layer.cell_sz != sizeof(sp_cell)
		__dbg_break;

	ar_layer.pos = cur_layer.pos;
	ar_layer.sz = cur_layer.sz;
	ar_layer.grid_x = cur_layer.grid_x;
	ar_layer.grid_y = cur_layer.grid_y;

	for c in 0..cur_layer.total_of_used_cells
	{
		cur_cell: = ptr_offset(cur_ptr, cast(u64)c, sp_cell);
		x_grid: = cur_cell.grid_x;
		y_grid: = cur_cell.grid_y;

		cell_tex_name: = cast(str_lit)ptr_offset(str_tbl, cur_cell.tex_name, u8);

		tex_found:*texture_info = nil;
		for t in* textures
		{
			if str_cmp(t.name, cell_tex_name)
			{
				tex_found = t;
				break;
			}
		}
		ASSERT(tex_found != nil);

		cur_dst_cell: = ptr_offset(ar_layer.cells.data, x_grid + y_grid * cur_layer.grid_x, cell);


		cur_dst_cell.tp.SPRITE.x_offset = cur_cell.src_tex_offset_x;
		cur_dst_cell.tp.SPRITE.y_offset = cur_cell.src_tex_offset_y;
		cur_dst_cell.tp.SPRITE.tex = tex_found;
		cur_dst_cell.used = true;

		//cur_ptr = cast(*u8)ptr_offset(cur_ptr, 1, sp_cell);
	}
	return ar_layer;
}

is_ast_word::fn(n : *ast_rep, str : str_lit) ! bool
{
	return n.type == ast_type.WORD && n.WORD.str == str
}
is_ast_num::fn(n : *ast_rep, num : s32) ! bool
{
	return n.type == ast_type.INT && n.INT.num == num
}




OpenScene::fn(alloc : *mem_alloc, name : str_lit, layers : *dyn_array(*layer_sprites), textures : *dyn_array(texture_info))! *u8
{
	for l in *layers
	{
		if l.type == layer_enum.SPRITE
		{
			for sh in l.cells
			{
				//FreeSheet(alloc, sh.sheet);
				FreeTexture(sh.tp.SPRITE.sheet.tex_id);
			}
		}
	}


	aux_buffer : [64]char;
	sprintf(cast(*u8)aux_buffer[0], 64, "%%", "../scenes/", name);
	fl_sz: = GetFileSize(cast(str_lit) aux_buffer[0]);
	file: = heap_alloc(alloc, cast(u32)fl_sz + 1);
	ReadFile(cast(str_lit) aux_buffer[0], file);

	lang_stat : lang_state
	scp := new_scope(nil)
	tkns : dyn_array(token)
	pinfo : parse_info
	pinfo.tkns = &tkns
	
	Tokenize(&tkns, cast(str_lit)file)
	n := parse(&pinfo, 999, parser_op.GREATER_THAN)
	ast := parse_node_to_ast(&lang_stat, n, scp)


	/*
	ASSERT(n.type == node_type.BIN && n.BIN.op == cast(u32)token_type.EQUAL)
	ASSERT(n.BIN.lhs.type == node_type.WORD && n.BIN.lhs.WORD.str == "a")
	ASSERT(n.BIN.rhs.type == node_type.INT && n.BIN.rhs.INT.num == 2)

	globals.nodes_alloc.cur = 0;

	str:string

	target_str := "a = 2, b = 3"
	Tokenize(&tkns, target_str)
	pinfo.cur_tkn = 0
	n = parse(&pinfo, 999, parser_op.GREATER_THAN)

	ASSERT(is_node_bin(n, cast(u32)token_type.COMMA))
	ASSERT(is_node_bin(n.BIN.lhs, cast(u32)token_type.EQUAL))
	ASSERT(is_node_bin(n.BIN.rhs, cast(u32)token_type.EQUAL))

	ASSERT(is_node_word(n.BIN.lhs.BIN.lhs, "a"))
	ASSERT(is_node_num(n.BIN.lhs.BIN.rhs, 2))

	ASSERT(is_node_word(n.BIN.rhs.BIN.lhs, "b"))
	ASSERT(is_node_num(n.BIN.rhs.BIN.rhs, 3))

	node_to_string(n, &str)
	ASSERT(str == target_str)


	target_str = "a = [1, 2]"
	Tokenize(&tkns, target_str)
	pinfo.cur_tkn = 0
	n = parse(&pinfo, 999, parser_op.GREATER_THAN)

	ASSERT(is_node_bin(n, cast(u32)token_type.EQUAL))
	ASSERT(is_node_word(n.BIN.lhs, "a"))
	ASSERT(n.BIN.rhs.type == node_type.INDEX)

	str.data.count = 0
	node_to_string(n, &str)
	ASSERT(str == target_str)

	target_str = "\{a = [1, 2]\}"
	Tokenize(&tkns, target_str)
	pinfo.cur_tkn = 0
	n = parse(&pinfo, 999, parser_op.GREATER_THAN)

	str.data.count = 0
	node_to_string(n, &str)
	ASSERT(str == target_str)


	target_str = "\{\{a}, \{d}\}"
	Tokenize(&tkns, target_str)
	pinfo.cur_tkn = 0
	n = parse(&pinfo, 999, parser_op.GREATER_THAN)

	str.data.count = 0
	node_to_string(n, &str)
	ASSERT(str == target_str)

	target_str = "a, b, c, d, e, f, g"
	Tokenize(&tkns, target_str)
	pinfo.cur_tkn = 0
	n = parse(&pinfo, 999, parser_op.GREATER_THAN)

	str.data.count = 0
	node_to_string(n, &str)
	ASSERT(str == target_str)

	ast := parse_node_to_ast(n, root)
	str.data.count = 0
	ast_to_string(ast, &str)
	cstr := cast(str_lit)LinearGet(&globals.temp_alloc, cast(u32)(str.data.count + 1))
	memcpy(cstr, str.data.data, str.data.count)
	*cstr[str.data.count] = cast(char)0


	globals.temp_alloc.cur = 0
	globals.nodes_alloc.cur = 0


	str.data.count = 0
	pinfo.cur_tkn = 0
	*ptr_offset(file, fl_sz, u8) = 0
	Tokenize(&tkns, cast(str_lit)file)

	n = parse(&pinfo, 999, parser_op.GREATER_THAN)
	ast = parse_node_to_ast(n)

	*/

	return file;
	
}

GetCharTextureIdx::fn(ch : char ) ! u32
{
	ch_idx := cast(u8)ch - 'a;
	if (cast(char)ch) == ',
		ch_idx = 26;
	else if (cast(char)ch) == '.
		ch_idx = 27;
	else if (cast(char)ch) == '?
		ch_idx = 28;
	else if (cast(char)ch) == '!
		ch_idx = 29;
	else if ch >= '0 && ch <= '9
	{
		ch_idx = 30 + cast(u8)ch - '0;
	}

	return ch_idx;
}
maxf::fn(a :f32, b :f32)!f32
{
	if a > b return a;
    return b;

}
abss32::fn(a :s32)!s32
{
	if a < 0 return -a;
    return a;

}
minf::fn(a :f32, b :f32)!f32
{
	if a > b return b;
    return a;
}





