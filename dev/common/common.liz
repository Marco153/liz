set_uniform_v4::fn(mat: *material_info, ent : *entity, u_name : str_lit, v : *_vec)
{
	inst :*material_instance= mat.instances[cast(u64)ent.in_material_instance]
	idx :u64
	for u in mat.uniforms
	{
		if u.name == u_name
		{
			break;
		}
		idx++
	}

	u_target := inst.uniforms[idx]
	u_target.v = *v
}
