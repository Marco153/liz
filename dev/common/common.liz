chunk_col_info :struct
{
	tris : dyn_array(u32)
	verts_mesh_idx : u32
	pos_x : f32
	pos_y : f32

	using uup :: union
	{
		up_neighbor : s32
		st ::struct
		{
			mx : u8
			my : u8
			cx : u8
			cy : u8
		}
	}
	down_neighbor: s32
	using uleft :: union
	{
		left_neighbor : s32
		st_2 ::struct
		{
			mx : u8
			my : u8
			cx : u8
			cy : u8
		}
	}
	using uright :: union
	{
		right_neighbor : s32
		st_3 ::struct
		{
			mx : u8
			my : u8
			cx : u8
			cy : u8
		}
	}

}
