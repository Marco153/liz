linear_alloc :struct(T)
{
	start : *T,
	cur : u32,
	max : u32,
	#make_ptr_len(start, cur)
}
LinearInit::fn{T}(linear_al : *linear_alloc(T), alloc : *mem_alloc, max : u32)
{
	linear_al.start = cast(*T)heap_alloc(alloc, max * sizeof(T))
	printf("init addr %\n", cast(u32)cast(u64)linear_al.start)
	linear_al.max = max
}
LinearGet::fn{T}(alloc : *linear_alloc(T), count : u32) ! *T
{
	ASSERT((alloc.cur + 1) < alloc.max)
	ret := ptr_offset(alloc.start, alloc.cur, T)
	alloc.cur += count;
	return ret
}
global_struct : struct
{
	entities : linear_alloc(entity),
	str_alloc : linear_alloc(u8),
	temp_alloc : linear_alloc(u8),
	allocs_occured : linear_alloc(*u8),
	nodes_alloc : linear_alloc(node),
	ast_alloc : linear_alloc(ast_rep),

	after_init : bool,

	timer : f32,
	alloc : *mem_alloc,
	args : rel_array(var_arg)

	cube_verts : [8]_vec
	gjk : *void
	ctx : *void

	mx : f32
	my : f32
}
