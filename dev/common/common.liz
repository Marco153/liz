DECL_PTR_HAS_LEN :const s32= 0x80

TP_STRCT_ETRUCT:const s32= 0x10
TP_STRCT_IS_DYN_ARRAY :const s32= 0x20
TP_STRCT_HAS_SERIALIZABLE_FUNC :const s32= 0x40

type_data:struct
{
	using u::union
	{
		// entries is how many members a strct has
		entries : u32,
		strct : *type_data,
	},
	strct_sz : u64,
	offset : u64,
	ptr : u8,
	ser_func : *void,
	tp : type_enum,
	flags : u32,
	name : rel_string,
	decl_offset_for_ptr_len : u32,

}

#assign_ser_func(dyn_array(cell), serialize_ar_cell)

serialize_ar_cell::fn(buffer : *dyn_array(char), data : *void, tab : u8)
{
	len: = *ptr_offset(data, 1, u64)
	ptr : = *ptr_offset(data, 0, u64)

	if len <= 0
	{
		return
	}


	cell_tp := GetTypeData(cell)
	for i in 0..len
	{
		ptr_cell := ptr_offset(ptr, i, cell)

		if !ptr_cell.used
			continue

		Serialize(buffer, cell_tp, ptr_cell, tab, nil)
	}
}


IsTkn::fn(tkns : *dyn_array(token), cur_tkn : u64, expected : u32) ! bool
{
	if (*tkns)[cur_tkn].type == cast(token_type)expected
		return true;
	return false
}
ExpectTkn::fn(tkns : *dyn_array(token), cur_tkn : *u64, expected : u32) ! *token 
{
	ASSERT((*tkns)[*cur_tkn].type == cast(token_type)expected)
	ret := tkns[*cur_tkn]
	(*cur_tkn)++;
	return ret
}
DeserializeStruct::fn(tkns : *dyn_array(token), cur_tkn : *u64, type : *type_data, data : *void)
{
	ExpectTkn(tkns, cur_tkn, cast(u32)token_type.OPEN_CURLY)

	if type.tp == type_enum.TYPE_STRUCT
		type = type.strct
	
	while true && *cur_tkn < tkns.count
	{
		type_found : *type_data
		word := ExpectTkn(tkns, cur_tkn, cast(u32)token_type.WORD)

		name : *string= &word.type.WORD.str

		for i in 0..type.entries
		{
			cur_tp := ptr_offset(type, 1 + i, type_data)
			if *name == cur_tp.name
			{
				type_found = cur_tp
				break;
			}
		}
		ASSERT(type_found != nil)
			
		ExpectTkn(tkns, cur_tkn, cast(u32)token_type.EQUAL)

		DeserializeVar(tkns, cur_tkn, type_found, ptr_offset(data, type_found.offset, u8), name)

		if IsTkn(tkns, *cur_tkn, cast(u32)token_type.CLOSE_CURLY)
			break;
	}
	ExpectTkn(tkns, cur_tkn, cast(u32)token_type.CLOSE_CURLY)
}

DeserializeVar::fn(tkns : *dyn_array(token), cur_tkn : *u64, type : *type_data, data : *void, var_name : *string)
{
	if is_flag_on(type.flags, DECL_PTR_HAS_LEN)
	{

		len := *cast(*u32)ptr_offset(data, type.decl_offset_for_ptr_len, u8)


		ExpectTkn(tkns, cur_tkn, cast(u32)token_type.OPEN_BRACKETS)

		aux_tp := *type;
		aux_tp.ptr--;

		//ptr_type_data := type;
		if type.tp == type_enum.TYPE_STRUCT
			aux_tp = *aux_tp.strct;
		for i in 0..len
		{
			addr := cast(u64)ptr_offset(data, cast(u64)i * type.strct_sz, u8);
			
			DeserializeVar(tkns, cur_tkn, &aux_tp, addr, var_name)
		}

		ExpectTkn(tkns, cur_tkn, cast(u32)token_type.CLOSE_BRACKETS)
	}
	else
	{
		if type.tp == type_enum.TYPE_STRUCT && is_flag_on(type.flags, TP_STRCT_ETRUCT)
		{
			type_name := ExpectTkn(tkns, cur_tkn, cast(u32)token_type.WORD)
			type_found : *type_data
			for i in 0..type.strct.entries
			{
				cur_tp := ptr_offset(type.strct, 1 + i, type_data)
				if type_name.type.WORD.str == cur_tp.name
				{
					type_found = cur_tp
					break;
				}
			}
			ASSERT(type_found != nil)
			
			DeserializeStruct(tkns, cur_tkn, type_found, ptr_offset(data, 4, u8))

		}
		else if type.tp == type_enum.TYPE_STRUCT 
		{
			DeserializeStruct(tkns, cur_tkn, type.strct, data)
		}
		else
		{
			int := ExpectTkn(tkns, cur_tkn, cast(u32)token_type.INT)
			if type.tp == type_enum.TYPE_U32
			{
				*cast(*u32)data  = cast(u32)int.type.INT.num
			}
			else if type.tp == type_enum.TYPE_S32
			{
				*cast(*s32)data  = cast(s32)int.type.INT.num
			}
			else
				__dbg_break;
		}
	}
}

DynArToStrLit::fn(ar : *dyn_array(char)) ! str_lit
{
	ret := heap_alloc(globals.alloc, cast(u32)ar.count + 1)
	memcpy(ret, ar.data, ar.count)
	*ptr_offset(ret, ar.count, u8) = 0
	return cast(str_lit)ret
}

Deserialize::fn(str : str_lit, type : *type_data, data : *void)
{
	__dbg_break
	
	globals.nodes_alloc.cur = 0
	globals.ast_alloc.cur = 0

	ln := str_ln(str)

	scp := new_scope(nil)

	lang_stat : lang_state
	tkns : dyn_array(token)
	Tokenize(&tkns, str)
	pinfo : parse_info
	pinfo.tkns = &tkns
	n := parse(&pinfo, 999, parser_op.GREATER_EQ)
	ast := parse_node_to_ast(&lang_stat, n, scp)

	ASSERT(ast.type == ast_type.SCOPE)


	cur_tkn : u64
	DeserializeStruct(&tkns, &cur_tkn, type, data);
	a := 0
}
InsertTab::fn(buffer : *dyn_array(char), tab : u8)
{
	for i in 0..tab
	{
		dyn_add(buffer, '\t)
	}
}
PushStr::fn(self : *string, str : *string)
{
	dyn_add_data(cast(*dyn_array(char))&self.data, str.data.data, cast(u32)str.data.count)
	globals.temp_alloc.cur -= cast(u32)str.data.count
}
PushStrLit::fn(self : *string, str : str_lit)
{
	ln := str_ln(str)

	dyn_add_data(cast(*dyn_array(char))&self.data, str, cast(u32)ln)
	globals.temp_alloc.cur -= cast(u32)ln
}
PushStrLit::fn(buffer : *dyn_array(char), str : str_lit)
{
	ln := str_ln(str)

	dyn_add_data(buffer, str, cast(u32)ln)
	globals.temp_alloc.cur -= cast(u32)ln
}
SerializeStruct::fn(buffer : *dyn_array(char), type : *type_data, data : *void, tab : u8)
{
	buffer_aux: [128] char;

	if type.ser_func
	{
		func : = cast(fn(*dyn_array(char), *void, u8))type.ser_func
		func(buffer, data, tab)
		return;
	}
	//InsertTab(buffer, tab)
	PushStrLit(buffer, "\{")

	serialized_var := false
	for i in 0..type.entries
	{
		cur_var: = ptr_offset(type, 1 + i, type_data);
		if is_flag_on(cur_var.flags, DECL_SERIALIZABLE)
		{
			final_ptr: = cast(u64)data + cur_var.offset
			if cur_var.ptr > 0
			{
				//__dbg_break
				ptr := cur_var.ptr
				while ptr > 0
				{
					final_ptr = *cast(*u64)final_ptr
					ptr--
				}
			}
			//InsertTab(buffer, tab + 1)
			Serialize(buffer, cur_var, final_ptr, tab + 1, &cur_var.name);
			dyn_add(buffer, ',)
			//dyn_add(buffer, '\n)
			serialized_var = true
		}
	}
	if serialized_var
	{
		buffer.count = buffer.count - 1
	}

	//dyn_add(buffer, '\n)
	//InsertTab(buffer, tab)
	PushStrLit(buffer, "\}")
	a:=0
}
SpreadRelString::fn macro(str : _expr)
{
	cast(str_lit)(cast(u64)&str + str.offset)
}
GetTypeSize::fn(tp : *type_data) !u64
{
	if tp.ptr > 0
		return 8;
	if tp.tp == type_enum.TYPE_U8 || tp.tp == type_enum.TYPE_S8
	{
		return 1;
	}
	else if tp.tp == type_enum.TYPE_U16 || tp.tp == type_enum.TYPE_S16
	{
		return 2;
	}
	else if tp.tp == type_enum.TYPE_U32 || tp.tp == type_enum.TYPE_S32 || tp.tp == type_enum.TYPE_ENUM
	{
		return 4;
	}
	else if tp.tp == type_enum.TYPE_U64 || tp.tp == type_enum.TYPE_S64
	{
		return 8;
	}
	else if tp.tp == type_enum.TYPE_VECTOR
	{
		return 16;
	}
	else if tp.tp == type_enum.TYPE_STRUCT
	{
		return tp.strct_sz;
	}
	// type not handled
	__dbg_break
	return 0
}
Serialize::fn(buffer : *dyn_array(char), type : *type_data, data : *void, tab : u8, name : *rel_string)
{
	buffer_aux: [128] char;
	if type.ser_func
	{
		__dbg_break
		func := cast(fn(*dyn_array(char), *void, u8))type.ser_func
		func(buffer, data, tab)
	}
	else if is_flag_on(type.flags, TP_STRCT_IS_DYN_ARRAY)
	{
		cur_tp_ptr: = ptr_offset(type, 1, type_data)

		len: = *ptr_offset(data, 1, u64)

		if len <= 0
		{
			return
		}
		data_ptr : = *ptr_offset(data, 0, u64)

		if name
			PushStrLit(buffer, "{*name} = ")

		cur_tp_ptr.ptr--
		tp_sz := GetTypeSize(cur_tp_ptr)
		cur_tp_ptr.ptr++

		//__dbg_break

		//InsertTab(buffer, tab)
		PushStrLit(buffer, "[")

		for i in 0..len
		{
			ptr := cur_tp_ptr.ptr
			serialize_ptr := cast(u64)ptr_offset(data_ptr, cast(u64)i * tp_sz, u8)
			while ptr > 1
			{
				serialize_ptr  = *cast(*u64)serialize_ptr
				ptr--
			}
			Serialize(buffer, cur_tp_ptr, serialize_ptr, tab + 1, nil)
			PushStrLit(buffer, ", ")
		}
		buffer.count -= 2

		//InsertTab(buffer, tab)
		PushStrLit(buffer, "]")
	}
	else
	{
		if type.tp == type_enum.TYPE_VECTOR
		{
			v := cast(*_vec)data
			sz := sprintf(buffer_aux, 128, "% = [%, %, %, %]", type.name, *cast(*u32)&v.x, 
						*cast(*u32)&v.y,
						*cast(*u32)&v.z,
						*cast(*u32)&v.w)

			dyn_add_data(buffer, buffer_aux, cast(u32)sz)

		}
		else if type.tp == type_enum.TYPE_STRUCT && is_flag_on(type.flags, TP_STRCT_ETRUCT)
		{
			idx: = *cast(*u32)data;

			st: = ptr_offset(type.strct, 2 + idx, type_data);
			//printf("{type.name}")
			sz:=sprintf(buffer_aux, 128,"% = %", type.name, st.name)
			dyn_add_data(buffer, buffer_aux, cast(u32)sz)
					
			SerializeStruct(buffer, st.strct, cast(u64)data + 4, tab);


			a: = 0;
		}
		else if type.tp == type_enum.TYPE_STRUCT_DECL && is_flag_on(type.flags, TP_STRCT_ETRUCT)
		{
			idx: = *cast(*u32)data;
			st: = ptr_offset(type, 2 + idx, type_data);
			//printf("{type.name}")
			sz:=sprintf(buffer_aux, 128,"%", type.name)
			dyn_add_data(buffer, buffer_aux, cast(u32)sz)
					
			SerializeStruct(buffer, st, cast(u64)data + 4, tab);


			a: = 0;
		}
		else if type.tp == type_enum.TYPE_STRUCT_DECL
		{
			SerializeStruct(buffer, type, cast(u64)data, tab);
		}
		else if type.tp == type_enum.TYPE_STRUCT
		{
			SerializeStruct(buffer, type.strct, cast(u64)data, tab);
		}
		else
		{
			///SerializeVar(buffer, type, cast(u64)data + type.offset);
			tp_sz := GetTypeSize(type)

			val :s64
			if tp_sz == 1
			{
				*cast(*u8)&val = *cast(*u8)data;
			}
			else if tp_sz == 2
			{
				*cast(*u16)&val = *cast(*u16)data;
			}
			else if tp_sz == 4
			{
				*cast(*u32)&val = *cast(*u32)data;
			}
			else if tp_sz == 8
			{
				*cast(*u64)&val = *cast(*u64)data;
			}

			sz : u64
			if name
				sz = sprintf(buffer_aux, 128, "% = %", *name,  val);
			else 
				sz = sprintf(buffer_aux, 128, "%",  val);
			dyn_add_data(buffer, buffer_aux, cast(u32)sz)
		}
	}
	a := 0
}

