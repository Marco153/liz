	{
		enemy_type : enemy_enum,
		interact_idx : u32,
		scene_character_start_idx : u32,
	};
	add_info : str_lit,
		
	using u2:: union
	{
		using st::struct
		{
			pos : _vec,
			sz : _vec,
		};
	}
	masked : masked_info,
}

layer_enum_cell:etruct
{
	SPRITE(
		x_offset : u32,
		y_offset : u32,
		sheet : *layer_sprites,
		tex: *texture_info,
		#serializable(x_offset, y_offset, sheet)
	),
	TEST(
		val : u32
		#serializable(val)
	),
	COL(
		pos : _vec,
		sz : _vec,
		#serializable(pos, sz)
	),
	OBJ(

		pos : _vec,
		sz : _vec,
		using type : layer_obj_enum2,
		#serializable(pos, sz, type)
	),
}
cell: struct
{
	sheet_idx: u32,
	used : bool,
	tp : layer_enum_cell,
	using tp,
	/*
	using u ::union
	{
		tex: *texture_info,
		col : col_cell,
		obj:obj_cell,
		sheet : *layer_sprites,
	};
	using u2::union
	{
		max_sz : u64,
		using pos_::struct
		{
			x_offset : u32,
			y_offset : u32,
		}
	}
	*/
	masked : masked_info,
	#serializable(tp, masked)
}
