IntToAst::fn(i : s32)!*ast_rep
{
	num := new_ast2()
	num.type = ast_type.INT
	num.INT.num = i
	return num
}
AssignmentToAst::fn(name : str_lit, rhs : *ast_rep)!*ast_rep
{
	ret := new_ast2()
	ret.type = ast_type.BIN

	name_ast := new_ast2()
	name_ast.type = ast_type.WORD
	AssignStr(&name_ast.WORD.str, name)

	ret.BIN.op = cast(u32)token_type.EQUAL
	dyn_add(&ret.BIN.expr, name_ast)
	dyn_add(&ret.BIN.expr, rhs)

	return ret
}
VecToAst::fn(v : *_vec)!*ast_rep
{
	ret := new_ast2()

	ret.type = ast_type.SCOPE

	op := new_ast2()
	op.type = ast_type.BIN
	op.BIN.op = cast(u32)token_type.COMMA

	dyn_add(&op.BIN.expr, IntToAst(*cast(*s32)&v.x))
	dyn_add(&op.BIN.expr, IntToAst(*cast(*s32)&v.y))
	dyn_add(&op.BIN.expr, IntToAst(*cast(*s32)&v.z))
	dyn_add(&op.BIN.expr, IntToAst(*cast(*s32)&v.w))

	dyn_add(&ret.SCOPE.stmnts, op)

	return ret
}
AssetIndexAssignmentToAst::fn(name : str_lit, idx : *asset_index)!*ast_rep
{
	scp := new_ast2()

	scp.type = ast_type.SCOPE

	cid := &globals.assets[cast(u64)idx.asset_idx].cid

	buffer:[13]char
	memcpy(buffer[0], &cid.name, 12)
	*buffer[13] = cast(char)0

	dyn_add(&scp.SCOPE.stmnts, StrLitAssignmentToAst("name", cast(str_lit)buffer[0]))
	dyn_add(&scp.SCOPE.stmnts, S32AssignmentToAst("a_type", cast(s32)cid.id.a_type))

	return AssignmentToAst(name, scp)
}
S32AssignmentToAst::fn(name : str_lit, rhs : s32)!*ast_rep
{
	num := new_ast2()
	num.type = ast_type.INT
	num.INT.num = rhs
	return AssignmentToAst(name, num)
}
StrLitAssignmentToAst::fn(name : str_lit, rhs : str_lit)!*ast_rep
{
	str_ast := new_ast2()
	str_ast.type = ast_type.STR_LIT
	AssignStr(&str_ast.STR_LIT.str, rhs)
	return AssignmentToAst(name, str_ast)
}
ArrayU32AssignmentToAst::fn(name : str_lit, rhs : *dyn_array(u32))!*ast_rep
{
	idx := new_ast2()
	idx.type = ast_type.INDEX

	if rhs.count > 0
	{
		bin := new_ast2()
		bin.type = ast_type.BIN
		bin.BIN.op = cast(u32)token_type.COMMA

		idx.INDEX.rhs = bin
		for v in *rhs
		{
			n := new_ast2()
			n.type = ast_type.INT
			n.INT.num = cast(s64)*v
			dyn_add(&bin.BIN.expr, n)
		}
	}
	return AssignmentToAst(name, idx)
}
VecAssignmentToAst::fn(name : str_lit, rhs : *_vec)!*ast_rep
{
	v := VecToAst(rhs)
	return AssignmentToAst(name, v)
}
SerializeEnt::fn(ent : *entity, idx : u64) ! *ast_rep
{
	al := globals.alloc
	ret := new_ast2()

	ret.type = ast_type.SCOPE
	
	dyn_add(&ret.SCOPE.stmnts, S32AssignmentToAst("flags", cast(s32)ent.flags))
	if(is_flag_on(ent.flags, ENTITY_DONT_FREE))
	{
		dyn_add(&ret.SCOPE.stmnts, S32AssignmentToAst("idx", cast(s32)idx))
	}
	dyn_add(&ret.SCOPE.stmnts, StrLitAssignmentToAst("name", ent.name))
	dyn_add(&ret.SCOPE.stmnts, VecAssignmentToAst("pos", &ent.pos))
	dyn_add(&ret.SCOPE.stmnts, VecAssignmentToAst("size", &ent.size))
	dyn_add(&ret.SCOPE.stmnts, VecAssignmentToAst("pivot", &ent.pivot))
	dyn_add(&ret.SCOPE.stmnts, VecAssignmentToAst("col_size", &ent.col_size))
	dyn_add(&ret.SCOPE.stmnts, VecAssignmentToAst("col_offset", &ent.col_offset))
	dyn_add(&ret.SCOPE.stmnts, VecAssignmentToAst("rot", &ent.rot))
	dyn_add(&ret.SCOPE.stmnts, VecAssignmentToAst("color", &ent.color))
	dyn_add(&ret.SCOPE.stmnts, VecAssignmentToAst("sec_color", &ent.sec_color))
	dyn_add(&ret.SCOPE.stmnts, S32AssignmentToAst("type", cast(s32)ent.type))
	dyn_add(&ret.SCOPE.stmnts, S32AssignmentToAst("hp", *cast(*s32)&ent.hp))
	dyn_add(&ret.SCOPE.stmnts, S32AssignmentToAst("layer", cast(s32)ent.layer))
	dyn_add(&ret.SCOPE.stmnts, S32AssignmentToAst("is_active", cast(s32)ent.is_active))
	dyn_add(&ret.SCOPE.stmnts, S32AssignmentToAst("c_type", cast(s32)ent.c_type))
	dyn_add(&ret.SCOPE.stmnts, S32AssignmentToAst("is_trigger", cast(s32)ent.is_trigger))
	//dyn_add(&ret.SCOPE.stmnts, S32AssignmentToAst("material_idx", cast(s32)ent.material_idx))
	dyn_add(&ret.SCOPE.stmnts, S32AssignmentToAst("is_static", cast(s32)ent.is_static))
	dyn_add(&ret.SCOPE.stmnts, ArrayU32AssignmentToAst("remove_from", cast(*dyn_array(u32))&ent.remove_from))
	
	aux_ast :*ast_rep
	aux_ast = AssetIndexAssignmentToAst("model", &ent.model)
	dyn_add(&ret.SCOPE.stmnts, aux_ast)

	aux_ast = AssetIndexAssignmentToAst("cl3d", &ent.cl3d)
	dyn_add(&ret.SCOPE.stmnts, aux_ast)
	if is_flag_on(ent.flags, ENTITY_HAS_TEXTURE)
	{
		aux_ast = AssetIndexAssignmentToAst("tex_id", &ent.tex_id)
		dyn_add(&ret.SCOPE.stmnts, aux_ast)
	}
	if(is_flag_on(ent.flags, ENTITY_CUSTOM_SHADER))
	{
		scp := new_ast2()
		scp.type = ast_type.SCOPE
		aux_ast = AssetIndexAssignmentToAst("idx", &ent.material_idx)
		dyn_add(&scp.SCOPE.stmnts, aux_ast)

		m := get_material_ptr(&ent.material_idx)
		inst := m.instances[cast(u64)ent.in_material_instance]
		prev_sz := globals.temp_alloc.cur
		for i in 0..m.uniforms.count
		{
			globals.temp_alloc.cur = prev_sz 

			u_with_name := m.uniforms[cast(u64)i]
			u_with_val := inst.uniforms[cast(u64)i]
			/*
			if u_with_name.name == "sky_color"
			{
				__dbg_break
			}
			*/
			on u_with_name.tp.type
			{
			lang_type_type.STATIC_ARRAY
			{

			}
			lang_type_type.MAT4
			{

			}
			lang_type_type.SAMPLER2D
			{
				dyn_add(&scp.SCOPE.stmnts, AssetIndexAssignmentToAst("{u_with_name.name}", &u_with_val.tex))
			}
			lang_type_type.V4, lang_type_type.V3, lang_type_type.V2
			{
				dyn_add(&scp.SCOPE.stmnts, VecAssignmentToAst("{u_with_name.name}", &u_with_val.v))
			}
			default
			{
				__dbg_break
			}
			}
		}

		dyn_add(&ret.SCOPE.stmnts, AssignmentToAst("material_idx", scp))
	}
	on ent.type
	{
	ent_type.ITEM
	{
		dyn_add(&ret.SCOPE.stmnts, S32AssignmentToAst("item_type", cast(s32)ent.item_type))

	}
	ent_type.EVENT
	{
		ev := &ent.event
		scp := new_ast2()
		scp.type = ast_type.SCOPE

		type_call := new_ast2()
		type_call.type = ast_type.CALL

		name_type := new_ast2()
		name_type.type = ast_type.WORD

		on ev.type
		{
		entity_event_type.BRIDGE_ROTATE
		{
			AssignStr(&name_type.WORD.str, "BRIDGE_ROTATE")
			dyn_add(&type_call.CALL.args, S32AssignmentToAst("ent_id", cast(s32)ev.BRIDGE_ROTATE.ent_id))
		}
		default
		{
			__dbg_break
		}
		}
		type_call.CALL.name = name_type

		dyn_add(&scp.SCOPE.stmnts, AssignmentToAst("type", type_call))
		dyn_add(&scp.SCOPE.stmnts, S32AssignmentToAst("one_time", cast(s32)ev.one_time))

		dyn_add(&ret.SCOPE.stmnts, AssignmentToAst("event", scp))
	}
	ent_type.ENEMY
	{
		mov := ent.en_info
		scp := new_ast2()
		scp.type = ast_type.SCOPE
		dyn_add(&scp.SCOPE.stmnts, VecAssignmentToAst("origin_pos", &mov.origin_pos))

		dyn_add(&ret.SCOPE.stmnts, AssignmentToAst("en_info", scp))
	}
	}
	if ent.cols.count > 0
	{
		scp := new_ast2()
		scp.type = ast_type.SCOPE
		for c in ent.cols
		{
			cur_scp := new_ast2()
			cur_scp.type = ast_type.SCOPE
			dyn_add(&cur_scp.SCOPE.stmnts, S32AssignmentToAst("type", cast(s32)c.type))
			if c.type == col_type.MESH
			{
				a_idx :asset_index
				a_idx.asset_idx = cast(u32)c.MESH.info.model_idx
				aux_ast = AssetIndexAssignmentToAst("model", &a_idx)
				dyn_add(&cur_scp.SCOPE.stmnts, aux_ast)

			}
			dyn_add(&cur_scp.SCOPE.stmnts, VecAssignmentToAst("pos", &c.pos))
			dyn_add(&cur_scp.SCOPE.stmnts, VecAssignmentToAst("size", &c.size))

			dyn_add(&scp.SCOPE.stmnts, cur_scp)
		}
		dyn_add(&ret.SCOPE.stmnts, AssignmentToAst("cols", scp))
	}



	return ret
}
Serialize::fn(buffer : *dyn_array(char), type : *type_data, data : *void, tab : u8, name : *rel_string)
{
	buffer_aux: [128] char;
	if type.ser_func
	{
		__dbg_break
		func := cast(fn(*dyn_array(char), *void, u8))type.ser_func
		func(buffer, data, tab)
	}
	else if is_flag_on(type.flags, TP_STRCT_IS_DYN_ARRAY)
	{
		cur_tp_ptr: = ptr_offset(type, 1, type_data)

		len: = *ptr_offset(data, 1, u64)

		if len <= 0
		{
			return
		}
		data_ptr : = *ptr_offset(data, 0, u64)

		if name
			PushStrLit(buffer, "{*name} = ")

		cur_tp_ptr.ptr--
		tp_sz := GetTypeSize(cur_tp_ptr)
		cur_tp_ptr.ptr++

		//__dbg_break

		//InsertTab(buffer, tab)
		PushStrLit(buffer, "[")

		for i in 0..len
		{
			ptr := cur_tp_ptr.ptr
			serialize_ptr := cast(u64)ptr_offset(data_ptr, cast(u64)i * tp_sz, u8)
			while ptr > 1
			{
				serialize_ptr  = *cast(*u64)serialize_ptr
				ptr--
			}
			Serialize(buffer, cur_tp_ptr, serialize_ptr, tab + 1, nil)
			PushStrLit(buffer, ", ")
		}
		buffer.count -= 2

		//InsertTab(buffer, tab)
		PushStrLit(buffer, "]")
	}
	else
	{
		if type.tp == type_enum.TYPE_VECTOR
		{
			v := cast(*_vec)data
			sz := sprintf(buffer_aux, 128, "% = [%, %, %, %]", type.name, *cast(*u32)&v.x, 
						*cast(*u32)&v.y,
						*cast(*u32)&v.z,
						*cast(*u32)&v.w)

			dyn_add_data(buffer, buffer_aux, cast(u32)sz)

		}
		else if type.tp == type_enum.TYPE_STRUCT && is_flag_on(type.flags, TP_STRCT_ETRUCT)
		{
			idx: = *cast(*u32)data;

			st: = ptr_offset(type.strct, 2 + idx, type_data);
			//printf("{type.name}")
			sz:=sprintf(buffer_aux, 128,"% = %", type.name, st.name)
			dyn_add_data(buffer, buffer_aux, cast(u32)sz)
					
			SerializeStruct(buffer, st.strct, cast(u64)data + 4, tab);


			a: = 0;
		}
		else if type.tp == type_enum.TYPE_STRUCT_DECL && is_flag_on(type.flags, TP_STRCT_ETRUCT)
		{
			idx: = *cast(*u32)data;
			st: = ptr_offset(type, 2 + idx, type_data);
			//printf("{type.name}")
			sz:=sprintf(buffer_aux, 128,"%", type.name)
			dyn_add_data(buffer, buffer_aux, cast(u32)sz)
					
			SerializeStruct(buffer, st, cast(u64)data + 4, tab);


			a: = 0;
		}
		else if type.tp == type_enum.TYPE_STRUCT_DECL
		{
			SerializeStruct(buffer, type, cast(u64)data, tab);
		}
		else if type.tp == type_enum.TYPE_STRUCT
		{
			SerializeStruct(buffer, type.strct, cast(u64)data, tab);
		}
		else
		{
			///SerializeVar(buffer, type, cast(u64)data + type.offset);
			tp_sz := GetTypeSize(type)

			val :s64
			if tp_sz == 1
			{
				*cast(*u8)&val = *cast(*u8)data;
			}
			else if tp_sz == 2
			{
				*cast(*u16)&val = *cast(*u16)data;
			}
			else if tp_sz == 4
			{
				*cast(*u32)&val = *cast(*u32)data;
			}
			else if tp_sz == 8
			{
				*cast(*u64)&val = *cast(*u64)data;
			}

			sz : u64
			if name
				sz = sprintf(buffer_aux, 128, "% = %", *name,  val);
			else 
				sz = sprintf(buffer_aux, 128, "%",  val);
			dyn_add_data(buffer, buffer_aux, cast(u32)sz)
		}
	}
	a := 0
}
