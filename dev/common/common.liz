str_2_num::fn(buf : str_lit, buffer_sz : u32) ! s64
{

	aux_buffer : [64]u8;

	out_buffer : dyn_array(char);
	out_buffer.data = cast(*char)aux_buffer;
	out_buffer.count = 64;

	buffer : dyn_array(char);
	buffer.data = cast(*char)buf;
	buffer.count = buffer_sz;

	negative : bool
	if *buffer[0] == '-
	{
		negative = true;
		buffer.data = ptr_offset(buffer.data, 1 , char)
		buffer_sz--;
	}
	aux :u32= 1
	mul :s64= 1

	while aux < buffer_sz
	{
		mul = mul * 10
		aux++
	}

	num :s64= 0
	aux = 0
		
	
	while aux < buffer_sz
	{
		ch := *buffer[cast(u64)aux] - '0
		num = num + (cast(s64)ch * mul)
		mul = mul / 10
		aux++;
	}
	
	if negative
		num = num * -1
		
	return num
}
num_2_str::fn(num : s64, in_buf : *u8, buffer_sz : u32) ! u64
{
	i :u64= 0;
	written :u64= 0;
	aux_buffer : [64]u8;

	out_buffer : dyn_array(char);
	out_buffer.data = cast(*char)in_buf;
	out_buffer.count = buffer_sz;

	buffer : dyn_array(char);
	buffer.data = cast(*char)aux_buffer;
	buffer.count = 64;

	if num == 0
	{
		*out_buffer[0] = '0;
		return 1;
	}
	negative: = false;
	if num < 0
	{
		negative = true;
		num = num * -1;
	}


	while num != 0
	{
		mod := num % 10;
		*buffer[written] = cast(char)(cast(u8)'0 + cast(u8)mod);
		num = num / 10;
		written += 1;
	}

	aux_written_rev := cast(s64)written - 1;
	aux_written :u64= 0;
	if negative
	{
		*out_buffer[aux_written] = '-;
		aux_written++;
		written++;
	}
	while  aux_written_rev >= 0
	{

		dst :=out_buffer[aux_written]
		*dst = *buffer[cast(u64)aux_written_rev];
		aux_written_rev--;
		aux_written++;
	}
	return written;
}
sprintf_base::fn(buffer : *u8, bsz : u32, format : str_lit, __var_args : *rel_array(var_arg)) !u64
{
	format_ln: = str_ln(format);
	format_idx:u64 = 0;
	buffer_idx:u64 = 0;
	arg_idx:u64 = 0;
	aux_num_buffer: [64] u8;

	while format_idx < format_ln
	{

		if* ptr_offset(format, format_idx, char) == '%
		{
			cur_arg: = (*__var_args)[arg_idx];
			if* ptr_offset(format, format_idx + 1, char) == '*
			{
				if* ptr_offset(format, format_idx + 2, char) == 's
				{
					len: = cast(u32)cast(u64)cur_arg.val;

					arg_idx++;

					cur_arg = (*__var_args)[arg_idx];

					str_ptr: = cast(*u8)cur_arg.val

					dst : = ptr_offset(buffer, buffer_idx, u8);
					memcpy(dst, cast(*u8)str_ptr, len);
					buffer_idx += len
					//format_idx++;
					format_idx += 2;

				}
				else
					__dbg_break;
			}
			else if cur_arg.type == type_enum.TYPE_STRUCT
			{
				if cur_arg.type_info.name == "rel_string"
				{
					addr := cast(*u8)cur_arg.val

					offset := *cast(*u32)addr
					len := *cast(*u32)ptr_offset(addr, 1, u32)
					
					actual_str := ptr_offset(addr, offset, u8)

					dst : = ptr_offset(buffer, buffer_idx, u8);
					memcpy(dst, cast(*u8)actual_str, len);
					buffer_idx += len
				}
				else if cur_arg.type_info.name == "string"
				{
					addr := cast(*u8)cur_arg.val

					str := cast(*string)addr;

					len := str.data.count
					
					actual_str := str.data.data

					dst : = ptr_offset(buffer, buffer_idx, u8);
					memcpy(dst, cast(*u8)actual_str, len);
					buffer_idx += len
				}
			}
			else if cur_arg.type == type_enum.TYPE_STR_LIT
			{
				arg_str_ln: = str_ln(cast(str_lit)cur_arg.val);
				dst: = ptr_offset(buffer, buffer_idx, u8);
				ASSERT((buffer_idx + arg_str_ln) < bsz);
				memcpy(dst, cast(*u8)cur_arg.val, arg_str_ln);
				buffer_idx += arg_str_ln;
			}
			else if cur_arg.type == type_enum.TYPE_BOOL

			{
				true_str := "true"
				false_str := "false"
				ln :u64=0
				correct_str :str_lit
				
				val :=cast(u8)cast(u64)cur_arg.val
				if val == 0
				{
					correct_str = false_str
				}
				else if val == 1
				{
					correct_str = true_str
				}
				else
				{
					__dbg_break
				}
				ln = str_ln(correct_str)

				memcpy(ptr_offset(buffer, buffer_idx, u8), correct_str, ln);
				buffer_idx += ln;


			}
			else if cur_arg.type == type_enum.TYPE_F32

			{
				f := *cast(*f32)&cur_arg.val
				lhs := cast(s32)f
				rhs := cast(s32)((f - cast(f32)lhs)* 100.0)

				negative := false
				if rhs < 0 && lhs == 0
				{
					negative = true
				}
				if rhs < 0
				{
					rhs = rhs * -1
				}

				

				//if cast(s64)cur_arg.val == 32
					//__dbg_break
				num_ln: = num_2_str(cast(s64)lhs, aux_num_buffer[0], 16);
				if negative
				{
					*ptr_offset(buffer, buffer_idx, u8) = '-
					buffer_idx++
				}
				*ptr_offset(aux_num_buffer[0], num_ln, u8) = '.
				num_ln2: = num_2_str(cast(s64)rhs, aux_num_buffer[num_ln + 1], 16);

				memcpy(ptr_offset(buffer, buffer_idx, u8), aux_num_buffer, num_ln + num_ln2 + 1);
				buffer_idx += num_ln + num_ln2 + 1;


			}
			else if cur_arg.type == type_enum.TYPE_U32 || cur_arg.type == type_enum.TYPE_S32 ||
					cur_arg.type == type_enum.TYPE_U8 || cur_arg.type == type_enum.TYPE_S8 ||
					cur_arg.type == type_enum.TYPE_U16 || cur_arg.type == type_enum.TYPE_S16 ||
					cur_arg.type == type_enum.TYPE_U64 || cur_arg.type == type_enum.TYPE_S64 ||
					cur_arg.type == type_enum.TYPE_INT

			{

				//if cast(s64)cur_arg.val == 32
					//__dbg_break
				num_ln: = num_2_str(cast(s64)cur_arg.val, aux_num_buffer, 32);

				memcpy(ptr_offset(buffer, buffer_idx, u8), aux_num_buffer, num_ln);
				buffer_idx += num_ln;


			}
			else
			{
				// type not handled
				__dbg_break;
			}
			arg_idx++;
		}
		else
		{
			ASSERT((buffer_idx + 1) < bsz);
			*ptr_offset(buffer, buffer_idx, u8) = *ptr_offset(format, format_idx, u8);
			buffer_idx++;
		}
		format_idx++;
	}
	ASSERT(buffer_idx < bsz);
	*ptr_offset(buffer, buffer_idx, u8) = 0;
	tast: = 0;
	return buffer_idx;
}
sprintf_temp::fn(format : str_lit, ...) !str_lit
{
	buffer: [512] char;

	sz: = sprintf_base(buffer, 512, format, &__var_args);
	ret: = LinearGet(&globals.temp_alloc, cast(u32)sz + 1)
	memcpy(ret, buffer, cast(u32)sz + 1);
	return cast(str_lit)ret;
}
sprintf::fn(buffer : *u8, bsz : u32, format : str_lit, ...) !u64
{
	tp: = GetTypeData(entity)
	return sprintf_base(buffer, bsz, format, &__var_args);
}
printf::fn(format : str_lit, ...)
{
	prev_sz := globals.temp_alloc.cur
	buffer : [128]u8;
	sprintf_base(buffer, 128, format, &__var_args);
	PrintStr(cast(str_lit)buffer);
	globals.temp_alloc.cur = prev_sz 
}

DECL_FROM_USING :const s32= 0x2
DECL_PTR_HAS_LEN :const s32= 0x80
DECL_SERIALIZABLE:const s32= 0x200
DECL_IS_USING:const s32= 0x400

TP_STRCT_ETRUCT:const s32= 0x10
TP_STRCT_IS_DYN_ARRAY :const s32= 0x20
TP_STRCT_HAS_SERIALIZABLE_FUNC :const s32= 0x40

type_data:struct
{
	using u::union
	{
		// entries is how many members a strct has
		entries : u32,
		strct : *type_data,
	},
	strct_sz : u64,
	offset : u64,
	ptr : u8,
	ser_func : *void,
	tp : type_enum,
	flags : u32,
	name : rel_string,
	decl_offset_for_ptr_len : u32,

}

#assign_ser_func(dyn_array(cell), serialize_ar_cell)

serialize_ar_cell::fn(buffer : *dyn_array(char), data : *void, tab : u8)
{
	len: = *ptr_offset(data, 1, u64)
	ptr : = *ptr_offset(data, 0, u64)

	if len <= 0
	{
		return
	}


	cell_tp := GetTypeData(cell)
	for i in 0..len
	{
		ptr_cell := ptr_offset(ptr, i, cell)

		if !ptr_cell.used
			continue

		Serialize(buffer, cell_tp, ptr_cell, tab, nil)
	}
}


IsTkn::fn(tkns : *dyn_array(token), cur_tkn : u64, expected : u32) ! bool
{
	if (*tkns)[cur_tkn].type == cast(token_type)expected
		return true;
	return false
}
ExpectTkn::fn(tkns : *dyn_array(token), cur_tkn : *u64, expected : u32) ! *token 
{
	ASSERT((*tkns)[*cur_tkn].type == cast(token_type)expected)
	ret := tkns[*cur_tkn]
	(*cur_tkn)++;
	return ret
}
DeserializeStruct::fn(tkns : *dyn_array(token), cur_tkn : *u64, type : *type_data, data : *void)
{
	ExpectTkn(tkns, cur_tkn, cast(u32)token_type.OPEN_CURLY)

	if type.tp == type_enum.TYPE_STRUCT
		type = type.strct
	
	while true && *cur_tkn < tkns.count
	{
		type_found : *type_data
		word := ExpectTkn(tkns, cur_tkn, cast(u32)token_type.WORD)

		name : *string= &word.type.WORD.str

		for i in 0..type.entries
		{
			cur_tp := ptr_offset(type, 1 + i, type_data)
			if *name == cur_tp.name
			{
				type_found = cur_tp
				break;
			}
		}
		ASSERT(type_found != nil)
			
		ExpectTkn(tkns, cur_tkn, cast(u32)token_type.EQUAL)

		DeserializeVar(tkns, cur_tkn, type_found, ptr_offset(data, type_found.offset, u8), name)

		if IsTkn(tkns, *cur_tkn, cast(u32)token_type.CLOSE_CURLY)
			break;
	}
	ExpectTkn(tkns, cur_tkn, cast(u32)token_type.CLOSE_CURLY)
}

DeserializeVar::fn(tkns : *dyn_array(token), cur_tkn : *u64, type : *type_data, data : *void, var_name : *string)
{
	if is_flag_on(type.flags, DECL_PTR_HAS_LEN)
	{

		len := *cast(*u32)ptr_offset(data, type.decl_offset_for_ptr_len, u8)


		ExpectTkn(tkns, cur_tkn, cast(u32)token_type.OPEN_BRACKETS)

		aux_tp := *type;
		aux_tp.ptr--;

		//ptr_type_data := type;
		if type.tp == type_enum.TYPE_STRUCT
			aux_tp = *aux_tp.strct;
		for i in 0..len
		{
			addr := cast(u64)ptr_offset(data, cast(u64)i * type.strct_sz, u8);
			
			DeserializeVar(tkns, cur_tkn, &aux_tp, addr, var_name)
		}

		ExpectTkn(tkns, cur_tkn, cast(u32)token_type.CLOSE_BRACKETS)
	}
	else
	{
		if type.tp == type_enum.TYPE_STRUCT && is_flag_on(type.flags, TP_STRCT_ETRUCT)
		{
			type_name := ExpectTkn(tkns, cur_tkn, cast(u32)token_type.WORD)
			type_found : *type_data
			for i in 0..type.strct.entries
			{
				cur_tp := ptr_offset(type.strct, 1 + i, type_data)
				if type_name.type.WORD.str == cur_tp.name
				{
					type_found = cur_tp
					break;
				}
			}
			ASSERT(type_found != nil)
			
			DeserializeStruct(tkns, cur_tkn, type_found, ptr_offset(data, 4, u8))

		}
		else if type.tp == type_enum.TYPE_STRUCT 
		{
			DeserializeStruct(tkns, cur_tkn, type.strct, data)
		}
		else
		{
			int := ExpectTkn(tkns, cur_tkn, cast(u32)token_type.INT)
			if type.tp == type_enum.TYPE_U32
			{
				*cast(*u32)data  = cast(u32)int.type.INT.num
			}
			else if type.tp == type_enum.TYPE_S32
			{
				*cast(*s32)data  = cast(s32)int.type.INT.num
			}
			else
				__dbg_break;
		}
	}
}

DynArToStrLit::fn(ar : *dyn_array(char)) ! str_lit
{
	ret := heap_alloc(globals.alloc, cast(u32)ar.count + 1)
	memcpy(ret, ar.data, ar.count)
	*ptr_offset(ret, ar.count, u8) = 0
	return cast(str_lit)ret
}

Deserialize::fn(str : str_lit, type : *type_data, data : *void)
{
	__dbg_break
	
	globals.nodes_alloc.cur = 0
	globals.ast_alloc.cur = 0

	ln := str_ln(str)

	scp := new_scope(nil)

	lang_stat : lang_state
	tkns : dyn_array(token)
	Tokenize(&tkns, str)
	pinfo : parse_info
	pinfo.tkns = &tkns
	n := parse(&pinfo, 999, parser_op.GREATER_EQ)
	ast := parse_node_to_ast(&lang_stat, n, scp)

	ASSERT(ast.type == ast_type.SCOPE)


	cur_tkn : u64
	DeserializeStruct(&tkns, &cur_tkn, type, data);
	a := 0
}
InsertTab::fn(buffer : *dyn_array(char), tab : u8)
{
	for i in 0..tab
	{
		dyn_add(buffer, '\t)
	}
}
PushStr::fn(self : *string, str : *string)
{
	dyn_add_data(cast(*dyn_array(char))&self.data, str.data.data, cast(u32)str.data.count)
}
PushStrLit::fn(self : *string, str : str_lit)
{
	ln := str_ln(str)

	dyn_add_data(cast(*dyn_array(char))&self.data, str, cast(u32)ln)
}
PushStrLit::fn(buffer : *dyn_array(char), str : str_lit)
{
	ln := str_ln(str)

	dyn_add_data(buffer, str, cast(u32)ln)
}
SerializeStruct::fn(buffer : *dyn_array(char), type : *type_data, data : *void, tab : u8)
{
	buffer_aux: [128] char;

	if type.ser_func
	{
		func : = cast(fn(*dyn_array(char), *void, u8))type.ser_func
		func(buffer, data, tab)
		return;
	}
	//InsertTab(buffer, tab)
	PushStrLit(buffer, "\{")

	serialized_var := false
	for i in 0..type.entries
	{
		cur_var: = ptr_offset(type, 1 + i, type_data);
		if is_flag_on(cur_var.flags, DECL_SERIALIZABLE)
		{
			final_ptr: = cast(u64)data + cur_var.offset
			if cur_var.ptr > 0
			{
				//__dbg_break
				ptr := cur_var.ptr
				while ptr > 0
				{
					final_ptr = *cast(*u64)final_ptr
					ptr--
				}
			}
			//InsertTab(buffer, tab + 1)
			Serialize(buffer, cur_var, final_ptr, tab + 1, &cur_var.name);
			dyn_add(buffer, ',)
			//dyn_add(buffer, '\n)
			serialized_var = true
		}
	}
	if serialized_var
	{
		buffer.count = buffer.count - 1
	}

	//dyn_add(buffer, '\n)
	//InsertTab(buffer, tab)
	PushStrLit(buffer, "\}")
	a:=0
}
SpreadRelString::fn macro(str : _expr)
{
	cast(str_lit)(cast(u64)&str + str.offset)
}
GetTypeSize::fn(tp : *type_data) !u64
{
	if tp.ptr > 0
		return 8;
	if tp.tp == type_enum.TYPE_U8 || tp.tp == type_enum.TYPE_S8
	{
		return 1;
	}
	else if tp.tp == type_enum.TYPE_U16 || tp.tp == type_enum.TYPE_S16
	{
		return 2;
	}
	else if tp.tp == type_enum.TYPE_U32 || tp.tp == type_enum.TYPE_S32 || tp.tp == type_enum.TYPE_ENUM
	{
		return 4;
	}
	else if tp.tp == type_enum.TYPE_U64 || tp.tp == type_enum.TYPE_S64
	{
		return 8;
	}
	else if tp.tp == type_enum.TYPE_VECTOR
	{
		return 16;
	}
	else if tp.tp == type_enum.TYPE_STRUCT
	{
		return tp.strct_sz;
	}
	// type not handled
	__dbg_break
	return 0
}
