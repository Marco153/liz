  trn : *terrain2

  work_to_do : linked_list_mutex(begin_work_thread)
  work_done : linked_list_mutex(done_work_thread)

  //work_to_do : linear_alloc(begin_work_thread)
  //work_done : linear_alloc(done_work_thread)
