import "../../core";

ent_type:enum
{
	DAMAGE,
	PLAYER,
	STATIC_COL,
	AXE,
	DEFENSE,
	ENEMY,
	BULLET,
	CHANGE_SCENE_TRIGGER,
	RESET_LEVEL,
	SPEAR,
	WATER,
	FLOATY_PLATFORM,
	INTERACT,
	TERRAIN,
	AXIS,
	EMMITTER,
	GRID,
	BRIDGE,
	EVENT,
	LOADING_AREA,
	CLIMBING_AREA,
	ITEM,
	PREVIEW_ENT,
	AUX_COL_ENT,
}
enemy_enum : enum
{
	SKULL
}
interact_type : enum
{

}
entity_event_type:etruct
{
	BRIDGE_ROTATE(
		ent_id : u32
	)
}
entity_event:struct
{
	using type : entity_event_type
	one_time : bool
	times_hit : u32
}

impact_enum:enum
{
	OPPOSITE_DIR,
	UP_AND_OPPOSITE_DIR,
	UP,
}

entity_state:enum
{
	IDLE,
	GO_SIDEWAYS,
	GO_FORWARDS,
	SURF,
	EDGE,
	ON_WALL_IDLE,
	ON_WALL_MOV,
	ON_WALL_UPWARDS,
	SLERP,
	CLIMP_WALL2,
}
behaviour_state: enum
{
	IDLE,
	GO_TO,
	ATTACK,
}
intention_state: enum
{
	CALM,
	ATTACK,
}

ENTITY_HAS_TEXTURE: const s32 = 1;
ENTITY_IS_MASKED: const s32 = 2;
ENTITY_DONT_FREE: const s32 = 4;
ENTITY_FREED: const s32 = 8;
ENTITY_3D: const s32 = 0x10;
ENTITY_TRANSPARENT: const s32 = 0x20;
ENTITY_ALWAYS_ON_FRONT: const s32 = 0x40;
ENTITY_IN_USE: const s32 = 0x80
ENTITY_SERIALIZE: const s32 = 0x100
ENTITY_TEMPORARILY_NOT_SERIALIZE: const s32 = 0x200
ENTITY_ONLY_COL: const s32 = 0x400
ENTITY_NO_LIGHT: const s32 = 0x1000
ENTITY_CUSTOM_SHADER: const s32 = 0x2000
ENTITY_NO_ROTATION_ON_COLLISION: const s32 = 0x4000
ENTITY_ALREADY_DONE_IN_COLISION: const s32 = 0x8000
ENTITY_COL_CHUNK_WAS_MODIFIED: const s32 = 0x10000
ENTITY_CHANGE_SCENES: const s32 = 0x20000

LAYER_ENTITY_PLAYABLE:const s32 = 1;
LAYER_PLAYER:const s32 = 2;
LAYER_TRIGGER :const s32 = 4;
LAYER_ENEMY :const s32 = 8;
LAYER_MAYBE_ONLY_UP_COL :const s32 = 0x10;
LAYER_LOOK_AT_PLAYER :const s32 = 0x20;
LAYER_IGNORE_RAYCAST :const s32 = 0x40;
LAYER_SINGLE_COLLISION_TEST :const s32 = 0x80;

event_type : enum
{
	START_CUTSCENE,
}

long_term_action:etruct
{
	MEETING_AT(
		hour : f32,
		pos : _vec
	),
}
mid_term_action:etruct
{
	MEETING_AT(
		long_term : u32,
		short_terms : dyn_array(short_term_action)
	),
	TEST(
		frames : u64,
		secs : f32,
		cur : f32,
	),
}
rated_stuff:struct(T)
{
	type : T,
	val : f32
	in_curse : bool
};
short_term_action:etruct
{
	SAY(
		str : str_lit
	),
	GO_TO(
		pos : _vec
		frames : u8,
		flags : u8

		x_vel_when_ray_col : s8
		y_vel_when_ray_col : s8
	),
	GO_PATH(
		cur_path : u32,
		path : dyn_array(_vec)
	)
}
thinking : struct
{
	long_term_acts : dyn_array(long_term_action)
	mid_term_acts : dyn_array(rated_stuff(mid_term_action))
	short_term_acts : dyn_array(short_term_action)

	check_mid_term : bool
}

ent_part_of:enum
{
	DRAWABLE,
	COLLIDER,
	INSTANTIATED,
	LOOK_AT_PLAYER,
	ANIMATION,
	TO_DEACTIVATE,
	PLAYABLE,
	ITEMS,
	EMMITTER,
}

particle_emmitter_type:enum
{
	POS_SZ_VEL
}
particle_pos_sz_vel :struct
{
	pos : _vec
	sz : _vec
	vel : _vec
	rot : _vec
	ang_vel : _vec
	time : f32

}
PARTICLE_FLAGS_LOOP :const s32= 0x1
PARTICLE_FLAGS_RANDOM_START_TIMER :const s32= 0x2
PARTICLE_FLAGS_FIRST_TIME :const s32= 0x4
//PARTICLE_FLAGS_TEXTURE :const s32= 0x4


particle_emmitter:struct
{
	type : particle_emmitter_type
	particles : *void
	total:u32
	using p : particle_emmitter_base
}
clip_type:enum
{
	C2D,
	C3D,
}
anim_manager:struct
{
	sec_clip : asset_index
	sec_clip_weight : f32
	sec_clip_timer : f32
	loop_sec_clip : bool
}
entity:struct
{
	type : ent_type,
	state : entity_state,
	name : str_lit,
	anim_man : *anim_manager
	using info_::union
	{
		mov_info : *player_info,
		en_info : *enemy_info,
		parent_col : *entity
	}

	//using base : base_entity
	pos : _vec,
	pivot : _vec,
	color : _vec,
	vel : _vec,
	flags : u32,
	model : asset_index
	tex_id : asset_index

	anim_mul : f32

	size : _vec,
	col_size : _vec,
	col_offset : _vec,
	rot : _vec,
	angle_rot : _vec,
	sec_color : _vec,
	color_lerp : f32,
	impact_vel : _vec,
	forward : _vec,
	using u3 :: union
	{
		hp : f32,
		bridge_rot : f32,
		aux_col : *collider
	}
	collided_entered : bool,
	col_enter : fn(*entity, *entity, *collision),
	col_stay : fn(*entity, *entity, *collision),
	col_exit : fn(*entity, *entity, *collision),
	playable_func : fn(*void, *entity, *f32),

	anim_func :fn(ent : *entity, f32);
	
	cols : dyn_array(*collider)
	emmitter : *particle_emmitter

	on_ground : bool,
	was_hit : bool,
	is_static : bool,
	is_trigger : bool,
	is_active : bool,
	knockedout : bool,
	can_start_combo : bool,
	normal_col : _vec

	material_idx : asset_index
	in_material_instance : u32

	matrices_ptr : *f32

	layer : u32,
	dont_res_cols_with_layers : u32,
	ignore_collision_with_layers : u32,


	axe : *axe_info,

	ents_in_collision : dyn_array(in_col_ent),
	c_type :clip_type
	using clip_union::union
	{
		cl : *clip2,
	}
	cl3d : asset_index,

	clip_time : f32,
	clip_done : bool,
	thoughts : *thinking
	
	timer_deactivate : f32
	using u :: union
	{
		event : entity_event
		item_type : inv_item
    l_area:*loading_area_info
		bullet ::struct
		{
			dmg_val : f32
		};
		dmg ::struct
		{
			from: *entity,
			val : f32,
			impact_type : impact_enum,
			impact_mul : f32,
			hit : bool,
			hit_ent : *entity 
		};
		spear_idle_tex_idx : u32,
		scene::struct
		{
			change_to_scene_name : str_lit,
			character_start_idx : u32,
		}
		enemy_type : enemy_enum,
		terrain : *terrain_info
	}
	using u2 :: union
	{
		platform_idle_time : f32,
		spear_on_col_with : *entity,
		
	}
	masking_objs : *dyn_array(*_vec),
	remove_from : dyn_array(ent_part_of),
	stencil_val : u8,
	stencil_func : stencil_func_enum,
}
loading_area_info:struct
{
    in_front_scene_name : str_lit
    in_back_scene_name : str_lit

    in_front_scene_data : str_lit
    in_back_scene_data : str_lit

    in_front_scene_sz : u32
    in_back_scene_sz : u32

    using u ::union
    {
      preserve_ents : dyn_array(*entity)
      preserve_ents_names : dyn_array(str_lit)
    }
    //preserve_ents : dyn_array(str_lit)
}

combo_enum:enum
{
	ATTACK_0,
	ATTACK_1,
	ATTACK_2,
	AIR_ATTACK_0,
	ATTACK_THROW_UPWARDS,
}
trigger_info: struct
{
	time :f32,
	timer :f32,
	size : _vec,
	state : u32,
}
jmp_info: struct
{
	time_off_ground :f32,
	speed :f32,
	off_ground_can_jmp_time :f32,
	jmpd : bool
	vel : _vec
}
axe_info: struct
{
	hit : bool,
}
inv_item:enum
{
	EMPTY,
	EXPLOSION_GEM,
	SHOCK,
}
inv_slot:struct
{
	item : inv_item,
}
TOTA_INV_ITEMS:const s32= 3;
inventory : struct
{
	items : [TOTA_INV_ITEMS]inv_slot,
}
enemy_info: struct
{
	state : behaviour_state
	can_move : bool,
	origin_pos : _vec,
	target_pos : _vec
}
player_info: struct
{
  can_move : bool,
  facing_wall : bool
  pos_anim : _vec
  neck_bone : *bone_animation
  arm_bone : *bone_animation
  hand_bone : *bone_animation
  spine_bone : *bone_animation

  can_change_scene : bool

  asking_for_this_scene_name : str_lit
  asking_for_this_scene : str_lit
  asking_for_this_scene_sz : u32
  asking_for_this_loading_area : *loading_area_info

  area_col_pos_start : _vec

  loading_level_data : str_lit
  loading_level_data_sz : u32

  using u1 :: union
  {
      mov_vel : _vec,
      origin_pos : _vec,
  }
  h : f32
  v : f32
  ab : f32

  slerp_start : _vec
  slerp_end : _vec
  slerp_timer : f32

  up_col_norm : _vec
  ent_col : *entity

  max_y_cam_pos : f32
  min_y_cam_pos : f32

  step_timer : f32

  on_getting_to_back_pos : bool
  on_rotating_cam:bool
  gravity_vel : _vec,
  platform_vel : _vec,
  platform : *entity,
  trigger : *entity,
  just_hit_ground : bool
  
  up_col : bool
  down_col : bool
  exhausted : bool

  inv : inventory
  cur_item : u32


  col_in_stay : bool

  jmp : jmp_info,
  speed : f32,

  stamina : f32
  stamina_temp_max : f32
  stamina_max : f32

  stamina_recover_rate : f32
  stamina_decrease_rate : f32
}
get_forward::fn(ent : *entity)  ! _vec
{
  z :_vec
  z.z = 1.0
  
  q:quaternion=?
  q.v = ent.rot
  
  return q * z
}
