}
terrain2:struct
{
  chunks_enabled : dyn_array(*terrain_chunk_info)
  chunk_blocks_pool : linked_list_mutex(chunk_blocks_aux)
  chunks_table : *terrain_chunk_info
  thread_func_info : chunk_thread_info

  max_chunks : u32
}
fmix32::fn( h:u32)!u32
{
    aux := h >> 16
    h = h ^ aux

    aux = h * 0x85EBCA6B;
    aux = aux >> 13;
    h = aux ^h

    aux = h * 0xC2B2AE35;
    aux = aux * aux
    aux = aux >> 16;
    h = h ^aux
    return h;
}
hash32_triplet::fn(x:u32,  y:u32, z:u32) !u32
{
    
    h :u32= 0;

    aux := x * 0x9E3779B9;
    h = h ^ aux

    aux = y * 0x85EBCA6B;
    h = h ^ aux

    aux = z * 0xC2B2AE35;
    h = h ^ aux

    return fmix32(h);
}
get_existing_chunk::fn(trn :*terrain2, x : s32, y : s32, z :s32, get_created : bool = false)!s32
{
  idx := hash32_triplet(cast(u32)x, cast(u32)y, cast(u32)z) % trn.max_chunks
  i :u32
  while i < 16
  {
    ch := cast(*terrain_chunk_info)ptr_offset(trn.chunks_table, i + idx, terrain_chunk_info)

    if (!get_created && ch.created || get_created) && ch.pos_x == x && ch.pos_y == y && ch.pos_z == z
    {
      return cast(s32)(i + idx)
    }
    i++
  }

  return -1
}
get_block_idx::fn macro(x : _expr, y : _expr, z : _expr)
{
  ((y * CHUNK_SIZE * CHUNK_SIZE) + (z * CHUNK_SIZE) + x)
}

get_block_terrain2::fn(x : s32, y : s32, z : s32, trn : *terrain2, out : **u32, chunk_idx : *u32) ! bool
{
  ch_x :s32= x / CHUNK_SIZE
  ch_y :s32= y / CHUNK_SIZE
  ch_z :s32= z / CHUNK_SIZE
  
  if x < 0 
  {
    ch_x = (x + 1) / CHUNK_SIZE
    ch_x -= 1
  }
  if y < 0
  {
      ch_y = (y + 1) / CHUNK_SIZE
      ch_y -= 1
  }
  if z < 0
  {
      ch_z = (z + 1) / CHUNK_SIZE
      ch_z -= 1
  }

  ch_x = ch_x * CHUNK_SIZE
  ch_y = ch_y * CHUNK_SIZE
  ch_z = ch_z * CHUNK_SIZE

  ch_idx := get_existing_chunk(trn, ch_x, ch_y, ch_z, get_created=true)

  if ch_idx == -1 return false

  chunk := cast(*terrain_chunk_info)ptr_offset(trn.chunks_table, ch_idx, terrain_chunk_info)
  if !chunk.in_use return false
  
  block_x := x - ch_x
  block_y := y - ch_y
  block_z := z - ch_z

  block_x = clamp(block_x, 0, (CHUNK_SIZE -1))
  block_y = clamp(block_y, 0, (CHUNK_SIZE -1))
  block_z = clamp(block_z, 0, (CHUNK_SIZE -1))

  aux := cast(u32)block_x
  aux = aux | cast(u32)(block_y << 3)
  aux = aux | cast(u32)(block_z << 6)
  aux = aux | (cast(u32)ch_idx << 16)


  idx := cast(u64)get_block_idx(block_x, block_y, block_z)
  ptr := chunk.blocks[idx]
  *out = ptr
  *chunk_idx = cast(u32)ch_idx

  return true
}
get_block_terrain::fn(x : s32, y : s32, z : s32, trn : *terrain2, out : *u32) ! block_type
{
  ch_x :s32= x / CHUNK_SIZE
  ch_y :s32= y / CHUNK_SIZE
  ch_z :s32= z / CHUNK_SIZE
  
  if x < 0 
  {
    ch_x = (x + 1) / CHUNK_SIZE
    ch_x -= 1
  }
  if y < 0
  {
      ch_y = (y + 1) / CHUNK_SIZE
      ch_y -= 1
  }
  if z < 0
  {
      ch_z = (z + 1) / CHUNK_SIZE
      ch_z -= 1
  }

  ch_x = ch_x * CHUNK_SIZE
  ch_y = ch_y * CHUNK_SIZE
  ch_z = ch_z * CHUNK_SIZE

  ch_idx := get_existing_chunk(trn, ch_x, ch_y, ch_z)

  if ch_idx == -1 return block_type.AIR

  chunk := cast(*terrain_chunk_info)ptr_offset(trn.chunks_table, ch_idx, terrain_chunk_info)
  
  block_x := x - ch_x
  block_y := y - ch_y
  block_z := z - ch_z

  block_x = clamp(block_x, 0, (CHUNK_SIZE -1))
  block_y = clamp(block_y, 0, (CHUNK_SIZE -1))
  block_z = clamp(block_z, 0, (CHUNK_SIZE -1))

  aux := cast(u32)block_x
  aux = aux | cast(u32)(block_y << 3)
  aux = aux | cast(u32)(block_z << 6)
  aux = aux | (cast(u32)ch_idx << 16)

  *out = cast(u32)aux


  idx := cast(u64)get_block_idx(block_x, block_y, block_z)
  ptr := chunk.blocks[idx]
  block := (*ptr & 0xffff)

  return cast(block_type)block
}
raycast_dda::fn(start : *_vec, dir : *_vec, max_dist : f32, trn : *terrain2, ret : *u32) ! bool
{
    // Normalize direction
    d := normalize_vec(dir);

    // Current voxel (integers)

    vx :f32
    vy :f32
    vz :f32

    vx = floor(start.x);
    vy = floor(start.y);
    vz = floor(start.z);

    // Step direction (-1 or +1)
    step_x := sign(d.x);
    step_y := sign(d.y);
    step_z := sign(d.z);

    // Distance to first voxel boundary
    t_delta_x := absf(1.0 / d.x);
    t_delta_y := absf(1.0 / d.y);
    t_delta_z := absf(1.0 / d.z);

    // Compute initial t_max: distance until first grid intersection
    t_max_x : f32;
    t_max_y : f32;
    t_max_z : f32;

    if d.x >= 0.0
        t_max_x = ((vx + 1.0) - start.x) * (1.0 / absf(d.x));
    else
        t_max_x = (start.x - vx) * (1.0 / absf(d.x));

    if d.y >= 0.0
        t_max_y = ((vy + 1.0) - start.y) * (1.0 / absf(d.y));
    else
        t_max_y = (start.y - vy) * (1.0 / absf(d.y));

    if d.z >= 0.0
        t_max_z = ((vz + 1.0) - start.z) * (1.0 / absf(d.z));
    else
        t_max_z = (start.z - vz) * (1.0 / absf(d.z));


    // --- Main DDA Loop ---
    dist : f32 = 0.0;

    closest_block_dist :f32=99999.0
    block_found := false
    max_its := cast(s32)(max_dist * 4.0)
    
    i:= 0
    while absf(dist) <= max_dist && i < max_its
    {
        // Check current voxel
        aux_val:u32
        if get_block_terrain(cast(s32)vx, cast(s32)vy, cast(s32)vz, trn, &aux_val) != block_type.AIR
        {
          aux := aux_val
          x := cast(s32)(aux & 0x7)
          y := cast(s32)((aux >> 3) & 0x7)
          z := cast(s32)((aux >> 6) & 0x7)

          
          ch_idx := (aux >> 16)
          //printf("dda x {x}, y {y}, z{z}\n")

          chunk := cast(*terrain_chunk_info)ptr_offset(trn.chunks_table, ch_idx, terrain_chunk_info)
          b_pos:_vec
          b_pos.x = cast(f32)(x + chunk.pos_x)
          b_pos.y = cast(f32)(y + chunk.pos_y)
          b_pos.z = cast(f32)(z + chunk.pos_z)

          to_start := *start - b_pos

          cur_d:= dot_vec(&to_start, &to_start)
          if cur_d < closest_block_dist
          {
            closest_block_dist = cur_d
            *ret = aux_val
          }
          block_found = true

        }

        // Step towards next voxel
        if (t_max_x < t_max_y) && (t_max_x < t_max_z)
        {
            vx = vx + step_x;
            dist = t_max_x;
            t_max_x = t_max_x + t_delta_x;
        }
        else if (t_max_y < t_max_z)
        {
            vy = vy + step_y;
            dist = t_max_y;
            t_max_y = t_max_y + t_delta_y;
        }
        else
        {
            vz = vz + step_z;
            dist = t_max_z;
            t_max_z = t_max_z + t_delta_z;
        }
        i++
    }

    return block_found
}

