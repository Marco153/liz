CopyRegionFromTex::fn(ctx : *context, tex : *texture_info, x_offset : u32, y_offset : u32, width : u32, height : u32, data : *u8)
{
	ASSERT(tex != nil)
	src_offset :u64= x_offset * 4 + y_offset * tex.width * 4;
	dst_offset :u64= 0;
	sz: = cast(u64)width * 4;
	//printf("xoffset %, yoffset %, src_offset %\n", x_offset, y_offset, src_offset);
	for h in 0..height
	{
		memcpy(ptr_offset(data, dst_offset, u8), ptr_offset(tex.data, src_offset, u8), sz);
		src_offset += tex.width * 4;
		dst_offset += width * 4;
	}
}

AssignToCell::fn(ctx : *context, out : *layer_sprites, cell_x : u32, cell_y : u32, src_x : u32, src_y : u32, tex : *texture_info, aux_buffer : *u8)
{
	pixels_per_width:u32 = out.pixels_per_width;

	//src_x = src_x * 4;
	//src_y = src_y * tex.width * 4;
	CopyRegionFromTex(ctx, tex, src_x, src_y, pixels_per_width, pixels_per_width, aux_buffer);
	x := cast(u32)cell_x * pixels_per_width;
	y := cast(u32)cell_y * pixels_per_width;
//	__dbg_break;
	UpdateTexture(out.tex_id, x, y, pixels_per_width, pixels_per_width, aux_buffer);
	
}
maxu32::fn(a : u32, b : u32) !u32
{
	if a > b return a;
	return b;
}
minu32::fn(a : u32, b : u32) !u32
{
	if a < b return a;
	return b;
}



aux_strs:struct
{
	addr : u64, 
	in_str_tbl: u64
}


SerializeSpriteLayer::fn(buffer: *dyn_array(u8), str_tbl: *dyn_array(u8), l_ptr : *layer_sprites, inserted_strs: *dyn_array(aux_strs), cl : *cell)
{
	//__dbg_break
	//dyn_init2(&buffer_char, 1, alloc);

	idx: u32= 0;
	total_of_used_cells:u32 = 0;

	//dyn_add(buffer, ',);
	//dyn_add(buffer, '\n);
	//InsertTab(cast(*dyn_array(char))buffer, 1)
	//PushStrLit(cast(*dyn_array(char))buffer, "cells = \{\n")

	tabs :u8= 3
	for c in l_ptr.cells
	{
		cell_tex := c.SPRITE.tex;
		
		if c.used
		{
			sp_aux :sp_cell;
			sp_aux.grid_x = idx % l_ptr.grid_x;
			sp_aux.grid_y = idx / l_ptr.grid_x;
			sp_aux.src_tex_offset_x = c.SPRITE.x_offset;
			sp_aux.src_tex_offset_y = c.SPRITE.y_offset;

			SerializeStruct(cast(*dyn_array(char))buffer, GetTypeData(sp_cell), &sp_aux, tabs);
			buffer.count -= (3 + tabs)
			PushStrLit(cast(*dyn_array(char))buffer, ",\n")

			InsertTab(cast(*dyn_array(char))buffer, 4)

			PushStrLit(cast(*dyn_array(char))buffer, "tex_name = \"{cell_tex.name}\"")

			PushStrLit(cast(*dyn_array(char))buffer, "\n\t\t\t\},\n")
			total_of_used_cells++;
		}
		idx++;
	}


	buffer.count = buffer.count - 2;
	dyn_add(buffer, '\n);
	InsertTab(cast(*dyn_array(char))buffer, 2)
	PushStrLit(cast(*dyn_array(char))buffer, "\}\n")

}
