import "../../core";
import "../common";
change_scene_collision_enter::fn(ent_a : *entity, ent_b : *entity, col : *collision)
{
	if ent_b.type == ent_type.PLAYER
	{
		ent_b.dmg.hit_ent = ent_a;
	}
}
floaty_platform_col_enter::fn(ent_a : *entity, ent_b : *entity, col : *collision)
{
	if ent_b.is_static
	{
		ent_a.was_hit = true;
		//ent_a.
	}
}

IsPosInsideMaskingObjs::fn(pos : *_vec, masking_objs : *dyn_array(*_vec), radius_to_be_in : f32) !bool
{
	
	mask_pos := *(*masking_objs)[0];
	dist := *pos - *mask_pos;
	//__dbg_break;
	dist_f := dot_vec(&dist, &dist);
	if dist_f <= (radius_to_be_in * radius_to_be_in) 
		return true;
	return false;
}
spear_collision_enter::fn(ent_a : *entity, ent_b : *entity, col : *collision)
{
	if ent_a.vel.y != 0.0
		return;
	ent_a.spear_on_col_with = ent_b;
	if ent_b.type == ent_type.STATIC_COL
	{
		if is_flag_on(ent_b.flags, ENTITY_IS_MASKED)
		{
			forward := ent_a.pos + ent_a.forward;
			
			if !IsPosInsideMaskingObjs(&forward, ent_b.masking_objs, MASKING_DIAMETER*0.5)
			{
				col.ignore_collision = true;
				return;
			}
		}
		ent_a.cl = nil;
		ent_a.tex_id = ent_a.spear_idle_tex_idx;
		ent_a.is_static = true;
	}
	if ent_b.type != ent_type.PLAYER && !ent_b.is_trigger
	{
		ent_a.vel.x = 0.0;
		ent_a.vel.y = 0.0;
	}
}

CanIgnoreTriggerAndDoCollision::fn(ent_a : *entity, spear : *entity, col : *collision) ! bool
{
	if spear.type == ent_type.SPEAR
	{
		ent_a_foot_y := ent_a.pos.y - ent_a.pivot.y * ent_a.col_size.y;
		spear_top_y := spear.pos.y + spear.pivot.y * spear.col_size.y;
		dabs := absf(col.depth);
		if dabs < 0.3 && ent_a_foot_y >= (spear_top_y - dabs) && ent_a.vel.y < 0.0
		{
			return true;
		}
	}
	return false;

}
player_collision_exit::fn(ent_a : *entity, ent_b : *entity, col : *collision)
{
}
player_collision_stay::fn(ent_a : *entity, ent_b : *entity, col : *collision)
{
	up : _vec
	up.y = 1.0
	ent_a.normal_col = col.normal
	ent_a.mov_info.col_in_stay = true
	if dot_vec(&col.normal, &up) > 0.5
	{
		ent_a.on_ground = true
	}
}
bullet_collision_enter::fn(ent_a : *entity, ent_b : *entity, col : *collision)
{
	ent_a.is_active = false
	if ent_b.type == ent_type.ENEMY
	{

		vel := ent_a.vel
		vel = normalize_vec(&vel) * 4.0
		vel.y = 2.0
		ent_b.impact_vel = vel 
		ent_b.color_lerp = 1.0
	}
}
player_collision_enter::fn(ent_a : *entity, ent_b : *entity, col : *collision)
{
	up : _vec
	up.y = 1.0
	ent_a.normal_col = col.normal
	if dot_vec(&col.normal, &up) > 0.5
	{
		ent_a.on_ground = true
	}
	if ent_a.state == entity_state.SURF
	{
		mov := ent_a.mov_info

		cross_right := cross_vec(&globals.up, &col.normal)
		ground_dir := cross_vec(&cross_right, &col.normal)
		ground_dir = normalize_vec(&ground_dir)
		ground_d := dot_vec(&ent_a.vel, &ground_dir)

		// making vel horizontal
		up_dot := dot_vec(&ground_dir, &globals.up)
		final_vel := ground_dir - globals.up * up_dot
		final_vel = normalize_vec(&final_vel)

		mov.platform_vel =  final_vel * ground_d
		printf("enter\n")
		print_vec(&ent_a.forward)
	}
}

axe_trig_collision_enter::fn(ent_a : *entity, ent_b : *entity, col : *collision)
{
	if ent_a.type == ent_type.AXE
	{
		if ent_b.type == ent_type.ENEMY
		{
			DisableEnt(ent_b);
		}
	}

}
defense_collision_enter::fn(ent_a : *entity, ent_b : *entity, col : *collision)
{
}
trig_collision_enter::fn(ent_a : *entity, ent_b : *entity, col : *collision)
{
	from: = ent_a.dmg.from;
	dir:_vec = ? ;
	dir.x = ent_b.pos.x - ent_a.dmg.from.pos.x;
	dir.x = signf(dir.x);

}












