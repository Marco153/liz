RaycastWithNonBodies::fn(ctx : *scene_info, start : *_vec, end : *_vec, cinfo:*collision, layers_to_ignore:u32, collided : **entity) !bool
{
	found := false
	dir := *end - *start
	cur_dist := 99999.0
	for it in ctx.ents
	{
		if it.model.asset_idx <= 257 || it.is_active == false || it.type == ent_type.PREVIEW_ENT || is_flag_on(it.layer, LAYER_IGNORE_RAYCAST)
			continue;
		
		
		out_verts_count:u32
		out_indices_count:u32
		
		//__dbg_break
		
		model_verts_count:u32
		model_tris_count:u32
		m := get_id_of_model(&it.model)
		printf("name {it.name}, idx {it.model.asset_idx}, gl id {m}\n")
		GetInfoFromModel(m, &model_verts_count, &model_tris_count)
		if model_verts_count > globals.aux_vertices_sz
		{
			continue
		}
		CopyDataFromModel(m, globals.aux_vertices, globals.aux_vertices_sz, globals.aux_indices, globals.aux_indices_sz, &out_verts_count, &out_indices_count)

		mat : mat4x4=?
		q :quaternion=?
		q.v =it.rot

		//__dbg_break
		//__dbg_break
		a := cast(*f32)&mat
		b := (it.pos)
		c := cast(*f32)&q.v
		d := _vec{1.0, 1.0, 1.0, 1.0}
		build_model_matrix(a, &b, c, &d)

		start_pos := globals.aux_vertices

		_min : _vec=?
		_max : _vec=?
		for i in 0..out_verts_count
		{
			v := ptr_offset(start_pos, i, _vec)
			v.w = 1.0
			*v = mul_mat_vec(&mat, v)
			//v.w = 0.0
			_min = minPerComponent(&_min, v)
			_max = maxPerComponent(&_max, v)
		}

		//__dbg_break
		t :u64
		while t < out_indices_count
		{
			info :verts_from_tri_info
			info.t = t
			get_verts_pos_from_tris(&info, cast(*u32)globals.aux_indices, cast(*f32)globals.aux_vertices, 4)
			rinfo : raycast_info=?
			rinfo.ray_origin = *start
			rinfo.ray_dir = dir
			rinfo.v0 = info.v1_out
			rinfo.v1 = info.v2_out
			rinfo.v2 = info.v3_out

			if ray_triangle_intersect(&rinfo)
			{
				tri_pos := *start + dir * rinfo.t_out
				dist_dir := *start - tri_pos
				d.x = dot_vec(&dist_dir, &dist_dir)


				//printf("is axis {e.name}\n")

				if d.x < cur_dist
				{
					cur_dist = d.x
					found = true
					*collided = *it
					cinfo.normal = info.cross
					cinfo.ent = *it
					cinfo.contact_point = tri_pos
				}

			}
			t += 3
		}
	}
	return found
}
ray_against_mesh_info:struct
{
	start : *_vec, 
	end : *_vec,
	verts : *_vec,
	tris : *u32,
	total_tris: u32,
	cur_dist : *f32,
	found : *bool,
	cinfo : *collision,
	is_axis : *bool,
	e : *entity,
	collided : **entity
}
ray_agains_mesh::fn(ctx : *scene_info, c1: *collider, ray_info : *ray_against_mesh_info, start_tri : u32= 0, end_tri :s32= -1) ! bool
{
	using ray_info

	aux_found := false
	dir := *end - *start

	t :u64= start_tri
	if end_tri != -1
	{
		total_tris = cast(u32)end_tri
	}
	while t < total_tris
	{
		info :verts_from_tri_info=?
		info.t = t
		get_verts_pos_from_tris(&info, cast(*u32)tris, cast(*f32)verts, 4)
		rinfo : raycast_info=?
		rinfo.ray_origin = *start
		rinfo.ray_dir = dir
		c_offset := c1.ent.col_offset
		rinfo.v0 = info.v1_out + c_offset
		rinfo.v1 = info.v2_out + c_offset
		rinfo.v2 = info.v3_out + c_offset

		globals.tri_v1 = rinfo.v0
		globals.tri_v2 = rinfo.v1
		globals.tri_v3 = rinfo.v2

		if ray_triangle_intersect(&rinfo)
		{
			tri_pos := *start + dir * rinfo.t_out
			dist_dir := *start - tri_pos
			d := dot_vec(&dist_dir, &dist_dir)

			ent_is_axis := e.type == ent_type.AXIS
			if ent_is_axis
			{
				*is_axis = true
			}
			if d < *cur_dist
			{
				*cur_dist = d
				*found = true
				cinfo.ent = e
				if *is_axis && ent_is_axis || *is_axis == false
				{
					*collided = e
					//printf("got {e.name}, is_axis {is_axis}, ent_is_axis {ent_is_axis}\n")
				}
				cinfo.normal = info.cross
				cinfo.contact_point = tri_pos
				aux_found = true
			}

		}
		t += 3
	}
	return aux_found
}
ray_agains_collider::fn(ctx : *scene_info, start : *_vec, end : *_vec, cinfo:*collision, layers_to_ignore:u32, collided : **entity, e : *entity, is_axis : *bool, cur_dist : *f32, found : *bool, c1 : *collider) ! bool
{
	//c1.pos = e.pos;
	dir := *end - *start

	dummy :_vec=?;
	dummy2 :_vec=?;
	CopyVerts(c1, &dummy, &dummy2);

	aux_found := false
	
	info : ray_against_mesh_info=?
	on c1.type
	{
	col_type.MESH
	{
		verts := c1.MESH.info.verts
		tris_count := c1.MESH.info.tris_count
		tris := c1.MESH.info.tris

		info.start = start
		info.end = end
		info.verts = verts
		info.tris = tris
		info.total_tris = tris_count
		info.cur_dist = cur_dist
		info.found = found
		info.cinfo = cinfo
		info.is_axis = is_axis
		info.e = e
		info.collided = collided
		aux_found = ray_agains_mesh(ctx, c1, &info)
	}
	col_type.CUBE
	{
		verts := c1.CUBE.verts[0]

		info.start = start
		info.end = end
		info.verts = verts
		info.tris = cast(*u32)globals.cube_tris[0]
		info.total_tris = 36
		info.cur_dist = cur_dist
		info.found = found
		info.cinfo = cinfo
		info.is_axis = is_axis
		info.e = e
		info.collided = collided
		aux_found = ray_agains_mesh(ctx, c1, &info)
	}
	}
	return aux_found
}
Raycast::fn(ctx : *scene_info, start : *_vec, end : *_vec, cinfo:*collision, layers_to_ignore:u32, collided : **entity) !bool
{
	//dyn_clear(&ctx.broad_phase_ents);

	len: = len_vec(&(*start - *end));

	sz:_vec = ? ;
	sz.x = len * 2.0;
	sz.y = len * 2.0;
	zero:_vec;
	cur_dist := 99999.0
	found := false
	aux_ent : *entity
	i:= 0
	is_axis := false

	
	for it in ctx.bodies
	{
		i++
		//printf("{i} addr {cast(u64)*it}\n")
		//__dbg_break
		if is_flag_on(it.layer, layers_to_ignore | LAYER_IGNORE_RAYCAST) 
			continue;
		e := *it
		
		for c in e.cols
		{
			if ray_agains_collider(ctx, start, end, cinfo, layers_to_ignore, collided, e, &is_axis, &cur_dist, &found, *c)
			{
				//printf("found\n")
				*collided = e
				if is_axis 
				{
					return true
				}
				if globals.cur_preview_idx == 1
				{
					*collided = globals.aux_col_ent

					globals.aux_col_ent.parent_col = e
					globals.aux_col_ent.pos = e.pos + c.pos * e.size
					globals.aux_col_ent.size = c.size * e.size
					globals.aux_col_ent.aux_col = *c

					dyn_clear(&globals.aux_col_ent.cols)
					dyn_add(&globals.aux_col_ent.cols, *c)
				}
			}
		}

		/*
		if IsKeyHeld(key_enum.KEY_Z) && str_cmp(e.name, "block 1_idx56")
		{
			gjk := cast(*gjk_state)globals.gjk
			gjk.col1 = c1
			gjk.col2 = c1
			globals.ray_origin = *start
			globals.ray_end = *end
			__dbg_break;
		}
		*/

	}
	return found;
}
