//code from GJK.h https://github.com/kevinmoran/GJK/tree/master
EPA::fn(gjk : *gjk_state, a : *_vec, b: *_vec, c : *_vec, d : *_vec, col1 : *collider, col2 : *collider, out : * collision) ! _vec
{

	cur_i : u64
	/*
	for v1 in col1.CUBE.verts
	{
		for v2 in col2.CUBE.verts
		{
			aux:= *v1 - *v2
			add_vert(gjk, &aux)
			cur_i++
			//printf("i {cur_i}\n")
			//globals.temp_alloc.cur = 0
		}
	}
	*/
    faces := &gjk.epa_faces
    loose_edges := &gjk.epa_loose_edges
    
	ba := *b-*a
	ca := *c-*a
	da := *d-*a
	cb := *c-*b
	db := *d-*b
    //Init with final simplex from GJK
    faces[0] = *a;
    faces[1] = *b;
    faces[2] = *c;
    faces[3] = normalize_vec(&cross_vec(&ba, &ca)); //ABC
    faces[1][0] = *a;
    faces[1][1] = *c;
    faces[1][2] = *d;
    faces[1][3] = normalize_vec(&cross_vec(&ca, &da)); //ACD
    faces[2][0] = *a;
    faces[2][1] = *d;
    faces[2][2] = *b;
    faces[2][3] = normalize_vec(&cross_vec(&da, &ba)); //ADB
    faces[3][0] = *b;
    faces[3][1] = *d;
    faces[3][2] = *c;
    faces[3][3] = normalize_vec(&cross_vec(&db, &cb)); //BDC

    num_faces:u64=4;
	gjk.num_faces = num_faces
	//__dbg_break
    closest_face:u64;
	cur_k := 0

  for iterations in 0.. EPA_MAX_NUM_ITERATIONS
	{
		globals.temp_alloc.cur = 0
    //Find face that's closest to origin
    min_dist:= dot_vec(faces[0][0], faces[0][3]);
    closest_face = 0;
    for i in 1..num_faces
		{
      dist := dot_vec(faces[cast(u64)i][0], faces[cast(u64)i][3]);
      if(dist<min_dist)
			{
        min_dist = dist;
        closest_face = cast(u32)i;
      }
    }
		//gjk.closest_face = closest_face

    //search normal to face that's closest to origin
    search_dir := *faces[cast(u64)closest_face][3]; 
    p := find_support(col1, col2, &search_dir)

		dot := dot_vec(&p, &search_dir)
		dist := dot-min_dist
    if((dist)<EPA_TOLERANCE){
        //Convergence (new point is not significantly further from origin)
			//__dbg_break
			out.normal = *faces[cast(u64)closest_face][3]
      return *faces[cast(u64)closest_face][3] * dot_vec(&p, &search_dir); //dot vertex with normal to resolve collision along normal!
    }

        num_loose_edges:u64 = 0;

		//printf("here\n")
        //Find all triangles that are facing p
		for i2 in 0..num_faces
    {
			i := cast(u64)i2
			//printf("i {i}\n")
			to_point := p-*faces[i][0] 
      if(dot_vec(faces[i][3], &to_point)>0.0) //triangle i faces p, remove it
      {
				n := faces[i][3]
				//gjk.cur_face_facing_point = i
				//gjk.epa_new_sup = p
				//__dbg_break
				//view_collision(1)

                //Add removed triangle's edges to loose edge list.
                //If it's already there, remove it (both triangles it belonged to are gone)
				for j2 in 0..3
        {
					j:=cast(u64)j2
					//printf("j {j}\n")
                    current_edge:[2]_vec=?
					current_edge[0] = *faces[i][j];
					current_edge[1] = *faces[i][(j+1)%3];
                    found_edge := false;

					for k2 in 0..num_loose_edges
                    {
						k := cast(u64)k2
						//printf("k {k}\n")
                        if(equal_vec(loose_edges[k][1], current_edge[0]) && 
							equal_vec(loose_edges[k][0], current_edge[1]))
						{
                            //Edge is already in the list, remove it
                            //THIS ASSUMES EDGE CAN ONLY BE SHARED BY 2 TRIANGLES (which should be true)
                            //THIS ALSO ASSUMES SHARED EDGE WILL BE REVERSED IN THE TRIANGLES (which 
                            //should be true provided every triangle is wound CCW)
                            loose_edges[k][0] = loose_edges[num_loose_edges-1][0]; //Overwrite current edge
                            loose_edges[k][1] = loose_edges[num_loose_edges-1][1]; //with last edge in list
                            num_loose_edges--;
                            found_edge = true;
                            k2=cast(s64)num_loose_edges; //exit loop because edge can only be shared once
                        }
                    }//endfor loose_edges

                    if(!found_edge){ //add current edge to list
                        // assert(num_loose_edges<EPA_MAX_NUM_LOOSE_EDGES);
                        if(num_loose_edges>=EPA_MAX_NUM_LOOSE_EDGES) break;
						//__dbg_break
                        loose_edges[num_loose_edges][0] = current_edge[0];
                        loose_edges[num_loose_edges][1] = current_edge[1];
                        num_loose_edges++;
                    }
					//gjk.num_loose_Iedges = num_loose_edges
                }
				//gjk.num_loose_edges = num_loose_edges
				//printf("k loop end")

                //Remove triangle i from list
                faces[i][0] = faces[num_faces-1][0];
                faces[i][1] = faces[num_faces-1][1];
                faces[i][2] = faces[num_faces-1][2];
                faces[i][3] = faces[num_faces-1][3];
                num_faces--;
                i2--;
            }//endif p can see triangle i
        }//endfor num_faces
        
		//__dbg_break
        //Reconstruct polytope with p added
		for i2 in 0..num_loose_edges
        {
			i := cast(u64)i2
            // assert(num_faces<EPA_MAX_NUM_FACES);
            if(num_faces>=EPA_MAX_NUM_FACES) break;
            faces[num_faces][0] = *loose_edges[i][0];
            faces[num_faces][1] = *loose_edges[i][1];
            faces[num_faces][2] = p;
			a_dir := *loose_edges[i][0]-*loose_edges[i][1]
			b_dir := *loose_edges[i][0]-p
			cross := cross_vec(&a_dir, &b_dir)
            faces[num_faces][3] = normalize_vec(&cross);

            //Check for wrong normal to maintain CCW winding
            bias:= 0.000001; //in case dot result is only slightly < 0 (because origin is on face)
            if(dot_vec(faces[num_faces][0], faces[num_faces][3])+bias < 0.0){
                temp := *faces[num_faces][0];
                faces[num_faces][0] = *faces[num_faces][1];
                faces[num_faces][1] = temp;
                faces[num_faces][3] = -*faces[num_faces][3];
            }
            num_faces++;
        }
    } //End for iterations
    //printf("EPA did not converge\n");
    //Return most recent closest point
	//__dbg_break
	out.normal = *faces[cast(u64)closest_face][3]
    return *faces[closest_face][3] * dot_vec(faces[closest_face][0], faces[closest_face][3]);
}
GetContactPointToArr::fn(vertsA : *_vec, vertsALen : u32, vertsB : *_vec, vertsBLen : u32, contacts : *_vec, contacts_count : *u64, minDist : *f32)
{
    for idx in 0..vertsALen
    {
        i:= ptr_offset(vertsA, cast(u64)idx, _vec);
		for j in 0..vertsBLen
		{
            va:= ptr_offset(vertsB, cast(u64)j, _vec);
			vb:= ptr_offset(vertsB, cast(u64)(j + 1) % vertsBLen, _vec);

			closest_point:_vec;
            dist:f32 = PointLineDistance(va, vb, i, &closest_point);
            
			ptr: = ptr_offset(contacts, 0, _vec);
			ptr1: = ptr_offset(contacts, 1, _vec);
            if(NearlyEqualF32(dist, *minDist) && !NearlyEqualV3(&closest_point, ptr))
            {
				*contacts_count = 2;
				*ptr = closest_point;
            }
            else if(dist < *minDist)
            {
                *minDist = dist;
                *ptr = closest_point;
            }
        }
    }
}
FindContactPoints::fn(vertsA : *_vec, vertsALen : u32, vertsB : *_vec, vertsBLen : u32, contacts : *dyn_array(_vec))
{
	ASSERT(contacts.alloc.id == 0x1234);
    minDist: f32 = 99999.0;

	GetContactPointToArr(vertsA, vertsALen, vertsB, vertsBLen, contacts.data, &contacts.count, &minDist);
	GetContactPointToArr(vertsB, vertsBLen, vertsA, vertsALen, contacts.data, &contacts.count, &minDist);
}

DrawCols::fn(ctx : *scene_info, drw_set : *draw_settings)
{
	a_verts : [4]_vec;
	dummy :_vec;
	for e in ctx.bodies
	{
		if !e.is_active
			continue;
		ApplyTranformationsToVerts(&e.pos, &e.vel, &e.pivot, &e.col_size, &dummy, a_verts, nil);
		pos: = *a_verts[0];
		size_x: = (*a_verts[3] - *a_verts[0]).x;
		size_y: = (*a_verts[1] - *a_verts[0]).y;

		if ctx.draw_col
		{
			draw: draw_info;
			draw.pos = pos;
			draw.pos.z = 0.9;
			draw.cam_pos = drw_set.cam_pos
			draw.cam_size = drw_set.cam_size;
			draw.ent_size.x = size_x;
			draw.ent_size.y = size_y;
			draw.flags = DRAW_INFO_WIREFRAME;
			*draw.color[3] = 1.0;
			Draw(drw_set.window, &draw);
		}
	}
}

add_body_to_chunks::fn(ctx : *scene_info, ent : *entity)
{
	min_rel_pos : _vec=?
	max_rel_pos : _vec=?
	
  for l_area in ctx.areas_col
  {
		for c in ent.cols 
		{
			CopyVerts(*c, &min_rel_pos, &max_rel_pos)
			dyn_clear(&ctx.aux_col_chunks)

			in_range := get_rel_size_from_min_and_max_pos_in_col_chunk(ctx, l_area, &c._min, &c._max, &min_rel_pos, &max_rel_pos)

      if !in_range continue
        
			get_chunks_close_to_ent(ctx, l_area, ent, &ctx.aux_col_chunks, &min_rel_pos, &max_rel_pos)

			for ch in ctx.aux_col_chunks
			{
				for e in ch.entities
				{
					if e.is_static continue
					e.flags = e.flags | ENTITY_COL_CHUNK_WAS_MODIFIED
				}
				dyn_add(&ch.entities, ent)
			}
		}
	}

}
add_body::fn(ctx : *scene_info, ent : *entity)
{
	dyn_add(&ctx.bodies, &ent);
	ent.ents_in_collision.alloc = ctx.alloc;
	dyn_init(&ent.ents_in_collision, 16);
	ent.ents_in_collision.count = 16

	col := new_ptr(collider)
	memset(col, 0, sizeof(collider))
	dyn_add(&ent.cols, col)
	c1 := col
	c1.type = col_type.CUBE
	c1.ent = ent
	c1.size.x = 1.0
	c1.size.y = 1.0
	c1.size.z = 1.0
	

	c1.rel_chunk_min.x = -1.0
	c1.rel_chunk_max.x = -1.0

	
	if ent.is_active == false return


	add_body_to_chunks(ctx, ent)
}

remove_body::fn(ctx : *scene_info, ent : *entity, free_ptr : bool=true)
{
	i :u32= 0
	found :=false
	for e in ctx.bodies
	{
		if *e == ent
		{
			found = true
			break
		}
		i++
	}
	if !found
	{
		return
	}

	dyn_rem(&ctx.bodies, i)

	heap_free(ent.ents_in_collision.alloc, ent.ents_in_collision.data);

	for c in ent.cols
	{
		heap_free(ctx.alloc, *c)
    if c.type == col_type.MESH
    {
      for a in ctx.areas_col
      {
        cur_ch :u64= 0
        while cur_ch < a.col_chunks.count
        {
          ch := a.col_chunks[cur_ch]
          found = false
          i = 0

          for e_ch in ch.from_ents
          {
            if e_ch.from_ent == ent
            {
              found = true
              break;
            }
            i++
          }

          if found
          {
            idx := ch.from_ents[cast(u64)i]
            alloc := idx.tris.alloc
            heap_free(alloc, idx.tris.data)
            dyn_rem(&ch.from_ents, i)
            cur_ch--
          }
          cur_ch++
        }
      }
    }
	}

}

EntIsInCollision::fn(into : *entity, in_col : *entity, cinfo : *collision) !bool
{
	inserted: = false;
	for e in into.ents_in_collision
	{
		if (e.ent == nil) && !inserted
		{
			//PrintV3(6.0, 0.0, 0.0);
			e.in_col = true;
			e.ent = in_col;
			e.col = *cinfo;
			inserted = true;
			return false;
		}
		else if (e.ent == in_col)
		{
			//PrintV3(5.0, 0.0, 0.0);
			e.in_col = true;
			e.col = *cinfo;
			inserted = true;
			return true;
		}
	}
	ASSERT(inserted);
	return true;
}
minPerComponent::fn x64(a: *_vec, b: *_vec) ! _vec 
{
	ret : _vec
	ret.x = minf(a.x, b.x)
	ret.y = minf(a.y, b.y)
	ret.z = minf(a.z, b.z)
	ret.w = minf(a.w, b.w)
    return ret
}

// Returns component-wise maximum of two vectors
maxPerComponent::fn x64(a: *_vec, b: *_vec) ! _vec 
{
	ret : _vec
	ret.x = maxf(a.x, b.x)
	ret.y = maxf(a.y, b.y)
	ret.z = maxf(a.z, b.z)
	ret.w = maxf(a.w, b.w)
    return ret
}
CopyVertsActual::fn x64(col : *collider, e : *entity, _min : *_vec, _max : *_vec, mesh_verts : *_vec)
{
	p := col.pos
	p.x = p.x * e.size.x
	p.y = p.y * e.size.y
	p.z = p.z * e.size.z
	q :quaternion=?
	q.v = e.rot

	p = q * p


	sz := col.size
	sz.x = sz.x * e.size.x
	sz.y = sz.y * e.size.y
	sz.z = sz.z * e.size.z
	final_pos := (e.pos + p)

	final_size := sz
	mat : mat4x4=?

	on col.type 
	{
	col_type.TRIANGLE
	{
		
	}
	col_type.CAPSULE
	{
		r := col.CAPSULE.radius * 4.0
		h := col.CAPSULE.height * 4.0
		_min.x = e.pos.x - r
		_min.y = e.pos.y - h * 0.5
		_min.z = e.pos.z - r
		_min.w = 0.0

		_max.x = e.pos.x + r
		_max.y = e.pos.y + h * 0.5
		_max.z = e.pos.z + r
		_max.w = 0.0
	}
	col_type.SPHERE
	{

		r := col.SPHERE.radius * 1.2
		_min.x = e.pos.x - r
		_min.y = e.pos.y - r
		_min.z = e.pos.z - r
		_min.w = 0.0

		_max.x = e.pos.x + r
		_max.y = e.pos.y + r
		_max.z = e.pos.z + r
		_max.w = 0.0
	}
	col_type.MESH
	{
		a := cast(*f32)&mat
		c := cast(*f32)&q.v
		build_model_matrix(a, &final_pos, c, &final_size)

		minfo := col.MESH.info
		start := mesh_verts
		//prev_ptr := minfo.tris
		//prev_val := *minfo.tris
		for i in 0..minfo.verts_count
		{
			v := ptr_offset(start, i, _vec)
			v.w = 1.0
			*v = mul_mat_vec(&mat, v)
			v.w = 0.0
			*_min = minPerComponent(_min, v)
			*_max = maxPerComponent(_max, v)
		}
		
	}
	col_type.CUBE
	{
		start := col.CUBE.verts[0]

		if col.no_rotation_ent
		{
			for i in 0..8
			{
				v := ptr_offset(start, i, _vec)
				*v = *v * final_size
				*v += final_pos
				*_min = minPerComponent(_min, v)
				*_max = maxPerComponent(_max, v)
			}
		}
		else
		{
			//memcpy(col.CUBE.verts[0], globals.cube_verts[0], 16 * 8)

			//__dbg_break
			//__dbg_break
			a := cast(*f32)&mat
			c := cast(*f32)&q.v
			build_model_matrix(a, &final_pos, c, &final_size)

			for i in 0..8
			{
				v := ptr_offset(start, i, _vec)
				v.w = 1.0
				*v = mul_mat_vec(&mat, v)
				v.w = 0.0
				*_min = minPerComponent(_min, v)
				*_max = maxPerComponent(_max, v)
			}
		}
	}
	default
	{
		__dbg_break
	}
	}

	col._min = *_min
	col._max = *_max
}
CopyVerts::fn(col : *collider, _min : *_vec, _max : *_vec)
{
	if col.data_ready
	{
		*_min = col._min
		*_max = col._max
		return;
	}

	if col.ent.is_static
	{
		col.data_ready = true
		//col.pos = col.ent.pos
	}

	mesh_verts : *_vec

	if col.type == col_type.MESH
	{
		minfo := &col.MESH.info
		//printf("is mesh copyverts\n")
		m := get_model_ptr(cast(*asset_index)&minfo.model_idx)
		
		CopyDataFromModel(cast(u32)m.model, minfo.verts, minfo.verts_count, minfo.tris, minfo.tris_count, &minfo.verts_count, &minfo.tris_count)

		mesh_verts = col.MESH.info.verts
	}
	_min.x = 9999.9
	_min.y = 9999.9
	_min.z = 9999.9
	
	_max.x = -9999.9
	_max.y = -9999.9
	_max.z = -9999.9
	if col.type == col_type.CUBE
	{
		memcpy(col.CUBE.verts[0], globals.cube_verts[0], 16 * 8)
	}
	CopyVertsActual(col, col.ent, _min, _max, mesh_verts)
}
//solve_col::fn(e : *entity, )

verts_from_tri_info:struct
{
	v1_out : _vec, 
	v2_out : _vec, 
	v3_out : _vec, 
	cross : _vec, 
	t : u64
}

get_verts_pos_from_tris2::fn x64(info : *verts_from_tri_info, tris_info : *triangle_info)
{
		t := info.t
    memcpy(info, &tris_info._v1, 4 * sizeof(_vec))
		info.v1_out.w = 0.0

		info.v2_out.w = 0.0

		info.v3_out.w = 0.0
}
get_verts_pos_from_tris::fn x64(info : *verts_from_tri_info, tris : *u32, verts : *f32, stride : u32)
{
		t := info.t
		idx :=  cast(u64)*ptr_offset(tris, t, u32)
		*cast(*_vec)&info.v1_out = *cast(*_vec)ptr_offset(verts, idx * stride, f32)
		info.v1_out.w = 0.0

		idx = *ptr_offset(tris, t + 1, u32)
		*cast(*_vec)&info.v2_out = *cast(*_vec)ptr_offset(verts, idx * stride, f32)
		info.v2_out.w = 0.0

		//v2_out += e2.pos + cpos

		idx = *ptr_offset(tris, t + 2, u32)


		*cast(*_vec)&info.v3_out = *cast(*_vec)ptr_offset(verts, idx * stride, f32)
		info.v3_out.w = 0.0


		tri_edge1 := info.v2_out - info.v1_out
		tri_edge2 := info.v3_out - info.v1_out

		
		info.cross = cross_vec(&tri_edge1, &tri_edge2)
		info.cross = normalize_vec(&info.cross)
}
ChunkCol::fn(gjk : *gjk_state, c1 : *collider, c2 : *collider, chunk : *chunk_col_info, trn : *terrain_info, chunk_pos : *_vec)
{
	e := c1.ent
	e2 := c2.ent
	t :u64
	tris := &chunk.tris
	verts := &trn.meshes[cast(u64)chunk.verts_mesh_idx].verts

	cpos:=*chunk_pos

	count := tris.count
	col : collision=?
	up :=_vec{0.0, 1.0, 0.0}
	
	while t < count
	{
		_v1 :_vec=?
		_v1.w = 0.0

		_v2 :_vec=?
		_v2.w = 0.0

		_v3 :_vec=?
		_v3.w = 0.0

		cross :_vec=?
		cross.w = 0.0

		info :verts_from_tri_info
		info.t = t
		globals.temp_alloc.cur = 0
		get_verts_pos_from_tris(&info, tris.data, verts.data, TERRAIN_VERTEX_SIZE)
		_v1 = info.v1_out
		_v2 = info.v2_out
		_v3 = info.v3_out
		cross = info.cross
		
		_v1 += e2.pos + cpos

		dir := e.pos - _v1
		dist := dot_vec(&dir, &dir)
		//__dbg_break
		//globals.test_i++
		up_dot := 1.0 + (1.0 - dot_vec(&cross, &up))
		up_dot = up_dot * 3.0
		if dist < (70.0 * up_dot)
		{
			//__dbg_break
			_v2 += e2.pos + cpos

			_v3 += e2.pos + cpos

			prev_cross := cross

			c2.type = col_type.TRIANGLE
			c2.TRIANGLE.verts[0] = _v1
			c2.TRIANGLE.verts[1] = _v2
			c2.TRIANGLE.verts[2] = _v3

			c2.TRIANGLE.normal = cross

			//if t == 375
				//__dbg_break;
			
			/*
			if chunk.verts_mesh_idx == 2 && c1.ent.pos.z >= 34.0
			{
				__dbg_break
			}
			*/
			if GJK(gjk, c1, c2)
			{
				//__dbg_break
				//if can_break
					//__dbg_break
				//tri_normal = cross

				//__dbg_break
				mtv := EPA(gjk, gjk.simplex[0], gjk.simplex[1], gjk.simplex[2], gjk.simplex[3], c1, c2, &col)
				c1.ent.pos -= mtv
				dummy :_vec
				CopyVerts(c1, &dummy, &dummy)

				col.normal = col.normal * -1.0
				if !EntIsInCollision(e, e2, &col)
				{
					if e.col_enter != nil
					{
						e.col_enter(e, e2, &col);
					}
				}
				if e.col_stay != nil
				{
					e.col_stay(e, e2, &col);
				}
			}
		}
		t += 3
	}
	//printf("tri is {globals.test_i}\n")
}
add_pos_to_verts::fn(trn : *terrain_info, ch : *chunk_col_info, pos : *_vec)
{
	t :u64=0

	count := cast(s64)trn.chunks_col_window_size
	//__dbg_break
	
	verts := &trn.meshes[cast(u64)ch.verts_mesh_idx].verts
	prev_w := pos.w
	for y in 0..count
	{
		for x in 0..count
		{
			if y == (count - 1)
			{
				v_idx :u64= cast(u64)*ch.tris[t]
				vec := cast(*_vec)verts[v_idx * 3]
				*vec += *pos

				v_idx = cast(u64)*ch.tris[t + 1]
				vec = cast(*_vec)verts[v_idx * 3]
				*vec += *pos

			}
			else
			{
				v_idx := cast(u64)*ch.tris[t + 1]
				vec := cast(*_vec)verts[v_idx * 3]
				*vec += *pos
			}
			t += 6
		}
	}
	pos.w = prev_w
}
get_close_chunk_cols::fn(ctx : *context, terrain_chunks_to_col : *dyn_array(*chunk_col_info), e_trn : *entity, mesh : *mesh_info, ref_pos : *_vec, window : f32)
{
	trn :*terrain_info= e_trn.terrain

	count := trn.tris.count
	t :u64
	verts := &mesh.verts
	tris := &trn.tris

	rel_pos := *ref_pos - e_trn.pos
	rel_pos -= mesh.pos

	min_x := rel_pos.x - window
	max_x := rel_pos.x + window
	min_y := rel_pos.z - window
	max_y := rel_pos.z + window


	min_x = min_x / cast(f32)trn.tris_per_unit
	max_x = max_x / cast(f32)trn.tris_per_unit
	min_y = min_y / cast(f32)trn.tris_per_unit
	max_y = max_y / cast(f32)trn.tris_per_unit

	min_x = cast(f32)cast(s32)min_x
	max_x = cast(f32)cast(s32)max_x
	min_y = cast(f32)cast(s32)min_y
	max_y = cast(f32)cast(s32)max_y

	min_x = clamp(min_x, 0.0, cast(f32)trn.chunks_col_per_row)
	max_x = clamp(max_x, 0.0, cast(f32)trn.chunks_col_per_row)
	min_y = clamp(min_y, 0.0, cast(f32)trn.chunks_col_per_row)
	max_y = clamp(max_y, 0.0, cast(f32)trn.chunks_col_per_row)

	vec_aux : _vec
	vec_aux.x = min_x
	vec_aux.y = max_x
	vec_aux.z = min_y
	vec_aux.w = max_y

	imin_x := cast(u32)min_x
	imax_x := cast(u32)max_x
	imin_y := cast(u32)min_y
	imax_y := cast(u32)max_y

	w := cast(u32)(max_x - min_x) + 1
	h := cast(u32)(max_y - min_y) + 1
	//__dbg_break

	if imax_x >= trn.chunks_col_per_row
	{
		w--
	}
	if imax_y >= trn.chunks_col_per_row
	{
		h--
	}
	//__dbg_break
	for y in 0..h
	{
		for x in 0..w
		{
			cur_x := cast(u64)(imin_x + cast(u32)x)
			cur_y := cast(u64)(imin_y + cast(u32)y)

			ch := mesh.chunks[cur_y * trn.chunks_col_per_row + cur_x]
			//printf("curx {cur_x}, cury {cur_y}, ")
			//printf("ptr %\n", cast(u32)cast(u64)ch)
			//globals.temp_alloc.cur = 0
			dyn_add(terrain_chunks_to_col, ch)
		}
	}
/*
	if mesh == trn.meshes[1]
	{
		//OpenLocalsWindow(__LINE__)
		//__dbg_break
	}
	*/
}
// 3D Axis-Aligned Bounding Box collision check
aabbCheck3D::fn x64(a: *aabb, b: *aabb) ! bool
{
    // X-axis overlap check
    x_overlap := (a._min.x <= b._max.x) && (a._max.x >= b._min.x)
    
    // Y-axis overlap check
    y_overlap := (a._min.y <= b._max.y) && (a._max.y >= b._min.y)
    
    // Z-axis overlap check
    z_overlap := (a._min.z <= b._max.z) && (a._max.z >= b._min.z)

    return x_overlap && y_overlap && z_overlap
}

// Collision check function taking pointer to AABBs
aabbCheck::fn x64(a: *aabb, b: *aabb) ! bool
{
    // Check for overlap on each axis
	a_minx := (a._min.x <= b._max.x)
	b_minx := (a._max.x >= b._min.x)

	a_miny := (a._min.y <= b._max.y)
	b_miny := (a._max.y >= b._min.y)

    x_overlap := a_minx && b_minx
    y_overlap := a_miny && b_miny
	
    //z_overlap := (a.min.z <= b.max.z) && (a.max.z >= b.min.z)

    return x_overlap && y_overlap
}
get_closest_terrain_meshes_chunk_cols::fn(ctx : *context, pos : *_vec, trn_ent : *entity, terrain_chunks_to_col : *dyn_array(*chunk_col_info), window : f32)
{
	trn :*terrain_info=trn_ent.terrain
	for m in trn.meshes
	{
		m_aabb :aabb = ?
		p_aabb :aabb = ?

		m_aabb._min = m.pos
		m_aabb._min.y = m_aabb._min.z
		
		m_aabb._max = m_aabb._min
		m_aabb._max.x += cast(f32)trn.width
		m_aabb._max.y += cast(f32)trn.width
		p_aabb._min.x = pos.x
		p_aabb._min.y = pos.z
		p_aabb._min = p_aabb._min + _vec{-window, -window, 0.0, 0.0}

		p_aabb._max.x = pos.x
		p_aabb._max.y = pos.z
		p_aabb._max = p_aabb._max + _vec{window, window, 0.0, 0.0}
		//if(can_break && m == trn.meshes[2])
			//__dbg_break
		if aabbCheck(&m_aabb, &p_aabb)
		{
			get_close_chunk_cols(ctx, terrain_chunks_to_col, trn_ent, m, pos, window)
			//ctx.mesh_idx = cast(u32)i
		}
		//i++
	}
}
cast_s32_and_compare_vecs::fn(a : *_vec, b : *_vec) ! bool
{
	if cast(s32)a.x != cast(s32)b.x || cast(s32)a.y != cast(s32)b.y ||
		cast(s32)a.z != cast(s32)b.z
	{
		return false;
	}
	return true
}
check_maybe_resolve_collision::fn(ctx : *scene_info, gjk : *gjk_state, e : *entity, e2 : *entity, dt : f32, c1 : *collider, c2 : *collider, p_aabb : *aabb)
{
	m_aabb :aabb = ?
	col : collision=?
	mtv : _vec=?
	CopyVerts(c2, &m_aabb._min, &m_aabb._max)

	//printf("name {e.name}\n")
	
	if aabbCheck3D(&m_aabb, p_aabb) == false
	{
		return
	}

	//__dbg_break
	/*
	if is_flag_on(e.layer, LAYER_ENTITY_PLAYABLE)
	{
		//ASSERT(e != nil)
		//ASSERT(e.mov_info != nil)

		r :=c1.CAPSULE.radius
		gjk.aux_col.type = col_type.SPHERE
		gjk.aux_col.SPHERE.radius = r
		gjk.aux_col.pos = e.pos
		gjk.aux_col.pos += e.forward * r * 2.0 + -ctx.up * 0.5
		gjk.aux_col.ent = e
		
		if GJK(gjk, &gjk.aux_col, c2)
		{
			e.mov_info.down_col = true
			e.mov_info.ent_col = e2
		}

		gjk.aux_col.pos = e.pos
		gjk.aux_col.pos += e.forward * r + ctx.up * 0.8
		
		if GJK(gjk, &gjk.aux_col, c2)
		{
			e.mov_info.up_col = true
			if is_flag_off(e.dont_res_cols_with_layers, e2.layer) && is_flag_off(e2.dont_res_cols_with_layers, e.layer)
				mtv = EPA(gjk, gjk.simplex[0], gjk.simplex[1], gjk.simplex[2], gjk.simplex[3], &gjk.aux_col, c2, &col);
			
			col.normal = col.normal * -1.0
			e.mov_info.up_col_norm = col.normal
		}
	}
	*/

	if !GJK(gjk, c1, c2)
	{
		return
	}
	if is_flag_off(e.dont_res_cols_with_layers, e2.layer) && is_flag_off(e2.dont_res_cols_with_layers, e.layer)
		mtv = EPA(gjk, gjk.simplex[0], gjk.simplex[1], gjk.simplex[2], gjk.simplex[3], c1, c2, &col);
	else
	{
		mtv.x = 0.0
		mtv.y = 0.0
		mtv.z = 0.0
		mtv.w = 0.0
	}
	
	col.normal = col.normal * -1.0
	if !EntIsInCollision(e, e2, &col)
	{
		if e.col_enter != nil
		{
			e.col_enter(e, e2, &col);
		}
	}
	if e.col_stay != nil
	{
		e.col_stay(e, e2, &col);
	}
	if e.is_trigger == false && e2.is_trigger == false
	{
		e.pos -= mtv
		//c1.data_ready = false
		//CopyVerts(c1, &p_aabb._min, &p_aabb._max)
	}
}
resolve_collision_with_block::fn(ent : *entity, block_pos : *_vec, face_dir : *u8) ! bool
{
  c := ent.cols[0]
  on c.type
  {
  CAPSULE
  {
    //__dbg_break

    bp := *block_pos
    if globals.frames_total == 49 && bp.x >= 4.4 && bp.x < 4.6 && bp.z >= 6.4 && bp.z < 6.6 __dbg_break
    pp := ent.pos
    b2p := pp - *block_pos
    clamped_dist:_vec=?
    clamped_dist.x = clamp(b2p.x, -0.5, 0.5)
    clamped_dist.y = clamp(b2p.y, -0.5, 0.5)
    clamped_dist.z = clamp(b2p.z, -0.5, 0.5)

    clamped_dist.y = 0.0

    from_block_2_clm := *block_pos + clamped_dist

    dir :_vec
    dir.x = from_block_2_clm.x - pp.x
    dir.z = from_block_2_clm.z - pp.z

    r := c.CAPSULE.radius
    h := c.CAPSULE.height
    r2 := r * r
    
    d := dot_vec(&dir, &dir)

    in_col_horizontal := r2 > d

    z_forward_limit := bp.z + 0.5
    z_back_limit := bp.z - 0.5
    x_right_limit := bp.x + 0.5
    x_left_limit := bp.x - 0.5
    y_up_limit := bp.y + 0.5
    y_down_limit := bp.y - 0.5

    y_cur_down := pp.y - h * 0.5
    y_cur_up := pp.y + h * 0.5
    z_cur_forward := pp.z + r
    z_cur_back := pp.z - r
    x_cur_right := pp.x + r
    x_cur_left := pp.x - r
    
    y_dist := pp.y - block_pos.y
    // 0.5 is the dist from the block center to either top or bottom
    in_col_vertical := absf(y_dist) < ((h * 0.5) + 0.5)

    
    collided := false
    
    diff :f32= 1000.0
    normal :_vec
    
    // top face
    printf("begin \n")
    if y_cur_down < y_up_limit && in_col_horizontal && in_col_vertical && y_cur_down > bp.y
    {
      //print_vec(block_pos)
      *face_dir = FACE_UP
      aux := absf(y_up_limit - y_cur_down)

      if aux < diff
      {
        normal.x = 0.0
        normal.y = 1.0
        normal.z = 0.0

        diff = aux
        collided = true
        printf("collided with top\n")
      }

    }
    if in_col_horizontal && in_col_vertical 
    {
      l := len_vec(&dir) 
      pen := r - l
      printf("l is {l}, pen is {pen}, diff {diff}\n")
      if l > 0.000001
      {
        //print_vec(&(dir / l))
        print_vec(&dir)
      }
      if absf(l) > 0.000001 && pen < diff
      {
        printf("we're in, {globals.frames_total}\n")
        dir.x = dir.x / l
        dir.z = dir.z / l
        diff = pen

        print_vec(&dir)
        _x := absf(dir.x)
        _z := absf(dir.z)
        printf("_x {_x}, _z {_z}\n")
        if dir.x > -1.1 && dir.x < -0.9 __dbg_break
        if _x > _z
        {
          normal.x = -dir.x
          printf("x path\n")
          normal.y = 0.0
          normal.z = 0.0
        }
        else
        {
          printf("z path\n")
          normal.x = 0.0
          normal.y = 0.0
          normal.z = -dir.z

        }
        collided = true
      }
      print_vec(&normal)
    }
    printf("end \n")
    if collided
    {
      //print_vec(&normal)
      ent.pos += normal *diff
    }

    return collided
  }
  default:
  {
    __dbg_break
  }
  }
  return false;
}
test_col_with_block::fn(e : *entity, ch :*terrain_chunk_info, x : s32, y : s32, z : s32, blocks_collided_count: *u8, blocks_collided_ptr : *u64)
{
  idx := *ch.blocks[cast(u64)get_block_idx(x, y, z)]
  block := cast(block_type)(idx & 0xffff)
  //printf("cur_block_pos x {x}, y {y}, z {z}\n")
  if block != block_type.AIR
  {
    bpos :_vec=?
    bpos.x = cast(f32)x + 0.5 + cast(f32)ch.pos_x
    bpos.y = cast(f32)y + 0.5 + cast(f32)ch.pos_y
    bpos.z = cast(f32)z + 0.5 + cast(f32)ch.pos_z

    face_dir:u8
    if resolve_collision_with_block(e, &bpos, &face_dir)
    {
      //cur_col := ptr_offset(blocks_collided_ptr,cast(u64)blocks_collided_count]
      //blocks_collided_count:u8=0
      if e.type == ent_type.PLAYER
      {
        normal :_vec
        on face_dir
        {
        FACE_RIGHT
        {
          normal.x = 1.0
        }
        FACE_LEFT
        {
          normal.x = -1.0
        }
        FACE_UP
        {
          e.on_ground = true
          //printf("on ground {globals.frames_total}\n")
          normal.y = 1.0
        }
        FACE_DOWN
        {
          normal.y = -1.0
        }
        FACE_FORWARD
        {
          normal.z = 1.0
        }
        FACE_BACK
        {
          normal.z = -1.0
        }
        }
        e.normal_col = normal
      }
    }
  }
}
StepCol::fn(ctx : *scene_info, dt : f32)
{
  //if ctx.col_chunks == nil return

	gjk := cast(*gjk_state)globals.gjk
	globals.ctx = cast(*void)ctx
	globals.gjk = gjk
	for _e in ctx.bodies
	{
		e := *_e
		if e.is_static || e.is_active == false || e.type == ent_type.TERRAIN
			continue;

		for in_col in e.ents_in_collision
		{
			if in_col.in_col == false && in_col.ent != nil
			{
				//PrintV3(5.0, 0.0, 0.0);
				//in_col.in_col = false;
				if e.col_exit != nil
				{
					e.col_exit(e, in_col.ent, &in_col.col);
				}
				in_col.ent = nil;
			}
			in_col.in_col = false;

		}	

		//__dbg_break
		c1 := *e.cols[0]
		e.pos += e.vel * dt
		//c1.pos = e.pos
		m_aabb :aabb = ?
		p_aabb :aabb = ?

		CopyVerts(c1, &p_aabb._min, &p_aabb._max)
		col : collision=?
		mtv :_vec=?

		aux_min : _vec=?
		aux_max : _vec=?

    l_area :*area_col_info
    in_range := false
    /*
    for a in ctx.areas_col
    {
      if get_rel_size_from_min_and_max_pos_in_col_chunk(ctx, a, &c1._min, &c1._max, &aux_min, &aux_max)
      {
        in_range = true
        l_area = a
        break
      }
      
    }
    if !in_range
    {
      if !e.is_static
      {
        e.flags = e.flags | ENTITY_CHANGE_SCENES 
      }
      continue
    }

		if e.type == ent_type.PLAYER && (cast_s32_and_compare_vecs(&c1.rel_chunk_min, &aux_min) == false ||
			cast_s32_and_compare_vecs(&c1.rel_chunk_max, &aux_max) == false ||
			is_flag_on(e.flags, ENTITY_COL_CHUNK_WAS_MODIFIED))
		{
			c1.rel_chunk_min = aux_min
			c1.rel_chunk_max = aux_max

			dyn_clear(&ctx.aux_col_chunks)
			get_chunks_close_to_ent(ctx, l_area, e, &ctx.aux_col_chunks, &aux_min, &aux_max)

			// remove the ents from chunks
			for c in c1.in_chunks
			{
				cur_i :u64
				for cur_e in c.entities
				{
					if *cur_e == e
					{
						dyn_rem(&c.entities, cast(u32)cur_i)
						break;
					}
					cur_i++
				}
			}

			dyn_clear(&c1.in_chunks)
			dyn_clear(&c1.ents_of_gotten_chunks)

			for c in ctx.aux_col_chunks
			{
				if c.entities.count == 0
				{
					continue
				}
				dyn_add_data(&c1.ents_of_gotten_chunks, c.entities.data, cast(u32)c.entities.count)
				dyn_add(&c.entities, e)
				dyn_add(&c1.in_chunks, *c)
			}

			//printf("new test, total {c1.ents_of_gotten_chunks.count}\n")
			e.flags = e.flags & ~ENTITY_COL_CHUNK_WAS_MODIFIED
		}
    */
    for ch in c1.in_trn_chunks
    {
      //__dbg_break
      min_pos_x : s32=? 
      min_pos_y : s32=? 
      min_pos_z : s32=? 
      max_pos_x : s32=? 
      max_pos_y : s32=? 
      max_pos_z : s32=? 

      window := 3

      min_pos_x = cast(s32)e.pos.x - window
      max_pos_x = cast(s32)e.pos.x + window
      min_pos_y = cast(s32)e.pos.y - window
      max_pos_y = cast(s32)e.pos.y + window
      min_pos_z = cast(s32)e.pos.z - window
      max_pos_z = cast(s32)e.pos.z + window

      min_pos_x = clamp(min_pos_x - ch.pos_x, 0, CHUNK_SIZE)
      max_pos_x = clamp(max_pos_x - ch.pos_x, 0, CHUNK_SIZE)
      min_pos_y = clamp(min_pos_y - ch.pos_y, 0, CHUNK_SIZE)
      max_pos_y = clamp(max_pos_y - ch.pos_y, 0, CHUNK_SIZE)
      min_pos_z = clamp(min_pos_z - ch.pos_z, 0, CHUNK_SIZE)
      max_pos_z = clamp(max_pos_z - ch.pos_z, 0, CHUNK_SIZE)

      blocks_collided_ptr:[8]u64
      blocks_collided_count:u8=0

      for y in min_pos_y..max_pos_y
      {
        for z in min_pos_z..max_pos_z
        {
          for x in min_pos_x..max_pos_x
          {
            test_col_with_block(e, *ch, cast(s32)x, cast(s32)y, cast(s32)z, &blocks_collided_count, blocks_collided_ptr[0])
          }
        }
      }
    }
    continue



		for _e2 in c1.ents_of_gotten_chunks
		{
			e2 := *_e2
			if e == e2 || e2.is_active == false || is_flag_on(e2.layer, LAYER_SINGLE_COLLISION_TEST) || is_flag_on(e.ignore_collision_with_layers, e2.layer) || is_flag_on(e2.ignore_collision_with_layers, e.layer) ||
				is_flag_on(e2.flags, ENTITY_ALREADY_DONE_IN_COLISION)
				continue;


			e2.flags = e2.flags | ENTITY_ALREADY_DONE_IN_COLISION

      if e2.cols.count == 0 continue
			
			c2 := *e2.cols[0]

			//c2.pos = e2.pos


			in_col :bool= false

			if e2.type == ent_type.TERRAIN2
      {
        __dbg_break
      }
			if e2.type == ent_type.TERRAIN
			{
				gjk.col1 = c1
				gjk.col2 = c2
				//__dbg_break
				can_break := false
				if IsKeyDown(key_enum.KEY_F1)
					can_break = true;

				trn := e2.terrain
				dyn_clear(&ctx.terrain_chunks_to_col)
				i := 0
				//get_closest_terrain_meshes_chunk_cols(ctx, &e.pos, e2, &ctx.terrain_chunks_to_col, 2.0)
				for ch in ctx.terrain_chunks_to_col
				{
					m := trn.meshes[cast(u64)ch.verts_mesh_idx]
					m_pos :_vec= m.pos
					m_pos.w = 0.0

					ChunkCol(gjk, c1, c2, *ch, trn, &m_pos)
				}
			}
			else
			{
				for c in e2.cols
				{
					check_maybe_resolve_collision(ctx, gjk, e, e2, dt, c1, *c, &p_aabb)
				}

			}
		}
		for _e2 in c1.ents_of_gotten_chunks
		{
			e2 := *_e2
			e2.flags = e2.flags & ~ENTITY_ALREADY_DONE_IN_COLISION
		}

		tri_verts1 :=gjk.aux_col.TRIANGLE.verts[0]


	for ch in ctx.aux_col_chunks
	{
      for e_ch in ch.from_ents
      {
        if e_ch.tris.count == 0
          continue
        gjk.aux_col.type = col_type.TRIANGLE

        cur_tri :u64= 0
        total_tris := e_ch.tris.count
        
        //printf("check tri col against {e_ch.from_ent.name}\n")

        tri := ptr_offset(e_ch.tris[0], 0, triangle_info)

        while cur_tri < total_tris
        {
          memcpy(tri_verts1, &tri._v1, 3 * 16)

          gjk.aux_col.TRIANGLE.normal = tri.normal

          dir := tri._v1 - e.pos
          //d := dot_vec(&dir, &dir)
          same_dir := dot_vec(&dir, &tri.normal)

          //globals.temp_alloc.cur = 0
          //__dbg_break
          if same_dir > 0.0 && aabbCheck3D(&p_aabb, &tri.bounds)
          {

            if  GJK(gjk, c1, &gjk.aux_col)
            {
              if !e.is_trigger
              {
                mtv = EPA(gjk, gjk.simplex[0], gjk.simplex[1], gjk.simplex[2], gjk.simplex[3], c1, &gjk.aux_col, &col)
                e.pos -= mtv
              }

              col.normal = col.normal * -1.0
              if !EntIsInCollision(e, tri.ent, &col)
              {
                if e.col_enter != nil
                {
                  e.col_enter(e, tri.ent, &col);
                }
              }
              if e.col_stay != nil
              {
                e.col_stay(e, tri.ent, &col);
              }
            }
          }
          cur_tri++
          tri = ptr_offset(tri, 1, triangle_info)
        }
        globals.tris_checked += cast(u32)total_tris
      }
		}
	}
}
get_chunk_pos_by_world_pos::fn(pos : *_vec, x : *s32, y : *s32, z : *s32)
{
  *x = (cast(s32)pos.x / CHUNK_SIZE) * CHUNK_SIZE
  *y = (cast(s32)pos.y / CHUNK_SIZE) * CHUNK_SIZE
  *z = (cast(s32)pos.z / CHUNK_SIZE) * CHUNK_SIZE
}
cmp_ivec3_s32::fn(a : *s32, b : *s32) !bool
{
  if *a != *b return false
  if *ptr_offset(a, 1, s32) != *ptr_offset(b, 1, s32) return false
  if *ptr_offset(a, 2, s32) != *ptr_offset(b, 2, s32) return false

  return true
}
PhysicsUpdate::fn(ctx : *scene_info, dt : f32)
{
  for e in ctx.bodies
  {
    if e.type == ent_type.PLAYER
    {
      c := e.cols[0]


      min_chunk : [3]s32=?
      max_chunk : [3]s32=?

      min_p := e.pos + _vec{-2.0, -2.0, -2.0}
      max_p := e.pos + _vec{2.0, 2.0, 2.0}

      get_chunk_pos_by_world_pos(&min_p, min_chunk[0], min_chunk[1], min_chunk[2])
      get_chunk_pos_by_world_pos(&max_p, max_chunk[0], max_chunk[1], max_chunk[2])

      if *max_chunk[0] == *min_chunk[0]
      {
        *max_chunk[0] += CHUNK_SIZE
      }
      if *max_chunk[1] == *min_chunk[1]
      {
        *max_chunk[1] += CHUNK_SIZE
      }
      if *max_chunk[2] == *min_chunk[2]
      {
        *max_chunk[2] += CHUNK_SIZE
      }

      trn := ctx.trn_ent.trn
      cond := globals.chunks_added || !cmp_ivec3_s32(min_chunk[0], &c.trn_chunk_min_x) || !cmp_ivec3_s32(max_chunk[0], &c.trn_chunk_max_x)


      if !cond continue


      dyn_clear(&c.in_trn_chunks)

      memcpy(&c.trn_chunk_min_x, min_chunk[0], 12)
      memcpy(&c.trn_chunk_max_x, max_chunk[0], 12)


      for y in c.trn_chunk_min_y..c.trn_chunk_max_y
      {
        for z in c.trn_chunk_min_z..c.trn_chunk_max_z
        {
          for x in c.trn_chunk_min_x..c.trn_chunk_max_x
          {
            ch_idx := get_existing_chunk(trn, cast(s32)x, cast(s32)y, cast(s32)z)

            if ch_idx == -1 continue

            chunk := ptr_offset(trn.chunks_table, ch_idx, terrain_chunk_info)

            dyn_add(&c.in_trn_chunks, chunk)
            x += CHUNK_SIZE - 1
          }
          z += CHUNK_SIZE - 1
        }
        y += CHUNK_SIZE - 1
      }
    }
  }
	for e in ctx.bodies
	{
    if e.cols.count == 0 continue

		c1 := e.cols[0]
		c1.no_rotation_ent = is_flag_on(e.flags, ENTITY_NO_ROTATION_ON_COLLISION)
	}
	steps := 1

	globals.tris_checked = 0


	dt = dt / cast(f32)steps
	for i in 0..steps
	{
		StepCol(ctx, dt)
	}
}


NarrowPhase::fn(ctx : *context, ref : *entity, close : *dyn_array(*entity), out : *dyn_array(contact_col), dt : f32)
{
	
}
BroadPhase::fn(ctx : *context, ref_pos : *_vec, ref_size : *_vec, out : *dyn_array(*entity))
{
}
 CheckRayAgainstVertices::fn(vertices : *_vec, verts_len : u32, ray_start : *_vec, ray_end : *_vec, ent : *entity, info : *collision)!bool
{
	for j in 0..verts_len
	{
		va: = ptr_offset(vertices, cast(u64)j, _vec);
		vb: = ptr_offset(vertices, cast(u64)(j + 1) % verts_len, _vec);

		p:_vec=?;

		if (DoTwoLinesIntersect(ray_start, ray_end, va, vb, &p))
		{
			dir: = *vb - *va;
			n:_vec=?;
			n.x = dir.y;
			n.y = -dir.x;

			dot: = dot_vec(&(*ray_start - *ray_end), &n);
			if (dot < 0.0)
			{
				n = n * -1.0;
			}
			info.contact_point = p;
			info.normal = n;
			return true;
		}
	}
	return false;
}
vertex_added::fn(ar : *dyn_array(vertex_terrrain_modify), idx : u64) ! bool
{
	for i in *ar
	{
		if i.vidx == idx
		{
			return true;
		}
	}
	return false;
}
mesh_added::fn(ar : *dyn_array(u32), idx : u32) ! bool
{
	for i in *ar
	{
		if *i == idx
		{
			return true;
		}
	}
	return false;
}
get_chunk_on_pos ::fn(trn : *terrain_info, pos_s : s32) ! *chunk_col_info
{
	if pos_s == -1
		return nil;
	pos := cast(u32)pos_s
	mesh_x :u32= pos & 0xff
	mesh_y :u32= (pos >> 8) & 0xff
	ch_x :u32= (pos >> 16) & 0xff
	ch_y :u32= (pos >> 24) & 0xff

	midx := cast(u64)(mesh_y * trn.size + mesh_x)
	//__dbg_break
	midx = clamp(midx, 0, trn.meshes.count - 1)

	mesh := trn.meshes[cast(u64)midx]

	chidx := cast(u64)ch_y * trn.chunks_col_per_row + ch_x
	chidx = clamp(chidx, 0, mesh.chunks.count - 1)

	return mesh.chunks[chidx]
}
