draw_terrain::fn(ctx : *context, cam_pos : *_vec, cam_rot : *_vec, e : *entity)
{
	trn : *terrain_info= e.terrain
	//__dbg_break
	for m in trn.meshes
	{
		draw : draw_info3d
		draw.model = m.model
		draw.flags = DRAW_INFO_TERRAIN
		//__dbg_break
		draw.pos = e.pos + m.pos
		draw.rot = e.rot
		draw.cam_pos = cam_pos
		draw.cam_rot = cam_rot
		draw.perspective_mat = ctx.perspective_mat
		draw.cam_forward = ctx.cam_forward_global
		draw.ent_size.x = 1.0
		draw.ent_size.y = 1.0
		draw.ent_size.z = 1.0
		draw.ent_size.w = 0.0
		memcpy(cast(*void)draw.color, &e.color, 4 * sizeof(f32));
		Draw3D(ctx.window, &draw);
	}
}
DrawEnts::fn(ctx : *context, cam_pos : *_vec, cam_rot : *_vec)
{
	if ctx.drawable_ents.count == 0
		return;
	for e in ctx.drawable_ents
	{
		if e.is_active == false
			continue

		if(e.type == ent_type.TERRAIN)
		{
			draw_terrain(ctx, cam_pos, cam_rot, *e)
		}
		else
		{
			DrawEntity(ctx, *e, cam_pos, cam_rot);
		}
	}
}
DrawEntity::fn(ctx : *context, ent : *entity, cam_pos : *_vec, cam_rot : *_vec)
{
	//PrintV3(cast(f32)cast(u32)ent.is_active, 0.0, 0.0);
	if !ent.is_active
		return;
		
	if(is_flag_on(ent.flags, ENTITY_3D))
	{
		draw : draw_info3d
		draw.model = ent.model
		draw.pos = ent.pos
		draw.rot = ent.rot
		draw.cam_pos = cam_pos
		draw.cam_rot = cam_rot
		draw.perspective_mat = ctx.perspective_mat
		draw.cam_forward = ctx.cam_forward_global
		draw.ent_size = ent.size
		memcpy(cast(*void)draw.color, &ent.color, 4 * sizeof(f32));
		if(is_flag_on(ent.flags, ENTITY_TRANSPARENT))
		{
			draw.flags = DRAW_INFO_TRANSPARENT;
		}
		if(is_flag_on(ent.flags, ENTITY_HAS_TEXTURE))
		{
			draw.flags = DRAW_INFO_HAS_TEXTURE;
			draw.texture_id = ent.tex_id
		}
		Draw3D(ctx.window, &draw);
	}
	else
	{
		//__dbg_break
		draw:draw_info;
		draw.pos = ent.pos;
		draw.pivot = ent.pivot;
		draw.cam_pos = cam_pos;
		draw.cam_rot = cam_rot;
		draw.rot = ent.rot;
		draw.ent_size = ent.size;
		if ent.forward.x != 0.0
			draw.ent_size.x = draw.ent_size.x * ent.forward.x;
		draw.cam_size = 5.0;
		if is_flag_on(ent.flags, ENTITY_HAS_TEXTURE)
		{
			//__dbg_break;
			draw.flags = DRAW_INFO_HAS_TEXTURE;
			draw.texture_id = ent.tex_id;
			draw.tex_size_x = ent.tex_size_x;
			draw.tex_size_y = ent.tex_size_y;
			draw.tex_offset_x = ent.tex_offset_x;
			draw.tex_offset_y = ent.tex_offset_y;
		}
		if is_flag_on(ent.flags, ENTITY_IS_MASKED)
		{
			//__dbg_break;
			draw.flags = draw.flags | DRAW_INFO_STENCIL_TEST;
			draw.stencil_func = ent.stencil_func;
			draw.stencil_val = ent.stencil_val;
		}
		memcpy(cast(*void)draw.color, &ent.color, 4 * sizeof(f32));

		Draw(ctx.window, &draw);
		
		if ctx.draw_origin
		{
			draw.flags = 0;
			*draw.color[0] = 1.0;
			*draw.color[1] = 0.0;
			*draw.color[2] = 0.0;
			*draw.color[3] = 1.0;
			draw.ent_size.x = 0.1;
			draw.ent_size.y = 0.1;
			draw.pos.z = 0.04;
			Draw(ctx.window, &draw);
			
			*draw.color[0] = 0.0;
			*draw.color[1] = 1.0;
			*draw.color[2] = 0.0;
			*draw.color[3] = 1.0;
			draw.pos.y = ent.pos.y + ent.pivot.y * ent.col_size.y;
			Draw(ctx.window, &draw);
			
			*draw.color[0] = 0.0;
			*draw.color[1] = 0.0;
			*draw.color[2] = 1.0;
			*draw.color[3] = 1.0;
			draw.pos.y = ent.pos.y - ent.pivot.y * ent.col_size.y;
			//draw.
			Draw(ctx.window, &draw);
			//draw.ent_size.x
		}
	}
}
