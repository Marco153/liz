import "../../core";
import "../common";


DisableEnt::fn(ent : *entity)
{
	if !ent.is_active
		return;
	for col in ent.ents_in_collision
	{
		col.in_col = false;
		col.ent = nil;
	}
	ent.is_active = false;

	if ent.type == ent_type.ENEMY
	{
		if ent.enemy_type == enemy_enum.THRAXER || ent.enemy_type == enemy_enum.WOLF
		{
			DisableEnt(ent.mov_info.trigger);
		}
	}
}

NewEnt::fn(alloc : *mem_alloc, name : str_lit) ! *entity
{
	ent := LinearGet(&globals.entities, 1)
	//ASSERT((globals.entity_cur + 1) <= globals.entity_max)
	//ent := ptr_offset(globals.entity_start,globals.entity_cur, entity);
	memset(ent, 0, sizeof(entity));
	//globals.entity_cur++;
	ent.color = []f32{1.0, 1.0, 1.0, 1.0};
	ent.name = name;
	ent.size.x = 1.0;
	ent.size.y = 1.0;
	ent.size.z = 1.0;
	ent.col_size.x = 1.0;
	ent.col_size.y = 1.0;
	ent.col_size.z = 1.0;
	ent.tex_size_x = 1.0;
	ent.tex_size_y = 1.0;
	ent.rot = euler_to_quaternion(0.0, 00.0, 0.0).v
	
	return ent;
}
