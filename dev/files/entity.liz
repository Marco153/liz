draw_terrain::fn(ctx : *scene_info, e : *entity, drw_set : *draw_settings)
{
	trn : *terrain_info= e.terrain
	//__dbg_break
	draw : draw_info3d
	custom_shader_setting(ctx, e, &draw)
	draw.sun_dir = drw_set.sun_dir
	draw.sun_color = drw_set.sun_color
	for m in trn.meshes
	{
		draw.model = m.model
		//__dbg_break
		draw.pos = e.pos + m.pos
		draw.rot = e.rot
		draw.cam_pos = drw_set.cam_pos
		draw.cam_rot = drw_set.cam_rot
		draw.cam_forward = drw_set.cam_forward
		draw.ent_size.x = 1.0
		draw.ent_size.y = 1.0
		draw.ent_size.z = 1.0
		memcpy(cast(*void)draw.color, &e.color, 4 * sizeof(f32));
		Draw3D(drw_set.window, &draw);
	}
}
LookAtPlayerEnts::fn(ctx : *scene_info, drw_set : *draw_settings)
{
  cam_pos := drw_set.cam_pos
  cam_rot := drw_set.cam_rot
  cam_forward := drw_set.cam_forward
	for ent in ctx.look_at_ents
	{
		if !ent.is_active
		{
			continue
		}
		ent.rot = euler_to_quaternion(0.0, radians_to_degree(cam_rot.y), 0.0).v
		draw : draw_info3d

		draw.model = 1
		draw.pos = ent.pos
		draw.rot = ent.rot
		draw.cam_pos = cam_pos
		draw.cam_rot = cam_rot
		draw.cam_forward = cam_forward
		draw.ent_size = ent.size
		memcpy(cast(*void)draw.color, &ent.color, 4 * sizeof(f32));
		memcpy(cast(*void)&draw.sec_color, &ent.sec_color, 4 * sizeof(f32));
		draw.color_lerp = ent.color_lerp
		if(is_flag_on(ent.flags, ENTITY_ALWAYS_ON_FRONT))
		{
			draw.flags = draw.flags | DRAW_INFO_ALWAYS_ON_FRONT;
		}
		if(is_flag_on(ent.flags, ENTITY_TRANSPARENT))
		{
			draw.flags = draw.flags | DRAW_INFO_TRANSPARENT;
		}
		if(is_flag_on(ent.flags, ENTITY_HAS_TEXTURE))
		{
			draw.flags = draw.flags | DRAW_INFO_HAS_TEXTURE ;
			draw.texture_id = get_id_of_texture_asset(&ent.tex_id)
		}
		draw.flags = draw.flags | DRAW_INFO_NO_LIGHT;
		Draw3D(drw_set.window, &draw);
	}
}

DRAW_BUFFER_MAX_COUNT:const s32= 512
DRAW_BUFFER_MAX_SIZE:const s32= 1024 * 256

get_transparents_offset_ptr ::fn(size : u32)!*object_draw_info
{
  scn := cast(*scene_draw_info)globals.scene_draw.buffer
  start := cast(*void)ptr_offset(scn, 1, scene_draw_info)

  start_count := cast(*void)ptr_offset(start, DRAW_BUFFER_MAX_COUNT, u8)
  start_data := cast(*void)ptr_offset(start, DRAW_BUFFER_MAX_COUNT * 2 + DRAW_BUFFER_MAX_SIZE, u8)
  scn.transparents_ptr = start_data

  cur := ptr_offset(start_count, scn.count_transparents, u32)
  *cur = scn.transparents_cur_size + DRAW_BUFFER_MAX_COUNT * 2 * 4 + DRAW_BUFFER_MAX_SIZE


  scn.transparents_cur_size += size
  assert(scn.transparents_cur_size < DRAW_BUFFER_MAX_SIZE)
  scn.count_transparents++

  scn.count_transparents = scn.count_transparents

  ret := cast(*object_draw_info)ptr_offset(start, *cur, u8)
  ret.flags = 0

  return ret
}
get_opaques_offset_ptr ::fn(size : u32)!*object_draw_info
{
  scn := cast(*scene_draw_info)globals.scene_draw.buffer
  start := cast(*void)ptr_offset(scn, 1, scene_draw_info)

  start_count := start
  start_data := cast(*void)ptr_offset(start, DRAW_BUFFER_MAX_COUNT * 2, u8)

  scn.opaques_ptr = start_data  

  cur := ptr_offset(start_count, scn.count_opaques, u32)
  *cur = scn.opaques_cur_size + DRAW_BUFFER_MAX_COUNT * 2 * 4

  scn.opaques_cur_size += size + sizeof(object_draw_info)
  assert(scn.opaques_cur_size < DRAW_BUFFER_MAX_SIZE)
  scn.count_opaques++

  scn.count_opaques = scn.count_opaques

  ret := cast(*object_draw_info)ptr_offset(start, *cur, u8)
  ret.flags = 0

  return ret
}
fill_terrain2_draw_data::fn(ctx : *scene_info, ent : *entity)
{
  MODEL_SIZE_UBO :u32= 64
  trn := ent.trn

  for ch in trn.chunks_enabled
  {
    data:*object_draw_info
    // 64 is for the model matrix, the rendrer still expects us to have a space for the model matrix there, because it will perform the matrix mul there, and update the uniform with it
    total_size:u32= MODEL_SIZE_UBO + sizeof(terrain_chunk_draw_info)

    data = cast(*object_draw_info)get_opaques_offset_ptr(total_size + 4)
    data.pos.x = cast(f32)ch.pos_x
    data.pos.y = cast(f32)ch.pos_y
    data.pos.z = cast(f32)ch.pos_z
    data.size.x = 1.0
    data.size.y = 1.0
    data.size.z = 1.0
    data.rot.x = 0.0
    data.rot.y = 0.0
    data.rot.z = 0.0
    data.rot.w = 1.0
    data.textures_count = 1
    data.flags = OBJ_DRAW_FLAGS_IS_TERRAIN_CHUNK
    data.model_uniform_size = MODEL_SIZE_UBO
    // this is unrealiable behaviour, but the first shader the we create is the terrain shader, so thats the zero
    data.shader_id = 0

    chunk_draw := cast(*terrain_chunk_draw_info )ptr_offset(data, MODEL_SIZE_UBO + sizeof(object_draw_info), u8)
    chunk_draw.total_faces = ch.total_faces
    //printf("drawing chunk: total_faces {ch.total_faces}")
    chunk_draw.ubo = ch.ubo


    texture_ptr := cast(*u32)ptr_offset(chunk_draw, 1, terrain_chunk_draw_info)
    *texture_ptr = globals.terrain_tex.asset_idx

    //i++
    //data.pos = e.pos
  }
}
DrawEnts::fn(ctx : *scene_info, cam_pos : *_vec, cam_rot : *_vec, drw_set : *draw_settings)
{
	if ctx.drawable_ents.count == 0
		return;


	for e in ctx.drawable_ents
	{
		if e.is_active == false || e.type == ent_type.PLAYER
			continue
		if e.type == ent_type.TERRAIN2
    {
      fill_terrain2_draw_data(ctx, *e)
      continue
    }

    //printf("ent {e.name}\n")

    //__dbg_break
    data:*object_draw_info
    m := get_material_ptr(&e.material_idx)
    inst := m.instances[cast(u64)e.in_material_instance]
    size := m.data_size + m.textures_count * 4

		if is_flag_on(e.flags, ENTITY_TRANSPARENT)
		{
      data = cast(*object_draw_info)get_transparents_offset_ptr(size)
		}
    else
    {
      data = cast(*object_draw_info)get_opaques_offset_ptr(size)
    }
    //__dbg_break
    data.model_id = get_id_of_model(&e.model)
    data.pos = e.pos
    data.size = e.size
    data.rot = e.rot
    data.shader_id = m.shader_id
    data.model_uniform_size = m.data_size
    data.textures_count = m.textures_count

    start_model_uniform := ptr_offset(data, 1, object_draw_info)
    start_texture_uniform := ptr_offset(start_model_uniform, m.data_size, u8)

    memcpy(start_model_uniform, inst.data, m.data_size)
    i:= 0

    //if m.textures_count >= 3 __dbg_break

    for u in inst.uniforms
    {
      if cast(lang_type_type)u.type == lang_type_type.SAMPLER2D
      {
        cur_texture_ptr := ptr_offset(start_texture_uniform, i, u32)
        asset := globals.assets[cast(u64)u.tex.asset_idx]
        *cur_texture_ptr = get_id_of_texture_asset(&u.tex)
        /*
        if !globals.first
        {
            AddMemoryWatch(cur_texture_ptr)
        }
        globals.first = true
        */

        i++
      }
    }

/*

		if(e.type == ent_type.TERRAIN)
		{
			draw_terrain(ctx, *e, drw_set)
		}
		else
		{
			DrawEntity(ctx, *e, drw_set);
		}
    */
	}
  //__dbg_break

}
custom_shader_setting::fn(ctx : *scene_info, ent : *entity, draw : *draw_info3d)
{				
	draw.flags = draw.flags | DRAW_INFO_CUSTOM_SHADER
	draw.flags = draw.flags & ~DRAW_INFO_HAS_TEXTURE
	
	m := get_material_ptr(&ent.material_idx)
	inst := m.instances[cast(u64)ent.in_material_instance]

	//printf("custom shader. shader id {m.shader_id}\n")

	if m.cull_type != 0
	{
		SetCulling(m.cull_type)
	}
  //if str_cmp(ent.name, "hy.fbx") __dbg_break

	draw.shader_id = m.shader_id

  __dbg_break
	SetShader(draw.shader_id)

	//a :lang_type_type
	i := 0
  //printf("ent {ent.name}, shader {m.name}\n")

  //if str_cmp(ent.name, "hy.fbx") __dbg_break

	for u in inst.uniforms
	{
		//a.type = cast(lang_type_type)u.type
    globals.temp_alloc.cur = 0
    u_name := m.uniforms[cast(u64)i]
    //printf("name {u_name.name}\n")


		if u.is_array
		{
			on cast(lang_type_type)u.type
			{
			lang_type_type.MAT4
			{
				SetUniformMatrices4x4(u.uniform_id, u.array_sz, u.data)
			}
			default
			{
				aux :lang_type
				aux.type = cast(lang_type_type)u.type
				__dbg_break
			}
			}
		}
		else
		{
			on cast(lang_type_type)u.type
			{
			lang_type_type.SAMPLER2D
			{
				//__dbg_break
        //

				SetSampler2D(u.uniform_id, get_id_of_texture_asset(&u.tex))
			}
			lang_type_type.F32
			{
				v := u.v
				SetUniform1f(u.uniform_id, v.x)

			}
			lang_type_type.V2
			{
				v := u.v
				SetUniform2f(u.uniform_id, v.x, v.y)

			}
			lang_type_type.V3
			{
				v := u.v
				SetUniform3f(u.uniform_id, v.x, v.y, v.z)

			}
			lang_type_type.V4
			{
				v := u.v
				SetUniform4f(u.uniform_id, v.x, v.y, v.z, v.w)
			}
			lang_type_type.MAT4
			{

			}
			default
			{
				aux :lang_type
				aux.type = cast(lang_type_type)u.type
				__dbg_break
			}
			}
		}
		i++
	}

	
}
DrawEntity::fn(ctx : *scene_info, ent : *entity, drw_set : *draw_settings)
{
	//PrintV3(cast(f32)cast(u32)ent.is_active, 0.0, 0.0);
  /*
  if IsKeyDown(key_enum.KEY_P) && str_cmp(ent.name, "player")
  {
    __dbg_break
  }
  */
	if !ent.is_active
		return;
	//printf("ent {ent.name}\n")

		
	if(is_flag_on(ent.flags, ENTITY_3D))
	{
		//printf("will draw ent {ent.name}\n")
		draw : draw_info3d
		if is_flag_off(ent.flags, ENTITY_ONLY_COL)
		{
			//printf("name {ent.name}\n")
			draw.model = get_id_of_model(&ent.model)
			draw.pos = ent.pos
			draw.rot = ent.rot
			draw.cam_pos = drw_set.cam_pos
			draw.cam_rot = drw_set.cam_rot
			draw.cam_forward = drw_set.cam_forward
			draw.sun_dir = drw_set.sun_dir
			draw.sun_color = drw_set.sun_color
			draw.ent_size = ent.size

			final_col := ent.color

			if globals.selected_ent == ent
			{
				s := clamp(sin(GetTime() * 4.0), 0.0, 1.0)
				yellow :_vec=final_col/2.0

				diff := yellow - final_col

				aux := final_col + (diff * s)

				final_col.x = aux.x
				final_col.y = aux.y
				final_col.z = aux.z
				//print_vec(&final_col)
			}

			final_col = final_col * ctx.color

/*
			if ent.type == ent_type.AXIS 
			{
        printf("sc name {ctx.name}\n")
				print_vec(&ctx.color)
			}
      */

			memcpy(cast(*void)&draw.color, &final_col, 4 * sizeof(f32));
			memcpy(cast(*void)&draw.sec_color, &ent.sec_color, 4 * sizeof(f32));

			draw.color_lerp = ent.color_lerp
			if(is_flag_on(ent.flags, ENTITY_ALWAYS_ON_FRONT))
			{
				draw.flags = draw.flags | DRAW_INFO_ALWAYS_ON_FRONT;
			}
			if(is_flag_on(ent.flags, ENTITY_NO_LIGHT))
			{
				draw.flags = draw.flags | DRAW_INFO_NO_LIGHT;
			}
			if(is_flag_on(ent.flags, ENTITY_TRANSPARENT))
			{
        //__dbg_break
				draw.flags = draw.flags | DRAW_INFO_TRANSPARENT2 
			}
			if(is_flag_on(ent.flags, ENTITY_HAS_TEXTURE))
			{
				draw.flags = draw.flags | DRAW_INFO_HAS_TEXTURE;
				draw.texture_id = get_id_of_texture_asset(&ent.tex_id)
			}
			draw.name = ent.name

			if(is_flag_on(ent.flags, ENTITY_CUSTOM_SHADER))
			{
				custom_shader_setting(ctx, ent, &draw)
			}


			Draw3D(drw_set.window, &draw);
		}


		if ctx.draw_col && ent.type != ent_type.AXIS
		{
			draw.model = 0
			draw.pos = ent.pos + ent.col_offset
			draw.ent_size = ent.col_size * 1.001
			draw.cam_forward = drw_set.cam_forward
			draw.cam_pos = drw_set.cam_pos
			draw.cam_rot = drw_set.cam_rot
			draw.rot = ent.rot
			draw.flags = DRAW_INFO_TRANSPARENT
			*draw.color[0] = 1.0
			*draw.color[1] = 1.0
			*draw.color[2] = 1.0
			*draw.color[3] = 0.5
			Draw3D(drw_set.window, &draw)
		}
	}
	else
	{
		//__dbg_break
		draw:draw_info;
		draw.pos = ent.pos;
		draw.pivot = ent.pivot;
		draw.cam_pos = drw_set.cam_pos;
		draw.cam_rot = drw_set.cam_rot;
		draw.rot = ent.rot;
		draw.ent_size = ent.size;
		if ent.forward.x != 0.0
			draw.ent_size.x = draw.ent_size.x * ent.forward.x;
		draw.cam_size = 5.0;
		if is_flag_on(ent.flags, ENTITY_HAS_TEXTURE)
		{
			//__dbg_break;
			draw.flags = DRAW_INFO_HAS_TEXTURE;
			draw.texture_id = get_id_of_texture_asset(&ent.tex_id);
			//draw.tex_size_x = ent.tex_size_x;
			//draw.tex_size_y = ent.tex_size_y;
			//draw.tex_offset_x = ent.tex_offset_x;
			//draw.tex_offset_y = ent.tex_offset_y;
		}
		if is_flag_on(ent.flags, ENTITY_IS_MASKED)
		{
			//__dbg_break;
			draw.flags = draw.flags | DRAW_INFO_STENCIL_TEST;
			draw.stencil_func = ent.stencil_func;
			draw.stencil_val = ent.stencil_val;
		}
		memcpy(cast(*void)draw.color, &ent.color, 4 * sizeof(f32));

		Draw(drw_set.window, &draw);
		
    /*
		if ctx.draw_origin
		{
			draw.flags = 0;
			*draw.color[0] = 1.0;
			*draw.color[1] = 0.0;
			*draw.color[2] = 0.0;
			*draw.color[3] = 1.0;
			draw.ent_size.x = 0.1;
			draw.ent_size.y = 0.1;
			draw.pos.z = 0.04;
			Draw(ctx.window, &draw);
			
			*draw.color[0] = 0.0;
			*draw.color[1] = 1.0;
			*draw.color[2] = 0.0;
			*draw.color[3] = 1.0;
			draw.pos.y = ent.pos.y + ent.pivot.y * ent.col_size.y;
			Draw(ctx.window, &draw);
			
