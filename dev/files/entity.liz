import "../../core";
import "../common";
import "../lang";


DisableEnt::fn(ent : *entity)
{
	if !ent.is_active
		return;
	for col in ent.ents_in_collision
	{
		col.in_col = false;
		col.ent = nil;
	}
	ent.is_active = false;

	if ent.type == ent_type.ENEMY
	{
	}
}

RemoveEntFromAr::fn(ar : *dyn_array(*entity), ent : *entity)!bool
{

	i :u32= 0
	found := false
	for e in *ar
	{
		if *e == ent
		{
			found = true
			break
		}
		i++
	}
	if found
	{
		dyn_rem(ar, i)
	}
	return found
}
deactivate_ent::fn(ctx : *context, e : *entity)
{
	e.is_active = false
}
DeleteEnt::fn(ctx : *context, ent : *entity)
{
	a :=0
	val :bool
	for t in ent.remove_from
	{
		te := cast(ent_part_of)*t
		on te
		{
		ent_part_of.LOOK_AT_PLAYER
		{
			val = RemoveEntFromAr(&ctx.look_at_ents, ent)
			ASSERT(val)
			a=0 
		}
		ent_part_of.ITEMS
		{
			val = RemoveEntFromAr(&ctx.items_ents, ent)
			ASSERT(val)
			a=0 
		}
		ent_part_of.PLAYABLE
		{
			val = RemoveEntFromAr(&ctx.playable_ents, ent)
			ASSERT(val)
			a=0 
		}
		ent_part_of.ANIMATION
		{
			val = RemoveEntFromAr(&ctx.ents_with_clip, ent)
			ASSERT(val)
			a=0 
		}
		ent_part_of.EMMITTER
		{
			val = RemoveEntFromAr(&ctx.emmitters, ent)
			ASSERT(val)
			a=0 

			heap_free(ctx.alloc, ent.emmitter.particles)
			heap_free(ctx.alloc, ent.emmitter)
		}
		ent_part_of.DRAWABLE
		{
			val = RemoveEntFromAr(&ctx.drawable_ents, ent)
			ASSERT(val)
			a=0 
		}
		ent_part_of.COLLIDER
		{
			remove_body(ctx, ent)
		}
		ent_part_of.INSTANTIATED
		{
			val = RemoveEntFromAr(&ctx.ents, ent)
			ASSERT(val)
			a=0 
		}
		default
		{
			__dbg_break
		}
		}
	}
	ent.flags = 0
}
NewEnt::fn(ctx : *context, name : str_lit) ! *entity
{
	ent :*entity
	i :u64=0
	while i < globals.entities.max
	{
		ent = ptr_offset(globals.entities.start, i, entity);
		if is_flag_off(ent.flags, ENTITY_IN_USE)
		{
			break
		}
		ent = nil
		i++
	}
	ASSERT(ent)
	memset(ent, 0, sizeof(entity));
	ent.material_idx.asset_idx = 0
	dyn_add(&ent.remove_from, ent_part_of.INSTANTIATED)
	dyn_add(&ctx.ents, ent)
	ent.flags = ENTITY_IN_USE
	ent.color = _vec{1.0, 1.0, 1.0, 1.0};
	ent.name = new_str_lit(ctx.alloc, "{name}_idx{i}");
	ent.size.x = 1.0;
	ent.size.y = 1.0;
	ent.size.z = 1.0;
	ent.col_size.x = 1.0;
	ent.col_size.y = 1.0;
	ent.col_size.z = 1.0;
	ent.rot = euler_to_quaternion(0.0, 0.0, 0.0).v
	
	return ent;
}
