		if ctx.textures_wnd
		{
			info:imgui_window=?
			info.
			{
				name = "textures"
				items = cast(u32)globals.textures.count
				items_per_line = 4
				selected_ref = &ctx.selected_tex
				window_bool = &ctx.textures_wnd
				item_width = 64.0
				item_height = 64.0
				_out_ent = out_ent
				ptr = ctx.selected_tex_ref
				func = fn(ctx : *context, info : *imgui_window, id : u32)
				{
					a := globals.assets[cast(u64)id + ASSETS_TEXTURES_OFFSET]
					if a.TEXTURE_ARRAY.texs.count > 0
