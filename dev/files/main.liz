	else
		__dbg_break;
	return "TEXT NOT FOUND";
}

Cutscenes::fn coroutine(cor_ctx : *coroutine_ctx, ctx : *context, dt : *f32)
{
	if ctx.cutscene_idx == 1
	{
		globals.player.mov_info.can_move = false;
		//ctx.
		//ct
		//globals.player.can_move //=
		//CorWait(4.0);
		ChangePrinterStr(ctx, GetDialogueStr(dialogue_enum.LEVEL_1_SIGN, 0));
		CorMoveVecTo(ctx.cam_pos_global, -29.0, 5.0, 0.0, 2.0, ctx.cam_col_left);
		while true
		{
			if ctx.prntr.done && IsKeyDown(key_enum.KEY_JMP)
			{
				break;
			}
			return;
		}
		ClearPrinterStr(ctx);
		globals.player.mov_info.can_move = true;
		ctx.cutscene_idx = 0;
		ResetCoroutine();
	}
}


to_deactivate_func::fn(ctx : *scene_info, dt : f32)
{
	for i in 0..ctx.to_deactivate.count
	{
		e := *ctx.to_deactivate[cast(u64)i]
		e.timer_deactivate -= dt
		//printf("cur is {i}\n")
		if e.timer_deactivate <= 0.0
		{
			deactivate_ent(ctx, e)

			dyn_rem(&ctx.to_deactivate, cast(u32)i)
			i--
		}
	}
}

MakeEntMasked::fn(ctx : *context, ent : *entity, masked :  *masked_info)
{
	ent.flags = ent.flags | ENTITY_IS_MASKED;
	ent.stencil_val = masked.stencil_val;
	ent.stencil_func = stencil_func_enum.EQUAL;
	ent.masking_objs = &ctx.masking_objs;
}
FreeArrayOfEnts::fn(ar : *dyn_array(*entity))
{
	for e in *ar
	{
		if is_flag_on(e.flags, ENTITY_DONT_FREE | ENTITY_FREED)
			continue;
		e.flags = ENTITY_DONT_FREE;
		heap_free(ar.alloc, *e);
		
	}
}

min :: fn(a : s32, b : s32) ! s32
{
	if a < b return a;
	return b;
}
min :: fn(a : u32, b : u32) ! u32
{
	if a < b return a;
	return b;
}
min :: fn(a : f32, b : f32) ! f32
{
	if a < b return a;
	return b;
}

axe_throw_callback::fn(data : *anim_callback_info) !bool
{
	if data.time_since_stopped > 3.0
		return true;
	return false;
}

NewAxeEnt::fn(ctx : *scene_info) ! *entity
{
	axe_ent := NewEnt(ctx, "axe");
	axe_ent.is_trigger = true;
	axe_ent.type = ent_type.AXE;
	add_body(ctx, axe_ent);
	axe_ent.flags = ENTITY_HAS_TEXTURE | ENTITY_DONT_FREE;
	axe_ent.layer = LAYER_TRIGGER
	//axe_ent.tex_id = cast(u32)ctx.axe_tex;
	axe_ent.is_active = true;
	axe_ent.axe = cast(*axe_info)heap_alloc(ctx.alloc, sizeof(axe_info));
	axe_ent.pivot.x = 0.5;
	axe_ent.pivot.y = 0.5;
	axe_ent.pos.y = 5.0;
	return axe_ent;
}
NewPlayerEnt::fn(ctx : *scene_info, name : str_lit) ! *entity
{
	player_ent:*entity;
	NewPlayableEnt(ctx, &player_ent, false);

	dyn_add(&player_ent.remove_from, ent_part_of.DRAWABLE)
	dyn_add(&player_ent.remove_from, ent_part_of.COLLIDER)
	
	player_ent.flags = player_ent.flags | ENTITY_DONT_FREE | ENTITY_SERIALIZE;
	//player_ent.mov_info.axe_ent = NewAxeEnt(ctx);
	
	dyn_add(&ctx.drawable_ents, player_ent)
	player_ent.model.asset_idx = ASSETS_MODELS_OFFSET
	
	player_ent.layer = LAYER_ENTITY_PLAYABLE | LAYER_PLAYER
	player_ent.dont_res_cols_with_layers = LAYER_ENTITY_PLAYABLE;

	player_ent.name = name;
	player_ent.pos.x = 4.0;
	player_ent.pos.y = 4.0;
	player_ent.size.x = 1.0;
	player_ent.size.y = 1.0;
	player_ent.col_size.x = 0.7;
	player_ent.col_size.y = 0.7;
	player_ent.pivot.x = 0.5;
	player_ent.pivot.y = 0.5;
	player_ent.color.x = 1.0;
	player_ent.color.y = 1.0;
	player_ent.color.z = 1.0;
	player_ent.color.w = 1.0;
	player_ent.col_enter = player_collision_enter;
	player_ent.col_stay = player_collision_stay;
	player_ent.col_exit = player_collision_exit;
	player_ent.is_active = true;

	player_ent_trigger: = player_ent.mov_info.trigger;
	pinfo: = player_ent.mov_info;
	pinfo.{
		speed = 0.01;
	};


	mov_info := player_ent.mov_info;
	
	player_ent.flags = player_ent.flags | ENTITY_HAS_TEXTURE;
	
	
	
	return player_ent;
}

