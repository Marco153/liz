	}

	//ctx.screen_tex_id = GenRawTexture(256, 256, gen_texture_type.RGBA, gen_texture_filter.NEAREST, gen_texture_size.BYTE)

	trn_ent.flags = trn_ent.flags | ENTITY_CUSTOM_SHADER
	trn_ent.material_idx = find_shader(ctx, "terrain.mat")
	trn_ent.in_material_instance = new_material_instance(ctx, &trn_ent.material_idx, trn_ent)
	set_shader_uniform_sampler2d(ctx, trn_ent, "tex", &ctx.grid_transparent_tex)
	set_shader_uniform_sampler2d(ctx, trn_ent, "tex2", &ctx.grass_tex)
	set_shader_uniform_sampler2d(ctx, trn_ent, "tex3", &ctx.water_tex)
	//set_shader_uniform_sampler2d(ctx, trn_ent, "heightmap", &ctx.terrain_tex)
	set_shader_uniform2f(ctx, trn_ent, "terrain_size", cast(f32)ctx.terrain_tex.width, cast(f32)ctx.terrain_tex.height)
	set_shader_uniform1f(ctx, trn_ent, "amplitude", cast(f32)terrain.amplitude)
	trn_ent.is_active = false
    */

	cam_dir_terrain :_vec

	on_click_dir :_vec
	on_click_pos :_vec
	on_click_ent_pos :_vec
	on_click_ent_pos_add :_vec
	on_click_ent_size :_vec


	ctx.cam_dist = 5.0

  ld_stage :loading_stage

  in_scenes :dyn_array(*scene_info)
	while !ShouldClose(ctx.window)
	{
		//aux_c := *ctx.test_ent.cols[0]
/*

		rsp := get_reg(&ctx.mach, RSP_REG)
		*rsp = 1024
		rbp := get_reg(&ctx.mach, RBP_REG)
		*rbp = 1024
		*cast(*u64)ctx.mach.data[*rsp] = 0
		*cast(*bool)ctx.mach.data[2000] = IsKeyHeld(key_enum.KEY_P)

		//val_t := *cast(*u32)ctx.mach.data[4000]

		//printf("val is {val_t}\n")

		bc_logic(&ctx.mach, &ctx.mach.bcs, 0)

		for i2 in 0..4
		{
			val := *cast(*u32)ptr_offset(ctx.mach.data.data, 4000 + i2 * 4, u8)
			printf("i{i2} is {val}, ")

		}
		printf("\n")
		*/

		if ctx.grid_ent.cols.count > 0
		{
			__dbg_break
		}

		dt_aux: = GetTime() - last_time;
		dt: = 0.017;

    dt_aux = 1.0/dt_aux
		//printf("dt {dt_aux}, tris checkd {globals.tris_checked}\n")

		ctx.i_clicked = IsKeyDown(key_enum.KEY_I)
		globals.timer = 0.0;

		screenmx := GetMouseScreenPosX();
		screenmy := GetMouseScreenPosY();
		
		curmx := GetMouseScreenPosX();
		curmy := GetMouseScreenPosY();
		dir := ScreenMouseToWorld(screenmx, screenmy)
		
		//dir.y = -dir.y
		cam_dir := cam_pos + dir * 20.0
		cam_dir2 := cam_pos + dir * 5.0

		cam_dir = cam_pos + dir * 2000.0

		ctx.dt = dt
		last_time = GetTime();
		ctx.time_since_start += dt


		ClearBackground(0.2, 0.5, 0.8);

		f := 0.5
		player_ent.color.x = 1.0
		player_ent.color.y = 0.0
		player_ent.color.z = 0.0

		ang: f32=?
		cross := cross_vec(&globals.up, &cam_forward)

		//cam_mov(ctx)



		change_select_ent_col :bool

		if IsKeyDown(key_enum.KEY_F1)
		{
			ctx.can_deactivate_path_ents = true
			ctx.editor_cam = !ctx.editor_cam 
			change_select_ent_col = true

			if !ctx.editor_cam
			{
				x_axis_ent.is_active = false
				y_axis_ent.is_active = false
				z_axis_ent.is_active = false
				//all_axis_ent.is_active = false
				
				change_preview_col_idx(ctx, 0)

				ctx.textures_wnd = false

			}
			else
			{

			}
		}
		if ctx.editor_cam
		{
			//printf("model {ctx.grid_ent.model}\n")
			if IsKeyHeld(key_enum.KEY_LCTRL) && IsKeyDown(key_enum.KEY_S)
			{
				SaveScene(ctx.cur_scn, ctx.cur_scn.name, &ctx.per_scene_alloc)
			}

			if !ImGuiHasFocus()
			{
				mvx := GetMouseVelX() * dt
				mvy := GetMouseVelY() * dt
				cam_mov_editor(ctx, mvx, mvy)
        sel_fw:_vec
        if axis_sel_ent
        {
          sel_fw = axis_sel_ent.forward 
        }
        else
        {

          sel_fw.z = 0.0
        }

				if IsKeyDown(key_enum.KEY_P)
				{
					player_ent.pos = cam_pos
				}
				if IsKeyDown(key_enum.KEY_1)
				{
					sel_action = select_action.MOV
					//all_axis_ent.is_active = false
				}
				if IsKeyDown(key_enum.KEY_2)
				{
					if sel_action == select_action.SCALE_ONE_AXIS
					{
						sel_action = select_action.SCALE_ONE_AXIS2
						
					}
					else if sel_action == select_action.SCALE_ONE_AXIS2
					{
						sel_action = select_action.SCALE_ONE_AXIS
					}
					else
					{
						sel_action = select_action.SCALE_ONE_AXIS
					}
					//all_axis_ent.is_active = true

				}
				if IsKeyDown(key_enum.KEY_3)
				{
					sel_action = select_action.SCALE
					//all_axis_ent.is_active = true
				}
				if IsKeyDown(key_enum.KEY_4)
				{
					change_preview_col_idx(ctx, globals.cur_preview_idx + 1)
				}
				if IsKeyDown(key_enum.KEY_5)
				{
					sel_action = select_action.ROT
					//all_axis_ent.is_active = false
				}

				if axis_sel_ent
				{
					local_fw := axis_sel_ent.vel 
					global_fw := axis_sel_ent.forward 

					dx := dot_vec(&local_fw, &select_right) * mvx
					pos_ptr := &out_ent.pos
					size_ptr := &out_ent.size

					prev_ent := out_ent
					if globals.cur_preview_idx == 0 && out_ent.type == ent_type.AUX_COL_ENT
					{
						out_ent = out_ent.parent_col
					}

					dist := len_vec(&(cam_pos - out_ent.pos))
					mul := 2.0 + dist
					n :_vec
					up_vec := globals.up
					if dot_vec(&globals.up, &local_fw) > 0.99
					{
						up_vec = _vec{1.0, 0.0, 0.0}
					}

					n = cross_vec(&up_vec, &local_fw)
					//printf("\n")

					denom := dot_vec(&n, &dir)
					if denom <= 0.001
					{
						//denom = 1.0
					}


					aux_pos := on_click_pos - cam_pos

					t := dot_vec(&n, &(aux_pos)) / denom
					final_pos := cam_pos + dir * t
					to_pos := final_pos - on_click_pos
					//printf("denom {denom}, t {t}\n")

					//printf("t {t}\n")


					on sel_action
					{
					select_action.MOV
					{
						to_pos_dot := dot_vec(&local_fw, &to_pos)
						final_pos = on_click_pos + local_fw * to_pos_dot
						draw_line(ctx, &out_ent.pos, &final_pos, &ctx.white_color, 0)
						diff_pos := final_pos - on_click_ent_pos 
						*pos_ptr = on_click_ent_pos + diff_pos
						on out_ent.type
						{
						ent_type.BRIDGE
						{
							out_ent.vel = *pos_ptr
						}
						ent_type.ITEM
						{
							out_ent.pos.w = pos_ptr.y
						}
						}
					}
					select_action.SCALE_ONE_AXIS
					{
						to_pos_dot := dot_vec(&local_fw, &to_pos)
						final_pos = on_click_pos + local_fw * to_pos_dot
						diff_pos := final_pos - on_click_ent_pos 

						len := len_vec(&diff_pos)

						*pos_ptr = on_click_ent_pos + diff_pos

						sz := axis_sel_ent.forward * len * 2.0
						sz = sz * sign(to_pos_dot)
						//printf("f {len}\n")

						*size_ptr = on_click_ent_size + sz

					}
					select_action.ROT
					{
						dx = -dx
						dy := dot_vec(&local_fw, &select_up) * mvy
						local_fw = local_fw * RAD_TO_DEG * (dx + dy)
						q : quaternion=?
						q.v = out_ent.rot
						out_ent.rot = (euler_to_quaternion(local_fw.x, local_fw.y, local_fw.z) * q).v
						if out_ent.type == ent_type.BRIDGE
						{
							out_ent.forward = out_ent.rot
						}
						for c in out_ent.cols
						{
							c.data_ready = false
						}
					}
					select_action.SCALE
					{
						dy := dot_vec(&local_fw, &select_up) * -mvy

						*size_ptr += local_fw * (dx + dy) * mul * 2.0
						if globals.cur_preview_idx == 0
						{
							out_ent.col_size += local_fw * (dx + dy) * mul * 2.0
						}

					}
					select_action.SCALE_ONE_AXIS2
					{
						to_pos_dot := -dot_vec(&local_fw, &to_pos)
						final_pos = on_click_pos + local_fw * to_pos_dot
						diff_pos := final_pos - on_click_ent_pos 

						*pos_ptr = on_click_ent_pos - diff_pos
						*size_ptr = on_click_ent_size + diff_pos * 2.0
						
					}
					}
					if out_ent != prev_ent
					{
						out_ent = prev_ent
					}
					if out_ent.type == ent_type.AUX_COL_ENT
					{
						parent := out_ent.parent_col
						p := out_ent.pos
						p.x = (p.x - parent.pos.x)/parent.size.x
						p.y = (p.y - parent.pos.y)/parent.size.y
						p.z = (p.z - parent.pos.z)/parent.size.z
						out_ent.aux_col.pos = p 

						sz := out_ent.size
						sz.x = sz.x /parent.size.x
						sz.y = sz.y /parent.size.y
						sz.z = sz.z /parent.size.z
						out_ent.aux_col.size = sz


					}
				}

				if IsKeyDown(key_enum.KEY_DEL) && out_ent != nil
				{
					DeleteEnt(ctx.cur_scn, out_ent)
					out_ent = nil
					x_axis_ent.is_active = true
					y_axis_ent.is_active = true
					z_axis_ent.is_active = true
					//all_axis_ent.is_active = true
				}
				if out_ent
				{
          if out_ent.is_static && out_ent.cols.count > 0 
          {
            c1 := *out_ent.cols[0]
            c1.data_ready = false
          }
					if out_ent.type == ent_type.AXIS
					{
					}
					else
					{

						x_axis_ent.pos = out_ent.pos

						y_axis_ent.pos = out_ent.pos
						
						z_axis_ent.pos = out_ent.pos
						
						//all_axis_ent.pos = out_ent.pos

						offset := 1.0
						x_axis_offset:_vec
						y_axis_offset:_vec
						z_axis_offset:_vec
						
						x_axis_offset.x = 1.0
						y_axis_offset.y = 1.0
						z_axis_offset.z = 1.0

						q :quaternion=?
						q.v = out_ent.rot


						x_axis_offset = q * x_axis_offset
						y_axis_offset = q * y_axis_offset
						z_axis_offset = q * z_axis_offset

						if sel_action == select_action.SCALE_ONE_AXIS2
						{
							x_axis_ent.pos -= x_axis_offset
							y_axis_ent.pos -= y_axis_offset
							z_axis_ent.pos -= z_axis_offset
						}
						else
						{
							x_axis_ent.pos += x_axis_offset
							y_axis_ent.pos += y_axis_offset
							z_axis_ent.pos += z_axis_offset
						}
						x_axis_ent.vel = x_axis_offset
						y_axis_ent.vel = y_axis_offset
						z_axis_ent.vel = z_axis_offset
						x_axis_ent.rot = out_ent.rot
						y_axis_ent.rot = out_ent.rot
						z_axis_ent.rot = out_ent.rot
					}
				}

				if IsKeyDown(key_enum.KEY_I)
				{
					if globals.cur_preview_idx == 1 && out_ent != nil
					{
						prev_ent := out_ent
						if out_ent.type == ent_type.AUX_COL_ENT
						{
							out_ent = out_ent.parent_col
						}
						if out_ent.cols.count == 0
						{
							add_body(ctx.cur_scn, out_ent);
						}
						printf("creting a new collider\n")
						new_col := new_ptr(collider)
						memset(new_col, 0, sizeof(collider))
						new_col.type = col_type.CUBE
						new_col.ent = out_ent
						new_col.size.x = 1.0
						new_col.size.y = 1.0
						new_col.size.z = 1.0
						dyn_add(&out_ent.cols, new_col)
						if prev_ent.type == ent_type.AUX_COL_ENT
						{
							out_ent = prev_ent
						}
					}
					else
					{
						dyn_clear(&ctx.vertex_terrain)
						prev_sel := out_ent
						aux_sel : *entity
						aux_sel_from_non_bodies : *entity
						shortest_dist : f32 = 9999.0
					
						point : _vec

						closest :*entity
						if RaycastWithNonBodies(ctx.cur_scn, &cam_pos, &cam_dir, &col, 0, &aux_sel_from_non_bodies)
						{
							printf("hit {aux_sel_from_non_bodies.name}\n")
							shortest_dist = len_vec(&(cam_pos - col.contact_point))
							point = col.contact_point
							closest = aux_sel_from_non_bodies
						}
						if Raycast(ctx.cur_scn, &cam_pos, &cam_dir, &col, 0, &aux_sel)
						{
							aux_dist := len_vec(&(cam_pos - col.contact_point))

							if aux_dist < shortest_dist 
							{
								point = col.contact_point
								closest = aux_sel
							}
						}
            /*
						if RaycastWithTerrain(ctx.cur_scn, &cam_pos, &cam_dir, trn_ent, &col)
						{
							aux_dist := len_vec(&(cam_pos - col.contact_point))

							if aux_dist < shortest_dist 
							{
								point = col.contact_point
							}
						}
            */

						n:=ctx.grid_ent.forward
						if ctx.on_custom_grid
						{
							denom := dot_vec(&n, &dir)
							t := dot_vec(&n, &(cam_pos - ctx.grid_ent.pos)) / denom
							point = cam_pos - dir * t
						}
						cube := new_cube(ctx.cur_scn, &point, &_vec{1.0, 1.0, 1.0}, true);

						new_rot := quaternion_to_euler(&ctx.grid_ent.rot)
						cube.rot = euler_to_quaternion(0.0, radians_to_degree(new_rot.y), 0.0).v


						if ctx.cur_model_selected_idx != -1
						{
							idx := cast(u64)ctx.cur_model_selected_idx + ASSETS_MODELS_OFFSET
							a := globals.assets[idx]
							m := &a.MODEL.mod
							cube.name = new_str_lit(ctx.alloc, m.name)
							cube.pos = globals.preview_ent.pos
							cube.model.asset_idx = cast(u32)idx
							cube.pos = globals.preview_ent.pos
							cube.flags = cube.flags & ~(ENTITY_HAS_TEXTURE)
							cube.rot = globals.preview_ent.rot
						}
						else
						{
							cube.tex_id = ctx.screen_tex_id
						}
						if ctx.on_contructing_path
						{
							//cube.flags = cube.flags | ENTITY_ALWAYS_ON_FRONT
							cube.pos += -col.normal
							printf("on path \n")
							if ctx.path_ents.count == 0
							{
								cube.size = cube.size * 2.0
							}
							dyn_add(&ctx.path_ents, cube)
							c1 := *cube.cols[0]
							CopyVerts(c1, &dir, &dir)
						}
					}
				}
				if IsMouseUp(mouse_enum.LEFT)
				{
					axis_sel_ent = nil
				}

				if IsMouseDown(mouse_enum.LEFT) && ctx.editor_wnd_type != editor_window_enum.GRID && 
				 	!IsKeyHeld(key_enum.KEY_LCTRL)
				{
          printf("before  out is {cast(u64)out_ent}\n")
					dyn_clear(&ctx.vertex_terrain)
					prev_sel := out_ent
					aux_sel : *entity
					aux_sel_from_non_bodies : *entity
					shortest_dist : f32 = 9999.0
				
					if RaycastWithNonBodies(ctx.cur_scn, &cam_pos, &cam_dir, &col, 0, &aux_sel_from_non_bodies)
					{
						//printf("hit {aux_sel_from_non_bodies.name}\n")
						shortest_dist = len_vec(&(cam_pos - col.contact_point))
					}
					if Raycast(ctx.cur_scn, &cam_pos, &cam_dir, &col, 0, &aux_sel)
					{
						aux_dist := len_vec(&(cam_pos - col.contact_point))
						if aux_dist < shortest_dist || aux_sel.type == ent_type.AXIS
						{
							
							shortest_dist = aux_dist
							aux_sel_from_non_bodies = nil
							x_axis_ent.is_active = true
							y_axis_ent.is_active = true
							z_axis_ent.is_active = true

							select_right = cross_vec(&dir, &globals.up)
							select_up = cross_vec(&select_right, &dir)
							on_click_dir = dir

							if aux_sel.type != ent_type.AXIS
							{
								on_click_ent_pos = aux_sel.pos
								on_click_ent_size = aux_sel.size
								on_click_pos = aux_sel.pos
								out_ent = aux_sel
								if prev_sel != nil
								{
									if  prev_sel != out_ent
										change_select_ent_col = true;
								}
								else
								{
									memcpy(&prev_select_ent_col, &out_ent.color, 16)
									start_selected_pos = out_ent.pos
								}
							}
							else
							{
								axis_sel_ent = aux_sel
								sel_fw = axis_sel_ent.forward
								if out_ent.model.asset_idx > ASSETS_MODELS_OFFSET + 1
								{

									id := get_id_of_model(&out_ent.model)
									ctx.model_farthes_vert = ModelFarthestPoint(cast(u32)id, &sel_fw)
									ctx.model_farthes_vert.y = dot_vec(&ctx.model_farthes_vert, &sel_fw)
								}
							}

							if out_ent.type != ent_type.AXIS
							{
								on_click_ent_pos = out_ent.pos
								on_click_ent_size = out_ent.size
								on_click_pos = out_ent.pos
							}

						}
					}
          /*
					else if RaycastWithTerrain(ctx, &cam_pos, &cam_dir_terrain, trn_ent, &col)
					{
						aux_dist := len_vec(&(cam_pos - col.contact_point))
						if aux_dist < shortest_dist
						{
							out_ent = trn_ent
						}
					}
          */
					else if aux_sel_from_non_bodies == nil
					{
						if out_ent != nil && out_ent.type != ent_type.TERRAIN
						{
							memcpy(&out_ent.color, &prev_select_ent_col, 16)
              printf("nilling")
							out_ent = nil
						}

						x_axis_ent.is_active = false
						y_axis_ent.is_active = false
						z_axis_ent.is_active = false
						//all_axis_ent.is_active = false
					}
					if aux_sel_from_non_bodies != nil && aux_sel == nil
					{
						out_ent = aux_sel_from_non_bodies
					}
          //printf("afte r out is {cast(u64)out_ent}\n")
				}

				//printf("path {ctx.on_contructing_path}, customgrid {ctx.on_custom_grid}, out {cast(u64)out_ent}, tp {cast(u32)out_ent.type}\n")
				if IsKeyHeld(key_enum.KEY_ALT)
				{
					if IsKeyHeld(key_enum.KEY_X)
					{
						DrawText(ctx, "{ctx.tedit.force}", -0.2, 0.0, &ctx.white_color, 0.7)
					}
					else if IsKeyHeld(key_enum.KEY_C)
					{
						draw_radial_menu(ctx, 0.0, 0.0, cast(*u32)&ctx.tedit.brush, brush_items_radial.len, brush_items_radial[0])
						if ctx.tedit.brush == terrain_brush_type.PATH
						{
							for e in ctx.path_ents
							{
								e.is_active = true
							}
							ctx.on_contructing_path = true
						}
						else
						{
							ctx.on_contructing_path = false
							ctx.can_deactivate_path_ents = true
						}
					}
					if IsMouseHeld(mouse_enum.LEFT)
					{
						if IsKeyHeld(key_enum.KEY_Z)
						{
							ctx.tedit.brush_size += mvx * 10.0
							if ctx.tedit.brush_size < 1.1
							{
								ctx.tedit.brush_size = 1.1
							}
						}
						if IsKeyHeld(key_enum.KEY_X)
						{
							ctx.tedit.force += mvx * 10.0
						}
					}
					dyn_clear(&ctx.vertex_terrain)
          /*
					if RaycastWithTerrain(ctx, &cam_pos, &cam_dir_terrain, trn_ent, &col)
					{
						out_ent = trn_ent
					}
					update_terrain_for_visualization(ctx, terrain, false)

					if IsKeyHeld(key_enum.KEY_V)
					{
						idx := get_pixel_idx(cast(s32)col.contact_point.x, cast(s32)col.contact_point.z, &ctx.terrain_tex)
						dst := ptr_offset(ctx.terrain_tex.data, idx, u8)
						ctx.tedit.terrain_height_max = cast(f32)cast(s32)*ptr_offset(dst, 0, u16)
						//draw_radial_menu(ctx, 0.0, 0.0, cast(*u32)&ctx.tedit.brush, brush_items_radial.len, brush_items_radial[0])
					}
          */
				}
				else if !ctx.on_contructing_path && !ctx.on_custom_grid &&  axis_sel_ent == nil && (out_ent == nil || out_ent.type == ent_type.TERRAIN)
				{
					cam_dir_terrain = cam_dir
					//printf("will try {ctx.frames_total}\n")
					if IsMouseHeld(mouse_enum.LEFT)
					{
            /*
						dyn_clear(&ctx.vertex_terrain)
						if RaycastWithTerrain(ctx, &cam_pos, &cam_dir, trn_ent, &col)
						{
							out_ent = trn_ent
						}
						update_terrain_for_visualization(ctx, terrain, true)
            */
					}
					if IsMouseUp(mouse_enum.LEFT)
					{
						calculate_normals(terrain)
						for vtx in ctx.vertex_terrain
						{
							verts := &vtx.mesh.verts
							m := vtx.mesh
							vt := cast(*terrain_vert_info)m.verts[vtx.vidx]
							vt.col.w = 0.0

						}
						for mi in ctx.mesh_added_aux
						{
							m := terrain.meshes[cast(u64)*mi]
							vi :u64
							verts := &m.verts
							count := m.verts.count
							//__dbg_break
							UpdateModel(m.model, m.verts.data)
						}
					}
				}
				else if ctx.on_contructing_path
				{
					i :u64
					limit := ctx.path_ents.count
					next :*entity
					//dir : _vec
					//cross :_vec
					path_width_start:_vec
					path_width_end:_vec
					pwidth_half := ctx.tedit.path_width * 0.5
					prev_dir:_vec
					prev_cross:_vec

					while i < limit
					{
						if limit == 1
							break;
						cur := ctx.path_ents[i]


						if i == 0 
						{
							
							next = *ctx.path_ents[i + 1]
							dir = next.pos - cur.pos
							cross = cross_vec(&globals.up, &dir)
							cross = normalize_vec(&cross)
							cross = cross * pwidth_half

							prev_cross = cross
							prev_dir = dir

							path_width_start = cur.pos - cross
							path_width_end = cur.pos + cross

							draw_line(ctx, &path_width_start, &path_width_end, &ctx.white_color, 0)
							draw_line(ctx, &cur.pos, &next.pos, &ctx.white_color, 0)
						}
						else if (i + 1) == limit
						{
							cross = cross_vec(&prev_dir, &globals.up)
							cross = normalize_vec(&cross)
							cross = cross * pwidth_half

							path_width_start = cur.pos - cross
							path_width_end = cur.pos + cross

							draw_line(ctx, &path_width_start, &path_width_end, &ctx.white_color, 0)

						}
						else
						{
							next = *ctx.path_ents[i + 1]

							dir = next.pos - cur.pos
							d := dot_vec(&normalize_vec(&dir), &normalize_vec(&prev_dir))

							cross = cross_vec(&dir, &globals.up)

							half_dir := lerp(&-dir, &prev_dir, 0.5)

							cross = lerp(&half_dir, &cross, d)

							cross = normalize_vec(&cross)
							cross = cross * pwidth_half

							prev_cross = cross
							prev_dir = dir

							path_width_start = cur.pos - cross
							path_width_end = cur.pos + cross

							draw_line(ctx, &cur.pos, &next.pos, &ctx.white_color, 0)
							draw_line(ctx, &path_width_start, &path_width_end, &ctx.white_color, 0)
						}
						cross.y = 0.0
						cur.vel = cross
						i++
					}
				}
			}
			if ctx.ent_collider_modify && out_ent != nil
			{

				//c1 := *out_ent.cols[0]
				//printf("total children {c1.children.count}\n")
				prev_ent := out_ent
				if out_ent.type == ent_type.AUX_COL_ENT
				{
					out_ent = out_ent.parent_col
				}
				for ch in out_ent.cols
				{

					sz := out_ent.size 
					sz.x = sz.x * ch.size.x
					sz.y = sz.y * ch.size.y
					sz.z = sz.z * ch.size.z

					p := out_ent.size 
					p.x = p.x * ch.pos.x
					p.y = p.y * ch.pos.y
					p.z = p.z * ch.pos.z

					q : quaternion=?
					q.v = out_ent.rot

					draw.ent_size = out_ent.col_size * 1.001 * sz
					draw.pos = q * p
					draw.pos = out_ent.pos + out_ent.col_offset + draw.pos

					draw.cam_forward = &cam_forward
					draw.cam_pos = &cam_pos
					draw.cam_rot = &cam_rot
					draw.rot = out_ent.rot
					draw.flags = DRAW_INFO_TRANSPARENT
					*draw.color[0] = 1.0
					*draw.color[1] = 0.0
					*draw.color[2] = 0.0
					*draw.color[3] = 0.5

					if ch.type == col_type.MESH
					{
						t:u64
						verts := ch.MESH.info.verts
						tris := ch.MESH.info.tris
						color : _vec
						color.x = 1.0
						color.w = 1.0

						while t < ch.MESH.info.tris_count
						{
							t1 := cast(u64)*ptr_offset(tris, t, u32)
							t2 := cast(u64)*ptr_offset(tris, t + 1, u32)
							t3 := cast(u64)*ptr_offset(tris, t + 2, u32)
							_v1 := *ptr_offset(verts, t1, _vec)
							_v2 := *ptr_offset(verts, t2, _vec)
							_v3 := *ptr_offset(verts, t3, _vec)

							draw_tri(ctx, &_v3, &_v2, &_v1, &color, 0)
							t+= 3
						}
					}
					else
					{
						Draw3D(ctx.window, &draw)
					}

				}
				if prev_ent.type == ent_type.AUX_COL_ENT
				{
					out_ent = prev_ent
				}
				//printf("drawing\n")
			}
			
		}
		else
		{
			
			/*
			mouse_sense := 0.4
			cam_rot.x -= GetMouseVelY() * dt * mouse_sense
			max_rot_x := 75.0 * (3.14159 / 180.0)
			cam_rot.x = clamp(cam_rot.x, -max_rot_x, max_rot_x)
			cam_rot.y -= GetMouseVelX() * dt * mouse_sense
			cam_forward = euler_to_quaternion(0.0 , radians_to_degree(cam_rot.y), 0.0) * aux_forward
			*/
			
			player_mov(ctx, &-aux_forward, &dt)

			sky.pos = player_ent.pos

			player_ent.angle_rot = aux_forward

      dir = cam_pos - player_ent.pos
      end := player_ent.pos + dir

      out_pos:_vec

      cam_dist := 5.0
      if raycast_against_chunk_tris(ctx, &player_ent.pos, &end, &out_pos)
      {
        dir = out_pos - player_ent.pos
        cam_dist = len_vec(&dir)
        cam_dist = cam_dist * 0.9
      }
      cam_dist = clamp(cam_dist, 0.0, 5.0)
			gameplay_cam(ctx, dt, cam_dist)


			

/*
			double_pi := PI * 2.0
			if cam_rot.y > double_pi
			{
				diff := cam_rot.y - double_pi
				cam_rot.y = diff
			}
			if cam_rot.y < -double_pi
			{
				diff := cam_rot.y + double_pi
				cam_rot.y = diff
			}
			
			*/

			playble_ents_logic(ctx.cur_scn, &dt)
			to_deactivate_func(ctx.cur_scn, dt)
			UpdateEntsWithClips(ctx.cur_scn, dt)

      c1 := *player_ent.cols[0]
      p_aabb :aabb = ?
      p_aabb._min = c1._min
      p_aabb._max = c1._max

      found := 1.0
      dyn_clear(&in_scenes)

      for s in ctx.scenes
      {
        for a in s.areas_col
        {
          a_aabb :aabb=?
          a_aabb._min = a.area_col_pos - a.area_col_size * 0.5
          a_aabb._max = a.area_col_pos + a.area_col_size * 0.5

          if aabbCheck3D(&p_aabb, &a_aabb)
          {
            dyn_add(&in_scenes, s)
            break;
          }
        }
      }
      for s in in_scenes
      {
        DeleteEnt(ctx.cur_scn, player_ent, for_changing_scenes=true)

        dyn_add(&s.drawable_ents, player_ent)
        dyn_add(&s.ents, player_ent)
        dyn_add(&s.bodies, player_ent)
        dyn_add(&s.ents_with_clip, player_ent)

        ctx.cur_scn = *s
        //player_ent.flags = player_ent.flags & ~ENTITY_CHANGE_SCENES
        div := cast(f32)in_scenes.count
        dt = dt / div
        PhysicsUpdate(*s, dt)

      }

			update_sword_in_hand(player_ent, sword, hand_bone)


			i :u64
			while i < globals.create_events.count
			{
				ev := ptr_offset(globals.create_events.data, i, create_event_info)
				on ev.type
				{
				create_event_etruct.BRIDGE_ROTATE
				{
					bridge_ent :*entity= *ctx.cur_scn.ents[cast(u64)ev.BRIDGE_ROTATE.ent_id]
					rot_cur := &ev.BRIDGE_ROTATE.rotation_cur
					rot_amount := bridge_ent.vel.w

					if *rot_cur < rot_amount
					{
						*rot_cur += dt
					}
					else
					{
						dyn_rem(&globals.create_events, cast(u32)i)
					}
					bridge_ent.bridge_rot = -*rot_cur

					set_bridge_pos(bridge_ent)
				}
				create_event_etruct.CREATE_EMMITTER
				{
					ent := get_inactive_ent(ctx.cur_scn, &ctx.cur_scn.emmitters, INACTIVE_FLAGS_GET_FIRST_WHEN_NONE_FOUND)
					ent.pos = ev.CREATE_EMMITTER.pos
					ent.timer_deactivate = ev.CREATE_EMMITTER.timer_deactivate
					ent.emmitter.p = ev.CREATE_EMMITTER.p
					init_emmitter(ent)

					dyn_add(&ctx.cur_scn.to_deactivate, ent)

					dyn_rem(&globals.create_events, cast(u32)i)

					i--
				}
				}
				i++
			}
		}
		
		if IsKeyDown(key_enum.KEY_F3)
		{
			ctx.editor_wnd = !ctx.editor_wnd
		}
		if ctx.models_wnd
		{
			
			info:imgui_window=?
			info.
			{
				name = "models"
				items = cast(u32)ctx.models_count
				items_per_line = 4
				selected_ref = &ctx.selected_model
				window_bool = &ctx.models_wnd

				item_width = 50.0
				item_height = 32.0

				_out_ent = out_ent
				func = fn(ctx : *context, info : *imgui_window, id : u32){
					//printf("on here id {id}\n")
					a := globals.assets[cast(u64)id + ASSETS_MODELS_OFFSET]
					m := &a.MODEL.mod
					ImGuiText("{m.name}")
				}
				get_idx = fn(ctx : *context, info : *imgui_window) ! u32
				{
					return ctx.selected_model.asset_idx - ASSETS_MODELS_OFFSET
				}
				set_val = fn(ctx : *context, info : *imgui_window, id : u32)
				{
					ctx.selected_model.asset_idx = id + ASSETS_MODELS_OFFSET
				}
				func = fn(ctx : *context, info : *imgui_window, id : u32){
					//printf("on here id {id}\n")
					a := globals.assets[cast(u64)id + ASSETS_MODELS_OFFSET]
					m := &a.MODEL.mod
					ImGuiText("{m.name}")
				}
				apply = fn(ctx : *context, info : *imgui_window)
				{
					c := *info._out_ent.cols[0]
					new_mesh_info:=false
					model_verts_count:u32
					model_tris_count:u32

					m := get_model_ptr(&ctx.selected_model)

					c.MESH.info.model_idx = ctx.selected_model

					GetInfoFromModel(m.model, &model_verts_count, &model_tris_count)
					if c.type == col_type.MESH
					{
						if model_verts_count != c.MESH.info.verts_count || model_tris_count != c.MESH.info.tris_count
						{
							new_mesh_info = true
						}
					}
					else
					{
						new_mesh_info = true
					}
					c.type = col_type.MESH

					if new_mesh_info
					{
						minfo := &c.MESH.info
						create_mesh_collider(ctx.cur_scn, c, model_tris_count, model_verts_count)
					}
					printf("mesh changed\n")
					assign_mesh_to_chunks(ctx.cur_scn, info._out_ent)
				}
			}
			imgui_show_window_grid(ctx, out_ent, &info)
		}
		if ctx.materials_wnd
		{
			
			info:imgui_window=?
			info.
			{
				name = "materials"
				items = cast(u32)ctx.materials_count
				items_per_line = 4
				selected_ref = &ctx.selected_material
				window_bool = &ctx.materials_wnd

				item_width = 50.0
				item_height = 32.0

				_out_ent = out_ent
				func = fn(ctx : *context, info : *imgui_window, id : u32){
					//printf("on here id {id}\n")
					a := globals.assets[cast(u64)id + ASSETS_MATERIALS_OFFSET]
					m := &a.MATERIAL.mat
					ImGuiText("{m.name}")
				}
				get_idx = fn(ctx : *context, info : *imgui_window) ! u32
				{
					return ctx.selected_material.asset_idx - ASSETS_MATERIALS_OFFSET
				}
				set_val = fn(ctx : *context, info : *imgui_window, id : u32)
				{
					ctx.selected_material.asset_idx = id + ASSETS_MATERIALS_OFFSET
				}
				apply = fn(ctx : *context, info : *imgui_window)
				{
					info._out_ent.material_idx = ctx.selected_material
					info._out_ent.in_material_instance = new_material_instance(ctx.cur_scn, &ctx.selected_material, info._out_ent)
					info._out_ent.flags = info._out_ent.flags | ENTITY_CUSTOM_SHADER
					//printf("ent midx s {info._out_ent.material_idx}\n")
				}
			}
