perspective::fn(mat : *f32, fov : f32, aspect : f32, near : f32, far : f32) {
    tanHalfFov:= tanf(fov / 2.0);
	memset(mat, 0, 16)
    *ptr_offset(mat, 0, f32) = 1.0 / (aspect * tanHalfFov);
    *ptr_offset(mat, 5, f32) = 1.0 / tanHalfFov;
    *ptr_offset(mat, 10, f32) = -(far + near) / (far - near);
    *ptr_offset(mat, 11, f32) = -1.0;
    *ptr_offset(mat, 14, f32) = -(2.0 * far * near) / (far - near);
}
inverse_perspective::fn(inv_mat : *f32, fov : f32, aspect : f32, near : f32, far : f32) {
    tanHalfFov := tanf(fov / 2.0);
    memset(inv_mat, 0, 16);
    
    *ptr_offset(inv_mat, 0, f32) = aspect * tanHalfFov;
    *ptr_offset(inv_mat, 5, f32) = tanHalfFov;
    *ptr_offset(inv_mat, 11, f32) = (near - far) / (2.0 * far * near);
    *ptr_offset(inv_mat, 14, f32) = -1.0;
    *ptr_offset(inv_mat, 15, f32) = (far + near) / (2.0 * far * near);
}



