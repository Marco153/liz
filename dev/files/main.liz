	stamina_w := info.stamina * w
	stamina_temp_max_w := info.stamina_temp_max * w
	DrawSquare(ctx, -0.9, 0.9, w, 0.1, &_vec{0.0, 0.0, 0.0, 1.0})
	DrawSquare(ctx, -0.9, 0.9, stamina_temp_max_w, 0.1, &_vec{0.0, 0.3, 0.0, 1.0})

	col :=_vec{0.0, 1.0, 0.0, 1.0}
