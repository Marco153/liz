ChangeState::fn(e : *entity, state : entity_state)
{
	if e.state != state
	{
		e.cl = nil;
		e.state = state;
		e.clip_time = 0.0;
		e.clip_done = false;
	}
}

clamp ::fn{T}(v : T, _min :T, _max : T) ! T
{
	if v <= _min return _min;
	if v >= _max return _max;
	return v;
}

PrevInvItem::fn(inv : *inventory, cur : **inv_slot)
{
	start := inv.items[0];
	prev := ptr_offset(*cur, -1, inv_slot);
	if cast(u64)prev >= cast(u64)start && prev.item != inv_item.EMPTY
	{
		*cur = prev;
	}
}


DoFreezeTime::fn(ctx : *context, max : f32, smooth : bool, dt : *f32, cam_rot : *_vec)
{
	cam_rot.z = 0.0;
	if (ctx.enable_freeze_timer && ctx.freeze_timer == 0.0)
	{
		cam_rot.z = 0.01;
	}
	if smooth
	{
		if ctx.enable_freeze_timer && ctx.freeze_timer < max
		{
			ctx.freeze_timer += *dt;
			*dt = *dt * (ctx.freeze_timer / max);
			//dt = 0.0;
		}
		else
		{
			ctx.freeze_timer = 0.0;
			ctx.enable_freeze_timer = false;
		}
	}
	else
	{
		if ctx.enable_freeze_timer && ctx.freeze_timer < max
		{
			ctx.freeze_timer += *dt;
			*dt = 0.0;
			//dt = 0.0;
		}
		else
		{
			ctx.freeze_timer = 0.0;
			ctx.enable_freeze_timer = false;
		}
	}
}

anim_add_tex_kf::fn(tm : *timeline, at : f32, in_tex_id : u32)
{
	kf: keyframe;
	kf.{
		time = at;
		tex_id = in_tex_id;
	};
	dyn_add(&tm.kfs, &kf);
	aoeu: = 0;
}

anim_add_activate_kf::fn(tm : *timeline, at : f32, val_in : bool, act_type : activate_type)
{
	kf: keyframe;
	kf.{
		time = at;
		activate.type = act_type;
		activate.val = val_in;
	};
	dyn_add(&tm.kfs, &kf);

}
anim_add_mov_kf::fn(tm : *timeline, at : f32, x : f32, y : f32, z : f32)
{
	kf: keyframe;
	kf.{
		time = at;
		mov.pos.x = x;
		mov.pos.y = y;
		mov.pos.z = z;
	};
	dyn_add(&tm.kfs, &kf);
}

CreateNewClip::fn(ctx : *context)!*clip2
{
	ret:= cast(*clip2)heap_alloc(ctx.alloc, sizeof(clip2));
	ret.loop = true;
	ret.vel = 1.0;
	dyn_init2(&ret.tms, 4, ctx.alloc);

	ret.tms.count = 1;
	tm: = ret.tms[0];
	dyn_init2(&tm.kfs, 4, ctx.alloc);

	return ret;
}
CreateAnim::fn(ctx : *context, start_idx : u32, end_idx : u32, texs_idxs : *u32, count_texs : u32) ! *clip2
{
	ASSERT(end_idx < (start_idx + count_texs));

	clip1: = CreateNewClip(ctx);
	clip1.loop = true;
	//dyn_init2(&clip1.tms, 4, ctx.alloc);
	tm: *timeline= clip1.tms[0];
	tm.type = timeline_type.TEXTURE;


	//tex_ptr: = ctx.character_texs.tex_idxs;
	
	for i in start_idx..end_idx
	{
		idx: = i - start_idx;
		anim_add_tex_kf(tm, (cast(f32)idx) * 0.1, *ptr_offset(texs_idxs, cast(u64)i, u32));
	}
	clip1.len = cast(f32)(end_idx - start_idx) * 0.1;
	return clip1;
}



dialogue_enum:enum
{
	LEVEL_1_SIGN,
}
GetDialogueStr::fn(idx : dialogue_enum, lang : u8) ! str_lit
{
	if idx == dialogue_enum.LEVEL_1_SIGN
	{
		
		if lang == 1
		{
		}
		else
			return "only those sincere at heart can reach the castle";
	}
	else
		__dbg_break;
	return "TEXT NOT FOUND";
}

Cutscenes::fn coroutine(cor_ctx : *coroutine_ctx, ctx : *context, dt : *f32)
{
	if ctx.cutscene_idx == 1
	{
		ctx.player.mov_info.can_move = false;
		//ctx.
		//ct
		//ctx.player.can_move //=
		//CorWait(4.0);
		ChangePrinterStr(ctx, GetDialogueStr(dialogue_enum.LEVEL_1_SIGN, 0));
		CorMoveVecTo(ctx.cam_pos_global, -29.0, 5.0, 0.0, 2.0, ctx.cam_col_left);
		while true
		{
			if ctx.prntr.done && IsKeyDown(key_enum.KEY_JMP)
			{
				break;
			}
			return;
		}
		ClearPrinterStr(ctx);
		ctx.player.mov_info.can_move = true;
		ctx.cutscene_idx = 0;
		ResetCoroutine();
	}
}


to_deactivate_func::fn(ctx : *context, dt : f32)
{
	for i in 0..ctx.to_deactivate.count
	{
		e := *ctx.to_deactivate[cast(u64)i]
		e.timer_deactivate -= dt
		//printf("cur is {i}\n")
		if e.timer_deactivate <= 0.0
		{
			deactivate_ent(ctx, e)

			dyn_rem(&ctx.to_deactivate, cast(u32)i)
			i--
		}
	}
}

MakeEntMasked::fn(ctx : *context, ent : *entity, masked :  *masked_info)
{
	ent.flags = ent.flags | ENTITY_IS_MASKED;
	ent.stencil_val = masked.stencil_val;
	ent.stencil_func = stencil_func_enum.EQUAL;
	ent.masking_objs = &ctx.masking_objs;
}
FreeArrayOfEnts::fn(ar : *dyn_array(*entity))
{
	for e in *ar
	{
		if is_flag_on(e.flags, ENTITY_DONT_FREE | ENTITY_FREED)
			continue;
		e.flags = ENTITY_DONT_FREE;
		heap_free(ar.alloc, *e);
		
	}
}

min :: fn(a : s32, b : s32) ! s32
{
	if a < b return a;
	return b;
}
min :: fn(a : u32, b : u32) ! u32
{
	if a < b return a;
	return b;
}
min :: fn(a : f32, b : f32) ! f32
{
	if a < b return a;
	return b;
}

axe_throw_callback::fn(data : *anim_callback_info) !bool
{
	if data.time_since_stopped > 3.0
		return true;
	return false;
}

NewAxeEnt::fn(ctx : *context) ! *entity
{
	axe_ent := NewEnt(ctx, "axe");
	axe_ent.is_trigger = true;
	axe_ent.type = ent_type.AXE;
	add_body(ctx, axe_ent);
	axe_ent.flags = ENTITY_HAS_TEXTURE | ENTITY_DONT_FREE;
	axe_ent.layer = LAYER_TRIGGER
	axe_ent.tex_id = cast(u32)ctx.axe_tex;
	axe_ent.is_active = true;
	axe_ent.axe = cast(*axe_info)heap_alloc(ctx.alloc, sizeof(axe_info));
	axe_ent.pivot.x = 0.5;
	axe_ent.pivot.y = 0.5;
	axe_ent.pos.y = 5.0;
	return axe_ent;
}
NewPlayerEnt::fn(ctx : *context, name : str_lit) ! *entity
{
	player_ent:*entity;
	NewPlayableEnt(ctx, &player_ent, false);

	dyn_add(&player_ent.remove_from, ent_part_of.DRAWABLE)
	dyn_add(&player_ent.remove_from, ent_part_of.COLLIDER)
	
	player_ent.flags = player_ent.flags | ENTITY_DONT_FREE | ENTITY_SERIALIZE;
	//player_ent.mov_info.axe_ent = NewAxeEnt(ctx);
	
	
	player_ent.layer = LAYER_ENTITY_PLAYABLE | LAYER_PLAYER
	player_ent.dont_res_cols_with_layers = LAYER_ENTITY_PLAYABLE;

	player_ent.name = name;
	player_ent.pos.x = 4.0;
	player_ent.pos.y = 4.0;
	player_ent.size.x = 1.0;
	player_ent.size.y = 1.0;
	player_ent.col_size.x = 0.7;
	player_ent.col_size.y = 0.7;
	player_ent.pivot.x = 0.5;
	player_ent.pivot.y = 0.5;
	player_ent.color.x = 1.0;
	player_ent.color.y = 1.0;
	player_ent.color.z = 1.0;
	player_ent.color.w = 1.0;
	player_ent.col_enter = player_collision_enter;
	player_ent.col_stay = player_collision_stay;
	player_ent.col_exit = player_collision_exit;
	player_ent.is_active = true;

	player_ent_trigger: = player_ent.mov_info.trigger;
	pinfo: = player_ent.mov_info;
	pinfo.{
		speed = 0.01;
	};


	mov_info := player_ent.mov_info;
	
	player_ent.flags = player_ent.flags | ENTITY_HAS_TEXTURE;
	
	
	
	return player_ent;
}

