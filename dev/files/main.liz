INACTIVE_FLAGS_GET_FIRST_WHEN_NONE_FOUND:const s32= 1
get_inactive_ent::fn(ctx : *context, ar : *dyn_array(*entity), flags : u32) ! *entity
{
	for e in *ar
	{
		if !e.is_active
		{
			e.is_active = true
			return *e
		}
	}
	if is_flag_on(flags, INACTIVE_FLAGS_GET_FIRST_WHEN_NONE_FOUND)
	{
		e := *ar[0]
		RemoveEntFromAr(&ctx.to_deactivate, e)
		return e
	}
	else
	{
		ASSERT(0)
	}
	return nil
}
