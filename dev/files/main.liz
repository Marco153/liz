update_terrain_for_visualization::fn(ctx : *context, terrain : *terrain_info, assign_tex : bool)
{
	for vtx in ctx.vertex_terrain
	{
		verts := &vtx.mesh.verts
		idx := get_pixel_idx(cast(s32)vtx.x, cast(s32)vtx.y, &ctx.terrain_tex)
		force := vtx.dir
		out_pixel := ptr_offset(ctx.terrain_tex.data, idx, u8)

		cur_val := *cast(*u16)out_pixel
		cur_val = cast(u16)clamp(cast(s32)cur_val + cast(s32)(force * ctx.tedit.force), cast(s32)ctx.tedit.terrain_height_min, cast(s32)ctx.tedit.terrain_height_max)
		if !vtx.duplicated && assign_tex
		{
			*cast(*u16)out_pixel = cur_val
		}


		m := vtx.mesh
		vt := cast(*terrain_vert_info)m.verts[vtx.vidx]
		vt.pos.y = (cast(f32)cur_val/65000.0) * terrain.amplitude
		vt.col.x = 1.0
		vt.col.y = 1.0
		vt.col.z = 1.0
		vt.col.w = force * 0.5

	}

	UpdateTexture(ctx.terrain_tex.id, 0, 0, ctx.terrain_tex.width, ctx.terrain_tex.height, 
					ctx.terrain_tex.data, ctx.terrain_tex.channels - 1, ctx.terrain_tex.channel_size)

	for mi in ctx.mesh_added_aux
	{
		m := terrain.meshes[cast(u64)*mi]
		vi :u64
		verts := &m.verts
		count := m.verts.count
		//__dbg_break
		UpdateModel(m.model, m.verts.data)
	}
	for vtx in ctx.vertex_terrain
	{
		verts := &vtx.mesh.verts
		m := vtx.mesh
		vt := cast(*terrain_vert_info)m.verts[vtx.vidx]
		vt.col.w = 0.0

	}

}
radial_item:struct
{
	name : str_lit
	idx : u32
}
draw_radial_menu::fn(ctx : *context, x : f32, y : f32, out : *u32, total : u32, items : *radial_item)
{
	start :_vec
	start.x = x
	start.y = y
	mx := GetMouseNormalizedPosX();
	my := GetMouseNormalizedPosY();
	mouse :_vec
	mouse.x = mx
	mouse.y = -my
	dir_to_mouse := mouse - start
	dir_to_mouse = normalize_vec(&dir_to_mouse)

	//__dbg_break
	max_items := 8.0

	part := 1.0/max_items

	part_as_angle := part * PI * 2.0
	mouse_angle := atan2(dir_to_mouse.x, dir_to_mouse.y)
	
	for i in 0..total
	{
		p := cast(f32)i/max_items
		cur := ptr_offset(items, i, radial_item)

		fx := x + cos(p * PI * 2.0) * 0.5
		fy := y + sin(p * PI * 2.0) * 0.5
		//__dbg_break

		dir_to_item :_vec
		dir_to_item.x = fx
		dir_to_item.y = fy
		dir_to_item = normalize_vec(&dir_to_item)

		item_angle := atan2(dir_to_item.x, dir_to_item.y)
		item_angle += part_as_angle * 0.5
		item_angle_min := item_angle - part_as_angle

		if (mouse_angle < item_angle) && (mouse_angle > item_angle_min)
		{
			*out = cur.idx
		}

		col := ctx.white_color
		if *out == cast(u32)cur.idx
		{
			col = ctx.red_color
		}


		DrawText(ctx, cur.name, fx, fy, &col, sz= 0.7)
	}
}
get_cam_final_pos::fn(ctx : *context, dt : f32) ! _vec
{
}
gameplay_cam::fn(ctx : *context, dt : f32, cam_dist : f32)
{
	cam_forward := ctx.cam_forward_global
	cam_rot_val := &ctx.cam_rot_val
	mouse_sense := 0.4

	vely := GetMouseVelY() * dt * mouse_sense
	velx := GetMouseVelX() * dt * mouse_sense

	cam_rot_val.x -= velx
	cam_rot_val.y += vely
	
	cam_rot_val.y = clamp(cam_rot_val.y, -1.4, 1.4)
	z :_vec
	z.z = -1.0

	aux := euler_to_quaternion(0.0 , radians_to_degree(cam_rot_val.x), 0.0) * z
	h := aux
	*ctx.cam_aux_forward_global = h

	right := cross_vec(&h, &globals.up)
	q := create_from_axis_angle(right.x, right.y, right.z, cam_rot_val.y)
	aux = q * aux

	*cam_forward = aux

	p_pos := globals.player.pos

	dir := *cam_forward * cam_dist
	final_pos := p_pos + dir

	cam_pos := ctx.cam_pos_global
	*cam_pos = final_pos


	angy := angle_on_axis(&z, cam_forward, &globals.up)
	angx := angle_on_axis(&h, cam_forward, &right)


	ctx.cam_rot_global.x = -angx
	ctx.cam_rot_global.y = angy + PI
	//test := create_from_axis_angle(1.0, 0.0, 0.0, dir.x).v
	//*ctx.cam_rot_global = test

	//printf("angx {angx}, angy {angy}\n")
	//print_vec(cam_forward)
}
create_clip_asset::fn(name : str_lit, start : f32, end : f32, vel : f32= 1.0) ! asset_index
{
	aux_idx := find_empty_asset(ASSETS_CLIPS_OFFSET)
	clip_aux := globals.assets[aux_idx]
	clip_aux.type = asset_type.CLIP
	memcpy(clip_aux.cid.name[0], name, str_ln(name))
	clip_aux.CLIP.cl.start = start
	clip_aux.CLIP.cl.end = end
	clip_aux.CLIP.cl.vel = vel

	ret :asset_index
	ret.asset_idx = cast(u32)aux_idx
	return ret
	
}
ANIM_TICKS_PER_SEC:const f32= 24.0
create_mesh_collider::fn(ctx : *scene_info, c : *collider, model_tris_count : u32, model_verts_count : u32)
{
	minfo : *verts_and_tris= &c.MESH.info

	minfo.verts = cast(*_vec)heap_alloc(ctx.alloc, model_verts_count * 16)
	minfo.verts_count = model_verts_count

	minfo.tris = cast(*u32)heap_alloc(ctx.alloc, sizeof(u32)*model_tris_count)
	minfo.tris_count = model_tris_count
	c.data_ready = false


	model_idx := get_id_of_model(&c.MESH.info.model_idx)

	CopyDataFromModel(model_idx, minfo.verts, minfo.verts_count, minfo.tris, minfo.tris_count, &minfo.verts_count, &minfo.tris_count)

/*
  tri :u64=0
  while tri < model_tris_count
  {

    info :verts_from_tri_info
    info.t = tri
    get_verts_pos_from_tris(&info, cast(*u32)minfo.tris, cast(*f32)minfo.tris, 4)

    tri_info :triangle_info=?
    memcpy(&tri_info._v1, &info, 4 * sizeof(_vec))
    dyn_add(&minfo.tris_info, &tri_info)
    tri += 3
  }
  */

	aux1 : _vec
	aux2 : _vec
	CopyVerts(c, &aux1, &aux2)
}
