	u : u32,
	#serializable(val)
}

main:: fn(){

	ctx: context
	AssignCtxAddr(&ctx);
	InitMemAlloc(&ctx.main_alloc, 16000);
	InitMemAlloc(&ctx.per_scene_alloc, 16000);
	ctx.alloc = &ctx.main_alloc;
	ctx.coroutines.alloc = ctx.alloc;
	window := OpenWindow(1024, 768);
	ctx.window = window;

	globals.alloc = &ctx.per_scene_alloc;

	// Cube vertices
	*globals.cube_verts[0] = _vec{-0.5, -0.5, -0.5, 0.0}
	*globals.cube_verts[1] = _vec{0.5, -0.5, -0.5, 0.0}
	*globals.cube_verts[2] = _vec{0.5,  0.5, -0.5, 0.0}
	*globals.cube_verts[3] = _vec{-0.5,  0.5, -0.5, 0.0}
	*globals.cube_verts[4] = _vec{-0.5, -0.5,  0.5, 0.0}
	*globals.cube_verts[5] = _vec{0.5, -0.5,  0.5, 0.0}
	*globals.cube_verts[6] = _vec{0.5,  0.5,  0.5, 0.0}
	*globals.cube_verts[7] = _vec{-0.5,  0.5,  0.5, 0.0};

	

	SetIsEngine(false);
	ctx.timers.timers_count = 128;
	ctx.timers.timers = cast(*timer_info)heap_alloc(ctx.alloc, ctx.timers.timers_count * sizeof(timer_info));

	ctx.to_draw.alloc = ctx.alloc;
	dyn_init(&ctx.to_draw, 4);

	ctx.bodies.alloc = ctx.alloc;
	dyn_init(&ctx.bodies, 4);

	ctx.broad_phase_ents.alloc = ctx.alloc;
	dyn_init(&ctx.broad_phase_ents, 4);

	ctx.narrow_phase_ents.alloc = ctx.alloc;
	dyn_init(&ctx.narrow_phase_ents, 4);

	ctx.hit_ents_in_col.alloc = ctx.alloc;
	dyn_init(&ctx.hit_ents_in_col, 4);

	dyn_init2(&ctx.playable_ents, 4, ctx.alloc);
	dyn_init2(&ctx.floaty_platforms, 4, ctx.alloc);
	dyn_init2(&ctx.drawable_ents, 4, ctx.alloc);
	dyn_init2(&ctx.axe_ents, 4, ctx.alloc);
	dyn_init2(&ctx.ents_with_clip, 4, ctx.alloc);

	//scn.items.alloc = ctx.alloc;
	/*
	test_ar: dyn_array(s32);
	test_ar.alloc = ctx.alloc;
	dyn_init(&test_ar, 4);

	val: = 5;
	dyn_add(&test_ar, &val);
	val = -5;
	dyn_add(&test_ar, &val);

	file_out: dyn_array(u8);
	file_out.alloc = ctx.alloc;
	dyn_init(&file_out, 4);
	*/


	ctx.gjk = cast(*gjk_state)heap_alloc(ctx.alloc, sizeof(gjk_state))
	memset(ctx.gjk, 0, sizeof(gjk_state))

	ctx.prntr.chars_per_line = 24;


	AssignTexFolder("../images");
	textures:dyn_array(texture_info);
	LoadTexFolder("../images", &ctx.textures);
	//AssignSoundFolder("../sound");
	LoadClip("abcd.png", 0, 0, 32, 32, 30, 1.0, &ctx.alphabet);
	LoadClip("character2.png", 0, 0, 64, 64, 60, 1.0, &ctx.character_texs);
	LoadClip("thraxer.png", 0, 0, 64, 64, 19, 1.0, &ctx.thraxer_texs);
	LoadClip("wolf.png", 0, 0, 64, 64, 12, 1.0, &ctx.wolf_texs);
	LoadClip("inv_items.png", 0, 0, 32, 32, 3, 1.0, &ctx.inv_texs);
	LoadClip("spear.png", 0, 0, 64, 64, 5, 1.0, &ctx.spear_texs);
	LoadClip("water.png", 0, 0, 32, 32, 3, 1.0, &ctx.water_texs);
	ctx.axe_throw_texs = 39;
	ctx.spear_throw_texs = 46;
	ctx.prntr.texs = ctx.alphabet.tex_idxs;
	//ctx.prntr.str = "this is a dialogue that fills the box";
	//ctx.prntr.str_ln = str_ln(cast(str_lit)ctx.prntr.str);
