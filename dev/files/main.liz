						t := a.TEXTURE_ARRAY.texs[0]
						ImGuiImage(t.id, 64.0, 64.0)
					}
					else
					{
						a = globals.assets[cast(u64)globals.white_tex.asset_idx]
						t := a.TEXTURE_ARRAY.texs[0]
						ImGuiImage(t.id, 64.0, 64.0)
					}
				}
				get_idx = fn(ctx : *context, info : *imgui_window) ! u32
				{
					return ctx.selected_tex.asset_idx - ASSETS_TEXTURES_OFFSET
				}
