	start_selected_pos :_vec

	axis_sel_ent : *entity

	select_up : _vec
	select_right : _vec
	
	sel_action : select_action

	//AllEnt(ctx, "01")
	//__dbg_break

  stage : loading_stage

  cor :*coroutine_func_saved

  fl_sz:s64
  file_data := cast(str_lit)read_entire_file("../scenes/02", &fl_sz)
  
  while stage != loading_stage.DONE
  {
    OpenScene(&ctx.coroutines, ctx.cur_scn, &stage, file_data, fl_sz, &cor)
  }

  cor.regs.rip = 0

  file_data = cast(str_lit)read_entire_file("../scenes/04", &fl_sz)
  other_scn := get_not_used_scene(ctx, "04")
  
  stage = loading_stage.NONE
  while stage != loading_stage.DONE
  {
    OpenScene(&ctx.coroutines, other_scn, &stage, file_data, fl_sz, &cor)
  }
  stage = loading_stage.NONE

	
	ctx.grid_ent = NewEnt(ctx.cur_scn, "grid_ent")
	ctx.grid_ent.flags = ctx.grid_ent.flags | ENTITY_3D | ENTITY_TRANSPARENT | ENTITY_DONT_FREE
	ctx.grid_ent.flags = ctx.grid_ent.flags & ~ENTITY_HAS_TEXTURE
	ctx.grid_ent.is_active = true
	ctx.grid_ent.model.asset_idx = ASSETS_MODELS_OFFSET + 1
	ctx.grid_ent.forward = _vec{0.0, 1.0, 0.0}
	ctx.grid_ent.material_idx = find_shader(ctx.cur_scn, "grid2.mat")
	ctx.grid_ent.in_material_instance = new_material_instance(ctx.cur_scn, &ctx.grid_ent.material_idx, ctx.grid_ent)
	set_shader_uniform_sampler2d(ctx.cur_scn, ctx.grid_ent, "tex", &globals.grid_transparent_tex)
	ctx.grid_ent.size.x = 10.0
	ctx.grid_ent.size.y = 10.0
	ctx.grid_ent.rot = euler_to_quaternion(90.0, 0.0, 0.0).v
	ctx.grid_ent.layer = LAYER_IGNORE_RAYCAST
	ctx.grid_ent.is_active = false
	dyn_add(&ctx.cur_scn.drawable_ents, &ctx.grid_ent);

	sky := new_cube(ctx.cur_scn, &_vec{5.0, 70.5, 5.0}, &_vec{500.5, 500.2, 500.5, 0.0}, false);
	sky.name = "sky"
	sky.is_trigger = true
	sky.flags = sky.flags | ENTITY_CUSTOM_SHADER | ENTITY_DONT_FREE
	sky.flags = sky.flags & ~ENTITY_SERIALIZE
	sky.material_idx = find_shader(ctx.cur_scn, "sky.mat")
	sky.in_material_instance = new_material_instance(ctx.cur_scn, &sky.material_idx, sky)




	mat := get_material_ptr(&sky.material_idx)
	//rgb(232, 255, 215)
	//rgb(235, 214, 251)
	//rgb(255, 203, 97)
	set_uniform_v4(mat, sky, "horizon_color", &_vec{233.0/255.0, 91.0/255.0, 111.0/255.0, 1.0})
	set_uniform_v4(mat, sky, "mid_horizon_color", &_vec{255.0/255.0, 203.0/255.0, 97.0/255.0, 1.0})
	set_uniform_v4(mat, sky, "sky_color", &_vec{235.0/255.0, 214.0/255.0, 251.0/255.0, 1.0})


	//dyn_add(&test_e.remove_from, ent_part_of.LOOK_AT_PLAYER)

	out_verts_count:u32
	out_indices_count:u32
	drw_set.sun_color = _vec{1.0, 0.6, 0.3, 1.0}
	drw_set.sun_dir = normalize_vec(&_vec{0.5, 0.2, 0.5, 0.0})
	
	//CopyDataFromModel(2, ctx.aux_vertices, globals.aux_vertices_sz, ctx.aux_indices, ctx.aux_indices_sz, &out_verts_count, &out_indices_count)

	globals.aux_col_ent = new_cube(ctx.cur_scn, &ctx.white_color, &ctx.white_color, false)
  
	globals.aux_col_ent.flags = globals.aux_col_ent.flags | ENTITY_3D | ENTITY_TRANSPARENT | ENTITY_DONT_FREE
	globals.aux_col_ent.flags = globals.aux_col_ent.flags & ~ENTITY_SERIALIZE
	globals.aux_col_ent.type = ent_type.AUX_COL_ENT
	globals.aux_col_ent.is_active = false



	//PlayAudio("01.flac", 1.0, 1.0);
	StepCol(ctx.cur_scn, 0.0)
	assign_bodies_to_chunks(ctx.cur_scn)
	
    /*
	for c in ctx.col_chunks.col_chunks
