}
update_sword_in_hand::fn(player_ent : *entity, sword : *entity, hand_bone : *bone_animation)
{
	dir := hand_bone.final_pos
	q:quaternion=?
	q.v = player_ent.rot
	final_rot := q
	q = final_rot
	q2 :quaternion=?
	q2.v = hand_bone.final_rot

	//pivot := cube.size

	dir = q * dir
	dir = dir * player_ent.size

	sword.pos = dir + player_ent.pos
	sword.rot = (q * q2).v

	q.v = sword.rot
	pivot :_vec
	pivot.x = -sword.size.x*0.5
	pivot =  q * pivot
	sword.pos += pivot
}
get_not_used_scene::fn(ctx : *context, name : str_lit) ! *scene_info
{
  for s in ctx.scenes
  {
    if s.in_use == false
    {
      prev_idx := s.alloc_idx
      prev_alloc := s.alloc
      memset(s, 0, sizeof(*s))

      s.alloc = prev_alloc
      s.alloc_idx = prev_idx

      s.in_use = true
      s.name = name
      InitMemAlloc(s.alloc, 458600)
      s.color = ctx.white_color
      return s
    }
  }
  assert(false)
  return nil
}
coroutine_test::fn coroutine(cor_ctx : *coroutine_ctx, a : *u32)
{
  *a = 1
  return
  *a = 2
  return
}
test_fun::fn(ctx :*scene_info)
{
  scn2 :=ptr_offset(ctx, 1, scene_info)
  OpenLocalsWindow(__LINE__)
}
