raycast_get_pos::fn(ctx : *context, col : *collision) !bool
{
	screenmx := GetMouseScreenPosX();
	screenmy := GetMouseScreenPosY();
	cam_pos := *ctx.cam_pos_global
	dir := ScreenMouseToWorld(screenmx, screenmy)
	
	//dir.y = -dir.y
	cam_dir := cam_pos + dir * 20.0
	cam_dir2 := cam_pos + dir * 5.0

	cam_dir = cam_pos + dir * 2000.0

	aux_sel : *entity
	shortest_dist : f32 = 9999.0

	found := false
	aux_col :collision=?
	if RaycastWithNonBodies(ctx, &cam_pos, &cam_dir, col, 0, &aux_sel)
	{
		shortest_dist = len_vec(&(cam_pos - col.contact_point))
		found = true
	}
	if Raycast(ctx, &cam_pos, &cam_dir, &aux_col, 0, &aux_sel)
	{
		aux_dist := len_vec(&(cam_pos - col.contact_point))

		if aux_dist < shortest_dist 
		{
			*col = aux_col
		}
		found = true
	}
	/*
	if RaycastWithTerrain(ctx, &cam_pos, &cam_dir_terrain, trn_ent, &col)
	{
		aux_dist := len_vec(&(cam_pos - col.contact_point))

		if aux_dist < shortest_dist 
		{
			*col = aux_col
		}
		found = true
	}
	*/
	return found
}
get_rel_size_from_min_and_max_pos_in_col_chunk::fn(ctx : *context, _min : *_vec, _max : *_vec, out_min : *_vec, out_max : *_vec)
{
	start_chunk_pos := ctx.area_col_pos - (ctx.area_col_size * 0.5)


	chunk_width := ctx.chunk_width

	x_width := (ctx.area_col_size.x / chunk_width)
	y_width := (ctx.area_col_size.y / chunk_width)
	z_width := (ctx.area_col_size.z / chunk_width)


	*out_min = (*_min - start_chunk_pos) / ctx.chunk_width
	out_min.x = clamp(out_min.x, 0.0, x_width)
	out_min.y = clamp(out_min.y, 0.0, y_width)
	out_min.z = clamp(out_min.z, 0.0, z_width)

	*out_max = (*_max - start_chunk_pos) / ctx.chunk_width
	out_max.x = clamp(out_max.x, 0.0, x_width)
	out_max.y = clamp(out_max.y, 0.0, y_width)
	out_max.z = clamp(out_max.z, 0.0, z_width)

}
get_chunks_close_to_ent::fn(ctx : *context, e : *entity, out : *dyn_array(*collision_chunk), min_rel_pos : *_vec, max_rel_pos : *_vec)
{
	c1 := cast(*collider)e.col

	chunk_width := ctx.chunk_width
	x_width := (ctx.area_col_size.x / chunk_width) + 1.0
	y_width := (ctx.area_col_size.y / chunk_width) + 1.0
	z_width := (ctx.area_col_size.z / chunk_width) + 1.0

	pos_stride := *max_rel_pos - *min_rel_pos 

	x_start := cast(s32)min_rel_pos.x
	y_start := cast(s32)min_rel_pos.y
	z_start := cast(s32)min_rel_pos.z

	x_end := cast(s32)max_rel_pos.x + 1
	y_end := cast(s32)max_rel_pos.y + 1
	z_end := cast(s32)max_rel_pos.z + 1


	for y in y_start..y_end
	{
		for z in z_start..z_end
		{
			for x in x_start..x_end
			{
				/*
				if x == 2 && y == 0 && z == 6
				{
					__dbg_break
				}
				*/
				idx :=cast(u64)(x + (z * cast(s32)x_width) + (y * cast(s32)(z_width * x_width)))
				cur := ctx.col_chunks[idx]

				dyn_add(out, cur)
				a := 0
			}
		}
	}
}
assign_bodies_to_chunks::fn(ctx : *context)
{
	for e_ in ctx.bodies
	{
		e := *e_
		c1 := cast(*collider)e.col
		if !e.is_active continue;

		if !e.is_static
		{
			c1.rel_chunk_max.x = -1.0
		}
		else
		{
			min_rel_pos : _vec=?
			max_rel_pos : _vec=?

/*
			if str_cmp(e.name, "block 1_idx63")
			{
				__dbg_break
			}
			*/
			CopyVerts(c1, &min_rel_pos, &max_rel_pos)
			dyn_clear(&ctx.aux_col_chunks)
			

			get_rel_size_from_min_and_max_pos_in_col_chunk(ctx, &c1._min, &c1._max, &min_rel_pos, &max_rel_pos)
			get_chunks_close_to_ent(ctx, e, &ctx.aux_col_chunks, &min_rel_pos, &max_rel_pos)

			for c in ctx.aux_col_chunks
			{
				dyn_add(&c.entities, e)
				a:=0
			}
		}

	}
}
copy_region_to_buffer::fn(ctx : *context, dst : *void, x_offset : u32, y_offset : u32, src_width : u32, src_height : u32, dst_width: u32, dst_height: u32, data : *u8)
{
	dst_offset :u64= x_offset * 4 + y_offset * dst_width * 4;
	src_offset :u64= 0;
	sz: = cast(u64)src_width * 4;
	//printf("xoffset %, yoffset %, src_offset %\n", x_offset, y_offset, src_offset);
	for h in 0..src_height
	{
		memcpy(ptr_offset(dst, dst_offset, u8), ptr_offset(data, src_offset, u8), sz);
		src_offset += src_width * 4;
		dst_offset += dst_width * 4;
	}
}
unpack_color::fn(col : u8) ! u32
{
	ret : u32

	brightness := cast(u32)(col >> 6)
	brightness_final :u32
	//brightness = brightness
	r := cast(u32)(col & 3)
	g := cast(u32)((col >> 2) & 3)
	b := cast(u32)((col >> 4) & 3)

	if brightness == 0
	{
		r = 0
		g = 0
		b = 0
	}
	else
	{
		brightness_final = (3 * 255) / brightness

		if r != 0
			r = (3 * 255) / r;

		if g != 0
			g = (3 * 255) / g;

		if b != 0
			b = (3 * 255) / b;

		brightness = 3 - brightness
		r_part := r / 4;
		g_part := g / 4;
		b_part := b / 4;

		r = r - (brightness * r_part)
		g = g - (brightness * g_part)
		b = b - (brightness * b_part)
	}
	ret = cast(u32)r | ((cast(u32)g) << 8)
	ret = ret | ((cast(u32)b) << 16)
	ret = ret | ((cast(u32)brightness_final) << 24)
	return ret
}
update_screen_texture::fn(ctx : *context, m : *machine)
{
	buffer : [8 * 8]u32
	letter_width := 6
	letter_height := 8
	//memset(ctx.computer_screen_tex_buffer, 0, 256 * 256 * 4)

	t : *texture_info=ctx.textures[cast(u64)ctx.abcd_tex_info_idx]
	id := ctx.screen_tex_id

	for i in 0..4
	{
		info := *cast(*u32)ctx.mach.data[4000 + cast(u64)i * 4]
		letter := cast(u32)cast(u16)info
		letter_col := cast(u8)(info >> 16)
		background_col := cast(u8)(info >> 24)
		letter_idx := letter - cast(u32)'a

		unpacked_letter_color := unpack_color(letter_col)
		unpacked_background_color := unpack_color(background_col)

		memset32(buffer[0], unpacked_background_color, 8 * 8)

		letter_src := ptr_offset(t.data, letter_idx * cast(u32)letter_width * 4, u8)
		for y in 0..letter_height
		{
			for x in 0..letter_width
			{
				cur_src_col := ptr_offset(letter_src, x * 4 + y * cast(s64)t.width * 4, u8)
				cur_dst_col := ptr_offset(buffer[0], x * 4 + y * 8 * 4, u8)
				cur_src_col32 := *cast(*u32)cur_src_col
				if cur_src_col32 != 0
				{
					ASSERT(cast(u64)cur_dst_col < 56000)
					*cast(*u32)cur_dst_col = unpacked_letter_color
				}
			}
		}

		copy_region_to_buffer(ctx, ctx.computer_screen_tex_buffer, cast(u32)i * 8 , 0, 8, 8, 256, 256, cast(*u8)buffer[0])
	}
	UpdateTexture(id, 0, 0, 256, 256, ctx.computer_screen_tex_buffer, 3, gen_texture_size.BYTE)
	//__dbg_break

}
update_terrain_for_visualization::fn(ctx : *context, terrain : *terrain_info, assign_tex : bool)
{
	for vtx in ctx.vertex_terrain
	{
		verts := &vtx.mesh.verts
		idx := get_pixel_idx(cast(s32)vtx.x, cast(s32)vtx.y, &ctx.terrain_tex)
		force := vtx.dir
		out_pixel := ptr_offset(ctx.terrain_tex.data, idx, u8)

		cur_val := *cast(*u16)out_pixel
		cur_val = cast(u16)clamp(cast(s32)cur_val + cast(s32)(force * ctx.tedit.force), cast(s32)ctx.tedit.terrain_height_min, cast(s32)ctx.tedit.terrain_height_max)
		if !vtx.duplicated && assign_tex
		{
			*cast(*u16)out_pixel = cur_val
		}


		m := vtx.mesh
		vt := cast(*terrain_vert_info)m.verts[vtx.vidx]
		vt.pos.y = (cast(f32)cur_val/65000.0) * terrain.amplitude
		vt.col.x = 1.0
		vt.col.y = 1.0
		vt.col.z = 1.0
		vt.col.w = force * 0.5

	}

	UpdateTexture(ctx.terrain_tex.id, 0, 0, ctx.terrain_tex.width, ctx.terrain_tex.height, 
					ctx.terrain_tex.data, ctx.terrain_tex.channels - 1, ctx.terrain_tex.channel_size)

	for mi in ctx.mesh_added_aux
	{
		m := terrain.meshes[cast(u64)*mi]
		vi :u64
		verts := &m.verts
		count := m.verts.count
		//__dbg_break
		UpdateModel(m.model, m.verts.data)
	}
	for vtx in ctx.vertex_terrain
	{
		verts := &vtx.mesh.verts
		m := vtx.mesh
		vt := cast(*terrain_vert_info)m.verts[vtx.vidx]
		vt.col.w = 0.0

	}

}
radial_item:struct
{
	name : str_lit
	idx : u32
}
draw_radial_menu::fn(ctx : *context, x : f32, y : f32, out : *u32, total : u32, items : *radial_item)
{
	start :_vec
	start.x = x
	start.y = y
	mx := GetMouseNormalizedPosX();
	my := GetMouseNormalizedPosY();
	mouse :_vec
	mouse.x = mx
	mouse.y = -my
	dir_to_mouse := mouse - start
	dir_to_mouse = normalize_vec(&dir_to_mouse)

	//__dbg_break
	max_items := 8.0

	part := 1.0/max_items

	part_as_angle := part * PI * 2.0
	mouse_angle := atan2(dir_to_mouse.x, dir_to_mouse.y)
	
	for i in 0..total
	{
		p := cast(f32)i/max_items
		cur := ptr_offset(items, i, radial_item)

		fx := x + cos(p * PI * 2.0) * 0.5
		fy := y + sin(p * PI * 2.0) * 0.5
		//__dbg_break

		dir_to_item :_vec
		dir_to_item.x = fx
		dir_to_item.y = fy
		dir_to_item = normalize_vec(&dir_to_item)

		item_angle := atan2(dir_to_item.x, dir_to_item.y)
		item_angle += part_as_angle * 0.5
		item_angle_min := item_angle - part_as_angle

		if (mouse_angle < item_angle) && (mouse_angle > item_angle_min)
		{
			*out = cur.idx
		}

		col := ctx.white_color
		if *out == cast(u32)cur.idx
		{
			col = ctx.red_color
		}


		DrawText(ctx, cur.name, fx, fy, &col, sz= 0.7)
	}
}
