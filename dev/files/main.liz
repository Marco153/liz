	cube.name = "cube2"
	cube.rot = euler_to_quaternion(10.0, 45.0, 0.0).v


	ctx.preview_ent = new_cube(ctx, &_vec{5.0, 70.5, 5.0}, &_vec{1.0, 1.0, 1.0, 0.0}, false);
	ctx.preview_ent.flags = ctx.preview_ent.flags | ENTITY_DONT_FREE
	ctx.preview_ent.flags = ctx.preview_ent.flags & ~(ENTITY_SERIALIZE | ENTITY_HAS_TEXTURE)
	ctx.preview_ent.is_active = false
	ctx.preview_ent.name = "preview_ent"
	ctx.preview_ent.type = ent_type.PREVIEW_ENT

	ctx.preview_ent.color = _vec{1.0, 1.0, 1.0, 1.0}

	remove_body(ctx, ctx.preview_ent)


	HideCursor(hidden_cur)
	out_ent : *entity= nil
	prev_select_ent_col : _vec


	x_axis_ent := new_axis_ent(ctx, "x_axis", &_vec{1.0, 0.2, 0.2}, &_vec{1.0, 0.0, 0.0, 1.0})
	y_axis_ent := new_axis_ent(ctx, "y_axis", &_vec{0.2, 1.0, 0.2}, &_vec{0.0, 1.0, 0.0, 1.0})
	z_axis_ent := new_axis_ent(ctx, "z_axis", &_vec{0.2, 0.2, 1.0}, &_vec{0.0, 0.0, 1.0, 1.0})

	ctx.y_axis_ent = y_axis_ent

	all_axis_ent := new_axis_ent(ctx, "all_axis", &_vec{0.5, 0.5, 0.5}, &_vec{1.0, 1.0, 1.0, 0.5})
	//all_axis_ent.type = ent_type.AXIS_ALL

	ctx.all_axis_ent = all_axis_ent
	globals.all_axis_ent = all_axis_ent
	globals.all_axis_col = cast(*collider)all_axis_ent.col

	x_axis_ent.forward.x = 1.0

	y_axis_ent.forward.y = 1.0

	z_axis_ent.forward.z = 1.0

	all_axis_ent.forward.z = 1.0
	all_axis_ent.forward.y = 1.0
	all_axis_ent.forward.x = 1.0
	ctx.all_axis_col = cast(*collider)all_axis_ent.col

	start_selected_pos :_vec

	axis_sel_ent : *entity

	select_up : _vec
	select_right : _vec
	
	sel_action : select_action

	SerializeAllEnt(ctx, "01")
	DeserializeAllEnt(ctx, "01")

	sky := new_cube(ctx, &_vec{5.0, 70.5, 5.0}, &_vec{500.5, 500.2, 500.5, 0.0}, false);
	sky.name = "sky"
	sky.is_trigger = true
	sky.flags = sky.flags | ENTITY_CUSTOM_SHADER | ENTITY_DONT_FREE
	sky.flags = sky.flags & ~ENTITY_SERIALIZE
	sky.material_idx = find_shader(ctx, "sky_shader.mat")
	sky.in_material_instance = new_material_instance(ctx, cast(u32)sky.material_idx, sky)




	mat :=ctx.materials[cast(u64)sky.material_idx]
	//rgb(232, 255, 215)
	//rgb(235, 214, 251)
	//rgb(255, 203, 97)
	set_uniform_v4(mat, sky, "horizon_color", &_vec{233.0/255.0, 91.0/255.0, 111.0/255.0, 1.0})
	set_uniform_v4(mat, sky, "mid_horizon_color", &_vec{255.0/255.0, 203.0/255.0, 97.0/255.0, 1.0})
	set_uniform_v4(mat, sky, "sky_color", &_vec{235.0/255.0, 214.0/255.0, 251.0/255.0, 1.0})


	ctx.red_color.x = 1.0
	ctx.red_color.y = 0.0
	ctx.red_color.z = 0.0
	ctx.red_color.w = 1.0

	ctx.white_color.x = 1.0
	ctx.white_color.y = 1.0
	ctx.white_color.z = 1.0
	ctx.white_color.w = 1.0
	//dyn_add(&test_e.remove_from, ent_part_of.LOOK_AT_PLAYER)

	out_verts_count:u32
	out_indices_count:u32
	ctx.sun_color = _vec{1.0, 0.6, 0.3, 1.0}
	ctx.sun_dir = normalize_vec(&_vec{0.5, 0.2, 0.5, 0.0})
	
	//CopyDataFromModel(2, ctx.aux_vertices, ctx.aux_vertices_sz, ctx.aux_indices, ctx.aux_indices_sz, &out_verts_count, &out_indices_count)

	ctx.aux_col_ent = NewEnt(ctx, "aux_col_ent")
	ctx.aux_col_ent.flags = ctx.aux_col_ent.flags | ENTITY_3D | ENTITY_TRANSPARENT | ENTITY_DONT_FREE
	ctx.aux_col_ent.type = ent_type.AUX_COL_ENT

	ctx.grid_ent = NewEnt(ctx, "grid_ent")
	ctx.grid_ent.flags = ctx.grid_ent.flags | ENTITY_3D | ENTITY_TRANSPARENT | ENTITY_DONT_FREE
	ctx.grid_ent.is_active = true
	ctx.grid_ent.model = 1
	ctx.grid_ent.forward = _vec{0.0, 1.0, 0.0}
	ctx.grid_ent.material_idx = find_shader(ctx, "grid2_shader.mat")
	ctx.grid_ent.in_material_instance = new_material_instance(ctx, cast(u32)ctx.grid_ent.material_idx, ctx.grid_ent)
	set_shader_uniform_sampler2d(ctx, ctx.grid_ent, "tex", ctx.textures[ctx.grid_transparent_tex])
	ctx.grid_ent.size.x = 10.0
	ctx.grid_ent.size.y = 10.0
	ctx.grid_ent.rot = euler_to_quaternion(90.0, 0.0, 0.0).v
	ctx.grid_ent.layer = LAYER_IGNORE_RAYCAST
	dyn_add(&ctx.drawable_ents, &ctx.grid_ent);


	//PlayAudio("01.flac", 1.0, 1.0);
	StepCol(ctx, 0.0)
	assign_bodies_to_chunks(ctx)
	
	for c in ctx.col_chunks
	{
		dyn_add(&c.entities, trn_ent)

	}

	ctx.screen_tex_id = GenRawTexture(256, 256, gen_texture_type.RGBA, gen_texture_filter.NEAREST, gen_texture_size.BYTE)

	trn_ent.flags = trn_ent.flags | ENTITY_CUSTOM_SHADER
	trn_ent.material_idx = find_shader(ctx, "terrain_shader.mat")
	trn_ent.in_material_instance = new_material_instance(ctx, cast(u32)trn_ent.material_idx, trn_ent)
	set_shader_uniform_sampler2d(ctx, trn_ent, "tex", ctx.textures[ctx.grid_transparent_tex])
	set_shader_uniform_sampler2d(ctx, trn_ent, "tex2", ctx.textures[ctx.grass_tex])
	set_shader_uniform_sampler2d(ctx, trn_ent, "tex3", ctx.textures[ctx.water_tex])
	set_shader_uniform_sampler2d(ctx, trn_ent, "heightmap", &ctx.terrain_tex)
	set_shader_uniform2f(ctx, trn_ent, "terrain_size", cast(f32)ctx.terrain_tex.width, cast(f32)ctx.terrain_tex.height)
	set_shader_uniform1f(ctx, trn_ent, "amplitude", cast(f32)terrain.amplitude)

	cam_dir_terrain :_vec

	while !ShouldClose(ctx.window)
	{
/*

		rsp := get_reg(&ctx.mach, RSP_REG)
		*rsp = 1024
		rbp := get_reg(&ctx.mach, RBP_REG)
		*rbp = 1024
		*cast(*u64)ctx.mach.data[*rsp] = 0
		*cast(*bool)ctx.mach.data[2000] = IsKeyHeld(key_enum.KEY_P)

		//val_t := *cast(*u32)ctx.mach.data[4000]

		//printf("val is {val_t}\n")

		bc_logic(&ctx.mach, &ctx.mach.bcs, 0)

		for i2 in 0..4
		{
			val := *cast(*u32)ptr_offset(ctx.mach.data.data, 4000 + i2 * 4, u8)
			printf("i{i2} is {val}, ")

		}
		printf("\n")
		*/

		if ctx.grid_ent.col != nil
		{
			__dbg_break
		}

		dt_aux: = GetTime() - last_time;
		dt: = 0.017;

		//printf("dt {dt_aux}\n")

		ctx.i_clicked = IsKeyDown(key_enum.KEY_I)
		globals.timer = 0.0;

		screenmx := GetMouseScreenPosX();
		screenmy := GetMouseScreenPosY();
		
		curmx := GetMouseScreenPosX();
		curmy := GetMouseScreenPosY();
		dir := ScreenMouseToWorld(screenmx, screenmy)
		
		//dir.y = -dir.y
		cam_dir := cam_pos + dir * 20.0
		cam_dir2 := cam_pos + dir * 5.0

		cam_dir = cam_pos + dir * 2000.0

		ctx.dt = dt
		last_time = GetTime();
		ctx.time_since_start += dt


		ClearBackground(0.2, 0.5, 0.8);

		f := 0.5
		player_ent.color.x = 1.0
		player_ent.color.y = 0.0
		player_ent.color.z = 0.0

		ang: f32=?
		cross := cross_vec(&ctx.up, &cam_forward)

		//cam_mov(ctx)



		change_select_ent_col :bool

		if IsKeyDown(key_enum.KEY_F1)
		{
			ctx.can_deactivate_path_ents = true
			ctx.editor_cam = !ctx.editor_cam 
			change_select_ent_col = true

			if !ctx.editor_cam
			{
				x_axis_ent.is_active = false
				y_axis_ent.is_active = false
				z_axis_ent.is_active = false
				all_axis_ent.is_active = false
				
				change_preview_col_idx(ctx, 0)

				ctx.textures_wnd = false

			}
			else
			{

			}
		}
		if ctx.editor_cam
		{
			//draw_vertex(ctx, &player_ent.pos, &_vec{1.0, 1.0, 1.0, 1.0}, &cam_pos, &cam_rot)
			//printf("model {ctx.grid_ent.model}\n")
			if IsKeyHeld(key_enum.KEY_LCTRL) && IsKeyDown(key_enum.KEY_S)
			{
				SerializeAllEnt(ctx, "02")
			}

			if !ImGuiHasFocus()
			{
				mvx := GetMouseVelX() * dt
				mvy := GetMouseVelY() * dt
				cam_mov_editor(ctx, mvx, mvy)
				if IsKeyDown(key_enum.KEY_P)
				{
					player_ent.pos = cam_pos
				}
				if IsKeyDown(key_enum.KEY_1)
				{
					sel_action = select_action.MOV
					all_axis_ent.is_active = false
				}
				if IsKeyDown(key_enum.KEY_2)
				{
					if sel_action == select_action.SCALE_ONE_AXIS
					{
						sel_action = select_action.SCALE_ONE_AXIS2
					}
					else if sel_action == select_action.SCALE_ONE_AXIS2
					{
						sel_action = select_action.SCALE_ONE_AXIS
					}
					else
					{
						sel_action = select_action.SCALE_ONE_AXIS
					}
					all_axis_ent.is_active = true

				}
				if IsKeyDown(key_enum.KEY_3)
				{
					sel_action = select_action.SCALE
					all_axis_ent.is_active = true
				}
				if IsKeyDown(key_enum.KEY_4)
				{
					change_preview_col_idx(ctx, ctx.cur_preview_idx + 1)
				}
				if IsKeyDown(key_enum.KEY_5)
				{
					sel_action = select_action.ROT
					all_axis_ent.is_active = false
				}

				if axis_sel_ent
				{
					fw := axis_sel_ent.forward 

					dx := dot_vec(&fw, &select_right) * mvx
					pos_ptr := &out_ent.pos
					size_ptr := &out_ent.size

					if ctx.cur_preview_idx > 0 && out_ent.type != ent_type.AUX_COL_ENT
					{
						if is_flag_on(out_ent.flags, ENTITY_ONLY_COL) && ctx.cur_preview_idx == 2
						{
							pos_ptr = &out_ent.pos
							size_ptr = &out_ent.col_size
						}
						else
						{
							pos_ptr = &out_ent.col_offset
							size_ptr = &out_ent.col_size
						}

					}

					dist := len_vec(&(cam_pos - out_ent.pos))
					mul := 2.0 + dist
					on sel_action
					{
					select_action.MOV
					{
						//printf("static {out_ent.is_static}, col {cast(u64)out_ent.col}, sel_mode {cast(u32)sel_action}, {ctx.frames_total}\n")
						dy := dot_vec(&fw, &select_up) * -mvy
						*pos_ptr += fw * (dx + dy) * 8.0
						on out_ent.type
						{
						ent_type.BRIDGE
						{
							out_ent.vel = *pos_ptr
						}
						ent_type.ITEM
						{
							out_ent.pos.w = pos_ptr.y
						}
						}
					}
					select_action.SCALE_ONE_AXIS
					{
						dx = -dx
						dy := dot_vec(&fw, &select_up) * mvy
						fw = fw * 0.5

						*pos_ptr -= fw * (dx + dy) * mul
						*size_ptr -= fw * (dx + dy) * mul * 2.0


						if ctx.cur_preview_idx == 0
						{
							//out_ent.col_offset -= fw * (dx + dy) * mul
							out_ent.col_size -= fw * (dx + dy) * mul * 2.0
						}

					}
					select_action.ROT
					{
						dx = -dx
						dy := dot_vec(&fw, &select_up) * mvy
						fw = fw * RAD_TO_DEG * (dx + dy)
						q : quaternion=?
						q.v = out_ent.rot
						out_ent.rot = (q * euler_to_quaternion(fw.x, fw.y, fw.z)).v
						if out_ent.type == ent_type.BRIDGE
						{
							out_ent.forward = out_ent.rot
						}
					}
					select_action.SCALE
					{
						dy := dot_vec(&fw, &select_up) * -mvy

						*size_ptr += fw * (dx + dy) * mul * 2.0
						if ctx.cur_preview_idx == 0
						{
							out_ent.col_size += fw * (dx + dy) * mul * 2.0
						}

					}
					select_action.SCALE_ONE_AXIS2
					{
						dy := dot_vec(&fw, &select_up) * -mvy
						fw = fw * 0.5

						*pos_ptr += fw * (dx + dy) * mul
						*size_ptr -= fw * (dx + dy) * mul * 2.0
						if ctx.cur_preview_idx == 0
						{
							out_ent.col_size -= fw * (dx + dy) * mul * 2.0
						}

					}
					}
					if out_ent.type == ent_type.AUX_COL_ENT
					{
						c1 := cast(*collider)out_ent.col

						print_vec(&out_ent.pos)
						c1.pos = out_ent.pos - out_ent.parent_col.pos
						c1.size = out_ent.size
					}
				}

				if out_ent.is_static && out_ent.col
				{
					c1 := cast(*collider)out_ent.col
					c1.data_ready = false
				}
				if IsKeyDown(key_enum.KEY_DEL) && out_ent != nil
				{
					DeleteEnt(ctx, out_ent)
					out_ent = nil
					x_axis_ent.is_active = true
					y_axis_ent.is_active = true
					z_axis_ent.is_active = true
					all_axis_ent.is_active = true
				}
				if out_ent
				{
					if out_ent.type == ent_type.AXIS
					{
					}
					else
					{
						s := clamp(sin(GetTime() * 4.0), 0.0, 1.0)
						yellow :_vec
						yellow.x = 0.5
						yellow.y = 0.5
						yellow.z = 0.5
						yellow.w = prev_select_ent_col.w

						diff := yellow - prev_select_ent_col

						aux := prev_select_ent_col + (diff * s)

						out_ent.color.x = aux.x
						out_ent.color.y = aux.y
						out_ent.color.z = aux.z

						x_axis_ent.pos = out_ent.pos

						y_axis_ent.pos = out_ent.pos
						
						z_axis_ent.pos = out_ent.pos
						
						all_axis_ent.pos = out_ent.pos

						offset := 1.0
						if sel_action == select_action.SCALE_ONE_AXIS2
						{
							x_axis_ent.pos.x -= offset
							y_axis_ent.pos.y -= offset
							z_axis_ent.pos.z -= offset
						}
						else
						{
							x_axis_ent.pos.x += offset
							y_axis_ent.pos.y += offset
							z_axis_ent.pos.z += offset
						}
					}
				}

				if IsKeyDown(key_enum.KEY_I)
				{
					dyn_clear(&ctx.vertex_terrain)
					prev_sel := out_ent
					aux_sel : *entity
					aux_sel_from_non_bodies : *entity
					shortest_dist : f32 = 9999.0
				
					point : _vec

					if RaycastWithNonBodies(ctx, &cam_pos, &cam_dir, &col, 0, &aux_sel_from_non_bodies)
					{
						printf("hit {aux_sel_from_non_bodies.name}\n")
						shortest_dist = len_vec(&(cam_pos - col.contact_point))
						point = col.contact_point
					}
					if Raycast(ctx, &cam_pos, &cam_dir, &col, 0, &aux_sel)
					{
						aux_dist := len_vec(&(cam_pos - col.contact_point))

						if aux_dist < shortest_dist 
						{
							point = col.contact_point
						}
					}
					if RaycastWithTerrain(ctx, &cam_pos, &cam_dir, trn_ent, &col)
					{
						aux_dist := len_vec(&(cam_pos - col.contact_point))

						if aux_dist < shortest_dist 
						{
							point = col.contact_point
						}
					}

					n:=ctx.grid_ent.forward
					if ctx.on_custom_grid
					{
						denom := dot_vec(&n, &dir)
						t := dot_vec(&n, &(cam_pos - ctx.grid_ent.pos)) / denom
						point = cam_pos - dir * t
					}
					if ctx.cur_preview_idx == 1 && aux_sel != nil
					{
						printf("creting a new collider\n")
						new_col := new_ptr(collider)
						memset(new_col, 0, sizeof(collider))
						new_col.type = col_type.CUBE
						new_col.ent = aux_sel
						new_col.size.x = 1.0
						new_col.size.y = 1.0
						new_col.size.z = 1.0
						c1 := cast(*collider)aux_sel.col
						dyn_add(&c1.children, new_col)
					}
					else
					{
						cube = new_cube(ctx, &point, &_vec{1.0, 1.0, 1.0}, true);

						new_rot := quaternion_to_euler(&ctx.grid_ent.rot)
						cube.rot = euler_to_quaternion(0.0, radians_to_degree(new_rot.y), 0.0).v


						if ctx.cur_model_selected_idx != -1
						{
							m :*model_info= ctx.models[cast(u64)ctx.cur_model_selected_idx]
							cube.name = new_str_lit(ctx.alloc, m.name)
							cube.pos = ctx.preview_ent.pos
							cube.model = m.model
							cube.pos = ctx.preview_ent.pos
							cube.flags = cube.flags & ~(ENTITY_HAS_TEXTURE)
						}
						else
						{
							cube.tex_id = ctx.screen_tex_id
						}
						if ctx.on_contructing_path
						{
							//cube.flags = cube.flags | ENTITY_ALWAYS_ON_FRONT
							cube.pos += -col.normal
							printf("on path \n")
							if ctx.path_ents.count == 0
							{
								cube.size = cube.size * 2.0
							}
							dyn_add(&ctx.path_ents, cube)
							c1 := cast(*collider)cube.col
							CopyVerts(c1, &dir, &dir)
						}
					}
				}
				if IsMouseUp(mouse_enum.LEFT)
				{
					axis_sel_ent = nil
				}

				if IsMouseDown(mouse_enum.LEFT) && ctx.editor_wnd_type != editor_window_enum.GRID && 
				 	!IsKeyHeld(key_enum.KEY_LCTRL)
				{
					dyn_clear(&ctx.vertex_terrain)
					prev_sel := out_ent
					aux_sel : *entity
					aux_sel_from_non_bodies : *entity
					shortest_dist : f32 = 9999.0
				
					if RaycastWithNonBodies(ctx, &cam_pos, &cam_dir, &col, 0, &aux_sel_from_non_bodies)
					{
						//printf("hit {aux_sel_from_non_bodies.name}\n")
						shortest_dist = len_vec(&(cam_pos - col.contact_point))
					}
					if Raycast(ctx, &cam_pos, &cam_dir, &col, 0, &aux_sel)
					{
						aux_dist := len_vec(&(cam_pos - col.contact_point))
						if aux_dist < shortest_dist || aux_sel.type == ent_type.AXIS
						{
							
							shortest_dist = aux_dist
							aux_sel_from_non_bodies = nil
							x_axis_ent.is_active = true
							y_axis_ent.is_active = true
							z_axis_ent.is_active = true

							select_right = cross_vec(&dir, &ctx.up)
							select_up = cross_vec(&select_right, &dir)

							if aux_sel.type != ent_type.AXIS
							{

								out_ent = aux_sel
								if prev_sel != nil
								{
									if  prev_sel != out_ent
										change_select_ent_col = true;
								}
								else
								{
									memcpy(&prev_select_ent_col, &out_ent.color, 16)
									start_selected_pos = out_ent.pos
								}
							}
							else
							{
								axis_sel_ent = aux_sel
							}
						}
					}
					else if RaycastWithTerrain(ctx, &cam_pos, &cam_dir_terrain, trn_ent, &col)
					{
						aux_dist := len_vec(&(cam_pos - col.contact_point))
						if aux_dist < shortest_dist
						{
							out_ent = trn_ent
						}
					}
					else if aux_sel_from_non_bodies == nil
					{
						if out_ent != nil && out_ent.type != ent_type.TERRAIN
						{
							memcpy(&out_ent.color, &prev_select_ent_col, 16)
							out_ent = nil
						}

						x_axis_ent.is_active = false
						y_axis_ent.is_active = false
						z_axis_ent.is_active = false
						all_axis_ent.is_active = false
					}
					if aux_sel_from_non_bodies != nil && aux_sel == nil
					{
						out_ent = aux_sel_from_non_bodies
					}
					printf("out ent is {out_ent.name}\n")
				}

				//printf("path {ctx.on_contructing_path}, customgrid {ctx.on_custom_grid}, out {cast(u64)out_ent}, tp {cast(u32)out_ent.type}\n")
				if IsKeyHeld(key_enum.KEY_ALT)
				{
					if IsKeyHeld(key_enum.KEY_X)
					{
						DrawText(ctx, "{ctx.tedit.force}", -0.2, 0.0, &ctx.white_color, 0.7)
					}
					else if IsKeyHeld(key_enum.KEY_C)
					{
						draw_radial_menu(ctx, 0.0, 0.0, cast(*u32)&ctx.tedit.brush, brush_items_radial.len, brush_items_radial[0])
						if ctx.tedit.brush == terrain_brush_type.PATH
						{
							for e in ctx.path_ents
							{
								e.is_active = true
							}
							ctx.on_contructing_path = true
						}
						else
						{
							ctx.on_contructing_path = false
							ctx.can_deactivate_path_ents = true
						}
					}
					if IsMouseHeld(mouse_enum.LEFT)
					{
						if IsKeyHeld(key_enum.KEY_Z)
						{
							ctx.tedit.brush_size += mvx * 10.0
							if ctx.tedit.brush_size < 1.1
							{
								ctx.tedit.brush_size = 1.1
							}
						}
						if IsKeyHeld(key_enum.KEY_X)
						{
							ctx.tedit.force += mvx * 10.0
						}
					}
					dyn_clear(&ctx.vertex_terrain)
					if RaycastWithTerrain(ctx, &cam_pos, &cam_dir_terrain, trn_ent, &col)
					{
						out_ent = trn_ent
					}
					update_terrain_for_visualization(ctx, terrain, false)

					if IsKeyHeld(key_enum.KEY_V)
					{
						idx := get_pixel_idx(cast(s32)col.contact_point.x, cast(s32)col.contact_point.z, &ctx.terrain_tex)
						dst := ptr_offset(ctx.terrain_tex.data, idx, u8)
						ctx.tedit.terrain_height_max = cast(f32)cast(s32)*ptr_offset(dst, 0, u16)
						//draw_radial_menu(ctx, 0.0, 0.0, cast(*u32)&ctx.tedit.brush, brush_items_radial.len, brush_items_radial[0])
					}
				}
				else if !ctx.on_contructing_path && !ctx.on_custom_grid &&  axis_sel_ent == nil && (out_ent == nil || out_ent.type == ent_type.TERRAIN)
				{
					cam_dir_terrain = cam_dir
					//printf("will try {ctx.frames_total}\n")
					if IsMouseHeld(mouse_enum.LEFT)
					{
						dyn_clear(&ctx.vertex_terrain)
						if RaycastWithTerrain(ctx, &cam_pos, &cam_dir, trn_ent, &col)
						{
							out_ent = trn_ent
						}
						update_terrain_for_visualization(ctx, terrain, true)
					}
					if IsMouseUp(mouse_enum.LEFT)
					{
						calculate_normals(terrain)
						for vtx in ctx.vertex_terrain
						{
							verts := &vtx.mesh.verts
							m := vtx.mesh
							vt := cast(*terrain_vert_info)m.verts[vtx.vidx]
							vt.col.w = 0.0

						}
						for mi in ctx.mesh_added_aux
						{
							m := terrain.meshes[cast(u64)*mi]
							vi :u64
							verts := &m.verts
							count := m.verts.count
							//__dbg_break
							UpdateModel(m.model, m.verts.data)
						}
					}
				}
				else if ctx.on_contructing_path
				{
					i :u64
					limit := ctx.path_ents.count
					next :*entity
					//dir : _vec
					//cross :_vec
					path_width_start:_vec
					path_width_end:_vec
					pwidth_half := ctx.tedit.path_width * 0.5
					prev_dir:_vec
					prev_cross:_vec

					while i < limit
					{
						if limit == 1
							break;
						cur := ctx.path_ents[i]


						if i == 0 
						{
							
							next = *ctx.path_ents[i + 1]
							dir = next.pos - cur.pos
							cross = cross_vec(&ctx.up, &dir)
							cross = normalize_vec(&cross)
							cross = cross * pwidth_half

							prev_cross = cross
							prev_dir = dir

							path_width_start = cur.pos - cross
							path_width_end = cur.pos + cross

							draw_line(ctx, &path_width_start, &path_width_end, &ctx.white_color, 0)
							draw_line(ctx, &cur.pos, &next.pos, &ctx.white_color, 0)
						}
						else if (i + 1) == limit
						{
							cross = cross_vec(&prev_dir, &ctx.up)
							cross = normalize_vec(&cross)
							cross = cross * pwidth_half

							path_width_start = cur.pos - cross
							path_width_end = cur.pos + cross

							draw_line(ctx, &path_width_start, &path_width_end, &ctx.white_color, 0)

						}
						else
						{
							next = *ctx.path_ents[i + 1]

							dir = next.pos - cur.pos
							d := dot_vec(&normalize_vec(&dir), &normalize_vec(&prev_dir))

							cross = cross_vec(&dir, &ctx.up)

							half_dir := lerp(&-dir, &prev_dir, 0.5)

							cross = lerp(&half_dir, &cross, d)

							cross = normalize_vec(&cross)
							cross = cross * pwidth_half

							prev_cross = cross
							prev_dir = dir

							path_width_start = cur.pos - cross
							path_width_end = cur.pos + cross

							draw_line(ctx, &cur.pos, &next.pos, &ctx.white_color, 0)
							draw_line(ctx, &path_width_start, &path_width_end, &ctx.white_color, 0)
						}
						cross.y = 0.0
						cur.vel = cross
						i++
					}
				}
			}
			if ctx.ent_collider_modify && out_ent != nil
			{
				draw.model = 0
				draw.pos = out_ent.pos + out_ent.col_offset
				if out_ent.type == ent_type.AUX_COL_ENT
				{
					draw.ent_size = out_ent.size * 1.001
				}
				else
				{
					draw.ent_size = out_ent.col_size * 1.001
				}
				draw.cam_forward = &cam_forward
				draw.cam_pos = &cam_pos
				draw.cam_rot = &cam_rot
				draw.rot = out_ent.rot
				draw.flags = DRAW_INFO_TRANSPARENT
				*draw.color[0] = 1.0
				*draw.color[1] = 0.0
				*draw.color[2] = 0.0
				*draw.color[3] = 0.5
				Draw3D(ctx.window, &draw)

				c1 := cast(*collider)out_ent.col
				//printf("total children {c1.children.count}\n")
				for ch in c1.children
				{
					draw.pos = out_ent.pos + out_ent.col_offset + ch.pos
					draw.ent_size = ch.size
					Draw3D(ctx.window, &draw)
				}
				//printf("drawing\n")
			}
			
		}
		else
		{
			
			mouse_sense := 0.4
			cam_rot.x -= GetMouseVelY() * dt * mouse_sense
			max_rot_x := 75.0 * (3.14159 / 180.0)
			cam_rot.x = clamp(cam_rot.x, -max_rot_x, max_rot_x)
			cam_rot.y -= GetMouseVelX() * dt * mouse_sense
			cam_forward = euler_to_quaternion(0.0 , radians_to_degree(cam_rot.y), 0.0) * aux_forward
			
			player_ent.forward = cam_forward

			player_mov(ctx, &aux_forward, &dt)

			cam_pos = player_ent.pos
			sky.pos = player_ent.pos
			



			double_pi := PI * 2.0
			if cam_rot.y > double_pi
			{
				diff := cam_rot.y - double_pi
				cam_rot.y = diff
			}
			if cam_rot.y < -double_pi
			{
				diff := cam_rot.y + double_pi
				cam_rot.y = diff
			}
			

			playble_ents_logic(ctx, &dt)
			to_deactivate_func(ctx, dt)
			UpdateEntsWithClips(ctx, dt)
			PhysicsUpdate(ctx, dt)

			i :u64
			while i < globals.create_events.count
			{
				ev := ptr_offset(globals.create_events.data, i, create_event_info)
				on ev.type
				{
				create_event_etruct.BRIDGE_ROTATE
				{
					bridge_ent :*entity= *ctx.ents[cast(u64)ev.BRIDGE_ROTATE.ent_id]
					rot_cur := &ev.BRIDGE_ROTATE.rotation_cur
					rot_amount := bridge_ent.vel.w

					if *rot_cur < rot_amount
					{
						*rot_cur += dt
					}
					else
					{
						dyn_rem(&globals.create_events, cast(u32)i)
					}
					bridge_ent.bridge_rot = -*rot_cur

					set_bridge_pos(bridge_ent)
				}
				create_event_etruct.CREATE_EMMITTER
				{
					ent := get_inactive_ent(ctx, &ctx.emmitters, INACTIVE_FLAGS_GET_FIRST_WHEN_NONE_FOUND)
					ent.pos = ev.CREATE_EMMITTER.pos
					ent.timer_deactivate = ev.CREATE_EMMITTER.timer_deactivate
					ent.emmitter.p = ev.CREATE_EMMITTER.p
					init_emmitter(ent)

					dyn_add(&ctx.to_deactivate, ent)

					dyn_rem(&globals.create_events, cast(u32)i)

					i--
				}
				}
				i++
			}
		}
		
		if IsKeyDown(key_enum.KEY_F3)
		{
			ctx.editor_wnd = !ctx.editor_wnd
		}
		if ctx.materials_wnd
		{
			
			info:imgui_window=?
			info.
			{
				name = "materials"
				items = cast(u32)ctx.materials.count
				items_per_line = 4
				selected_ref = &ctx.selected_material
				window_bool = &ctx.materials_wnd

				item_width = 50.0
				item_height = 32.0

				_out_ent = out_ent
				func = fn(ctx : *context, info : *imgui_window, id : u32){
					//printf("on here id {id}\n")
					m := ctx.materials[cast(u64)id]
					ImGuiText("{m.name}")
				}
				apply = fn(ctx : *context, info : *imgui_window)
				{
					info._out_ent.material_idx = cast(s32)ctx.selected_material
					info._out_ent.in_material_instance = new_material_instance(ctx, ctx.selected_material, info._out_ent)
					info._out_ent.flags = info._out_ent.flags | ENTITY_CUSTOM_SHADER
					//printf("ent midx s {info._out_ent.material_idx}\n")
				}
			}
			imgui_show_window_grid(ctx, out_ent, &info)
		}
		if ctx.textures_wnd
		{
			info:imgui_window=?
			info.
			{
				name = "textures"
				items = cast(u32)ctx.textures.count
				items_per_line = 4
				selected_ref = &ctx.selected_tex
				window_bool = &ctx.textures_wnd
				item_width = 64.0
				item_height = 64.0
				_out_ent = out_ent
				ptr = ctx.selected_tex_ref
				func = fn(ctx : *context, info : *imgui_window, id : u32)
				{
					t := ctx.textures[cast(u64)id]
					ImGuiImage(t.id, 64.0, 64.0)
				}
				apply = fn(ctx : *context, info : *imgui_window)
				{
					*cast(*u32)info.ptr = ctx.selected_tex
					info._out_ent.flags = info._out_ent.flags | ENTITY_HAS_TEXTURE
				}
			}

			imgui_show_window_grid(ctx, out_ent, &info)
		}
		if ctx.editor_wnd
		{
			prev_ent := out_ent
			if out_ent.type == ent_type.AUX_COL_ENT
			{
				out_ent = out_ent.parent_col
			}
			editor_window(ctx, &out_ent)

			if prev_ent.type == ent_type.AUX_COL_ENT
			{
				out_ent = prev_ent
			}

		}
		
		if change_select_ent_col && out_ent != nil
		{
		}
		if IsKeyDown(key_enum.KEY_F2)
		{
			hidden_cur = !hidden_cur
			HideCursor(hidden_cur)
		}
		print_mov(player_ent)
		//OpenLocalsWindow(__LINE__)

		//__dbg_break
		//WaitThread(render_thread_id)
		//ResumeThread(render_thread_id)

		//update_screen_texture(ctx, &ctx.mach)
		emmitters_func(ctx, dt)
		DrawEnts(ctx, ctx.cam_pos_global, ctx.cam_rot_global)
		LookAtPlayerEnts(ctx, ctx.cam_pos_global, ctx.cam_rot_global)
		items_func(ctx, dt, out_ent)

		if !ctx.editor_cam
		{
			s:= 0.003
			// aim
			DrawSquare(ctx, -s, -s, s, s, &_vec{1.0, 1.0, 1.0, 1.0})
			draw_ui_gameplay(ctx, ctx.player.mov_info)
		}
		globals.temp_alloc.cur = 0
		/*
		{
		trn :*terrain_info=trn_ent.terrain
		t :u64=0
		idx :u64=0
		if IsKeyHeld(key_enum.KEY_1)
		{
			idx = 1
		}
		if IsKeyHeld(key_enum.KEY_2)
		{
			idx = 6
		}
		mesh := trn.meshes[idx]
		tris := &trn.tris
		//trn_ent.is_active = false
		
		tcol :=_vec{1.0, 1.0, 1.0, 1.0}
		while t < tris.count
		{
			t1 := cast(u64)*tris[t]
			t2 := cast(u64)*tris[t + 1]
			t3 := cast(u64)*tris[t + 2]

			_v1_start := mesh.verts[t1 * TERRAIN_VERTEX_SIZE]
			_v2_start := mesh.verts[t2 * TERRAIN_VERTEX_SIZE]
			_v3_start := mesh.verts[t3 * TERRAIN_VERTEX_SIZE]

			_v1 :_vec=?
			_v1.w = 0.0

			_v2 :_vec=?
			_v2.w = 0.0

			_v3 :_vec=?
			_v3.w = 0.0
			
			memcpy(&_v1, _v1_start, 3 * 4)
			memcpy(&_v2, _v2_start, 3 * 4)
			memcpy(&_v3, _v3_start, 3 * 4)

			//__dbg_break
			_v1 += trn_ent.pos + mesh.pos
			_v2 += trn_ent.pos + mesh.pos
			_v3 += trn_ent.pos + mesh.pos

			draw_tri(ctx, &_v3, &_v2, &_v1, &tcol, 0)
			/*
			print_vec(&_v1)
			print_vec(&_v2)
			print_vec(&_v3)
			printf("\n")
			globals.temp_alloc.cur = 0
			__dbg_break
			*/
			

			t += 3
		}
		}
		*/

		mx = GetMouseScreenPosX() - curmx;
		my = GetMouseScreenPosY() - curmy;
		mx = mx / 500.0
		my = my / 500.0
		EndFrame(ctx.window);
		ctx.frames_total++;

		if ctx.can_deactivate_path_ents
		{
			for e in ctx.path_ents
			{
				e.is_active = false
			}
			ctx.can_deactivate_path_ents = false
		}
	}
}

load_tex::fn(ctx : *context, name:str_lit, x_offset : u32, y_offset:u32, sp_width:u32, sp_height:u32) ! u32
{
	found := find_tex(ctx, name, x_offset, y_offset, sp_width, sp_height)
	if found != -1
	{
		return cast(u32)found
	}
	tex : texture_info
	tex.id = LoadTex(name, x_offset, y_offset, sp_width, sp_height)
	tex.x_offset = x_offset
	tex.y_offset = y_offset
	tex.width = sp_width
	tex.height = sp_height
	tex.idx_on_array = cast(u32)(ctx.textures.count - 1)
	dyn_add(&ctx.textures, &tex)

	return tex.idx_on_array
}
find_tex::fn(ctx : *context, name:str_lit, x_offset : u32, y_offset:u32, w:u32, h:u32) ! s32
{
	idx :u32
	for t in ctx.textures
	{
		if str_cmp(t.name, name) && t.width == w && t.height == h && t.x_offset == x_offset && t.y_offset == y_offset
		{
			return cast(s32)idx
		}
		idx++
	}
	return -1
}
TERRAIN_TRIS_SIZE :const s32=(MESH_WIDTH ) * (MESH_WIDTH) * 6 * 4
TERRAIN_MESHES_SIZE :const s32= sizeof(mesh_info) * (TERRAIN_WIDTH * TERRAIN_WIDTH + 1)
TERRAIN_CHUNKS_COL_SIZE :const s32= sizeof(mesh_info) * TERRAIN_WIDTH * TERRAIN_WIDTH

UpdateEntsWithClips::fn(ctx : *context, dt : f32)
{
	if ctx.ents_with_clip.count == 0
		return;
	for e in ctx.ents_with_clip
	{
		if e.cl == nil || !e.is_active
			continue;
		//__dbg_break;
		UpdateClip2(*e, dt);
		
	}
}


main:: fn(){
	q := euler_to_quaternion(-8.103, 0.0, 8.103)
	q_aux2 :_vec
	euler_to_quaternion2(-8.103, 0.0, 8.103, &q_aux2)
	ctx: context
	ctx.tedit.force = 16.0
	ctx.tedit.brush_size = 16.0
	ctx.tedit.path_width = 10.0
	ctx.tedit.terrain_height_max = 65000.0
	AssignCtxAddr(&ctx);
	InitMemAlloc(&ctx.terrain_alloc, 10);
	InitMemAlloc(&ctx.main_alloc, 258600);
	InitMemAlloc(&ctx.compiling_shaders_alloc, 16000);
	InitMemAlloc(&ctx.per_scene_alloc, 16000);
	ctx.alloc = &ctx.main_alloc;
	ctx.coroutines.alloc = ctx.alloc;
	window := OpenWindow(1000, 1000);
	ctx.chunk_width = 16.0

	LinearInit(&globals.temp_alloc, ctx.alloc, 1024)

	//__dbg_break
	bytes_per_mesh := MESH_WIDTH * MESH_WIDTH * TERRAIN_VERTEX_SIZE * 4
	total_chunks := TERRAIN_WIDTH
	terrain_bytes_total := cast(u32)(bytes_per_mesh * total_chunks * total_chunks)
	tris_per_chunk := TERRAIN_TRIS_SIZE

	terrain_tris := cast(u32)(tris_per_chunk )

	ctx.terrain_tex.width = cast(u32)total_chunks * (MESH_WIDTH - 1)
	ctx.terrain_tex.height = cast(u32)total_chunks * (MESH_WIDTH - 1)
	ctx.terrain_tex.channels = 1
	ctx.terrain_tex.channel_size = gen_texture_size.WORD
	channels_size := get_tex_pixel_stride(&ctx.terrain_tex)
	heightmap_bytes := ctx.terrain_tex.width * ctx.terrain_tex.height * channels_size
	aux_heightmap_bytes := ctx.terrain_tex.width * ctx.terrain_tex.height * channels_size

	terrain_textures_bytes := ctx.terrain_tex.width * ctx.terrain_tex.height + 1024 * 1024 * 40


	total_terrain_bytes := terrain_bytes_total + terrain_tris + heightmap_bytes + terrain_textures_bytes + TERRAIN_MESHES_SIZE
	globals.terrain_alloc.start = cast(*u8)GetMem(total_terrain_bytes)
	globals.terrain_alloc.max = total_terrain_bytes
	printf("terrain alloc size {total_terrain_bytes/ 1024 / 1024}mb\n")


	ctx.terrain_tex.data = LinearGet(&globals.terrain_alloc, heightmap_bytes)
	ctx.aux_terrain_tex = LinearGet(&globals.terrain_alloc, aux_heightmap_bytes)

	for y in 0..ctx.terrain_tex.height
	{
		py := cast(f32)y / cast(f32)ctx.terrain_tex.height
		for x in 0..ctx.terrain_tex.width
		{
			px := cast(f32)x / cast(f32)ctx.terrain_tex.width
			p:=Perlin2D(px * 8.0, py * 8.0, 1.0, 2)
			idx := get_pixel_idx(cast(s32)x, cast(s32)y, &ctx.terrain_tex)
			//p = (p * 15000.0)
			p = 0.0
			dst := ptr_offset(ctx.terrain_tex.data, idx, u8)
			*cast(*u16)dst = cast(u16)cast(u32)p
		}
	}
	ctx.terrain_tex.id = GenRawTexture(ctx.terrain_tex.width, ctx.terrain_tex.height, gen_texture_type.R, gen_texture_filter.LINEAR, ctx.terrain_tex.channel_size)
	UpdateTexture(ctx.terrain_tex.id, 0, 0, ctx.terrain_tex.width, ctx.terrain_tex.height, ctx.terrain_tex.data, ctx.terrain_tex.channels - 1, ctx.terrain_tex.channel_size)

	ctx.window = window;

	//globals.alloc = &ctx.per_scene_alloc;
	globals.alloc = ctx.alloc;

	// Cube vertices
	*globals.cube_verts[0] = _vec{-0.5, -0.5, -0.5, 0.0}
	*globals.cube_verts[1] = _vec{0.5, -0.5, -0.5, 0.0}
	*globals.cube_verts[2] = _vec{0.5,  0.5, -0.5, 0.0}
	*globals.cube_verts[3] = _vec{-0.5,  0.5, -0.5, 0.0}
	*globals.cube_verts[4] = _vec{-0.5, -0.5,  0.5, 0.0}
	*globals.cube_verts[5] = _vec{0.5, -0.5,  0.5, 0.0}
	*globals.cube_verts[6] = _vec{0.5,  0.5,  0.5, 0.0}
	*globals.cube_verts[7] = _vec{-0.5,  0.5,  0.5, 0.0};

	globals.cube_tris = [36]s32{
		// Bottom face
		0, 4, 5,
		0, 5, 1,

		// Front face
		0, 1, 2,
		0, 2, 3,
		
		// Back face
		4, 6, 5,
		4, 7, 6,
		
		// Left face
		0, 3, 7,
		0, 7, 4,
		
		// Right face
		1, 5, 6,
		1, 6, 2,
		
		// Top face
		3, 2, 6,
		3, 6, 7
	};

	SetIsEngine(false);
	ctx.timers.timers_count = 128;
	ctx.timers.timers = cast(*timer_info)heap_alloc(ctx.alloc, ctx.timers.timers_count * sizeof(timer_info));

	ctx.to_draw.alloc = ctx.alloc;
	dyn_init(&ctx.to_draw, 4);

	ctx.bodies.alloc = ctx.alloc;
	dyn_init(&ctx.bodies, 4);

	ctx.broad_phase_ents.alloc = ctx.alloc;
	dyn_init(&ctx.broad_phase_ents, 4);

	ctx.narrow_phase_ents.alloc = ctx.alloc;
	dyn_init(&ctx.narrow_phase_ents, 4);

	ctx.hit_ents_in_col.alloc = ctx.alloc;
	dyn_init(&ctx.hit_ents_in_col, 4);

	dyn_init2(&ctx.playable_ents, 4, ctx.alloc);
	dyn_init2(&ctx.floaty_platforms, 4, ctx.alloc);
	dyn_init2(&ctx.drawable_ents, 4, ctx.alloc);
	dyn_init2(&ctx.axe_ents, 4, ctx.alloc);
	dyn_init2(&ctx.ents_with_clip, 4, ctx.alloc);
	dyn_init2(&ctx.materials, 4, ctx.alloc);

	//scn.items.alloc = ctx.alloc;
	/*
	test_ar: dyn_array(s32);
	test_ar.alloc = ctx.alloc;
	dyn_init(&test_ar, 4);

	val: = 5;
	dyn_add(&test_ar, &val);
	val = -5;
	dyn_add(&test_ar, &val);

	file_out: dyn_array(u8);
	file_out.alloc = ctx.alloc;
	dyn_init(&file_out, 4);
	*/


	ctx.gjk = cast(*gjk_state)heap_alloc(ctx.alloc, sizeof(gjk_state))
	memset(ctx.gjk, 0, sizeof(gjk_state))

	ctx.prntr.chars_per_line = 24;


	AssignModelFolder("../models");
	AssignTexFolder("../images");
	AssignSoundFolder("../sound");
	LoadTexFolder("../images", &ctx.textures);

	ctx.step_audio_idxs[0] = GetAudioHandle("step1.flac")
	ctx.step_audio_idxs[1] = GetAudioHandle("step2.flac")

	globals.item_pick_sound_handle = GetAudioHandle("item_pick.flac")
	globals.magic_hit_sound_handle = GetAudioHandle("item_hit.flac")
	
	ctx.white_tex = load_tex(&ctx, "white.png", 0, 0, 32, 32)
	ctx.grass_tex = load_tex(&ctx, "grass.png", 0, 0, 32, 32)
	ctx.aim_tex = load_tex(&ctx, "aim.png", 0, 0, 32, 32)
	ctx.ball_tex = load_tex(&ctx, "ball.png", 0, 0, 32, 32)
	ctx.water_tex = load_tex(&ctx, "water.png", 0, 0, 32, 32)
	ctx.grid_tex = load_tex(&ctx, "grid.png", 0, 0, 32, 32)
	ctx.grid_transparent_tex = load_tex(&ctx, "transparent_grid.png", 0, 0, 32, 32)


	LoadClip("character.png", 0, 0, 64, 64, 3, 1.0, &ctx.character_texs);

	LoadClip("shock.png", 0, 0, 64, 32, 4, 1.0, &ctx.shock_small_texs);
	LoadClip("shock.png", 0, 0, 128, 32, 4, 1.0, &ctx.shock_medium_texs);

	idle_clip := CreateAnim(&ctx, 0, 1, ctx.character_texs.tex_idxs, ctx.character_texs.total_texs);
	walk_clip: = CreateAnim(&ctx, 1, 3, ctx.character_texs.tex_idxs, ctx.character_texs.total_texs);

	shock_small_clip: = CreateAnim(&ctx, 0, 3, ctx.shock_small_texs.tex_idxs, ctx.shock_small_texs.total_texs);
	shock_medium_clip: = CreateAnim(&ctx, 0, 3, ctx.shock_medium_texs.tex_idxs, ctx.shock_medium_texs.total_texs);

	LoadClip("items.png", 0, 0, 16, 16, 2, 1.0, &ctx.items_texs);
	LoadClip("abcd.png", 0, 0, 6, 8, 92, 1.0, &ctx.abcd_texs);

	idle_clip.loop = true
	walk_clip.loop = true
	shock_small_clip.loop = true
	shock_medium_clip.loop = true

	ctx.character_idle = idle_clip
	ctx.character_walk = walk_clip
	ctx.shock_small_clip = shock_small_clip
	ctx.shock_medium_clip = shock_medium_clip
	
	ctx.character_walk.vel = 0.2

	*ctx.curtain[0] = 0.0;
	*ctx.curtain[1] = 0.0;
	*ctx.curtain[2] = 0.0;
	*ctx.curtain[3] = 0.0;

	i := 0
	for t in ctx.textures
	{
		if str_cmp(t.name, "abcd.png")
		{
			break
		}
		i++
	}

	ctx.abcd_tex_info_idx = cast(u32)i

	main_loop(&ctx);
}