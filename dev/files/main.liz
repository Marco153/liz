DeserializeEntVar::fn(ctx : *scene_info, type : *type_data, data : *void, ast : *ast_rep)
{
	if is_flag_on(type.flags, TP_STRCT_IS_DYN_ARRAY)
	{
		ASSERT(ast.type == ast_type.INDEX)
		cur_tp_ptr := ptr_offset(type.strct, 1, type_data)


		on cur_tp_ptr.tp
		{
		type_enum.TYPE_ENUM
		{
			ar := cast(*dyn_array(u32))data
			bin := ast.INDEX.rhs

			if !bin
				return;
			dyn_clear(ar)
			for c in bin.BIN.expr
			{
				ASSERT(c.type == ast_type.INT)
				dyn_add(ar, cast(u32)c.INT.num)
			}
		}
		default
		{
			__dbg_break
		}
		}

	}
	else
	{
		if type.ptr == 1
		{
			type.ptr--
			if type.tp == type_enum.TYPE_STRUCT
			{
				*cast(**void)data = cast(*void)heap_alloc(globals.alloc, cast(u32)type.strct.strct_sz)
			}
			else
			{
				*cast(**void)data = cast(*void)heap_alloc(globals.alloc, cast(u32)GetTypeSize(type))
			}
			type.ptr++
			data = *cast(**void)data
		}
		else if type.ptr > 1
		{
			__dbg_break
		}

		on type.tp
		{
		type_enum.TYPE_BOOL
		{
			*cast(*u8)data = cast(u8)ast.INT.num
		}
		type_enum.TYPE_VECTOR
		{
			vec := cast(*_vec)data

			ASSERT(ast.type == ast_type.SCOPE)

			bin := *ast.SCOPE.stmnts[0]
			
			ASSERT(is_ast_bin(bin, cast(u32)token_type.COMMA))
			cur := cast(*f32)data
			for c in bin.BIN.expr
			{
				ASSERT(c.type == ast_type.INT)
				*cur = *cast(*f32)cast(*s32)&c.INT.num

				cur = ptr_offset(cur, 1, f32)
			}
		}
		type_enum.TYPE_F32
		{
			*cast(*u32)data = cast(u32)ast.INT.num
		}
		type_enum.TYPE_S32,	type_enum.TYPE_U32
		{
			*cast(*u32)data = cast(u32)ast.INT.num
		}
		type_enum.TYPE_STRUCT, type_enum.TYPE_STRUCT_DECL
		{
			ASSERT(ast.type == ast_type.SCOPE)
			
			stmnts := &ast.SCOPE.stmnts

			strct_tp :*type_data= type

			if type.tp == type_enum.TYPE_STRUCT
			{
				strct_tp = type.strct
			}

			for st in *stmnts
			{
				ASSERT(is_ast_bin(*st, cast(u32)token_type.EQUAL))
				name :*string= &st.BIN.expr[0].WORD.str

				offset :u32
				var_type:*type_data= find_var(strct_tp, name, &offset)
				if !var_type continue;

				DeserializeEntVar(ctx,var_type, ptr_offset(data, var_type.offset + offset, u8), *st.BIN.expr[1])
			}

		}
		type_enum.TYPE_ENUM
		{
			*cast(*s32)data = cast(s32)ast.INT.num
		}
		type_enum.TYPE_STR_LIT
		{
			if ast.type == ast_type.WORD
			{
				*cast(*str_lit)data = string_to_str_lit(ctx.alloc, &ast.WORD.str)
			}
			else if ast.type == ast_type.STR_LIT
			{
				*cast(*str_lit)data = string_to_str_lit(ctx.alloc, &ast.STR_LIT.str)
			}
			else
			{
				__dbg_break
			}
		}
		default
		{
			__dbg_break
		}
		}
	}
}
find_var::fn(var_type : *type_data, name : *string, offset : *u32) ! *type_data
{
	for i2 in 0..var_type.entries
	{
		cur_var: = ptr_offset(var_type, 1 + i2, type_data);
		if *name == cur_var.name
		{
			return cur_var
		}
		if cur_var.tp == type_enum.TYPE_STRUCT && is_flag_on(cur_var.flags, DECL_IS_USING) && cur_var.ptr == 0
		{
			found := find_var(cur_var.strct, name, offset)
			if found
			{
				*offset += cast(u32)cur_var.offset
				return found
			}
		}
	}
	return nil
}
parse_specific_event_ast::fn(ctx : *scene_info, ast : *ast_rep, ent : *entity)
{
	ASSERT(ast.type == ast_type.CALL)
	type :*type_data
	if ast.CALL.name.WORD.str == "BRIDGE_ROTATE"
	{
		type = GetTypeData(entity_event_type.BRIDGE_ROTATE)
	}
	else
	{
		__dbg_break
	}
	start := ptr_offset(&ent.event.type, 1, u32)

	for st in ast.CALL.args
	{

		name :*string= &st.BIN.expr[0].WORD.str

		offset : u32
		var_type:*type_data= find_var(type, name, &offset)

		if !var_type continue;

		data := ptr_offset(start, var_type.offset + offset, u8)
		DeserializeEntVar(ctx, var_type, data, *st.BIN.expr[1])
	}
}
parse_event_ast::fn(ctx : *scene_info, ast : *ast_rep, ent : *entity)
{
	ASSERT(ast.type == ast_type.SCOPE)
	type := GetTypeData(ent.event)
	bin := *ast.SCOPE.stmnts[0]
	for st in bin.BIN.expr
	{
		name :*string= &st.BIN.expr[0].WORD.str

		offset : u32
		var_type:*type_data= find_var(type, name, &offset)

		if !var_type continue;

		data := ptr_offset(&ent.event, var_type.offset + offset, u8)

		if *name == "type"
		{
			call := *st.BIN.expr[1]
			parse_specific_event_ast(ctx, call, ent)
		}
		else
		{
			DeserializeEntVar(ctx, var_type, data, *st.BIN.expr[1])
		}
	}

}
cid_from_ast::fn(ast : *ast_rep) ! custom_id
{
	ASSERT(ast.type == ast_type.SCOPE)
	bin := ast.SCOPE.stmnts[0]
	ASSERT(is_ast_bin(*bin, cast(u32)token_type.SEMI_COLON))

	ret :custom_id
	for st in bin.BIN.expr
	{
		lhs := st.BIN.expr[0]
		rhs := st.BIN.expr[1]
		name :*string= &lhs.WORD.str
		if *name == "name"
		{
			ASSERT(rhs.type == ast_type.STR_LIT)
			memcpy(ret.name[0], rhs.STR_LIT.str.data.data, rhs.STR_LIT.str.data.count)
		}
		else if *name == "a_type"
		{
			ret.id.a_type = cast(u8)rhs.INT.num
		}
		else
		{
			__dbg_break
		}
	}
	return ret
}

find_closing_curly::fn(file : *u8, i : s64) ! s64
{
  cur := ptr_offset(file, i, char)
  ASSERT(*cur == '{)

  open_levels:= 1


  i++
  while true
  {
    cur = ptr_offset(file, i, char)
    if *cur == '{
    {
      open_levels++
    }
    if *cur == '}
    {
      open_levels--
    }
    if open_levels == 0
    {
        break
    }
    i++
  }
  i++
  return i
}

ast_from_string_range::fn(file : str_lit, start : s64, end : s64, root : *scope, pinfo : *parse_info, tkns : *dyn_array(token), lang_stat : *lang_state) ! *ast_rep
{

  aux_ptr := file[end]
  prev_char := *aux_ptr
  *aux_ptr = cast(char)0

  pinfo.cur_tkn = 0
  dyn_clear(tkns)

  Tokenize(tkns, cast(str_lit)file[start])
  globals.nodes_alloc.cur = 0
  globals.ast_alloc.cur = 0
  globals.scope_alloc.cur = 1

  nd :*node= parse_scope(pinfo)
  ast :*ast_rep= parse_node_to_ast(lang_stat, nd, root)

  *aux_ptr = prev_char
  return ast
}

OpenScene::fn coroutine(cor_ctx : *coroutine_ctx, ctx : *scene_info, stage : *loading_stage, file : str_lit, fl_sz : s64, out_cor : **coroutine_func_saved)
{
  if out_cor != nil
  {
    *out_cor = _found
  }

  prev_alloc := globals.alloc

  globals.alloc = ctx.alloc

  buffer:[13]char

  dyn_clear(&ctx.tkns)

  lang_stat :lang_state

  pinfo :parse_info
  pinfo.tkns = &ctx.tkns
  pinfo.lang_stat = &lang_stat

  root :*scope= new_scope(nil)
  i :s64
  settings_end := find_closing_curly(file, i)
  settings_ast :*ast_rep= ast_from_string_range(file, i, settings_end, root, &pinfo, &ctx.tkns, &lang_stat)

  stmnts:*ast_rep= *settings_ast.SCOPE.stmnts[0]
  ar := &settings_ast.SCOPE.stmnts
  tp1 := cast(token_type)stmnts.BIN.op
  if(!is_ast_bin(stmnts, cast(u32)token_type.EQUAL))
  {
    stmnts = *stmnts.BIN.expr[0]
    ar = &stmnts.BIN.expr
  }

  // getting settings
  for st in *ar
  {
    ASSERT(is_ast_bin(*st, cast(u32)token_type.EQUAL))
    name :*string= &st.BIN.expr[0].WORD.str

    if *name == "area_col"
    {
      stmnts2 := *st.BIN.expr[1]

      if stmnts2.SCOPE.stmnts.count == 0 continue

      stmnts = *stmnts2.SCOPE.stmnts[0]

      total_areas := 1
      if is_ast_bin(stmnts, cast(u32)token_type.SEMI_COLON)
      {
        total_areas = cast(s32)stmnts.BIN.expr.count
      }

      for cur_ar_idx in 0..total_areas
      {
        cur_area :area_col_info
        cur := *stmnts.BIN.expr[cast(u64)cur_ar_idx]
        ar2 := &cur.BIN.expr

        if cur.type == ast_type.SCOPE && is_ast_bin(*cur.SCOPE.stmnts[0], cast(u32)token_type.SEMI_COLON)
        {
          ar2 = &cur.SCOPE.stmnts[0].BIN.expr
        }

        area_name_ast := ar2[0].BIN.expr[1]

        ASSERT(area_name_ast.type == ast_type.STR_LIT)

        area_name := &area_name_ast.STR_LIT.str

        preserve_area := false

        for a in ctx.areas_col
        {
          if *area_name == a.name
          {
            preserve_area = true
            break
          }
        }

        if preserve_area continue;

        for st2 in *ar2
        {
          type :*type_data= GetTypeData(area_col_info)

          if(!is_ast_bin(*st2, cast(u32)token_type.EQUAL))
          {
            tt :token_type
            tt.type = cast(token_type)st2.BIN.op
          }
          name = &st2.BIN.expr[0].WORD.str

          offset : u32
          var_type:*type_data= find_var( type, name, &offset)

          if !var_type continue;

          data := ptr_offset(&cur_area, var_type.offset, u8)
          DeserializeEntVar(ctx, var_type, data, *st2.BIN.expr[1])
        }
        //__dbg_break
        new_collision_chunks(ctx, &cur_area)

        dyn_add(&ctx.areas_col, &cur_area)
        return

      }
    }
  }
  ctx.col_chunks = ctx.areas_col[0]

  i = settings_end

  instantiated_ents := 0
  file = cast(str_lit)ptr_offset(file, 0, u8);

  loading_areas_to_fill :dyn_array(*loading_area_info)

  while i < fl_sz
  {
    ch := ptr_offset(file, i, char)
    if *file[i] == '{
    {
      //__dbg_break
      ent_str_end := find_closing_curly(file, i)
      dyn_clear(&ctx.tkns)
      ast :*ast_rep= ast_from_string_range(file, i, ent_str_end, root, &pinfo, &ctx.tkns, &lang_stat)
      return

      aux_str:string
        ast_to_string(ast, &aux_str)
        ASSERT(ast.type == ast_type.SCOPE)

        stmnts= *ast.SCOPE.stmnts[0]
        test := cast(token_type)stmnts.BIN.op

        ASSERT(is_ast_bin(stmnts, cast(u32)token_type.SEMI_COLON))

        etype :*type_data= GetTypeData(cast(*entity)0)

        flags := cast(u32)stmnts.BIN.expr[0].BIN.expr[1].INT.num

        ent :*entity
        if is_flag_on(flags, ENTITY_DONT_FREE)
        {
          i = ent_str_end
          continue
          bin := stmnts.BIN.expr[1]
          ASSERT(bin.BIN.expr[0].WORD.str == "idx")
          ent_idx := cast(u32)stmnts.BIN.expr[1].BIN.expr[1].INT.num
          ASSERT(ent_idx < globals.entities.max)
          ent = ptr_offset(globals.entities.start, ent_idx, entity)


        }
        else
        {
            ent = NewEnt(ctx, "")
        }

        printf("des {instantiated_ents}\n")

        deleted := false
        for st in stmnts.BIN.expr
        {
            ASSERT(is_ast_bin(*st, cast(u32)token_type.EQUAL))
            name :*string= &st.BIN.expr[0].WORD.str

            offset : u32
            var_type:*type_data= find_var(etype, name, &offset)

            if !var_type continue;

            data := ptr_offset(ent, var_type.offset + offset, u8)
            if *name == "emmitter"
            {
                ent.emmitter = cast(*particle_emmitter)heap_alloc(ctx.alloc, sizeof(particle_emmitter))
            }
            else if *name == "l_area"
            {
              l_area := new_ptr(loading_area_info)
              memset(l_area, 0, sizeof(*l_area))
              scp := *st.SCOPE.stmnts[1]
              bin := scp.BIN.expr[0]
              in_front_name := &bin.BIN.expr[0].BIN.expr[1].STR_LIT.str
              in_back_name := &bin.BIN.expr[1].BIN.expr[1].STR_LIT.str
              
              l_area.in_front_scene_name = string_to_str_lit(ctx.alloc, in_front_name)
              l_area.in_back_scene_name = string_to_str_lit(ctx.alloc, in_back_name)
            
              fill_loading_area_with_file_data(ctx, l_area)

              if bin.BIN.expr.count > 2
              {
                bin = bin.BIN.expr[2]
                preserve_name := &bin.BIN.expr[0].WORD.str
                ASSERT(*preserve_name == "preserve_ents")

                preserve_scp := bin.BIN.expr[1]
                preserve_scp_bin := preserve_scp.SCOPE.stmnts[0]

                ar = &preserve_scp_bin.BIN.expr

                if preserve_scp_bin.type == ast_type.STR_LIT
                {
                  ar = &preserve_scp.SCOPE.stmnts
                }

                for str in *ar
                {
                  ASSERT(str.type == ast_type.STR_LIT)
                  new_str := string_to_str_lit(ctx.alloc, &str.STR_LIT.str)
                  dyn_add(&l_area.preserve_ents_names, new_str)
                }
              }

              
              ent.l_area = l_area
              dyn_add(&loading_areas_to_fill, l_area)

              return
            }
            else if *name == "event"
            {
                parse_event_ast(ctx, *st.BIN.expr[1], ent)
            }
            else if *name == "cl3d"
            {
                //__dbg_break
                cid := cid_from_ast( *st.BIN.expr[1])
                memcpy(buffer[0], cid.name, 12)
                found := find_asset(ctx, cast(str_lit)buffer[0], &ent.cl3d)
                ASSERT(found)
                if ent.matrices_ptr
                {
                  heap_free(ctx.alloc, ent.matrices_ptr)
                }
                ent.matrices_ptr = nil
            }
            else if *name == "model"
            {
                //__dbg_break
                cid := cid_from_ast( *st.BIN.expr[1])
                memcpy(buffer[0], cid.name, 12)
                found := find_asset(ctx, cast(str_lit)buffer[0], &ent.model, ASSETS_MODELS_OFFSET)
                ASSERT(found)
            }
            else if *name == "tex_id"
            {
                //__dbg_break
                cid := cid_from_ast( *st.BIN.expr[1])
                memcpy(buffer[0], cid.name, 12)
                found := find_asset(ctx, cast(str_lit)buffer[0], &ent.tex_id)
                ASSERT(found)
            }
            else if *name == "material_idx"
            {
              ASSERT(st.BIN.expr[1].type == ast_type.SCOPE)
              ASSERT(is_ast_bin(*st.BIN.expr[1].SCOPE.stmnts[0], cast(u32)token_type.SEMI_COLON))
              ent.flags = ent.flags | ENTITY_CUSTOM_SHADER

              cur_stmnts := &st.BIN.expr[1].SCOPE.stmnts[0].BIN.expr

              m_idx_name := cur_stmnts[0].BIN.expr[0]
              m_idx_scp := cur_stmnts[0].BIN.expr[1]
              ASSERT(m_idx_name.type == ast_type.WORD && m_idx_name.WORD.str == "idx")

              cid := cid_from_ast( *m_idx_scp)
              memcpy(buffer[0], cid.name, 12)

              found:=find_asset(ctx, cast(str_lit)buffer[0], &ent.material_idx, start=ASSETS_MATERIALS_OFFSET)
              ASSERT(found)

              mat := get_material_ptr(&ent.material_idx)

              ent.in_material_instance = new_material_instance(ctx, &ent.material_idx, ent)

              inst := mat.instances[cast(u64)ent.in_material_instance]

              return
              
              for cur_ast in *cur_stmnts
              {
                cur_ast_name := &cur_ast.BIN.expr[0].WORD.str
                i2 :u64= 0
                
                found = false
                for u in mat.uniforms
                {
                  if u.name == *cur_ast_name
                  {
                      found = true
                      break
                  }
                  i2++
                }
                if !found
                    continue;

                target_decl_u := mat.uniforms[i2]
                target_u := inst.uniforms[i2]
                aux_type_data : type_data
                on target_decl_u.tp.type
                {
                lang_type_type.SAMPLER2D
                {
                  //__dbg_break
                  aux_type_data.tp = type_enum.TYPE_U32
                  cid = cid_from_ast( *cur_ast.BIN.expr[1])
                  memcpy(buffer[0], cid.name, 12)
                  found = find_asset(ctx, cast(str_lit)buffer[0], &target_u.tex)
                  ASSERT(found)

                }
                lang_type_type.V2, lang_type_type.V3, lang_type_type.V4
                {
                    aux_type_data.tp = type_enum.TYPE_VECTOR
                    a := *cur_ast.BIN.expr[1]
                    DeserializeEntVar(ctx, &aux_type_data, &target_u.v, a)
                }
                default
                {
                    __dbg_break
                }
                }
                a:=0
              }
              return
            }
            else if *name == "en_info"
            {
                ent.en_info = new_ptr(enemy_info)
                memset(ent.en_info, 0, sizeof(enemy_info))
                DeserializeEntVar(ctx, GetTypeData(enemy_info), ent.en_info , *st.BIN.expr[1])
            }
            else if *name == "cols"
            {
                if  ent.cols.count == 0
                {

                    scps := st.BIN.expr[1]
                    dyn_add(&ctx.bodies, &ent);
                    ent.ents_in_collision.alloc = ctx.alloc;
                    dyn_init(&ent.ents_in_collision, 16);
                    ent.ents_in_collision.count = 16

                    ASSERT(scps.type == ast_type.SCOPE)

                    return
                    for s in scps.SCOPE.stmnts
                    {
                        col := new_ptr(collider)
                        memset(col, 0, sizeof(collider))
                        col.ent = ent
                        dyn_add(&ent.cols, col)

                        ASSERT(s.type == ast_type.SCOPE)
                        ASSERT(is_ast_bin(*s.SCOPE.stmnts[0], cast(u32)token_type.SEMI_COLON))

                        sts := s.SCOPE.stmnts[0]

                        for cur_st in sts.BIN.expr
                        {

                            name = &cur_st.BIN.expr[0].WORD.str
                            
                            col_t :*type_data= GetTypeData(collider)
                            var_type = find_var(col_t, name, &offset)

                            if *name == "type"
                            {
                                col.type = cast(col_type)cur_st.BIN.expr[1].INT.num
                            }
                            else if *name == "model"
                            {
                                cid := cid_from_ast( *cur_st.BIN.expr[1])
                                memcpy(buffer[0], cid.name, 12)
                                a_idx := cast(*asset_index)&col.MESH.info.model_idx
                                found:=find_asset(ctx, cast(str_lit)buffer[0], a_idx, ASSETS_MODELS_OFFSET)
                                ASSERT(found)
                            }
                            else
                            {
                                if !var_type continue;

                                data = ptr_offset(col, var_type.offset + offset, u8)

                                DeserializeEntVar(ctx, var_type, data, *cur_st.BIN.expr[1])
                            }
                        }
                        if col.type == col_type.MESH
                        {
                            model_verts_count:u32
                            model_tris_count:u32
                            m := get_model_ptr(cast(*asset_index)&col.MESH.info.model_idx)

                            GetInfoFromModel(m.model, &model_verts_count, &model_tris_count)
                            create_mesh_collider(ctx, col, model_tris_count, model_verts_count)
                            //__dbg_break
                            return
                            assign_mesh_to_chunks(ctx, ent)
                        }
                    }
                    return
                }
                add_body_to_chunks(ctx, ent)
                return
            }
            else
            {
              DeserializeEntVar(ctx, var_type, data, *st.BIN.expr[1])
            }
        }

        return

        ent.anim_mul = 1.0

        i = ent_str_end
        if is_flag_off(ent.flags, ENTITY_DONT_FREE)
        {
          for en in ent.remove_from
          {
              on *en
              {
              ent_part_of.PLAYABLE
              {
                  printf("type {cast(u32)ent.type}\n")

                  dyn_add(&ctx.playable_ents, ent)
                  if ent.type == ent_type.ENEMY
                  {
                      on ent.enemy_type
                      {
                      enemy_enum.SKULL
                      {
                          ent.playable_func = skull_mov
                          ent.state = entity_state.GO_FORWARDS
                          ent.c_type = clip_type.C3D
                      }
                      default
                      {
                          __dbg_break
                      }
                      }
                      ent.col_enter = enemy_collision_enter;
                      //ent.en_info.origin_pos = ent.pos
                  }
              }
              ent_part_of.ANIMATION
              {
                  dyn_add(&ctx.ents_with_clip, ent)
              }
              ent_part_of.ITEMS
              {
                  dyn_add(&ctx.items_ents, ent)
                  ent.col_enter = item_col_func
              }
              ent_part_of.LOOK_AT_PLAYER
              {
                  dyn_add(&ctx.look_at_ents, ent)
              }
              ent_part_of.EMMITTER
              {
                  dyn_add(&ctx.emmitters, ent)
              }
              ent_part_of.DRAWABLE
              {
                  dyn_add(&ctx.drawable_ents, ent)
              }
              ent_part_of.COLLIDER
              {
                  //add_body(ctx, ent);
              }
              ent_part_of.INSTANTIATED
              {
                  //__dbg_break
                  //dyn_add(&ctx.ents, ent)
              }
              default
              {
                  __dbg_break
              }
              }
          }
        }
        if ent.type == ent_type.BRIDGE
        {
            ent.forward = ent.rot
            ent.vel = ent.pos

            q2:quaternion=?
            q2.v = ent.rot
            qeuler := quaternion_to_euler(&q2.v)
            ent.vel.w = qeuler.x
        }
        instantiated_ents++
        return

      }

      i++
	}

  return
  grid_shader := find_shader(ctx, "grid.mat")
  globals.preview_ent.in_material_instance = new_material_instance(ctx, &grid_shader, globals.preview_ent)
  assign_bodies_to_chunks(ctx)
  globals.player.flags = globals.player.flags
  return


  aux_ents :[16]*entity


  ASSERT(sizeof(str_lit) == sizeof(*entity))
  for ld in loading_areas_to_fill
  {
    i=0
    
    for str in ld.preserve_ents_names
    {
      for e in ctx.ents
      {
        if str_cmp(*str, e.name)
        {
          *aux_ents[cast(u64)i] = *e
          i++
        }
      }
    }
    memcpy(ld.preserve_ents.data, aux_ents[0], cast(u64)i * sizeof(*entity))
  }


  if loading_areas_to_fill.count > 0
    heap_free(ctx.alloc, loading_areas_to_fill.data)


  *stage = loading_stage.DONE

  globals.alloc = prev_alloc
}
_DeserializeAllEnt::fn coroutine(cor_ctx : *coroutine_ctx, ctx : *context, stage : *loading_stage, file : str_lit, fl_sz : s64, out_cor : **coroutine_func_saved)
{
  /*
  if out_cor != nil
  {
    *out_cor = _found
  }

  buffer:[13]char

  dyn_clear(&ctx.tkns)

  lang_stat :lang_state

  pinfo :parse_info
  pinfo.tkns = &ctx.tkns

  root :*scope= new_scope(nil)

  preserved_ents : dyn_array(*entity)
  for i2 in 0..globals.entities.max
  {
    ent := ptr_offset(globals.entities.start, i2, entity);

    if is_flag_on(ent.flags, ENTITY_IN_USE) && is_flag_off(ent.flags, ENTITY_DONT_FREE)
    {
      DeleteEnt(ctx, ent)
      ent.flags = 0;
      return 
    }
    else
    {
      had_cols := false
      for c in ent.ents_in_collision
      {
        had_cols = true
          c.in_col = false;
      }
      if had_cols
      {
        return
      }
    }
  }
  return

  i :s64
  settings_end := find_closing_curly(file, i)
  settings_ast :*ast_rep= ast_from_string_range( file, i, settings_end, root, &pinfo, &ctx.tkns, &lang_stat)

  for a_idx in 0..ctx.areas_col.count
  {
    l_area := ctx.areas_col[cast(u64)a_idx]
    found_preserve := false
    cur_ch := 0
    for ch in l_area.col_chunks
    {
      for e in preserved_ents
      {
        for e2 in ch.entities
        {
          if str_cmp(e2.name, e.name)
          {
            found_preserve = true
            break
          }
        }

        if found_preserve break;

        for e2 in ch.from_ents
        {
          if str_cmp(e2.from_ent.name, e.name)
          {
            found_preserve = true
            break
          }
        }

        if found_preserve break;
      }
    }
    if !found_preserve
    {
      dyn_rem(&ctx.areas_col, cast(u32)a_idx)
      a_idx--
    }
  }
  return
  //dyn_clear(&ctx.areas_col)

  stmnts:*ast_rep= *settings_ast.SCOPE.stmnts[0]
  ar := &settings_ast.SCOPE.stmnts
  tp1 := cast(token_type)stmnts.BIN.op
  if(!is_ast_bin(stmnts, cast(u32)token_type.EQUAL))
  {
    stmnts = *stmnts.BIN.expr[0]
    ar = &stmnts.BIN.expr
  }
  */

}
free_lang_stuff::fn()
{
	globals.ast_alloc.cur = 0
	globals.scope_alloc.cur = 0
	globals.nodes_alloc.cur = 0
}

SaveScene::fn(ctx : *scene_info, file_name : str_lit, per_scene_alloc : *mem_alloc)
{
	out :string

	InitMemAlloc(per_scene_alloc, 16000)
	//dyn_add_data(&out.data, &fl, sizeof(fl));

	prev_alloc := globals.alloc
	globals.alloc = per_scene_alloc

	file_name = "../scenes/{file_name}"
	out_file := OpenFile(file_name)
	defer CloseFile(out_file)

  settings_ast := new_ast2()
  settings_ast.type = ast_type.SCOPE

  area_cols_ast := new_ast2()
  area_cols_ast.type = ast_type.SCOPE


  for a in ctx.areas_col
  {
    cur := new_ast2()
    cur.type = ast_type.SCOPE

    dyn_add(&cur.SCOPE.stmnts, StrLitAssignmentToAst("name", a.name))
    dyn_add(&cur.SCOPE.stmnts, VecAssignmentToAst("area_col_pos", &a.area_col_pos))
    dyn_add(&cur.SCOPE.stmnts, VecAssignmentToAst("area_col_size", &a.area_col_size))

    dyn_add(&cur.SCOPE.stmnts, S32AssignmentToAst("chunk_width", *cast(*s32)&a.chunk_width))

    dyn_add(&area_cols_ast.SCOPE.stmnts, cur)
    
  }
  
  dyn_add(&settings_ast.SCOPE.stmnts, AssignmentToAst("area_col", area_cols_ast))

  aux :string

  
  ast_to_string(settings_ast, &aux)
  PushStr(&out, &aux)
  heap_free(aux.data.alloc, aux.data.data)


	WriteToFile(out_file, out.data.data, out.data.count)
	cur_file_sz := out.data.count

	out.data.count = 0

	for i in 0..ctx.ents.count
	{
		globals.temp_alloc.cur = 0
		ent := *ctx.ents[cast(u64)i]
		/*
		if str_cmp(ent.name, "item_idx79")
		{
			__dbg_break
		}
		*/
		printf("i is {i} name {ent.name}\n")
		if is_flag_off(ent.flags, ENTITY_IN_USE)
		{
			continue
		}
		//printf("ent saved {ent.name}, flags {ent.flags}\n")
		if ent.type == ent_type.AXIS
			continue;

		if is_flag_on(ent.flags, ENTITY_TEMPORARILY_NOT_SERIALIZE)
		{
			__dbg_break
			continue
		}

		if is_flag_on(ent.flags, ENTITY_IN_USE) && is_flag_on(ent.flags, ENTITY_SERIALIZE)
		{
			free_lang_stuff()
      memset(&aux, 0, sizeof(string))
			cur_al:=globals.alloc

			ast := SerializeEnt(ent, cast(u64)i)
			
			ast_to_string(ast, &aux)
			PushStr(&out, &aux)
			heap_free(aux.data.alloc, aux.data.data)
			PushStrLit(&out, "\n ")

			SetFilePtr(out_file, cur_file_sz);

			WriteToFile(out_file, out.data.data, out.data.count)

			cur_file_sz += out.data.count

			out.data.count = 0

			globals.temp_alloc.cur = 0
			//printf("str {out}\n")
		}
	}
	globals.alloc = prev_alloc
	out.data.count -= 2
	printf("file name %", file_name)
	//WriteFile(file_name, out.data.data, out.data.count)

	heap_free(out.data.alloc, out.data.data)

}
show_material_instance_uniforms::fn(ctx : *context, mat : *material_info, inst : *material_instance)
{
	prev_sz:=globals.temp_alloc.cur
	idx :u64

	//printf("here, max {inst.uniforms.count}")
	for u in inst.uniforms
	{
		globals.temp_alloc.cur = prev_sz
		u_with_name := mat.uniforms[idx]
		ImGuiText("{u_with_name.name}:")
		//printf("cur {idx}\n")
		if u.is_array
		{
			on cast(lang_type_type)u.type
			{
			lang_type_type.MAT4
			{
				start := u.data
				for i in 0..u.array_sz
				{
					ImGuiPushID(cast(u32)i)
					
					ImGuiText("[{i}]:")
					cur:= ptr_offset(start, 0, _vec)
					ImGuiShowV4(cur)

					cur = ptr_offset(cur, 1, _vec)
					ImGuiShowV4(cur)

					cur = ptr_offset(cur, 1, _vec)
					ImGuiShowV4(cur)

					cur = ptr_offset(cur, 1, _vec)
					ImGuiShowV4(cur)

					ImGuiPopID()
					
					start = ptr_offset(start, 64, u8)
				}
			}
			default
			{
				__dbg_break
			}
			}
		}
		else
		{
			on cast(lang_type_type)u.type
			{
			lang_type_type.V2
			{
				ImGuiShowV2(&u.v)
			}
			lang_type_type.V3
			{
				ImGuiShowV2(&u.v)
			}
			lang_type_type.V4
			{
				ImGuiSameLine()
				ImGuiShowV4(&u.v)
			}
			lang_type_type.SAMPLER2D
			{
				ImGuiSameLine()
				x := ImGuiGetCursorPosX()
				y := ImGuiGetCursorPosY()
				selected := false
				if ImGuiSelectable("##mat{cast(u32)y}", selected, 32.0, 32.0)
				{
					ctx.selected_tex_ref = &u.tex
					ctx.textures_wnd = true
				}
				ImGuiSetCursorPos(x, y)
				a :=  globals.assets[cast(u64)u.tex.asset_index]
				id := a.TEXTURE_ARRAY.texs[cast(u64)u.tex.offset].id
				//printf("index {u.tex.asset_index}, offset {u.tex.offset}\n")
				ImGuiImage(id, 32.0, 32.0)
			}
			}
		}

		idx++
	}
	//printf("here2\n")

}
set_bridge_pos::fn(ent : *entity)
{
	q : quaternion= euler_to_quaternion(radians_to_degree(ent.bridge_rot), 0.0, 0.0)
	rotated_pivot:_vec= q * ent.pivot

	q2:quaternion=?
	q2.v = ent.forward
	ent.rot = (q2 * q).v
	dir_to_pivot := ent.pivot - rotated_pivot
	ent.pos = ent.vel + dir_to_pivot
	c := *ent.cols[0]
	c.data_ready = false
}
new_collision_chunks::fn(ctx : *scene_info, area_col : *area_col_info)
{
  area_col_size := area_col.area_col_size
  chunk_width := area_col.chunk_width

  assert(chunk_width > 0.0, "chunk_with was {chunk_width}")

	x_width := cast(u32)(area_col_size.x / chunk_width) + 1
	y_width := cast(u32)(area_col_size.y / chunk_width) + 1
	z_width := cast(u32)(area_col_size.z / chunk_width) + 1

	total_chunks := x_width * y_width * z_width

	printf("{total_chunks} chunks created \n")
  

	dyn_init2(&area_col.col_chunks, total_chunks, ctx.alloc)
  //memset(area_col.col_chunks.data, 0, total_chunks * sizeof(*area_col.col_chunks.data))
	area_col.col_chunks.count = area_col.col_chunks.cap
}
items_func::fn(ctx : *scene_info, dt : f32, selected_ent : *entity)
{
	for e_ in ctx.items_ents
	{
		e := *e_
		if e == selected_ent continue;

		e.pos.y = e.pos.w + sin(globals.time_since_start) * 0.1
	}
}
terrain_brush_type:enum
{
	NONE,
	SMOOTH,
	PATH,
	ROUGH
}
terrain_edit:struct
{
	brush : terrain_brush_type
	force : f32
	brush_size :f32
	terrain_height_max : f32
	terrain_height_min : f32

	path_width : f32

}
point_in_square :: fn(P : *_vec, A : *_vec, B : *_vec, C : *_vec, D : *_vec) ! bool
{
	_P := *P
    _A := *A
    _B := *B
    _C := *C
    _D := *D

	aux1 := _B - _A
	aux2 := _P - _A
	c := cross_vec(&aux1, &aux2)
    c1 : f32 = c.y

	aux1 = _C - _B
	aux2 = _P - _B
	c = cross_vec(&aux1, &aux2)
    c2 : f32 = c.y

	aux1 = _D - _C
	aux2 = _P - _C
	c = cross_vec(&aux1, &aux2)
    c3 : f32 = c.y

	aux1 = _A - _D
	aux2 = _P - _D
	c = cross_vec(&aux1, &aux2)
    c4 : f32 = c.y

    all_non_neg := (c1 >= 0.0 && c2 >= 0.0 && c3 >= 0.0 && c4 >= 0.0)
    all_non_pos := (c1 <= 0.0 && c2 <= 0.0 && c3 <= 0.0 && c4 <= 0.0)

    if (all_non_neg || all_non_pos) {
        return true
    }

    return false
}
set_path_on_terrain::fn(ctx : *context, trn : *entity)
{
	max_dist := 0.0
	start_pos := ctx.path_ents[0].pos
	all_pos:_vec

	for e in ctx.path_ents
	{
		all_pos += e.pos
	}
	all_pos = all_pos / cast(f32)cast(s32)ctx.path_ents.count

	start_pos = all_pos
	end_pos := start_pos

	for e in ctx.path_ents
	{
		dir := e.pos - start_pos
		dist := len_vec(&dir)
		
		if dist > max_dist
		{
			max_dist = dist
		}
	}

	col : collision=?

	start_pos.y += 500.0
	end_pos.y -= 500.0
	ctx.tedit.brush_size = max_dist + ctx.tedit.brush_size

	
	if !RaycastWithTerrain(ctx, &start_pos, &end_pos, trn, &col)
	{
		// we should be on the terrain
		__dbg_break
	}
	terrain := trn.terrain
	i :u64= 0
	count := ctx.path_ents.count - 1
	height_ratio := 65000 / terrain.amplitude

	while i < count
	{
		//__dbg_break
		cur := ctx.path_ents[i]
		next := ctx.path_ents[i + 1]

		cpos := cur.pos
		npos := next.pos
		cur_cross := cur.vel
		next_cross := next.vel

		steep_diff := npos.y - cpos.y

		A := cpos - cur_cross
		B := cpos + cur_cross
		C := npos + next_cross
		D := npos - next_cross

		AB := B - A
		CD := D - C

		A.y = 0.0
		B.y = 0.0
		C.y = 0.0
		D.y = 0.0

		if dot_vec(&AB, &CD) > 0.0
		{
			aux := C
			C = D
			D = aux
			printf("yep i{i}\n")

		}

		dir := next.pos - cur.pos
		dir_len := len_vec(&dir)
		og_dir := dir
		dir = normalize_vec(&dir)
		dir.y = 0.0


		//__dbg_break
		for vtx in ctx.vertex_terrain
		{
			vpos :_vec
			vpos.x = cast(f32)vtx.x
			vpos.z = cast(f32)vtx.y
			m := vtx.mesh
			/*vt := cast(*terrain_vert_info)m.verts[vtx.vidx]
			//vt.pos.y = (cast(f32)cur_val/65000.0) * terrain.amplitude
			vt.col.x = 1.0
			vt.col.y = 1.0
			vt.col.z = 1.0
			vt.col.w = 0.5
			*/

			if !point_in_square (&vpos, &A, &B, &C, &D)
			{
				continue
			}
			
			to_vpos := vpos - cpos

			d:= dot_vec(&dir, &to_vpos)

			d = d / dir_len
			steep := steep_diff * d + cpos.y
			vt := cast(*terrain_vert_info)m.verts[vtx.vidx]
			vt.pos.y = steep
			steep = steep * height_ratio

			/*printf("\nd {d}, steep {steep}, len {dir_len}, i {i}\n")
			printf("cpos:")
			print_vec(&cpos)
			printf("npos:")
			print_vec(&npos)
			printf("dir:")
			print_vec(&og_dir)
			printf("vpos:")
			print_vec(&vpos)
			
			*/


			globals.temp_alloc.cur = 0

			idx := get_pixel_idx(cast(s32)vtx.x, cast(s32)vtx.y, &ctx.terrain_tex)
			force := vtx.dir
			out_pixel := ptr_offset(ctx.terrain_tex.data, idx, u8)

			val := cast(u16)clamp(cast(s32)steep, 0, 65000)
			if !vtx.duplicated
			{
				*cast(*u16)out_pixel = val
			}
		}
		i++
	}
	UpdateTexture(ctx.terrain_tex.id, 0, 0, ctx.terrain_tex.width, ctx.terrain_tex.height, 
					ctx.terrain_tex.data, ctx.terrain_tex.channels - 1, ctx.terrain_tex.channel_size)
	dyn_clear(&ctx.vertex_terrain)


	calculate_normals(terrain)
	for mi in ctx.mesh_added_aux
	{
		m := terrain.meshes[cast(u64)*mi]
		vi :u64
		verts := &m.verts
		//__dbg_break
		UpdateModel(m.model, m.verts.data)
	}
}
find_keyframe::fn(ar : *dyn_array(keyframe_psr), time : f32) ! u64
{
	ret : u64
	for k in *ar
	{
		if k.time > time
		{
			break
		}
		ret++
	}
	ret--
	return ret
}
get_keyframe_rot::fn(b : *bone_animation, time : f32) ! _vec
{
	rot_kf_idx := find_keyframe(&b.rot, time)
	rot_next_kf_idx := clamp(rot_kf_idx + 1, 0, b.rot.count - 1)
	final_rot :_vec=?

	cur_rot_kf := b.rot[rot_kf_idx]
	next_rot_kf := b.rot[rot_next_kf_idx]

	val_diff := next_rot_kf.time - cur_rot_kf.time

	if val_diff != 0.0
	{
		p := (time - (cur_rot_kf.time - 1.0)) / val_diff
		final_rot = quaternion_slerp(&cur_rot_kf.val, &next_rot_kf.val, p)
	}
	else
	{
		final_rot = cur_rot_kf.val
	}

	return final_rot
}
get_keyframe_pos::fn(b : *bone_animation, time : f32) ! _vec
{
	final_pos :_vec=?
	pos_kf_idx := find_keyframe(&b.pos, time)
	pos_next_kf_idx := clamp(pos_kf_idx + 1, 0, b.pos.count - 1)

	cur_pos_kf := b.pos[pos_kf_idx]
	next_pos_kf := b.pos[pos_next_kf_idx]
	val_diff := next_pos_kf.time - cur_pos_kf.time

	if val_diff > 0.0
	{
		p := (time - cur_pos_kf.time) / val_diff

		diff_pos := next_pos_kf.val - cur_pos_kf.val 
		final_pos = cur_pos_kf.val + diff_pos * p

	}
	else
	{
		final_pos = cur_pos_kf.val
	}

	return final_pos
}
fill_bones::fn(ent : *entity, out_matrices : *f32, b : *bone_animation, parent_mat : *mat4x4, time : f32, dt : f32)
{
	a_man := ent.anim_man
	final_pos := get_keyframe_pos(b, time)
	final_rot := get_keyframe_rot(b, time)

	if b.has_sec_clip
	{
		sec_cl := get_clip_ptr(&a_man.sec_clip)

		sec_timer := &a_man.sec_clip_timer

		cur := *sec_timer + sec_cl.start
		if cur < sec_cl.end
		{
			cur = cur * ANIM_TICKS_PER_SEC

			sec_pos := get_keyframe_pos(b, cur)
			sec_rot := get_keyframe_rot(b, cur)

			final_pos = lerp(&final_pos, &sec_pos, a_man.sec_clip_weight)
			final_rot = quaternion_slerp(&final_rot, &sec_rot, a_man.sec_clip_weight)

			*sec_timer += dt * sec_cl.vel
		}

	}

	mat_ptr := ptr_offset(out_matrices, 16 * b.id, f32)
	anim_local:mat4x4=?;


	rot_mat :mat4x4=?
	pos_mat :mat4x4=?

	
	p := b.target_world_pos.w
	first := (final_pos * (1.0 - p))
	final_pos = first + b.target_world_pos * p

	final_rot = quaternion_slerp(&final_rot, &b.target_rot, b.target_rot_weight)

	q:quaternion=?
	q.v = final_rot

	build_rotation_matrix(&rot_mat, &q)
	build_translation_matrix(&pos_mat, &final_pos)

	anim_local = pos_mat * rot_mat
	anim_local = *parent_mat * anim_local

	offset :=  anim_local * b.local_matrix
	memcpy(mat_ptr, &offset, sizeof(mat4x4));
	//__dbg_break
	for ch in b.children
	{
		fill_bones(ent, out_matrices, *ch, &anim_local, time, dt)
	}
	/*
	if str_cmp(b.name, "spine")
	{
		print_vec(&final_pos)
	}
	*/

	b.final_pos = final_pos
	b.final_rot = final_rot

}
input_text::fn(ctx : *context, label_name : str_lit, name : *str_lit, buffer : *char, free_name :bool=true)
{
  name_ln := str_ln(*name)
  memcpy(buffer, *name, name_ln)
  *ptr_offset(buffer, name_ln, u8) = 0
  if ImGuiInputText(label_name, cast(str_lit)buffer, 32)
  {
    if free_name
    {
      printf("freeing {cast(u64)*name}\n")
      heap_free(ctx.alloc, *name)
      *name = new_str_lit(ctx.alloc, cast(str_lit)buffer)
    }
  }
}
fill_loading_area_with_file_data::fn(ctx : *scene_info, l_area : *loading_area_info)
{
  in_front_name := "../scenes/{l_area.in_front_scene_name}"
  in_back_name := "../scenes/{l_area.in_back_scene_name}"
  fl_sz: = cast(u32)GetFileSize(in_front_name);
  if fl_sz == -1
    __dbg_break

  l_area.in_front_scene_data = cast(str_lit)heap_alloc(ctx.alloc, cast(u32)fl_sz + 1);
  ReadFile(in_front_name, l_area.in_front_scene_data);
  l_area.in_front_scene_sz = fl_sz

  *ptr_offset(l_area.in_front_scene_data, fl_sz, u8) = 0

  fl_sz = cast(u32)GetFileSize(in_back_name);
  if fl_sz == -1
    __dbg_break

  l_area.in_back_scene_data = cast(str_lit)heap_alloc(ctx.alloc, cast(u32)fl_sz + 1);
  ReadFile(in_back_name, l_area.in_back_scene_data);
  l_area.in_back_scene_sz = fl_sz

  *ptr_offset(l_area.in_back_scene_data, fl_sz, u8) = 0
}
area_col_ui::fn(ctx :*context, a : *area_col_info)
{
  i :u32
  selected_idx:global u32
  for ch in a.col_chunks
  {
    selected:= i == selected_idx
    if ImGuiSelectable("{i}: col_chunk", selected, 40.0, 15.0)
    {
      selected_idx = i
    }
    if i == selected_idx
    {
      for e_ch in ch.from_ents
      {
        for tri in e_ch.tris
        {
          _v1 := tri._v1
          _v2 := tri._v2
          _v3 := tri._v3
          _v1.y += 0.5
          _v2.y += 0.5
          _v3.y += 0.5
          draw_tri(ctx, &_v3, &_v2, &_v1, &ctx.white_color, 0)
        }
      }

    }
    i++
  }

}
editor_window::fn(ctx : *context, out_ent : **entity, dt : f32)
{
	buffer:[256]char
	screenmx := GetMouseScreenPosX();
	screenmy := GetMouseScreenPosY();
	
	cam_pos := *ctx.cam_pos_global
	cam_rot := *ctx.cam_rot_global
	dir := ScreenMouseToWorld(screenmx, screenmy)

	//dir.y = -dir.y
	cam_dir := cam_pos + dir * 20.0
	cam_dir2 := cam_pos + dir * 5.0

	cam_dir = cam_pos + dir * 2000.0

  open_scene:=false

	prev_sel := out_ent
	aux_sel : *entity
	col: collision;
	on ctx.editor_wnd_type
	{
	editor_window_enum.ENEMY
	{
		if IsMouseDown(mouse_enum.LEFT) && IsKeyHeld(key_enum.KEY_SHIFT)
		{

		}
	}
	editor_window_enum.GRID
	{

		start_pos : global _vec=?
		aux_ent : global *entity=?
		relative_right : global _vec=?
		relative_forward : global _vec=?

		n:=ctx.grid_ent.forward
		denom := dot_vec(&n, &dir)
		t := dot_vec(&n, &(cam_pos - ctx.grid_ent.pos)) / denom
		point := cam_pos - dir * t
		point.x = cast(f32)cast(s32)point.x + 0.5
		point.y = cast(f32)cast(s32)point.y + 0.5
		point.z = cast(f32)cast(s32)point.z + 0.5

		if IsMouseDown(mouse_enum.LEFT) && IsKeyHeld(key_enum.KEY_SHIFT)
		{
			start_pos = point
			aux_ent = new_cube(ctx.cur_scn, &point, &_vec{1.0, 1.0, 1.0}, true);
			aux_ent.tex_id = ctx.screen_tex_id
			set_shader_uniform_sampler2d(ctx.cur_scn, aux_ent, "tex", &ctx.screen_tex_id)
			c1 := aux_ent.cols[0]
			c1.data_ready = false
			aux_ent.rot = ctx.grid_ent.vel

			new_rot := quaternion_to_euler(&aux_ent.rot)
			q:quaternion
			//__dbg_break
			q.v = aux_ent.rot
			if q.v.x == 0.0 && q.v.y == 0.0 && q.v.z == 0.0
			{
				q.v.w = 1.0
			}
			rel_up := q * _vec{0.0, 1.0, 0.0}

			dot := dot_vec(&rel_up, &n)
			//__dbg_break
			if dot < 0.999999
			{
				relative_forward = cross_vec(&n, &rel_up)
				rf := relative_forward
				relative_right = cross_vec(&n, &relative_forward)
				diff := angle_on_axis(&rel_up, &n, &relative_forward)

				sum_:f32= ctx.sum_
				aux_n :_vec=relative_forward
				q.v = aux_ent.rot

				quat := create_from_axis_angle(aux_n.x, aux_n.y, aux_n.z, diff)

				q = quat * q  
				//ctx.sum_ += 0.5

				aux_ent.rot = q.v


			}
			else
			{
				relative_forward = q * _vec{1.0, 0.0, 0.0}
				relative_right = cross_vec(&n, &relative_forward)
			}
		}
		if IsMouseUp(mouse_enum.LEFT)
		{
			aux_ent = nil
		}
		if IsMouseHeld(mouse_enum.LEFT) && aux_ent != nil
		{
			
			to_point := point - start_pos
			dot_x := dot_vec(&relative_forward, &to_point)
			dot_z := dot_vec(&relative_right, &to_point)
			aux_ent.pos = start_pos
			aux_ent.size.x = absf(dot_x)
			aux_ent.size.z = absf(dot_z)
			aux_ent.size.x = clamp(aux_ent.size.x, 1.0, aux_ent.size.x)
			aux_ent.size.z = clamp(aux_ent.size.z, 1.0, aux_ent.size.z)

			aux_ent.pos = start_pos + to_point * 0.5
			//aux_ent.size.x = aux_ent.size.x* 0.5
			//aux_ent.size.z = aux_ent.size.z* 0.5

			aux_ent.col_size = aux_ent.size
			c1 := aux_ent.cols[0]
			c1.data_ready = false
			//aux_ent.size.z = absf(point.z - start_pos.z)
			//aux_ent.size.z = clamp(aux_ent.size.z, 1.0, aux_ent.size.z)
		}
		if IsKeyHeld(key_enum.KEY_JMP)
		{
			if raycast_get_pos(ctx.cur_scn, ctx.cam_pos_global, &col)
			{
				ctx.grid_ent.pos = col.contact_point + col.normal * -0.001
				ctx.grid_ent.vel = col.ent.rot
			}
			else
			{
				ctx.grid_ent.pos = normalize_vec(&cam_dir) * cam_pos.y + cam_pos
				ctx.grid_ent.forward.x = 0.0
				ctx.grid_ent.forward.y = 1.0
				ctx.grid_ent.forward.z = 0.0
			}
			ctx.on_custom_grid = true
		}
		if IsKeyDown(key_enum.KEY_LCTRL)
		{
			ctx.grid_ent.rot = look_at_quaternion(&_vec{0.0, 0.0, 1.0}, &col.normal, &globals.up).v
			ctx.grid_ent.forward = -col.normal
		}
	}
	}

	_compile_shader := false
	HideCursor(false)
	ImGuiBegin("editor", &ctx.editor_wnd, 0);

	aux_bool :=ctx.editor_wnd_type == editor_window_enum.ENTS

	change_ent_to_grid := false
	if ImGuiSelectable("ents", aux_bool, 40.0, 15.0)
	{
		ctx.editor_wnd_type = editor_window_enum.ENTS
		globals.preview_ent.is_active = false
		ctx.cur_model_selected_idx = -1
	}

	ImGuiSameLine()
	aux_bool =ctx.editor_wnd_type == editor_window_enum.MODELS
	if ImGuiSelectable("models", aux_bool, 40.0, 15.0)
	{
		ctx.editor_wnd_type = editor_window_enum.MODELS
	}

	ImGuiSameLine()
	aux_bool =ctx.editor_wnd_type == editor_window_enum.SCENES
	if ImGuiSelectable("scenes", aux_bool, 40.0, 15.0)
	{
		ctx.editor_wnd_type = editor_window_enum.SCENES
	}

	ImGuiSameLine()
	aux_bool =ctx.editor_wnd_type == editor_window_enum.MODELS
	if ImGuiSelectable("particle", aux_bool, 40.0, 15.0)
	{
		ctx.editor_wnd_type = editor_window_enum.PARTICLE
	}

	ImGuiSameLine()
	aux_bool =ctx.editor_wnd_type == editor_window_enum.PREFABS
	if ImGuiSelectable("prefabs", aux_bool, 40.0, 15.0)
	{
		ctx.editor_wnd_type = editor_window_enum.PREFABS
	}
	ImGuiSameLine()
	aux_bool =ctx.editor_wnd_type == editor_window_enum.GRID
	if ImGuiSelectable("grid", aux_bool, 40.0, 15.0) || IsKeyDown(key_enum.KEY_JMP)
	{
		ctx.editor_wnd_type = editor_window_enum.GRID
	}

	ImGuiSameLine()
	aux_bool =ctx.editor_wnd_type == editor_window_enum.AREA_COL
	if ImGuiSelectable("area col", aux_bool, 40.0, 15.0)
	{
		ctx.editor_wnd_type = editor_window_enum.AREA_COL
	}

	ImGuiSameLine()
	aux_bool =ctx.editor_wnd_type == editor_window_enum.ITEMS
	if ImGuiSelectable("items", aux_bool, 40.0, 15.0)
	{
		ctx.editor_wnd_type = editor_window_enum.ITEMS
	}


	ImGuiSameLine()
	aux_bool =ctx.editor_wnd_type == editor_window_enum.TEST_ANIM
	if ImGuiSelectable("anim", aux_bool, 40.0, 15.0)
	{
		ctx.editor_wnd_type = editor_window_enum.TEST_ANIM
		ctx.anim_timer = 0.0
	}

	assign_new_height := false
	set_path := false
	set_bones_anim := false
	model_changed := false
	on ctx.editor_wnd_type
	{
	editor_window_enum.SCENES
  {
    i := 0
    fallback_used_scene:*scene_info

    for s in ctx.scenes
    {
      if !s.in_use continue

      if ImGuiSelectable("{s.name}", false, 20.0, 30.0)
      {
        ctx.cur_scn = s
      }
      ImGuiSameLine()
      if ImGuiSelectable("x##{i}", false, 20.0, 30.0)
      {
        if ctx.cur_scn == s
          ctx.cur_scn = nil
        s.in_use = false
      }
      if s.in_use
      {
          fallback_used_scene = s
      }
      i++
    }

    if ctx.cur_scn == nil
    {
      ctx.cur_scn = fallback_used_scene
    }
    ImGuiInputText("name", cast(str_lit)buffer, 32)
    ImGuiSameLine()
    if ImGuiSelectable("open", false, 20.0, 30.0)
    {
      open_scene = true
      memcpy(ctx.save_scene_buffer[0], buffer, 32)
      ctx.cur_scn = get_not_used_scene(ctx, cast(str_lit)buffer)
    }
    
  }
	editor_window_enum.TEST_ANIM
	{
		if ctx.matrices_inst == nil
		{
			mat_idx :asset_index
			if find_asset(ctx.cur_scn, "skin.mat", &mat_idx, start=ASSETS_MATERIALS_OFFSET)
			{
				mat := &globals.assets[cast(u64)mat_idx.asset_idx].MATERIAL.mat
				mod_idx :asset_index
				find_asset(ctx.cur_scn, "bones.fbx", &mod_idx, start=ASSETS_MODELS_OFFSET)
				mod := &globals.assets[cast(u64)mod_idx.asset_idx].MODEL.mod
				ctx.model_anim = mod

				idx :u64
				for u in mat.uniforms
				{
					if u.name == "bones"
					{
						break;
					}
					idx++
				}
				ctx.matrices_inst = cast(*f32)mat.instances[0].uniforms[idx].data
			}
		}
		set_bones_anim = true
		ImGuiDragF32("anim_timer", &ctx.anim_timer)

		ImGuiText("b1_pos:")
		ImGuiSameLine();
		ImGuiShowV3(&ctx.bone1_pos)

		ImGuiText("b1_rot:")
		ImGuiSameLine();
		ImGuiShowV3(&ctx.bone1_rot)

		ImGuiText("b1_scale:")
		ImGuiSameLine();
		ImGuiShowV3(&ctx.bone1_scale)


		ImGuiText("b2_pos:")
		ImGuiSameLine();
		ImGuiShowV3(&ctx.bone2_pos)

		ImGuiText("b2_rot:")
		ImGuiSameLine();
		ImGuiShowV3(&ctx.bone2_rot)

		ImGuiText("b2_scale:")
		ImGuiSameLine();
		ImGuiShowV3(&ctx.bone2_scale)

		start := ctx.bone1_pos
		end := ctx.bone2_pos
		draw_line(ctx, &start, &end, &ctx.white_color, 0)


	


		z :_vec
		z.z = 2.0

		z = euler_to_quaternion(ctx.bone2_rot.x, ctx.bone2_rot.y, ctx.bone2_rot.z) * z 
		start = ctx.bone2_pos
		end = start + z

		draw_line(ctx, &start, &end, &ctx.white_color, 0)

		sz :_vec
		sz.x = 0.5
		sz.y = 0.5
		sz.z = 0.5
		draw_vertex(ctx, &end, &sz, &cam_pos, &cam_rot)
	}
	editor_window_enum.AREA_COL
	{
      cur_area_selected:global s64

      for i in 0..ctx.cur_scn.areas_col.count
      {
        selected := i == cur_area_selected
        if ImGuiSelectable("{i}", selected, 20.0, 30.0)
        {
          cur_area_selected = i
          ctx.col_chunks = ctx.cur_scn.areas_col[cast(u64)i]
        }
        ImGuiSameLine()

        if ImGuiSelectable("x##{i}", false, 10.0, 10.0)
        {
          dyn_rem(&ctx.cur_scn.areas_col, cast(u32)i)
          ctx.col_chunks = nil
          i--
        }
        if selected
        {
          printf("idx {cast(u64)i}, count {ctx.cur_scn.areas_col.count}\n")
          a := ctx.cur_scn.areas_col[cast(u64)i]
          //area_col_ui(ctx, a)

        }
      }
      if ImGuiSelectable("+", false, 10.0, 10.0)
      {
        aux:area_col_info
        aux.name = cast(str_lit)heap_alloc(ctx.alloc, 1)
        dyn_add(&ctx.cur_scn.areas_col, &aux)
      }

      if ctx.col_chunks
      {
        draw:draw_info3d

        draw.model = 0
        draw.pos = ctx.col_chunks.area_col_pos
        draw.rot.w = 1.0
        draw.cam_pos = &cam_pos
        draw.cam_rot = &cam_rot
        *draw.color[0] = 1.0
        *draw.color[3] = 0.3
        draw.cam_forward = ctx.cam_forward_global
        draw.ent_size = ctx.col_chunks.area_col_size


        draw.flags = DRAW_INFO_TRANSPARENT;
        Draw3D(ctx.window, &draw);


        input_text(ctx, "area##{cast(u64)ctx.col_chunks}", &ctx.col_chunks.name, buffer[0])

        ImGuiText("pos: ")
        ImGuiSameLine()
        ImGuiShowV3(&ctx.col_chunks.area_col_pos)
        ImGuiText("size: ")
        ImGuiSameLine()
        ImGuiShowV3(&ctx.col_chunks.area_col_size)

        ImGuiDragF32("chunk_width", &ctx.col_chunks.chunk_width)

        if ImGuiSelectable("generate", false, 20.0, 30.0)
        {
            //new_collision_chunks(ctx, ctx.col_chunks)
        }
      }
	}
	editor_window_enum.ITEMS
	{
		item_type:global inv_item
		ImGuiEnumCombo("inv_item", __LINE__, cast(*u32)&item_type)


		if IsKeyDown(key_enum.KEY_I) && item_type != inv_item.EMPTY
		{
			if raycast_get_pos(ctx.cur_scn, ctx.cam_pos_global, &col)
			{
				test_e := NewPlaneEnt(ctx.cur_scn, "item", &col.contact_point, &_vec{1.0, 1.0, 0.5})
				test_e.type  = ent_type.ITEM

				test_e.flags  = test_e.flags | ENTITY_HAS_TEXTURE
				//test_e.tex_id  = *ptr_offset(ctx.items_texs.tex_idxs, cast(u32)item_type - 1, u32)
				test_e.pos -= col.normal;
				test_e.pos.w = test_e.pos.y

				test_e.item_type = item_type

				test_e.is_trigger = true

				dyn_add(&test_e.remove_from, ent_part_of.ITEMS)

				dyn_add(&ctx.cur_scn.items_ents, test_e)
			}
		}

	}
	editor_window_enum.GRID
	{

	}
	editor_window_enum.PARTICLE
	{
		ent := globals.preview_ent
		if !ent.emmitter
		{
			ent.emmitter = cast(*particle_emmitter)heap_alloc(ctx.alloc, sizeof(particle_emmitter))
			memset(ent.emmitter, 0, sizeof(particle_emmitter))
			ent.type = ent_type.EMMITTER
			dyn_add(&ctx.cur_scn.emmitters, ent)
		}
		emm := ent.emmitter

		aux_type :global u32
		aux_total :global s32

		ImGuiEnumCombo("particle_emmitter_type", __LINE__, cast(*u32)&aux_type)
		ImGuiInputInt("total", &aux_total)
		ImGuiShowV4(&emm.normal)
		ImGuiShowV4(&emm.cross)

		if ImGuiSelectable("new", false, 20.0, 30.0)
		{
			printf("start selectable\n")
			emm.type = cast(particle_emmitter_type)aux_type
			emm.total = cast(u32)aux_total

			printf("addr {cast(u64)emm.particles}\n")
			if emm.particles
			{
				heap_free(ctx.alloc, emm.particles)
			}
			printf("after free\n")
			sz :u32= 0
			on emm.type
			{
			particle_emmitter_type.POS_SZ_VEL
			{
				sz = sizeof(particle_pos_sz_vel)
			}
			}
			printf("after on\n")
			emm.particles = heap_alloc(ctx.alloc, sz * emm.total)
			printf("after alloc\n")
		}



		if Raycast(ctx.cur_scn, &cam_pos, &cam_dir, &col, 0, &aux_sel)
		{
			ent.pos = col.contact_point
			emm.normal = col.normal
			emm.cross = findPerpendicularVector(&emm.normal)
			emm.cross.x = absf(emm.cross.x)
			emm.cross.y = absf(emm.cross.y)
			emm.cross.z = absf(emm.cross.z)

			ent.size.x = 0.1
			ent.size.y = 0.1
			ent.size.z = 0.1
			//draw_vertex(ctx, &ent.pos, &ent.size, &cam_pos, &cam_rot)
			//print_vec(&col.contact_point)
			//printf("on col {aux_sel.name}, t1 {col.t1}, t2 {col.t2}, t3 {col.t3}\n")
		}

	}
	editor_window_enum.MODELS
	{
		idx :s32
		
		for i in 0..ctx.models_count
		{
			selected := idx == ctx.cur_model_selected_idx
			a := globals.assets[cast(u64)idx + ASSETS_MODELS_OFFSET]
			m := &a.MODEL.mod
			if ImGuiSelectable(m.name, selected, 140.0, 15.0)
			{
				ctx.cur_model_selected_idx = cast(s32)idx
			}
			idx++
		}

		if ctx.cur_model_selected_idx != -1
		{
			globals.preview_ent.size.x = 1.0
			globals.preview_ent.size.y = 1.0
			globals.preview_ent.size.z = 1.0
			globals.preview_ent.rot = euler_to_quaternion(90.0, 0.0, 0.0).v

			aux_sel_from_non_bodies : *entity
			shortest_dist : f32 = 9999.0
		
			point : _vec

			hit := false
			if RaycastWithNonBodies(ctx.cur_scn, &cam_pos, &cam_dir, &col, 0, &aux_sel_from_non_bodies)
			{
				shortest_dist = len_vec(&(cam_pos - col.contact_point))
				point = col.contact_point
				hit = true
			}
			if Raycast(ctx.cur_scn, &cam_pos, &cam_dir, &col, 0, &aux_sel)
			{
				point = col.contact_point
				hit = true
			}
			if out_ent.type == ent_type.TERRAIN
			{
				if RaycastWithTerrain(ctx, &cam_pos, &cam_dir, *out_ent, &col)
				{
					aux_dist := len_vec(&(cam_pos - col.contact_point))

					if aux_dist < shortest_dist 
					{
						point = col.contact_point
						hit = true
					}
				}
			}
			if hit
			{
				idx = ctx.cur_model_selected_idx + ASSETS_MODELS_OFFSET
				a := globals.assets[cast(u64)idx]
				m :*model_info= &a.MODEL.mod
				globals.preview_ent.model.asset_idx = cast(u32)idx
				globals.preview_ent.is_active = true
				globals.preview_ent.pos = point

				inv := col.normal
				vert:= ModelFarthestPoint(cast(u32)m.model, &inv)
				d := dot_vec(&vert, &inv)
				if IsKeyHeld(key_enum.KEY_LCTRL)
				{
					globals.preview_ent.pos += inv * d * -1.0
				}

			}
			else
			{
				globals.preview_ent.is_active = false
				globals.preview_ent.pos = point
			}
		}
	}
	editor_window_enum.ENTS
	{
		type := GetTypeData(ent_part_of)
		if !type
		{
			printf("ERROR: 'type' is nil\n")
			ASSERT(false)
		}

		start := ptr_offset(type, 1, type_data)

		ImGuiBeginChild("ents", 300.0, 500.0)

		dummy_sel := false
		idx :u64=0
		for e in ctx.cur_scn.ents
		{
			//if is_flag_on(ent.flags, ENTITY_IN_USE) && is_flag_on(ent.flags, ENTITY_SERIALIZE)
			globals.temp_alloc.cur = 0
			sprintf(buffer, buffer.len, "{idx}: {e.name}")

			dummy_sel = *out_ent == *e
			if ImGuiSelectable(cast(str_lit)buffer, dummy_sel, 150.0, 15.0)
			{
				*out_ent = *e
			}
			idx++
		}
		ImGuiInputText(" ", cast(str_lit)ctx.save_scene_buffer[0], 32)

		ImGuiSameLine()

		if ImGuiSelectable("save", dummy_sel, 40.0, 15.0)
		{
			SaveScene(ctx.cur_scn, cast(str_lit)ctx.save_scene_buffer[0], &ctx.per_scene_alloc)
		}
		ImGuiSameLine()


		if ImGuiSelectable("open", dummy_sel, 40.0, 15.0)
		{
      open_scene = true
		}


		ImGuiEndChild()
		ImGuiSameLine()

		ImGuiBeginChild("selected", 400.0, 500.0)

		if *out_ent
		{
			globals.temp_alloc.cur = 0
			aux_type := cast(u32)out_ent.type
			if ImGuiEnumCombo("ent_type", __LINE__, &aux_type)
			{

				on cast(ent_type)aux_type
				{
				ent_type.EVENT
				{
					
				}
				ent_type.LOADING_AREA
				{
          if out_ent.type != ent_type.LOADING_AREA
          {
            out_ent.is_trigger = true
            out_ent.l_area = new_ptr(loading_area_info)
            memset(out_ent.l_area, 0, sizeof(loading_area_info))
            l_area := out_ent.l_area
            l_area.in_front_scene_name = cast(str_lit)heap_alloc(ctx.alloc, 1)
            l_area.in_back_scene_name = cast(str_lit)heap_alloc(ctx.alloc, 1)
            *ptr_offset(l_area.in_front_scene_name, 1, u16) = 0
            *ptr_offset(l_area.in_back_scene_name, 1, u16) = 0
          }
				}
				ent_type.BRIDGE
				{
					out_ent.vel = out_ent.pos
					out_ent.forward = out_ent.rot
				}
				ent_type.ENEMY
				{

				}
				ent_type.GRID
				{
					change_ent_to_grid = true
				}
				ent_type.WATER
				{
					out_ent.tex_id = globals.water_tex
					water_shader := find_shader(ctx.cur_scn, "water.mat")

					out_ent.flags = out_ent.flags | ENTITY_CUSTOM_SHADER
					if out_ent.material_idx.asset_idx != water_shader.asset_idx
					{
						out_ent.material_idx = water_shader
						out_ent.in_material_instance = new_material_instance(ctx.cur_scn, &water_shader, *out_ent)
					}
					set_shader_uniform_sampler2d(ctx.cur_scn, *out_ent, "tex", &globals.water_tex)
					//out_ent.flags = out_ent.flags | ENTITY_TRANSPARENT
					out_ent.color.x = 1.0
					out_ent.color.y = 1.0
					out_ent.color.z = 1.0
					out_ent.color.w = 0.5
				}
				}
				out_ent.type = cast(ent_type)aux_type
			}
			on out_ent.type
			{
      ent_type.LOADING_AREA
      {
        l_area := out_ent.l_area
        input_text(ctx, "in_front({cast(u64)l_area.in_front_scene_name}), lar {cast(u64)l_area}", &l_area.in_front_scene_name, buffer[0])
        input_text(ctx, "in_back", &l_area.in_back_scene_name, buffer[0])

        if ImGuiSelectable("assign", false, 80.0, 15.0)
        {
          if l_area.in_front_scene_data != nil
          {
            heap_free(ctx.alloc, l_area.in_front_scene_data)
            heap_free(ctx.alloc, l_area.in_back_scene_data)
          }
          else
          {

          }
          fill_loading_area_with_file_data(ctx.cur_scn, l_area)
        }
        ImGuiSeparator()
        ImGuiText("preserve ents:")

        i :u32
        for e in l_area.preserve_ents
        {
          name :="nil"
          if e != nil
          {
            name = e.name
          }

          buffer_ptr := cast(str_lit)buffer[cast(u64)i * 16  + 32 ]
          ImGuiText("{name}\n")

          ImGuiSameLine()

          ImGuiInputText("##{i}pick", buffer_ptr, 16)
          ImGuiSameLine()
          if ImGuiSelectable("assign##{i}", false, 80.0, 15.0)
          {
            for e2 in ctx.cur_scn.ents
            {
              if str_cmp(e2.name, buffer_ptr)
              {
                *e = *e2
                break
              }
            }
          }

          ImGuiSameLine()

          if ImGuiSelectable("pick##{i}", false, 50.0, 15.0)
          {
            if out_ent
            {
              *e = *out_ent
            }
          }

          ImGuiSameLine()

          if ImGuiSelectable("x", false, 80.0, 15.0)
          {
            dyn_rem(&l_area.preserve_ents, i)
          }

          i++
        }
        if ImGuiSelectable("+##preserve", false, 80.0, 15.0)
        {
          dyn_add(&l_area.preserve_ents, nil)
        }
        ImGuiSeparator()
      }
      ent_type.ENEMY
      {
				aux_type = cast(u32)out_ent.enemy_type
				if ImGuiEnumCombo("enemy_enum", __LINE__, cast(*u32)&aux_type)
				{
					//printf("clickd combo val {cast(u32)aux_type}\n")
					on cast(enemy_enum)aux_type
					{
					enemy_enum.SKULL
					{
						printf("changed to skull\n")
						find_asset(ctx.cur_scn, "skel.fbx", &out_ent.model)
						prev_val := out_ent.material_idx.asset_idx
						out_ent.size.x = 0.1
						out_ent.size.y = 0.1
						out_ent.size.z = 0.1
						out_ent.is_static = false
						out_ent.playable_func = skull_mov
						out_ent.col_enter = enemy_collision_enter;
						dyn_add(&out_ent.remove_from, ent_part_of.PLAYABLE)
						dyn_add(&ctx.cur_scn.playable_ents, *out_ent)

						if out_ent.cols.count == 0
						{
							add_body(ctx.cur_scn, *out_ent)
						}

						dyn_add(&ctx.cur_scn.ents_with_clip, *out_ent)
						dyn_add(&out_ent.remove_from, ent_part_of.ANIMATION)
						out_ent.c_type = clip_type.C3D
						out_ent.cl3d = ctx.skull_idle

						c := *out_ent.cols[0]
						c.type = col_type.CUBE
						c.size.x = 10.0
						c.size.y = 10.0
						c.size.z = 25.0
						c.pos.z = -1.0

						out_ent.state = entity_state.GO_SIDEWAYS


						skin := find_shader(ctx.cur_scn, "skin.mat")
						out_ent.material_idx = skin
						out_ent.flags = out_ent.flags | ENTITY_CUSTOM_SHADER
						if skin.asset_idx != prev_val
						{
							out_ent.in_material_instance = new_material_instance(ctx.cur_scn, &out_ent.material_idx, *out_ent)
						}

						out_ent.rot = euler_to_quaternion(270.0, 0.0, 0.0).v
						//ent.c_type = clip_type.C3D
					}
					}
				}
      }
			}
			for i in out_ent.remove_from
			{
				cur := ptr_offset(start, *i, type_data)
				ASSERT(cur.name.count < buffer.len)

				aux := ptr_offset(&cur.name, cur.name.offset, u8)
				memcpy(buffer, aux, cur.name.count)

				*buffer[cast(u64)cur.name.count] = cast(char)0

				ImGuiText(cast(str_lit)buffer[0])

			}
			ImGuiSeparator()
			ImGuiText("collider:")

			ImGuiText("col offset:")
			ImGuiSameLine();
			ImGuiShowV3(&out_ent.col_offset)

			if out_ent.cols.count > 0
			{
				ImGuiText("children:")
				aux_1 : _vec=?
				aux_2 : _vec=?
				for ch in out_ent.cols
				{
					if ImGuiSelectable("assign mesh", aux_bool, 80.0, 15.0)
					{
						ctx.models_wnd = true
						model_changed = true
					}
					
					ImGuiText("pos:")
					ImGuiSameLine();
					ImGuiShowV3(&ch.pos)

					ImGuiText("size:")
					ImGuiSameLine();
					ImGuiShowV3(&ch.size)
					
					ch.data_ready = false
					CopyVerts(*ch, &aux_1, &aux_2)
				}
			}
			ImGuiSeparator()
			ImGuiText("pos: ")
			ImGuiSameLine()
			ImGuiShowV3(&out_ent.pos)
			ImGuiText("size: ")
			ImGuiSameLine()
			ImGuiShowV3(&out_ent.size)

			ImGuiText("color: ")
			ImGuiSameLine()
			ImGuiShowV4(&out_ent.color)

			ImGuiText("rot: ")
			ImGuiSameLine()
			ImGuiShowV4(&out_ent.rot)

			check := is_flag_on(out_ent.flags, ENTITY_ONLY_COL)
			if ImGuiCheckbox("only col", &check)
			{
				toggle_flag(&out_ent.flags, ENTITY_ONLY_COL)
			}
			check = is_flag_on(out_ent.flags, ENTITY_DONT_FREE)
			if ImGuiCheckbox("dont free", &check)
			{
				toggle_flag(&out_ent.flags, ENTITY_DONT_FREE)
      }
			check = is_flag_on(out_ent.flags, ENTITY_TEMPORARILY_NOT_SERIALIZE)
			if ImGuiCheckbox("not serialize", &check)
			{
				toggle_flag(&out_ent.flags, ENTITY_TEMPORARILY_NOT_SERIALIZE)

				found :bool;
				idx = 0
				for e in ctx.temporarily_not_serialize_ents
				{
					if e.ent == *out_ent
					{
						found = true
						break
					}
					idx++
				}
				if is_flag_on(out_ent.flags, ENTITY_TEMPORARILY_NOT_SERIALIZE)
				{
					ASSERT(found)
					t :*temporarily_not_serialize_info=ctx.temporarily_not_serialize_ents[idx]
					heap_free(t.str.data.alloc, t.str.data.data)
					
					dyn_rem(&ctx.temporarily_not_serialize_ents, cast(u32)idx)
				}
				else
				{
					ASSERT(found == false)
					t:temporarily_not_serialize_info
					ast := SerializeEnt(*out_ent, cast(u64)idx)
					
					ast_to_string(ast, &t.str)

					dyn_add(&ctx.temporarily_not_serialize_ents, &t)
				}
			}
			globals.temp_alloc.cur = 0

      input_text(ctx, "name", &out_ent.name, buffer[0])

			has_col := out_ent.cols.count > 0
			ImGuiText("has col: {has_col}");
			ImGuiCheckbox("active: ", &out_ent.is_active)
			ImGuiCheckbox("static: ", &out_ent.is_static)
      ImGuiDragF32("anim_mul", &out_ent.anim_mul)

			if ImGuiSelectable("materials", dummy_sel, 40.0, 15.0)
			{
				ctx.materials_wnd = true
			}
			ImGuiSameLine()
			if ImGuiSelectable("compile", dummy_sel, 40.0, 15.0)
			{
				if out_ent.material_idx.asset_idx != -1
				{
					_compile_shader = true
				}

			}
			if ImGuiSelectable("texture", dummy_sel, 40.0, 15.0)
			{
				ctx.textures_wnd = true
				ctx.selected_tex_ref = &out_ent.tex_id
			}
			ImGuiSeparator()
			ImGuiText("material:")
			if out_ent.material_idx.asset_idx != -1
			{
				m := get_material_ptr(&out_ent.material_idx)
				inst := m.instances[cast(u64)out_ent.in_material_instance]

				show_material_instance_uniforms(ctx, m, inst)
				// materials uniforms
			}
			
			on out_ent.type
			{
			ent_type.EVENT
			{
				ImGuiSeparator()
				ImGuiText("event: ")
				ev := &out_ent.event

				ImGuiCheckbox("one time: ", &ev.one_time)

				ImGuiEnumCombo("entity_event_type", __LINE__, cast(*u32)&ev.type)
				on ev.type
				{
				entity_event_type.BRIDGE_ROTATE
				{
					ImGuiInputInt("ent_id", cast(*s32)&ev.BRIDGE_ROTATE.ent_id)
				}
				}
			}
			ent_type.TERRAIN
			{
				ImGuiSeparator()
				ImGuiText("brush type: ")
				ImGuiEnumCombo("terrain_brush_type", __LINE__, cast(*u32)&ctx.tedit.brush)
				ImGuiDragF32("force", &ctx.tedit.force)


				ImGuiSameLine()

				trn := out_ent.terrain
				if ImGuiSelectable("set", dummy_sel, 40.0, 15.0)
				{
					h:= cast(u16)cast(u32)ctx.tedit.terrain_height_max
					memset16(ctx.terrain_tex.data, h, ctx.terrain_tex.width * ctx.terrain_tex.height)
					UpdateTexture(ctx.terrain_tex.id, 0, 0, ctx.terrain_tex.width, ctx.terrain_tex.height, 
									ctx.terrain_tex.data, ctx.terrain_tex.channels - 1, ctx.terrain_tex.channel_size)
					printf("count {trn.meshes.count}\n")
					assign_new_height = true
				}
				ImGuiDragF32("terrain height max", &ctx.tedit.terrain_height_max)
				ImGuiDragF32("terrain height min", &ctx.tedit.terrain_height_min)

				ImGuiDragF32("brush size", &ctx.tedit.brush_size)

				if ctx.tedit.brush == terrain_brush_type.PATH
				{
					if ImGuiSelectable("set path", dummy_sel, 50.0, 15.0)
					{
						set_path = true
					}
				}
				
			}
			ent_type.BRIDGE
			{
				ImGuiSeparator()
				ImGuiText("brigde: ")
				draw_vertex(ctx, &(out_ent.pos + out_ent.pivot), &_vec{1.0, 1.0, 1.0, 1.0}, &cam_pos, &cam_rot)
				ImGuiShowV3(&out_ent.pivot)
				ImGuiDragF32("bridge_rot", &out_ent.bridge_rot)

				set_bridge_pos(*out_ent)

			}
			}
			//ImGuiInputInt("flags", &out_ent.flags)
		}

		ImGuiEndChild()
	}
	}
	ImGuiEnd()

	if _compile_shader
	{
		m := get_material_ptr(&out_ent.material_idx)
		inst := m.instances[cast(u64)out_ent.in_material_instance]
		mat := compile_shader(ctx, m.name, m)
		new_material_instance(ctx.cur_scn, &out_ent.material_idx, *out_ent)
		// materials uniforms
	}
	if model_changed
	{
		//__dbg_break
	}
	if change_ent_to_grid
	{
		grid_shader := find_shader(ctx.cur_scn, "grid.mat")

		out_ent.flags = out_ent.flags | ENTITY_CUSTOM_SHADER

		if out_ent.material_idx.asset_idx != grid_shader.asset_idx
		{
			out_ent.material_idx = grid_shader
			out_ent.in_material_instance = new_material_instance(ctx.cur_scn, &grid_shader, *out_ent)
		}
		set_shader_uniform_sampler2d(ctx.cur_scn, *out_ent, "tex", &globals.grid_tex)
		
	}

	if IsKeyDown(key_enum.KEY_ESCAPE)
	{
		ctx.on_custom_grid = false
		ctx.on_contructing_path = false
		ctx.can_deactivate_path_ents = true

		ctx.editor_wnd_type = editor_window_enum.ENTS
	}
	if ctx.on_contructing_path && ctx.on_custom_grid
	{
		ctx.on_custom_grid = false
		ctx.editor_wnd_type = editor_window_enum.ENTS
	}
	if  ctx.editor_wnd_type != editor_window_enum.GRID
	{
		ctx.on_custom_grid = false
	}

	if assign_new_height
	{
		trn := out_ent.terrain
		h:= cast(u32)ctx.tedit.terrain_height_max
		hf := (cast(f32)h/65000.0) * trn.amplitude
		for m in trn.meshes
		{
			printf("count {m.verts.count}\n")
			v :u64
			while v < m.verts.count
			{
				cur := cast(*terrain_vert_info)ptr_offset(m.verts.data, v, u32)
				cur.pos.y = hf
				//printf("here {i}\n")
				globals.temp_alloc.cur = 0
				v += TERRAIN_VERTEX_SIZE
			}
			UpdateModel(m.model, m.verts.data)
		}
	}
	if set_path
	{
		set_path_on_terrain(ctx, *out_ent)

	}
	if set_bones_anim
	{
		matrices :=ctx.matrices_inst
		bone1_mat :mat4x4=?
		bone2_mat :mat4x4=?
		bone3_mat :mat4x4=?

		//__dbg_break
		ctx.anim_timer += dt
		time := ctx.anim_timer * ANIM_TICKS_PER_SEC
		for b in ctx.model_anim.roots
		{
			identity_matrix4x4(cast(*f32)&bone3_mat)
			//fill_bones(matrices, *b, &bone3_mat, time)
		}
	}
  if open_scene
  {
    stage : loading_stage

    file_name := "../scenes/{cast(str_lit)ctx.save_scene_buffer[0]}"
    file_data : str_lit
    fl_sz := GetFileSize(file_name);
    if fl_sz == -1
        __dbg_break
    file_data = cast(str_lit)heap_alloc(ctx.alloc, cast(u32)fl_sz + 1);

    ReadFile(file_name, file_data);
    cor :*coroutine_func_saved

    while stage != loading_stage.DONE
    {
      OpenScene(&ctx.coroutines, ctx.cur_scn, &stage, file_data, cast(s64)fl_sz, &cor)
    }
    cor.regs.rip = 0

    heap_free(ctx.alloc, file_data)
  }
}
change_preview_col_idx::fn(ctx : *context, new_val : u8)
{
	globals.cur_preview_idx = (new_val) % 3;

	on globals.cur_preview_idx
	{
	0
	{
		ctx.ent_collider_modify = false
		ctx.draw_col = false
	}
	1
	{
		ctx.ent_collider_modify = true
		ctx.draw_col = false
	}
	2
	{
		ctx.ent_collider_modify = false
		ctx.draw_col = true
	}
	}
}
skull_mov::fn(ctx : *context, ent : *entity, dt : *f32)
{
	//return
	player := globals.player
	dir := player.pos - ent.pos

	dist := len_vec(&dir)

	dir = normalize_vec(&dir)

	ent.vel.y = -1.0
	z:_vec
	z.z = 1.0
	dir.y = 0.0
	cross := cross_vec(&dir, &globals.up)

	speed := 4.0
	if ent.on_ground
	{
		ent.vel.y = -0.0

		ang := angle_on_axis(&z, &dir, &globals.up)
		q :quaternion=euler_to_quaternion(270.0, radians_to_degree(ang), 0.0)

		ent.rot = q.v
		ent.forward = euler_to_quaternion(0.0, radians_to_degree(ang), 0.0) * z

		on ent.state
		{
		entity_state.GO_FORWARDS
		{
			target := player.pos - dir * 10.0

			dir = target - ent.pos

			d := dot_vec(&dir, &ent.forward)
			//printf("d {d}\n")
			//print_vec(&ent.forward)

			dist = len_vec(&dir)
			dir = normalize_vec(&dir)
			dir.y = 0.0
			if dist <  1.0
			{
				//printf("will go side\n")
				ent.state = entity_state.GO_SIDEWAYS
			}
			else
			{
				ent.vel = dir * speed
				ent.cl3d = ctx.skull_walk_forwards
			}
			if d > 0.0
			{
				ent.anim_mul = 1.0
			}
			else
			{
				ent.anim_mul = -1.0

			}
		}
		entity_state.GO_SIDEWAYS
		{
			if dist < 7.0 || dist > 12.0
			{
				ent.state = entity_state.GO_FORWARDS
			}
			else
			{
				ent.vel = cross * speed
				ent.cl3d = ctx.skull_walk_sideways
			}

		}
		}

	}
	//printf("dist {dist}\n")
	//print_vec(&ent.vel)
	//ent.on_ground = false
}
