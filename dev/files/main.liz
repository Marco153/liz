	{
		draw.texture_id = *ptr_offset(ctx.inv_texs.tex_idxs, 2, u32);
	}
	else
	{
		__dbg_break;
	}
	*/
	draw.pos.z = 0.5;
	draw.color = []f32{1.0, 1.0, 1.0, 1.0};
	Draw(ctx.window, &draw);
}

tst_st : struct
{
	val : u32,
	ar : dyn_array(cell)
	#serializable(val, ar)
}

has_blocks_left::fn(ar : *dyn_array(dyn_array(_vec)), y : *u64) ! bool
{
	*y = 0
	for ar_y in* ar
	{
		if ar_y.count > 0
		{
			return true;
		}
		*y++;
	}
	return false;
}
below_block_is_contiguous::fn(blocks_grid : *dyn_array(dyn_array(_vec)), cur : *_vec, str : str_lit, grid_width : u32, out_idx_on_same_x : *u64) ! bool
{
	if cast(u32)cur.y < cast(u32)(blocks_grid.count - 1) &&
		*level_str_offset(str, cast(u32)cur.x, cast(u32)cur.y, grid_width) == '-
	{
		row := blocks_grid[cast(u64)cast(u32)cur.y]
		if row.count == 0
		{
			return false
		}
		i :u64
		while (row[i].x - cur.x) < 0.1
		{
			i++
		}
		*out_idx_on_same_x = i
		return true;
	}

	return false;
}
level_str_offset::fn(str: str_lit, x : u32, y : u32, width: u32) ! *char
{
	// y * 2 accounts for \n\r
	return str[cast(u64)(2 + x + y * width + y * 2)]
}
create_map_from_str::fn(ctx : *context, str : str_lit, final_t : *_vec)
{
	width : u32
	i : u32
	len := str_ln(str)
	while (*str[width + 2] != '\n && *str[width + 2] != '\r)
	{
		width++
	}

	height :u64
	i = 2
	while i < cast(u32)len
	{
		if *str[i] == '\n
		{
			height++
		}
		i++
	}
	height++
	i = 0

	// subing 2 because the first character is a new line


	blocks_grid : dyn_array(dyn_array(_vec))
	wp : waypoint


	for y in 0..height
	{
		cur_ar : dyn_array(_vec)
		dyn_init2(&cur_ar, width, ctx.alloc)
		for x in 0..width
		{
			fx := cast(f32)x
			fy := cast(f32)(height - cast(u64)y)
			ch := *level_str_offset(str, cast(u32)x, cast(u32)y, width)
			if ch == '-
			{
				last_on_x := cast(u64)x >= (width - 1)
				last_on_y := cast(u64)y >= (height - 1)
				first_on_x := x == 0
				first_on_y := y == 0

				if !last_on_x && !last_on_y  && !first_on_x && !first_on_y
				{
					prev_x := *level_str_offset(str, cast(u32)x - 1, cast(u32)y, width)
					next_x := *level_str_offset(str, cast(u32)x + 1, cast(u32)y, width)

					prev_y := *level_str_offset(str, cast(u32)x, cast(u32)y - 1, width)
					next_y := *level_str_offset(str, cast(u32)x, cast(u32)y + 1, width)

					if prev_x == '- && next_x == '- && prev_y == '- && next_y == 'n
					{
						continue
					}
				}
				v :_vec
				v.x = fx
				v.y = fy
				v.z = 0.1
				dyn_add(&cur_ar, &v)

			}
			else if ch == 'p
			{
				ctx.player.pos.x = fx
				ctx.player.pos.y = fy
				ctx.player.pos.z = 0.1
				ctx.player.pos.w = 0.0
				dyn_add(&ctx.drawable_ents, ctx.player)
			}
			else if ch == 't
			{
				final_t.x = fx
				final_t.y = fy
				final_t.z = 0.0
				final_t.w = 0.0
			}
			else if ch == 'w
			{
				wp.pos.x = fx + 0.5
				wp.pos.y = fy + 0.5

				dyn_add(&ctx.waypoints, &wp)
			}
		}
		dyn_add(&blocks_grid, &cur_ar)
	}

	y : u64
	while has_blocks_left(&blocks_grid, &y)
	{
		row_ar := blocks_grid[y]
		start_pos :_vec= *row_ar[0]

		
		next_is_contiguous := false

		contiguous_width := 0

		cur_b :u64=1
		cur_prev := start_pos
		if row_ar.count > 1
		{

			while cur_b < row_ar.count && (row_ar[cur_b].x - cur_prev.x) < 1.1
			{
				next_is_contiguous = true
				cur_prev = *row_ar[cur_b]
				cur_b++
			}
		}


		sz :_vec
		sz.x = 1.0
		sz.y = 1.0
		if next_is_contiguous
		{
			sz.x = cast(f32)cur_b
			while cur_b > 0
			{
				dyn_rem(row_ar, 0)
				cur_b--
			}
		}
		else
		{
			down_is_contiguous := false

			cur_downwards_idx := y

			if y < (blocks_grid.count - 1)
			{
				next_row := blocks_grid[cur_downwards_idx + 1]
				out_below_block_idx : u64
				while below_block_is_contiguous(&blocks_grid, &cur_prev, str, width, &out_below_block_idx)
				{
					cur_prev = *next_row[out_below_block_idx]
					dyn_rem(next_row, cast(u32)out_below_block_idx)

					cur_downwards_idx++

					next_row = blocks_grid[cur_downwards_idx]
				}

			}
			else
			{
				idx_block_to_remove :u32
				for b in *row_ar
				{
					if (b.x - start_pos.x) < 0.1
					{
						break;
					}
					idx_block_to_remove++
				}
				ASSERT(idx_block_to_remove < cast(u32)row_ar.count)
				dyn_rem(row_ar, idx_block_to_remove)

				cur_downwards_idx++
			}
			block_height := cur_downwards_idx - y
			sz.y = cast(f32)block_height
		}
		ent := NewEnt(ctx, "block");
		ent.is_active = true;
		ent.pos = start_pos
		ent.pos.z = 0.1
		ent.col_size = sz
		//ent.col_size.y = 1.0
		ent.size = ent.col_size
		ent.is_static = true;
		ent.color.w = 1.0
		dyn_add(&ctx.drawable_ents, &ent);
		add_body(ctx, ent);

		block_width := 1
	}

	for cur_w in ctx.waypoints
	{
		for aux_w in ctx.waypoints
		{
			if aux_w == cur_w
			{
				continue;
			}
			col : collision
			if !Raycast(ctx, &cur_w.pos, &aux_w.pos, &col, LAYER_TRIGGER | LAYER_PLAYER, nil)
			{
				dyn_add(&cur_w.neighbors, aux_w)
			}
		}
	}
}
head_long_term_meeting_diff::fn(ctx : *context, t : *thinking, out : *f32) ! bool
{
	head:*long_term_action = t.long_term_acts[0]
	if *head == long_term_action.MEETING_AT
	{
		*out = head.MEETING_AT.hour - ctx.time_since_start
		return true
	}

	return false
}
add_long_term::fn(t : *thinking, r : *long_term_action)
{
	dyn_add(&t.long_term_acts, r)
}
add_mid_term::fn(t : *thinking, r : *rated_stuff(mid_term_action))
{
	lesser_idx : u32

	for cur_r in t.mid_term_acts
	{
		if r.val > cur_r.val 
		{
			break
		}
		lesser_idx++
	}

	if cast(u64)lesser_idx >= t.mid_term_acts.count
	{
		dyn_add(&t.mid_term_acts, r)
	}
	else
	{
		dyn_add_at(&t.mid_term_acts, lesser_idx, r)
	}
}
has_mid_term::fn(t : *thinking, type : u32) !bool
{
	for m in t.mid_term_acts
	{
		if cast(u32)m.type == type
		{
			return true
		}
	}
	return false
}

check_mid_term_adding::fn(ctx : *context, e : *entity, dt  : *f32)
{
	t : *thinking= e.thoughts
	mid := &t.mid_term_acts
	diff : f32

	no_short_terms := t.short_term_acts.count == 0

	if no_short_terms 
		&& head_long_term_meeting_diff(ctx, t, &diff) 
		&& diff > -20.0
		&& !has_mid_term(t, cast(u32)mid_term_action.TEST)
	{
		r : rated_stuff(mid_term_action)
		r.val = 10.0
		r.type.type = mid_term_action.TEST
		r.type.TEST.secs = 5.0
		add_mid_term(t, &r)
	}
}
mid_term::fn(ctx : *context, e : *entity, dt  : *f32)
{
	t : *thinking= e.thoughts

	if t.mid_term_acts.count == 0
	{
		return;
	}
	head_r:*rated_stuff(mid_term_action) = t.mid_term_acts[0]
	head :*mid_term_action= &head_r.type

	if *head == mid_term_action.TEST
	{
		if head.TEST.frames % 30 == 0
		{
			r : short_term_action
			r.type = short_term_action.SAY
			r.SAY.str = "hello"
			dyn_add(&t.short_term_acts, &r)
		}
		head.TEST.cur += *dt
		head.TEST.frames++

		if head.TEST.cur >= head.TEST.secs
		{
			dyn_rem(&t.mid_term_acts, 0)
		}
	}
	else if *head == mid_term_action.MEETING_AT 
	{
		if !head_r.in_curse
		{
			long_t := t.long_term_acts[cast(u64)head.MEETING_AT.long_term]

			go_path : short_term_action
			go_path.type = short_term_action.GO_PATH

			closest_wp := get_closest_waypoint(&ctx.waypoints, &e.pos)
			ASSERT(closest_wp)
			
			find_wpath(ctx, closest_wp, &long_t.MEETING_AT.pos, &go_path.GO_PATH.path)

			dyn_clear(&t.short_term_acts)
			
			dyn_add(&t.short_term_acts, &go_path)
			head_r.in_curse = true
		}
	}
}
set_vel_dir_ret_dist::fn(vel : *_vec, start : *_vec, end : *_vec, vel_mul : f32, normal : *_vec) ! f32
{
	dir := (*end - *start)
	dist := dot_vec(&dir, &dir)
	dir = normalize_vec(&dir)

	*vel = dir * vel_mul
	if normal
	{
		normal.x = dir.y
		normal.y = -dir.x
	}
	return dist
}
short_term::fn(ctx : *context, e : *entity, dt  : *f32)
{
	t : *thinking= e.thoughts

	if t.short_term_acts.count == 0
	{
		return 
	}
	head:*short_term_action = dyn_last(&t.short_term_acts)

	if *head == short_term_action.SAY
	{
		printf(head.SAY.str)
		dyn_rem(&t.short_term_acts, 0)
	}
	else if *head == short_term_action.GO_TO
	{
		normal :_vec
		dir := (head.GO_TO.pos - e.pos)
		dist := dot_vec(&dir, &dir)
		dir = normalize_vec(&dir)

		e.vel = dir
		normal.x = dir.y
		normal.y = -dir.x

		left_ray_start:= e.pos + normal * 0.5
		right_ray_start:= e.pos + normal * -0.5
		left_ray_end:= left_ray_start + dir * 1.5
		right_ray_end:= right_ray_start + dir * 1.5

			/*
		draw:draw_info

		draw.pos.x = left_ray_start.x
		draw.pos.y = left_ray_start.y
		draw.pos.z = left_ray_end.x
		draw.pos.w = left_ray_end.y
		draw.flags = DRAW_INFO_LINE
		*draw.color[1] = 1.0
		*draw.color[3] = 1.0
		draw.cam_pos = ctx.cam_pos_global;
		draw.cam_size = ctx.cam_size;
		Draw(ctx.window, &draw)

		head.GO_TO.frames++

		if (head.GO_TO.frames % 15) == 0
		{
			head.GO_TO.flags = 0


			col : collision
			out : *entity
			if Raycast(ctx, &left_ray_start, &left_ray_end, &col, LAYER_PLAYER | LAYER_TRIGGER, &out)
			{
				head.GO_TO.flags = 1
				printf("left ent name %\n", col.ent.name)
			}
			else if Raycast(ctx, &right_ray_start, &right_ray_end, &col, LAYER_PLAYER | LAYER_TRIGGER, &out)
			{
				head.GO_TO.flags = 2
				printf("right ent name %\n", col.ent.name)
			}

			surface_dir: _vec
			surface_dir.x = col.normal.y
			surface_dir.y = col.normal.x
			// left ray col
			if head.GO_TO.flags == 1
			{
				if dot_vec(&surface_dir, &dir) < 0.0
				{
					surface_dir = surface_dir * -1.0
				}
			}
			// right ray col
			else if head.GO_TO.flags == 1
			{
				if dot_vec(&surface_dir, &dir) > 0.0
				{
					surface_dir = surface_dir * -1.0
				}
			}


			head.GO_TO.x_vel_when_ray_col = cast(s8)cast(s32)(surface_dir.x * 128.0)
			head.GO_TO.y_vel_when_ray_col = cast(s8)cast(s32)(surface_dir.y * 128.0)
		}
		if head.GO_TO.flags != 0
		{
			x := (cast(f32)cast(s32)head.GO_TO.x_vel_when_ray_col) / 128.0
			y := (cast(f32)cast(s32)head.GO_TO.y_vel_when_ray_col) / 128.0

			e.vel.x = x
			e.vel.y = y
		}
		*/
		//else
		//{
			e.vel = dir
			if dist < 0.01
			{
				t.short_term_acts.count--
			}
		//}

	}
	else if *head == short_term_action.GO_PATH
	{
		last := head.GO_PATH.path.count - 1
		cur := head.GO_PATH.cur_path
		pos := head.GO_PATH.path[last - cur]

		head.GO_PATH.cur_path++

		if cur > cast(u32)last
		{
			dyn_rem(&t.short_term_acts, 0)
		}
		else
		{
			r : short_term_action
			r.type = short_term_action.GO_TO
			r.GO_TO.pos = *pos
			dyn_add(&t.short_term_acts, &r)
		}
	}
	else
	{
		__dbg_break
	}
	i := 0

}
long_term::fn(ctx : *context, e : *entity, dt  : *f32)
{
	t : *thinking= e.thoughts

	if t.long_term_acts.count == 0
	{
		return;
	}
	head:*long_term_action = t.long_term_acts[0]
	if *head == long_term_action.MEETING_AT
	{
		diff := head.MEETING_AT.hour - ctx.time_since_start
		if diff < 0.0
		{
			//__dbg_break
			if t.short_term_acts.count == 0 && !has_mid_term(t, cast(u32)mid_term_action.MEETING_AT)
			{
				r : rated_stuff(mid_term_action)
				r.type.type = mid_term_action.MEETING_AT
				r.type.MEETING_AT.long_term = 0
				r.val = 40.0
				
				add_mid_term(t, &r)
			}
			diff = 0.0
		}
	}
	else
	{
		__dbg_break
	}
}
thinking_ents::fn(ctx : *context, dt  : *f32)
{
	for e in ctx.ents_think
	{
		t: *thinking = e.thoughts
		long_term(ctx, *e, dt)
		if t.check_mid_term
		{
			check_mid_term_adding(ctx, *e, dt)
			t.check_mid_term = false
		}
		mid_term(ctx, *e, dt)
		short_term(ctx, *e, dt);
	}
}
new_thinking::fn(ctx : *context, e : *entity)
{
	e.thoughts = cast(*thinking)heap_alloc(globals.alloc, sizeof(thinking))
	dyn_add(&ctx.ents_think, e)

}

draw_vertex ::fn(ctx : *context, pos : *_vec, sz : *_vec, cam_pos : *_vec, cam_rot : *_vec)
{
	draw : draw_info3d
	//draw.flags = DRAW_INFO_DBG_BREAK
	draw.pos = *pos
	draw.rot.w = 1.0
	draw.ent_size = *sz
	*draw.color[0] = 1.0
	*draw.color[1] = 1.0
	*draw.color[2] = 1.0
	*draw.color[3] = 1.0
	draw.cam_pos = cam_pos;
	draw.cam_rot = cam_rot;
	//draw.cam_forward = ctx.cam_aux_forward_global;
	Draw3D(ctx.window, &draw)
}
DRAW_TRI_TRANSPARENY :const s32= 1

draw_tri::fn(ctx : *context, v1 : *_vec, v2 : *_vec, _v3 : *_vec, col : *_vec, flags : u32)
{
	draw : draw_info3d
	draw.flags = DRAW_INFO_TRIANGLE

	if is_flag_on(flags, DRAW_TRI_TRANSPARENY)
		draw.flags = draw.flags | DRAW_INFO_TRANSPARENT
	draw.pos = *_v3
	draw.pivot = *v2
	draw.ent_size = *v1
	memcpy(draw.color[0], col, 16)
	
	draw.cam_pos = ctx.cam_pos_global
	draw.cam_rot = ctx.cam_rot_global
	draw.cam_forward = ctx.cam_forward_global
	Draw3D(ctx.window, &draw)

}
DRAW_LINE_TIP :const s32= 1
DRAW_LINE_NO_PROJ :const s32= 2
draw_line::fn(ctx : *context, start : *_vec, end : *_vec, col : *_vec, flags : u32)
{
	draw : draw_info3d
	draw.flags =  DRAW_INFO_LINE;
	draw.pos = *start
	draw.ent_size = *end
	memcpy(draw.color, col, 4 * 4);
	draw.cam_pos = ctx.cam_pos_global;
	draw.cam_rot = ctx.cam_rot_global;
	draw.cam_forward = ctx.cam_forward_global;
	if is_flag_on(flags, DRAW_LINE_NO_PROJ)
	{
		draw.flags = draw.flags | DRAW_INFO_NO_PROJ

	}
	Draw3D(ctx.window, &draw)
	if is_flag_on(flags, DRAW_LINE_TIP)
	{
		v_sz: _vec=?
		v_sz.x = 0.05
		v_sz.y = 0.05
		v_sz.z = 0.05
		v_sz.w = 1.0
		draw_vertex(ctx, end, &v_sz, ctx.cam_pos_global, ctx.cam_rot_global)
	}

}

cam_mov_editor::fn(ctx : *context, mx : f32, my : f32)
{
	axis : _vec
	axis.z = 0.0
	axis.x = 0.0
	axis.y = 1.0
	aux_forward := ctx.cam_aux_forward_global
	cam_forward := ctx.cam_forward_global
	cam_pos := ctx.cam_pos_global
	cam_rot := ctx.cam_rot_global

	speed := 10.0
	dt := 0.017

	if IsKeyHeld(key_enum.KEY_SHIFT)
	{

		speed = speed * 4.0
	}


	if IsKeyHeld(key_enum.KEY_E)
	{
		cam_pos.y += dt * speed
	}
	if IsKeyHeld(key_enum.KEY_Q)
	{
		cam_pos.y -= dt * speed
	}
	if IsKeyDown(key_enum.KEY_F2)
	{
		globals.tog = !globals.tog
	}
	cross := cross_vec(cam_forward, &axis)

	axis = cross * radians_to_degree(cam_rot.x)
	aux_rot := euler_to_quaternion(axis.x , axis.y, axis.z)
	
	axis.x = 0.0
	axis.y = 1.0
	axis.z = 0.0
	axis = cross * radians_to_degree(cam_rot.y)
	//aux_rot = aux_rot * euler_to_quaternion(axis.x , axis.y, axis.z)

	actual_forward := aux_rot * *cam_forward
	if IsKeyHeld(key_enum.KEY_A)
	{
		*cam_pos -= cross * dt * speed

	}
	if IsKeyHeld(key_enum.KEY_D)
	{
		*cam_pos += cross * dt * speed
	}
	if IsKeyHeld(key_enum.KEY_W)
	{
		*cam_pos += actual_forward * dt * speed
	}
	if IsKeyHeld(key_enum.KEY_S)
	{
		*cam_pos -= actual_forward * dt * speed
	}
	


	if IsMouseHeld(mouse_enum.RIGHT)
	{
		*cam_forward = euler_to_quaternion(0.0, radians_to_degree(mx), 0.0) * *cam_forward

		cam_rot.y += mx
		cam_rot.x += my
	}
}
cam_mov::fn(ctx : *context)
{
	axis : _vec
	axis.z = 0.0
	axis.x = 0.0
	axis.y = 1.0
	aux_forward := ctx.cam_aux_forward_global
	cam_forward := ctx.cam_forward_global
	cam_pos := ctx.cam_pos_global
	cam_rot := ctx.cam_rot_global

	speed := 5.0
	dt := 0.017

	if IsKeyHeld(key_enum.KEY_Q)
	{
		cam_pos.y += dt * speed
	}
	if IsKeyHeld(key_enum.KEY_E)
	{
		cam_pos.y -= dt * speed
	}
	if IsKeyDown(key_enum.KEY_F2)
	{
		globals.tog = !globals.tog
	}
	cross := cross_vec(cam_forward, &axis)
	if IsKeyHeld(key_enum.KEY_A)
	{
		*cam_pos -= cross * dt * speed

	}
	if IsKeyHeld(key_enum.KEY_D)
	{
		*cam_pos += cross * dt * speed
	}
	if IsKeyHeld(key_enum.KEY_W)
	{
		*cam_pos += *cam_forward * dt * speed
	}
	if IsKeyHeld(key_enum.KEY_S)
	{
		*cam_pos -= *cam_forward * dt * speed
	}
	
	dt = dt * 2.0
	if IsKeyHeld(key_enum.KEY_SHIFT)
	{
		if IsMouseHeld(mouse_enum.LEFT)
		{
			*cam_forward = euler_to_quaternion(0.0, radians_to_degree(dt), 0.0) * *cam_forward

			cam_rot.y += dt
			//cam_rot.x += dt
		}
		if IsMouseHeld(mouse_enum.RIGHT)
		{
			*cam_forward = euler_to_quaternion(0.0, -radians_to_degree(dt), 0.0) * *cam_forward

			cam_rot.y -= dt
			//cam_rot.x += dt
		}
	}
	else if IsKeyHeld(key_enum.KEY_JMP)
	{

		if IsMouseHeld(mouse_enum.LEFT)
		{
			cam_rot.x += dt
		}
		if IsMouseHeld(mouse_enum.RIGHT)
		{
			cam_rot.x -= dt
		}
	}
}
_draw_col ::fn(ctx : *context, c : *collider)
{
	on c.type
	{
	SPHERE
	{
		vsz :_vec
		vsz.x = c.SPHERE.radius
		vsz.y = c.SPHERE.radius
		vsz.z = c.SPHERE.radius
		draw_vertex(ctx, &c.ent.pos, &vsz, ctx.cam_pos_global, ctx.cam_rot_global)
	}
	TRIANGLE
	{
		col : _vec
		col.x = 1.0
		_v1 :=*c.TRIANGLE.verts[0] 
		_v2 :=*c.TRIANGLE.verts[1] 
		_v3 :=*c.TRIANGLE.verts[2] 

		draw_line(ctx, &_v1, &_v2, &col, 0)
		draw_line(ctx, &_v2, &_v3, &col, 0)
		draw_line(ctx, &_v3, &_v1, &col, 0)

		nv1 := _v1 - c.TRIANGLE.normal
		nv2 := _v2 - c.TRIANGLE.normal
		nv3 := _v3 - c.TRIANGLE.normal

		draw_line(ctx, &nv1, &nv2, &col, 0)
		draw_line(ctx, &nv2, &nv3, &col, 0)
		draw_line(ctx, &nv3, &nv1, &col, 0)

		draw_line(ctx, &_v1, &nv1, &col, 0)
		draw_line(ctx, &_v2, &nv2, &col, 0)
		draw_line(ctx, &_v3, &nv3, &col, 0)
		
	}
	CUBE
	{
		col : _vec
		col.z = 1.0
		_v1 :=*c.CUBE.verts[0] 
		_v2 :=*c.CUBE.verts[1] 
		_v3 :=*c.CUBE.verts[2] 
		_v4 :=*c.CUBE.verts[3] 
		_v5 :=*c.CUBE.verts[4] 
		_v6 :=*c.CUBE.verts[5] 
		_v7 :=*c.CUBE.verts[6] 
		_v8 :=*c.CUBE.verts[7] 

		draw_line(ctx, &_v1, &_v2, &col, 0)
		draw_line(ctx, &_v2, &_v3, &col, 0)
		draw_line(ctx, &_v3, &_v4, &col, 0)
		draw_line(ctx, &_v4, &_v1, &col, 0)

		draw_line(ctx, &_v5, &_v6, &col, 0)
		draw_line(ctx, &_v6, &_v7, &col, 0)
		draw_line(ctx, &_v7, &_v8, &col, 0)
		draw_line(ctx, &_v8, &_v5, &col, 0)
	}
	}
}
VIEW_COL_METHOD:const s32= 0
draw_aabb::fn(ctx : *context, _min : *_vec, _max : *_vec)
{
	_v1 := *_min
	_v2 := *_max
	_v3 := *_min
	_v4 := *_max

	_v3.y = _max.y
	_v4.y = _min.y

	_v1.z = _v1.y
	_v1.y = 0.0

	_v2.z = _v2.y
	_v2.y = 0.0

	_v3.z = _v3.y
	_v3.y = 0.0

	_v4.z = _v4.y
	_v4.y = 0.0

	col : _vec
	col.x = 1.0
	col.y = 1.0
	col.z = 1.0
	draw_line(ctx, &_v1, &_v2, &col, 0);
	draw_line(ctx, &_v2, &_v3, &col, 0);
	draw_line(ctx, &_v3, &_v4, &col, 0);
	draw_line(ctx, &_v4, &_v1, &col, 0);
}
view_collision ::fn(ccc : u32)
{
	curmx := GetMouseNormalizedPosX();
	curmy := GetMouseNormalizedPosY();



	ctx := cast(*context)globals.ctx
	gjk := cast(*gjk_state)globals.gjk
	if gjk == nil && VIEW_COL_METHOD != 2
		return;
	ClearBackground(0.7, 0.7, 0.7);

	cam_pos := ctx.cam_pos_global
	cam_rot := ctx.cam_rot_global

	e1 := gjk.col1.ent
	e2 := gjk.col2.ent
	mx := &globals.mx
	my := &globals.my
	dt := 0.017
	mvx := GetMouseVelX() * dt
	mvy := GetMouseVelY() * dt
	cam_mov_editor(ctx, mvx, mvy)
	//cam_mov(ctx)

	//printf("curx %, mx %\n", cast(s32)(curmx * 100.0), cast(s32)(*mx * 100.0))


	*mx = GetMouseNormalizedPosX() - curmx;
	*my = GetMouseNormalizedPosY() - curmy;

	//printf("addr %, act2 %\n", cast(u32)cast(s64)e1, cast(s32)(e1.is_active))
	if e1 
	{
		e1.color.w = 0.5;
		e1.flags = e1.flags | ENTITY_TRANSPARENT;
		//DrawEntity(ctx, e1, cam_pos, cam_rot)
	}
	else
	{
		e1 = ctx.player
		e1.color.w = 0.5;
		e1.flags = e1.flags | ENTITY_TRANSPARENT;
		//DrawEntity(ctx, e1, cam_pos, cam_rot)
	}
	if e2
	{
		e2.color.w = 0.5;
		e2.flags = e2.flags | ENTITY_TRANSPARENT;
		//DrawEntity(ctx, e2, cam_pos, cam_rot)

	}

	orig : _vec
	col : _vec
	col.x = 1.0
	col.y = 0.0
	col.z = 0.0
	col.w = 1.0

	x_axis_start: _vec= _vec{-100.0, 0.0, 0.0, 0.0}
	x_axis_end: _vec= _vec{100.0, 0.0, 0.0, 0.0}
	z_axis_start: _vec= _vec{0.0, 0.0, -100.0, 0.0}
	z_axis_end: _vec= _vec{0.0, 0.0, 100.0, 0.0}
	draw_line(ctx, &x_axis_start, &x_axis_end, &col, 0)
	
	col.x = 0.0
	col.y = 0.0
	col.z = 1.0
	col.w = 1.0
	draw_line(ctx, &z_axis_start, &z_axis_end, &col, 0)

	v_sz: _vec=?
	v_sz.x = 0.1
	v_sz.y = 0.1
	v_sz.z = 0.1
	v_sz.w = 1.0

	globals.temp_alloc.cur = 0

	c1 := cast(*collider)e1.col
	c2 := cast(*collider)e2.col

	#if VIEW_COL_METHOD == 0
	{
		target_face :u64= gjk.closest_face
		if IsKeyHeld(key_enum.KEY_1) && c2.type == col_type.CUBE
		{
			t:u64
			while t < 30
			{
				t1 := cast(u64)*globals.cube_tris[t]
				t2 := cast(u64)*globals.cube_tris[t + 1]
				t3 := cast(u64)*globals.cube_tris[t + 2]
				_v1 := *c2.CUBE.verts[t1]
				_v2 := *c2.CUBE.verts[t2]
				_v3 := *c2.CUBE.verts[t3]

				draw_tri(ctx, &_v3, &_v2, &_v1, &col, 0)
				//print_vec(&_v1)
				t+= 3
			}
		}
		if IsKeyHeld(key_enum.KEY_2)
		{
			target_face = gjk.cur_face_facing_point;

			//__dbg_break
			draw_vertex(ctx, &gjk.epa_new_sup, &v_sz, cam_pos, cam_rot)
		}
		if IsKeyHeld(key_enum.KEY_3)
		{
			for i in 0..16
			{
				draw_vertex(ctx, gjk.mink_diff[cast(u64)i], &v_sz, cam_pos, cam_rot)
			}
			
		}
		if IsKeyHeld(key_enum.KEY_4)
		{
			for i in 0..gjk.num_loose_edges
			{
				draw_vertex(ctx, gjk.epa_loose_edges[cast(u64)i][0], &v_sz, cam_pos, cam_rot)
				draw_vertex(ctx, gjk.epa_loose_edges[cast(u64)i][1], &v_sz, cam_pos, cam_rot)
			}
			
		}
		for i2 in 0..gjk.num_faces
		{
			i := cast(u64)i2
			_v1 := *gjk.epa_faces[i][0]
			_v2 := *gjk.epa_faces[i][1]
			_v3 := *gjk.epa_faces[i][2]
			n := gjk.epa_faces[i][3]
			//printf("\ni % ", i)
			//printf("\n")

			
			col.x = 0.4
			col.y = 0.4
			col.z = 0.4
			col.w = 1.0
			if i == target_face
			{
				col.x = 0.0
				col.y = 0.0
				col.z = 0.0
				col.w = 1.0
				//printf("g2 %\n", cast(u32)gjk_state.cur_face_facing_point)
			}
			else
			{
				col = *n
				col.x = (col.x + 1.0) *0.5
				col.y = (col.y + 1.0) *0.5
				col.z = (col.z + 1.0) *0.5
			}
			flags :u32= 0
			if IsKeyHeld(key_enum.KEY_1)
			{
				_v1 = *gjk.epa_faces[i][2]
				_v2 = *gjk.epa_faces[i][1]
				_v3 = *gjk.epa_faces[i][0]
				
			}
			draw_tri(ctx, &_v1, &_v2, &_v3, &col, flags)
		}

	}
	else if VIEW_COL_METHOD == 1
	{
		if IsKeyHeld(key_enum.KEY_JMP)
		{
			_draw_col(ctx, gjk.col2)
			_draw_col(ctx, gjk.col1)

			if e2.type == ent_type.TERRAIN
			{

				trn :*terrain_info=e2.terrain
				t :u64=0
				mesh := trn.meshes[0]
				tris := &trn.tris
				
				while t < tris.count
				{
					t1 := cast(u64)*tris[t]
					t2 := cast(u64)*tris[t + 1]
					t3 := cast(u64)*tris[t + 2]

					_v1_start := mesh.verts[t1 * 3]
					_v2_start := mesh.verts[t2 * 3]
					_v3_start := mesh.verts[t3 * 3]

					_v1 :_vec=?
					_v1.w = 0.0

					_v2 :_vec=?
					_v2.w = 0.0

					_v3 :_vec=?
					_v3.w = 0.0
					
					memcpy(&_v1, _v1_start, 3 * 4)
					memcpy(&_v2, _v2_start, 3 * 4)
					memcpy(&_v3, _v3_start, 3 * 4)

					_v1 += e2.pos
					_v2 += e2.pos
					_v3 += e2.pos

					draw_tri(ctx, &_v3, &_v2, &_v1, &col, 0)

					t += 3
				}
			}
		}

		draw_vertex(
			ctx, 
			&gjk.sup1, &v_sz, cam_pos, cam_rot)
		draw_vertex(ctx, &gjk.sup2, &v_sz, cam_pos, cam_rot)

		draw_line(ctx, &gjk.sup1, &gjk.sup2, &v_sz, DRAW_LINE_TIP);

		simplex_col : _vec
		simplex_col.x = 1.0
		simplex_col.y = 1.0
		simplex_col.z = 1.0
		draw_line(ctx, &orig, &gjk.dir, &simplex_col, DRAW_LINE_TIP);
		simplex_col.y = 0.0
		simplex_col.z = 0.0

		start : _vec= ?
		end : _vec= ?
		cross : _vec= ?
		if IsKeyHeld(key_enum.KEY_1)
		{
			draw_vertex(ctx, &gjk.simplex[0], &v_sz, cam_pos, cam_rot)
		}
		if IsKeyHeld(key_enum.KEY_2)
		{
			draw_vertex(ctx, &gjk.simplex[1], &v_sz, cam_pos, cam_rot)
		}
		if IsKeyHeld(key_enum.KEY_3)
		{
			draw_vertex(ctx, &gjk.simplex[2], &v_sz, cam_pos, cam_rot)
		}
		if IsKeyHeld(key_enum.KEY_4)
		{
			draw_vertex(ctx, &gjk.simplex[3], &v_sz, cam_pos, cam_rot)
		}
		on gjk.simplex_verts
		{
		2
		{
			draw_line(ctx, gjk.simplex[0], gjk.simplex[1], &simplex_col, DRAW_LINE_TIP);

			if IsKeyHeld(key_enum.KEY_F1)
			{
				a := gjk.simplex[0]
				b := gjk.simplex[1]

				ab := *b - *a
				ao := -*a

				cross = cross_vec(&cross_vec(&ab, &ao), &ab)
				start = *a + ab / 2.0
				end = start + cross

				draw_line(ctx, &start, &end, &simplex_col, 0);

				if(same_direction(&ab, &ao))
				{
					printf("the same dir\n")
				}
				else
				{
					printf("not in the same dir\n")
				}
			}
		}
		3
		{

			draw_line(ctx, gjk.simplex[0], gjk.simplex[1], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[0], gjk.simplex[2], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[1], gjk.simplex[2], &simplex_col, 0);

			a := gjk.simplex[0]
			b := gjk.simplex[1]
			c := gjk.simplex[2]

			ab := *b - *a
			ac := *c - *a
			ao := -*a

			abc := cross_vec(&ab, &ac)
			cross = cross_vec(&abc, &ac)
			start = *a + ac / 2.0
			end = start + cross

			simplex_col.y = 1.0
			draw_line(ctx, &start, &end, &simplex_col, 0);

			if IsKeyHeld(key_enum.KEY_F1)
			{
				cross = cross_vec(&cross_vec(&ac, &ao), &ac)
				end = start + cross
				simplex_col.z = 1.0
				draw_line(ctx, a, &end, &simplex_col, 0);

				simplex_col.y = 0.5
				simplex_col.z = 0.5
				draw_line(ctx, a, &(-*a), &simplex_col, 0);

				if same_direction(&ac, &ao)
				{
					printf("the same dir\n")
				}
				else
				{
					printf("not in the same dir\n")
				}
			}
		}
		4
		{
			draw_line(ctx, gjk.simplex[0], gjk.simplex[1], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[0], gjk.simplex[2], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[0], gjk.simplex[3], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[1], gjk.simplex[2], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[1], gjk.simplex[3], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[3], gjk.simplex[2], &simplex_col, 0);

		}
		}
		a := 0
	}
	else if VIEW_COL_METHOD == 2
	{

		trn :*terrain_info= globals.trn.terrain
		tpos := globals.trn.pos
		if globals.chunk
		{
			ch :*chunk_col_info= globals.chunk

			aux :*chunk_col_info
			if IsKeyHeld(key_enum.KEY_1)
			{
				//printf("curx {cast(s32)ch.pos_x}, cury {cast(s32)ch.pos_y}\n")
				aux = get_chunk_on_pos(trn, ch.left_neighbor)
				if aux != nil
				{
					ch = aux
				}
			}
			else if IsKeyHeld(key_enum.KEY_2)
			{
				aux = get_chunk_on_pos(trn, ch.up_neighbor)
				if aux != nil
				{
					ch = aux
				}
			}
			else if IsKeyHeld(key_enum.KEY_3)
			{
				aux = get_chunk_on_pos(trn, ch.down_neighbor)
				if aux != nil
				{
					ch = aux
				}
			}
			else if IsKeyHeld(key_enum.KEY_4)
			{
				aux = get_chunk_on_pos(trn, ch.right_neighbor)
				if aux != nil
				{
					ch = aux
				}
			}
			info :verts_from_tri_info=?
			mesh :*mesh_info= trn.meshes[cast(u64)ch.verts_mesh_idx]
			tris := &ch.tris


			t :u64= 0
			while t < tris.count
			{
				info.t = t
				get_verts_pos_from_tris(&info, tris.data, mesh.verts.data, TERRAIN_VERTEX_SIZE)
				info.v1_out += tpos + mesh.pos
				info.v2_out += tpos + mesh.pos
				info.v3_out += tpos + mesh.pos

				draw_tri(ctx, &info.v3_out, &info.v2_out, &info.v1_out, &col, 0)

				t += 3
			}
		}
		else
		{
			if IsKeyHeld(key_enum.KEY_1)
			{
				DrawEntity(ctx, globals.trn, cam_pos, cam_rot)
			}
			draw_line(ctx, &globals.ray_origin, &globals.ray_end, &col, 0)
			draw_tri(ctx, &globals.tri_v3, &globals.tri_v2, &globals.tri_v1, &col, 0)

/*
			info :verts_from_tri_info=?
			for ch in ctx.terrain_chunks_to_col
			{
				mesh :*mesh_info= trn.meshes[cast(u64)ch.verts_mesh_idx]
				tris := &ch.tris


				t :u64= 0
				while t < tris.count
				{
					info.t = t
					get_verts_pos_from_tris(&info, tris.data, mesh.verts.data)
					info.v1_out += tpos + mesh.pos
					info.v2_out += tpos + mesh.pos
					info.v3_out += tpos + mesh.pos

					draw_tri(ctx, &info.v3_out, &info.v2_out, &info.v1_out, &col, 0)

					t += 3
				}
			}
			*/
		}
		/*
		DrawEntity(ctx, globals.trn, cam_pos, cam_rot)
		if IsKeyHeld(key_enum.KEY_1)
		{
			draw_aabb(ctx, &globals.aabb1_min, &globals.aabb1_max)
		}
		if IsKeyHeld(key_enum.KEY_2)
		{
			draw_aabb(ctx, &globals.aabb2_min, &globals.aabb2_max)
			
		}
		*/
		a :=0
	}
	else if VIEW_COL_METHOD == 3
	{
	}



}
print_f32::fn(a : f32)
{
	printf("f %\n", cast(s32)(a * 100.0))
}
reset_jmp::fn(mov : *player_info)
{
	mov.jmp.vel.x = 0.0
	mov.jmp.vel.y = 0.0
	mov.jmp.vel.z = 0.0
	mov.jmp.time_off_ground = 0.0
	mov.jmp.jmpd = false
}

player_mov::fn(ctx : *context, aux_forward : *_vec, dt : *f32)
{
	//OpenLocalsWindow(__LINE__)
	player_ent := ctx.player
	forward := &player_ent.forward
	cross := cross_vec(&ctx.up, ctx.cam_forward_global)
	mov := player_ent.mov_info
	on_ground := player_ent.on_ground
	grav := &mov.gravity_vel
	//printf("down col {cast(u32)mov.down_col}, up col {cast(u32)mov.up_col}\n")
	if mov.up_col == false && mov.down_col
	{
	}

	if on_ground
	{
		grav.y = -0.05
		reset_jmp(mov)
	}
	else
	{
		mov.jmp.time_off_ground += *dt
		if IsKeyUp(key_enum.KEY_JMP) && mov.jmp.time_off_ground < 0.15
		{
			mov.jmp.vel.y = 0.0
		}
		grav.y += -15.0 * *dt
		//grav.y = -1.0
	}

	mov_pressed := false
	
	dont_change_forward_based_on_cam := false

	if IsKeyHeld(key_enum.KEY_W)
	{
		mov.v += *dt *10.0
		mov_pressed = true
	}
	else if IsKeyHeld(key_enum.KEY_S)
	{
		mov.v -= *dt * 10.0
		mov_pressed = true
	}
	else
	{
		mov.v += -mov.v * *dt * 10.0
	}


	if IsKeyHeld(key_enum.KEY_A)
	{
		mov.h += *dt * 10.0
		mov_pressed = true
	}
	else if IsKeyHeld(key_enum.KEY_D)
	{
		mov.h -= *dt * 10.0
		mov_pressed = true
	}
	else
	{
		mov.h += -mov.h * *dt * 10.0
	}

	mov.v = clamp(mov.v, -1.0, 1.0)
	mov.h = clamp(mov.h, -1.0, 1.0)

	ab := (absf(mov.v) + absf(mov.h))
	weight := clamp(ab - 1.0, 0.0, 1.0) + 1.0
	actual_forward := *ctx.cam_forward_global * mov.v + cross * mov.h
	actual_forward = actual_forward / weight
	if mov.on_getting_to_back_pos
	{
		actual_forward.x = 0.0
		actual_forward.y = 0.0
		actual_forward.z = 0.0
	}

	on player_ent.state
	{
	entity_state.ON_WALL
	{
		cross = cross_vec(&ctx.up, &player_ent.normal_col)
		d := dot_vec(&cross, &player_ent.vel)

		player_ent.vel.x = 0.0
		player_ent.vel.z = 0.0
		player_ent.vel.y = -0.5
		if IsKeyDown(key_enum.KEY_JMP) && !mov.exhausted
		{
			grav.y = 0.0
			mov.jmp.vel = *ctx.cam_forward_global * 5.0 + ctx.up * 6.0
			player_ent.state = entity_state.IDLE

			mov.stamina -= 0.2
		}
		if on_ground
		{
			player_ent.state = entity_state.IDLE
		}
	}
	entity_state.SLERP
	{
		player_ent.is_trigger = true
		mov.slerp_timer += *dt
		maxt := 0.2
		if mov.slerp_timer > maxt
		{
			player_ent.pos = mov.slerp_end
			player_ent.state = entity_state.IDLE
			player_ent.is_trigger = false
		}
		dir := mov.slerp_end - mov.slerp_start

		p := mov.slerp_timer / maxt
		player_ent.pos = mov.slerp_start + (dir * p)

	}
	entity_state.IDLE
	{
		mov.platform_vel += -mov.platform_vel * *dt * 2.0
		player_ent.color.x = 1.0
		player_ent.color.y = 0.0
		player_ent.color.z = 0.0
		speed := mov.speed

		trying_to_run := false
		if IsKeyHeld(key_enum.KEY_SHIFT)
		{
			trying_to_run = true
			if !mov.exhausted
			{
				speed = speed * 1.8
			}
		}
		if IsKeyDown(key_enum.KEY_JMP) && (on_ground && mov.jmp.time_off_ground == 0.0 || mov.jmp.time_off_ground <= 0.5)
			&& !mov.jmp.jmpd
		{
			if !mov.exhausted
			{
				player_ent.vel.y = 0.0
				mov.jmp.vel.y = 1.0 * mov.jmp.speed
				mov.jmp.jmpd = true
				player_ent.on_ground = false

				mov.stamina -= 0.05

			}
		}

		if mov.stamina < 0.01
		{
			mov.exhausted = true
		}

		if mov.exhausted && mov.stamina > 0.3
		{
			mov.exhausted = false
		}

		if ab < 0.01 && on_ground
		{
			mov.stamina += *dt * mov.stamina_recover_rate
		}

		if mov.exhausted
		{
			if trying_to_run
			{
				speed = speed * 0.8
				mov.stamina_temp_max -= speed * *dt * mov.stamina_decrease_rate * 0.1
			}
			else
			{
				speed = speed * 0.5
			}
		}
		else
		{
			decrease_vel := speed * *dt * mov.stamina_decrease_rate
			if trying_to_run
			{
				decrease_vel = decrease_vel * 2.0
			}

			if ab > 0.5
			{
				mov.stamina -= decrease_vel
				mov.stamina_temp_max -= decrease_vel * 0.03
			}
		}



		mov.stamina = clamp(mov.stamina, 0.0, mov.stamina_temp_max)

		player_ent.vel = actual_forward * speed + *grav
		player_ent.vel += mov.jmp.vel; // + mov.platform_vel
		if dot_vec(&actual_forward, &actual_forward) > 0.01 && !mov.on_rotating_cam
		{
			*forward = normalize_vec(&actual_forward)
		}

		if IsMouseDown(mouse_enum.LEFT)
		{
			cam_rot := *ctx.cam_rot_global
			cam_pos := *ctx.cam_pos_global
			b := get_bullet(ctx)
			b.col_enter = bullet_collision_enter
			b.ignore_collision_with_layers = LAYER_PLAYER
			b.tex_id = ctx.ball_tex
			b.pos = cam_pos
			dir := euler_to_quaternion(radians_to_degree(cam_rot.x), radians_to_degree(cam_rot.y), 0.0) * *ctx.cam_aux_forward_global
			b.size.x = 0.2
			b.size.y = 0.2
			b.col_size = b.size

			b.is_active = true
			b.vel = dir * 40.0
		}

		
		ang := angle_on_axis(aux_forward, forward, &ctx.up)
		player_ent.rot = euler_to_quaternion(0.0, radians_to_degree(-ang), 0.0).v

		if IsKeyDown(key_enum.KEY_ACT1) && !on_ground
		{
			player_ent.state = entity_state.SURF
		}
		d_up := dot_vec(&player_ent.normal_col, &ctx.up)
		if IsMouseDown(mouse_enum.RIGHT) && mov.col_in_stay && absf(d_up) < 0.1 && !on_ground
		{
			player_ent.state = entity_state.ON_WALL
		}
		if IsKeyDown(key_enum.KEY_JMP) && mov.down_col && mov.up_col==false
		{
			//__dbg_break
			ASSERT(mov.ent_col)
			c1 := cast(*collider)player_ent.col
			ASSERT(c1.type == col_type.CAPSULE)
			r := c1.CAPSULE.radius
			c1.pos = player_ent.pos
			c1.pos += player_ent.forward *r * 2.0 + ctx.up * 1.4
			c2 := cast(*collider)mov.ent_col.col
			c2.type = col_type.CUBE
			c2.pos = mov.ent_col.pos
			c2.ent = mov.ent_col
			CopyVerts(c2)
			gjk := ctx.gjk

			if GJK(gjk, c1, c2)
			{
				//__dbg_break
				col : collision
				
				mtv := EPA(gjk, gjk.simplex[0], gjk.simplex[1], gjk.simplex[2], gjk.simplex[3], c1, c2, &col)
				
				col.normal = col.normal * -1.0
				mov.slerp_end = c1.pos
			}
			else
			{
				mov.slerp_end = c1.pos
			}

			mov.slerp_timer = 0.0
			mov.slerp_start = player_ent.pos
			player_ent.state = entity_state.SLERP
			player_ent.vel.x = 0.0
			player_ent.vel.y = 0.0
			player_ent.vel.z = 0.0
		}
	}
	entity_state.SURF
	{
		if on_ground
		{
			grav.y = -4.0

			cross_right := cross_vec(&ctx.up, &player_ent.normal_col)
			ground_dir := cross_vec(&cross_right, &player_ent.normal_col)
			ground_dir = normalize_vec(&ground_dir)
			d := dot_vec(&player_ent.forward, &ground_dir)

			rot_vel := mov.h * *dt * 2.0

			ground_steep := dot_vec(&mov.platform_vel, &player_ent.normal_col)
			if ground_steep < 0.0
			{
				mov.platform_vel += mov.platform_vel * *dt * ground_steep * 0.4
			}
			else
			{
				mov.platform_vel += player_ent.forward * *dt * 64.0 * ground_steep
			}

			fric_dot := dot_vec(&ctx.up, &player_ent.normal_col)

			mov.platform_vel += -player_ent.forward * *dt * fric_dot * 2.0
			
			if dot_vec(&mov.platform_vel, &player_ent.forward) < 0.0
			{
				up_dot := dot_vec(&ground_dir, &globals.up)
				final_vel := ground_dir - globals.up * up_dot
				final_vel = normalize_vec(&final_vel)

				player_ent.forward = final_vel
			}


			mov.platform_vel.x = clamp(mov.platform_vel.x, -20.0, 20.0)
			mov.platform_vel.y = clamp(mov.platform_vel.y, -20.0, 20.0)
			mov.platform_vel.z = clamp(mov.platform_vel.z, -20.0, 20.0)

			ang := angle_on_axis(&player_ent.forward, &mov.platform_vel, &ctx.up)
			mov.platform_vel = euler_to_quaternion(0.0, radians_to_degree(-ang), 0.0) * mov.platform_vel
		}

		player_ent.color.x = 1.0
		player_ent.color.y = 1.0
		player_ent.color.z = 0.0
		d := dot_vec(&player_ent.vel, &player_ent.forward)*0.1
		rot_vel := mov.h * *dt * d
		player_ent.forward = euler_to_quaternion(0.0, radians_to_degree(rot_vel), 0.0) * player_ent.forward

		player_ent.vel = mov.jmp.vel + mov.platform_vel
		player_ent.vel += *grav

		player_ent.rot.x = 0.0
		player_ent.rot.y = 0.0
		player_ent.rot.z = 0.0
		player_ent.rot.w = 1.0

		ang := angle_on_axis(aux_forward, forward, &ctx.up)
		axis_rot := euler_to_quaternion(0.0, radians_to_degree(-ang), 0.0).v
		aux :_vec= player_ent.rot

		multiply_quaternions(&player_ent.rot, &aux, &axis_rot)
		
		cross = cross_vec(&player_ent.forward, &player_ent.normal_col)

		ang = angle_on_axis(&ctx.up, &player_ent.normal_col, &cross) * 57.0
		cross = cross * -ang
		axis_rot = euler_to_quaternion(cross.x, cross.y , cross.z ).v
		aux = player_ent.rot
		multiply_quaternions(&player_ent.rot, &aux, &axis_rot)

		d = dot_vec(&mov.platform_vel, &mov.platform_vel)

		if d <= 10.0 && on_ground
		{
			player_ent.state = entity_state.IDLE
		}
		if IsKeyDown(key_enum.KEY_ACT1)
		{
			player_ent.state = entity_state.IDLE
		}
		
	}
	}
	player_ent.vel.x = clamp(player_ent.vel.x, -20.0, 20.0)
	player_ent.vel.y = clamp(player_ent.vel.y, -20.0, 20.0)
	player_ent.vel.z = clamp(player_ent.vel.z, -20.0, 20.0)




	ang := angle_on_axis(aux_forward, forward, &ctx.up)
	//player_ent.rot = euler_to_quaternion(0.0, radians_to_degree(-ang), 0.0).v
	player_ent.on_ground = false
	width := 4.0
	if player_ent.pos.y < mov.min_y_cam_pos || mov_pressed
	{
		mov.min_y_cam_pos = player_ent.pos.y
		mov.max_y_cam_pos = mov.min_y_cam_pos + width
	}
	if player_ent.pos.y > mov.max_y_cam_pos
	{
		mov.max_y_cam_pos = player_ent.pos.y
		mov.min_y_cam_pos = mov.max_y_cam_pos - width
	}	
	mov.down_col = false
	mov.col_in_stay = false
	mov.up_col = false
}

MESH_WIDTH :const s32= 33
init_tri_terrain::fn(trn : *terrain_info)
{
	for y in 0..MESH_WIDTH
	{
		for x in 0..MESH_WIDTH
		{
			if y >= 1 && x < (MESH_WIDTH - 1)
			{
				cur := y  * MESH_WIDTH + x
				next_cur := y  * MESH_WIDTH + x + 1
				below_vert := (y - 1) * MESH_WIDTH + x
				below_right_vert := (y - 1) * MESH_WIDTH + x + 1
				dyn_add(&trn.tris, cast(u32)cur)
				dyn_add(&trn.tris, cast(u32)below_vert)
				dyn_add(&trn.tris, cast(u32)below_right_vert)

				dyn_add(&trn.tris, cast(u32)next_cur)
				dyn_add(&trn.tris, cast(u32)cur)
				dyn_add(&trn.tris, cast(u32)below_right_vert)
			}
		}
	}

}
make_chunk_idx_within_mesh::fn(mesh_x : u8, mesh_y : u8, chunk_x : u8, chunk_y : u8) ! s32
{
	ret:s32
	ret = cast(s32)(cast(u32)mesh_x | (cast(u32)mesh_y << 8))
	if(mesh_y >= 16)
	{
		__dbg_break
	}
	ret = ret | cast(s32)((cast(u32)chunk_x << 16) | (cast(u32)chunk_y << 24))
	return ret;
}
generate_mesh::fn(trn : *terrain_info, pos_x : u32, pos_y : u32) ! u32
{
	ASSERT((MESH_WIDTH % 2) == 1)
	verts:[MESH_WIDTH * MESH_WIDTH * TERRAIN_VERTEX_SIZE]f32
	memset(verts, 0, sizeof(verts))

	size := cast(f32)trn.width
	add_x := cast(f32)pos_x / size
	add_y := cast(f32)pos_y / size

	max_y := cast(f32)(MESH_WIDTH - 1) * 6.0
	for y in 0..MESH_WIDTH
	{
		for x in 0..MESH_WIDTH
		{
			px := cast(f32)x / cast(f32)MESH_WIDTH
			py := cast(f32)y / cast(f32)MESH_WIDTH

			mul := 5.0

			perlin := Perlin2D(px+ add_x, py + add_y, 1.0, 2)
			perlin = perlin * mul * 2.0

			perlin2 := Perlin2D(px+ add_x + 5.5, py + add_y + 5.5, 0.1, 2)
			perlin2 =  perlin2 * mul *20.0


			idx := cast(u64)y * MESH_WIDTH * TERRAIN_VERTEX_SIZE + cast(u64)x * TERRAIN_VERTEX_SIZE
			*verts[idx] = cast(f32)px * size
			//__dbg_break
			*verts[idx + 1] = perlin + perlin2
			//*verts[idx + 1] = 0.0

			*verts[idx + 2] = py * size
			*verts[idx + 3] = 1.0
			*verts[idx + 4] = 1.0
			*verts[idx + 5] = 1.0
		}
	}


	m :mesh_info
	m.pos.x = cast(f32)pos_x
	m.pos.z = cast(f32)pos_y

	dyn_add_data(&m.verts, cast(*f32)verts, MESH_WIDTH * MESH_WIDTH * TERRAIN_VERTEX_SIZE * 4)
	m.verts.count = MESH_WIDTH * MESH_WIDTH * TERRAIN_VERTEX_SIZE

	//dyn_add_data(&trn.tris, cast(*f32)tris[0], cast(u32)tris.count * 4)
	//trn.tris.count = tris.count

	info :create_mesh_info
	info.verts = cast(*f32)&verts
	info.total_verts = MESH_WIDTH * MESH_WIDTH
	info.tris = trn.tris[0]
	info.total_tris = cast(u32)trn.tris.count

	trn.vertices_per_row = MESH_WIDTH

	actual_size := MESH_WIDTH - 1
	tris_per_unit := (actual_size) / cast(s32)size

	chunk_window_size := 4
	trn.chunks_col_window_size = cast(u32)chunk_window_size
	
	ASSERT(tris_per_unit >= 1)

	tris_per_unit = tris_per_unit * chunk_window_size
	trn.tris_per_unit = cast(f32)tris_per_unit

	ASSERT((actual_size % cast(s32)tris_per_unit) == 0)

	total_chunks_cols := actual_size / cast(s32)tris_per_unit

	ret := CreateMesh(&info)
	ASSERT(ret != -1)
	m.model = ret
	//total_chunks_cols = total_chunks_cols - 1

	trn.chunks_col_per_row = cast(u32)total_chunks_cols


	tris_per_unit_u64 := cast(u64)tris_per_unit
	dyn_add(&trn.meshes, &m)
	last_mesh_idx := cast(u32)trn.meshes.count - 1

	//__dbg_break

	lastm :*mesh_info= ptr_offset(trn.meshes.data, cast(u64)last_mesh_idx, mesh_info)
	size_u32 := cast(u32)size

	for y in 0..total_chunks_cols
	{
		for x in 0..total_chunks_cols
		{
		
			start_x := cast(u64)x * tris_per_unit_u64
			start_y := cast(u64)y * tris_per_unit_u64
			end_x := cast(u64)x * tris_per_unit_u64 + tris_per_unit_u64
			end_y := cast(u64)y * tris_per_unit_u64 + tris_per_unit_u64
			create_chunk_col_for_terrain(trn, last_mesh_idx, start_x, start_y, end_x, end_y)

			last_chunk := dyn_last(&lastm.chunks)

			pos_x_u8 := cast(u8)(pos_x / (size_u32 - 1))
			pos_y_u8 := cast(u8)(pos_y / (size_u32 - 1))
			x_u8 := cast(u8)x
			y_u8 := cast(u8)y
			total_chunks_col_u8 := cast(u8)total_chunks_cols
			//if pos_x_u8 == 1 && pos_y_u8 == 1 && x == 1 && y == 1
				//__dbg_break;

			if x_u8 > 0
			{
				last_chunk.left_neighbor = make_chunk_idx_within_mesh(pos_x_u8, pos_y_u8, x_u8 - 1, y_u8)
			}
			else if pos_x_u8 > 0
			{
				last_chunk.left_neighbor = make_chunk_idx_within_mesh(pos_x_u8 - 1, pos_y_u8, total_chunks_col_u8 - 1, y_u8)
			}
			
			if (x_u8 + 1) < total_chunks_col_u8
			{
				last_chunk.right_neighbor = make_chunk_idx_within_mesh(pos_x_u8, pos_y_u8, x_u8 + 1, y_u8)
			}
			else if (pos_x_u8 + 1) < cast(u8)trn.size
			{
				last_chunk.right_neighbor = make_chunk_idx_within_mesh(pos_x_u8 + 1, pos_y_u8, 0, y_u8)
			}

			if y_u8 > 0
			{
				last_chunk.up_neighbor = make_chunk_idx_within_mesh(pos_x_u8, pos_y_u8, x_u8, y_u8 - 1)
			}
			else if pos_y_u8 > 0
			{
				last_chunk.up_neighbor = make_chunk_idx_within_mesh(pos_x_u8, pos_y_u8 - 1, x_u8, total_chunks_col_u8 - 1)
			}
			
			if (y_u8 + 1) < total_chunks_col_u8
			{
				last_chunk.down_neighbor = make_chunk_idx_within_mesh(pos_x_u8, pos_y_u8, x_u8, y_u8 + 1)
			}
			else if (pos_x_u8 + 1) < cast(u8)trn.size
			{
				last_chunk.down_neighbor = make_chunk_idx_within_mesh(pos_x_u8, pos_y_u8 + 1, x_u8, 0)
			}
		}
	}
	
	return ret
}
create_chunk_col_for_terrain::fn(trn : *terrain_info, mesh_idx : u32, start_x_quad : u64, start_y_quad : u64, end_x_quad : u64, end_y_quad : u64 )
{

	mesh :*mesh_info= trn.meshes[cast(u64)mesh_idx]
	chunk : chunk_col_info
	chunk.verts_mesh_idx = mesh_idx
	t :u64
	chunk.pos_x = cast(f32)cast(s32)start_x_quad
	chunk.pos_y = cast(f32)cast(s32)start_y_quad
	chunk.up_neighbor = -1
	chunk.down_neighbor = -1
	chunk.left_neighbor = -1
	chunk.right_neighbor = -1
	count := trn.tris.count
	tris := &trn.tris
	tst := 0
	if tst == 0
	{
		for y in start_y_quad..end_y_quad
		{
			for x in start_x_quad..end_x_quad
			{
				start_x := x * 6
				start_y := (cast(u64)trn.vertices_per_row - 1)* 6 * cast(u64)y

				dyn_add(&chunk.tris, *tris[start_x + start_y])
				dyn_add(&chunk.tris, *tris[start_x + start_y + 1])
				dyn_add(&chunk.tris, *tris[start_x + start_y + 2])
				dyn_add(&chunk.tris, *tris[start_x + start_y + 3])
				dyn_add(&chunk.tris, *tris[start_x + start_y + 4])
				dyn_add(&chunk.tris, *tris[start_x + start_y + 5])
			}
		}
	}
	else
	{
		while t < count
		{
			dyn_add(&chunk.tris, *tris[t])
			dyn_add(&chunk.tris, *tris[t + 1])
			dyn_add(&chunk.tris, *tris[t + 2])
			t += 3
		}
	}
	dyn_add(&mesh.chunks, &chunk)
}

generate_terrain::fn(ctx : *context, e : *entity)
{
	terrain := e.terrain
	globals.alloc = &ctx.terrain_alloc
	ctx.alloc = &ctx.terrain_alloc
	init_tri_terrain(terrain)
	trn :*terrain_info= e.terrain
	trn.size = 6
	i := 0
	//__dbg_break

	mesh :*mesh_info
	for y in 0..trn.size
	{
		for x in 0..trn.size
		{
			generate_mesh(terrain, cast(u32)x * (terrain.width - 1), cast(u32)y * (terrain.width - 1))
		}
	}
	//__dbg_break

	globals.alloc = &ctx.main_alloc
	ctx.alloc = &ctx.main_alloc

}

print_mov :: fn(mov : *entity)
{
	//OpenLocalsWindow(__LINE__)
}
new_cube::fn(ctx : *context, pos : *_vec, size : *_vec) ! *entity
{
	other := NewEnt(ctx, "block 1")
	other.pos = *pos
	other.size = *size
	other.col_size = *size
	other.flags = other.flags | ENTITY_3D | ENTITY_HAS_TEXTURE | ENTITY_SERIALIZE
	other.flags = other.flags & ~ENTITY_TRANSPARENT
	add_body(ctx, other)
	dyn_add(&ctx.drawable_ents, other)
	other.is_active = true
	other.is_static = true

	dyn_add(&other.remove_from, ent_part_of.DRAWABLE)
	dyn_add(&other.remove_from, ent_part_of.COLLIDER)

	return other
}
new_axis_ent::fn(ctx : *context, name : str_lit, sz : *_vec, col : *_vec) ! *entity
{
	ret := NewEnt(ctx, name)
	ret.is_active = false
	ret.is_trigger = true
	ret.type = ent_type.AXIS
	ret.flags = ret.flags | ENTITY_ALWAYS_ON_FRONT | ENTITY_3D | ENTITY_DONT_FREE
	ret.size = *sz
	memcpy(&ret.color, col, 16)
	dyn_add(&ctx.drawable_ents, ret)
	add_body(ctx, ret)

	return ret
}
select_action:enum
{
	MOV,
	SCALE_ONE_AXIS,
	SCALE_ONE_AXIS2,
	SCALE,
}
DeserializeEntVar::fn(ctx : *context, type : *type_data, data : *void, ast : *ast_rep)
{
	if is_flag_on(type.flags, TP_STRCT_IS_DYN_ARRAY)
	{
		ASSERT(ast.type == ast_type.INDEX)
		cur_tp_ptr := ptr_offset(type.strct, 1, type_data)


		on cur_tp_ptr.tp
		{
		type_enum.TYPE_ENUM
		{
			ar := cast(*dyn_array(u32))data
			bin := ast.INDEX.rhs

			if !bin
				return;
			dyn_clear(ar)
			for c in bin.BIN.expr
			{
				ASSERT(c.type == ast_type.INT)
				dyn_add(ar, cast(u32)c.INT.num)
			}
		}
		default
		{
			__dbg_break
		}
		}

	}
	else
	{
		on type.tp
		{
		type_enum.TYPE_BOOL
		{
			*cast(*u8)data = cast(u8)ast.INT.num
		}
		type_enum.TYPE_VECTOR
		{
			vec := cast(*_vec)data

			ASSERT(ast.type == ast_type.SCOPE)

			bin := *ast.SCOPE.stmnts[0]
			
			ASSERT(is_ast_bin(bin, cast(u32)token_type.COMMA))
			cur := cast(*f32)data
			for c in bin.BIN.expr
			{
				ASSERT(c.type == ast_type.INT)
				*cur = *cast(*f32)cast(*s32)&c.INT.num

				cur = ptr_offset(cur, 1, f32)
			}
		}
		type_enum.TYPE_U32
		{
			*cast(*u32)data = cast(u32)ast.INT.num
		}
		type_enum.TYPE_ENUM
		{
			*cast(*s32)data = cast(s32)ast.INT.num
		}
		type_enum.TYPE_STR_LIT
		{
			if ast.type == ast_type.WORD
			{
				*cast(*str_lit)data = string_to_str_lit(ctx.alloc, &ast.WORD.str)
			}
			else if ast.type == ast_type.STR_LIT
			{
				*cast(*str_lit)data = string_to_str_lit(ctx.alloc, &ast.STR_LIT.str)
			}
			else
			{
				__dbg_break
			}
		}
		default
		{
			__dbg_break
		}
		}
	}
	
}
DeserializeAllEnt::fn(ctx : *context, file_name : str_lit)
{

	file_name = "../scenes/{file_name}"
	fl_sz: = GetFileSize(file_name);
	if fl_sz == -1
		__dbg_break
	file: = cast(str_lit)heap_alloc(ctx.alloc, cast(u32)fl_sz + 1);
	ReadFile(file_name, file);
	fl :=cast(*scene_file)file

	file = cast(str_lit)ptr_offset(file, sizeof(*fl), u8);
	i :s64

	tkns : dyn_array(token)

	lang_stat :lang_state

	pinfo :parse_info
	pinfo.tkns = &tkns

	root :*scope= new_scope(nil)

	for i2 in 0..globals.entities.max
	{
		ent := ptr_offset(globals.entities.start, i2, entity);
		if is_flag_on(ent.flags, ENTITY_IN_USE) && is_flag_off(ent.flags, ENTITY_DONT_FREE)
		{
			DeleteEnt(ctx, ent)
			ent.flags = 0;
		}
	}

	while i < fl_sz
	{
		if *file[i] == '(
		{
			i++
			
			start := i
			while cast(s64)i < fl_sz && IsNumber(*file[i])
				i++;

			num_len: = i - start
			ent_str_sz := str_2_num(cast(str_lit)file[start], cast(u32)num_len)

			i++


			aux_ptr := file[i + ent_str_sz]
			prev_char := *aux_ptr
			*aux_ptr = cast(char)0

			pinfo.cur_tkn = 0
			dyn_clear(&tkns)

			Tokenize(&tkns, cast(str_lit)file[i])
			globals.nodes_alloc.cur = 0
			globals.ast_alloc.cur = 0
			globals.scope_alloc.cur = 1

			nd :*node= parse_scope(&pinfo)
			ast :*ast_rep= parse_node_to_ast(&lang_stat, nd, root)
			aux_str:string
			ast_to_string(ast, &aux_str)
			ASSERT(ast.type == ast_type.SCOPE)

			stmnts:*ast_rep= *ast.SCOPE.stmnts[0]
			test := cast(token_type)stmnts.BIN.op

			ASSERT(is_ast_bin(stmnts, cast(u32)token_type.SEMI_COLON))

			etype :*type_data= GetTypeData(cast(*entity)0)

			flags := cast(u32)stmnts.BIN.expr[0].BIN.expr[1].INT.num

			ent :*entity

			if is_flag_on(flags, ENTITY_DONT_FREE)
			{
				bin := stmnts.BIN.expr[1]
				ASSERT(bin.BIN.expr[0].WORD.str == "idx")
				ent_idx := cast(u32)stmnts.BIN.expr[1].BIN.expr[1].INT.num
				ASSERT(ent_idx < globals.entities.max)
				ent = ptr_offset(globals.entities.start, ent_idx, entity)
			}
			else
			{
				ent = NewEnt(ctx, "")
			}


			for st in stmnts.BIN.expr
			{
				ASSERT(is_ast_bin(*st, cast(u32)token_type.EQUAL))
				name :*string= &st.BIN.expr[0].WORD.str

				var_type:*type_data
				for i2 in 0..etype.entries
				{
					cur_var: = ptr_offset(etype, 1 + i2, type_data);
					if *name == cur_var.name
					{
						var_type = cur_var
						break;
					}
				}

				if !var_type continue;

				data := ptr_offset(ent, var_type.offset, u8)
				if *name == "col"
				{
					if  ent.col == nil
					{
						add_body(ctx, ent);

						c := cast(*collider)ent.col
						c.type = cast(col_type)st.BIN.expr[1].INT.num
					}

				}
				else
				{
					DeserializeEntVar(ctx, var_type, data, *st.BIN.expr[1])
				}

			}
			//printf("ent deserialized {ent.name}, flags {ent.flags}, addr {cast(u32)cast(u64)ent}\n")
			i += ent_str_sz - 1

	
			str :string
			AssignStr(&str, ent.name)
			if str == "test"
			{
				print_ar(cast(*dyn_array(u32))&ent.remove_from)
				ctx.test_ent = ent
				printf("\nc {ent.remove_from.count}\n")
			}

			if is_flag_off(ent.flags, ENTITY_DONT_FREE)
			{
				for en in ent.remove_from
				{
					on *en
					{
					ent_part_of.PLAYABLE
					{
						dyn_add(&ctx.playable_ents, ent)
						if ent.type == ent_type.ENEMY
						{
							ent.playable_func = enemy_mov
						}
					}
					ent_part_of.ANIMATION
					{
						dyn_add(&ctx.ents_with_clip, ent)
					}
					ent_part_of.LOOK_AT_PLAYER
					{
						dyn_add(&ctx.look_at_ents, ent)
					}
					ent_part_of.DRAWABLE
					{
						dyn_add(&ctx.drawable_ents, ent)
					}
					ent_part_of.COLLIDER
					{
						//add_body(ctx, ent);
					}
					ent_part_of.INSTANTIATED
					{
						//__dbg_break
						//dyn_add(&ctx.ents, ent)
					}
					default
					{
						__dbg_break
					}
					}
				}
			}

		}
		i++
	}
}
free_lang_stuff::fn()
{
	globals.ast_alloc.cur = 0
	globals.scope_alloc.cur = 0
	globals.nodes_alloc.cur = 0
}
SerializeAllEnt::fn(ctx : *context, file_name : str_lit)
{
	out :string
	fl:scene_file
	fl.session_id = ctx.session_id

	dyn_add_data(&out.data, &fl, sizeof(fl));


	for i in 0..globals.entities.max
	{
		ent := ptr_offset(globals.entities.start, i, entity);
		if is_flag_off(ent.flags, ENTITY_IN_USE)
		{
			continue
		}
		printf("ent saved {ent.name}, flags {ent.flags}\n")
		if ent.type == ent_type.AXIS
			continue;

		if is_flag_on(ent.flags, ENTITY_TEMPORARILY_NOT_SERIALIZE)
		{
			__dbg_break
			continue
		}

		if is_flag_on(ent.flags, ENTITY_IN_USE) && is_flag_on(ent.flags, ENTITY_SERIALIZE)
		{
			free_lang_stuff()
			aux :string

			ast := SerializeEnt(ent, cast(u64)i)
			
			ast_to_string(ast, &aux)
			PushStrLit(&out, "({aux.data.count})")
			PushStr(&out, &aux)
			heap_free(aux.data.alloc, aux.data.data)
			PushStrLit(&out, "\n ")

			globals.temp_alloc.cur = 0
			//printf("str {out}\n")
		}
	}
	out.data.count -= 2
	printf("file name bef %", file_name)
	file_name = "../scenes/{file_name}"
	printf("file name aft {file_name}")
	WriteFile(file_name, out.data.data, out.data.count)
}
editor_window::fn(ctx : *context, out_ent : *entity)
{
	HideCursor(false)
	ImGuiBegin("editor", &ctx.editor_wnd, 0);

	aux_bool :=ctx.editor_wnd_type == editor_window_enum.ENTS
	if ImGuiSelectable("ents", aux_bool, 40.0, 15.0)
	{
		ctx.editor_wnd_type = editor_window_enum.ENTS
	}
	ImGuiSameLine()

	aux_bool =ctx.editor_wnd_type == editor_window_enum.MODELS
	if ImGuiSelectable("models", aux_bool, 40.0, 15.0)
	{
		ctx.editor_wnd_type = editor_window_enum.MODELS
	}

	aux_bool =ctx.editor_wnd_type == editor_window_enum.PREFABS
	ImGuiSameLine()
	if ImGuiSelectable("prefabs", aux_bool, 40.0, 15.0)
	{
		ctx.editor_wnd_type = editor_window_enum.PREFABS
	}

	on ctx.editor_wnd_type
	{
	editor_window_enum.MODELS
	{
		idx :s32
		for m in ctx.models
		{
			selected := idx == ctx.cur_model_selected_idx
			if ImGuiSelectable(m.name, selected, 140.0, 15.0)
			{
				ctx.cur_model_selected_idx = cast(s32)m.model
			}
			idx++
		}

		screenmx := GetMouseScreenPosX();
		screenmy := GetMouseScreenPosY();
		
		cam_pos := *ctx.cam_pos_global
		dir := ScreenMouseToWorld(screenmx, screenmy)

		//dir.y = -dir.y
		cam_dir := cam_pos + dir * 20.0
		cam_dir2 := cam_pos + dir * 5.0

		cam_dir = cam_pos + dir * 2000.0

		dyn_clear(&ctx.vertex_terrain)
		prev_sel := out_ent
		aux_sel : *entity
		col: collision;
		if ctx.cur_model_selected_idx != -1
		{
			if Raycast(ctx, &cam_pos, &cam_dir, &col, 0, &aux_sel)
			{
				ctx.preview_ent.model = cast(u32)ctx.cur_model_selected_idx
				ctx.preview_ent.is_active = true
				ctx.preview_ent.pos = col.contact_point

				inv := col.normal
				vert:= ModelFarthestPoint(cast(u32)ctx.cur_model_selected_idx, &inv)
				ctx.preview_ent.pos += vert * -1.0
			}
			else
			{
				ctx.preview_ent.is_active = false
				ctx.preview_ent.pos = col.contact_point
			}
		}
	}
	editor_window_enum.ENTS
	{
		for e in ctx.ents
		{
			buffer:[64]char
			//if is_flag_on(ent.flags, ENTITY_IN_USE) && is_flag_on(ent.flags, ENTITY_SERIALIZE)
			sprintf(buffer, 32, "{e.name}, {cast(u32)e.flags}, addr {cast(u32)cast(u64)*e}")
			ImGuiText(cast(str_lit)buffer)
			if out_ent == *e
			{
				ImGuiSameLine()
				ImGuiText("o")

			}
		}
		ImGuiInputText(" ", cast(str_lit)ctx.save_scene_buffer[0], 32)

		ImGuiSameLine()
		dummy_sel :bool

		if ImGuiSelectable("save", dummy_sel, 40.0, 15.0)
		{
			SerializeAllEnt(ctx, cast(str_lit)ctx.save_scene_buffer[0])
		}
		ImGuiSameLine()
		if ImGuiSelectable("open", dummy_sel, 40.0, 15.0)
		{
			DeserializeAllEnt(ctx, cast(str_lit)ctx.save_scene_buffer[0])
		}


		if out_ent
		{
			check := is_flag_on(out_ent.flags, ENTITY_ONLY_COL)
			if ImGuiCheckbox("only col", &check)
			{
				toggle_flag(&out_ent.flags, ENTITY_ONLY_COL)
			}
			check = is_flag_on(out_ent.flags, ENTITY_TEMPORARILY_NOT_SERIALIZE)
			if ImGuiCheckbox("not serialize", &check)
			{
				toggle_flag(&out_ent.flags, ENTITY_TEMPORARILY_NOT_SERIALIZE)

				found :bool;
				idx : u64;
				for e in ctx.temporarily_not_serialize_ents
				{
					if e.ent == out_ent
					{
						found = true
						break
					}
					idx++
				}
				if is_flag_on(out_ent.flags, ENTITY_TEMPORARILY_NOT_SERIALIZE)
				{
					ASSERT(found)
					t :*temporarily_not_serialize_info=ctx.temporarily_not_serialize_ents[idx]
					heap_free(t.str.data.alloc, t.str.data.data)
					
					dyn_rem(&ctx.temporarily_not_serialize_ents, cast(u32)idx)
				}
				else
				{
					ASSERT(found == false)
					t:temporarily_not_serialize_info
					ast := SerializeEnt(out_ent, cast(u64)idx)
					
					ast_to_string(ast, &t.str)

					dyn_add(&ctx.temporarily_not_serialize_ents, &t)
				}
			}
			ImGuiText(out_ent.name)
			ImGuiCheckbox("active: ", &out_ent.is_active)
			ImGuiText("pos: ")
			ImGuiSameLine()
			ImGuiShowV3(&out_ent.pos)
		}
	}
	}
	ImGuiEnd()
}
change_preview_col_idx::fn(ctx : *context, new_val : u8)
{
	ctx.cur_preview_idx = (new_val) % 3;

	on ctx.cur_preview_idx
	{
	0
	{
		ctx.ent_collider_modify = false
		ctx.draw_col = false
	}
	1
	{
		ctx.ent_collider_modify = true
		ctx.draw_col = false
	}
	2
	{
		ctx.ent_collider_modify = false
		ctx.draw_col = true
	}
	}
}
enemy_mov::fn(ctx : *context, ent : *entity, dt : *f32)
{
	//printf("enemy\n")
	ent.cl = ctx.character_walk
	dir := ctx.player.pos - ent.pos
	dir = normalize_vec(&dir)
	ent.vel = dir + ent.impact_vel
	ent.vel.y += -1.0
	ent.sec_color.w = 1.0

	ent.impact_vel += -ent.impact_vel * *dt * 4.0

	ent.color_lerp += -ent.color_lerp * *dt * 8.0
}
playble_ents_logic::fn(ctx : *context, dt : *f32)
{
	for e in ctx.playable_ents
	{
		if !e.is_active
		{
			continue;
		}
		e.playable_func(ctx, *e, dt)
	}
}
print_ar::fn(ar : *dyn_array(u32))
{
	printf("count {ar.count}\n")
	for i in *ar
	{
		printf("c is {*i}\n")
	}
}
draw_ui_gameplay::fn(ctx : *context, info : *player_info)
{
	w := 0.2
	stamina_w := info.stamina * w
	stamina_temp_max_w := info.stamina_temp_max * w
	DrawSquare(ctx, -0.9, 0.9, w, 0.1, &_vec{0.0, 0.0, 0.0, 1.0})
	DrawSquare(ctx, -0.9, 0.9, stamina_temp_max_w, 0.1, &_vec{0.0, 0.3, 0.0, 1.0})

	col :=_vec{0.0, 1.0, 0.0, 1.0}
	if info.exhausted
	{
		col =_vec{1.0, 0.0, 0.0, 1.0}
	}
	DrawSquare(ctx, -0.9, 0.9, stamina_w, 0.1, &col)
}
NewPlaneEnt::fn(ctx : *context, name : str_lit, pos : *_vec, size : *_vec) ! *entity
{
	ret := NewEnt(ctx, name);
	ret.type = ent_type.ENEMY
	ret.flags = ret.flags | ENTITY_SERIALIZE | ENTITY_3D | ENTITY_HAS_TEXTURE
	ret.is_active = true


	dyn_add(&ret.remove_from, ent_part_of.LOOK_AT_PLAYER)
	dyn_add(&ret.remove_from, ent_part_of.ANIMATION)
	dyn_add(&ret.remove_from, ent_part_of.PLAYABLE)
	dyn_add(&ctx.look_at_ents, ret)
	add_body(ctx, ret)

	ret.pos = *pos
	ret.size = *size
	ret.col_size = *size
	ret.color.x = 1.0
	ret.color.y = 1.0
	ret.color.z = 1.0
	ret.color.w = 1.0

	return ret
}
main_loop::fn(ctx : *context)
{
	ctx.cur_model_selected_idx = -1
	ctx.session_id = cast(u32)(Rand01() * 1000.0)
	//perspective(ctx.perspective_mat[0], fov : f32, aspect : f32, near : f32, far : f32)
    perspective(&ctx.perspective_mat, 45.0 * (3.14159 / 180.0), 1.0, 0.1, 500.0);


	hidx := HandleForGettingFilesInDir("../models")
	total_fl := HandleDirTotalFiles(hidx)

	for i in 0..total_fl
	{
		HandleDirFilenameAt(hidx, cast(u32)i, ctx.save_scene_buffer[0], 64)
		m :model_info
		m.model = LoadModel("../models/test.fbx")
		m.name = new_str_lit(ctx.alloc, cast(str_lit)ctx.save_scene_buffer[0])
		dyn_add(&ctx.models, &m)
	}


	test_model := LoadModel("../models/test.fbx")
	ctx.up.y = 1.0
	globals.up = ctx.up
	globals.ctx = ctx

	dyn_init2(&ctx.coroutines.funcs, 2, ctx.alloc);

	LinearInit(&globals.entities, ctx.alloc, 32)
	LinearInit(&globals.str_alloc, ctx.alloc, 128)
	LinearInit(&globals.allocs_occured, ctx.alloc, 32)
	LinearInit(&globals.temp_alloc, ctx.alloc, 1024)
	LinearInit(&globals.nodes_alloc, ctx.alloc, 512)
	LinearInit(&globals.ast_alloc, ctx.alloc, 512)
	LinearInit(&globals.scope_alloc, ctx.alloc, 16)

	total_bullets := 8
	
	bullet_sz := _vec{0.1, 0.1, 0.1}
	for i in 0..total_bullets
	{
		e := NewPlaneEnt(ctx, "bullet{i}", &ctx.up, &bullet_sz)
		e.flags = e.flags & ~(ENTITY_SERIALIZE) | ENTITY_DONT_FREE
		e.is_active = false
		e.type = ent_type.BULLET
		dyn_add(&ctx.bullets, e)
	}

	//using ctx;
	draw:draw_info3d;
	draw2d:draw_info;
	//AssignCamStuff(scn, &draw);
	pos :_vec;
	speed :f32= 10.0;
	cam_pos: _vec;
	cam_rot: _vec;
	cam_rot.z = 0.0;
	cam_rot.y = 0.0;
	other_block :_vec;
	other_block.x = 5.0;
	other_block.y = 0.0;

	ctx.cam_pos_global = &cam_pos;
	cam_pos.z = 5.0

    cinfo: col_info;
    col: collision;

	col.contacts.alloc = ctx.alloc;
	dyn_init(&col.contacts, 2);
	col.contacts.count = 1;


	player_ent:*entity=NewPlayerEnt(ctx, "player");
	{
		c1 := cast(*collider)player_ent.col
		c1.type = col_type.CAPSULE
		c1.CAPSULE.radius = 0.2
		c1.CAPSULE.height = 1.7
	}

	player_ent.mov_info.speed = 4.5
	player_ent.mov_info.jmp.speed = 2.1
	//player_ent.model = test_model

	ctx.player = player_ent;
	
	dyn_init2(&ctx.masking_objs, 4, ctx.alloc);
	dyn_init2(&ctx.start_pos, 4, ctx.alloc);


	//add_body(ctx, enemy_ent);
	//add_body(ctx, &ground2)

	last_time : = GetTime();

	keys: input_info;

	cam_wiggle_time:f32;
	cam_wiggle_timer:f32;
	cam_wiggle_rot_time:f32;
	cam_wiggle_rot_timer:f32;
	
	
	ctx.draw_col = false;
	//ctx.draw_origin = true;

	//__dbg_break
	layers : dyn_array(*layer_sprites);
	dyn_init2(&layers, 8, ctx.alloc);
	ctx.layers_ptr = &layers;

	//ctx.alloc = &ctx.per_scene_alloc;
	//OpenSceneGame(ctx, "../scenes/01", &layers, &ctx.textures);
	ctx.cam_size = 5.0;
	//ctx.cam_size_original = ctx.cam_size;


	info_3d : draw_info3d
	globals.after_init = true

	player_ent.flags = player_ent.flags | ENTITY_3D
	player_ent.pos.x = 8.0
	player_ent.pos.y = 76.0
	player_ent.pos.z = 9.0

	player_ent.mov_info.stamina = 1.0
	player_ent.mov_info.stamina_recover_rate = 0.05
	player_ent.mov_info.stamina_decrease_rate = 0.005
	player_ent.mov_info.stamina_temp_max = 1.0


/*
	terrain := cast(*terrain_info)heap_alloc(ctx.alloc, sizeof(terrain_info))
	other := NewEnt(ctx, "block 1")
	other.flags = other.flags | ENTITY_3D
	//add_body(ctx, other)
	dyn_add(&ctx.drawable_ents, other)
	//other.is_active = true
	other.type= ent_type.TERRAIN
	other.terrain = terrain
	//other.is_static = true
	other.pos.x = 0.0
	other.pos.y = -2.0
	other.pos.z = 0.0
	other.size.z = 1.0
	other.size.x = 1.0
	terrain.width = MESH_WIDTH - 1
	terrain.height = MESH_WIDTH - 1
	trn_ent := other
	
	str :string

	//generate_terrain(ctx, other)
	*/


	mx := 0.0
	my := 0.0

	player_ent.forward.z = -1.0

	cam_forward : _vec
	cam_forward.z = -1.0



	//cam_rot.y = 1.5708

	ctx.cam_rot_global = &cam_rot;
	ctx.cam_forward_global = &cam_forward;

	axis : _vec
	axis.z = 0.0
	axis.x = 0.0
	axis.y = 1.0
	aux_forward := cam_forward
	ctx.cam_aux_forward_global = &aux_forward;

	cam_to_player_dist := 10.0

	h : f32
	v : f32

	timer_for_cam_go_back_of_player : f32
	ang_diff_for_cam_go_back_of_player : f32

	player_back_pos := player_ent.pos - cam_forward * cam_to_player_dist + ctx.up * 2.0
	cam_start_pos_before_rotate_to_back_pos :_vec
	on_getting_to_back_pos := false
	forward := &player_ent.forward
	pmov := player_ent.mov_info
	cam_up_dist := 5.0
	hidden_cur := true

	
	cube :*entity
	cube = new_cube(ctx, &_vec{10.0, 70.0, 10.0}, &_vec{20.0, 1.0, 20.0});
	cube.tex_id = ctx.grass_tex

	test_e := NewPlaneEnt(ctx, "test", &ctx.up, &_vec{0.5, 1.5, 0.5})
	test_e.pos = cube.pos
	test_e.pos.y += 1.0
	test_e.pos.x += 1.0
	test_e.size.x += 1.0
	//test_e.size.y += 0.5
	test_e.col_size.z = 0.5
	test_e.col_size.x = 0.5
	test_e.col_size.y = 1.5
	test_e.color.x = 1.0
	test_e.color.y = 1.0
	test_e.color.z = 1.0
	test_e.color.w = 1.0
	test_e.sec_color = test_e.color

	test_e.tex_id = *ptr_offset(ctx.character_texs.tex_idxs, 0, u32)

	cube = new_cube(ctx, &_vec{5.0, 70.5, 10.0}, &_vec{10.5, 8.0, 0.5});
	cube.tex_id = ctx.grass_tex
	cube.name = "cube1"
	
	cube = new_cube(ctx, &_vec{5.0, 70.5, 5.0}, &_vec{10.5, 5.2, 1.5, 0.0});
	cube.tex_id = ctx.grass_tex
	cube.name = "cube2"
	cube.rot = euler_to_quaternion(0.0, 45.0, 0.0).v

	ctx.preview_ent = new_cube(ctx, &_vec{5.0, 70.5, 5.0}, &_vec{1.0, 1.0, 1.0, 0.0});
	ctx.preview_ent.flags = ctx.preview_ent.flags | ENTITY_DONT_FREE
	ctx.preview_ent.flags = ctx.preview_ent.flags & ~(ENTITY_SERIALIZE | ENTITY_HAS_TEXTURE)
	ctx.preview_ent.is_active = false
	ctx.preview_ent.name = "preview_ent"

	ctx.preview_ent.color = _vec{1.0, 1.0, 1.0, 1.0}

	remove_body(ctx, ctx.preview_ent)


	HideCursor(hidden_cur)
	out_ent : *entity= nil
	prev_select_ent_col : _vec


	x_axis_ent := new_axis_ent(ctx, "x_axis", &_vec{1.0, 0.2, 0.2}, &_vec{1.0, 0.0, 0.0, 1.0})
	y_axis_ent := new_axis_ent(ctx, "y_axis", &_vec{0.2, 1.0, 0.2}, &_vec{0.0, 1.0, 0.0, 1.0})
	z_axis_ent := new_axis_ent(ctx, "z_axis", &_vec{0.2, 0.2, 1.0}, &_vec{0.0, 0.0, 1.0, 1.0})

	x_axis_ent.forward.x = 1.0

	y_axis_ent.forward.y = 1.0

	z_axis_ent.forward.z = 1.0
	start_selected_pos :_vec

	axis_sel_ent : *entity

	select_up : _vec
	select_right : _vec
	
	sel_action : select_action

	SerializeAllEnt(ctx, "01")
	DeserializeAllEnt(ctx, "01")

	//test_e = ctx.test_ent


	//dyn_add(&test_e.remove_from, ent_part_of.LOOK_AT_PLAYER)

	while !ShouldClose(ctx.window)
	{
		globals.timer = 0.0;

		screenmx := GetMouseScreenPosX();
		screenmy := GetMouseScreenPosY();
		
		curmx := GetMouseScreenPosX();
		curmy := GetMouseScreenPosY();

		//dt: = GetTime() - last_time;
		dt: = 0.017;
		last_time = GetTime();
		ctx.time_since_start += dt
		//print_f32(dt)

		//print_vec(&cam_forward)

		ClearBackground(0.2, 0.5, 0.8);

		f := 0.5
		player_ent.color.x = 1.0
		player_ent.color.y = 0.0
		player_ent.color.z = 0.0

		ang: f32=?
		cross := cross_vec(&ctx.up, &cam_forward)

		//cam_mov(ctx)



		change_select_ent_col :bool

		if IsKeyDown(key_enum.KEY_F1)
		{
			ctx.editor_cam = !ctx.editor_cam 
			change_select_ent_col = true

			if !ctx.editor_cam
			{
				x_axis_ent.is_active = false
				y_axis_ent.is_active = false
				z_axis_ent.is_active = false
				change_preview_col_idx(ctx, 0)
			}
		}
		if ctx.editor_cam
		{
			if !ImGuiHasFocus()
			{
				mvx := GetMouseVelX() * dt
				mvy := GetMouseVelY() * dt
				cam_mov_editor(ctx, mvx, mvy)
				if IsKeyDown(key_enum.KEY_1)
				{
					sel_action = select_action.MOV
				}
				if IsKeyDown(key_enum.KEY_2)
				{
					if sel_action == select_action.SCALE_ONE_AXIS
					{
						sel_action = select_action.SCALE_ONE_AXIS2
					}
					else if sel_action == select_action.SCALE_ONE_AXIS2
					{
						sel_action = select_action.SCALE_ONE_AXIS
					}
					else
					{
						sel_action = select_action.SCALE_ONE_AXIS
					}

				}
				if IsKeyDown(key_enum.KEY_3)
				{
					sel_action = select_action.SCALE
				}
				if IsKeyDown(key_enum.KEY_4)
				{
					change_preview_col_idx(ctx, ctx.cur_preview_idx + 1)
				}

				if axis_sel_ent
				{
					print_vec(&out_ent.pos)
					fw := axis_sel_ent.forward 

					dx := dot_vec(&fw, &select_right) * mvx
					pos_ptr := &out_ent.pos
					size_ptr := &out_ent.size

					if ctx.cur_preview_idx > 0
					{
						if is_flag_on(out_ent.flags, ENTITY_ONLY_COL) && ctx.cur_preview_idx == 2
						{
							pos_ptr = &out_ent.pos
							size_ptr = &out_ent.col_size
						}
						else
						{
							pos_ptr = &out_ent.col_offset
							size_ptr = &out_ent.col_size
						}
					}

					on sel_action
					{
					select_action.MOV
					{
						dy := dot_vec(&fw, &select_up) * -mvy
						*pos_ptr += fw * (dx + dy) * 4.0
					}
					select_action.SCALE_ONE_AXIS
					{
						dx = -dx
						dy := dot_vec(&fw, &select_up) * mvy
						fw = fw * 0.5

						*pos_ptr -= fw * (dx + dy) * 2.0
						*size_ptr -= fw * (dx + dy) * 4.0;

					}
					select_action.SCALE
					{
						dy := dot_vec(&fw, &select_up) * -mvy

						*size_ptr += fw * (dx + dy) * 4.0;

					}
					select_action.SCALE_ONE_AXIS2
					{
						dy := dot_vec(&fw, &select_up) * -mvy
						fw = fw * 0.5

						*pos_ptr += fw * (dx + dy) * 2.0
						*size_ptr -= fw * (dx + dy) * 4.0;

					}
					}
				}

				if IsKeyDown(key_enum.KEY_DEL) && out_ent != nil
				{

					DeleteEnt(ctx, out_ent)
					out_ent = nil
					x_axis_ent.is_active = true
					y_axis_ent.is_active = true
					z_axis_ent.is_active = true
				}
				if out_ent
				{
					if out_ent.type == ent_type.AXIS
					{
					}
					else
					{
						s := clamp(sin(GetTime() * 4.0), 0.0, 1.0)
						yellow :_vec
						yellow.x = 0.5
						yellow.y = 0.5
						yellow.z = 0.5
						yellow.w = prev_select_ent_col.w

						diff := yellow - prev_select_ent_col

						aux := prev_select_ent_col + (diff * s)

						out_ent.color.x = aux.x
						out_ent.color.y = aux.y
						out_ent.color.z = aux.z

						x_axis_ent.pos = out_ent.pos

						y_axis_ent.pos = out_ent.pos
						
						z_axis_ent.pos = out_ent.pos

						if sel_action == select_action.SCALE_ONE_AXIS2
						{
							x_axis_ent.pos.x -= 0.5
							y_axis_ent.pos.y -= 0.5
							z_axis_ent.pos.z -= 0.5
						}
						else
						{
							x_axis_ent.pos.x += 0.5
							y_axis_ent.pos.y += 0.5
							z_axis_ent.pos.z += 0.5
						}
						if ctx.ent_collider_modify
						{
							draw.model = 0
							draw.pos = out_ent.pos + out_ent.col_offset
							draw.ent_size = out_ent.col_size * 1.001
							draw.cam_forward = &cam_forward
							draw.cam_pos = &cam_pos
							draw.cam_rot = &cam_rot
							draw.rot = out_ent.rot
							draw.flags = DRAW_INFO_TRANSPARENT
							*draw.color[0] = 1.0
							*draw.color[1] = 0.0
							*draw.color[2] = 0.0
							*draw.color[3] = 0.5
							Draw3D(ctx.window, &draw)
							//printf("drawing\n")
						}
					}
				}

				if IsKeyDown(key_enum.KEY_I)
				{
					
					dir := ScreenMouseToWorld(screenmx, screenmy)
					
					//dir.y = -dir.y
					cam_dir := cam_pos + dir * 20.0
					cam_dir2 := cam_pos + dir * 5.0

					cam_dir = cam_pos + dir * 2000.0

					dyn_clear(&ctx.vertex_terrain)
					prev_sel := out_ent
					aux_sel : *entity
					if Raycast(ctx, &cam_pos, &cam_dir, &col, 0, &aux_sel)
					{
						cube = new_cube(ctx, &col.contact_point, &_vec{1.0, 1.0, 1.0});
						cube.tex_id = ctx.grass_tex
					}
				}
				if IsMouseUp(mouse_enum.LEFT)
				{
					axis_sel_ent = nil
				}
				if IsMouseDown(mouse_enum.LEFT)
				{
					dir := ScreenMouseToWorld(screenmx, screenmy)
					
					//dir.y = -dir.y
					cam_dir := cam_pos + dir * 20.0
					cam_dir2 := cam_pos + dir * 5.0

					cam_dir = cam_pos + dir * 2000.0

					dyn_clear(&ctx.vertex_terrain)
					prev_sel := out_ent
					aux_sel : *entity
					if Raycast(ctx, &cam_pos, &cam_dir, &col, 0, &aux_sel)
					{
						x_axis_ent.is_active = true
						y_axis_ent.is_active = true
						z_axis_ent.is_active = true

						select_right = cross_vec(&dir, &ctx.up)
						select_up = cross_vec(&select_right, &dir)

						if aux_sel.type != ent_type.AXIS
						{

							out_ent = aux_sel
							if prev_sel != nil
							{
								if  prev_sel != out_ent
									change_select_ent_col = true;
							}
							else
							{
								memcpy(&prev_select_ent_col, &out_ent.color, 16)
								start_selected_pos = out_ent.pos
							}
						}
						else
						{
							axis_sel_ent = aux_sel
						}
					}
					else
					{
						if out_ent
						{
							memcpy(&out_ent.color, &prev_select_ent_col, 16)
							out_ent = nil
						}

						x_axis_ent.is_active = false
						y_axis_ent.is_active = false
						z_axis_ent.is_active = false
					}
					//RaycastWithTerrain(ctx, &cam_pos, &cam_dir, trn_ent)
				}
				/*
				if IsMouseHeld(mouse_enum.RIGHT){
					sz : _vec
					sz.x = 1.0
					sz.y = 1.0
					sz.z = 1.0
					dir := ScreenMouseToWorld(screenmx, screenmy)
					
					//dir.y = -dir.y
					cam_dir := cam_pos + dir * 20.0
					cam_dir2 := cam_pos + dir * 5.0

					//draw_vertex(ctx, &cam_dir, &sz, &cam_pos, &cam_rot)
					cam_dir = cam_pos + dir * 2000.0

					dyn_clear(&ctx.vertex_terrain)
					//RaycastWithTerrain(ctx, &cam_pos, &cam_dir, trn_ent)
					for vtx in ctx.vertex_terrain
					{
						verts := &vtx.mesh.verts
						vec_pos := cast(*_vec)verts[vtx.vidx]
						vec_pos.y += vtx.dir
					}
				}
				if IsMouseUp(mouse_enum.RIGHT)
				{
					for mi in ctx.mesh_added_aux
					{
						m := terrain.meshes[cast(u64)*mi]
						vi :u64
						verts := &m.verts
						count := m.verts.count
						//__dbg_break
						while vi < count
						{
							vec_col := cast(*_vec)verts[vi + 3]
							vec_col.x = 1.0
							vec_col.y = 1.0
							vec_col.z = 1.0

							vi += 6
						}
						UpdateModel(m.model, m.verts.data)
					}
				}
			*/
			}
			if IsKeyDown(key_enum.KEY_F3)
			{
				ctx.editor_wnd = !ctx.editor_wnd
			}
			if ctx.editor_wnd
			{
				editor_window(ctx, out_ent)
			}
			
		}
		else
		{
			
			player_mov(ctx, &aux_forward, &dt)
			//print_f32(GetMouseVelX())
			
			mouse_sense := 0.5
			cam_rot.y -= GetMouseVelX() * dt * mouse_sense
			cam_forward = euler_to_quaternion(0.0 , radians_to_degree(cam_rot.y), 0.0) * aux_forward



			double_pi := PI * 2.0
			if cam_rot.y > double_pi
			{
				diff := cam_rot.y - double_pi
				cam_rot.y = diff
			}
			if cam_rot.y < -double_pi
			{
				diff := cam_rot.y + double_pi
				cam_rot.y = diff
			}
			cam_rot.x -= GetMouseVelY() * dt * mouse_sense

			max_rot_x := 75.0 * (3.14159 / 180.0)
			cam_rot.x = clamp(cam_rot.x, -max_rot_x, max_rot_x)
			player_ent.forward = cam_forward

			cam_pos = player_ent.pos
			dir := euler_to_quaternion(radians_to_degree(cam_rot.x), radians_to_degree(cam_rot.y), 0.0) * aux_forward
			cam_dir := cam_pos + dir * 2000.0

			aux_sel : *entity
			if IsMouseDown(mouse_enum.LEFT) && Raycast(ctx, &cam_pos, &cam_dir, &col, 0, &aux_sel)
			{
				printf("col name {aux_sel.name}\n")
			}




			UpdateEntsWithClips(ctx, dt)
			PhysicsUpdate(ctx, dt)
		}
		
		if change_select_ent_col && out_ent != nil
		{
		}
		if IsKeyDown(key_enum.KEY_F2)
		{
			hidden_cur = !hidden_cur
			HideCursor(hidden_cur)
		}
		print_mov(player_ent)
		playble_ents_logic(ctx, &dt)
		//OpenLocalsWindow(__LINE__)

		DrawEnts(ctx, ctx.cam_pos_global, &cam_rot)
		LookAtPlayerEnts(ctx, ctx.cam_pos_global, &cam_rot)

		if !ctx.editor_cam
		{
			s:= 0.003
			// aim
			DrawSquare(ctx, -s, -s, s, s, &_vec{1.0, 1.0, 1.0, 1.0})
			draw_ui_gameplay(ctx, ctx.player.mov_info)
		}
		globals.temp_alloc.cur = 0

		mx = GetMouseScreenPosX() - curmx;
		my = GetMouseScreenPosY() - curmy;
		mx = mx / 500.0
		my = my / 500.0
		EndFrame(ctx.window);
		ctx.frames_total++;
	}
}


UpdateEntsWithClips::fn(ctx : *context, dt : f32)
{
	if ctx.ents_with_clip.count == 0
		return;
	for e in ctx.ents_with_clip
	{
		if e.cl == nil || !e.is_active
			continue;
		//__dbg_break;
		UpdateClip2(*e, dt);
		
	}
}


main:: fn(){

	ctx: context
	AssignCtxAddr(&ctx);
	InitMemAlloc(&ctx.main_alloc, 46000);
	//InitMemAlloc(&ctx.per_scene_alloc, 16000);
	ctx.alloc = &ctx.main_alloc;
	ctx.coroutines.alloc = ctx.alloc;
	window := OpenWindow(1000, 1000);

	bytes_per_mesh := MESH_WIDTH * MESH_WIDTH * 3
	total_chunks := 9
	terrain_bytes_total := cast(u32)(bytes_per_mesh * total_chunks * total_chunks)
	tris_per_chunk := (MESH_WIDTH - 1) * (MESH_WIDTH - 1) * 6 * 4
	terrain_tris := cast(u32)(tris_per_chunk * total_chunks * total_chunks)

	InitMemAlloc(&ctx.terrain_alloc, terrain_bytes_total + terrain_tris);

	ctx.window = window;

	//globals.alloc = &ctx.per_scene_alloc;
	globals.alloc = ctx.alloc;

	// Cube vertices
	*globals.cube_verts[0] = _vec{-0.5, -0.5, -0.5, 0.0}
	*globals.cube_verts[1] = _vec{0.5, -0.5, -0.5, 0.0}
	*globals.cube_verts[2] = _vec{0.5,  0.5, -0.5, 0.0}
	*globals.cube_verts[3] = _vec{-0.5,  0.5, -0.5, 0.0}
	*globals.cube_verts[4] = _vec{-0.5, -0.5,  0.5, 0.0}
	*globals.cube_verts[5] = _vec{0.5, -0.5,  0.5, 0.0}
	*globals.cube_verts[6] = _vec{0.5,  0.5,  0.5, 0.0}
	*globals.cube_verts[7] = _vec{-0.5,  0.5,  0.5, 0.0};

	globals.cube_tris = [30]s32{
		// Front face
		0, 1, 2,
		0, 2, 3,
		
		// Back face
		4, 6, 5,
		4, 7, 6,
		
		// Left face
		0, 3, 7,
		0, 7, 4,
		
		// Right face
		1, 5, 6,
		1, 6, 2,
		
		// Top face
		3, 2, 6,
		3, 6, 7,
		
		// Bottom face
		0, 4, 5,
		0, 5, 1
	};

	SetIsEngine(false);
	ctx.timers.timers_count = 128;
	ctx.timers.timers = cast(*timer_info)heap_alloc(ctx.alloc, ctx.timers.timers_count * sizeof(timer_info));

	ctx.to_draw.alloc = ctx.alloc;
	dyn_init(&ctx.to_draw, 4);

	ctx.bodies.alloc = ctx.alloc;
	dyn_init(&ctx.bodies, 4);

	ctx.broad_phase_ents.alloc = ctx.alloc;
	dyn_init(&ctx.broad_phase_ents, 4);

	ctx.narrow_phase_ents.alloc = ctx.alloc;
	dyn_init(&ctx.narrow_phase_ents, 4);

	ctx.hit_ents_in_col.alloc = ctx.alloc;
	dyn_init(&ctx.hit_ents_in_col, 4);

	dyn_init2(&ctx.playable_ents, 4, ctx.alloc);
	dyn_init2(&ctx.floaty_platforms, 4, ctx.alloc);
	dyn_init2(&ctx.drawable_ents, 4, ctx.alloc);
	dyn_init2(&ctx.axe_ents, 4, ctx.alloc);
	dyn_init2(&ctx.ents_with_clip, 4, ctx.alloc);

	//scn.items.alloc = ctx.alloc;
	/*
	test_ar: dyn_array(s32);
	test_ar.alloc = ctx.alloc;
	dyn_init(&test_ar, 4);

	val: = 5;
	dyn_add(&test_ar, &val);
	val = -5;
	dyn_add(&test_ar, &val);

	file_out: dyn_array(u8);
	file_out.alloc = ctx.alloc;
	dyn_init(&file_out, 4);
	*/


	ctx.gjk = cast(*gjk_state)heap_alloc(ctx.alloc, sizeof(gjk_state))
	memset(ctx.gjk, 0, sizeof(gjk_state))

	ctx.prntr.chars_per_line = 24;


	AssignModelFolder("../models");
	AssignTexFolder("../images");
	LoadTexFolder("../images", &ctx.textures);
	ctx.grass_tex = LoadTex("grass.png", 0, 0, 32, 32)
	ctx.aim_tex = LoadTex("aim.png", 0, 0, 32, 32)
	ctx.ball_tex = LoadTex("ball.png", 0, 0, 32, 32)

	LoadClip("character.png", 0, 0, 64, 64, 3, 1.0, &ctx.character_texs);

	idle_clip := CreateAnim(&ctx, 0, 1, ctx.character_texs.tex_idxs, ctx.character_texs.total_texs);
	walk_clip: = CreateAnim(&ctx, 1, 3, ctx.character_texs.tex_idxs, ctx.character_texs.total_texs);

	idle_clip.loop = true
	walk_clip.loop = true

	ctx.character_idle = idle_clip
	ctx.character_walk = walk_clip
	ctx.character_walk.vel = 0.2

	*ctx.curtain[0] = 0.0;
	*ctx.curtain[1] = 0.0;
	*ctx.curtain[2] = 0.0;
	*ctx.curtain[3] = 0.0;
	main_loop(&ctx);

}