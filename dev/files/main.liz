Cutscenes::fn coroutine(cor_ctx : *coroutine_ctx, ctx : *context, dt : *f32)
{
	if ctx.cutscene_idx == 1
	{
		ctx.player.mov_info.can_move = false;
		//ctx.
		//ct
		//ctx.player.can_move //=
		//CorWait(4.0);
		ChangePrinterStr(ctx, GetDialogueStr(dialogue_enum.LEVEL_1_SIGN, 0));
		CorMoveVecTo(ctx.cam_pos_global, -29.0, 5.0, 0.0, 2.0, ctx.cam_col_left);
		while true
		{
			if ctx.prntr.done && IsKeyDown(key_enum.KEY_JMP)
			{
				break;
			}
			return;
		}
		ClearPrinterStr(ctx);
		ctx.player.mov_info.can_move = true;
		ctx.cutscene_idx = 0;
		ResetCoroutine();
	}
}

FloatyPlatformLogic::fn(ctx : *context, dt : *f32)
{
	for e in ctx.floaty_platforms
	{
		prev_vel := &e.impact_vel;
		if prev_vel.x == 0.0
		{
			*prev_vel = e.vel
		}
		if cast(u32)e.state  == 0
		{
			e.vel.x += (prev_vel.x - e.vel.x) * *dt * 2.0;
			e.vel.y += (prev_vel.y - e.vel.y) * *dt * 2.0;
			if e.was_hit
			{
				*cast(*u32)&e.state = 1;
				e.platform_idle_time = 0.0;
				e.was_hit = false
				*prev_vel = e.vel;
			}
		}
		if cast(u32)e.state  == 1
		{
			e.platform_idle_time += *dt
			e.vel.x = 0.0;
			e.vel.y = 0.0;
			if e.platform_idle_time > 2.0
			{
				*cast(*u32)&e.state = 0;
				prev_vel.x = -prev_vel.x;
				prev_vel.y = -prev_vel.y;
				e.platform_idle_time = 0.0;
			}
		}
	}
}

MovPlayablesEntMov::fn(ctx : *context, dt : *f32)
{
    col: collision=?;
	for e in ctx.playable_ents
	{
		if !e.is_active
			continue;
		keys: input_info;
		if e.type == ent_type.PLAYER
		{
				//player_ent.vel.x = 0.0;
			keys.up_key_held = IsKeyHeld(key_enum.KEY_UP);
			keys.down_key_held = IsKeyHeld(key_enum.KEY_DOWN);
			keys.left_key_held = IsKeyHeld(key_enum.KEY_LEFT);
			keys.right_key_held = IsKeyHeld(key_enum.KEY_RIGHT);
			keys.left_key_held = IsKeyHeld(key_enum.KEY_LEFT);
			keys.horizontal_key_held = keys.left_key_held || keys.right_key_held;
			keys.down_key_held = IsKeyHeld(key_enum.KEY_DOWN);
			keys.jmp_key_held = IsKeyHeld(key_enum.KEY_JMP);
			keys.jmp_key_up = IsKeyUp(key_enum.KEY_JMP);
			keys.attack_key_down = IsKeyDown(key_enum.KEY_ACT0);
			keys.attack2_key_down = IsKeyDown(key_enum.KEY_ACT1);
			keys.attack2_key_up = IsKeyUp(key_enum.KEY_ACT1);
			keys.attack2_key_held = IsKeyHeld(key_enum.KEY_ACT1);
	
			if e.mov_info 
				MovEntity(ctx, e.mov_info, *e, &keys, dt);
			hit_ent := e.dmg.hit_ent;
			//changing scenes
			if hit_ent != nil
			{
				if hit_ent.type == ent_type.CHANGE_SCENE_TRIGGER
				{
					aux_buffer :[64]char;
					//__dbg_break;
					sprintf(aux_buffer[0], 64, "%%", "../scenes/", hit_ent.scene.change_to_scene_name);
					ctx.character_start_obj_idx = hit_ent.scene.character_start_idx;
					OpenSceneGame(ctx, cast(str_lit)aux_buffer[0], ctx.layers_ptr, &ctx.textures);
					return;
				}
				else if hit_ent.type == ent_type.RESET_LEVEL
				{
					e.pos = ctx.player_start_level_pos;
				}
				e.dmg.hit_ent = nil;
				
			}
			//e.tex_size_x += *dt;
			//e.tex_size_y += *dt;

			if IsKeyDown(key_enum.KEY_UP) && ctx.cutscene_idx == 0
			{
				for c in e.ents_in_collision
				{
					if c.in_col && c.ent.type ==  ent_type.INTERACT
					{
						//idx := c.ent.event.interact_idx;
						ctx.cutscene_idx = c.ent.event.interact_idx;
						//__dbg_break;
					}
					
				}
			}
		}
		else if e.type == ent_type.ENEMY
		{
			if e.enemy_type == enemy_enum.THRAXER
			{
				//e.mov_info.
				dist_to_axe := 400.0;
				if !e.mov_info.axe_ent
				{
					max_dist := 40.0;
					for a in ctx.axe_ents
					{
						cur_dist := absf(e.pos.x - a.pos.x);
						if cur_dist < max_dist
						{
							max_dist = cur_dist;
							e.mov_info.axe_ent = *a;
						}
					}
				}
				else
				{
					dir_to_axe := e.pos - e.mov_info.axe_ent.pos;
					dist_to_axe = dot_vec(&dir_to_axe, &dir_to_axe);
					if !e.mov_info.axe_ent.is_active
					{
						dist_to_axe = 400.0;
					}
				}
				
				dist_x := ctx.player.pos.x - e.pos.x;
				e.forward.x = sign(dist_x);
				if e.state == entity_state.THRAXER_IDLE
				{
					e.cl = ctx.thraxer_idle;
					if dist_to_axe < 16.0
					{
						ChangeState(*e, entity_state.THRAXER_DEFEND);
					}

				}
				else if e.state == entity_state.THRAXER_DEFEND
				{
					e.cl = ctx.thraxer_defend;
					if e.mov_info.trigger.dmg.hit || dist_to_axe > 64.0
					{
						if e.cl.vel > 0.0
							e.cl.vel = e.cl.vel * -1.0;
						if e.clip_time <= 0.0
						{
							e.cl.vel = e.cl.vel * -1.0;
							e.mov_info.trigger.dmg.hit = false;
							e.mov_info.trigger.is_active = false;
							ChangeState(*e, entity_state.THRAXER_IDLE);
						}
					}
				}
			}
			else if e.enemy_type == enemy_enum.WOLF
			{
				dist_x := ctx.player.pos.x - e.pos.x;
				e.mov_info.trigger.is_active = true;
				//PrintV3(cast(f32)cast(u32)e.state, 0.0, 0.0);
				if !e.on_ground
				{
					e.vel.y += -4.0 * *dt; 
				}
				else
					e.vel.y = -0.0;
				e.vel.y = clamp(e.vel.y, -20.0, 20.0);
					
				if e.state == entity_state.IDLE
				{
					e.cl = ctx.wolf_idle;
					if dist_x < 5.0
					{
						e.state = entity_state.WALK;
						e.mov_info.prev_player_pos = ctx.player.pos;
						dir_to_player := e.mov_info.prev_player_pos.x - e.pos.x;
						e.forward.x = sign(dir_to_player);

					}
				}
				else if e.state == entity_state.WOLF_BACK_TO_ORIGIN
				{
					dist_to_origin_x := e.mov_info.origin_pos.x - e.pos.x;
					sign_x := sign(dist_to_origin_x);
					e.vel.x = sign_x * 3.0;
					e.forward.x = sign_x;
					
					if absf(dist_to_origin_x)  < 1.0
					{
						e.state = entity_state.IDLE;
						e.vel.x = 0.0;
					}
				}
				else if e.state == entity_state.WALK
				{
					e.cl = ctx.wolf_walk;
					a:=0;
					
					start_pos:_vec = ? ;
					end_pos:_vec = ? ;
		
					start_pos = e.pos + e.forward * 1.5;
					end_pos = e.pos + e.forward * 1.5;
					end_pos.y -= 10.0;
		
					out_ent: *entity;
					if !Raycast(ctx, &start_pos, &end_pos, &col, LAYER_TRIGGER, &out_ent)
					{
						e.state = entity_state.WOLF_BACK_TO_ORIGIN;
						//PrintV3(1.0, 0.0, 0.0);
						e.vel.x = 0.0;
					}
					else
						e.vel.x = e.forward.x * 5.0;
					
				}
			}
		}
	}
}
EnemyMovLogic::fn(ctx : *context, e_ent : *entity, p_ent : *entity, ekeys : *input_info, dt : f32)
{
	if e_ent.knockedout
		return;
	x_dir: = e_ent.pos.x - p_ent.pos.x;
	y_dir: = e_ent.pos.y - p_ent.pos.y;
	aux_state: = e_ent.mov_info.this_state;
	key_towards_player:*bool;
	key_away_player:*bool;
	if x_dir > 0.0
	{
		key_towards_player = &ekeys.left_key_held;
		key_away_player = &ekeys.right_key_held;
	}
	else
	{
		key_away_player  = &ekeys.left_key_held;
		key_towards_player= &ekeys.right_key_held;
	}

	e_ent.mov_info.behaviour_timer += dt;
	btimer := &e_ent.mov_info.behaviour_timer;

	//e_ent.mov_info.this_state = behaviour_state.JUMP;

	if aux_state == behaviour_state.IDLE
	{
		if absf(x_dir) < 3.0 && absf(y_dir) < 1.0
		{
			val: = Rand01();
			//PrintV3(val, 0.0, 0.0);
			//if val > 0.5
				ChangeBehaviour(e_ent, behaviour_state.MAINTAIN_DISTANCE);
			//else
				//ChangeBehaviour(e_ent, behaviour_state.WAIT);
		}
		if absf(x_dir) < 10.0 && *btimer > 4.0
		{
			ChangeBehaviour(e_ent, behaviour_state.GET_CLOSER_THEN_ATTACK);
		}
	}
	else if aux_state == behaviour_state.WAIT
	{
		if* btimer > 1.0
			ChangeBehaviour(e_ent, behaviour_state.IDLE);
	}
	else if aux_state == behaviour_state.JUMP
	{
		if absf(x_dir) > 1.0
		{
			*key_towards_player = true;
		}

		if *btimer < 0.4
			ekeys.jmp_key_held = true;
		if *btimer > 0.8
		{
			ekeys.attack_key_down = true;
			//ekeys.jmp_key_up = true;
			ChangeIfBehaviourIfStateIsTerminal(e_ent, behaviour_state.IDLE);
		}
	}
	else if aux_state == behaviour_state.GET_CLOSER_THEN_ATTACK
	{
		*key_towards_player = true;
		if absf(x_dir) < 1.5
		{
			ekeys.attack_key_down = true;
		}
		ChangeIfBehaviourIfStateIsTerminal(e_ent, behaviour_state.IDLE);
	}
	else if aux_state == behaviour_state.MAINTAIN_DISTANCE
	{
		if absf(x_dir) < 4.0 && absf(y_dir) < 1.0
		{
			e_ent.mov_info.speed = p_ent.mov_info.speed;
			if x_dir > 0.0
				ekeys.right_key_held = true;
			else
				ekeys.left_key_held = true;

			if* btimer > 1.0
			{
				val: = Rand01();
				if  val > 0.5
				{
					ChangeBehaviour(e_ent, behaviour_state.GET_CLOSER_THEN_ATTACK);
				}
				else
					ChangeBehaviour(e_ent, behaviour_state.JUMP);

			}
		}
		else
			e_ent.mov_info.this_state = behaviour_state.IDLE;
	}
	else
		__dbg_break;
}

MovTriggerToCloserToEnt::fn(ctx : *context)
{
	if ctx.playable_ents.count == 0
		return;
	for e in ctx.playable_ents
	{
		if !e.mov_info
			continue;
		player_ent: = *e;
		player_ent_trigger: = e.mov_info.trigger;
		pinfo: = e.mov_info;

		player_ent_trigger.pos = player_ent.pos;
		player_ent_trigger.pos.x += player_ent.forward.x;
		player_ent_trigger.col_size.x = pinfo.trig_info.size.x * player_ent.forward.x * 1.1;
		player_ent_trigger.col_size.y = pinfo.trig_info.size.y;
	}
}
MakeEntMasked::fn(ctx : *context, ent : *entity, masked :  *masked_info)
{
	ent.flags = ent.flags | ENTITY_IS_MASKED;
	ent.stencil_val = masked.stencil_val;
	ent.stencil_func = stencil_func_enum.EQUAL;
	ent.masking_objs = &ctx.masking_objs;
}
FreeArrayOfEnts::fn(ar : *dyn_array(*entity))
{
	for e in *ar
	{
		if is_flag_on(e.flags, ENTITY_DONT_FREE | ENTITY_FREED)
			continue;
		e.flags = ENTITY_DONT_FREE;
		heap_free(ar.alloc, *e);
		
	}
}
OpenSceneGame::fn(ctx:*context, name : str_lit, layers : *dyn_array(*layer_sprites), textures : *dyn_array(texture_info))
{
	InitMemAlloc(ctx.alloc, ctx.alloc.chunks_cap)
	//globals.allocs_occured.cur = 0
	for l in *layers
	{
		for sh in l.cells
		{
			//FreeSheet(alloc, sh.sheet);
			FreeTexture(sh.SPRITE.sheet.tex_id);
		}
		*l = nil;
		/*
		if l.type == layer_enum.OBJ
		{
			for c in l.cells
			{
				if c.obj.type == layer_obj_enum.CHANGE_SCENE_TRIG
					heap_free(ctx.alloc, c.obj.add_info);
			}
		}
		*/
	}
	/*
	FreeArrayOfEnts(&ctx.bodies);
	FreeArrayOfEnts(&ctx.playable_ents);
	FreeArrayOfEnts(&ctx.ents_with_clip);
	*/
	for e in ctx.bodies
	{
		for c in e.ents_in_collision
		{
			c.in_col = false;
		}
		if is_flag_on(e.flags, ENTITY_DONT_FREE | ENTITY_FREED)
		{
			continue;
		}
		//heap_free(e.ents_in_collision.alloc, e.ents_in_collision.data);
	}
	SetMem(ctx.already_allocated_mem_count);
	globals.entities.cur = ctx.already_allocated_ents_count;
	globals.str_alloc.cur = ctx.already_allocated_str_count;
	//globals.allocs_occured : linear_alloc(*u8),
	
	dyn_clear(&ctx.playable_ents);
	dyn_clear(&ctx.drawable_ents);
	dyn_clear(&ctx.masking_objs);
	dyn_clear(&ctx.ents_with_clip);
	dyn_clear(&ctx.axe_ents);
	dyn_clear(&ctx.floaty_platforms);
	
	aux__vec:= &ctx.player.pos;
	dyn_add(&ctx.masking_objs, &aux__vec);
	dyn_clear(&ctx.bodies);
	
	file := OpenScene(ctx.alloc, name, layers, &ctx.textures);

	//__dbg_break;
	for l in *layers
	{
		if l.type == layer_enum.COL
		{
			for c in l.cells
			{
				ent := NewEnt(ctx.alloc, "collider");
				ent.is_active = true;
				ent.pos = c.COL.pos;
				ent.col_size = c.COL.sz;
				ent.type = ent_type.STATIC_COL;
				ent.is_static = true;
				if c.masked.is_masked
				{
					MakeEntMasked(ctx, ent, &c.masked);
					//ent. = ENTITY_IS_MASKED;
				}
				add_body(ctx, ent);
				
			}
		}
		else if l.type == layer_enum.SPRITE
		{
			for sh in l.cells
			{
				//__dbg_break
				ent := NewEnt(ctx.alloc, "sprite");
				test := heap_alloc(ctx.alloc, 1);
				sheet := sh.SPRITE.sheet;
				ent.pos = sheet.pos;
				ent.size = sheet.sz;
				ent.is_active = true;
				ent.color.{x = 1.0; y = 1.0; z = 1.0; w = 1.0 };
				ent.tex_id = cast(u32)sheet.tex_id;
				ent.pos.z = 0.8;
				ent.flags = ent.flags | DRAW_INFO_HAS_TEXTURE;
				dyn_add(&ctx.drawable_ents, &ent);
				
				if sh.masked.is_masked
				{
					MakeEntMasked(ctx, ent, &sh.masked);
					a := 0;
					//ent. = ENTITY_IS_MASKED;
				}
				
				if cast(layer_obj_enum)sheet.obj_type == layer_obj_enum.FLOATY_PLATFORM
				{
					ent.type = ent_type.FLOATY_PLATFORM;
					ent.col_enter = floaty_platform_col_enter;
					ent.col_size = ent.size;
					ent.vel.x = -5.0;
					add_body(ctx, ent);
					dyn_add(&ctx.floaty_platforms, &ent)
				}
			}
		}
		else if l.type == layer_enum.OBJ
		{
			
			for c in l.cells
			{
				if c.OBJ.type == layer_obj_enum2.PLAYER
				{
					
					dyn_add(&ctx.playable_ents, &ctx.player); 
					dyn_add(&ctx.playable_ents, &ctx.player.mov_info.axe_ent); 
					
					dyn_add(&ctx.drawable_ents, &ctx.player);
					dyn_add(&ctx.drawable_ents, &ctx.player.mov_info.axe_ent);
					
					
					dyn_add(&ctx.ents_with_clip, &ctx.player);
					__dbg_break
					dyn_add(&ctx.bodies, &ctx.player); 
					dyn_add(&ctx.bodies, &ctx.player.mov_info.axe_ent); 
					dyn_add(&ctx.bodies, &ctx.player.mov_info.trigger); 
					
					dyn_add(&ctx.axe_ents, &ctx.player.mov_info.axe_ent);
					
					ctx.player_start_level_pos = c.OBJ.pos;
					
					ctx.player.pos = c.OBJ.pos;
					ctx.player.pos.z = 0.1;
					ctx.player.dont_res_cols_with_layers = LAYER_ENEMY;
					ctx.player.layer = ctx.player.layer | LAYER_PLAYER;
					ctx.player.type = ent_type.PLAYER;
					ctx.player.mov_info.axe_ent.is_active = false;
					ctx.player.mov_info.axe_ent.pos.z = 0.5;
					ctx.player.is_trigger = false;
					
					

					ctx.player.mov_info.max_spears = 1;
					max_spears := ctx.player.mov_info.max_spears;
					ctx.player.mov_info.spears = cast(*entity)heap_alloc(ctx.alloc, sizeof(*entity) * max_spears);
					ctx.player.mov_info.cur_spear = 0;
					
					// instatiatitg spears
					for i in 0..max_spears
					{
						spear := ptr_offset(ctx.player.mov_info.spears, i, *entity);
						*spear = NewEnt(ctx.alloc, "spear");
						spear.col_enter = spear_collision_enter;
						spear.pivot.x = 0.5;
						spear.pivot.y = 0.35;
						spear.layer = LAYER_MAYBE_ONLY_UP_COL;
						spear.dont_res_cols_with_layers = LAYER_PLAYER;
						spear.spear_idle_tex_idx = *ptr_offset(ctx.spear_texs.tex_idxs, 4, u32);
						spear.type = ent_type.SPEAR;
						
						spear.size.x = 2.0;
						spear.size.y = 2.0;
						spear.col_size.x = 1.7;
						spear.col_size.y = 0.5;
						
						spear.color.x = 1.0;
						spear.color.y = 1.0;
						spear.color.z = 1.0;
						spear.color.w = 1.0;
						spear.flags = ENTITY_HAS_TEXTURE;
						//spear.flags = spear.flags | ENTITY_DONT_FREE;
						spear.cl = ctx.spear_clip;
						
						add_body(ctx, *spear);
						dyn_add(&ctx.drawable_ents, spear);
						dyn_add(&ctx.ents_with_clip, spear);
					}
					
					
					//ctx.player.col_exit = player_collision_exit;
				}
				else if c.OBJ.type == layer_obj_enum2.ENEMY
				{
					ent :*entity;
					NewPlayableEnt(ctx, &ent, true);
					ent.is_active = true;
					ent.type = ent_type.ENEMY;
					ent.enemy_type = c.OBJ.ENEMY.enemy_type;

					ent.pos = c.OBJ.pos;
					ent.size.x = 2.0;
					ent.size.y = 2.0;
					ent.pivot.x = 0.5;
					ent.pivot.y = 0.5;
					ent.mov_info.origin_pos = ent.pos;
					ent.forward.x = 1.0;
					ent.col_size = ent.size;
					ent.col_exit = nil;
					ent.col_enter = nil;
					ent.flags = ent.flags | DRAW_INFO_HAS_TEXTURE;
					ent.mov_info.trigger.type = ent_type.DEFENSE;
					ent.layer = LAYER_ENEMY;
					
					ctx.thraxer_trigger = ent.mov_info.trigger;
					
					dyn_add(&ctx.drawable_ents, &ent);
					dyn_add(&ctx.ents_with_clip, &ent);

					if c.OBJ.ENEMY.enemy_type == enemy_enum.THRAXER
					{
						ent.tex_id = *ctx.thraxer_texs.tex_idxs;
						//ent.dont
						ent.is_trigger = true;
					}
					else if c.OBJ.ENEMY.enemy_type == enemy_enum.WOLF
					{
						ent.tex_id = *ctx.wolf_texs.tex_idxs;
						ent.col_size.y = 1.0;
						ent.pivot.y = 0.0;
						ent.mov_info.trig_info.size.y = 2.0;
						ent.dont_res_cols_with_layers = LAYER_PLAYER;
						ent.is_trigger = false;
					}
				}
				else if c.OBJ.type == layer_obj_enum2.CAM_RESTRAINT
				{
					ctx.cur_cam_rest = cast(*cam_restraint)&c.OBJ.pos;
				}
				else if c.OBJ.type == layer_obj_enum2.INTERACT
				{
					ent := NewEnt(ctx.alloc, "interact");
					//ent.change_to_scene_name = cast(str_lit)heap_alloc(ctx.alloc, SCENE_NAME_NAME_MAX);
					//__dbg_break
					ent.event.interact_idx = c.OBJ.INTERACT.interact_idx;
					//ent.event.interact_idx = c.obj.interact_idx;
					ent.type = ent_type.INTERACT;
					//ent.event.interact_idxin = c.obj.interact_idx;
					ent.is_active = true;
					ent.is_trigger = true;
					add_body(ctx, ent);
					ent.col_size = c.OBJ.sz;
					ent.size = c.OBJ.sz;
					ent.pos = c.OBJ.pos;
				}
				else if c.OBJ.type == layer_obj_enum2.CHANGE_SCENE_TRIG
				{
					ent := NewEnt(ctx.alloc, "change scene");
					//ent.change_to_scene_name = cast(str_lit)heap_alloc(ctx.alloc, SCENE_NAME_NAME_MAX);
					//__dbg_break
					ent.scene.change_to_scene_name = c.OBJ.CHANGE_SCENE_TRIG.add_info;
					ent.scene. character_start_idx = c.OBJ.CHANGE_SCENE_TRIG.scene_character_start_idx;
					ent.type = ent_type.CHANGE_SCENE_TRIGGER;
					ent.col_enter = change_scene_collision_enter;
					ent.col_exit = nil;
					ent.is_active = true;
					ent.is_trigger = true;
					add_body(ctx, ent);
					ent.col_size = c.OBJ.sz;
					ent.size = c.OBJ.sz;
					ent.pos = c.OBJ.pos;
				}
				else if c.OBJ.type == layer_obj_enum2.CHARACTER_START_POS
				{
					sinfo:start_pos_info
					sinfo.pos = c.OBJ.pos;
					sinfo.idx = c.OBJ.CHARACTER_START_POS.scene_character_start_idx
					dyn_add(&ctx.start_pos, &sinfo)
					//sinfo.
					//ctx.start_pos
				}
				else if c.OBJ.type == layer_obj_enum2.RESET_LEVEL
				{
					ent := NewEnt(ctx.alloc, "reset level");
					//ent.change_to_scene_name = cast(str_lit)heap_alloc(ctx.alloc, SCENE_NAME_NAME_MAX);
					//__dbg_break
					ent.type = ent_type.RESET_LEVEL;
					ent.col_enter = nil;
					ent.col_exit = nil;
					ent.is_active = true;
					ent.is_trigger = true;
					add_body(ctx, ent);
					ent.col_size = c.OBJ.sz;
					ent.size = ent.col_size;
					ent.pos = c.OBJ.pos;
				}
				else
				{
					// layer_obj not handled
					printf("not handled: %\n", cast(u32)c.OBJ.type)
					__dbg_break;
				}
			}
		}
	}
	heap_free(ctx.alloc, file);
	
	if ctx.character_start_obj_idx > 0
	{
		//found := false
		for s in ctx.start_pos
		{
			if s.idx == ctx.character_start_obj_idx
			{
				ctx.player.pos = s.pos;
			}
		}
	}
}

min :: fn(a : s32, b : s32) ! s32
{
	if a < b return a;
	return b;
}
min :: fn(a : u32, b : u32) ! u32
{
	if a < b return a;
	return b;
}
min :: fn(a : f32, b : f32) ! f32
{
	if a < b return a;
	return b;
}

axe_throw_callback::fn(data : *anim_callback_info) !bool
{
	if data.time_since_stopped > 3.0
		return true;
	return false;
}

NewAxeEnt::fn(ctx : *context) ! *entity
{
	axe_ent := NewEnt(ctx.alloc, "axe");
	axe_ent.is_trigger = true;
	axe_ent.type = ent_type.AXE;
	axe_ent.col_enter = axe_trig_collision_enter;
	add_body(ctx, axe_ent);
	axe_ent.flags = ENTITY_HAS_TEXTURE | ENTITY_DONT_FREE;
	axe_ent.layer = LAYER_TRIGGER
	axe_ent.tex_id = cast(u32)ctx.axe_tex;
	axe_ent.is_active = true;
	axe_ent.axe = cast(*axe_info)heap_alloc(ctx.alloc, sizeof(axe_info));
	axe_ent.pivot.x = 0.5;
	axe_ent.pivot.y = 0.5;
	axe_ent.pos.y = 5.0;
	return axe_ent;
}
NewInventory::fn(ctx : *context, slots : u32) ! *inventory
{
	inv:*inventory = cast(*inventory)heap_alloc(ctx.alloc, sizeof(inventory));
	dyn_init2(&inv.items, slots, ctx.alloc);
	inv.items.count = slots;
	return inv;
}
NewPlayerEnt::fn(ctx : *context, name : str_lit) ! *entity
{
	player_ent:*entity;
	NewPlayableEnt(ctx, &player_ent, false);
	
	player_ent.flags = player_ent.flags | ENTITY_DONT_FREE;
	//player_ent.mov_info.axe_ent = NewAxeEnt(ctx);
	
	
	player_ent.layer = LAYER_ENTITY_PLAYABLE | LAYER_PLAYER
	player_ent.dont_res_cols_with_layers = LAYER_ENTITY_PLAYABLE;

	player_ent.name = name;
	player_ent.pos.x = 4.0;
	player_ent.pos.y = 4.0;
	player_ent.size.x = 1.0;
	player_ent.size.y = 1.0;
	player_ent.col_size.x = 0.7;
	player_ent.col_size.y = 0.7;
	player_ent.pivot.x = 0.5;
	player_ent.pivot.y = 0.5;
	player_ent.color.x = 1.0;
	player_ent.color.y = 1.0;
	player_ent.color.z = 1.0;
	player_ent.color.w = 1.0;
	player_ent.col_enter = player_collision_enter;
	player_ent.col_stay = player_collision_stay;
	player_ent.col_exit = player_collision_exit;
	player_ent.is_active = true;

	player_ent_trigger: = player_ent.mov_info.trigger;
	pinfo: = player_ent.mov_info;
	pinfo.{
		speed = 5.0;
		can_move = true;
		jmp.speed = 15.0;
		forward.x = 1.0;
		has_axe = true;
		jmp.off_ground_can_jmp_time = 0.2;
		trigger = player_ent_trigger;
		trig_info.{
			time = 0.2;
			size.x = 1.0;
			size.y = 1.0;
		};
	};
	
	mov_info := player_ent.mov_info;
	mov_info.usable_items = NewInventory(ctx, 2);
	mov_info.usable_items.items[0].item = inv_item.BRACELET_OF_SINCERITY;
	mov_info.weapons_inv = NewInventory(ctx, 4);
	
	mov_info.cur_weapon = mov_info.weapons_inv.items[0];
	mov_info.cur_weapon.item = inv_item.AXE;
	
	mov_info.cur_weapon = mov_info.weapons_inv.items[1];
	mov_info.cur_weapon.item = inv_item.SPEAR;
	
	mov_info.cur_weapon = mov_info.weapons_inv.items[0];
	
	player_ent.flags = player_ent.flags | ENTITY_HAS_TEXTURE;
	
	
	
	return player_ent;
}

DrawUpperInv::fn(ctx : *context, islot : *inv_slot)
{
	draw:draw_info;
	
	draw.pos.x = -0.1;
	draw.pos.y = 0.8;
	draw.pos.z = 0.8;
	draw.ent_size.y = 0.2;
	draw.ent_size.x = 0.2;
	draw.cam_size = 1.0;
	//draw.cam_pos = ctx.cam_pos_global;
	draw.color = []f32{0.0, 0.0, 0.0, 1.0};
	draw.flags = 0;
	Draw(ctx.window, &draw);
	
	draw.flags = DRAW_INFO_HAS_TEXTURE;
	item := islot.item;
	if item == inv_item.AXE
	{
		draw.texture_id = *ctx.inv_texs.tex_idxs;
	}
	else if item == inv_item.SPEAR
	{
		draw.texture_id = *ptr_offset(ctx.inv_texs.tex_idxs, 1, u32);
	}
	else if item == inv_item.BRACELET_OF_SINCERITY
	{
		draw.texture_id = *ptr_offset(ctx.inv_texs.tex_idxs, 2, u32);
	}
	else
	{
		__dbg_break;
	}
	draw.pos.z = 0.5;
	draw.color = []f32{1.0, 1.0, 1.0, 1.0};
	Draw(ctx.window, &draw);
}

tst_st : struct
{
	val : u32,
	ar : dyn_array(cell)
	#serializable(val, ar)
}

has_blocks_left::fn(ar : *dyn_array(dyn_array(_vec)), y : *u64) ! bool
{
	*y = 0
	for ar_y in* ar
	{
		if ar_y.count > 0
		{
			return true;
		}
		*y++;
	}
	return false;
}
below_block_is_contiguous::fn(blocks_grid : *dyn_array(dyn_array(_vec)), cur : *_vec, str : str_lit, grid_width : u32, out_idx_on_same_x : *u64) ! bool
{
	if cast(u32)cur.y < cast(u32)(blocks_grid.count - 1) &&
		*level_str_offset(str, cast(u32)cur.x, cast(u32)cur.y, grid_width) == '-
	{
		row := blocks_grid[cast(u64)cast(u32)cur.y]
		if row.count == 0
		{
			return false
		}
		i :u64
		while (row[i].x - cur.x) < 0.1
		{
			i++
		}
		*out_idx_on_same_x = i
		return true;
	}

	return false;
}
level_str_offset::fn(str: str_lit, x : u32, y : u32, width: u32) ! *char
{
	// y * 2 accounts for \n\r
	return str[cast(u64)(2 + x + y * width + y * 2)]
}
create_map_from_str::fn(ctx : *context, str : str_lit, final_t : *_vec)
{
	width : u32
	i : u32
	len := str_ln(str)
	while (*str[width + 2] != '\n && *str[width + 2] != '\r)
	{
		width++
	}

	height :u64
	i = 2
	while i < cast(u32)len
	{
		if *str[i] == '\n
		{
			height++
		}
		i++
	}
	height++
	i = 0

	// subing 2 because the first character is a new line


	blocks_grid : dyn_array(dyn_array(_vec))
	wp : waypoint


	for y in 0..height
	{
		cur_ar : dyn_array(_vec)
		dyn_init2(&cur_ar, width, ctx.alloc)
		for x in 0..width
		{
			fx := cast(f32)x
			fy := cast(f32)(height - cast(u64)y)
			ch := *level_str_offset(str, cast(u32)x, cast(u32)y, width)
			if ch == '-
			{
				last_on_x := cast(u64)x >= (width - 1)
				last_on_y := cast(u64)y >= (height - 1)
				first_on_x := x == 0
				first_on_y := y == 0

				if !last_on_x && !last_on_y  && !first_on_x && !first_on_y
				{
					prev_x := *level_str_offset(str, cast(u32)x - 1, cast(u32)y, width)
					next_x := *level_str_offset(str, cast(u32)x + 1, cast(u32)y, width)

					prev_y := *level_str_offset(str, cast(u32)x, cast(u32)y - 1, width)
					next_y := *level_str_offset(str, cast(u32)x, cast(u32)y + 1, width)

					if prev_x == '- && next_x == '- && prev_y == '- && next_y == 'n
					{
						continue
					}
				}
				v :_vec
				v.x = fx
				v.y = fy
				v.z = 0.1
				dyn_add(&cur_ar, &v)

			}
			else if ch == 'p
			{
				ctx.player.pos.x = fx
				ctx.player.pos.y = fy
				ctx.player.pos.z = 0.1
				ctx.player.pos.w = 0.0
				dyn_add(&ctx.drawable_ents, ctx.player)
			}
			else if ch == 't
			{
				final_t.x = fx
				final_t.y = fy
				final_t.z = 0.0
				final_t.w = 0.0
			}
			else if ch == 'w
			{
				wp.pos.x = fx + 0.5
				wp.pos.y = fy + 0.5

				dyn_add(&ctx.waypoints, &wp)
			}
		}
		dyn_add(&blocks_grid, &cur_ar)
	}

	y : u64
	while has_blocks_left(&blocks_grid, &y)
	{
		row_ar := blocks_grid[y]
		start_pos :_vec= *row_ar[0]

		
		next_is_contiguous := false

		contiguous_width := 0

		cur_b :u64=1
		cur_prev := start_pos
		if row_ar.count > 1
		{

			while cur_b < row_ar.count && (row_ar[cur_b].x - cur_prev.x) < 1.1
			{
				next_is_contiguous = true
				cur_prev = *row_ar[cur_b]
				cur_b++
			}
		}


		sz :_vec
		sz.x = 1.0
		sz.y = 1.0
		if next_is_contiguous
		{
			sz.x = cast(f32)cur_b
			while cur_b > 0
			{
				dyn_rem(row_ar, 0)
				cur_b--
			}
		}
		else
		{
			down_is_contiguous := false

			cur_downwards_idx := y

			if y < (blocks_grid.count - 1)
			{
				next_row := blocks_grid[cur_downwards_idx + 1]
				out_below_block_idx : u64
				while below_block_is_contiguous(&blocks_grid, &cur_prev, str, width, &out_below_block_idx)
				{
					cur_prev = *next_row[out_below_block_idx]
					dyn_rem(next_row, cast(u32)out_below_block_idx)

					cur_downwards_idx++

					next_row = blocks_grid[cur_downwards_idx]
				}

			}
			else
			{
				idx_block_to_remove :u32
				for b in *row_ar
				{
					if (b.x - start_pos.x) < 0.1
					{
						break;
					}
					idx_block_to_remove++
				}
				ASSERT(idx_block_to_remove < cast(u32)row_ar.count)
				dyn_rem(row_ar, idx_block_to_remove)

				cur_downwards_idx++
			}
			block_height := cur_downwards_idx - y
			sz.y = cast(f32)block_height
		}
		ent := NewEnt(ctx.alloc, "block");
		ent.is_active = true;
		ent.pos = start_pos
		ent.pos.z = 0.1
		ent.col_size = sz
		//ent.col_size.y = 1.0
		ent.size = ent.col_size
		ent.is_static = true;
		ent.color.w = 1.0
		dyn_add(&ctx.drawable_ents, &ent);
		add_body(ctx, ent);

		block_width := 1
	}

	for cur_w in ctx.waypoints
	{
		for aux_w in ctx.waypoints
		{
			if aux_w == cur_w
			{
				continue;
			}
			col : collision
			if !Raycast(ctx, &cur_w.pos, &aux_w.pos, &col, LAYER_TRIGGER | LAYER_PLAYER, nil)
			{
				dyn_add(&cur_w.neighbors, aux_w)
			}
		}
	}
}
head_long_term_meeting_diff::fn(ctx : *context, t : *thinking, out : *f32) ! bool
{
	head:*long_term_action = t.long_term_acts[0]
	if *head == long_term_action.MEETING_AT
	{
		*out = head.MEETING_AT.hour - ctx.time_since_start
		return true
	}

	return false
}
add_long_term::fn(t : *thinking, r : *long_term_action)
{
	dyn_add(&t.long_term_acts, r)
}
add_mid_term::fn(t : *thinking, r : *rated_stuff(mid_term_action))
{
	lesser_idx : u32

	for cur_r in t.mid_term_acts
	{
		if r.val > cur_r.val 
		{
			break
		}
		lesser_idx++
	}

	if cast(u64)lesser_idx >= t.mid_term_acts.count
	{
		dyn_add(&t.mid_term_acts, r)
	}
	else
	{
		dyn_add_at(&t.mid_term_acts, lesser_idx, r)
	}
}
has_mid_term::fn(t : *thinking, type : u32) !bool
{
	for m in t.mid_term_acts
	{
		if cast(u32)m.type == type
		{
			return true
		}
	}
	return false
}

check_mid_term_adding::fn(ctx : *context, e : *entity, dt  : *f32)
{
	t : *thinking= e.thoughts
	mid := &t.mid_term_acts
	diff : f32

	no_short_terms := t.short_term_acts.count == 0

	if no_short_terms 
		&& head_long_term_meeting_diff(ctx, t, &diff) 
		&& diff > -20.0
		&& !has_mid_term(t, cast(u32)mid_term_action.TEST)
	{
		r : rated_stuff(mid_term_action)
		r.val = 10.0
		r.type.type = mid_term_action.TEST
		r.type.TEST.secs = 5.0
		add_mid_term(t, &r)
	}
}
mid_term::fn(ctx : *context, e : *entity, dt  : *f32)
{
	t : *thinking= e.thoughts

	if t.mid_term_acts.count == 0
	{
		return;
	}
	head_r:*rated_stuff(mid_term_action) = t.mid_term_acts[0]
	head :*mid_term_action= &head_r.type

	if *head == mid_term_action.TEST
	{
		if head.TEST.frames % 30 == 0
		{
			r : short_term_action
			r.type = short_term_action.SAY
			r.SAY.str = "hello"
			dyn_add(&t.short_term_acts, &r)
		}
		head.TEST.cur += *dt
		head.TEST.frames++

		if head.TEST.cur >= head.TEST.secs
		{
			dyn_rem(&t.mid_term_acts, 0)
		}
	}
	else if *head == mid_term_action.MEETING_AT 
	{
		if !head_r.in_curse
		{
			long_t := t.long_term_acts[cast(u64)head.MEETING_AT.long_term]

			go_path : short_term_action
			go_path.type = short_term_action.GO_PATH

			closest_wp := get_closest_waypoint(&ctx.waypoints, &e.pos)
			ASSERT(closest_wp)
			
			find_wpath(ctx, closest_wp, &long_t.MEETING_AT.pos, &go_path.GO_PATH.path)

			dyn_clear(&t.short_term_acts)
			
			dyn_add(&t.short_term_acts, &go_path)
			head_r.in_curse = true
		}
	}
}
set_vel_dir_ret_dist::fn(vel : *_vec, start : *_vec, end : *_vec, vel_mul : f32, normal : *_vec) ! f32
{
	dir := (*end - *start)
	dist := dot_vec(&dir, &dir)
	dir = normalize_vec(&dir)

	*vel = dir * vel_mul
	if normal
	{
		normal.x = dir.y
		normal.y = -dir.x
	}
	return dist
}
short_term::fn(ctx : *context, e : *entity, dt  : *f32)
{
	t : *thinking= e.thoughts

	if t.short_term_acts.count == 0
	{
		return 
	}
	head:*short_term_action = dyn_last(&t.short_term_acts)

	if *head == short_term_action.SAY
	{
		printf(head.SAY.str)
		dyn_rem(&t.short_term_acts, 0)
	}
	else if *head == short_term_action.GO_TO
	{
		normal :_vec
		dir := (head.GO_TO.pos - e.pos)
		dist := dot_vec(&dir, &dir)
		dir = normalize_vec(&dir)

		e.vel = dir
		normal.x = dir.y
		normal.y = -dir.x

		left_ray_start:= e.pos + normal * 0.5
		right_ray_start:= e.pos + normal * -0.5
		left_ray_end:= left_ray_start + dir * 1.5
		right_ray_end:= right_ray_start + dir * 1.5

			/*
		draw:draw_info

		draw.pos.x = left_ray_start.x
		draw.pos.y = left_ray_start.y
		draw.pos.z = left_ray_end.x
		draw.pos.w = left_ray_end.y
		draw.flags = DRAW_INFO_LINE
		*draw.color[1] = 1.0
		*draw.color[3] = 1.0
		draw.cam_pos = ctx.cam_pos_global;
		draw.cam_size = ctx.cam_size;
		Draw(ctx.window, &draw)

		head.GO_TO.frames++

		if (head.GO_TO.frames % 15) == 0
		{
			head.GO_TO.flags = 0


			col : collision
			out : *entity
			if Raycast(ctx, &left_ray_start, &left_ray_end, &col, LAYER_PLAYER | LAYER_TRIGGER, &out)
			{
				head.GO_TO.flags = 1
				printf("left ent name %\n", col.ent.name)
			}
			else if Raycast(ctx, &right_ray_start, &right_ray_end, &col, LAYER_PLAYER | LAYER_TRIGGER, &out)
			{
				head.GO_TO.flags = 2
				printf("right ent name %\n", col.ent.name)
			}

			surface_dir: _vec
			surface_dir.x = col.normal.y
			surface_dir.y = col.normal.x
			// left ray col
			if head.GO_TO.flags == 1
			{
				if dot_vec(&surface_dir, &dir) < 0.0
				{
					surface_dir = surface_dir * -1.0
				}
			}
			// right ray col
			else if head.GO_TO.flags == 1
			{
				if dot_vec(&surface_dir, &dir) > 0.0
				{
					surface_dir = surface_dir * -1.0
				}
			}


			head.GO_TO.x_vel_when_ray_col = cast(s8)cast(s32)(surface_dir.x * 128.0)
			head.GO_TO.y_vel_when_ray_col = cast(s8)cast(s32)(surface_dir.y * 128.0)
		}
		if head.GO_TO.flags != 0
		{
			x := (cast(f32)cast(s32)head.GO_TO.x_vel_when_ray_col) / 128.0
			y := (cast(f32)cast(s32)head.GO_TO.y_vel_when_ray_col) / 128.0

			e.vel.x = x
			e.vel.y = y
		}
		*/
		//else
		//{
			e.vel = dir
			if dist < 0.01
			{
				t.short_term_acts.count--
			}
		//}

	}
	else if *head == short_term_action.GO_PATH
	{
		last := head.GO_PATH.path.count - 1
		cur := head.GO_PATH.cur_path
		pos := head.GO_PATH.path[last - cur]

		head.GO_PATH.cur_path++

		if cur > cast(u32)last
		{
			dyn_rem(&t.short_term_acts, 0)
		}
		else
		{
			r : short_term_action
			r.type = short_term_action.GO_TO
			r.GO_TO.pos = *pos
			dyn_add(&t.short_term_acts, &r)
		}
	}
	else
	{
		__dbg_break
	}
	i := 0

}
long_term::fn(ctx : *context, e : *entity, dt  : *f32)
{
	t : *thinking= e.thoughts

	if t.long_term_acts.count == 0
	{
		return;
	}
	head:*long_term_action = t.long_term_acts[0]
	if *head == long_term_action.MEETING_AT
	{
		diff := head.MEETING_AT.hour - ctx.time_since_start
		if diff < 0.0
		{
			//__dbg_break
			if t.short_term_acts.count == 0 && !has_mid_term(t, cast(u32)mid_term_action.MEETING_AT)
			{
				r : rated_stuff(mid_term_action)
				r.type.type = mid_term_action.MEETING_AT
				r.type.MEETING_AT.long_term = 0
				r.val = 40.0
				
				add_mid_term(t, &r)
			}
			diff = 0.0
		}
	}
	else
	{
		__dbg_break
	}
}
thinking_ents::fn(ctx : *context, dt  : *f32)
{
	for e in ctx.ents_think
	{
		t: *thinking = e.thoughts
		long_term(ctx, *e, dt)
		if t.check_mid_term
		{
			check_mid_term_adding(ctx, *e, dt)
			t.check_mid_term = false
		}
		mid_term(ctx, *e, dt)
		short_term(ctx, *e, dt);
	}
}
new_thinking::fn(ctx : *context, e : *entity)
{
	e.thoughts = cast(*thinking)heap_alloc(globals.alloc, sizeof(thinking))
	dyn_add(&ctx.ents_think, e)

}

test_ang ::fn(a : s32)
{
	axis : _vec
	axis.z = 0.0
	axis.x = 0.0
	axis.y = 1.0
	forward : _vec
	forward.z = 1.0
	
	rot :_vec
	ang := 3.1415 / 4.0
	s := sin(ang)
	rot.x = axis.x * s
	rot.y = axis.y * s
	rot.z = axis.z * s
	rot.w = cos(ang)

	rotate_vector(&forward, &forward, &rot)

	//print_vec(&forward)
	
}
draw_vertex ::fn(ctx : *context, pos : *_vec, sz : *_vec, cam_pos : *_vec, cam_rot : *_vec)
{
	draw : draw_info3d
	draw.pos = *pos
	draw.ent_size = *sz
	//print_vec(&draw.ent_size)
	*draw.color[0] = 1.0
	*draw.color[1] = 1.0
	*draw.color[2] = 1.0
	*draw.color[3] = 1.0
	draw.cam_pos = cam_pos;
	draw.cam_rot = cam_rot;
	Draw3D(ctx.window, &draw)
}
draw_line::fn(ctx : *context, start : *_vec, end : *_vec, col : *_vec, tip : bool)
{
	draw : draw_info3d
	draw.flags =  DRAW_INFO_LINE;
	draw.pos = *start
	draw.ent_size = *end
	//print_vec(&draw.ent_size)
	memcpy(draw.color, col, 4 * 4);
	draw.cam_pos = ctx.cam_pos_global;
	draw.cam_rot = ctx.cam_rot_global;
	Draw3D(ctx.window, &draw)
	if tip
	{
		v_sz: _vec=?
		v_sz.x = 0.05
		v_sz.y = 0.05
		v_sz.z = 0.05
		v_sz.w = 1.0
		draw_vertex(ctx, end, &v_sz, ctx.cam_pos_global, ctx.cam_rot_global)
	}

}

cam_mov::fn(ctx : *context)
{
	axis : _vec
	axis.z = 0.0
	axis.x = 0.0
	axis.y = 1.0
	aux_forward := ctx.cam_aux_forward_global
	cam_forward := ctx.cam_forward_global
	cam_pos := ctx.cam_pos_global
	cam_rot := ctx.cam_rot_global

	speed := 5.0
	dt := 0.017

	if IsKeyHeld(key_enum.KEY_Q)
	{
		cam_pos.y += dt * speed
	}
	if IsKeyHeld(key_enum.KEY_E)
	{
		cam_pos.y -= dt * speed
	}
	if IsKeyDown(key_enum.KEY_F2)
	{
		globals.tog = !globals.tog
	}
	cross := cross_vec(cam_forward, &axis)
	if IsKeyHeld(key_enum.KEY_A)
	{
		*cam_pos -= cross * dt * speed

	}
	if IsKeyHeld(key_enum.KEY_D)
	{
		*cam_pos += cross * dt * speed
	}
	if IsKeyHeld(key_enum.KEY_W)
	{
		*cam_pos += *cam_forward * dt * speed
	}
	if IsKeyHeld(key_enum.KEY_S)
	{
		*cam_pos -= *cam_forward * dt * speed
	}
	
	dt = dt * 2.0
	if IsKeyHeld(key_enum.KEY_SHIFT)
	{
		if IsMouseHeld(mouse_enum.LEFT)
		{
			*cam_forward = euler_to_quaternion(0.0, radians_to_degree(dt), 0.0) * *cam_forward

			cam_rot.y += dt
			//cam_rot.x += dt
		}
		if IsMouseHeld(mouse_enum.RIGHT)
		{
			*cam_forward = euler_to_quaternion(0.0, -radians_to_degree(dt), 0.0) * *cam_forward

			cam_rot.y -= dt
			//cam_rot.x += dt
		}
	}
	else if IsKeyHeld(key_enum.KEY_JMP)
	{

		if IsMouseHeld(mouse_enum.LEFT)
		{
			cam_rot.x += dt
		}
		if IsMouseHeld(mouse_enum.RIGHT)
		{
			cam_rot.x -= dt
		}
	}
	//print_vec(cam_forward);
}
view_collision ::fn(ccc : u32)
{
	return;
	curmx := GetMouseNormalizedPosX();
	curmy := GetMouseNormalizedPosY();

	ctx := cast(*context)globals.ctx
	gjk := cast(*gjk_state)globals.gjk
	if !gjk
		return;
	ClearBackground(0.7, 0.7, 0.7);

	cam_pos := ctx.cam_pos_global
	cam_rot := ctx.cam_rot_global

	e1 := gjk.col1.ent
	e2 := gjk.col2.ent
	mx := &globals.mx
	my := &globals.my
	cam_mov(ctx)

	//printf("curx %, mx %\n", cast(s32)(curmx * 100.0), cast(s32)(*mx * 100.0))

	e1.color.w = 0.3;
	e2.color.w = 0.6;

	e1.flags = e1.flags | ENTITY_TRANSPARENT;
	e2.flags = e2.flags | ENTITY_TRANSPARENT;

	*mx = GetMouseNormalizedPosX() - curmx;
	*my = GetMouseNormalizedPosY() - curmy;

	DrawEntity(ctx, e1, cam_pos, cam_rot)
	DrawEntity(ctx, e2, cam_pos, cam_rot)

	orig : _vec

	v_sz: _vec=?
	v_sz.x = 0.1
	v_sz.y = 0.1
	v_sz.z = 0.1
	v_sz.w = 1.0
	draw_vertex(ctx, &gjk.sup1, &v_sz, cam_pos, cam_rot)
	draw_vertex(ctx, &gjk.sup2, &v_sz, cam_pos, cam_rot)

	draw_line(ctx, &gjk.sup1, &gjk.sup2, &v_sz, true);

	simplex_col : _vec
	simplex_col.x = 1.0
	simplex_col.y = 1.0
	simplex_col.z = 1.0
	draw_line(ctx, &orig, &gjk.dir, &simplex_col, true);
	simplex_col.y = 0.0
	simplex_col.z = 0.0

	start : _vec= ?
	end : _vec= ?
	cross : _vec= ?
	if IsKeyHeld(key_enum.KEY_1)
	{
		draw_vertex(ctx, &gjk.simplex[0], &v_sz, cam_pos, cam_rot)
	}
	if IsKeyHeld(key_enum.KEY_2)
	{
		draw_vertex(ctx, &gjk.simplex[1], &v_sz, cam_pos, cam_rot)
	}
	if IsKeyHeld(key_enum.KEY_3)
	{
		draw_vertex(ctx, &gjk.simplex[2], &v_sz, cam_pos, cam_rot)
	}
	if IsKeyHeld(key_enum.KEY_4)
	{
		draw_vertex(ctx, &gjk.simplex[3], &v_sz, cam_pos, cam_rot)
	}
	on gjk.simplex_verts
	{
	2
	{
		draw_line(ctx, gjk.simplex[0], gjk.simplex[1], &simplex_col, true);

		if IsKeyHeld(key_enum.KEY_F1)
		{
			a := gjk.simplex[0]
			b := gjk.simplex[1]

			ab := *b - *a
			ao := -*a

			cross = cross_vec(&cross_vec(&ab, &ao), &ab)
			start = *a + ab / 2.0
			end = start + cross

			draw_line(ctx, &start, &end, &simplex_col, false);

			if(same_direction(&ab, &ao))
			{
				printf("the same dir\n")
			}
			else
			{
				printf("not in the same dir\n")
			}
		}
	}
	3
	{

		draw_line(ctx, gjk.simplex[0], gjk.simplex[1], &simplex_col, false);
		draw_line(ctx, gjk.simplex[0], gjk.simplex[2], &simplex_col, false);
		draw_line(ctx, gjk.simplex[1], gjk.simplex[2], &simplex_col, false);

		a := gjk.simplex[0]
		b := gjk.simplex[1]
		c := gjk.simplex[2]

		ab := *b - *a
		ac := *c - *a
		ao := -*a

		abc := cross_vec(&ab, &ac)
		cross = cross_vec(&abc, &ac)
		start = *a + ac / 2.0
		end = start + cross

		simplex_col.y = 1.0
		draw_line(ctx, &start, &end, &simplex_col, false);

		if IsKeyHeld(key_enum.KEY_F1)
		{
			cross = cross_vec(&cross_vec(&ac, &ao), &ac)
			end = start + cross
			simplex_col.z = 1.0
			draw_line(ctx, a, &end, &simplex_col, false);

			simplex_col.y = 0.5
			simplex_col.z = 0.5
			draw_line(ctx, a, &(-*a), &simplex_col, false);

			if same_direction(&ac, &ao)
			{
				printf("the same dir\n")
			}
			else
			{
				printf("not in the same dir\n")
			}
		}
	}
	4
	{
		draw_line(ctx, gjk.simplex[0], gjk.simplex[1], &simplex_col, false);
		draw_line(ctx, gjk.simplex[0], gjk.simplex[2], &simplex_col, false);
		draw_line(ctx, gjk.simplex[0], gjk.simplex[3], &simplex_col, false);
		draw_line(ctx, gjk.simplex[1], gjk.simplex[2], &simplex_col, false);
		draw_line(ctx, gjk.simplex[1], gjk.simplex[3], &simplex_col, false);
		draw_line(ctx, gjk.simplex[3], gjk.simplex[2], &simplex_col, false);

	}
	}
	a := 0


	Draw3DTransparency(ctx.window);

}
print_f32::fn(a : f32)
{
	printf("f %\n", cast(s32)(a * 100.0))
}

main_loop::fn(ctx : *context)
{
	ctx.up.y = 1.0

	dyn_init2(&ctx.coroutines.funcs, 2, ctx.alloc);

	LinearInit(&globals.entities, ctx.alloc, 32)
	LinearInit(&globals.str_alloc, ctx.alloc, 128)
	LinearInit(&globals.allocs_occured, ctx.alloc, 32)
	LinearInit(&globals.temp_alloc, ctx.alloc, 128)
	LinearInit(&globals.nodes_alloc, ctx.alloc, 512)
	LinearInit(&globals.ast_alloc, ctx.alloc, 512)


	//using ctx;
	draw:draw_info3d;
	//AssignCamStuff(scn, &draw);
	pos :_vec;
	speed :f32= 10.0;
	cam_pos: _vec;
	cam_rot: _vec;
	cam_rot.z = 0.0;
	cam_rot.y = 0.0;
	other_block :_vec;
	other_block.x = 5.0;
	other_block.y = 0.0;

	ctx.cam_pos_global = &cam_pos;
	cam_pos.z = 5.0

    cinfo: col_info;
    col: collision;

	col.contacts.alloc = ctx.alloc;
	dyn_init(&col.contacts, 2);
	col.contacts.count = 1;


	player_ent:*entity=NewPlayerEnt(ctx, "player");

	ctx.player = player_ent;
	
	ctx.already_allocated_ents_count = globals.entities.cur;
	ctx.already_allocated_str_count = globals.str_alloc.cur;
	
	dyn_init2(&ctx.masking_objs, 4, ctx.alloc);
	dyn_init2(&ctx.start_pos, 4, ctx.alloc);


	//add_body(ctx, enemy_ent);
	//add_body(ctx, &ground2)

	last_time : = GetTime();

	keys: input_info;

	cam_wiggle_time:f32;
	cam_wiggle_timer:f32;
	cam_wiggle_rot_time:f32;
	cam_wiggle_rot_timer:f32;
	
	
	ctx.draw_col = true;
	//ctx.draw_origin = true;

	//__dbg_break
	layers : dyn_array(*layer_sprites);
	dyn_init2(&layers, 8, ctx.alloc);
	ctx.layers_ptr = &layers;

	ctx.alloc = &ctx.per_scene_alloc;
	ctx.already_allocated_mem_count = cast(u32)cast(u64)GetMem(1);
	//OpenSceneGame(ctx, "../scenes/01", &layers, &ctx.textures);
	ctx.cam_size = 5.0;
	//ctx.cam_size_original = ctx.cam_size;


	info_3d : draw_info3d
	globals.after_init = true

	dyn_add(&ctx.drawable_ents, &player_ent);
	player_ent.flags = player_ent.flags | ENTITY_3D
	player_ent.pos.x = 0.0
	player_ent.pos.y = -1.0

	other := NewEnt(ctx.alloc, "block 1")
	other.flags = other.flags | ENTITY_3D
	dyn_add(&ctx.drawable_ents, other)
	other.is_active = true
	other.pos.x = 0.0
	other.pos.y = -2.0
	other.size.z = 20.0
	other.size.x = 20.0

	other = NewEnt(ctx.alloc, "block 1")
	other.flags = other.flags | ENTITY_3D
	dyn_add(&ctx.drawable_ents, other)
	other.is_active = true
	other.pos.x = 20.0
	other.size.z = -20.0

	other = NewEnt(ctx.alloc, "block 2")
	other.flags = other.flags | ENTITY_3D
	dyn_add(&ctx.drawable_ents, other)
	other.is_active = true
	other.pos.x = 30.0
	other.size.x = 30.0

	other = NewEnt(ctx.alloc, "enemy")
	add_body(ctx, other)
	dyn_add(&ctx.drawable_ents, other)
	other.flags = other.flags | ENTITY_3D

	other.pos.y = -1.0
	other.pos.x = -0.1
	other.pos.z = -20.6
	other.size.z = 1.0
	other.is_active = true
	other.is_static = true

	mx := GetMouseScreenPosX();
	my := GetMouseScreenPosY();

	forward : _vec
	forward.z = -1.0

	cam_forward : _vec
	cam_forward.z = -1.0



	//cam_rot.y = 1.5708

	ctx.cam_rot_global = &cam_rot;
	ctx.cam_forward_global = &cam_forward;

	axis : _vec
	axis.z = 0.0
	axis.x = 0.0
	axis.y = 1.0
	aux_forward := cam_forward
	ctx.cam_aux_forward_global = &aux_forward;

	cam_to_player_dist := 10.0

	h : f32
	v : f32

	timer_for_cam_go_back_of_player : f32
	ang_diff_for_cam_go_back_of_player : f32

	player_back_pos := player_ent.pos - cam_forward * cam_to_player_dist + ctx.up * 2.0
	cam_start_pos_before_rotate_to_back_pos :_vec
	on_rotating_cam := false
	while !ShouldClose(ctx.window)
	{
		globals.timer = 0.0;
		{
			//start_pos:_vec = ? ;
			//end_pos:_vec = ? ;

			//out_ent: *entity;
			/*
			if !Raycast(ctx, &start_pos, &end_pos, &col, LAYER_TRIGGER, &out_ent)
			{
				ChangeBehaviour(enemy_ent, behaviour_state.GET_CLOSER_THEN_ATTACK);
				//PrintV3(5.0, 0.0, 0.0);
			}
			*/
		}
		//PrintV3(einfo.forward.x, 0.0, 0.0);

		curmx := GetMouseNormalizedPosX();
		curmy := GetMouseNormalizedPosY();

		dt: = GetTime() - last_time;
		//dt: = 0.017;
		last_time = GetTime();
		ctx.time_since_start += dt


		ClearBackground(0.7, 0.7, 0.7);

		f := 0.5
		player_ent.color.x = f
		player_ent.color.y = f
		player_ent.color.z = f
		other.color.x = f
		other.color.y = f
		other.color.z = f

		ang: f32=?
		cross := cross_vec(&ctx.up, &cam_forward)
		if IsKeyHeld(key_enum.KEY_W)
		{
			v += dt * speed
		}
		else if IsKeyHeld(key_enum.KEY_S)
		{
			v -= dt * speed
		}
		else
		{
			v += -v * dt * speed
		}

		if IsKeyHeld(key_enum.KEY_A)
		{
			h += dt * speed
		}
		else if IsKeyHeld(key_enum.KEY_D)
		{
			h -= dt * speed
		}
		else
		{
			h += -h * dt * speed
		}
		v = clamp(v, -1.0, 1.0)
		h = clamp(h, -1.0, 1.0)

		ab := (absf(v) + absf(h))
		weight := clamp(ab - 1.0, 0.0, 1.0) + 1.0
		actual_forward := cam_forward * v + cross * h
		actual_forward = actual_forward / weight
		player_ent.pos += actual_forward * dt * speed

		if dot_vec(&actual_forward, &actual_forward) > 0.01 && !on_rotating_cam
		{
			forward = normalize_vec(&actual_forward)
		}
		//print_vec(&actual_forward)


		ang = angle_on_axis(&aux_forward, &forward, &ctx.up)
		player_ent.rot = euler_to_quaternion(0.0, radians_to_degree(-ang), 0.0).v

		//cam_mov(ctx)

		
		add_cam_forward := cam_forward
		if ab > 1.5
		{

			add_cam_forward += (forward - add_cam_forward)
		}

		target_pos := player_ent.pos - add_cam_forward * cam_to_player_dist + ctx.up * 2.0

		if IsKeyDown(key_enum.KEY_ACT0)
		{
			timer_for_cam_go_back_of_player = 0.0
			cam_start_pos_before_rotate_to_back_pos = player_back_pos
			ang_diff_for_cam_go_back_of_player = angle_on_axis(&cam_forward, &forward, &ctx.up)
			print_f32(ang_diff_for_cam_go_back_of_player)
			if(ang_diff_for_cam_go_back_of_player < -PI)
			{
				__dbg_break
				ang_diff_for_cam_go_back_of_player = angle_on_axis(&cam_forward, &forward, &ctx.up)
			}
		}
		add_mul := 1.0
		if IsKeyHeld(key_enum.KEY_ACT0)
		{
			timer_for_cam_go_back_of_player += dt
			time_for_complete_rot := 0.5
			on_rotating_cam = true
			add_mul = 4.0
			if timer_for_cam_go_back_of_player < (time_for_complete_rot + 0.1)
			{
				local_pos_back_rot := cam_start_pos_before_rotate_to_back_pos - player_ent.pos

				p := timer_for_cam_go_back_of_player / time_for_complete_rot
				p = clamp(p, 0.0, 1.0)

				ang = p * ang_diff_for_cam_go_back_of_player
				local_pos_back_rot = euler_to_quaternion(0.0, radians_to_degree(ang), 0.0) * local_pos_back_rot
				target_pos = local_pos_back_rot + player_ent.pos
				player_back_pos = target_pos
			}
			else
			{
				target_pos = player_ent.pos - forward * cam_to_player_dist + ctx.up * 2.0
				player_back_pos = target_pos
			}
		}
		else
			on_rotating_cam = false;
		
		player_back_pos += (target_pos - player_back_pos) * dt * 4.0
		dir_to_player := (cam_pos-player_ent.pos)
		dist := len_vec(&dir_to_player)

		if dist <= cam_to_player_dist && !on_rotating_cam
		{
			target_pos_limit := player_ent.pos - cam_forward * cam_to_player_dist + ctx.up * 2.0
			target_pos_to_other := target_pos - target_pos_limit
			player_back_pos = target_pos_limit
		}
		dir_to_cam := (player_back_pos - cam_pos)

		cam_pos += dir_to_cam * dt * 4.0 * add_mul
		
		dir := ctx.player.pos - cam_pos
		dist = len_vec(&dir)
		dir = normalize_vec(&dir)

		ang = angle_on_axis(&aux_forward, &dir, &ctx.up)
		cam_rot.y = ang
		cam_forward = euler_to_quaternion(0.0, radians_to_degree(ang), 0.0) * aux_forward

		//print_vec(&forward)
		draw.flags = DRAW_INFO_TRIANGLE
		draw.pos.x = 1.0
		draw.pos.y = 0.0
		draw.pos.z = -6.0
		draw.pivot.x = 0.0
		draw.pivot.y = 6.0
		draw.pivot.z = -6.0
		draw.cam_pos = &cam_pos
		draw.cam_rot = &cam_rot
		draw.cam_forward = &cam_forward
		draw.ent_size.x = 6.0
		draw.ent_size.y = 0.0
		draw.ent_size.z = -6.0
		Draw3D(ctx.window, &draw)

		PhysicsUpdate(ctx, dt)
		DrawEnts(ctx, ctx.cam_pos_global, &cam_rot)
		

		mx = GetMouseNormalizedPosX() - curmx;
		my = GetMouseNormalizedPosY() - curmy;
		EndFrame(ctx.window);
		ctx.frames_total++;
	}
}

move_color_in_time::fn(src_original : *v4, src : *v4, dst_x : f32, dst_y : f32, dst_z : f32, dst_w : f32, dt : f32, time : f32) ! bool
{
	dst:v4;
	dst.x = dst_x;
	dst.y = dst_y;
	dst.z = dst_z;
	dst.w = dst_w;
	dir:= dst - *src;
	dir_og:= dst - *src_original;
	dir_og_len:= len_v4(&dir_og);

	norm := normalize_v4(&dir);

	*src = *src + norm * (dt / time) * dir_og_len;

	if len_v4(&dir) < 0.01
		return true;

	return false;

}
move_vec::fn(src : *_vec, dst_x : f32, dst_y : f32, dst_z : f32, dt : f32, vel : f32) ! bool
{
	dst:_vec;
	dst.x = dst_x;
	dst.y = dst_y;
	dst.z = dst_z;
	dir:= dst - *src;

	norm := normalize_vec(&dir);

	*src = *src + norm * dt * vel;

	if len_vec(&dir) < 0.1
		return true;

	return false;

}

UpdateEntsWithClips::fn(ctx : *context, dt : f32)
{
	if ctx.ents_with_clip.count == 0
		return;
	for e in ctx.ents_with_clip
	{
		if e.cl == nil || !e.is_active
			continue;
		//__dbg_break;
		UpdateClip2(*e, dt);
		
	}
}

