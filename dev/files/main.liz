	ctx.prntr.pos.y = -0.5;
	
	ctx.axe_tex = LoadTex("axe.png", 0, 0, 32, 32);
	ctx.col_mask_tex = LoadTex("col_mask.png", 0, 0, 256, 256);

	*ctx.curtain[0] = 0.0;
	*ctx.curtain[1] = 0.0;
	*ctx.curtain[2] = 0.0;
	*ctx.curtain[3] = 0.0;
