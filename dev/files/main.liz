new_cube::fn(ctx : *scene_info, pos : *_vec, size : *_vec, col : bool) ! *entity
{
	other := NewEnt(ctx, "block 1")
	other.pos = *pos
	other.size = *size
	other.col_size.x = 1.0
	other.col_size.y = 1.0
	other.col_size.z = 1.0
	other.flags = other.flags | ENTITY_3D | ENTITY_HAS_TEXTURE | ENTITY_SERIALIZE
	other.flags = other.flags & ~ENTITY_TRANSPARENT
	dyn_add(&ctx.drawable_ents, other)
	//dyn_add(&ctx.ents, other)
	other.is_active = true
	other.is_static = true
	other.model.asset_idx = ASSETS_MODELS_OFFSET

	dyn_add(&other.remove_from, ent_part_of.DRAWABLE)
	//dyn_add(&other.remove_from, ent_part_of.INSTANTIATED)

	if col
	{
		dyn_add(&other.remove_from, ent_part_of.COLLIDER)
		add_body(ctx, other)
	}
	grid_shader := find_shader(ctx, "grid.mat")

	other.flags = other.flags | ENTITY_CUSTOM_SHADER

	if other.material_idx.asset_idx != grid_shader.asset_idx
	{
		other.material_idx = grid_shader
		other.in_material_instance = new_material_instance(ctx, &grid_shader, other)
	}
	set_shader_uniform_sampler2d(ctx, other, "tex", &globals.grid_tex)


	return other
}
new_axis_ent::fn(ctx : *scene_info, name : str_lit, sz : *_vec, col : *_vec) ! *entity
{
	ret := NewEnt(ctx, name)
	ret.is_active = false
	ret.is_trigger = true
	ret.type = ent_type.AXIS
	ret.flags = ret.flags | ENTITY_ALWAYS_ON_FRONT | ENTITY_3D | ENTITY_DONT_FREE | ENTITY_TRANSPARENT
	ret.col_size.x = 1.0
	ret.col_size.y = 1.0
	ret.col_size.z = 1.0
	ret.model.asset_idx = ASSETS_MODELS_OFFSET 
	ret.size = *sz
	memcpy(&ret.color, col, 16)
	dyn_add(&ctx.drawable_ents, ret)
	add_body(ctx, ret)

	ret.cols[0].size.x = 1.0
	ret.cols[0].size.y = 1.0
	ret.cols[0].size.z = 1.0

	return ret
}
