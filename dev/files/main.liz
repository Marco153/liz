draw_inv_item::fn(ctx : *context, tex : u32, selected : bool, x : f32, y : f32)
{
	w := 0.1
	DrawSquare(ctx, x, y, w, w, &_vec{0.0, 0.0, 0.0, 1.0})

	if tex != 0
	{
			
		draw:draw_info;
		
		draw.pos.x = x
		draw.pos.y = y
		draw.ent_size.x = w
		draw.ent_size.y = w
		draw.cam_size = 1.0;
		//draw.cam_pos = ctx.cam_pos_global;
		draw.color = []f32{1.0, 1.0, 1.0, 1.0};
		draw.texture_id = tex
		draw.flags = DRAW_INFO_HAS_TEXTURE | DRAW_INFO_NO_DEPTH_TEST;
		draw.pos.z = 0.01
		Draw(ctx.window, &draw);
	}
}
