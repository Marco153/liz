raycast_get_pos::fn(ctx : *scene_info, _cam_pos : *_vec, col : *collision) !bool
{
	screenmx := GetMouseScreenPosX();
	screenmy := GetMouseScreenPosY();
	cam_pos := *_cam_pos
	dir := ScreenMouseToWorld(screenmx, screenmy)
	
	//dir.y = -dir.y
	cam_dir := cam_pos + dir * 20.0
	cam_dir2 := cam_pos + dir * 5.0

	cam_dir = cam_pos + dir * 2000.0

	aux_sel : *entity
	shortest_dist : f32 = 9999.0

	found := false
	aux_col :collision=?
	if RaycastWithNonBodies(ctx, &cam_pos, &cam_dir, col, 0, &aux_sel)
	{
		shortest_dist = len_vec(&(cam_pos - col.contact_point))
		found = true
	}
	if Raycast(ctx, &cam_pos, &cam_dir, &aux_col, 0, &aux_sel)
	{
		aux_dist := len_vec(&(cam_pos - col.contact_point))

		if aux_dist < shortest_dist 
		{
			*col = aux_col
		}
		found = true
	}
	/*
	if RaycastWithTerrain(ctx, &cam_pos, &cam_dir_terrain, trn_ent, &col)
	{
		aux_dist := len_vec(&(cam_pos - col.contact_point))

		if aux_dist < shortest_dist 
		{
			*col = aux_col
		}
		found = true
	}
	*/
	return found
}
get_rel_size_from_min_and_max_pos_in_col_chunk::fn(ctx : *scene_info, l_area : *area_col_info, _min : *_vec, _max : *_vec, out_min : *_vec, out_max : *_vec) ! bool
{
  area_col_size := l_area.area_col_size
  area_col_pos := l_area.area_col_pos
  chunk_width := l_area.chunk_width
	start_chunk_pos := area_col_pos - (area_col_size * 0.5)


	x_width := (area_col_size.x / chunk_width)
	y_width := (area_col_size.y / chunk_width)
	z_width := (area_col_size.z / chunk_width)


	*out_min = (*_min - start_chunk_pos) / chunk_width
	*out_max = (*_max - start_chunk_pos) / chunk_width

  below_x := out_min.x < 0.0 && out_max.x < 0.0
  below_y := out_min.y < 0.0 && out_max.y < 0.0
  below_z := out_min.z < 0.0 && out_max.z < 0.0

  above_x := out_min.x > x_width && out_max.x > x_width
  above_y := out_min.y > y_width && out_max.y > y_width
  above_z := out_min.z > z_width && out_max.z > z_width

  not_in_x := below_x || above_x
  not_in_y := below_y || above_y
  not_in_z := below_z || above_z

  if not_in_x || not_in_y || not_in_z 
  {
    return false
    __dbg_break
  }

	out_min.x = clamp(out_min.x, 0.0, x_width)
	out_min.y = clamp(out_min.y, 0.0, y_width)
	out_min.z = clamp(out_min.z, 0.0, z_width)

	out_max.x = clamp(out_max.x, 0.0, x_width)
	out_max.y = clamp(out_max.y, 0.0, y_width)
	out_max.z = clamp(out_max.z, 0.0, z_width)
  return true

}
get_chunks_close_to_ent::fn(ctx : *scene_info, l_area :*area_col_info, e : *entity, out : *dyn_array(*collision_chunk), min_rel_pos : *_vec, max_rel_pos : *_vec)
{
	c1 := *e.cols[0]

  area_col_size := l_area.area_col_size
  area_col_pos := l_area.area_col_pos
  chunk_width := l_area.chunk_width
	x_width := (area_col_size.x / chunk_width) + 1.0
	y_width := (area_col_size.y / chunk_width) + 1.0
	z_width := (area_col_size.z / chunk_width) + 1.0

	pos_stride := *max_rel_pos - *min_rel_pos 

	x_start := cast(s32)min_rel_pos.x
	y_start := cast(s32)min_rel_pos.y
	z_start := cast(s32)min_rel_pos.z

	x_end := cast(s32)max_rel_pos.x + 1
	y_end := cast(s32)max_rel_pos.y + 1
	z_end := cast(s32)max_rel_pos.z + 1


	for y in y_start..y_end
	{
		for z in z_start..z_end
		{
			for x in x_start..x_end
			{
				idx :=cast(u64)(x + (z * cast(s32)x_width) + (y * cast(s32)(z_width * x_width)))
				cur := l_area.col_chunks[idx]

				dyn_add(out, cur)
				a := 0
			}
		}
	}
}
assign_mesh_to_chunks::fn(ctx : *scene_info, ent : *entity)
{
	c1 := *ent.cols[0]
	tri_idx:u64
	info := &c1.MESH.info

	verts := info.verts
	tris := info.tris
	while tri_idx < info.tris_count
	{
		tri1 := *ptr_offset(tris, tri_idx, u32)
		tri2 := *ptr_offset(tris, tri_idx + 1, u32)
		tri3 := *ptr_offset(tris, tri_idx + 2, u32)
		
		v1 := ptr_offset(verts, tri1, _vec)
		v2 := ptr_offset(verts, tri2, _vec)
		_v3 := ptr_offset(verts, tri3, _vec)

    edge1 := *v2 - *v1
    edge2 := *_v3 - *v1
    cross := cross_vec(&edge1, &edge2)
    cross = normalize_vec(&cross)

		min_v := minPerComponent(v1, v2)
		min_v = minPerComponent(&min_v, _v3)

		max_v := maxPerComponent(v1, v2)
		max_v = maxPerComponent(&max_v, _v3)

    for l_area in ctx.areas_col
    {
      rel_min_v :_vec
      rel_max_v :_vec
      in_range := get_rel_size_from_min_and_max_pos_in_col_chunk(ctx, l_area, &min_v, &max_v, &rel_min_v, &rel_max_v)

      if in_range
      {
        dyn_clear(&ctx.aux_col_chunks)
        get_chunks_close_to_ent(ctx, l_area, ent, &ctx.aux_col_chunks, &rel_min_v, &rel_max_v)

        for c in ctx.aux_col_chunks
        {
          found_in_chunk := false
          found : *collision_chunk_tris

          for e_ch in c.from_ents
          {
              if e_ch.from_ent == ent
              {
                found_in_chunk = true
                found = e_ch
                break;
              }
          }

          if !found_in_chunk
          {
            cinfo:collision_chunk_tris
            cinfo.from_ent = ent
            dyn_add(&c.from_ents, &cinfo)
            found = dyn_last(&c.from_ents)
          }

          tri_info : triangle_info=?
          tri_info.ent = ent
          //tri_info.info = &c1.MESH.info
          //tri_info.tri_idx = cast(u32)tri_idx
          tri_info._v1 = *v1
          tri_info._v2 = *v2
          tri_info._v3 = *_v3
          tri_info.normal = cross
          dyn_add(&found.tris, &tri_info)
          a:=0

        }
      }
    }
    globals.temp_alloc.cur = 0
		tri_idx += 3
	}
  printf("mesh added col chunk\n")
}
assign_bodies_to_chunks::fn(ctx : *scene_info)
{
  if ctx.col_chunks == nil return
	for e_ in ctx.bodies
	{
		e := *e_
		c1 := *e.cols[0]
		if !e.is_active continue;

		if !e.is_static
		{
			c1.rel_chunk_max.x = -1.0
		}
		else if c1.type == col_type.MESH
		{
			assign_mesh_to_chunks(ctx, e)
		}
		else
		{
			min_rel_pos : _vec=?
			max_rel_pos : _vec=?

/*
			if str_cmp(e.name, "block 1_idx63")
			{
				__dbg_break
			}
			*/
			CopyVerts(c1, &min_rel_pos, &max_rel_pos)
			dyn_clear(&ctx.aux_col_chunks)
			

      l_area := ctx.col_chunks
		  in_range := get_rel_size_from_min_and_max_pos_in_col_chunk(ctx, l_area, &c1._min, &c1._max, &min_rel_pos, &max_rel_pos)

      if !in_range continue

			get_chunks_close_to_ent(ctx, l_area, e, &ctx.aux_col_chunks, &min_rel_pos, &max_rel_pos)

			for c in ctx.aux_col_chunks
			{
				dyn_add(&c.entities, e)
				a:=0
			}
		}

	}
}
copy_region_to_buffer::fn(ctx : *context, dst : *void, x_offset : u32, y_offset : u32, src_width : u32, src_height : u32, dst_width: u32, dst_height: u32, data : *u8)
{
	dst_offset :u64= x_offset * 4 + y_offset * dst_width * 4;
	src_offset :u64= 0;
	sz: = cast(u64)src_width * 4;
	//printf("xoffset %, yoffset %, src_offset %\n", x_offset, y_offset, src_offset);
	for h in 0..src_height
	{
		memcpy(ptr_offset(dst, dst_offset, u8), ptr_offset(data, src_offset, u8), sz);
		src_offset += src_width * 4;
		dst_offset += dst_width * 4;
	}
}
unpack_color::fn(col : u8) ! u32
{
	ret : u32

	brightness := cast(u32)(col >> 6)
	brightness_final :u32
	//brightness = brightness
	r := cast(u32)(col & 3)
	g := cast(u32)((col >> 2) & 3)
	b := cast(u32)((col >> 4) & 3)

	if brightness == 0
	{
		r = 0
		g = 0
		b = 0
	}
	else
	{
		brightness_final = (3 * 255) / brightness

		if r != 0
			r = (3 * 255) / r;

		if g != 0
			g = (3 * 255) / g;

		if b != 0
			b = (3 * 255) / b;

		brightness = 3 - brightness
		r_part := r / 4;
		g_part := g / 4;
		b_part := b / 4;

		r = r - (brightness * r_part)
		g = g - (brightness * g_part)
		b = b - (brightness * b_part)
	}
	ret = cast(u32)r | ((cast(u32)g) << 8)
	ret = ret | ((cast(u32)b) << 16)
	ret = ret | ((cast(u32)brightness_final) << 24)
	return ret
}
