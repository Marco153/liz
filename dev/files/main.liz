tst_st : struct
{
	val : u32,
	ar : dyn_array(cell)
	#serializable(val, ar)
}

has_blocks_left::fn(ar : *dyn_array(dyn_array(_vec)), y : *u64) ! bool
{
	*y = 0
	for ar_y in* ar
	{
		if ar_y.count > 0
		{
			return true;
		}
		*y++;
	}
	return false;
}
below_block_is_contiguous::fn(blocks_grid : *dyn_array(dyn_array(_vec)), cur : *_vec, str : str_lit, grid_width : u32, out_idx_on_same_x : *u64) ! bool
{
	if cast(u32)cur.y < cast(u32)(blocks_grid.count - 1) &&
		*level_str_offset(str, cast(u32)cur.x, cast(u32)cur.y, grid_width) == '-
	{
		row := blocks_grid[cast(u64)cast(u32)cur.y]
		if row.count == 0
		{
			return false
		}
		i :u64
		while (row[i].x - cur.x) < 0.1
		{
			i++
		}
		*out_idx_on_same_x = i
		return true;
	}

	return false;
}
level_str_offset::fn(str: str_lit, x : u32, y : u32, width: u32) ! *char
{
	// y * 2 accounts for \n\r
	return str[cast(u64)(2 + x + y * width + y * 2)]
}
create_map_from_str::fn(ctx : *context, str : str_lit, final_t : *_vec)
{
	width : u32
	i : u32
	len := str_ln(str)
	while (*str[width + 2] != '\n && *str[width + 2] != '\r)
	{
		width++
	}

	height :u64
	i = 2
	while i < cast(u32)len
	{
		if *str[i] == '\n
		{
			height++
		}
		i++
	}
	height++
	i = 0

	// subing 2 because the first character is a new line


	blocks_grid : dyn_array(dyn_array(_vec))
	wp : waypoint


	for y in 0..height
	{
		cur_ar : dyn_array(_vec)
		dyn_init2(&cur_ar, width, ctx.alloc)
		for x in 0..width
		{
			fx := cast(f32)x
			fy := cast(f32)(height - cast(u64)y)
			ch := *level_str_offset(str, cast(u32)x, cast(u32)y, width)
			if ch == '-
			{
				last_on_x := cast(u64)x >= (width - 1)
				last_on_y := cast(u64)y >= (height - 1)
				first_on_x := x == 0
				first_on_y := y == 0

				if !last_on_x && !last_on_y  && !first_on_x && !first_on_y
				{
					prev_x := *level_str_offset(str, cast(u32)x - 1, cast(u32)y, width)
					next_x := *level_str_offset(str, cast(u32)x + 1, cast(u32)y, width)

					prev_y := *level_str_offset(str, cast(u32)x, cast(u32)y - 1, width)
					next_y := *level_str_offset(str, cast(u32)x, cast(u32)y + 1, width)

					if prev_x == '- && next_x == '- && prev_y == '- && next_y == 'n
					{
						continue
					}
				}
				v :_vec
				v.x = fx
				v.y = fy
				v.z = 0.1
				dyn_add(&cur_ar, &v)

			}
			else if ch == 'p
			{
				ctx.player.pos.x = fx
				ctx.player.pos.y = fy
				ctx.player.pos.z = 0.1
				ctx.player.pos.w = 0.0
				dyn_add(&ctx.drawable_ents, ctx.player)
			}
			else if ch == 't
			{
				final_t.x = fx
				final_t.y = fy
				final_t.z = 0.0
				final_t.w = 0.0
			}
			else if ch == 'w
			{
				wp.pos.x = fx + 0.5
				wp.pos.y = fy + 0.5

				dyn_add(&ctx.waypoints, &wp)
			}
		}
		dyn_add(&blocks_grid, &cur_ar)
	}

	y : u64
	while has_blocks_left(&blocks_grid, &y)
	{
		row_ar := blocks_grid[y]
		start_pos :_vec= *row_ar[0]

		
		next_is_contiguous := false

		contiguous_width := 0

		cur_b :u64=1
		cur_prev := start_pos
		if row_ar.count > 1
		{

			while cur_b < row_ar.count && (row_ar[cur_b].x - cur_prev.x) < 1.1
			{
				next_is_contiguous = true
				cur_prev = *row_ar[cur_b]
				cur_b++
			}
		}


		sz :_vec
		sz.x = 1.0
		sz.y = 1.0
		if next_is_contiguous
		{
			sz.x = cast(f32)cur_b
			while cur_b > 0
			{
				dyn_rem(row_ar, 0)
				cur_b--
			}
		}
		else
		{
			down_is_contiguous := false

			cur_downwards_idx := y

			if y < (blocks_grid.count - 1)
			{
				next_row := blocks_grid[cur_downwards_idx + 1]
				out_below_block_idx : u64
				while below_block_is_contiguous(&blocks_grid, &cur_prev, str, width, &out_below_block_idx)
				{
					cur_prev = *next_row[out_below_block_idx]
					dyn_rem(next_row, cast(u32)out_below_block_idx)

					cur_downwards_idx++

					next_row = blocks_grid[cur_downwards_idx]
				}

			}
			else
			{
				idx_block_to_remove :u32
				for b in *row_ar
				{
					if (b.x - start_pos.x) < 0.1
					{
						break;
					}
					idx_block_to_remove++
				}
				ASSERT(idx_block_to_remove < cast(u32)row_ar.count)
				dyn_rem(row_ar, idx_block_to_remove)

				cur_downwards_idx++
			}
			block_height := cur_downwards_idx - y
			sz.y = cast(f32)block_height
		}
		ent := NewEnt(ctx, "block");
		ent.is_active = true;
		ent.pos = start_pos
		ent.pos.z = 0.1
		ent.col_size = sz
		//ent.col_size.y = 1.0
		ent.size = ent.col_size
		ent.is_static = true;
		ent.color.w = 1.0
		dyn_add(&ctx.drawable_ents, &ent);
		add_body(ctx, ent);

		block_width := 1
	}

	for cur_w in ctx.waypoints
	{
		for aux_w in ctx.waypoints
		{
			if aux_w == cur_w
			{
				continue;
			}
			col : collision
			if !Raycast(ctx, &cur_w.pos, &aux_w.pos, &col, LAYER_TRIGGER | LAYER_PLAYER, nil)
			{
				dyn_add(&cur_w.neighbors, aux_w)
			}
		}
	}
}
head_long_term_meeting_diff::fn(ctx : *context, t : *thinking, out : *f32) ! bool
{
	head:*long_term_action = t.long_term_acts[0]
	if *head == long_term_action.MEETING_AT
	{
		*out = head.MEETING_AT.hour - ctx.time_since_start
		return true
	}

	return false
}
add_long_term::fn(t : *thinking, r : *long_term_action)
{
	dyn_add(&t.long_term_acts, r)
}
add_mid_term::fn(t : *thinking, r : *rated_stuff(mid_term_action))
{
	lesser_idx : u32

	for cur_r in t.mid_term_acts
	{
		if r.val > cur_r.val 
		{
			break
		}
		lesser_idx++
	}

	if cast(u64)lesser_idx >= t.mid_term_acts.count
	{
		dyn_add(&t.mid_term_acts, r)
	}
	else
	{
		dyn_add_at(&t.mid_term_acts, lesser_idx, r)
	}
}
has_mid_term::fn(t : *thinking, type : u32) !bool
{
	for m in t.mid_term_acts
	{
		if cast(u32)m.type == type
		{
			return true
		}
	}
	return false
}

check_mid_term_adding::fn(ctx : *context, e : *entity, dt  : *f32)
{
	t : *thinking= e.thoughts
	mid := &t.mid_term_acts
	diff : f32

	no_short_terms := t.short_term_acts.count == 0

	if no_short_terms 
		&& head_long_term_meeting_diff(ctx, t, &diff) 
		&& diff > -20.0
		&& !has_mid_term(t, cast(u32)mid_term_action.TEST)
	{
		r : rated_stuff(mid_term_action)
		r.val = 10.0
		r.type.type = mid_term_action.TEST
		r.type.TEST.secs = 5.0
		add_mid_term(t, &r)
	}
}
mid_term::fn(ctx : *context, e : *entity, dt  : *f32)
{
	t : *thinking= e.thoughts

	if t.mid_term_acts.count == 0
	{
		return;
	}
	head_r:*rated_stuff(mid_term_action) = t.mid_term_acts[0]
	head :*mid_term_action= &head_r.type

	if *head == mid_term_action.TEST
	{
		if head.TEST.frames % 30 == 0
		{
			r : short_term_action
			r.type = short_term_action.SAY
			r.SAY.str = "hello"
			dyn_add(&t.short_term_acts, &r)
		}
		head.TEST.cur += *dt
		head.TEST.frames++

		if head.TEST.cur >= head.TEST.secs
		{
			dyn_rem(&t.mid_term_acts, 0)
		}
	}
	else if *head == mid_term_action.MEETING_AT 
	{
		if !head_r.in_curse
		{
			long_t := t.long_term_acts[cast(u64)head.MEETING_AT.long_term]

			go_path : short_term_action
			go_path.type = short_term_action.GO_PATH

			closest_wp := get_closest_waypoint(&ctx.waypoints, &e.pos)
			ASSERT(closest_wp)
			
			find_wpath(ctx, closest_wp, &long_t.MEETING_AT.pos, &go_path.GO_PATH.path)

			dyn_clear(&t.short_term_acts)
			
			dyn_add(&t.short_term_acts, &go_path)
			head_r.in_curse = true
		}
	}
}
set_vel_dir_ret_dist::fn(vel : *_vec, start : *_vec, end : *_vec, vel_mul : f32, normal : *_vec) ! f32
{
	dir := (*end - *start)
	dist := dot_vec(&dir, &dir)
	dir = normalize_vec(&dir)

	*vel = dir * vel_mul
	if normal
	{
		normal.x = dir.y
		normal.y = -dir.x
	}
	return dist
}
short_term::fn(ctx : *context, e : *entity, dt  : *f32)
{
	t : *thinking= e.thoughts

	if t.short_term_acts.count == 0
	{
		return 
	}
	head:*short_term_action = dyn_last(&t.short_term_acts)

	if *head == short_term_action.SAY
	{
		printf(head.SAY.str)
		dyn_rem(&t.short_term_acts, 0)
	}
	else if *head == short_term_action.GO_TO
	{
		normal :_vec
		dir := (head.GO_TO.pos - e.pos)
		dist := dot_vec(&dir, &dir)
		dir = normalize_vec(&dir)

		e.vel = dir
		normal.x = dir.y
		normal.y = -dir.x

		left_ray_start:= e.pos + normal * 0.5
		right_ray_start:= e.pos + normal * -0.5
		left_ray_end:= left_ray_start + dir * 1.5
		right_ray_end:= right_ray_start + dir * 1.5

			/*
		draw:draw_info

		draw.pos.x = left_ray_start.x
		draw.pos.y = left_ray_start.y
		draw.pos.z = left_ray_end.x
		draw.pos.w = left_ray_end.y
		draw.flags = DRAW_INFO_LINE
		*draw.color[1] = 1.0
		*draw.color[3] = 1.0
		draw.cam_pos = ctx.cam_pos_global;
		draw.cam_size = ctx.cam_size;
		Draw(ctx.window, &draw)

		head.GO_TO.frames++

		if (head.GO_TO.frames % 15) == 0
		{
			head.GO_TO.flags = 0


			col : collision
			out : *entity
			if Raycast(ctx, &left_ray_start, &left_ray_end, &col, LAYER_PLAYER | LAYER_TRIGGER, &out)
			{
				head.GO_TO.flags = 1
				printf("left ent name %\n", col.ent.name)
			}
			else if Raycast(ctx, &right_ray_start, &right_ray_end, &col, LAYER_PLAYER | LAYER_TRIGGER, &out)
			{
				head.GO_TO.flags = 2
				printf("right ent name %\n", col.ent.name)
			}

			surface_dir: _vec
			surface_dir.x = col.normal.y
			surface_dir.y = col.normal.x
			// left ray col
			if head.GO_TO.flags == 1
			{
				if dot_vec(&surface_dir, &dir) < 0.0
				{
					surface_dir = surface_dir * -1.0
				}
			}
			// right ray col
			else if head.GO_TO.flags == 1
			{
				if dot_vec(&surface_dir, &dir) > 0.0
				{
					surface_dir = surface_dir * -1.0
				}
			}


			head.GO_TO.x_vel_when_ray_col = cast(s8)cast(s32)(surface_dir.x * 128.0)
			head.GO_TO.y_vel_when_ray_col = cast(s8)cast(s32)(surface_dir.y * 128.0)
		}
		if head.GO_TO.flags != 0
		{
			x := (cast(f32)cast(s32)head.GO_TO.x_vel_when_ray_col) / 128.0
			y := (cast(f32)cast(s32)head.GO_TO.y_vel_when_ray_col) / 128.0

			e.vel.x = x
			e.vel.y = y
		}
		*/
		//else
		//{
			e.vel = dir
			if dist < 0.01
			{
				t.short_term_acts.count--
			}
		//}

	}
	else if *head == short_term_action.GO_PATH
	{
		last := head.GO_PATH.path.count - 1
		cur := head.GO_PATH.cur_path
		pos := head.GO_PATH.path[last - cur]

		head.GO_PATH.cur_path++

		if cur > cast(u32)last
		{
			dyn_rem(&t.short_term_acts, 0)
		}
		else
		{
			r : short_term_action
			r.type = short_term_action.GO_TO
			r.GO_TO.pos = *pos
			dyn_add(&t.short_term_acts, &r)
		}
	}
	else
	{
		__dbg_break
	}
	i := 0

}
long_term::fn(ctx : *context, e : *entity, dt  : *f32)
{
	t : *thinking= e.thoughts

	if t.long_term_acts.count == 0
	{
		return;
	}
	head:*long_term_action = t.long_term_acts[0]
	if *head == long_term_action.MEETING_AT
	{
		diff := head.MEETING_AT.hour - ctx.time_since_start
		if diff < 0.0
		{
			//__dbg_break
			if t.short_term_acts.count == 0 && !has_mid_term(t, cast(u32)mid_term_action.MEETING_AT)
			{
				r : rated_stuff(mid_term_action)
				r.type.type = mid_term_action.MEETING_AT
				r.type.MEETING_AT.long_term = 0
				r.val = 40.0
				
				add_mid_term(t, &r)
			}
			diff = 0.0
		}
	}
	else
	{
		__dbg_break
	}
}
thinking_ents::fn(ctx : *context, dt  : *f32)
{
	for e in ctx.ents_think
	{
		t: *thinking = e.thoughts
		long_term(ctx, *e, dt)
		if t.check_mid_term
		{
			check_mid_term_adding(ctx, *e, dt)
			t.check_mid_term = false
		}
		mid_term(ctx, *e, dt)
		short_term(ctx, *e, dt);
	}
}
new_thinking::fn(ctx : *context, e : *entity)
{
	e.thoughts = cast(*thinking)heap_alloc(globals.alloc, sizeof(thinking))
	dyn_add(&ctx.ents_think, e)

}

draw_vertex ::fn(ctx : *context, pos : *_vec, sz : *_vec, cam_pos : *_vec, cam_rot : *_vec)
{
	draw : draw_info3d
	//draw.flags = DRAW_INFO_DBG_BREAK
	draw.pos = *pos
	draw.rot.w = 1.0
	draw.ent_size = *sz
	*draw.color[0] = 1.0
	*draw.color[1] = 1.0
	*draw.color[2] = 1.0
	*draw.color[3] = 1.0
	draw.cam_pos = cam_pos;
	draw.cam_rot = cam_rot;
	//draw.cam_forward = ctx.cam_aux_forward_global;
	Draw3D(ctx.window, &draw)
}
DRAW_TRI_TRANSPARENY :const s32= 1

draw_tri::fn(ctx : *context, v1 : *_vec, v2 : *_vec, _v3 : *_vec, col : *_vec, flags : u32)
{
	draw : draw_info3d
	draw.flags = DRAW_INFO_TRIANGLE

	if is_flag_on(flags, DRAW_TRI_TRANSPARENY)
		draw.flags = draw.flags | DRAW_INFO_TRANSPARENT
	draw.pos = *_v3
	draw.pivot = *v2
	draw.ent_size = *v1
	memcpy(draw.color[0], col, 16)
	
	draw.cam_pos = ctx.cam_pos_global
	draw.cam_rot = ctx.cam_rot_global
	draw.cam_forward = ctx.cam_forward_global
	Draw3D(ctx.window, &draw)

}
DRAW_LINE_TIP :const s32= 1
DRAW_LINE_NO_PROJ :const s32= 2
draw_line::fn(ctx : *context, start : *_vec, end : *_vec, col : *_vec, flags : u32)
{
	draw : draw_info3d
	draw.flags =  DRAW_INFO_LINE;
	draw.pos = *start
	draw.pos.w = 0.0
	draw.ent_size = *end
	draw.ent_size.w = 0.0
	memcpy(draw.color, col, 4 * 4);
	draw.cam_pos = ctx.cam_pos_global;
	draw.cam_rot = ctx.cam_rot_global;
	draw.cam_forward = ctx.cam_forward_global;
	if is_flag_on(flags, DRAW_LINE_NO_PROJ)
	{
		draw.flags = draw.flags | DRAW_INFO_NO_PROJ

	}
	draw.flags = draw.flags | DRAW_INFO_CUSTOM_SHADER
	m := ctx.materials[cast(u64)ctx.line_shader]
	draw.shader_id = m.shader_id

	SetShader(m.shader_id)
	loc := GetUniformLocation(m.shader_id, cast(*char)"col", 3)

	SetUniform4f(loc, col.x, col.y, col.z, col.w)
	Draw3D(ctx.window, &draw)
	if is_flag_on(flags, DRAW_LINE_TIP)
	{
		v_sz: _vec=?
		v_sz.x = 0.05
		v_sz.y = 0.05
		v_sz.z = 0.05
		v_sz.w = 1.0
		draw_vertex(ctx, end, &v_sz, ctx.cam_pos_global, ctx.cam_rot_global)
	}

}

cam_mov_editor::fn(ctx : *context, mx : f32, my : f32)
{
	axis : _vec
	axis.z = 0.0
	axis.x = 0.0
	axis.y = 1.0
	aux_forward := ctx.cam_aux_forward_global
	cam_forward := ctx.cam_forward_global
	cam_pos := ctx.cam_pos_global
	cam_rot := ctx.cam_rot_global

	speed := 10.0
	dt := 0.017

	if IsKeyHeld(key_enum.KEY_SHIFT)
	{

		speed = speed * 4.0
	}


	if IsKeyHeld(key_enum.KEY_E)
	{
		cam_pos.y += dt * speed
	}
	if IsKeyHeld(key_enum.KEY_Q)
	{
		cam_pos.y -= dt * speed
	}
	if IsKeyDown(key_enum.KEY_F2)
	{
		globals.tog = !globals.tog
	}
	cross := cross_vec(cam_forward, &axis)

	axis = cross * radians_to_degree(cam_rot.x)
	aux_rot := euler_to_quaternion(axis.x , axis.y, axis.z)
	
	axis.x = 0.0
	axis.y = 1.0
	axis.z = 0.0
	axis = cross * radians_to_degree(cam_rot.y)
	//aux_rot = aux_rot * euler_to_quaternion(axis.x , axis.y, axis.z)

	actual_forward := aux_rot * *cam_forward
	if IsKeyHeld(key_enum.KEY_A)
	{
		*cam_pos -= cross * dt * speed

	}
	if IsKeyHeld(key_enum.KEY_D)
	{
		*cam_pos += cross * dt * speed
	}
	if IsKeyHeld(key_enum.KEY_W)
	{
		*cam_pos += actual_forward * dt * speed
	}
	if IsKeyHeld(key_enum.KEY_S)
	{
		*cam_pos -= actual_forward * dt * speed
	}
	


	if IsMouseHeld(mouse_enum.RIGHT)
	{
		*cam_forward = euler_to_quaternion(0.0, radians_to_degree(mx), 0.0) * *cam_forward

		cam_rot.y += mx
		cam_rot.x += my
	}
}
cam_mov::fn(ctx : *context)
{
	axis : _vec
	axis.z = 0.0
	axis.x = 0.0
	axis.y = 1.0
	aux_forward := ctx.cam_aux_forward_global
	cam_forward := ctx.cam_forward_global
	cam_pos := ctx.cam_pos_global
	cam_rot := ctx.cam_rot_global

	speed := 5.0
	dt := 0.017

	if IsKeyHeld(key_enum.KEY_Q)
	{
		cam_pos.y += dt * speed
	}
	if IsKeyHeld(key_enum.KEY_E)
	{
		cam_pos.y -= dt * speed
	}
	if IsKeyDown(key_enum.KEY_F2)
	{
		globals.tog = !globals.tog
	}
	cross := cross_vec(cam_forward, &axis)
	if IsKeyHeld(key_enum.KEY_A)
	{
		*cam_pos -= cross * dt * speed

	}
	if IsKeyHeld(key_enum.KEY_D)
	{
		*cam_pos += cross * dt * speed
	}
	if IsKeyHeld(key_enum.KEY_W)
	{
		*cam_pos += *cam_forward * dt * speed
	}
	if IsKeyHeld(key_enum.KEY_S)
	{
		*cam_pos -= *cam_forward * dt * speed
	}
	
	dt = dt * 2.0
	if IsKeyHeld(key_enum.KEY_SHIFT)
	{
		if IsMouseHeld(mouse_enum.LEFT)
		{
			*cam_forward = euler_to_quaternion(0.0, radians_to_degree(dt), 0.0) * *cam_forward

			cam_rot.y += dt
			//cam_rot.x += dt
		}
		if IsMouseHeld(mouse_enum.RIGHT)
		{
			*cam_forward = euler_to_quaternion(0.0, -radians_to_degree(dt), 0.0) * *cam_forward

			cam_rot.y -= dt
			//cam_rot.x += dt
		}
	}
	else if IsKeyHeld(key_enum.KEY_JMP)
	{

		if IsMouseHeld(mouse_enum.LEFT)
		{
			cam_rot.x += dt
		}
		if IsMouseHeld(mouse_enum.RIGHT)
		{
			cam_rot.x -= dt
		}
	}
}
_draw_col ::fn(ctx : *context, c : *collider)
{
	on c.type
	{
	SPHERE
	{
		vsz :_vec
		vsz.x = c.SPHERE.radius
		vsz.y = c.SPHERE.radius
		vsz.z = c.SPHERE.radius
		draw_vertex(ctx, &c.ent.pos, &vsz, ctx.cam_pos_global, ctx.cam_rot_global)
	}
	TRIANGLE
	{
		col : _vec
		col.x = 1.0
		_v1 :=*c.TRIANGLE.verts[0] 
		_v2 :=*c.TRIANGLE.verts[1] 
		_v3 :=*c.TRIANGLE.verts[2] 

		draw_line(ctx, &_v1, &_v2, &col, 0)
		draw_line(ctx, &_v2, &_v3, &col, 0)
		draw_line(ctx, &_v3, &_v1, &col, 0)

		nv1 := _v1 - c.TRIANGLE.normal
		nv2 := _v2 - c.TRIANGLE.normal
		nv3 := _v3 - c.TRIANGLE.normal

		draw_line(ctx, &nv1, &nv2, &col, 0)
		draw_line(ctx, &nv2, &nv3, &col, 0)
		draw_line(ctx, &nv3, &nv1, &col, 0)

		draw_line(ctx, &_v1, &nv1, &col, 0)
		draw_line(ctx, &_v2, &nv2, &col, 0)
		draw_line(ctx, &_v3, &nv3, &col, 0)
		
	}
	CUBE
	{
		col : _vec
		col.z = 1.0
		_v1 :=*c.CUBE.verts[0] 
		_v2 :=*c.CUBE.verts[1] 
		_v3 :=*c.CUBE.verts[2] 
		_v4 :=*c.CUBE.verts[3] 
		_v5 :=*c.CUBE.verts[4] 
		_v6 :=*c.CUBE.verts[5] 
		_v7 :=*c.CUBE.verts[6] 
		_v8 :=*c.CUBE.verts[7] 

		draw_line(ctx, &_v1, &_v2, &col, 0)
		draw_line(ctx, &_v2, &_v3, &col, 0)
		draw_line(ctx, &_v3, &_v4, &col, 0)
		draw_line(ctx, &_v4, &_v1, &col, 0)

		draw_line(ctx, &_v5, &_v6, &col, 0)
		draw_line(ctx, &_v6, &_v7, &col, 0)
		draw_line(ctx, &_v7, &_v8, &col, 0)
		draw_line(ctx, &_v8, &_v5, &col, 0)
	}
	}
}
VIEW_COL_METHOD:const s32= 0
draw_aabb::fn(ctx : *context, _min : *_vec, _max : *_vec)
{
	_v1 := *_min
	_v2 := *_max
	_v3 := *_min
	_v4 := *_max

	_v3.y = _max.y
	_v4.y = _min.y

	_v1.z = _v1.y
	_v1.y = 0.0

	_v2.z = _v2.y
	_v2.y = 0.0

	_v3.z = _v3.y
	_v3.y = 0.0

	_v4.z = _v4.y
	_v4.y = 0.0

	col : _vec
	col.x = 1.0
	col.y = 1.0
	col.z = 1.0
	draw_line(ctx, &_v1, &_v2, &col, 0);
	draw_line(ctx, &_v2, &_v3, &col, 0);
	draw_line(ctx, &_v3, &_v4, &col, 0);
	draw_line(ctx, &_v4, &_v1, &col, 0);
}
view_collision ::fn(ccc : u32)
{
	return
	curmx := GetMouseNormalizedPosX();
	curmy := GetMouseNormalizedPosY();



	ctx := cast(*context)globals.ctx
	gjk := cast(*gjk_state)globals.gjk
	if gjk == nil && VIEW_COL_METHOD != 2
		return;
	ClearBackground(0.7, 0.7, 0.7);

	cam_pos := ctx.cam_pos_global
	cam_rot := ctx.cam_rot_global

	e1 := gjk.col1.ent
	e2 := gjk.col2.ent
	mx := &globals.mx
	my := &globals.my
	dt := 0.017
	mvx := GetMouseVelX() * dt
	mvy := GetMouseVelY() * dt
	cam_mov_editor(ctx, mvx, mvy)
	//cam_mov(ctx)

	//printf("curx %, mx %\n", cast(s32)(curmx * 100.0), cast(s32)(*mx * 100.0))


	*mx = GetMouseNormalizedPosX() - curmx;
	*my = GetMouseNormalizedPosY() - curmy;

	//printf("addr %, act2 %\n", cast(u32)cast(s64)e1, cast(s32)(e1.is_active))
	if e1 
	{
		e1.color.w = 0.5;
		e1.flags = e1.flags | ENTITY_TRANSPARENT;
		//DrawEntity(ctx, e1, cam_pos, cam_rot)
	}
	else
	{
		e1 = ctx.player
		e1.color.w = 0.5;
		e1.flags = e1.flags | ENTITY_TRANSPARENT;
		//DrawEntity(ctx, e1, cam_pos, cam_rot)
	}
	if e2
	{
		e2.color.w = 0.5;
		e2.flags = e2.flags | ENTITY_TRANSPARENT;
		//DrawEntity(ctx, e2, cam_pos, cam_rot)

	}

	orig : _vec
	col : _vec
	col.x = 1.0
	col.y = 0.0
	col.z = 0.0
	col.w = 1.0

	x_axis_start: _vec= _vec{-100.0, 0.0, 0.0, 0.0}
	x_axis_end: _vec= _vec{100.0, 0.0, 0.0, 0.0}
	z_axis_start: _vec= _vec{0.0, 0.0, -100.0, 0.0}
	z_axis_end: _vec= _vec{0.0, 0.0, 100.0, 0.0}
	draw_line(ctx, &x_axis_start, &x_axis_end, &col, 0)
	
	col.x = 0.0
	col.y = 0.0
	col.z = 1.0
	col.w = 1.0
	draw_line(ctx, &z_axis_start, &z_axis_end, &col, 0)

	v_sz: _vec=?
	v_sz.x = 0.1
	v_sz.y = 0.1
	v_sz.z = 0.1
	v_sz.w = 1.0

	globals.temp_alloc.cur = 0

	c1 := cast(*collider)e1.col
	c2 := cast(*collider)e2.col

	#if VIEW_COL_METHOD == 0
	{
		target_face :u64= gjk.closest_face
		draw_line(ctx, &globals.ray_origin, &globals.ray_end, &col, 0)
		draw_tri(ctx, &globals.tri_v3, &globals.tri_v2, &globals.tri_v1, &col, 0)
		if IsKeyHeld(key_enum.KEY_1) && c2.type == col_type.CUBE
		{
			t:u64
			while t < 30
			{
				t1 := cast(u64)*globals.cube_tris[t]
				t2 := cast(u64)*globals.cube_tris[t + 1]
				t3 := cast(u64)*globals.cube_tris[t + 2]
				_v1 := *c2.CUBE.verts[t1]
				_v2 := *c2.CUBE.verts[t2]
				_v3 := *c2.CUBE.verts[t3]

				draw_tri(ctx, &_v3, &_v2, &_v1, &col, 0)
				//print_vec(&_v1)
				t+= 3
			}
		}
		if IsKeyHeld(key_enum.KEY_2)
		{
			target_face = gjk.cur_face_facing_point;

			//__dbg_break
			//draw_vertex(ctx, &gjk.epa_new_sup, &v_sz, cam_pos, cam_rot)
		}
		if IsKeyHeld(key_enum.KEY_3)
		{
			for i in 0..16
			{
				//draw_vertex(ctx, gjk.mink_diff[cast(u64)i], &v_sz, cam_pos, cam_rot)
			}
			
		}
		if IsKeyHeld(key_enum.KEY_4)
		{
			for i in 0..gjk.num_loose_edges
			{
				draw_vertex(ctx, gjk.epa_loose_edges[cast(u64)i][0], &v_sz, cam_pos, cam_rot)
				draw_vertex(ctx, gjk.epa_loose_edges[cast(u64)i][1], &v_sz, cam_pos, cam_rot)
			}
			
		}
		for i2 in 0..gjk.num_faces
		{
			i := cast(u64)i2
			_v1 := *gjk.epa_faces[i][0]
			_v2 := *gjk.epa_faces[i][1]
			_v3 := *gjk.epa_faces[i][2]
			n := gjk.epa_faces[i][3]
			//printf("\ni % ", i)
			//printf("\n")

			
			col.x = 0.4
			col.y = 0.4
			col.z = 0.4
			col.w = 1.0
			if i == target_face
			{
				col.x = 0.0
				col.y = 0.0
				col.z = 0.0
				col.w = 1.0
				//printf("g2 %\n", cast(u32)gjk_state.cur_face_facing_point)
			}
			else
			{
				col = *n
				col.x = (col.x + 1.0) *0.5
				col.y = (col.y + 1.0) *0.5
				col.z = (col.z + 1.0) *0.5
			}
			flags :u32= 0
			if IsKeyHeld(key_enum.KEY_1)
			{
				_v1 = *gjk.epa_faces[i][2]
				_v2 = *gjk.epa_faces[i][1]
				_v3 = *gjk.epa_faces[i][0]
				
			}
			draw_tri(ctx, &_v1, &_v2, &_v3, &col, flags)
		}

	}
	else if VIEW_COL_METHOD == 1
	{
		if IsKeyHeld(key_enum.KEY_JMP)
		{
			_draw_col(ctx, gjk.col2)
			_draw_col(ctx, gjk.col1)

			if e2.type == ent_type.TERRAIN
			{

				trn :*terrain_info=e2.terrain
				t :u64=0
				mesh := trn.meshes[6]
				tris := &trn.tris
				
				while t < tris.count
				{
					t1 := cast(u64)*tris[t]
					t2 := cast(u64)*tris[t + 1]
					t3 := cast(u64)*tris[t + 2]

					_v1_start := mesh.verts[t1 * TERRAIN_VERTEX_SIZE]
					_v2_start := mesh.verts[t2 * TERRAIN_VERTEX_SIZE]
					_v3_start := mesh.verts[t3 * TERRAIN_VERTEX_SIZE]

					_v1 :_vec=?
					_v1.w = 0.0

					_v2 :_vec=?
					_v2.w = 0.0

					_v3 :_vec=?
					_v3.w = 0.0
					
					memcpy(&_v1, _v1_start, 3 * 4)
					memcpy(&_v2, _v2_start, 3 * 4)
					memcpy(&_v3, _v3_start, 3 * 4)

					_v1 += e2.pos
					_v2 += e2.pos
					_v3 += e2.pos

					draw_tri(ctx, &_v3, &_v2, &_v1, &col, 0)
					//globals.temp_alloc.cur = 0
					//printf("t is {*tris[t]}\n")
					//print_vec(&_v1)

					t += 3
				}
			}
		}

		draw_vertex(
			ctx, 
			&gjk.sup1, &v_sz, cam_pos, cam_rot)
		draw_vertex(ctx, &gjk.sup2, &v_sz, cam_pos, cam_rot)

		draw_line(ctx, &gjk.sup1, &gjk.sup2, &v_sz, DRAW_LINE_TIP);

		simplex_col : _vec
		simplex_col.x = 1.0
		simplex_col.y = 1.0
		simplex_col.z = 1.0
		draw_line(ctx, &orig, &gjk.dir, &simplex_col, DRAW_LINE_TIP);
		simplex_col.y = 0.0
		simplex_col.z = 0.0

		start : _vec= ?
		end : _vec= ?
		cross : _vec= ?
		if IsKeyHeld(key_enum.KEY_1)
		{
			draw_vertex(ctx, &gjk.simplex[0], &v_sz, cam_pos, cam_rot)
		}
		if IsKeyHeld(key_enum.KEY_2)
		{
			draw_vertex(ctx, &gjk.simplex[1], &v_sz, cam_pos, cam_rot)
		}
		if IsKeyHeld(key_enum.KEY_3)
		{
			draw_vertex(ctx, &gjk.simplex[2], &v_sz, cam_pos, cam_rot)
		}
		if IsKeyHeld(key_enum.KEY_4)
		{
			draw_vertex(ctx, &gjk.simplex[3], &v_sz, cam_pos, cam_rot)
		}
		on gjk.simplex_verts
		{
		2
		{
			draw_line(ctx, gjk.simplex[0], gjk.simplex[1], &simplex_col, DRAW_LINE_TIP);

			if IsKeyHeld(key_enum.KEY_F1)
			{
				a := gjk.simplex[0]
				b := gjk.simplex[1]

				ab := *b - *a
				ao := -*a

				cross = cross_vec(&cross_vec(&ab, &ao), &ab)
				start = *a + ab / 2.0
				end = start + cross

				draw_line(ctx, &start, &end, &simplex_col, 0);

				if(same_direction(&ab, &ao))
				{
					printf("the same dir\n")
				}
				else
				{
					printf("not in the same dir\n")
				}
			}
		}
		3
		{

			draw_line(ctx, gjk.simplex[0], gjk.simplex[1], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[0], gjk.simplex[2], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[1], gjk.simplex[2], &simplex_col, 0);

			a := gjk.simplex[0]
			b := gjk.simplex[1]
			c := gjk.simplex[2]

			ab := *b - *a
			ac := *c - *a
			ao := -*a

			abc := cross_vec(&ab, &ac)
			cross = cross_vec(&abc, &ac)
			start = *a + ac / 2.0
			end = start + cross

			simplex_col.y = 1.0
			draw_line(ctx, &start, &end, &simplex_col, 0);

			if IsKeyHeld(key_enum.KEY_F1)
			{
				cross = cross_vec(&cross_vec(&ac, &ao), &ac)
				end = start + cross
				simplex_col.z = 1.0
				draw_line(ctx, a, &end, &simplex_col, 0);

				simplex_col.y = 0.5
				simplex_col.z = 0.5
				draw_line(ctx, a, &(-*a), &simplex_col, 0);

				if same_direction(&ac, &ao)
				{
					printf("the same dir\n")
				}
				else
				{
					printf("not in the same dir\n")
				}
			}
		}
		4
		{
			draw_line(ctx, gjk.simplex[0], gjk.simplex[1], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[0], gjk.simplex[2], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[0], gjk.simplex[3], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[1], gjk.simplex[2], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[1], gjk.simplex[3], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[3], gjk.simplex[2], &simplex_col, 0);

		}
		}
		a := 0
	}
	else if VIEW_COL_METHOD == 2
	{

		trn :*terrain_info= globals.trn.terrain
		tpos := globals.trn.pos
		if globals.chunk
		{
			ch :*chunk_col_info= globals.chunk

			aux :*chunk_col_info
			if IsKeyHeld(key_enum.KEY_1)
			{
				//printf("curx {cast(s32)ch.pos_x}, cury {cast(s32)ch.pos_y}\n")
				aux = get_chunk_on_pos(trn, ch.left_neighbor)
				if aux != nil
				{
					ch = aux
				}
			}
			else if IsKeyHeld(key_enum.KEY_2)
			{
				aux = get_chunk_on_pos(trn, ch.up_neighbor)
				if aux != nil
				{
					ch = aux
				}
			}
			else if IsKeyHeld(key_enum.KEY_3)
			{
				aux = get_chunk_on_pos(trn, ch.down_neighbor)
				if aux != nil
				{
					ch = aux
				}
			}
			else if IsKeyHeld(key_enum.KEY_4)
			{
				aux = get_chunk_on_pos(trn, ch.right_neighbor)
				if aux != nil
				{
					ch = aux
				}
			}
			info :verts_from_tri_info=?
			mesh :*mesh_info= trn.meshes[cast(u64)ch.verts_mesh_idx]
			tris := &ch.tris


			t :u64= 0
			while t < tris.count
			{
				info.t = t
				get_verts_pos_from_tris(&info, tris.data, mesh.verts.data, TERRAIN_VERTEX_SIZE)
				info.v1_out += tpos + mesh.pos
				info.v2_out += tpos + mesh.pos
				info.v3_out += tpos + mesh.pos

				draw_tri(ctx, &info.v3_out, &info.v2_out, &info.v1_out, &col, 0)

				t += 3
			}
		}
		else
		{
			if IsKeyHeld(key_enum.KEY_1)
			{
				DrawEntity(ctx, globals.trn, cam_pos, cam_rot)
			}
			draw_line(ctx, &globals.ray_origin, &globals.ray_end, &col, 0)
			draw_tri(ctx, &globals.tri_v3, &globals.tri_v2, &globals.tri_v1, &col, 0)

/*
			info :verts_from_tri_info=?
			for ch in ctx.terrain_chunks_to_col
			{
				mesh :*mesh_info= trn.meshes[cast(u64)ch.verts_mesh_idx]
				tris := &ch.tris


				t :u64= 0
				while t < tris.count
				{
					info.t = t
					get_verts_pos_from_tris(&info, tris.data, mesh.verts.data)
					info.v1_out += tpos + mesh.pos
					info.v2_out += tpos + mesh.pos
					info.v3_out += tpos + mesh.pos

					draw_tri(ctx, &info.v3_out, &info.v2_out, &info.v1_out, &col, 0)

					t += 3
				}
			}
			*/
		}
		/*
		DrawEntity(ctx, globals.trn, cam_pos, cam_rot)
		if IsKeyHeld(key_enum.KEY_1)
		{
			draw_aabb(ctx, &globals.aabb1_min, &globals.aabb1_max)
		}
		if IsKeyHeld(key_enum.KEY_2)
		{
			draw_aabb(ctx, &globals.aabb2_min, &globals.aabb2_max)
			
		}
		*/
		a :=0
	}
	else if VIEW_COL_METHOD == 3
	{
	}



}
print_f32::fn(a : f32)
{
	printf("f %\n", cast(s32)(a * 100.0))
}
reset_jmp::fn(mov : *player_info)
{
	mov.jmp.vel.x = 0.0
	mov.jmp.vel.y = 0.0
	mov.jmp.vel.z = 0.0
	mov.jmp.time_off_ground = 0.0
	mov.jmp.jmpd = false
}

player_mov::fn(ctx : *context, aux_forward : *_vec, dt : *f32)
{

	//OpenLocalsWindow(__LINE__)
	player_ent := ctx.player
	forward := &player_ent.forward
	cross := cross_vec(&ctx.up, ctx.cam_forward_global)
	mov := player_ent.mov_info
	on_ground := player_ent.on_ground
	grav := &mov.gravity_vel
	cam_pos := *ctx.cam_pos_global
	cam_rot := *ctx.cam_rot_global
	//printf("up col {mov.up_col}\n")


	if mov.step_timer > 1.0
	{
		idx := cast(u64)cast(u32)(Rand01() * 2.0)
		PlayAudioByHandle(*ctx.step_audio_idxs[idx])
		mov.step_timer = 0.0
	}
	if mov.just_hit_ground && player_ent.vel.y < -8.0
	{
		PlayAudio("step_fall.flac", 1.0, 1.0)
	}
	if mov.up_col == false && mov.down_col
	{
	}

	if on_ground
	{
		grav.y = -0.05
		reset_jmp(mov)
	}
	else
	{
		mov.jmp.time_off_ground += *dt
		if IsKeyUp(key_enum.KEY_JMP) && mov.jmp.time_off_ground < 0.15
		{
			mov.jmp.vel.y = 0.0
		}
		grav.y += -15.0 * *dt
		//grav.y = -1.0
	}

	mov_pressed := false
	
	dont_change_forward_based_on_cam := false

	if IsKeyHeld(key_enum.KEY_W)
	{
		mov.v += *dt *10.0
		mov_pressed = true
	}
	else if IsKeyHeld(key_enum.KEY_S)
	{
		mov.v -= *dt * 10.0
		mov_pressed = true
	}
	else
	{
		mov.v += -mov.v * *dt * 10.0
	}


	if IsKeyHeld(key_enum.KEY_A)
	{
		mov.h += *dt * 10.0
		mov_pressed = true
	}
	else if IsKeyHeld(key_enum.KEY_D)
	{
		mov.h -= *dt * 10.0
		mov_pressed = true
	}
	else
	{
		mov.h += -mov.h * *dt * 10.0
	}

	if IsKeyDown(key_enum.KEY_1)
	{
		mov.cur_item = 0
	}
	if IsKeyDown(key_enum.KEY_2)
	{
		mov.cur_item = 1
	}
	if IsKeyDown(key_enum.KEY_3)
	{
		mov.cur_item = 2
	}
	if IsKeyDown(key_enum.KEY_4)
	{
		mov.cur_item = 3
	}

	mov.v = clamp(mov.v, -1.0, 1.0)
	mov.h = clamp(mov.h, -1.0, 1.0)

	ab := (absf(mov.v) + absf(mov.h))
	weight := clamp(ab - 1.0, 0.0, 1.0) + 1.0
	actual_forward := *ctx.cam_forward_global * mov.v + cross * mov.h
	actual_forward = actual_forward / weight
	if mov.on_getting_to_back_pos
	{
		actual_forward.x = 0.0
		actual_forward.y = 0.0
		actual_forward.z = 0.0
	}

	on player_ent.state
	{
	entity_state.ON_WALL
	{
		cross = cross_vec(&ctx.up, &player_ent.normal_col)
		d := dot_vec(&cross, &player_ent.vel)

		player_ent.vel.x = 0.0
		player_ent.vel.z = 0.0
		player_ent.vel.y = -0.5
		if IsKeyDown(key_enum.KEY_JMP) && !mov.exhausted
		{
			grav.y = 0.0
			mov.jmp.vel = *ctx.cam_forward_global * 5.0 + ctx.up * 6.0
			player_ent.state = entity_state.IDLE

			mov.stamina -= 0.2
		}
		if on_ground
		{
			player_ent.state = entity_state.IDLE
		}
	}
	entity_state.SLERP
	{
		player_ent.is_trigger = true
		mov.slerp_timer += *dt
		maxt := 0.2
		if mov.slerp_timer > maxt
		{
			player_ent.pos = mov.slerp_end
			player_ent.state = entity_state.IDLE
			player_ent.is_trigger = false
		}
		dir := mov.slerp_end - mov.slerp_start

		p := mov.slerp_timer / maxt
		player_ent.pos = mov.slerp_start + (dir * p)

	}
	entity_state.IDLE
	{
		mov.platform_vel += -mov.platform_vel * *dt * 2.0
		player_ent.color.x = 1.0
		player_ent.color.y = 0.0
		player_ent.color.z = 0.0
		speed := mov.speed

		trying_to_run := false
		if IsKeyHeld(key_enum.KEY_SHIFT)
		{
			trying_to_run = true
			if !mov.exhausted
			{
				speed = speed * 1.8
				if on_ground
				{
					mov.step_timer += *dt * 2.0;
				}
			}
		}

		if on_ground
		{
			if absf(mov.h) > 0.1 || absf(mov.v) > 0.1
			{
				mov.step_timer += *dt * 2.0
			}
		}
		if IsKeyDown(key_enum.KEY_JMP) && (on_ground && mov.jmp.time_off_ground == 0.0 || mov.jmp.time_off_ground <= 0.5)
			&& !mov.jmp.jmpd
		{
			if !mov.exhausted
			{
				player_ent.vel.y = 0.0
				mov.jmp.vel.y = 1.0 * mov.jmp.speed
				mov.jmp.jmpd = true
				player_ent.on_ground = false

				mov.stamina -= 0.05

			}
		}

		if mov.stamina < 0.01
		{
			mov.exhausted = true
		}

		if mov.exhausted && mov.stamina > 0.3
		{
			mov.exhausted = false
		}

		if ab < 0.01 && on_ground
		{
			mov.stamina += *dt * mov.stamina_recover_rate
		}

		if mov.exhausted
		{
			if trying_to_run
			{
				speed = speed * 0.8
				mov.stamina_temp_max -= speed * *dt * mov.stamina_decrease_rate * 0.1
			}
			else
			{
				speed = speed * 0.5
			}
		}
		else
		{
			decrease_vel := speed * *dt * mov.stamina_decrease_rate
			if trying_to_run
			{
				decrease_vel = decrease_vel * 2.0
			}

			if ab > 0.5
			{
				mov.stamina -= decrease_vel
				mov.stamina_temp_max -= decrease_vel * 0.03
			}
		}




		player_ent.vel = actual_forward * speed + *grav
		player_ent.vel += mov.jmp.vel; // + mov.platform_vel
		if dot_vec(&actual_forward, &actual_forward) > 0.01 && !mov.on_rotating_cam
		{
			*forward = normalize_vec(&actual_forward)
		}

		if IsMouseDown(mouse_enum.LEFT)
		{

			dir := euler_to_quaternion(radians_to_degree(cam_rot.x), radians_to_degree(cam_rot.y), 0.0) * *aux_forward
			cam_dir := cam_pos + dir * 2000.0

			aux_sel : *entity
			col: collision=?;
			Raycast(ctx, &cam_pos, &cam_dir, &col, 0, &aux_sel)
			item := mov.inv.items[cast(u64)mov.cur_item]
			on item.item
			{
			inv_item.SHOCK
			{
				if aux_sel
				{
					dir = col.contact_point - player_ent.pos
					vlen := len_vec(&dir)
					if vlen > 4.0
					{
						ctx.shock_ent.cl = ctx.shock_medium_clip
					}
					ctx.shock_ent.pos = player_ent.pos + dir * 0.5
					ctx.shock_ent.size = _vec{vlen, 0.2, 0.0, 1.0}

					dir = normalize_vec(&dir)
					cross = cross_vec(&ctx.up, &dir)

					ctx.shock_ent.pos += cross * 0.2

					
					fw := euler_to_quaternion(0.0, radians_to_degree(ctx.cam_rot_global.y), 0.0) * *aux_forward
					ang := angle_on_axis(aux_forward, &dir, &ctx.up) + PI *0.5
					ang2 := angle_on_axis(&fw, &dir, &cross)

					ctx.shock_ent.rot = euler_to_quaternion(0.0, radians_to_degree(ang), 0.0).v

					q : quaternion=?
					q.v = ctx.shock_ent.rot
					ctx.shock_ent.rot = (q * euler_to_quaternion(0.0, 0.0, radians_to_degree(-ang2))).v

					ctx.shock_ent.forward = dir
					ctx.shock_ent.vel = ctx.shock_ent.rot

					ctx.shock_ent.is_active = true
					ctx.shock_ent.color = _vec{1.0, 1.0, 1.0, 1.0}

					ent := get_inactive_ent(ctx, &ctx.emmitters, INACTIVE_FLAGS_GET_FIRST_WHEN_NONE_FOUND)
					ent.pos = col.contact_point
					ent.timer_deactivate = 1.0
					ent.emmitter.normal = col.normal
					ent.emmitter.cross = findPerpendicularVector(&col.normal)
					ent.emmitter.gravity.y = 0.0
					ent.emmitter.flags = PARTICLE_FLAGS_LOOP | PARTICLE_FLAGS_RANDOM_START_TIMER
					ent.emmitter.random_start_timer = 0.5
					ent.emmitter.speed = 4.0
					ent.emmitter.min_sz.x = 0.1
					ent.emmitter.min_sz.y = 0.1
					ent.emmitter.min_sz.z = 0.1
					ent.emmitter.max_sz.x = 0.3
					ent.emmitter.max_sz.y = 0.3
					ent.emmitter.max_sz.z = 0.3
					ent.emmitter.particle_lifetime = 0.2
					init_emmitter(ent)

					ctx.shock_ent_emmitter.is_active = true
					ctx.shock_ent_emmitter.pos = col.contact_point - col.normal * 0.01
					ctx.shock_ent_emmitter.rot = look_at_quaternion(aux_forward, &col.normal, &ctx.up).v

					ctx.shock_ent_emmitter.timer_deactivate = 1.0
					ctx.shock_ent.timer_deactivate = 0.4
					
					RemoveEntFromAr(&ctx.to_deactivate, ctx.shock_ent_emmitter)
					RemoveEntFromAr(&ctx.to_deactivate, ctx.shock_ent)
					dyn_add(&ctx.to_deactivate, ent)
					dyn_add(&ctx.to_deactivate, ctx.shock_ent_emmitter)
					dyn_add(&ctx.to_deactivate, ctx.shock_ent)
					//printf("col name {aux_sel.name}\n")

				}
			}
			inv_item.EXPLOSION_GEM
			{
				//__dbg_break

				b := get_inactive_ent(ctx, &ctx.bullets, INACTIVE_FLAGS_GET_FIRST_WHEN_NONE_FOUND)
				b.col_enter = bullet_collision_enter
				b.bullet.dmg_val = 10.0
				b.ignore_collision_with_layers = LAYER_PLAYER
				b.tex_id = cast(u32)ctx.textures[ctx.ball_tex].id
				b.pos = cam_pos
				//dir := euler_to_quaternion(radians_to_degree(cam_rot.x), radians_to_degree(cam_rot.y), 0.0) * *ctx.cam_aux_forward_global
				b.size.x = 0.2
				b.size.y = 0.2
				b.col_size = b.size

				b.timer_deactivate =  3.0
				dyn_add(&ctx.to_deactivate, b)

				b.is_active = true
				b.vel = dir * 40.0

			}
			}
		}
		fw := ctx.shock_ent.forward
		dir := ctx.shock_ent.pos - player_ent.pos
		cross = cross_vec(&ctx.up, &fw)

		aux_mul :=  PI
		half_aux_mul := aux_mul * 0.5
		d := dot_vec(&cross, &dir) * aux_mul * 2.0
		d = clamp(d, -half_aux_mul, half_aux_mul)
		d = d + PI * 0.5

		//ang2 := angle_on_axis(&aux_forward, &dir, &cross)
		q : quaternion=?
		q.v = ctx.shock_ent.vel
	
		ctx.shock_ent.rot = (q * euler_to_quaternion(radians_to_degree(d), 0.0, 0.0)).v

		tmr := ctx.shock_ent_emmitter.timer_deactivate
		ctx.shock_ent_emmitter.color.w = tmr
		clamped := clamp((1.0 - tmr) * 16.0, 0.0, 1.0)
		ctx.shock_ent_emmitter.size.x = clamped
		ctx.shock_ent_emmitter.size.y = clamped
		ctx.shock_ent_emmitter.size.z = clamped

		ang := angle_on_axis(aux_forward, forward, &ctx.up)
		player_ent.rot = euler_to_quaternion(0.0, radians_to_degree(-ang), 0.0).v

		if IsKeyDown(key_enum.KEY_ACT1) && !on_ground
		{
			player_ent.state = entity_state.SURF
		}
		d_up := dot_vec(&player_ent.normal_col, &ctx.up)
		if IsMouseDown(mouse_enum.RIGHT) && mov.col_in_stay && absf(d_up) < 0.1 && !on_ground
		{
			player_ent.state = entity_state.ON_WALL
		}
		if IsKeyDown(key_enum.KEY_JMP) && mov.down_col && mov.up_col==false
		{
			//__dbg_break
			ASSERT(mov.ent_col)
			c1 := cast(*collider)player_ent.col
			ASSERT(c1.type == col_type.CAPSULE)
			r := c1.CAPSULE.radius
			c1.pos = player_ent.forward *r * 2.0 + ctx.up * 1.4
			c2 := cast(*collider)mov.ent_col.col
			c2.type = col_type.CUBE
			//c2.pos = mov.ent_col.pos
			c2.ent = mov.ent_col
			dummy : _vec
			CopyVerts(c2, &dummy, &dummy)
			gjk := ctx.gjk

			if GJK(gjk, c1, c2)
			{
				//__dbg_break
				col : collision
				
				mtv := EPA(gjk, gjk.simplex[0], gjk.simplex[1], gjk.simplex[2], gjk.simplex[3], c1, c2, &col)
				
				col.normal = col.normal * -1.0
				mov.slerp_end = player_ent.pos
			}
			else
			{
				mov.slerp_end = player_ent.pos
			}

			mov.slerp_timer = 0.0
			mov.slerp_start = player_ent.pos
			player_ent.state = entity_state.SLERP
			player_ent.vel.x = 0.0
			player_ent.vel.y = 0.0
			player_ent.vel.z = 0.0
		}
	}
	entity_state.SURF
	{
		if on_ground
		{
			grav.y = -4.0

			cross_right := cross_vec(&ctx.up, &player_ent.normal_col)
			ground_dir := cross_vec(&cross_right, &player_ent.normal_col)
			ground_dir = normalize_vec(&ground_dir)
			d := dot_vec(&player_ent.forward, &ground_dir)

			rot_vel := mov.h * *dt * 2.0

			ground_steep := dot_vec(&mov.platform_vel, &player_ent.normal_col)
			if ground_steep < 0.0
			{
				mov.platform_vel += mov.platform_vel * *dt * ground_steep * 0.4
			}
			else
			{
				mov.platform_vel += player_ent.forward * *dt * 64.0 * ground_steep
			}

			fric_dot := dot_vec(&ctx.up, &player_ent.normal_col)

			mov.platform_vel += -player_ent.forward * *dt * fric_dot * 2.0
			
			if dot_vec(&mov.platform_vel, &player_ent.forward) < 0.0
			{
				up_dot := dot_vec(&ground_dir, &globals.up)
				final_vel := ground_dir - globals.up * up_dot
				final_vel = normalize_vec(&final_vel)

				player_ent.forward = final_vel
			}


			mov.platform_vel.x = clamp(mov.platform_vel.x, -20.0, 20.0)
			mov.platform_vel.y = clamp(mov.platform_vel.y, -20.0, 20.0)
			mov.platform_vel.z = clamp(mov.platform_vel.z, -20.0, 20.0)

			ang := angle_on_axis(&player_ent.forward, &mov.platform_vel, &ctx.up)
			mov.platform_vel = euler_to_quaternion(0.0, radians_to_degree(-ang), 0.0) * mov.platform_vel
		}

		player_ent.color.x = 1.0
		player_ent.color.y = 1.0
		player_ent.color.z = 0.0
		d := dot_vec(&player_ent.vel, &player_ent.forward)*0.1
		rot_vel := mov.h * *dt * d
		player_ent.forward = euler_to_quaternion(0.0, radians_to_degree(rot_vel), 0.0) * player_ent.forward

		player_ent.vel = mov.jmp.vel + mov.platform_vel
		player_ent.vel += *grav


		player_ent.rot.x = 0.0
		player_ent.rot.y = 0.0
		player_ent.rot.z = 0.0
		player_ent.rot.w = 1.0

		ang := angle_on_axis(aux_forward, forward, &ctx.up)
		axis_rot := euler_to_quaternion(0.0, radians_to_degree(-ang), 0.0).v
		aux :_vec= player_ent.rot

		multiply_quaternions(&player_ent.rot, &aux, &axis_rot)
		
		cross = cross_vec(&player_ent.forward, &player_ent.normal_col)

		ang = angle_on_axis(&ctx.up, &player_ent.normal_col, &cross) * 57.0
		cross = cross * -ang
		axis_rot = euler_to_quaternion(cross.x, cross.y , cross.z ).v
		aux = player_ent.rot
		multiply_quaternions(&player_ent.rot, &aux, &axis_rot)

		d = dot_vec(&mov.platform_vel, &mov.platform_vel)

		if d <= 10.0 && on_ground
		{
			player_ent.state = entity_state.IDLE
		}
		if IsKeyDown(key_enum.KEY_ACT1)
		{
			player_ent.state = entity_state.IDLE
		}
		
	}
	}
	player_ent.vel.x = clamp(player_ent.vel.x, -20.0, 20.0)
	player_ent.vel.y = clamp(player_ent.vel.y, -20.0, 20.0)
	player_ent.vel.z = clamp(player_ent.vel.z, -20.0, 20.0)


	mov.stamina = clamp(mov.stamina, 1.0, mov.stamina_temp_max)


	//ang := angle_on_axis(aux_forward, forward, &ctx.up)
	//player_ent.rot = euler_to_quaternion(0.0, radians_to_degree(-ang), 0.0).v
	player_ent.on_ground = false
	width := 4.0
	if player_ent.pos.y < mov.min_y_cam_pos || mov_pressed
	{
		mov.min_y_cam_pos = player_ent.pos.y
		mov.max_y_cam_pos = mov.min_y_cam_pos + width
	}
	if player_ent.pos.y > mov.max_y_cam_pos
	{
		mov.max_y_cam_pos = player_ent.pos.y
		mov.min_y_cam_pos = mov.max_y_cam_pos - width
	}	
	mov.down_col = false
	mov.col_in_stay = false
	mov.up_col = false
	mov.just_hit_ground = false
}

MESH_WIDTH :const s32= 33
init_tri_terrain::fn(trn : *terrain_info)
{
	for y in 0..MESH_WIDTH
	{
		for x in 0..MESH_WIDTH
		{
			if y >= 1 && x < (MESH_WIDTH - 1)
			{
				cur := y  * MESH_WIDTH + x
				next_cur := y  * MESH_WIDTH + x + 1
				below_vert := (y - 1) * MESH_WIDTH + x
				below_right_vert := (y - 1) * MESH_WIDTH + x + 1
				dyn_add(&trn.tris, cast(u32)cur)
				dyn_add(&trn.tris, cast(u32)below_vert)
				dyn_add(&trn.tris, cast(u32)below_right_vert)

				dyn_add(&trn.tris, cast(u32)next_cur)
				dyn_add(&trn.tris, cast(u32)cur)
				dyn_add(&trn.tris, cast(u32)below_right_vert)
			}
		}
	}

}
make_chunk_idx_within_mesh::fn(mesh_x : u8, mesh_y : u8, chunk_x : u8, chunk_y : u8) ! s32
{
	ret:s32
	ret = cast(s32)(cast(u32)mesh_x | (cast(u32)mesh_y << 8))
	if(mesh_y >= 16)
	{
		//__dbg_break
	}
	ret = ret | cast(s32)((cast(u32)chunk_x << 16) | (cast(u32)chunk_y << 24))
	return ret;
}
create_mesh::fn(minfo : *create_mesh_info, type : *type_data) ! u32
{
	aux :[16]u64
	ASSERT(type.entries < 16)
	for i in 0..type.entries 
	{
		// offset 0 is the type
		// offset 1 is how of this type there is on this

		cur := ptr_offset(type, 1 + i, type_data)
		*aux[cast(u64)i] = 0
		cur_aux := ptr_offset(aux[0], i * 8, u8)

		// how many members it has
		if cur.tp == cast(u32)type_enum.TYPE_VECTOR
		{
			*ptr_offset(cur_aux, 1, u8) = 4
		}
		else if cur.tp == cast(u32)type_enum.TYPE_F32
		{
			*ptr_offset(cur_aux, 0, u8) = 0
			*ptr_offset(cur_aux, 1, u8) = 1
		}
		else if cur.tp == cast(u32)type_enum.TYPE_U8
		{
			*ptr_offset(cur_aux, 0, u8) = 1
			*ptr_offset(cur_aux, 1, u8) = 1
		}
		else if cur.tp == cast(u32)type_enum.TYPE_STRUCT
		{
			cur = cur.strct
			if cur.name == "v2"
			{
				*ptr_offset(cur_aux, 1, u8) = 2
			}
			else if cur.name == "v3"
			{
				*ptr_offset(cur_aux, 1, u8) = 3
			}
			else
			{
				__dbg_break
			}
		}
		else
		{
			__dbg_break
		}
	}

	minfo.attribs = cast(*u32)aux[0]
	minfo.total_attribs = type.entries
	return CreateMesh(minfo)
}

generate_mesh::fn(ctx : *context, trn : *terrain_info, pos_x : u32, pos_y : u32) ! u32
{
	ASSERT((MESH_WIDTH % 2) == 1)
	verts:[MESH_WIDTH * MESH_WIDTH * TERRAIN_VERTEX_SIZE]f32
	memset(verts, 0, sizeof(verts))


	size := cast(f32)trn.width
	add_x := cast(f32)pos_x / size
	add_y := cast(f32)pos_y / size
	pos_xf:=cast(f32)pos_x
	pos_yf:=cast(f32)pos_y

	max_size := cast(f32)trn.width*cast(f32)trn.size
	part_max := cast(f32)trn.width/max_size

	//printf("px {aux_x}, py {aux_y}\n")

	//__dbg_break
	for y in 0..MESH_WIDTH
	{
		aux_y := pos_yf / max_size
		
		py := cast(f32)y / cast(f32)(MESH_WIDTH -1)
		aux_y += py * part_max

		for x in 0..MESH_WIDTH
		{
			px := cast(f32)x / cast(f32)(MESH_WIDTH -1)

			aux_x := pos_xf / max_size
			aux_x += px * part_max

			u := aux_x
			v := aux_y
			//__dbg_break

			perlin := sample_texture_bilinear(trn.tex, u, v).x * trn.amplitude
			globals.temp_alloc.cur = 0
			//printf("val is {perlin}\n")

			idx := cast(u64)y * MESH_WIDTH * TERRAIN_VERTEX_SIZE + cast(u64)x * TERRAIN_VERTEX_SIZE
			*verts[idx] = cast(f32)px * size
			*verts[idx + 1] = perlin
			*verts[idx + 2] = py * size

			vert_col :=cast(*_vec) verts[idx + 6]
			vert_col.x = 1.0
			vert_col.y = 1.0
			vert_col.z = 1.0
			vert_col.w = 0.0


		}
		//printf("\n")
	}


	m :mesh_info
	m.pos.x = cast(f32)pos_x
	m.pos.z = cast(f32)pos_y


	total_bytes := cast(u32)MESH_WIDTH * MESH_WIDTH * TERRAIN_VERTEX_SIZE * 4
	m.verts.data = cast(*f32)LinearGet(&globals.terrain_alloc, total_bytes)
	memcpy(m.verts.data, verts, total_bytes)
	m.verts.count = MESH_WIDTH * MESH_WIDTH * TERRAIN_VERTEX_SIZE

	//dyn_add_data(&trn.tris, cast(*f32)tris[0], cast(u32)tris.count * 4)
	//trn.tris.count = tris.count

	info :create_mesh_info
	info.verts = cast(*f32)&verts
	info.total_verts = MESH_WIDTH * MESH_WIDTH
	info.tris = trn.tris[0]
	info.total_tris = cast(u32)trn.tris.count

	trn.vertices_per_row = MESH_WIDTH

	actual_size := MESH_WIDTH - 1
	tris_per_unit := (actual_size) / cast(s32)size

	chunk_window_size := 4
	trn.chunks_col_window_size = cast(u32)chunk_window_size
	
	ASSERT(tris_per_unit >= 1)

	tris_per_unit = tris_per_unit * chunk_window_size
	trn.tris_per_unit = cast(f32)tris_per_unit

	ASSERT((actual_size % cast(s32)tris_per_unit) == 0)

	total_chunks_cols := actual_size / cast(s32)tris_per_unit

	ret := create_mesh(&info, GetTypeData(terrain_vert_info))

	ASSERT(ret != -1)
	m.model = ret
	//total_chunks_cols = total_chunks_cols - 1

	trn.chunks_col_per_row = cast(u32)total_chunks_cols


	tris_per_unit_u64 := cast(u64)tris_per_unit
	sz_type := sizeof(*m.chunks.data)
	_total_bytes := (total_chunks_cols * total_chunks_cols + 1) * sz_type

	m.chunks.data = cast(*chunk_col_info)LinearGet(&globals.terrain_alloc, cast(u32)_total_bytes)
	m.chunks.alloc = ctx.alloc
	m.chunks.cap = cast(u64)(_total_bytes / sz_type)
	dyn_add(&trn.meshes, &m)
	last_mesh_idx := cast(u32)trn.meshes.count - 1

	//__dbg_break

	lastm :*mesh_info= ptr_offset(trn.meshes.data, cast(u64)last_mesh_idx, mesh_info)
	size_u32 := cast(u32)size

	//__dbg_break
	for y in 0..total_chunks_cols
	{
		for x in 0..total_chunks_cols
		{
		
			start_x := cast(u64)x * tris_per_unit_u64
			start_y := cast(u64)y * tris_per_unit_u64
			end_x := cast(u64)x * tris_per_unit_u64 + tris_per_unit_u64
			end_y := cast(u64)y * tris_per_unit_u64 + tris_per_unit_u64
			/*
			if x == 7 && y == 7
			{
				__dbg_break
			}
			printf("on col chunk x {x}, y {y}\n")
			globals.temp_alloc.cur = 0
			*/
			create_chunk_col_for_terrain(ctx, trn, last_mesh_idx, start_x, start_y, end_x, end_y)

			last_chunk := dyn_last(&lastm.chunks)

			pos_x_u8 := cast(u8)(pos_x / (size_u32 - 1))
			pos_y_u8 := cast(u8)(pos_y / (size_u32 - 1))
			x_u8 := cast(u8)x
			y_u8 := cast(u8)y
			total_chunks_col_u8 := cast(u8)total_chunks_cols
			//if pos_x_u8 == 1 && pos_y_u8 == 1 && x == 1 && y == 1
				//__dbg_break;

			if x_u8 > 0
			{
				last_chunk.left_neighbor = make_chunk_idx_within_mesh(pos_x_u8, pos_y_u8, x_u8 - 1, y_u8)
			}
			else if pos_x_u8 > 0
			{
				last_chunk.left_neighbor = make_chunk_idx_within_mesh(pos_x_u8 - 1, pos_y_u8, total_chunks_col_u8 - 1, y_u8)
			}
			
			if (x_u8 + 1) < total_chunks_col_u8
			{
				last_chunk.right_neighbor = make_chunk_idx_within_mesh(pos_x_u8, pos_y_u8, x_u8 + 1, y_u8)
			}
			else if (pos_x_u8 + 1) < cast(u8)trn.size
			{
				last_chunk.right_neighbor = make_chunk_idx_within_mesh(pos_x_u8 + 1, pos_y_u8, 0, y_u8)
			}

			if y_u8 > 0
			{
				last_chunk.up_neighbor = make_chunk_idx_within_mesh(pos_x_u8, pos_y_u8, x_u8, y_u8 - 1)
			}
			else if pos_y_u8 > 0
			{
				last_chunk.up_neighbor = make_chunk_idx_within_mesh(pos_x_u8, pos_y_u8 - 1, x_u8, total_chunks_col_u8 - 1)
			}
			
			if (y_u8 + 1) < total_chunks_col_u8
			{
				last_chunk.down_neighbor = make_chunk_idx_within_mesh(pos_x_u8, pos_y_u8, x_u8, y_u8 + 1)
			}
			else if (pos_x_u8 + 1) < cast(u8)trn.size
			{
				last_chunk.down_neighbor = make_chunk_idx_within_mesh(pos_x_u8, pos_y_u8 + 1, x_u8, 0)
			}
		}
	}
	
	return ret
}
create_chunk_col_for_terrain::fn(ctx : *context, trn : *terrain_info, mesh_idx : u32, start_x_quad : u64, start_y_quad : u64, end_x_quad : u64, end_y_quad : u64 )
{

	mesh :*mesh_info= trn.meshes[cast(u64)mesh_idx]
	chunk : chunk_col_info
	chunk.verts_mesh_idx = mesh_idx
	t :u64
	chunk.pos_x = cast(f32)cast(s32)start_x_quad
	chunk.pos_y = cast(f32)cast(s32)start_y_quad
	chunk.up_neighbor = -1
	chunk.down_neighbor = -1
	chunk.left_neighbor = -1
	chunk.right_neighbor = -1
	count := trn.tris.count

	diffy := end_y_quad - start_y_quad
	diffx := end_x_quad - start_x_quad

	diffx++
	//diffy++

	total_bytes := diffx * diffy * 6 * 4
	chunk.tris.data = LinearGet(&globals.terrain_alloc, cast(u32)total_bytes)
	chunk.tris.alloc = ctx.alloc
	chunk.tris.cap = total_bytes / 4

	tris := &trn.tris
	tst := 0
	if tst == 0
	{
		aux_y:=0
		for y in start_y_quad..end_y_quad
		{
			aux_x:=0
			for x in start_x_quad..end_x_quad
			{
				start_x := x * 6
				start_y := (cast(u64)trn.vertices_per_row - 1)* 6 * cast(u64)y

				dyn_add(&chunk.tris, *tris[start_x + start_y])
				dyn_add(&chunk.tris, *tris[start_x + start_y + 1])
				dyn_add(&chunk.tris, *tris[start_x + start_y + 2])
				dyn_add(&chunk.tris, *tris[start_x + start_y + 3])
				dyn_add(&chunk.tris, *tris[start_x + start_y + 4])
				dyn_add(&chunk.tris, *tris[start_x + start_y + 5])
				aux_x++
			}
			aux_y++
		}
	}
	else
	{
		while t < count
		{
			dyn_add(&chunk.tris, *tris[t])
			dyn_add(&chunk.tris, *tris[t + 1])
			dyn_add(&chunk.tris, *tris[t + 2])
			t += 3
		}
	}
	//__dbg_break
	dyn_add(&mesh.chunks, &chunk)
}

calculate_normals::fn(terrain : *terrain_info)
{
	tris_data := terrain.tris[0]
	for m in terrain.meshes
	{
		t :u64
		count := terrain.tris.count
		verts_data := m.verts[0]
		while t < count
		{
			info :verts_from_tri_info=?
			info.t = t
			get_verts_pos_from_tris(&info, tris_data, verts_data, TERRAIN_VERTEX_SIZE)
			info.cross = -info.cross

			tri := cast(u64)*terrain.tris[t]
			tri = tri * TERRAIN_VERTEX_SIZE
			vt := cast(*terrain_vert_info)m.verts[tri]

			vn := cast(*_vec)&vt.normal
			prev := vn.w

			*vn += info.cross
			vn.w = prev
			
			t += 3
		}
	}
	for m in terrain.meshes
	{
		t :u64
		count := terrain.tris.count
		verts_data := m.verts[0]
		while t < count
		{
			tri := cast(u64)*terrain.tris[t]
			tri = tri * TERRAIN_VERTEX_SIZE
			vt := cast(*terrain_vert_info)m.verts[tri]

			vn := cast(*_vec)&vt.normal
			prev := vn.w

			*vn = *vn / 3.0

			vn.w = prev
			
			t += 3
		}
	}

}
generate_terrain::fn(ctx : *context, e : *entity, chunks_per_side : u32)
{
	terrain := e.terrain
	globals.alloc = &ctx.terrain_alloc
	ctx.alloc = &ctx.terrain_alloc

	init_tri_terrain(terrain)
	trn :*terrain_info= e.terrain
	trn.size = chunks_per_side


	i := 0
	//__dbg_break

	mesh :*mesh_info
	for y in 0..trn.size
	{
		for x in 0..trn.size
		{
			generate_mesh(ctx, terrain, cast(u32)x * (terrain.width - 1), cast(u32)y * (terrain.width - 1))
		}
	}
	//__dbg_break

	globals.alloc = &ctx.main_alloc
	ctx.alloc = &ctx.main_alloc

	calculate_normals(terrain)
	for m in terrain.meshes
	{
		verts := &m.verts
		//__dbg_break
		UpdateModel(m.model, m.verts.data)
	}
}

