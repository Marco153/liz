NewPlaneEnt::fn(ctx : *scene_info, name : str_lit, pos : *_vec, size : *_vec) ! *entity
{
	ret := NewEnt(ctx, name);
	ret.type = ent_type.ENEMY
	ret.flags = ret.flags | ENTITY_SERIALIZE | ENTITY_3D | ENTITY_HAS_TEXTURE
	ret.is_active = true


	dyn_add(&ret.remove_from, ent_part_of.LOOK_AT_PLAYER)
	dyn_add(&ctx.look_at_ents, ret)
	add_body(ctx, ret)

	ret.pos = *pos
	ret.size = *size
	ret.col_size.x = 1.0
	ret.col_size.y = 1.0
	ret.col_size.z = 1.0
	ret.cols[0].size = *size
	ret.color.x = 1.0
	ret.color.y = 1.0
	ret.color.z = 1.0
	ret.color.w = 1.0

	return ret
}
new_enemy::fn(ctx : *scene_info, pos : *_vec, name : str_lit) ! *entity
{
	test_e := NewPlaneEnt(ctx, name, &globals.up, &_vec{0.5, 1.5, 0.5})

	dyn_add(&test_e.remove_from, ent_part_of.ANIMATION)
	dyn_add(&test_e.remove_from, ent_part_of.PLAYABLE)
	dyn_add(&ctx.ents_with_clip, test_e)
	dyn_add(&ctx.playable_ents, test_e)

	test_e.pos = *pos
	test_e.hp = 100.0
	test_e.pos.y += 1.0
	test_e.pos.x += 1.0 + Rand01() * 4.0
	test_e.size.x += 1.0
	//test_e.size.y += 0.5
	test_e.col_size.z = 0.5
	test_e.col_size.x = 0.5
	test_e.col_size.y = 1.5
	test_e.color.x = 1.0
	test_e.color.y = 1.0
	test_e.color.z = 1.0
	test_e.color.w = 1.0
	test_e.sec_color = test_e.color
	test_e.en_info = new_ptr(enemy_info)
	test_e.en_info.origin_pos = test_e.pos

	test_e.layer = test_e.layer | LAYER_ENEMY
	test_e.type = ent_type.ENEMY
	//test_e.dont_res_cols_with_layers = LAYER_PLAYER
	//test_e.ignore_collision_with_layers = LAYER_ENEMY

	c1 := test_e.cols[0]
	test_e.flags = test_e.flags | ENTITY_NO_ROTATION_ON_COLLISION
	//c1.type = col_type.SPHERE
	//c1.SPHERE.radius = 2.0

	//test_e.tex_id = *ptr_offset(ctx.character_texs.tex_idxs, 0, u32)
	
	return test_e

}
init_emmitter_particle::fn(emm : *particle_emmitter, p : *particle_pos_sz_vel, e : *entity)
{
	n := emm.normal
	cross := emm.cross
	rand := Rand01()
	p.ang_vel.x = 0.0
	p.ang_vel.z = rand * 2.0

	rot_rand := rand * 360.0

	aux_cross := euler_to_quaternion(rot_rand * n.x, rot_rand * n.y, rot_rand * n.z) * cross

	p.pos = e.pos
	p.time = emm.particle_lifetime

	if is_flag_on(emm.flags, PARTICLE_FLAGS_RANDOM_START_TIMER) && is_flag_off(emm.flags, PARTICLE_FLAGS_FIRST_TIME)
	{
		p.time += Rand01() * emm.random_start_timer
	}

	p.vel = -emm.normal + aux_cross


	diff_x := emm.max_sz.x - emm.min_sz.x
	diff_y := emm.max_sz.y - emm.min_sz.y
	diff_z := emm.max_sz.z - emm.min_sz.z

	r1 := rand
	r2 := Rand01()
	r3 := Rand01()

	p.sz.x = emm.min_sz.x + r1 * diff_x
	p.sz.y = emm.min_sz.x + r1 * diff_y
	p.sz.z = emm.min_sz.z + r1 * diff_z
}
init_emmitter::fn(e : *entity)
{
	emm := e.emmitter
	
	n := emm.normal	
	cross := emm.cross

	on emm.type
	{
	particle_emmitter_type.POS_SZ_VEL
	{
		emm.flags = emm.flags | PARTICLE_FLAGS_FIRST_TIME
		for i in 0..emm.total
		{
			p := ptr_offset(emm.particles, i, particle_pos_sz_vel)
			init_emmitter_particle(emm, p, e)
		}
	}
	}
}
emmitters_func::fn(ctx : *scene_info, dt : f32, drw_set : *draw_settings)
{
	for e in ctx.emmitters
	{
		if !e.is_active
			continue;
		ASSERT(e.emmitter)
		emm := e.emmitter

		if !emm.particles
			continue;
		n := emm.normal	
		cross := emm.cross

		cam_pos := *drw_set.cam_pos
		cam_rot := *drw_set.cam_rot
		cam_fw := *drw_set.cam_forward
			
		//printf("type is {cast(u32)emm.type}\n")
		
		on emm.type
		{
		particle_emmitter_type.POS_SZ_VEL
		{
			for i in 0..emm.total
			{
				p := ptr_offset(emm.particles, i, particle_pos_sz_vel)
				if p.time < 0.0
				{
					continue;
				}
				p.time -= dt
				if  p.time > emm.particle_lifetime
				{
					continue;
				}

				p.vel += emm.gravity * dt
				p.pos += p.vel * dt * emm.speed
			
				p.rot += p.ang_vel
				
				fwx := cam_rot.x * p.rot.x
				fwz := cam_rot.z * p.rot.z
				rot := euler_to_quaternion(0.0, radians_to_degree(cam_rot.y), 0.0).v
				draw : draw_info3d

				draw.model = 1
				draw.pos = p.pos
				draw.rot = rot
				draw.cam_pos = &cam_pos
				draw.cam_rot = &cam_rot
				draw.cam_forward = &cam_fw
				draw.ent_size = p.sz

				*draw.color[0] = 1.0
				*draw.color[1] = 1.0
				*draw.color[2] = 1.0
				*draw.color[3] = 1.0

				draw.flags = draw.flags | DRAW_INFO_NO_LIGHT | DRAW_INFO_HAS_TEXTURE;
				draw.texture_id = get_id_of_texture_asset(&globals.white_tex)
				Draw3D(drw_set.window, &draw);
				
				if p.time < 0.0
				{
					if is_flag_off(emm.flags, PARTICLE_FLAGS_LOOP)
					{
						continue;
					}
					init_emmitter_particle(emm, p, *e)
				}
			}
		}
		}
	}
}
test_rett::fn(val : u32) ! u32
{
	return val + 1
}

compile_shader::fn(ctx : *context, file_name : str_lit, mat : *material_info) ! *material_info
{
	file_name_original := file_name

	file_name = "../materials/{file_name}"
	prev_size := globals.temp_alloc.cur

	fl_sz: = GetFileSize(file_name);
	if fl_sz == -1
		__dbg_break

  printf("----creating shader {file_name}\n")
	InitMemAlloc(&ctx.compiling_shaders_alloc, ctx.compiling_shaders_alloc.chunks_cap)

	globals.alloc = &ctx.compiling_shaders_alloc

	file: = cast(str_lit)heap_alloc(ctx.alloc, cast(u32)fl_sz + 1);
	defer heap_free(ctx.alloc, file)

	ReadFile(file_name, file);
	*ptr_offset(file, fl_sz, u8) = 0
	tkns : dyn_array(token)

	lang_stat :lang_state

	pinfo :parse_info
	pinfo.tkns = &tkns
  pinfo.lang_stat = &lang_stat

	globals.scope_alloc.cur = 1

	root :*scope= new_scope(nil)

	globals.add_new_line_new_stmnt_ast_to_string = true
	defer globals.add_new_line_new_stmnt_ast_to_string = false

	Tokenize(&tkns, cast(str_lit)file[0])
	globals.nodes_alloc.cur = 0
	globals.ast_alloc.cur = 0

	nd :*node= parse_all(&pinfo)
	ast :*ast_rep= parse_node_to_ast(&lang_stat, nd, root)
	test_str:string
	//ast_to_string(ast, &test_str)

	
	out_decl : *decl
	done := false
  lang_stat.flags = LANG_STAT_FLAGS_COMPILING_SHADER
	for i in 0..5
	{
		if descend_name_finding(&lang_stat, ast, root, &out_decl)
		{
			break;
		}
	}

	lang_stat.flags = LANG_STAT_FLAGS_REPORT_UNDECLARED

	descend_name_finding(&lang_stat, ast, root, &out_decl)



	uniforms : string
	vs : string
	fs : string


	for un in lang_stat.uniforms
	{
		globals.temp_alloc.cur = prev_size
		if un.tp.type == lang_type_type.STATIC_ARRAY
		{
			sz := un.tp.STATIC_ARRAY.sz
			tp := un.tp.STATIC_ARRAY.type
			PushStrLit(&uniforms, "uniform {builtin_type_to_string(tp)} {un.name}[{sz}];\n")
		}
		else
		{
			PushStrLit(&uniforms, "uniform {builtin_type_to_string(&un.tp)} {un.name};\n")
		}
	}
	PushStrLit(&uniforms, "uniform float TIME;\n")

	PushStrLit(&vs, "#version 330 core\n")
	PushStrLit(&fs, "#version 330 core\n")

	PushStr(&vs, &uniforms)
	PushStr(&fs, &uniforms)
	for f in lang_stat.funcs
	{
		globals.temp_alloc.cur = prev_size
		if f.name == "vertex"
		{
			i := 0
			for arg in f.args
			{
				PushStrLit(&vs, "layout (location = {i}) in {builtin_type_to_string(&arg.tp)} {arg.name};\n")
				i++
			}
			globals.temp_alloc.cur = prev_size


			for r in f.rets
			{
				PushStrLit(&vs, "out {builtin_type_to_string(&r.tp)} {r.name};\n")
				i++
			}
			PushStrLit(&vs, "void main()")
			ast_to_string(f.ast.FUNC.scp_ast, &vs)
		}
		else if f.name == "fragment"
		{
			i := 0
			for arg in f.args
			{
				PushStrLit(&fs, "in {builtin_type_to_string(&arg.tp)} {arg.name};\n")
				i++
			}
			globals.temp_alloc.cur = prev_size

			i = 0

			PushStrLit(&fs, "out vec4 frag_Color;\n")
			for r in f.rets
			{
				PushStrLit(&fs, "out {builtin_type_to_string(&r.tp)} {r.name};\n")
				i++
			}
			PushStrLit(&fs, "void main()")
			ast_to_string(f.ast.FUNC.scp_ast, &fs)

			globals.temp_alloc.cur = prev_size
		}
	}
	shader := CompileShader(vs.data.data, vs.data.count, fs.data.data, fs.data.count)
	printf("compiled shader {shader} \n")
	if !mat
	{
		empty_idx := find_empty_asset(ASSETS_MATERIALS_OFFSET)

		empty_a:asset_index
		empty_a.asset_idx = cast(u32)empty_idx

		//__dbg_break

		a := globals.assets[empty_idx]
		a.cid.id.a_type = cast(u8)cast(u32)asset_type.MATERIAL
		a.type = asset_type.MATERIAL
		ln := str_ln(file_name_original)
		ASSERT(ln < 12)
		
		memcpy(&a.cid.name, file_name_original, ln)

		mat = get_material_ptr(&empty_a)
		mat.name = new_str_lit(ctx.alloc, file_name_original)
	}
	else
	{
		dyn_clear(&mat.uniforms)
	}
	mat.cull_type = lang_stat.cull_type

	mat.shader_id = shader
	total_texs :u32= 0

	printf("new uniforms\n")

	globals.alloc = &ctx.main_alloc
	for u in lang_stat.uniforms
	{
		if u.tp.type == lang_type_type.SAMPLER2D
		{
			u.offset = cast(s32)total_texs
			ValidateTextureSlot(shader, u.name.data.data, cast(u32)u.name.data.count, total_texs);
			total_texs++
		}
		else
		{
			u.offset = cast(s32)GetUniformLocation(shader, u.name.data.data, cast(u32)u.name.data.count)
		}
		if u.offset == -1
		{
			continue
		}

		new_u :decl=?
		memcpy(&new_u, *u, sizeof(decl))
		memset(&new_u.name, 0, sizeof(new_u.name))
		AssignStr(&new_u.name, &u.name)
		if u.tp.type == lang_type_type.STATIC_ARRAY
		{
			new_u.tp.STATIC_ARRAY.type = cast(*lang_type)heap_alloc(globals.perm_alloc, sizeof(lang_type))
			*new_u.tp.STATIC_ARRAY.type = *u.tp.STATIC_ARRAY.type
			//new_u.array_sz = u.type.STATIC_ARRAY.SZ
		}
		dyn_add(&mat.uniforms, &new_u)
		a:= 0
	}

	printf("uniforms done\n")
	return mat
}
imgui_window:struct
{
	name : str_lit, 
	items : u32, 
	items_per_line : u32, 
	selected_ref : *void
	window_bool : *bool
	item_width : f32
	item_height : f32
	_out_ent : *entity
	ptr : *void
	func : fn(ctx : *context, info : *imgui_window, id : u32),
	apply : fn(ctx : *context, info : *imgui_window),
	get_idx : fn(ctx : *context, info : *imgui_window) ! u32,
	set_val : fn(ctx : *context, info : *imgui_window, id : u32)
}
imgui_show_window_grid::fn(ctx : *context, out_ent : *entity, info : *imgui_window)
{
	items_per_line := info.items_per_line
	items_per_line_actual := cast(s64)info.items_per_line - 1

	ImGuiBegin(info.name, info.window_bool, 0)
	ImGuiBeginChild("{info.name}child", 200.0, 200.0)
	apply := false
	image_width := 32.0
	if(info.get_idx == nil || info.set_val == nil)
	{
		printf("get_idx or set_val is nil\n")
		__dbg_break
	}
	printf("here max{info.items}\n")
	for i in 0..info.items
	{
		globals.temp_alloc.cur = 0
		selected := info.get_idx(ctx, info) == cast(u32)i
		//ImGuiSetCursorPos(x, y)
		x := ImGuiGetCursorPosX()
		y := ImGuiGetCursorPosY()
		start_x := x
		//printf("cur is {i}\n")

		if ImGuiSelectable("##{info.name}{i}", selected, info.item_width, info.item_height)
		{
			info.set_val(ctx, info, cast(u32)i)
		}
		
		//printf("mod {cast(u32)i % items_per_line}, i is {i}")
		ImGuiSetCursorPos(x, y)
		if (i % cast(s64)items_per_line) < items_per_line_actual
		{
			info.func(ctx, info, cast(u32)i)
			ImGuiSameLine()
			//x += info.item_width * 2.0
		}
		else
		{
			info.func(ctx, info, cast(u32)i)
			if i != 0
				y += info.item_height
				//x = start_x

		}
		//printf("\n")
	}
	ImGuiEndChild()
	if ImGuiSelectable("change", false, 80.0, 15.0)
	{
		apply = true
	}
	ImGuiEnd()
	if out_ent != nil && apply
	{
		info.apply(ctx, info)
		*info.window_bool = false
	}
}
new_material_instance::fn(ctx : *scene_info, mat_id : *asset_index, ent : *entity) ! u32
{
	m := get_material_ptr(mat_id)
	inst :*material_instance
	inst_id :u32
	ent.flags = ent.flags | ENTITY_CUSTOM_SHADER
	for mi in m.instances
	{
		if mi.ent == ent
		{
			inst = mi
			break;
		}
		inst_id++;
	}
	if !inst
	{
        i :u64
        found_empty := false
        for i2 in m.instances
        {
          if i2.ent == nil
          {
            found_empty = true
            break
          }
          i++
        }

        if found_empty
        {
          inst = m.instances[i]
          inst_id = cast(u32)i
        }
        else
        {
          new_i:material_instance

          inst_id = cast(u32)m.instances.count

          dyn_add(&m.instances, &new_i)
          inst = dyn_last(&m.instances)
        }
	}
	else
	{
		dyn_clear(&inst.uniforms)
	}
    inst.ent = ent

	for u in m.uniforms
	{
		un_val:uniform_val
		un_val.uniform_id = cast(u32)u.offset
		un_val.type = cast(u32)u.tp.type
		on cast(lang_type_type)un_val.type
		{
		lang_type_type.SAMPLER2D
		{
			//un_val.tex. = cast(u32)u.offset
		}
		lang_type_type.V4
		{
			un_val.v.x = 1.0
			un_val.v.y = 1.0
			un_val.v.z = 1.0
			un_val.v.w = 1.0
		}
		}
		if u.tp.type == lang_type_type.STATIC_ARRAY
		{
			sz := lget_type_size(u.tp.STATIC_ARRAY.type) * u.tp.STATIC_ARRAY.sz
			un_val.is_array = true
			un_val.type = cast(u32)u.tp.STATIC_ARRAY.type.type
			un_val.array_sz = u.tp.STATIC_ARRAY.sz
			un_val.data = heap_alloc(globals.alloc, sz)

			if un_val.type == cast(u32)lang_type_type.MAT4
			{
				for i in 0..un_val.array_sz
				{
					cur := ptr_offset(un_val.data, i * 16, f32)

					identity_matrix4x4(cur)
				}
			}
		}
		dyn_add(&inst.uniforms, &un_val)
	}


	return inst_id
}
