		//update_screen_texture(ctx, &ctx.mach)
		emmitters_func(ctx.cur_scn, dt, drw_set)
    for s in ctx.scenes
    {
      if !s.in_use continue

      if s == ctx.cur_scn || ctx.editor_cam == false
      {
        s.color = ctx.white_color
      }
      else
      {
        memset(&s.color, 0, sizeof(_vec))
        s.color.x = 1.0
      }

      DrawEnts(s, ctx.cam_pos_global, ctx.cam_rot_global, drw_set)
    }
		LookAtPlayerEnts(ctx.cur_scn, drw_set)
		items_func(ctx.cur_scn, dt, out_ent)

    

    //test_fun(ctx.scenes[0])
    if is_flag_on(player_ent.flags, ENTITY_CHANGE_SCENES)
    {
      c1 := *player_ent.cols[0]
      p_aabb :aabb = ?
      p_aabb._min = c1._min
      p_aabb._max = c1._max

      for s in ctx.scenes
      {
        if ctx.cur_scn == s continue

        found := false
        for a in s.areas_col
        {
          a_aabb :aabb
          a_aabb._min = a.area_col_pos - a.area_col_size * 0.5
          a_aabb._max = a.area_col_pos + a.area_col_size * 0.5

          if aabbCheck3D(&p_aabb, &a_aabb)
          {
            break
          }
        }
        if found
        {
            break
        }
      }
    }

		if !ctx.editor_cam
		{
			s:= 0.003
			// aim
			DrawSquare(ctx, -s, -s, s, s, &_vec{1.0, 1.0, 1.0, 1.0})
			draw_ui_gameplay(ctx, globals.player.mov_info)
		}
		globals.temp_alloc.cur = 0
		/*
		{
		trn :*terrain_info=trn_ent.terrain
		t :u64=0
		idx :u64=0
		if IsKeyHeld(key_enum.KEY_1)
		{
			idx = 1
		}
		if IsKeyHeld(key_enum.KEY_2)
		{
			idx = 6
		}
		mesh := trn.meshes[idx]
		tris := &trn.tris
		//trn_ent.is_active = false
		
		tcol :=_vec{1.0, 1.0, 1.0, 1.0}
		while t < tris.count
		{
			t1 := cast(u64)*tris[t]
			t2 := cast(u64)*tris[t + 1]
			t3 := cast(u64)*tris[t + 2]

			_v1_start := mesh.verts[t1 * TERRAIN_VERTEX_SIZE]
			_v2_start := mesh.verts[t2 * TERRAIN_VERTEX_SIZE]
			_v3_start := mesh.verts[t3 * TERRAIN_VERTEX_SIZE]

			_v1 :_vec=?
			_v1.w = 0.0

			_v2 :_vec=?
			_v2.w = 0.0

			_v3 :_vec=?
			_v3.w = 0.0
			
			memcpy(&_v1, _v1_start, 3 * 4)
			memcpy(&_v2, _v2_start, 3 * 4)
			memcpy(&_v3, _v3_start, 3 * 4)

			//__dbg_break
			_v1 += trn_ent.pos + mesh.pos
			_v2 += trn_ent.pos + mesh.pos
			_v3 += trn_ent.pos + mesh.pos

			draw_tri(ctx, &_v3, &_v2, &_v1, &tcol, 0)
			/*
			print_vec(&_v1)
			print_vec(&_v2)
			print_vec(&_v3)
			printf("\n")
			globals.temp_alloc.cur = 0
			__dbg_break
			*/
			

			t += 3
		}
		}
		*/

        if player_ent.mov_info.asking_for_this_scene && player_ent.mov_info.asking_for_this_scene != ctx.cur_scene_changing &&
          (stage == loading_stage.NOT_DONE_BUT_CAN_CHANGE_SCENES || stage == loading_stage.NONE)
        {
          ctx.cur_scene_changing = player_ent.mov_info.asking_for_this_scene
          ctx.cur_scene_changing_sz = player_ent.mov_info.asking_for_this_scene_sz

          ctx.cur_changing_loading_area = player_ent.mov_info.asking_for_this_loading_area

          l_area := player_ent.mov_info.asking_for_this_loading_area

          already_loaded := false
          for s in ctx.scenes
          {
            if s.in_use && str_cmp(s.name, ctx.cur_scene_changing_name)
            {
              already_loaded = true
              break
            }
          }
          if already_loaded
          {
            player_ent.mov_info.asking_for_this_scene = nil
            ctx.cur_scene_changing = nil
          }
          else
          {
            ctx.changing_scn = get_not_used_scene(ctx, ctx.cur_scene_changing_name)
          }
        }
        if ctx.cur_scene_changing
        {
          //assert(ctx.changing_scn != nil)
          OpenScene(&ctx.coroutines, ctx.changing_scn, &stage, ctx.cur_scene_changing, cast(s64)ctx.cur_scene_changing_sz, &cor)
          if stage == loading_stage.DONE
          {
            caux := cor
            printf("stage {cast(u32)stage}\n")
            ctx.cur_scene_changing = nil
            player_ent.mov_info.asking_for_this_scene = nil
            stage = loading_stage.NONE
            cor.regs.rip = 0

            l_area := ctx.cur_changing_loading_area
             
            //__dbg_break

          }
          //printf("not done stage {cast(u32)stage}\n")

        }
		mx = GetMouseScreenPosX() - curmx;
		my = GetMouseScreenPosY() - curmy;
		mx = mx / 500.0
		my = my / 500.0
		EndFrame(ctx.window);
		ctx.frames_total++;

		if ctx.can_deactivate_path_ents
		{
			for e in ctx.path_ents
			{
				e.is_active = false
			}
			ctx.can_deactivate_path_ents = false
		}
    globals.selected_ent = out_ent
	}
}

find_empty_asset::fn(idx : u64) ! u64
{
	ret : u64
	while ret < ASSETS_MAX
	{
		cur_idx := (ret + idx) % ASSETS_MAX
		cur_asset := globals.assets[cur_idx]
		if cur_asset.in_use == false
		{
			memset(cur_asset, 0, sizeof(asset_info))
			cur_asset.in_use = true
			return cur_idx
		}
		ret++
	}
	ASSERT(false)
	return -1
}
load_tex::fn(ctx : *scene_info, name:str_lit, x_offset : u32, y_offset:u32, sp_width:u32, sp_height:u32) ! asset_index
{
	ret :asset_index
	found := find_asset(ctx, name, &ret)
	if found
	{
		return ret
	}
	empty_idx := find_empty_asset(ASSETS_TEXTURES_OFFSET)
	a := globals.assets[empty_idx]
	a.cid.id.a_type = cast(u8)cast(u32)asset_type.TEXTURE_ARRAY

	ln := str_ln(name)
	ASSERT(ln < 12)
	
	memcpy(a.cid.name, name, ln)

	tex :texture_info
	tex.id = LoadTex(name, x_offset, y_offset, sp_width, sp_height)
	tex.x_offset = x_offset
	tex.y_offset = y_offset
	tex.width = sp_width
	tex.height = sp_height
	tex.idx_on_array = cast(u32)(globals.textures.count - 1)

	a.in_use = true

	ret.asset_idx = cast(u32)empty_idx
	dyn_add(&a.TEXTURE_ARRAY.texs, &tex)

	return ret
}
clear_material_instances::fn()
{
	idx :u32

	while idx < ASSETS_MAX
	{
		cur := cast(u64)ASSETS_MATERIALS_OFFSET + idx
		cur = cur % ASSETS_MAX
		cur_asset :=globals.assets[cur]
		if cur_asset.type == asset_type.MATERIAL
		{
			dyn_clear(&cur_asset.MATERIAL.mat.instances)
		}

		idx++
	}
}
find_asset::fn(ctx : *scene_info, name:str_lit, out : *asset_index, start : u64 = 0) ! bool
{
	idx :u32
	aux_buffer:[13]char
	ln: =str_ln(name)

	while idx < ASSETS_MAX
	{
		cur := start + idx
		cur = cur % ASSETS_MAX
		cur_asset :=globals.assets[cur]

		if memcmp(name, cur_asset.cid.name, ln)
		{
			out.asset_idx = cast(u32)cur
			return true
		}

		idx++
	}
	return false
}
TERRAIN_TRIS_SIZE :const s32=(MESH_WIDTH ) * (MESH_WIDTH) * 6 * 4
TERRAIN_MESHES_SIZE :const s32= sizeof(mesh_info) * (TERRAIN_WIDTH * TERRAIN_WIDTH + 1)
TERRAIN_CHUNKS_COL_SIZE :const s32= sizeof(mesh_info) * TERRAIN_WIDTH * TERRAIN_WIDTH


UpdateEntsWithClips::fn(ctx : *scene_info, dt : f32)
{
	if ctx.ents_with_clip.count == 0
		return;
	for e in ctx.ents_with_clip
	{
		if !e.is_active
			continue;
		//__dbg_break;
		UpdateClip2(*e, dt);
		
	}
}

find_bone2::fn(name : str_lit, m : *model_info) ! *bone_animation
{
	for b in m.roots
	{
		if str_cmp(b.name, name)
		{
			return *b
		}
		val := find_bone(name, *b)
		if val
		{
			return val
		}
	}
	return nil
}
find_bone::fn(name : str_lit, b : *bone_animation) ! *bone_animation
{
	if str_cmp(b.name, name)
	{
		return b
	}
	for ch in b.children
	{
		val := find_bone(name, *ch)
		if val
		{
			return val
		}
	}
	return nil
}

