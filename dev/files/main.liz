			editor_window(ctx, &out_ent, dt)

			if prev_ent != nil&& prev_ent.type == ent_type.AUX_COL_ENT
			{
				out_ent = prev_ent
			}

		}
		
		if change_select_ent_col && out_ent != nil
		{
		}
		if IsKeyDown(key_enum.KEY_F2)
		{
