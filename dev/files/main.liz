ChangeState::fn(e : *entity, state : entity_state)
{
	if e.state != state
	{
		e.cl = nil;
		e.state = state;
		e.clip_time = 0.0;
		e.clip_done = false;
	}
}

clamp ::fn(v : f32, _min :f32, _max : f32) ! f32
{
	if v <= _min return _min;
	if v >= _max return _max;
	return v;
}

NextInvItem::fn(inv : *inventory, cur : **inv_slot)
{
	last := dyn_last(&inv.items);
	
	next := ptr_offset(*cur, 1, inv_slot);
	if cast(u64)next <= cast(u64)last && next.item != inv_item.EMPTY
	{
		*cur = next;
	}
}
PrevInvItem::fn(inv : *inventory, cur : **inv_slot)
{
	start := inv.items[0];
	prev := ptr_offset(*cur, -1, inv_slot);
	if cast(u64)prev >= cast(u64)start && prev.item != inv_item.EMPTY
	{
		*cur = prev;
	}
}


DoFreezeTime::fn(ctx : *context, max : f32, smooth : bool, dt : *f32, cam_rot : *_vec)
{
	cam_rot.z = 0.0;
	if (ctx.enable_freeze_timer && ctx.freeze_timer == 0.0)
	{
		cam_rot.z = 0.01;
	}
	if smooth
	{
		if ctx.enable_freeze_timer && ctx.freeze_timer < max
		{
			ctx.freeze_timer += *dt;
			*dt = *dt * (ctx.freeze_timer / max);
			//dt = 0.0;
		}
		else
		{
			ctx.freeze_timer = 0.0;
			ctx.enable_freeze_timer = false;
		}
	}
	else
	{
		if ctx.enable_freeze_timer && ctx.freeze_timer < max
		{
			ctx.freeze_timer += *dt;
			*dt = 0.0;
			//dt = 0.0;
		}
		else
		{
			ctx.freeze_timer = 0.0;
			ctx.enable_freeze_timer = false;
		}
	}
}

anim_add_tex_kf::fn(tm : *timeline, at : f32, in_tex_id : u32)
{
	kf: keyframe;
	kf.{
		time = at;
		tex_id = in_tex_id;
	};
	dyn_add(&tm.kfs, &kf);
	aoeu: = 0;
}

anim_add_activate_kf::fn(tm : *timeline, at : f32, val_in : bool, act_type : activate_type)
{
	kf: keyframe;
	kf.{
		time = at;
		activate.type = act_type;
		activate.val = val_in;
	};
	dyn_add(&tm.kfs, &kf);

}
anim_add_mov_kf::fn(tm : *timeline, at : f32, x : f32, y : f32, z : f32)
{
	kf: keyframe;
	kf.{
		time = at;
		mov.pos.x = x;
		mov.pos.y = y;
		mov.pos.z = z;
	};
	dyn_add(&tm.kfs, &kf);
}

CreateNewClip::fn(ctx : *context)!*clip2
{
	ret:= cast(*clip2)heap_alloc(ctx.alloc, sizeof(clip2));
	ret.loop = true;
	ret.vel = 1.0;
	dyn_init2(&ret.tms, 4, ctx.alloc);

	ret.tms.count = 1;
	tm: = ret.tms[0];
	dyn_init2(&tm.kfs, 4, ctx.alloc);

	return ret;
}
CreateAnim::fn(ctx : *context, start_idx : u32, end_idx : u32, texs_idxs : *u32, count_texs : u32) ! *clip2
{
	ASSERT(end_idx < (start_idx + count_texs));

	clip1: = CreateNewClip(ctx);
	clip1.loop = true;
	//dyn_init2(&clip1.tms, 4, ctx.alloc);
	tm: *timeline= clip1.tms[0];
	tm.type = timeline_type.TEXTURE;


	//tex_ptr: = ctx.character_texs.tex_idxs;
	
	for i in start_idx..end_idx
	{
		idx: = i - start_idx;
		anim_add_tex_kf(tm, (cast(f32)idx) * 0.1, *ptr_offset(texs_idxs, cast(u64)i, u32));
	}
	clip1.len = cast(f32)(end_idx - start_idx) * 0.1;
	return clip1;
}



