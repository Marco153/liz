Max::fn(a : s32, b : s32) !s32
{
	ret: = if a > b a else b;
	return ret;
}


DrawSquare::fn(ctx : *context, x : f32, y : f32, w : f32, h : f32, col : *_vec)
{
	draw : draw_info
	draw.pos.x = x
	draw.pos.y = y
	draw.pos.z = 0.05
	memcpy(draw.color[0], col, 16)
	draw.ent_size.x = w
	draw.ent_size.y = h
	draw.cam_size = 1.0

	draw.flags = DRAW_INFO_NO_SCREEN_RATIO | DRAW_INFO_NO_DEPTH_TEST
	Draw(ctx.window, &draw)
}
DrawText::fn(ctx : *context, str : str_lit, x : f32, y : f32, color:*_vec, sz : f32=1.0)
{
	ln := str_ln(str)

	if ln == 0
		return;
	draw : draw_info

	cursor_x:f32=0.0
	cursor_y:f32=0.0

	w := 0.05 * sz
	h := 0.06 * sz

	for i in 0..ln
	{
		memcpy(&draw.color, color, 16)
		draw.pos.x = cursor_x + x
		draw.pos.y = cursor_y + y
		draw.pos.z = 0.09;
		draw.ent_size.x = w;
		draw.ent_size.y = h;
		draw.flags = DRAW_INFO_HAS_TEXTURE;

		idx :=*ptr_offset(str, i, u8) - cast(u8)' 
		ch_idx := *ptr_offset(ctx.abcd_texs.tex_idxs, idx, u32)

		draw.texture_id = ch_idx
		draw.cam_size = 1.0;

		cursor_x += w
		Draw(ctx.window, &draw);
	}
}

UpdatePrinter::fn(ctx : *context, p : *printer, dt : f32)
{
	p.cur_time += dt;

	if p.cur_time >= p.time_to_next_ch && p.cur_ch < p.str_ln
	{
		p.cur_time = 0.0;

		p.cur_ch++;
		ch := *ptr_offset(p.str, cast(u64)p.cur_ch, u8);
		if (cast(char)ch) == ' 
			p.cur_ch++;
	}
	if p.cur_ch >= p.str_ln
	{
		p.done = true;
	}

	draw:draw_info;
	cursor_time : global f32;
	if p.cur_ch >= p.str_ln && p.str_ln > 0
	{
		time_int := cast(u32)cursor_time;
		if (time_int % 2) == 0 && p.end_cursor
		{
			draw.color = []f32{ 1.0, 1.0, 1.0, 1.0 };
			draw.flags = 0;
			draw.pos.x = 0.0;
			draw.pos.y = -0.5;
			draw.cam_size = 1.0;
			draw.ent_size.x = 0.1;
			draw.ent_size.y = 0.1;

			//Draw(ctx.window, &draw);
		}
		if IsKeyDown(key_enum.KEY_ACT0)
			p.done = true;

		cursor_time += dt;
		if time_int > 3
			cursor_time = 0.0;
	}
	
	
	// black background
	if p.str_ln != nil
	{
		draw.pos.{
			x = -1.0;
			y = -1.0;
			z = 0.1;
		};
		draw.ent_size.{
			x = 2.0;
			y = 0.6;
		};
		*draw.color[0] = 0.2;
		*draw.color[1] = 0.2;
		*draw.color[2] = 0.2;
		*draw.color[3] = 0.8;
		draw.cam_size = 1.0;
		//draw.flags = DRAW_INFO_NO_SCREEN_RATIO | DRAW_INFO_STENCIL_WRITE;
		draw.flags = DRAW_INFO_NO_SCREEN_RATIO;
		//draw.stencil_val = 7;
		Draw(ctx.window, &draw);
	}
	cursor_x := 0.0;
	cursor_y := 0.0;
	first_letter := true;
	letter :u32= 0;
	letter_h := 0.05;
	for idx in 0..p.cur_ch
	{
		
		if first_letter
		{
			cur_letter:=0;

			if *ptr_offset(p.str, cast(u64)idx, char) == 's
			{
				//__dbg_break;
			}

			while !IsTerminalCharater(*ptr_offset(p.str, idx + cast(s64)(cur_letter), char)) && cast(u64)(idx + cur_letter) < p.str_ln
			{
				cur_letter++;
			}


			idx_in_line := cast(s32)letter;
			if (cur_letter  + idx_in_line) > cast(s32)p.chars_per_line &&  (idx + cur_letter) < cast(s32)p.str_ln
			{
				cursor_x = 0.0;
				cursor_y -= letter_h + letter_h/4.0;
				letter = 0;
			}
			first_letter = false;
		}

		if letter >= p.chars_per_line
		{
			cursor_x = 0.0;
			cursor_y -= letter_h + letter_h/4.0;
			letter = 0;
		}
		ch := *ptr_offset(p.str, cast(u64)idx, u8);
		//PrintV3(p.cur_time, cast(f32)idx, 0.0);
		if (cast(char)ch) != '  
		{
			draw.color = []f32{ 1.0, 1.0, 1.0, 1.0 };
			draw.pos.x = cursor_x + p.pos.x;
			draw.pos.y = cursor_y + p.pos.y;
			draw.pos.z = 0.09;
			draw.ent_size.x = 0.05;
			draw.ent_size.y = letter_h;
			draw.flags = DRAW_INFO_HAS_TEXTURE;

			ch_idx := GetCharTextureIdx(cast(char)ch);

			draw.texture_id = *ptr_offset(p.texs, ch_idx, u32);
			draw.cam_size = 1.0;
			Draw(ctx.window, &draw);
			first_letter = false;
		}
		else
		{
			first_letter = true;
		}
			
		space_at_start := (cast(char)ch) == '  && letter == 0;

		if !space_at_start
			cursor_x += draw.ent_size.x;
		letter++;
	}
}

ClearPrinterStr::fn(ctx : *context)
{
	ctx.prntr.str = nil;
	ctx.prntr.str_ln = 0;
	ctx.prntr.cur_ch = 0;
	ctx.prntr.done = false;
}
ChangePrinterStr::fn(ctx : *context, str : str_lit)
{
	ctx.prntr.str = str;
	ctx.prntr.str_ln = str_ln(str);
	ctx.prntr.cur_ch = 0;
	ctx.prntr.done = false;
}


