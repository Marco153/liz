	player_ent.anim_func = fn(ent : *entity, dt : f32)
	{
		mov := ent.mov_info
		b := mov.neck_bone

		up :_vec
		up.y = 1.0
		z:_vec
		z.z = 1.0

		q:quaternion
		q.v = ent.rot
		euler := quaternion_to_euler(&q.v)
		final_rot_ := euler_to_quaternion(-270.0, 0.0, 0.0) * q
		final_rot_.v.y = final_rot_.v.z
		final_rot_.v.z = 0.0
		final_rot_ = inverse_quaternion(cast(*quaternion)&final_rot_)

		
		original_z := z

		target_pos :_vec
		target_pos.x = 76.0
		target_pos.y = 71.0
		target_pos.z = 5.0
		dir := ent.pos - target_pos 
		dir = normalize_vec(&dir)
		

		ang := angle_on_axis(&z, &dir, &up)

		rot := euler_to_quaternion(0.0, radians_to_degree(ang), 0.0)

		final_rot_ = rot * final_rot_
		b.target_rot = final_rot_.v

		d := dot_vec(&dir, &ent.forward)
		
		if d > 0.2
		{
			b.target_rot_weight += dt

		}
		else
		{
			b.target_rot_weight -= dt * 4.0
		}

		b.target_rot_weight = clamp(b.target_rot_weight, 0.0, 1.0)
	}
