Cutscenes::fn coroutine(cor_ctx : *coroutine_ctx, ctx : *context, dt : *f32)
{
	if ctx.cutscene_idx == 1
	{
		ctx.player.mov_info.can_move = false;
		//ctx.
		//ct
		//ctx.player.can_move //=
		//CorWait(4.0);
		ChangePrinterStr(ctx, GetDialogueStr(dialogue_enum.LEVEL_1_SIGN, 0));
		CorMoveVecTo(ctx.cam_pos_global, -29.0, 5.0, 0.0, 2.0, ctx.cam_col_left);
		while true
		{
			if ctx.prntr.done && IsKeyDown(key_enum.KEY_JMP)
			{
				break;
			}
			return;
		}
		ClearPrinterStr(ctx);
		ctx.player.mov_info.can_move = true;
		ctx.cutscene_idx = 0;
		ResetCoroutine();
	}
}



MakeEntMasked::fn(ctx : *context, ent : *entity, masked :  *masked_info)
{
	ent.flags = ent.flags | ENTITY_IS_MASKED;
	ent.stencil_val = masked.stencil_val;
	ent.stencil_func = stencil_func_enum.EQUAL;
	ent.masking_objs = &ctx.masking_objs;
}
FreeArrayOfEnts::fn(ar : *dyn_array(*entity))
{
	for e in *ar
	{
		if is_flag_on(e.flags, ENTITY_DONT_FREE | ENTITY_FREED)
			continue;
		e.flags = ENTITY_DONT_FREE;
		heap_free(ar.alloc, *e);
		
	}
}

min :: fn(a : s32, b : s32) ! s32
{
	if a < b return a;
	return b;
}
min :: fn(a : u32, b : u32) ! u32
{
	if a < b return a;
	return b;
}
min :: fn(a : f32, b : f32) ! f32
{
	if a < b return a;
	return b;
}

axe_throw_callback::fn(data : *anim_callback_info) !bool
{
	if data.time_since_stopped > 3.0
		return true;
	return false;
}

NewAxeEnt::fn(ctx : *context) ! *entity
{
	axe_ent := NewEnt(ctx.alloc, "axe");
	axe_ent.is_trigger = true;
	axe_ent.type = ent_type.AXE;
	axe_ent.col_enter = axe_trig_collision_enter;
	add_body(ctx, axe_ent);
	axe_ent.flags = ENTITY_HAS_TEXTURE | ENTITY_DONT_FREE;
	axe_ent.layer = LAYER_TRIGGER
	axe_ent.tex_id = cast(u32)ctx.axe_tex;
	axe_ent.is_active = true;
	axe_ent.axe = cast(*axe_info)heap_alloc(ctx.alloc, sizeof(axe_info));
	axe_ent.pivot.x = 0.5;
	axe_ent.pivot.y = 0.5;
	axe_ent.pos.y = 5.0;
	return axe_ent;
}
NewInventory::fn(ctx : *context, slots : u32) ! *inventory
{
	inv:*inventory = cast(*inventory)heap_alloc(ctx.alloc, sizeof(inventory));
	dyn_init2(&inv.items, slots, ctx.alloc);
	inv.items.count = slots;
	return inv;
}
NewPlayerEnt::fn(ctx : *context, name : str_lit) ! *entity
{
	player_ent:*entity;
	NewPlayableEnt(ctx, &player_ent, false);
	
	player_ent.flags = player_ent.flags | ENTITY_DONT_FREE;
	//player_ent.mov_info.axe_ent = NewAxeEnt(ctx);
	
	
	player_ent.layer = LAYER_ENTITY_PLAYABLE | LAYER_PLAYER
	player_ent.dont_res_cols_with_layers = LAYER_ENTITY_PLAYABLE;

	player_ent.name = name;
	player_ent.pos.x = 4.0;
	player_ent.pos.y = 4.0;
	player_ent.size.x = 1.0;
	player_ent.size.y = 1.0;
	player_ent.col_size.x = 0.7;
	player_ent.col_size.y = 0.7;
	player_ent.pivot.x = 0.5;
	player_ent.pivot.y = 0.5;
	player_ent.color.x = 1.0;
	player_ent.color.y = 1.0;
	player_ent.color.z = 1.0;
	player_ent.color.w = 1.0;
	player_ent.col_enter = player_collision_enter;
	player_ent.col_stay = player_collision_stay;
	player_ent.col_exit = player_collision_exit;
	player_ent.is_active = true;

	player_ent_trigger: = player_ent.mov_info.trigger;
	pinfo: = player_ent.mov_info;
	pinfo.{
		speed = 5.0;
	};
	
	mov_info := player_ent.mov_info;
	
	player_ent.flags = player_ent.flags | ENTITY_HAS_TEXTURE;
	
	
	
	return player_ent;
}

DrawUpperInv::fn(ctx : *context, islot : *inv_slot)
{
	draw:draw_info;
	
	draw.pos.x = -0.1;
	draw.pos.y = 0.8;
	draw.pos.z = 0.8;
	draw.ent_size.y = 0.2;
	draw.ent_size.x = 0.2;
	draw.cam_size = 1.0;
	//draw.cam_pos = ctx.cam_pos_global;
	draw.color = []f32{0.0, 0.0, 0.0, 1.0};
	draw.flags = 0;
	Draw(ctx.window, &draw);
	
	draw.flags = DRAW_INFO_HAS_TEXTURE;
	item := islot.item;
	if item == inv_item.AXE
	{
		draw.texture_id = *ctx.inv_texs.tex_idxs;
	}
	else if item == inv_item.SPEAR
	{
		draw.texture_id = *ptr_offset(ctx.inv_texs.tex_idxs, 1, u32);
	}
	else if item == inv_item.BRACELET_OF_SINCERITY
	{
		draw.texture_id = *ptr_offset(ctx.inv_texs.tex_idxs, 2, u32);
	}
	else
	{
		__dbg_break;
	}
	draw.pos.z = 0.5;
	draw.color = []f32{1.0, 1.0, 1.0, 1.0};
	Draw(ctx.window, &draw);
}

tst_st : struct
{
	val : u32,
	ar : dyn_array(cell)
	#serializable(val, ar)
}

has_blocks_left::fn(ar : *dyn_array(dyn_array(_vec)), y : *u64) ! bool
{
	*y = 0
	for ar_y in* ar
	{
		if ar_y.count > 0
		{
			return true;
		}
		*y++;
	}
	return false;
}
below_block_is_contiguous::fn(blocks_grid : *dyn_array(dyn_array(_vec)), cur : *_vec, str : str_lit, grid_width : u32, out_idx_on_same_x : *u64) ! bool
{
	if cast(u32)cur.y < cast(u32)(blocks_grid.count - 1) &&
		*level_str_offset(str, cast(u32)cur.x, cast(u32)cur.y, grid_width) == '-
	{
		row := blocks_grid[cast(u64)cast(u32)cur.y]
		if row.count == 0
		{
			return false
		}
		i :u64
		while (row[i].x - cur.x) < 0.1
		{
			i++
		}
		*out_idx_on_same_x = i
		return true;
	}

	return false;
}
level_str_offset::fn(str: str_lit, x : u32, y : u32, width: u32) ! *char
{
	// y * 2 accounts for \n\r
	return str[cast(u64)(2 + x + y * width + y * 2)]
}
create_map_from_str::fn(ctx : *context, str : str_lit, final_t : *_vec)
{
	width : u32
	i : u32
	len := str_ln(str)
	while (*str[width + 2] != '\n && *str[width + 2] != '\r)
	{
		width++
	}

	height :u64
	i = 2
	while i < cast(u32)len
	{
		if *str[i] == '\n
		{
			height++
		}
		i++
	}
	height++
	i = 0

	// subing 2 because the first character is a new line


	blocks_grid : dyn_array(dyn_array(_vec))
	wp : waypoint


	for y in 0..height
	{
		cur_ar : dyn_array(_vec)
		dyn_init2(&cur_ar, width, ctx.alloc)
		for x in 0..width
		{
			fx := cast(f32)x
			fy := cast(f32)(height - cast(u64)y)
			ch := *level_str_offset(str, cast(u32)x, cast(u32)y, width)
			if ch == '-
			{
				last_on_x := cast(u64)x >= (width - 1)
				last_on_y := cast(u64)y >= (height - 1)
				first_on_x := x == 0
				first_on_y := y == 0

				if !last_on_x && !last_on_y  && !first_on_x && !first_on_y
				{
					prev_x := *level_str_offset(str, cast(u32)x - 1, cast(u32)y, width)
					next_x := *level_str_offset(str, cast(u32)x + 1, cast(u32)y, width)

					prev_y := *level_str_offset(str, cast(u32)x, cast(u32)y - 1, width)
					next_y := *level_str_offset(str, cast(u32)x, cast(u32)y + 1, width)

					if prev_x == '- && next_x == '- && prev_y == '- && next_y == 'n
					{
						continue
					}
				}
				v :_vec
				v.x = fx
				v.y = fy
				v.z = 0.1
				dyn_add(&cur_ar, &v)

			}
			else if ch == 'p
			{
				ctx.player.pos.x = fx
				ctx.player.pos.y = fy
				ctx.player.pos.z = 0.1
				ctx.player.pos.w = 0.0
				dyn_add(&ctx.drawable_ents, ctx.player)
			}
			else if ch == 't
			{
				final_t.x = fx
				final_t.y = fy
				final_t.z = 0.0
				final_t.w = 0.0
			}
			else if ch == 'w
			{
				wp.pos.x = fx + 0.5
				wp.pos.y = fy + 0.5

				dyn_add(&ctx.waypoints, &wp)
			}
		}
		dyn_add(&blocks_grid, &cur_ar)
	}

	y : u64
	while has_blocks_left(&blocks_grid, &y)
	{
		row_ar := blocks_grid[y]
		start_pos :_vec= *row_ar[0]

		
		next_is_contiguous := false

		contiguous_width := 0

		cur_b :u64=1
		cur_prev := start_pos
		if row_ar.count > 1
		{

			while cur_b < row_ar.count && (row_ar[cur_b].x - cur_prev.x) < 1.1
			{
				next_is_contiguous = true
				cur_prev = *row_ar[cur_b]
				cur_b++
			}
		}


		sz :_vec
		sz.x = 1.0
		sz.y = 1.0
		if next_is_contiguous
		{
			sz.x = cast(f32)cur_b
			while cur_b > 0
			{
				dyn_rem(row_ar, 0)
				cur_b--
			}
		}
		else
		{
			down_is_contiguous := false

			cur_downwards_idx := y

			if y < (blocks_grid.count - 1)
			{
				next_row := blocks_grid[cur_downwards_idx + 1]
				out_below_block_idx : u64
				while below_block_is_contiguous(&blocks_grid, &cur_prev, str, width, &out_below_block_idx)
				{
					cur_prev = *next_row[out_below_block_idx]
					dyn_rem(next_row, cast(u32)out_below_block_idx)

					cur_downwards_idx++

					next_row = blocks_grid[cur_downwards_idx]
				}

			}
			else
			{
				idx_block_to_remove :u32
				for b in *row_ar
				{
					if (b.x - start_pos.x) < 0.1
					{
						break;
					}
					idx_block_to_remove++
				}
				ASSERT(idx_block_to_remove < cast(u32)row_ar.count)
				dyn_rem(row_ar, idx_block_to_remove)

				cur_downwards_idx++
			}
			block_height := cur_downwards_idx - y
			sz.y = cast(f32)block_height
		}
		ent := NewEnt(ctx.alloc, "block");
		ent.is_active = true;
		ent.pos = start_pos
		ent.pos.z = 0.1
		ent.col_size = sz
		//ent.col_size.y = 1.0
		ent.size = ent.col_size
		ent.is_static = true;
		ent.color.w = 1.0
		dyn_add(&ctx.drawable_ents, &ent);
		add_body(ctx, ent);

		block_width := 1
	}

	for cur_w in ctx.waypoints
	{
		for aux_w in ctx.waypoints
		{
			if aux_w == cur_w
			{
				continue;
			}
			col : collision
			if !Raycast(ctx, &cur_w.pos, &aux_w.pos, &col, LAYER_TRIGGER | LAYER_PLAYER, nil)
			{
				dyn_add(&cur_w.neighbors, aux_w)
			}
		}
	}
}
head_long_term_meeting_diff::fn(ctx : *context, t : *thinking, out : *f32) ! bool
{
	head:*long_term_action = t.long_term_acts[0]
	if *head == long_term_action.MEETING_AT
	{
		*out = head.MEETING_AT.hour - ctx.time_since_start
		return true
	}

	return false
}
add_long_term::fn(t : *thinking, r : *long_term_action)
{
	dyn_add(&t.long_term_acts, r)
}
add_mid_term::fn(t : *thinking, r : *rated_stuff(mid_term_action))
{
	lesser_idx : u32

	for cur_r in t.mid_term_acts
	{
		if r.val > cur_r.val 
		{
			break
		}
		lesser_idx++
	}

	if cast(u64)lesser_idx >= t.mid_term_acts.count
	{
		dyn_add(&t.mid_term_acts, r)
	}
	else
	{
		dyn_add_at(&t.mid_term_acts, lesser_idx, r)
	}
}
has_mid_term::fn(t : *thinking, type : u32) !bool
{
	for m in t.mid_term_acts
	{
		if cast(u32)m.type == type
		{
			return true
		}
	}
	return false
}

check_mid_term_adding::fn(ctx : *context, e : *entity, dt  : *f32)
{
	t : *thinking= e.thoughts
	mid := &t.mid_term_acts
	diff : f32

	no_short_terms := t.short_term_acts.count == 0

	if no_short_terms 
		&& head_long_term_meeting_diff(ctx, t, &diff) 
		&& diff > -20.0
		&& !has_mid_term(t, cast(u32)mid_term_action.TEST)
	{
		r : rated_stuff(mid_term_action)
		r.val = 10.0
		r.type.type = mid_term_action.TEST
		r.type.TEST.secs = 5.0
		add_mid_term(t, &r)
	}
}
mid_term::fn(ctx : *context, e : *entity, dt  : *f32)
{
	t : *thinking= e.thoughts

	if t.mid_term_acts.count == 0
	{
		return;
	}
	head_r:*rated_stuff(mid_term_action) = t.mid_term_acts[0]
	head :*mid_term_action= &head_r.type

	if *head == mid_term_action.TEST
	{
		if head.TEST.frames % 30 == 0
		{
			r : short_term_action
			r.type = short_term_action.SAY
			r.SAY.str = "hello"
			dyn_add(&t.short_term_acts, &r)
		}
		head.TEST.cur += *dt
		head.TEST.frames++

		if head.TEST.cur >= head.TEST.secs
		{
			dyn_rem(&t.mid_term_acts, 0)
		}
	}
	else if *head == mid_term_action.MEETING_AT 
	{
		if !head_r.in_curse
		{
			long_t := t.long_term_acts[cast(u64)head.MEETING_AT.long_term]

			go_path : short_term_action
			go_path.type = short_term_action.GO_PATH

			closest_wp := get_closest_waypoint(&ctx.waypoints, &e.pos)
			ASSERT(closest_wp)
			
			find_wpath(ctx, closest_wp, &long_t.MEETING_AT.pos, &go_path.GO_PATH.path)

			dyn_clear(&t.short_term_acts)
			
			dyn_add(&t.short_term_acts, &go_path)
			head_r.in_curse = true
		}
	}
}
set_vel_dir_ret_dist::fn(vel : *_vec, start : *_vec, end : *_vec, vel_mul : f32, normal : *_vec) ! f32
{
	dir := (*end - *start)
	dist := dot_vec(&dir, &dir)
	dir = normalize_vec(&dir)

	*vel = dir * vel_mul
	if normal
	{
		normal.x = dir.y
		normal.y = -dir.x
	}
	return dist
}
short_term::fn(ctx : *context, e : *entity, dt  : *f32)
{
	t : *thinking= e.thoughts

	if t.short_term_acts.count == 0
	{
		return 
	}
	head:*short_term_action = dyn_last(&t.short_term_acts)

	if *head == short_term_action.SAY
	{
		printf(head.SAY.str)
		dyn_rem(&t.short_term_acts, 0)
	}
	else if *head == short_term_action.GO_TO
	{
		normal :_vec
		dir := (head.GO_TO.pos - e.pos)
		dist := dot_vec(&dir, &dir)
		dir = normalize_vec(&dir)

		e.vel = dir
		normal.x = dir.y
		normal.y = -dir.x

		left_ray_start:= e.pos + normal * 0.5
		right_ray_start:= e.pos + normal * -0.5
		left_ray_end:= left_ray_start + dir * 1.5
		right_ray_end:= right_ray_start + dir * 1.5

			/*
		draw:draw_info

		draw.pos.x = left_ray_start.x
		draw.pos.y = left_ray_start.y
		draw.pos.z = left_ray_end.x
		draw.pos.w = left_ray_end.y
		draw.flags = DRAW_INFO_LINE
		*draw.color[1] = 1.0
		*draw.color[3] = 1.0
		draw.cam_pos = ctx.cam_pos_global;
		draw.cam_size = ctx.cam_size;
		Draw(ctx.window, &draw)

		head.GO_TO.frames++

		if (head.GO_TO.frames % 15) == 0
		{
			head.GO_TO.flags = 0


			col : collision
			out : *entity
			if Raycast(ctx, &left_ray_start, &left_ray_end, &col, LAYER_PLAYER | LAYER_TRIGGER, &out)
			{
				head.GO_TO.flags = 1
				printf("left ent name %\n", col.ent.name)
			}
			else if Raycast(ctx, &right_ray_start, &right_ray_end, &col, LAYER_PLAYER | LAYER_TRIGGER, &out)
			{
				head.GO_TO.flags = 2
				printf("right ent name %\n", col.ent.name)
			}

			surface_dir: _vec
			surface_dir.x = col.normal.y
			surface_dir.y = col.normal.x
			// left ray col
			if head.GO_TO.flags == 1
			{
				if dot_vec(&surface_dir, &dir) < 0.0
				{
					surface_dir = surface_dir * -1.0
				}
			}
			// right ray col
			else if head.GO_TO.flags == 1
			{
				if dot_vec(&surface_dir, &dir) > 0.0
				{
					surface_dir = surface_dir * -1.0
				}
			}


			head.GO_TO.x_vel_when_ray_col = cast(s8)cast(s32)(surface_dir.x * 128.0)
			head.GO_TO.y_vel_when_ray_col = cast(s8)cast(s32)(surface_dir.y * 128.0)
		}
		if head.GO_TO.flags != 0
		{
			x := (cast(f32)cast(s32)head.GO_TO.x_vel_when_ray_col) / 128.0
			y := (cast(f32)cast(s32)head.GO_TO.y_vel_when_ray_col) / 128.0

			e.vel.x = x
			e.vel.y = y
		}
		*/
		//else
		//{
			e.vel = dir
			if dist < 0.01
			{
				t.short_term_acts.count--
			}
		//}

	}
	else if *head == short_term_action.GO_PATH
	{
		last := head.GO_PATH.path.count - 1
		cur := head.GO_PATH.cur_path
		pos := head.GO_PATH.path[last - cur]

		head.GO_PATH.cur_path++

		if cur > cast(u32)last
		{
			dyn_rem(&t.short_term_acts, 0)
		}
		else
		{
			r : short_term_action
			r.type = short_term_action.GO_TO
			r.GO_TO.pos = *pos
			dyn_add(&t.short_term_acts, &r)
		}
	}
	else
	{
		__dbg_break
	}
	i := 0

}
long_term::fn(ctx : *context, e : *entity, dt  : *f32)
{
	t : *thinking= e.thoughts

	if t.long_term_acts.count == 0
	{
		return;
	}
	head:*long_term_action = t.long_term_acts[0]
	if *head == long_term_action.MEETING_AT
	{
		diff := head.MEETING_AT.hour - ctx.time_since_start
		if diff < 0.0
		{
			//__dbg_break
			if t.short_term_acts.count == 0 && !has_mid_term(t, cast(u32)mid_term_action.MEETING_AT)
			{
				r : rated_stuff(mid_term_action)
				r.type.type = mid_term_action.MEETING_AT
				r.type.MEETING_AT.long_term = 0
				r.val = 40.0
				
				add_mid_term(t, &r)
			}
			diff = 0.0
		}
	}
	else
	{
		__dbg_break
	}
}
thinking_ents::fn(ctx : *context, dt  : *f32)
{
	for e in ctx.ents_think
	{
		t: *thinking = e.thoughts
		long_term(ctx, *e, dt)
		if t.check_mid_term
		{
			check_mid_term_adding(ctx, *e, dt)
			t.check_mid_term = false
		}
		mid_term(ctx, *e, dt)
		short_term(ctx, *e, dt);
	}
}
new_thinking::fn(ctx : *context, e : *entity)
{
	e.thoughts = cast(*thinking)heap_alloc(globals.alloc, sizeof(thinking))
	dyn_add(&ctx.ents_think, e)

}

test_ang ::fn(a : s32)
{
	axis : _vec
	axis.z = 0.0
	axis.x = 0.0
	axis.y = 1.0
	forward : _vec
	forward.z = 1.0
	
	rot :_vec
	ang := 3.1415 / 4.0
	s := sin(ang)
	rot.x = axis.x * s
	rot.y = axis.y * s
	rot.z = axis.z * s
	rot.w = cos(ang)

	rotate_vector(&forward, &forward, &rot)

	//print_vec(&forward)
	
}
draw_vertex ::fn(ctx : *context, pos : *_vec, sz : *_vec, cam_pos : *_vec, cam_rot : *_vec)
{
	draw : draw_info3d
	//draw.flags = DRAW_INFO_DBG_BREAK
	draw.pos = *pos
	draw.rot.w = 1.0
	draw.ent_size = *sz
	//print_vec(&draw.ent_size)
	*draw.color[0] = 1.0
	*draw.color[1] = 1.0
	*draw.color[2] = 1.0
	*draw.color[3] = 1.0
	draw.cam_pos = cam_pos;
	draw.cam_rot = cam_rot;
	//draw.cam_forward = ctx.cam_aux_forward_global;
	Draw3D(ctx.window, &draw)
}
DRAW_TRI_TRANSPARENY :const s32= 1

draw_tri::fn(ctx : *context, v1 : *_vec, v2 : *_vec, _v3 : *_vec, col : *_vec, flags : u32)
{
	draw : draw_info3d
	draw.flags = DRAW_INFO_TRIANGLE
	if is_flag_on(flags, DRAW_TRI_TRANSPARENY)
		draw.flags = draw.flags | DRAW_INFO_TRANSPARENT
	draw.pos = *_v3
	draw.pivot = *v2
	draw.ent_size = *v1
	memcpy(draw.color[0], col, 16)
	
	draw.cam_pos = ctx.cam_pos_global
	draw.cam_rot = ctx.cam_rot_global
	draw.cam_forward = ctx.cam_forward_global
	Draw3D(ctx.window, &draw)

}
DRAW_LINE_TIP :const s32= 1
DRAW_LINE_NO_PROJ :const s32= 2
draw_line::fn(ctx : *context, start : *_vec, end : *_vec, col : *_vec, flags : u32)
{
	draw : draw_info3d
	draw.flags =  DRAW_INFO_LINE;
	draw.pos = *start
	draw.ent_size = *end
	//print_vec(&draw.ent_size)
	memcpy(draw.color, col, 4 * 4);
	draw.cam_pos = ctx.cam_pos_global;
	draw.cam_rot = ctx.cam_rot_global;
	draw.cam_forward = ctx.cam_forward_global;
	if is_flag_on(flags, DRAW_LINE_NO_PROJ)
	{
		draw.flags = draw.flags | DRAW_INFO_NO_PROJ

	}
	Draw3D(ctx.window, &draw)
	if is_flag_on(flags, DRAW_LINE_TIP)
	{
		v_sz: _vec=?
		v_sz.x = 0.05
		v_sz.y = 0.05
		v_sz.z = 0.05
		v_sz.w = 1.0
		draw_vertex(ctx, end, &v_sz, ctx.cam_pos_global, ctx.cam_rot_global)
	}

}

cam_mov::fn(ctx : *context)
{
	axis : _vec
	axis.z = 0.0
	axis.x = 0.0
	axis.y = 1.0
	aux_forward := ctx.cam_aux_forward_global
	cam_forward := ctx.cam_forward_global
	cam_pos := ctx.cam_pos_global
	cam_rot := ctx.cam_rot_global

	speed := 5.0
	dt := 0.017

	if IsKeyHeld(key_enum.KEY_Q)
	{
		cam_pos.y += dt * speed
	}
	if IsKeyHeld(key_enum.KEY_E)
	{
		cam_pos.y -= dt * speed
	}
	if IsKeyDown(key_enum.KEY_F2)
	{
		globals.tog = !globals.tog
	}
	cross := cross_vec(cam_forward, &axis)
	if IsKeyHeld(key_enum.KEY_A)
	{
		*cam_pos -= cross * dt * speed

	}
	if IsKeyHeld(key_enum.KEY_D)
	{
		*cam_pos += cross * dt * speed
	}
	if IsKeyHeld(key_enum.KEY_W)
	{
		*cam_pos += *cam_forward * dt * speed
	}
	if IsKeyHeld(key_enum.KEY_S)
	{
		*cam_pos -= *cam_forward * dt * speed
	}
	
	dt = dt * 2.0
	if IsKeyHeld(key_enum.KEY_SHIFT)
	{
		if IsMouseHeld(mouse_enum.LEFT)
		{
			*cam_forward = euler_to_quaternion(0.0, radians_to_degree(dt), 0.0) * *cam_forward

			cam_rot.y += dt
			//cam_rot.x += dt
		}
		if IsMouseHeld(mouse_enum.RIGHT)
		{
			*cam_forward = euler_to_quaternion(0.0, -radians_to_degree(dt), 0.0) * *cam_forward

			cam_rot.y -= dt
			//cam_rot.x += dt
		}
	}
	else if IsKeyHeld(key_enum.KEY_JMP)
	{

		if IsMouseHeld(mouse_enum.LEFT)
		{
			cam_rot.x += dt
		}
		if IsMouseHeld(mouse_enum.RIGHT)
		{
			cam_rot.x -= dt
		}
	}
	//print_vec(cam_forward);
}
_draw_col ::fn(ctx : *context, c : *collider)
{
	on c.type
	{
	TRIANGLE
	{
		col : _vec
		col.x = 1.0
		_v1 :=*c.TRIANGLE.verts[0] 
		_v2 :=*c.TRIANGLE.verts[1] 
		_v3 :=*c.TRIANGLE.verts[2] 

		draw_line(ctx, &_v1, &_v2, &col, 0)
		draw_line(ctx, &_v2, &_v3, &col, 0)
		draw_line(ctx, &_v3, &_v1, &col, 0)

		nv1 := _v1 - c.TRIANGLE.normal
		nv2 := _v2 - c.TRIANGLE.normal
		nv3 := _v3 - c.TRIANGLE.normal

		draw_line(ctx, &nv1, &nv2, &col, 0)
		draw_line(ctx, &nv2, &nv3, &col, 0)
		draw_line(ctx, &nv3, &nv1, &col, 0)

		draw_line(ctx, &_v1, &nv1, &col, 0)
		draw_line(ctx, &_v2, &nv2, &col, 0)
		draw_line(ctx, &_v3, &nv3, &col, 0)
		
	}
	CUBE
	{
		col : _vec
		col.z = 1.0
		_v1 :=*c.CUBE.verts[0] 
		_v2 :=*c.CUBE.verts[1] 
		_v3 :=*c.CUBE.verts[2] 
		_v4 :=*c.CUBE.verts[3] 
		_v5 :=*c.CUBE.verts[4] 
		_v6 :=*c.CUBE.verts[5] 
		_v7 :=*c.CUBE.verts[6] 
		_v8 :=*c.CUBE.verts[7] 

		draw_line(ctx, &_v1, &_v2, &col, 0)
		draw_line(ctx, &_v2, &_v3, &col, 0)
		draw_line(ctx, &_v3, &_v4, &col, 0)
		draw_line(ctx, &_v4, &_v1, &col, 0)

		draw_line(ctx, &_v5, &_v6, &col, 0)
		draw_line(ctx, &_v6, &_v7, &col, 0)
		draw_line(ctx, &_v7, &_v8, &col, 0)
		draw_line(ctx, &_v8, &_v5, &col, 0)
	}
	}
}
VIEW_COL_METHOD:const s32= 1
view_collision ::fn(ccc : u32)
{
	curmx := GetMouseNormalizedPosX();
	curmy := GetMouseNormalizedPosY();



	ctx := cast(*context)globals.ctx
	gjk := cast(*gjk_state)globals.gjk
	if !gjk
		return;
	ClearBackground(0.7, 0.7, 0.7);

	cam_pos := ctx.cam_pos_global
	cam_rot := ctx.cam_rot_global

	e1 := gjk.col1.ent
	e2 := gjk.col2.ent
	mx := &globals.mx
	my := &globals.my
	cam_mov(ctx)

	//printf("curx %, mx %\n", cast(s32)(curmx * 100.0), cast(s32)(*mx * 100.0))

	e1.color.w = 0.3;
	e2.color.w = 0.6;

	e1.flags = e1.flags | ENTITY_TRANSPARENT;
	e2.flags = e2.flags | ENTITY_TRANSPARENT;

	*mx = GetMouseNormalizedPosX() - curmx;
	*my = GetMouseNormalizedPosY() - curmy;

	printf("addr %, act2 %\n", cast(u32)cast(s64)e1, cast(s32)(e1.is_active))
	DrawEntity(ctx, e1, cam_pos, cam_rot)
	DrawEntity(ctx, e2, cam_pos, cam_rot)

	orig : _vec
	col : _vec
	col.x = 1.0
	col.y = 0.0
	col.z = 0.0
	col.w = 1.0

	x_axis_start: _vec= _vec{-100.0, 0.0, 0.0, 0.0}
	x_axis_end: _vec= _vec{100.0, 0.0, 0.0, 0.0}
	z_axis_start: _vec= _vec{0.0, 0.0, -100.0, 0.0}
	z_axis_end: _vec= _vec{0.0, 0.0, 100.0, 0.0}
	draw_line(ctx, &x_axis_start, &x_axis_end, &col, 0)
	
	col.x = 0.0
	col.y = 0.0
	col.z = 1.0
	col.w = 1.0
	draw_line(ctx, &z_axis_start, &z_axis_end, &col, 0)

	v_sz: _vec=?
	v_sz.x = 0.1
	v_sz.y = 0.1
	v_sz.z = 0.1
	v_sz.w = 1.0

	globals.temp_alloc.cur = 0

	#if VIEW_COL_METHOD == 0
	{
		target_face :u64= gjk.closest_face
		if IsKeyHeld(key_enum.KEY_2)
		{
			target_face = gjk.cur_face_facing_point;

			//__dbg_break
			draw_vertex(ctx, &gjk.epa_new_sup, &v_sz, cam_pos, cam_rot)
		}
		if IsKeyHeld(key_enum.KEY_3)
		{
			for i in 0..16
			{
				draw_vertex(ctx, gjk.mink_diff[cast(u64)i], &v_sz, cam_pos, cam_rot)
			}
			
		}
		if IsKeyHeld(key_enum.KEY_4)
		{
			for i in 0..gjk.num_loose_edges
			{
				draw_vertex(ctx, gjk.epa_loose_edges[cast(u64)i][0], &v_sz, cam_pos, cam_rot)
				draw_vertex(ctx, gjk.epa_loose_edges[cast(u64)i][1], &v_sz, cam_pos, cam_rot)
			}
			
		}
		for i2 in 0..gjk.num_faces
		{
			i := cast(u64)i2
			_v1 := *gjk.epa_faces[i][0]
			_v2 := *gjk.epa_faces[i][1]
			_v3 := *gjk.epa_faces[i][2]
			n := gjk.epa_faces[i][3]
			//printf("\ni % ", i)
			//print_vec(n)
			//printf("\n")

			
			col.x = 0.4
			col.y = 0.4
			col.z = 0.4
			col.w = 1.0
			if i == target_face
			{
				col.x = 0.0
				col.y = 0.0
				col.z = 0.0
				col.w = 1.0
				//printf("g2 %\n", cast(u32)gjk_state.cur_face_facing_point)
			}
			else
			{
				col = *n
				col.x = (col.x + 1.0) *0.5
				col.y = (col.y + 1.0) *0.5
				col.z = (col.z + 1.0) *0.5
			}
			flags :u32= 0
			if IsKeyHeld(key_enum.KEY_1)
			{
				_v1 = *gjk.epa_faces[i][2]
				_v2 = *gjk.epa_faces[i][1]
				_v3 = *gjk.epa_faces[i][0]
				
			}
			draw_tri(ctx, &_v1, &_v2, &_v3, &col, flags)
		}

	}
	else
	{
		if IsKeyHeld(key_enum.KEY_JMP)
		{
			_draw_col(ctx, gjk.col2)
			_draw_col(ctx, gjk.col1)
		}

		draw_vertex(
			ctx, 
			&gjk.sup1, &v_sz, cam_pos, cam_rot)
		draw_vertex(ctx, &gjk.sup2, &v_sz, cam_pos, cam_rot)

		draw_line(ctx, &gjk.sup1, &gjk.sup2, &v_sz, DRAW_LINE_TIP);

		simplex_col : _vec
		simplex_col.x = 1.0
		simplex_col.y = 1.0
		simplex_col.z = 1.0
		draw_line(ctx, &orig, &gjk.dir, &simplex_col, DRAW_LINE_TIP);
		simplex_col.y = 0.0
		simplex_col.z = 0.0

		start : _vec= ?
		end : _vec= ?
		cross : _vec= ?
		if IsKeyHeld(key_enum.KEY_1)
		{
			draw_vertex(ctx, &gjk.simplex[0], &v_sz, cam_pos, cam_rot)
		}
		if IsKeyHeld(key_enum.KEY_2)
		{
			draw_vertex(ctx, &gjk.simplex[1], &v_sz, cam_pos, cam_rot)
		}
		if IsKeyHeld(key_enum.KEY_3)
		{
			draw_vertex(ctx, &gjk.simplex[2], &v_sz, cam_pos, cam_rot)
		}
		if IsKeyHeld(key_enum.KEY_4)
		{
			draw_vertex(ctx, &gjk.simplex[3], &v_sz, cam_pos, cam_rot)
		}
		on gjk.simplex_verts
		{
		2
		{
			draw_line(ctx, gjk.simplex[0], gjk.simplex[1], &simplex_col, DRAW_LINE_TIP);

			if IsKeyHeld(key_enum.KEY_F1)
			{
				a := gjk.simplex[0]
				b := gjk.simplex[1]

				ab := *b - *a
				ao := -*a

				cross = cross_vec(&cross_vec(&ab, &ao), &ab)
				start = *a + ab / 2.0
				end = start + cross

				draw_line(ctx, &start, &end, &simplex_col, 0);

				if(same_direction(&ab, &ao))
				{
					printf("the same dir\n")
				}
				else
				{
					printf("not in the same dir\n")
				}
			}
		}
		3
		{

			draw_line(ctx, gjk.simplex[0], gjk.simplex[1], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[0], gjk.simplex[2], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[1], gjk.simplex[2], &simplex_col, 0);

			a := gjk.simplex[0]
			b := gjk.simplex[1]
			c := gjk.simplex[2]

			ab := *b - *a
			ac := *c - *a
			ao := -*a

			abc := cross_vec(&ab, &ac)
			cross = cross_vec(&abc, &ac)
			start = *a + ac / 2.0
			end = start + cross

			simplex_col.y = 1.0
			draw_line(ctx, &start, &end, &simplex_col, 0);

			if IsKeyHeld(key_enum.KEY_F1)
			{
				cross = cross_vec(&cross_vec(&ac, &ao), &ac)
				end = start + cross
				simplex_col.z = 1.0
				draw_line(ctx, a, &end, &simplex_col, 0);

				simplex_col.y = 0.5
				simplex_col.z = 0.5
				draw_line(ctx, a, &(-*a), &simplex_col, 0);

				if same_direction(&ac, &ao)
				{
					printf("the same dir\n")
				}
				else
				{
					printf("not in the same dir\n")
				}
			}
		}
		4
		{
			draw_line(ctx, gjk.simplex[0], gjk.simplex[1], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[0], gjk.simplex[2], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[0], gjk.simplex[3], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[1], gjk.simplex[2], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[1], gjk.simplex[3], &simplex_col, 0);
			draw_line(ctx, gjk.simplex[3], gjk.simplex[2], &simplex_col, 0);

		}
		}
		a := 0
	}


	Draw3DTransparency(ctx.window);

}
print_f32::fn(a : f32)
{
	printf("f %\n", cast(s32)(a * 100.0))
}
player_mov::fn(ctx : *context, aux_forward : *_vec, dt : *f32)
{
	player_ent := ctx.player
	forward := &player_ent.forward
	cross := cross_vec(&ctx.up, ctx.cam_forward_global)
	mov := player_ent.mov_info
	on_ground := player_ent.on_ground
	grav := &mov.gravity_vel

	if on_ground
	{
		grav.y = -0.001
		mov.jmp.vel.y = 0.0
		mov.jmp.time_off_ground = 0.0
		mov.jmp.jmpd = false
	}
	else
	{
		mov.jmp.time_off_ground += *dt
		if IsKeyUp(key_enum.KEY_JMP) && mov.jmp.time_off_ground < 0.15
		{
			mov.jmp.vel.y = 0.0
		}
		grav.y += -25.0 * *dt
		//grav.y = -1.0
	}
	if IsKeyDown(key_enum.KEY_JMP) && (on_ground && mov.jmp.time_off_ground == 0.0 || mov.jmp.time_off_ground <= 0.5)
		&& !mov.jmp.jmpd
	{
		player_ent.vel.y = 0.0
		mov.jmp.vel.y = 1.0 * mov.jmp.speed
		mov.jmp.jmpd = true
		player_ent.on_ground = false
	}

	
	if IsKeyHeld(key_enum.KEY_W)
	{
		mov.v += *dt * mov.speed
	}
	else if IsKeyHeld(key_enum.KEY_S)
	{
		mov.v -= *dt * mov.speed
	}
	else
	{
		mov.v += -mov.v * *dt * mov.speed
	}


	if IsKeyHeld(key_enum.KEY_A)
	{
		mov.h += *dt * mov.speed
	}
	else if IsKeyHeld(key_enum.KEY_D)
	{
		mov.h -= *dt * mov.speed
	}
	else
	{
		mov.h += -mov.h * *dt * mov.speed
	}
	mov.v = clamp(mov.v, -1.0, 1.0)
	mov.h = clamp(mov.h, -1.0, 1.0)

	mov.ab = (absf(mov.v) + absf(mov.h))
	weight := clamp(mov.ab - 1.0, 0.0, 1.0) + 1.0
	actual_forward := *ctx.cam_forward_global * mov.v + cross * mov.h
	actual_forward = actual_forward / weight
	if mov.on_getting_to_back_pos
	{
		actual_forward.x = 0.0
		actual_forward.y = 0.0
		actual_forward.z = 0.0
	}
	player_ent.vel = actual_forward * mov.speed + *grav
	player_ent.vel += mov.jmp.vel


	if dot_vec(&actual_forward, &actual_forward) > 0.01 && !mov.on_rotating_cam
	{
		*forward = normalize_vec(&actual_forward)
	}
	//print_vec(&actual_forward)


	ang := angle_on_axis(aux_forward, forward, &ctx.up)
	player_ent.rot = euler_to_quaternion(0.0, radians_to_degree(-ang), 0.0).v
	player_ent.on_ground = false
	width := 4.0
	if player_ent.pos.y < mov.min_y_cam_pos
	{
		mov.min_y_cam_pos = player_ent.pos.y
		mov.max_y_cam_pos = mov.min_y_cam_pos + width
	}
	if player_ent.pos.y > mov.max_y_cam_pos
	{
		mov.max_y_cam_pos = player_ent.pos.y
		mov.min_y_cam_pos = mov.max_y_cam_pos - width
	}	
	//OpenLocalsWindow(__LINE__);
}

MESH_WIDTH :const s32= 5
generate_mesh::fn(out : *mesh_info) ! u32
{
	verts:[MESH_WIDTH * MESH_WIDTH * 3]f32
	tris: dyn_array(u32)

	size := 3.0
	for y in 0..5
	{
		for x in 0..5
		{
			idx := cast(u64)y * MESH_WIDTH * 3 + cast(u64)x * 3
			*verts[idx] = cast(f32)x * size
			*verts[idx + 1] = 0.0
			*verts[idx + 2] = cast(f32)y * size

			if x==2 && y ==2
			{
				//*verts[idx] = cast(f32)x * size
				*verts[idx + 1] = 1.0
				//*verts[idx + 2] = cast(f32)y * size
			}
			
			if y >= 1 && x < (MESH_WIDTH - 1)
			{
				cur := y  * MESH_WIDTH + x
				next_cur := y  * MESH_WIDTH + x + 1
				below_vert := (y - 1) * MESH_WIDTH + x
				below_right_vert := (y - 1) * MESH_WIDTH + x + 1
				dyn_add(&tris, cast(u32)cur)
				dyn_add(&tris, cast(u32)below_vert)
				dyn_add(&tris, cast(u32)below_right_vert)

				dyn_add(&tris, cast(u32)next_cur)
				dyn_add(&tris, cast(u32)cur)
				dyn_add(&tris, cast(u32)below_right_vert)
			}
		}
	}
	dyn_add_data(&out.verts, cast(*f32)verts, MESH_WIDTH * MESH_WIDTH * 3 * 4)
	out.verts.count = MESH_WIDTH * MESH_WIDTH * 3
	dyn_add_data(&out.tris, cast(*f32)tris[0], cast(u32)tris.count * 4)
	out.tris.count = tris.count

	info :create_mesh_info
	info.verts = cast(*f32)&verts
	info.total_verts = MESH_WIDTH * MESH_WIDTH
	info.tris = tris[0]
	info.total_tris = cast(u32)tris.count
	return CreateMesh(&info)

}
main_loop::fn(ctx : *context)
{
	test_model := LoadModel("../models/test.fbx")
	ctx.up.y = 1.0

	dyn_init2(&ctx.coroutines.funcs, 2, ctx.alloc);

	LinearInit(&globals.entities, ctx.alloc, 32)
	LinearInit(&globals.str_alloc, ctx.alloc, 128)
	LinearInit(&globals.allocs_occured, ctx.alloc, 32)
	LinearInit(&globals.temp_alloc, ctx.alloc, 128)
	LinearInit(&globals.nodes_alloc, ctx.alloc, 512)
	LinearInit(&globals.ast_alloc, ctx.alloc, 512)


	//using ctx;
	draw:draw_info3d;
	//AssignCamStuff(scn, &draw);
	pos :_vec;
	speed :f32= 10.0;
	cam_pos: _vec;
	cam_rot: _vec;
	cam_rot.z = 0.0;
	cam_rot.y = 0.0;
	other_block :_vec;
	other_block.x = 5.0;
	other_block.y = 0.0;

	ctx.cam_pos_global = &cam_pos;
	cam_pos.z = 5.0

    cinfo: col_info;
    col: collision;

	col.contacts.alloc = ctx.alloc;
	dyn_init(&col.contacts, 2);
	col.contacts.count = 1;


	player_ent:*entity=NewPlayerEnt(ctx, "player");

	player_ent.mov_info.speed = 10.0
	player_ent.mov_info.jmp.speed = 4.0
	//player_ent.model = test_model

	ctx.player = player_ent;
	
	ctx.already_allocated_ents_count = globals.entities.cur;
	ctx.already_allocated_str_count = globals.str_alloc.cur;
	
	dyn_init2(&ctx.masking_objs, 4, ctx.alloc);
	dyn_init2(&ctx.start_pos, 4, ctx.alloc);


	//add_body(ctx, enemy_ent);
	//add_body(ctx, &ground2)

	last_time : = GetTime();

	keys: input_info;

	cam_wiggle_time:f32;
	cam_wiggle_timer:f32;
	cam_wiggle_rot_time:f32;
	cam_wiggle_rot_timer:f32;
	
	
	ctx.draw_col = true;
	//ctx.draw_origin = true;

	//__dbg_break
	layers : dyn_array(*layer_sprites);
	dyn_init2(&layers, 8, ctx.alloc);
	ctx.layers_ptr = &layers;

	ctx.alloc = &ctx.per_scene_alloc;
	ctx.already_allocated_mem_count = cast(u32)cast(u64)GetMem(1);
	//OpenSceneGame(ctx, "../scenes/01", &layers, &ctx.textures);
	ctx.cam_size = 5.0;
	//ctx.cam_size_original = ctx.cam_size;


	info_3d : draw_info3d
	globals.after_init = true

	dyn_add(&ctx.drawable_ents, &player_ent);
	player_ent.flags = player_ent.flags | ENTITY_3D
	player_ent.pos.x = -1.0
	player_ent.pos.y = 0.0


	terrain : terrain_info
	other := NewEnt(ctx.alloc, "block 1")
	other.flags = other.flags | ENTITY_3D
	add_body(ctx, other)
	dyn_add(&ctx.drawable_ents, other)
	other.is_active = true
	other.type= ent_type.TERRAIN
	other.terrain = &terrain
	other.is_static = true
	other.pos.x = -3.0
	other.pos.y = -2.0
	other.pos.z = -3.0
	other.size.z = 1.0
	other.size.x = 1.0
	terrain.width = MESH_WIDTH
	terrain.height = MESH_WIDTH
	other.model = generate_mesh(&terrain.mesh)
	other.terrain = &terrain

	other = NewEnt(ctx.alloc, "block 1")
	other.flags = other.flags | ENTITY_3D
	dyn_add(&ctx.drawable_ents, other)
	other.is_active = true
	other.pos.x = 20.0
	other.size.z = -20.0

	other = NewEnt(ctx.alloc, "block 2")
	other.flags = other.flags | ENTITY_3D
	dyn_add(&ctx.drawable_ents, other)
	other.is_active = true
	other.pos.x = 30.0
	other.size.x = 30.0

	other = NewEnt(ctx.alloc, "enemy")
	add_body(ctx, other)
	dyn_add(&ctx.drawable_ents, other)
	other.flags = other.flags | ENTITY_3D

	other.pos.y = -1.0
	other.pos.x = -0.1
	other.pos.z = -20.6
	other.size.z = 8.0
	other.is_active = true
	other.is_static = true

	mx := GetMouseScreenPosX();
	my := GetMouseScreenPosY();

	player_ent.forward.z = -1.0

	cam_forward : _vec
	cam_forward.z = -1.0



	//cam_rot.y = 1.5708

	ctx.cam_rot_global = &cam_rot;
	ctx.cam_forward_global = &cam_forward;

	axis : _vec
	axis.z = 0.0
	axis.x = 0.0
	axis.y = 1.0
	aux_forward := cam_forward
	ctx.cam_aux_forward_global = &aux_forward;

	cam_to_player_dist := 10.0

	h : f32
	v : f32

	timer_for_cam_go_back_of_player : f32
	ang_diff_for_cam_go_back_of_player : f32

	player_back_pos := player_ent.pos - cam_forward * cam_to_player_dist + ctx.up * 2.0
	cam_start_pos_before_rotate_to_back_pos :_vec
	on_getting_to_back_pos := false
	forward := &player_ent.forward
	pmov := player_ent.mov_info
	cam_up_dist := 2.0
	while !ShouldClose(ctx.window)
	{
		globals.timer = 0.0;
		{
			//start_pos:_vec = ? ;
			//end_pos:_vec = ? ;

			//out_ent: *entity;
			/*
			if !Raycast(ctx, &start_pos, &end_pos, &col, LAYER_TRIGGER, &out_ent)
			{
				ChangeBehaviour(enemy_ent, behaviour_state.GET_CLOSER_THEN_ATTACK);
				//PrintV3(5.0, 0.0, 0.0);
			}
			*/
		}
		//PrintV3(einfo.forward.x, 0.0, 0.0);

		curmx := GetMouseNormalizedPosX();
		curmy := GetMouseNormalizedPosY();

		//dt: = GetTime() - last_time;
		dt: = 0.017;
		last_time = GetTime();
		ctx.time_since_start += dt


		ClearBackground(0.2, 0.5, 0.8);

		f := 0.5
		player_ent.color.x = 1.0
		player_ent.color.y = 0.0
		player_ent.color.z = 0.0
		other.color.x = f
		other.color.y = f
		other.color.z = f

		ang: f32=?
		cross := cross_vec(&ctx.up, &cam_forward)
		player_mov(ctx, &aux_forward, &dt)

		//cam_mov(ctx)

		
		add_cam_forward := cam_forward
		if pmov.ab > 1.5
		{

			add_cam_forward += (*forward - add_cam_forward)
		}

		//__dbg_break
		player_pos := player_ent.pos
		player_pos.y = pmov.min_y_cam_pos + cam_up_dist;
		
		target_pos := player_pos - add_cam_forward * cam_to_player_dist

		if IsKeyDown(key_enum.KEY_ACT0)
		{
			timer_for_cam_go_back_of_player = 0.0
			cam_start_pos_before_rotate_to_back_pos = player_back_pos
			ang_diff_for_cam_go_back_of_player = angle_on_axis(&cam_forward, forward, &ctx.up)
		}
		add_mul := 1.0

		pmov.on_getting_to_back_pos = false
		if IsKeyHeld(key_enum.KEY_ACT0)
		{
			timer_for_cam_go_back_of_player += dt
			time_for_complete_rot := 0.5
			pmov.on_rotating_cam = true
			add_mul = 4.0
			if timer_for_cam_go_back_of_player < (time_for_complete_rot + 0.1)
			{
				local_pos_back_rot := cam_start_pos_before_rotate_to_back_pos - player_pos

				pmov.on_getting_to_back_pos = true

				p := timer_for_cam_go_back_of_player / time_for_complete_rot
				p = clamp(p, 0.0, 1.0)

				ang = p * ang_diff_for_cam_go_back_of_player
				local_pos_back_rot = euler_to_quaternion(0.0, radians_to_degree(ang), 0.0) * local_pos_back_rot
				target_pos = local_pos_back_rot + player_pos
				player_back_pos = target_pos
			}
			else
			{
				target_pos = player_pos - *forward * cam_to_player_dist;
				player_back_pos = target_pos
			}
		}
		else
			pmov.on_rotating_cam = false;
		
		player_back_pos += (target_pos - player_back_pos) * dt * 4.0
		dir_to_player := (cam_pos-player_pos)
		dist := len_vec(&dir_to_player)

		if dist <= cam_to_player_dist && !pmov.on_rotating_cam
		{
			target_pos_limit := player_pos - cam_forward * cam_to_player_dist
			target_pos_to_other := target_pos - target_pos_limit
			player_back_pos = target_pos_limit
		}
		dir_to_cam := (player_back_pos - cam_pos)

		//print_f32(dot_up)

		cam_pos += dir_to_cam * dt * 2.0 * add_mul
		
		dir := ctx.player.pos - cam_pos
		dist = len_vec(&dir)
		dir = normalize_vec(&dir)

		ang = angle_on_axis(&aux_forward, &dir, &ctx.up)
		cam_rot.y = ang
		cam_forward = euler_to_quaternion(0.0, radians_to_degree(ang), 0.0) * aux_forward

		//print_vec(&forward)

		PhysicsUpdate(ctx, dt)
		DrawEnts(ctx, ctx.cam_pos_global, &cam_rot)

/*
		color : _vec=?
		color.x = 0.0
		color.y = 0.0
		color.z = 1.0
		color.w = 1.0
		line_start : _vec;
		line_start.z = 0.0
		line_end : _vec;
		line_end.z = -0.5
		ctx.cam_pos_global = nil
		draw_line(ctx, &line_start, &line_end, &color, DRAW_LINE_NO_PROJ)

		line_start.z = 0.0
		line_end.x = -0.5
		color.x = 1.0
		color.y = 0.0
		color.z = 0.0
		draw_line(ctx, &line_start, &line_end, &color, DRAW_LINE_NO_PROJ)
		ctx.cam_pos_global = &cam_pos
		*/

		mx = GetMouseNormalizedPosX() - curmx;
		my = GetMouseNormalizedPosY() - curmy;
		EndFrame(ctx.window);
		ctx.frames_total++;
	}
}

move_color_in_time::fn(src_original : *v4, src : *v4, dst_x : f32, dst_y : f32, dst_z : f32, dst_w : f32, dt : f32, time : f32) ! bool
{
	dst:v4;
	dst.x = dst_x;
	dst.y = dst_y;
	dst.z = dst_z;
	dst.w = dst_w;
	dir:= dst - *src;
	dir_og:= dst - *src_original;
	dir_og_len:= len_v4(&dir_og);

	norm := normalize_v4(&dir);

	*src = *src + norm * (dt / time) * dir_og_len;

	if len_v4(&dir) < 0.01
		return true;

	return false;

}
move_vec::fn(src : *_vec, dst_x : f32, dst_y : f32, dst_z : f32, dt : f32, vel : f32) ! bool
{
	dst:_vec;
	dst.x = dst_x;
	dst.y = dst_y;
	dst.z = dst_z;
	dir:= dst - *src;

	norm := normalize_vec(&dir);

	*src = *src + norm * dt * vel;

	if len_vec(&dir) < 0.1
		return true;

	return false;

}

UpdateEntsWithClips::fn(ctx : *context, dt : f32)
{
	if ctx.ents_with_clip.count == 0
		return;
	for e in ctx.ents_with_clip
	{
		if e.cl == nil || !e.is_active
			continue;
		//__dbg_break;
		UpdateClip2(*e, dt);
		
	}
}

