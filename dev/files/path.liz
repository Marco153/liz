import "../../core";
import "../common";

waypoint:struct
{
	pos : _vec,
	neighbors : dyn_array(*waypoint),
}
waypoint_info:struct
{
	wp : *waypoint,
	parent : s32,
	dist_to_start : f32,
	fcost : f32,
	neighbors : dyn_array(u32)
}

wp_in_ar::fn(ar : *dyn_array(u32), wp : u32) !s32
{
	i: s32 = 0
	for cur in* ar
	{
		if *cur == wp
		{
			return i;
		}
		i++
	}
	return -1
}
remove_wp::fn(ar : *dyn_array(u32), wp : u32)
{
	i := wp_in_ar(ar, wp)
	if i >= 0
	{
		dyn_rem(ar, cast(u32)i)
	}
}
maybe_add_existing_wp_to_neighbors::fn(winfo_idx : u32, wps_created : *dyn_array(waypoint_info), w : *waypoint)
{
	i :u32= 0

	out := &wps_created[cast(u64)winfo_idx].neighbors
	for cur_wp in *wps_created
	{
		if cur_wp.wp == w
		{
			dyn_add(out, i)
			break
		}
		i++
	}
	if i >= cast(u32)wps_created.count
	{
		i = cast(u32)wps_created.count
		winfo: waypoint_info
		winfo.wp = w
		dyn_add(wps_created, &winfo)
		out = &wps_created[cast(u64)winfo_idx].neighbors
		dyn_add(out, i)
		i = 0
	}

}
get_lowest_fcost ::fn(wps_created : *dyn_array(waypoint_info), ar : *dyn_array(u32)) !u64
{
	lowest := 99999999.0
	lowest_idx := 0

	i := 0

	for w_idx in *ar
	{
		w := wps_created[cast(u64)*w_idx]
		if lowest > w.fcost 
		{
			lowest = w.fcost
			lowest_idx = i
		}
		i++;
	}
	return cast(u64)*ar[cast(u64)lowest_idx]
}
get_closest_waypoint::fn(wps : *dyn_array(waypoint), pos : *_vec) ! *waypoint
{
	closest_idx : u64= -1
	closest_dist : f32= 999999.0
	i:u64
	for w in *wps
	{
		dist := w.pos - *pos
		d := dot_vec(&dist, &dist)
		if d < closest_dist
		{
			closest_idx = i
			closest_dist = d
		}
		i++
	}
	if closest_idx != -1
	{
		return wps[closest_idx]
	}
	return nil
}
add_neighbors_to_wpinfo::fn(cur_wp_idx : u32, wps_info : *dyn_array(waypoint_info), visited : *dyn_array(u32))
{
	cur_wp := wps_info[cast(u64)cur_wp_idx]
	max := cur_wp.wp.neighbors.count
	for w_idx in 0..max
	{
		cur_wp = wps_info[cast(u64)cur_wp_idx]
		w := cur_wp.wp.neighbors[cast(u64)w_idx]
		in_visited := false
		for v_idx in *visited
		{
			v := wps_info[cast(u64)*v_idx]
			if v.wp == *w
			{
				in_visited = true
				break
			}
		}
		if !in_visited
		{
			maybe_add_existing_wp_to_neighbors(cast(u32)cur_wp_idx, wps_info, *w)
		}
	}
}
find_wpath::fn(ctx : *scene_info, start_w : *waypoint, final_pos : *_vec, out_pos : *dyn_array(_vec))
{
	wps_that_can_see_final_pos : dyn_array(*waypoint)
	wps := &ctx.waypoints

	for w in *wps
	{
		col : collision
		start_pos := w.pos
		start_pos.y += 0.5
		
		if !Raycast(ctx, &start_pos, final_pos, &col, 0, nil)
		{
			dyn_add(&wps_that_can_see_final_pos, w)
		}
	}


	wps_info : dyn_array(waypoint_info)

	winfo : waypoint_info
	winfo.wp = start_w
	winfo.parent = -1
	dyn_add(&wps_info, &winfo)


	cur_wp :*waypoint_info= dyn_last(&wps_info)

	open : dyn_array(u32)
	visited : dyn_array(u32)

	dyn_add(&open, 0)

	cur_wp_idx :u64


	while true
	{
		ASSERT(open.count > 0)
		cur_wp_idx = get_lowest_fcost(&wps_info, &open)
		cur_wp = wps_info[cur_wp_idx]

		remove_wp(&open, cast(u32)cur_wp_idx)
		dyn_add(&visited, cast(u32)cur_wp_idx)

		if cur_wp.fcost < -900.0
		{
			break;
		}

		add_neighbors_to_wpinfo(cast(u32)cur_wp_idx, &wps_info, &visited)
		cur_wp = wps_info[cur_wp_idx]

		dyn_add(&visited, cast(u32)cur_wp_idx)

		for n_idx in cur_wp.neighbors
		{
			n := wps_info[cast(u64)*n_idx]
			dist_to_neighbor := len_vec(&(n.wp.pos - cur_wp.wp.pos))
			dist_to_final := len_vec(&(*final_pos - cur_wp.wp.pos))
			n_fcost := dist_to_neighbor + dist_to_final

			n.fcost = n_fcost

			dist_to_start_sum := dist_to_neighbor + cur_wp.dist_to_start
			
			in_open := wp_in_ar(&open, *n_idx) != -1
			if dist_to_start_sum < n.dist_to_start || !in_open
			{
				n.parent = cast(s32)cur_wp_idx
				n.dist_to_start = dist_to_start_sum
				n.fcost  = dist_to_start_sum + len_vec(&(n.wp.pos - *final_pos))
				
				if !in_open
				{
					dyn_add(&open, n_idx)
				}
				in_can_see_final := false

				for w in wps_that_can_see_final_pos 
				{
					if n.wp == *w
					{
						in_can_see_final = true
						break
					}
				}
				if in_can_see_final
				{
					n.fcost = -999.0
				}

			}
		}
	}

	dyn_add(out_pos, final_pos)
	while cast(s32)cur_wp_idx != -1
	{
		cur_wp = wps_info[cur_wp_idx]
		dyn_add(out_pos, &cur_wp.wp.pos)
		cur_wp_idx = cast(u64)cur_wp.parent
	}
}
