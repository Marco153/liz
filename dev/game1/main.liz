		a_col : ent_col;
		b_col : ent_col;
		
		a_col.pos = pos;
		a_col.size.x = 1.0;
		a_col.size.y = 1.0;

		b_col.pos = other_block;
		b_col.size.x = 1.0;
		b_col.size.y = 1.0;
		res :_vec;
		
		ratio :=  ScreenRatio();
		
		ctx.cam_col_bottom = false;
		ctx.cam_col_top = false;
		ctx.cam_col_right = false;
		ctx.cam_col_left = false;
		if ctx.cur_cam_rest
		{
			real_cam_width := ctx.cam_size / ratio;
			real_cam_height := (ctx.cam_size / 2.0);
			
			min_cam_axis := min(real_cam_width, real_cam_height);
			//ctx.cam_size = min(min_cam_axis, ctx.cam_size);
			
			left_cam_pos := cam_pos.x - real_cam_width;
			right_cam_pos := cam_pos.x + real_cam_width;
			top_cam_pos := cam_pos.y + (ctx.cam_size);
			bottom_cam_pos := cam_pos.y - (ctx.cam_size);
			
			restraint_sz := &ctx.cur_cam_rest.size;
			restraint_pos := &ctx.cur_cam_rest.pos;
			
			left_bound:f32;
			right_bound:f32;
			top_bound : f32;
			bottom_bound : f32;
			
			if restraint_sz.y < 0.0
			{
				bottom_bound = restraint_pos.y + restraint_sz.y;
				top_bound = restraint_pos.y;
			}
			else 
			{
				bottom_bound = restraint_pos.y;
				top_bound = restraint_pos.y + restraint_sz.y;
			}
			
			if restraint_sz.x < 0.0
			{
				left_bound = restraint_pos.x + restraint_sz.x;
				right_bound = restraint_pos.x;
			}
			else
				left_bound = restraint_pos.x;
				right_bound = restraint_pos.x + restraint_sz.x;
			
			
			if bottom_bound > bottom_cam_pos
			{
				ctx.cam_col_bottom = true;
				cam_pos.y = bottom_bound + ctx.cam_size;
			}
			if top_bound < top_cam_pos
			{
				ctx.cam_col_top = true;
				cam_pos.y = top_bound - ctx.cam_size;
			}
			if left_bound > left_cam_pos
			{
				ctx.cam_col_left = true;
				cam_pos.x = left_bound + real_cam_width;
			}
			if right_bound < right_cam_pos
			{
				ctx.cam_col_right = true;
				cam_pos.x = right_bound - real_cam_width;
			}
			
		}

		OpenLocalsWindow(__LINE__);

		DrawEnts(ctx, &cam_pos, &cam_rot);

		DrawCols(ctx);
		
		UpdateEntsWithClips(ctx, dt);
		//__dbg_break;
