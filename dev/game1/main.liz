		//DrawText(ctx);
		
		draw.pos.x = -1.0 - (ratio / 2.0);
		draw.pos.y = -1.0;
		draw.cam_size = 1.0;
		draw.ent_size.x = 2.0 / (ratio / 2.0);
		draw.ent_size.y = 2.0;
