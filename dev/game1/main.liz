Max::fn(a : s32, b : s32) !s32
{
	ret: = if a > b a else b;
	return ret;
}


DrawText::fn(ctx : *context)
{
	if ctx.to_draw.count == 0
		return;
	for d in ctx.to_draw
	{
		Draw(ctx.window, d);
		
	}
}

UpdatePrinter::fn(ctx : *context, p : *printer, dt : f32)
{
	p.cur_time += dt;

	if p.cur_time >= p.time_to_next_ch && p.cur_ch < p.str_ln
	{
		p.cur_time = 0.0;

		p.cur_ch++;
		ch := *ptr_offset(p.str, cast(u64)p.cur_ch, u8);
		if (cast(char)ch) == ' 
			p.cur_ch++;
	}
	if p.cur_ch >= p.str_ln
	{
		p.done = true;
	}

	draw:draw_info;
	cursor_time : global f32;
	if p.cur_ch >= p.str_ln && p.str_ln > 0
	{
		time_int := cast(u32)cursor_time;
		if (time_int % 2) == 0 && p.end_cursor
		{
			draw.color = []f32{ 1.0, 1.0, 1.0, 1.0 };
			draw.flags = 0;
			draw.pos.x = 0.0;
			draw.pos.y = -0.5;
			draw.cam_size = 1.0;
			draw.ent_size.x = 0.1;
			draw.ent_size.y = 0.1;

			//Draw(ctx.window, &draw);
		}
		if IsKeyDown(key_enum.KEY_ACT0)
			p.done = true;

		cursor_time += dt;
		if time_int > 3
			cursor_time = 0.0;
	}
	
	
	// black background
	if p.str_ln != nil
	{
		draw.pos.{
			x = -1.0;
			y = -1.0;
			z = 0.1;
		};
		draw.ent_size.{
			x = 2.0;
			y = 0.6;
		};
		*draw.color[0] = 0.2;
		*draw.color[1] = 0.2;
		*draw.color[2] = 0.2;
		*draw.color[3] = 0.8;
		draw.cam_size = 1.0;
		//draw.flags = DRAW_INFO_NO_SCREEN_RATIO | DRAW_INFO_STENCIL_WRITE;
		draw.flags = DRAW_INFO_NO_SCREEN_RATIO;
		//draw.stencil_val = 7;
		Draw(ctx.window, &draw);
	}
	cursor_x := 0.0;
	cursor_y := 0.0;
	first_letter := true;
	letter :u32= 0;
	letter_h := 0.05;
	for idx in 0..p.cur_ch
	{
		
		if first_letter
		{
			cur_letter:=0;

			if *ptr_offset(p.str, cast(u64)idx, char) == 's
			{
				//__dbg_break;
			}

			while !IsTerminalCharater(*ptr_offset(p.str, idx + cast(s64)(cur_letter), char)) && cast(u64)(idx + cur_letter) < p.str_ln
			{
				cur_letter++;
			}


			idx_in_line := cast(s32)letter;
			if (cur_letter  + idx_in_line) > cast(s32)p.chars_per_line &&  (idx + cur_letter) < cast(s32)p.str_ln
			{
				cursor_x = 0.0;
				cursor_y -= letter_h + letter_h/4.0;
				letter = 0;
			}
			first_letter = false;
		}

		if letter >= p.chars_per_line
		{
			cursor_x = 0.0;
			cursor_y -= letter_h + letter_h/4.0;
			letter = 0;
		}
		ch := *ptr_offset(p.str, cast(u64)idx, u8);
		//PrintV3(p.cur_time, cast(f32)idx, 0.0);
		if (cast(char)ch) != '  
		{
			draw.color = []f32{ 1.0, 1.0, 1.0, 1.0 };
			draw.pos.x = cursor_x + p.pos.x;
			draw.pos.y = cursor_y + p.pos.y;
			draw.pos.z = 0.09;
			draw.ent_size.x = 0.05;
			draw.ent_size.y = letter_h;
			draw.flags = DRAW_INFO_HAS_TEXTURE;

			ch_idx := GetCharTextureIdx(cast(char)ch);

			draw.texture_id = *ptr_offset(p.texs, ch_idx, u32);
			draw.cam_size = 1.0;
			Draw(ctx.window, &draw);
			first_letter = false;
		}
		else
		{
			first_letter = true;
		}
			
		space_at_start := (cast(char)ch) == '  && letter == 0;

		if !space_at_start
			cursor_x += draw.ent_size.x;
		letter++;
	}
}

ClearPrinterStr::fn(ctx : *context)
{
	ctx.prntr.str = nil;
	ctx.prntr.str_ln = 0;
	ctx.prntr.cur_ch = 0;
	ctx.prntr.done = false;
}
ChangePrinterStr::fn(ctx : *context, str : str_lit)
{
	ctx.prntr.str = str;
	ctx.prntr.str_ln = str_ln(str);
	ctx.prntr.cur_ch = 0;
	ctx.prntr.done = false;
}


ent_col : struct
{
	pos : _vec,
	size : _vec,
	pivot : _vec,
}
AABB::fn(a : *ent_col, b : *ent_col, res : *_vec) ! bool
{
	a_center_x := a.pos.x - a.pivot.x * a.size.x;
	a_center_y := a.pos.y - a.pivot.y * a.size.y;
	b_center_x := b.pos.x - b.pivot.x * a.size.x;
	b_center_y := b.pos.y - b.pivot.y * a.size.y;

	a_right := (a_center_x + a.size.x);
	a_left := (a_center_x);
	b_right := (b_center_x + b.size.x);
	b_left := (b_center_x);

	a_top := (a_center_y + a.size.y);
	a_bottom := (a_center_y);
	b_top := (b_center_y + b.size.y);
	b_bottom := (b_center_y);



	right_check := a_right >= b_left && b_right > a_right;
	left_check  := a_left <= b_right && b_left < a_left;

	top_check := a_top >= b_bottom && b_top > a_top;
	bottom_check  := a_bottom <= b_top && b_bottom < a_bottom;

	right_diff := a_right - b_left;
	left_diff := a_left - b_right;
	top_diff := a_top - b_bottom;
	bottom_diff := a_bottom - b_top;
	
	res.x = cast(f32)right_check * right_diff + cast(f32)left_check * left_diff;
	res.y = cast(f32)top_check * top_diff + cast(f32)bottom_check * bottom_diff;

	//cond2 := (y1 + szy1) >= y2 || y1 <= (y2 + szy2);
	if (right_check || left_check) && (top_check || bottom_check)
		return true;
	return false;
}



input_info:struct
{
	jmp_key_held : bool,
	jmp_key_up : bool,
	left_key_held : bool,
	right_key_held : bool,
	horizontal_key_held : bool,
	down_key_held : bool,
	attack_key_down: bool,
	attack2_key_down: bool,
	attack2_key_up: bool,
	attack2_key_held: bool,
}



ChangeState::fn(e : *entity, state : entity_state)
{
	if e.state != state
	{
		e.cl = nil;
		e.state = state;
		e.clip_time = 0.0;
		e.clip_done = false;
	}
}

clamp ::fn(v : f32, _min :f32, _max : f32) ! f32
{
	if v <= _min return _min;
	if v >= _max return _max;
	return v;
}
sign ::fn(f : f32) ! f32
{
	if f < 0.0 return -1.0;
	return 1.0;
}

NextInvItem::fn(inv : *inventory, cur : **inv_slot)
{
	last := dyn_last(&inv.items);
	
	next := ptr_offset(*cur, 1, inv_slot);
	if cast(u64)next <= cast(u64)last && next.item != inv_item.EMPTY
	{
		*cur = next;
	}
}
PrevInvItem::fn(inv : *inventory, cur : **inv_slot)
{
	start := inv.items[0];
	prev := ptr_offset(*cur, -1, inv_slot);
	if cast(u64)prev >= cast(u64)start && prev.item != inv_item.EMPTY
	{
		*cur = prev;
	}
}
MovEntity::fn(ctx : *context, mov_info : *player_info, player_ent : *entity, keys : *input_info, dt : *f32)
{
	using mov_info;
	//if player_ent.collided_entered 
		//__dbg_break;

	key_pressed := false;
	// drawing the mask of bracelet of sincerity
	draw : draw_info;
	draw.pos =player_ent.pos;
	//draw.pos.y = nmy;
	draw.pos.z = 0.92;
	draw.color = []f32{ 1.0, 1.0, 1.0, 1.0 };
	draw.ent_size.x = MASKING_DIAMETER;
	draw.ent_size.y = MASKING_DIAMETER;
	draw.pivot.x = 0.5;
	draw.pivot.y = 0.5;
	draw.cam_size = ctx.cam_size;
	draw.cam_pos = ctx.cam_pos_global;
	draw.flags = DRAW_INFO_HAS_TEXTURE | DRAW_INFO_STENCIL_WRITE;
	draw.texture_id = cast(u32)ctx.col_mask_tex;
	draw.stencil_val = 1;
	Draw(ctx.window, &draw);

	//cheking if spears that are on masked objs
	// are still on the range of the mask
	for i in 0..max_spears
	{
		spear := *ptr_offset(spears, i, *entity);
		if !spear.is_active
			continue;
		if spear.vel.x == 0.0 && spear.vel.y == 0.0
		{
			
			spear_forward := spear.pos + spear.forward;
			// making the spear fall if it is caught by a masked obj
			for in_col in spear.ents_in_collision
			{
				if in_col.in_col
				{
					if is_flag_off(in_col.ent.flags, ENTITY_IS_MASKED)
						continue;
					if !IsPosInsideMaskingObjs(&spear_forward, &ctx.masking_objs, MASKING_DIAMETER *0.5)
					{
						spear.vel.y = -5.0;
						spear.is_static = false;
						spear.is_trigger = true;
					}
				}
			}
			//__dbg_break;
		}
	}

	if IsKeyDown(key_enum.KEY_Q)
	{
		PrevInvItem(weapons_inv, &cur_weapon);
		// = cast(inv_item)(cast(u32)on_hand_item - 1);
		key_pressed = true;
	}
	if IsKeyDown(key_enum.KEY_E)
	{
		NextInvItem(weapons_inv, &cur_weapon);
	}

	if player_ent.vel.y < 0.0
	{
		gravity_vel.y += mov_vel.y;
		mov_vel.y = 0.0;
	}
	
	if !axe_ent.axe.hit
	{
		axe_ent.vel.y += -20.0 * *dt;
	}
	
	on_air_attack := player_ent.state == entity_state.AIR_KICK || player_ent.state == entity_state.AXE_AIR_THROW;
	if player_ent.on_ground
	{
		jmp.time_off_ground = 0.0;
		gravity_vel.y = -0.1;
		can_jmp = true;
		player_ent.dmg.hit = false;
		if player_ent.state == entity_state.IMPACTED
		{
			ChangeState(player_ent, entity_state.IDLE)
			can_move = true;
		}
		//PrintV3(1.0, 0.0, 1.0);
		mov_vel.y = 0.0;

	}
	else
	{
		jmp.time_off_ground += *dt;
		gravity_vel.y += -45.0 * *dt;
		//mov_vel.y = 0.0;
		
		
		//if player_ent.state == entity_state.IMPACTED
			//__dbg_break;
		if jmp.time_off_ground > 0.05 && !on_air_attack && player_ent.state != entity_state.IMPACTED
		{
			if player_ent.vel.y > 0.0
			{
				ChangeState(player_ent, entity_state.RISING);
			}
			else
				ChangeState(player_ent, entity_state.DESCENDING);
		}
	}
	if (keys.jmp_key_held && jmp.time_off_ground < jmp.off_ground_can_jmp_time) && can_move && can_jmp
	{
		mov_vel.y = jmp.speed;
		can_jmp = false;
		gravity_vel.y = 0.0;
	}

	if (keys.jmp_key_up && jmp.time_off_ground < jmp.off_ground_can_jmp_time) && !on_air_attack
	{
		mov_vel.y = -1.0;
		gravity_vel.y = 0.0;
		//PrintV3(2.0, 0.0, 1.0);
	}



	if (keys.left_key_held) && can_move
	{
		mov_vel.x = -speed;
		forward.x = -1.0;
	}
	else if (keys.right_key_held) && can_move
	{
		mov_vel.x = speed;
		forward.x = 1.0;
	}
	else
		mov_vel.x += -mov_vel.x * *dt * 20.0;

	if ((keys.attack_key_down || keys.attack2_key_down) && trigger != nil && can_move && (player_ent.state == entity_state.IDLE|| player_ent.state == entity_state.WALK || !player_ent.on_ground))
	{
		//PrintV3(3.0, 0.0, 0.0);
		key_pressed = false;
		which_combo:combo_enum;
		impact_mul: = 1.0;
		attack_state :=entity_state.KICK;
		if player_ent.on_ground
		{
			has_axe = true;
			key_pressed = true;
			if keys.attack_key_down
				attack_state = entity_state.AXE_PUNCH;
			if keys.attack2_key_down
			{
				attack_state = entity_state.AXE_THROW;
			}
		}
		else
		{
			has_axe = true;
			key_pressed = true;
			if keys.attack2_key_down
			{
				attack_state = entity_state.AXE_AIR_THROW;
			}
		}

		//if has_axe
		//{
		//}
		/*
		else
		{
			if keys.attack_key_down
			{			
				which_combo = combo_enum.ATTACK_0;
				key_pressed = true;
				if !player_ent.on_ground
				{
					impact_mul = 5.0;
					attack_state = entity_state.AIR_KICK;
				}
				else
				{
					if keys.down_key_held
					{
						which_combo = combo_enum.ATTACK_THROW_UPWARDS;
						attack_state = entity_state.UPWARD_PUNCH;
					}
				}
			}
		}
		*/
		 if key_pressed
		{
			//in_combo = true;
			mov_info.combo = which_combo;
			mov_info.trig_info.state = 0;
			trigger.dmg.impact_mul = impact_mul;
			//trigger.is_active = true;
			mov_info.wait_timer = 0.0;
			mov_info.trig_info.state = 0;
			if !player_ent.on_ground && mov_vel.y > 5.0
				mov_vel.y = 10.0;
			///player_ent.state = entity_state.KICK;
			ChangeState(player_ent, attack_state);
		}
	}


	clip_changed: = false;
	if player_ent.state == entity_state.IDLE
	{
		player_ent.cl = ctx.character_idle;
		//PrintV3(5.0, 0.0, 0.0);
		if absf(mov_vel.x) > 0.1 && can_move
		{
			ChangeState(player_ent, entity_state.WALK);
		}
	}
	else if player_ent.state == entity_state.WALK
	{
		player_ent.cl = character_walk;
		if absf(mov_vel.x) < 0.1
		{
			ChangeState(player_ent, entity_state.IDLE);
		}
	}
	else if player_ent.state == entity_state.SWEEPED
	{
		player_ent.cl = ctx.character_sweeped;
		if player_ent.clip_done
		{
			clip_changed = true;

			can_move = true;
			trigger.is_active = false;
			ChangeState(player_ent, entity_state.IDLE);
			//aux = 1;
			//__dbg_break;
		}
	}
	else if player_ent.state == entity_state.AIR_KICK
	{
		player_ent.cl = ctx.character_air_kick;
		can_move = false;
		mov_info.trigger.dmg.impact_type = impact_enum.OPPOSITE_DIR;
		if player_ent.clip_done || player_ent.on_ground
		{
			clip_changed = true;
			can_move = true;
			ChangeState(player_ent, entity_state.IDLE);
			//aux = 1;
			//__dbg_break;
		}
	}
	else if player_ent.state == entity_state.DESCENDING
	{
		player_ent.cl = ctx.character_descending;
		if player_ent.on_ground
		{
			clip_changed = true;
			can_move = true;
			ChangeState(player_ent, entity_state.IDLE);
			//aux = 1;
			//__dbg_break;
		}
	}
	else if player_ent.state == entity_state.AXE_PUNCH
	{
		can_move = false;
		player_ent.cl = character_axe_punch;
		//PrintV3(15.0, 0.0, 0.0);
		if player_ent.clip_done
		{
			clip_changed = true;
			can_move = true;
			player_ent.knockedout = false;
			ChangeState(player_ent, entity_state.IDLE);
			//aux = 1;
			//__dbg_break;
		}
	}
	else if player_ent.state == entity_state.AXE_THROW || player_ent.state == entity_state.AXE_AIR_THROW
	{
		can_move = false;
		was_equal := true;
		diff_tex :u32= 0;
		
		if player_ent.state == entity_state.AXE_THROW
		{
			was_equal = player_ent.cl == character_axe_throw;
			player_ent.cl = character_axe_throw;
			diff_tex = player_ent.tex_id - THROW_ANIM_START_TEX_IDX;
		}
		else
		{
			was_equal = player_ent.cl == ctx.character_axe_throw_air;
			player_ent.cl = ctx.character_axe_throw_air;
			diff_tex = player_ent.tex_id - THROW_AIR_ANIM_START_TEX_IDX;
			gravity_vel.y = gravity_vel.y / 1.4;
			player_ent.vel.y = player_ent.vel.y/1.4;
			mov_vel.y = 0.0;
		}

		if !was_equal
			return;
		
		
		on_hand_item := cur_weapon.item;
		anim_start_tex := ctx.axe_throw_texs;
		if on_hand_item == inv_item.SPEAR
			anim_start_tex = ctx.spear_throw_texs;
		
		
		// weapon drawing
		memset(&draw, 0, sizeof(draw));
		draw.pos = player_ent.pos;
		draw.pivot = player_ent.pivot;
		draw.ent_size.x = 2.0 * player_ent.forward.x;
		draw.ent_size.y = 2.0;
		*draw.color[0] = 1.0;
		*draw.color[1] = 1.0;
		*draw.color[2] = 1.0;
		*draw.color[3] = 1.0;
		draw.cam_pos = ctx.cam_pos_global;
		draw.cam_size = ctx.cam_size;
		draw.flags = DRAW_INFO_HAS_TEXTURE;
		draw.texture_id = diff_tex + anim_start_tex;
		Draw(ctx.window, &draw);
		
		if player_ent.clip_time >= 0.3 && charge_attack_time == 0.0 && player_ent.on_ground
		{
			player_ent.cl.pause = true;
			//player_ent.tex_id = 70;
		}
		if player_ent.cl.pause
		{
			charge_attack_time += *dt;
			if keys.attack2_key_up || !keys.attack2_key_held || charge_attack_time > 1.0
			{
				player_ent.cl.pause = false;
			}
		}
		if trigger.is_active && has_axe
		{
			summed_time := charge_attack_time * 3.0 + 1.0;
			
			has_axe = false;
			if on_hand_item == inv_item.AXE
			{
				axe_ent.is_active = true;
				axe_ent.pos.x = player_ent.pos.x + player_ent.forward.x;
				axe_ent.pos.y = player_ent.pos.y;
				axe_ent.vel.x = player_ent.forward.x * 4.0 * (summed_time);
				axe_ent.vel.y = 5.0;
				axe_ent.angle_rot.z = sign(player_ent.forward.x) * 5.0 * (charge_attack_time * 4.0 + 1.0);
			}
			else if on_hand_item == inv_item.SPEAR
			{
				spear := *ptr_offset(spears, cur_spear, *entity);
				ASSERT(spear != nil)
				spear.cl = ctx.spear_clip;
				spear.pos.x = player_ent.pos.x - player_ent.forward.x;
				spear.pos.y = player_ent.pos.y + 0.5;
				spear.is_trigger = true;
				spear.is_static = false;
				spear.forward.x = player_ent.forward.x;
				spear.is_active = true;
				spear.vel.x = player_ent.forward.x * 10.0;
				spear.vel.y = 0.0;
				cur_spear = (cur_spear + 1) % max_spears;
			}
			//has_axe = false;1
		}

		
		//PrintV3(15.0, 0.0, 0.0);
		if player_ent.clip_done
		{
			
			clip_changed = true;
			can_move = true;
			player_ent.knockedout = false;
			ChangeState(player_ent, entity_state.IDLE);
			charge_attack_time = 0.0;
			//aux = 1;
			//__dbg_break;
		}
	}
	else if player_ent.state == entity_state.RISING
	{
		player_ent.cl = ctx.character_rising;
		if player_ent.on_ground
		{
			clip_changed = true;
			can_move = true;
			ChangeState(player_ent, entity_state.IDLE);
			//aux = 1;
			//__dbg_break;
		}
	}
	else if player_ent.state == entity_state.UPWARD_PUNCH
	{
		player_ent.cl = ctx.character_upward_punch;
		can_move = false;
		mov_info.trigger.dmg.impact_type = impact_enum.UP;
		if player_ent.clip_done
		{
			clip_changed = true;
			can_move = true;
			ChangeState(player_ent, entity_state.IDLE);
			//aux = 1;
			//__dbg_break;
		}
	}
	else if player_ent.state == entity_state.HIGH_KICK
	{
		player_ent.cl = ctx.character_high_kick;
		can_move = false;
		mov_info.trigger.dmg.impact_type = impact_enum.UP_AND_OPPOSITE_DIR;
		if player_ent.clip_done
		{
			clip_changed = true;
			can_move = true;
			ChangeState(player_ent, entity_state.IDLE);
			//aux = 1;
			//__dbg_break;
		}
	}
	else if player_ent.state == entity_state.ON_GROUND
	{
		can_move = false;
		player_ent.cl = ctx.character_on_ground;
		//PrintV3(15.0, 0.0, 0.0);
		if player_ent.clip_done
		{
			clip_changed = true;
			can_move = true;
			player_ent.knockedout = false;
			ChangeState(player_ent, entity_state.IDLE);
			//aux = 1;
			//__dbg_break;
		}
	}
	else if player_ent.state == entity_state.FALLING
	{
		can_move = false;
		player_ent.cl = ctx.character_falling;
		if player_ent.clip_done
		{
			clip_changed = true;
			can_move = true;
			ChangeState(player_ent, entity_state.IDLE);
			//aux = 1;
			//__dbg_break;
		}
	}
	else if player_ent.state == entity_state.IMPACTED
	{
		can_move = false;
		can_jmp = false;
		player_ent.cl = ctx.character_impacted;
		if player_ent.clip_done
		{
			__dbg_break;
			clip_changed = true;
			can_move = true;
			ChangeState(player_ent, entity_state.IDLE);
			//aux = 1;
			//__dbg_break;
		}
	}
	else if player_ent.state == entity_state.MEDIUM_KICK
	{
		player_ent.cl = ctx.character_medium_kick;
		can_move = false;
		mov_info.trigger.dmg.impact_type = impact_enum.OPPOSITE_DIR;
		if player_ent.clip_done
		{
			clip_changed = true;
			can_move = true;
			ChangeState(player_ent, entity_state.IDLE);
			//aux = 1;
			//__dbg_break;
		}
	}
	else if player_ent.state == entity_state.KICK
	{
		player_ent.cl = ctx.character_kick;
		//PrintV3(4.0, 0.0, 0.0);
		if player_ent.clip_done
		{
			clip_changed = true;
			can_move = true;
			ChangeState(player_ent, entity_state.IDLE);
			//aux = 1;
			//__dbg_break;
		}

		if player_ent.can_start_combo
		{
			//PrintV3(10.0, 0.0, 0.0);
			if keys.attack_key_down && keys.horizontal_key_held
			{
				ChangeState(player_ent, entity_state.HIGH_KICK);
				clip_changed = true;
			}
			else if keys.attack_key_down && !keys.horizontal_key_held
			{
				ChangeState(player_ent, entity_state.MEDIUM_KICK);
				clip_changed = true;
			}
		}
	}
	else
		__dbg_break;

	if player_ent.knockedout
	{
		if player_ent.on_ground
		{
			//PrintV3(13.0, 0.0, 0.0);
			ChangeState(player_ent, entity_state.ON_GROUND);
		}
		else
		{
			//PrintV3(14.0, 0.0, 0.0);
			ChangeState(player_ent, entity_state.FALLING);
		}
	}

	if clip_changed
	{
		player_ent.can_start_combo = false;
		trigger.is_active = false;
		trigger.dmg.hit = false;
	}


	if in_combo
	{
		can_move = false;
	}


	if !can_move || player_ent.dmg.hit
	{
		mov_vel.x = 0.0;
		//mov_vel.y = 0.0;
	}
	else
	{
		player_ent.forward = forward;
	}

	if player_ent.was_hit
	{
		//__dbg_break;
		ChangeState(player_ent, entity_state.IMPACTED);
		if enemy_state == entity_state.MEDIUM_KICK
		{
			ChangeState(player_ent, entity_state.IMPACTED);
			ctx.enable_freeze_timer = true;
		}
		else if enemy_state == entity_state.UPWARD_PUNCH
		{
			ChangeState(player_ent, entity_state.FALLING);
			player_ent.knockedout = true;
			ctx.enable_freeze_timer = true;
		}
		else if enemy_state == entity_state.HIGH_KICK || enemy_state == entity_state.AIR_KICK 
		{
			ChangeState(player_ent, entity_state.FALLING);
			player_ent.knockedout = true;
			ctx.enable_freeze_timer = true;
		}
		if player_ent.mov_info.enemy_state == entity_state.KICK
		{
			ChangeState(player_ent, entity_state.SWEEPED);
		}
		player_ent.was_hit = false;
		///player_ent.state = entity_state.HIT;
	}
	if platform
	{
		platform_vel = platform.vel;
	}
	player_ent.vel = mov_vel + gravity_vel + player_ent.impact_vel;
	player_ent.vel = player_ent.vel + player_ent.mov_info.platform_vel

	if player_ent.on_ground
	{
		player_ent.impact_vel = player_ent.impact_vel + player_ent.impact_vel * -(*dt * 10.0);
		platform_vel.x = 0.0;
		platform_vel.y = 0.0;
	}
	else
		platform = nil;
	

	player_ent.on_ground = false;
	if trigger
		trigger.size = trig_info.size;
	player_ent.vel.y = clamp(player_ent.vel.y, -20.0, 20.0);
	player_ent.vel.x = clamp(player_ent.vel.x, -10.0, 10.0);
	player_ent.collided_entered = false;

}


DoFreezeTime::fn(ctx : *context, max : f32, smooth : bool, dt : *f32, cam_rot : *_vec)
{
	cam_rot.z = 0.0;
	if (ctx.enable_freeze_timer && ctx.freeze_timer == 0.0)
	{
		cam_rot.z = 0.01;
	}
	if smooth
	{
		if ctx.enable_freeze_timer && ctx.freeze_timer < max
		{
			ctx.freeze_timer += *dt;
			*dt = *dt * (ctx.freeze_timer / max);
			//dt = 0.0;
		}
		else
		{
			ctx.freeze_timer = 0.0;
			ctx.enable_freeze_timer = false;
		}
	}
	else
	{
		if ctx.enable_freeze_timer && ctx.freeze_timer < max
		{
			ctx.freeze_timer += *dt;
			*dt = 0.0;
			//dt = 0.0;
		}
		else
		{
			ctx.freeze_timer = 0.0;
			ctx.enable_freeze_timer = false;
		}
	}
}

anim_add_tex_kf::fn(tm : *timeline, at : f32, in_tex_id : u32)
{
	kf: keyframe;
	kf.{
		time = at;
		tex_id = in_tex_id;
	};
	dyn_add(&tm.kfs, &kf);
	aoeu: = 0;
}

anim_add_activate_kf::fn(tm : *timeline, at : f32, val_in : bool, act_type : activate_type)
{
	kf: keyframe;
	kf.{
		time = at;
		activate.type = act_type;
		activate.val = val_in;
	};
	dyn_add(&tm.kfs, &kf);

}
anim_add_mov_kf::fn(tm : *timeline, at : f32, x : f32, y : f32, z : f32)
{
	kf: keyframe;
	kf.{
		time = at;
		mov.pos.x = x;
		mov.pos.y = y;
		mov.pos.z = z;
	};
	dyn_add(&tm.kfs, &kf);
}

CreateNewClip::fn(ctx : *context)!*clip2
{
	ret:= cast(*clip2)heap_alloc(ctx.alloc, sizeof(clip2));
	ret.loop = true;
	ret.vel = 1.0;
	dyn_init2(&ret.tms, 4, ctx.alloc);

	ret.tms.count = 1;
	tm: = ret.tms[0];
	dyn_init2(&tm.kfs, 4, ctx.alloc);

	return ret;
}
CreateAnim::fn(ctx : *context, start_idx : u32, end_idx : u32, texs_idxs : *u32, count_texs : u32) ! *clip2
{
	ASSERT(end_idx < (start_idx + count_texs));

	clip1: = CreateNewClip(ctx);
	clip1.loop = true;
	//dyn_init2(&clip1.tms, 4, ctx.alloc);
	tm: *timeline= clip1.tms[0];
	tm.type = timeline_type.TEXTURE;


	tex_ptr: = ctx.character_texs.tex_idxs;
	
	for i in start_idx..end_idx
	{
		idx: = i - start_idx;
		anim_add_tex_kf(tm, (cast(f32)idx) * 0.1, *ptr_offset(texs_idxs, cast(u64)i, u32));
	}
	clip1.len = cast(f32)(end_idx - start_idx) * 0.1;
	return clip1;
}

MakeClipStopCharacterAndMore::fn(ctx : *context, cl : *clip2, stop_move_at : f32, activate_trigger_at : f32, can_start_combo_at : f32)
{

	if cl.tms.count == 1
	{
		regrow(&cl.tms, cl.tms.count + 1);
		cl.tms[1].type = timeline_type.CHANGE;
		dyn_init2(&cl.tms[1].kfs, 4, ctx.alloc);
	}
	if stop_move_at >= 0.0
		anim_add_activate_kf(cl.tms[1], stop_move_at, false, activate_type.CAN_MOVE);
	if activate_trigger_at >= 0.0
		anim_add_activate_kf(cl.tms[1], activate_trigger_at, true, activate_type.ACTIVATE_ATTACK_TRIGGER);
	if can_start_combo_at >= 0.0
		anim_add_activate_kf(cl.tms[1], can_start_combo_at, true, activate_type.CAN_START_COMBO);
}

ChangeBehaviour::fn(e_ent : *entity, to : behaviour_state)
{
	e_ent.mov_info.this_state = to;
	e_ent.mov_info.behaviour_timer = 0.0;
}

ChangeIfBehaviourIfStateIsTerminal::fn(ent : *entity, to : behaviour_state)
{
	if ent.state == entity_state.MEDIUM_KICK || ent.state == entity_state.AIR_KICK
	{
		ent.mov_info.this_state = to;
	}

}
