		/*
		"
		func : fn()
		\{
			a : u32= 4
			r1 = a
		\}
		")
		*/
	Tokenize(&tkns,
		"
		call : fn()
		\{
		\}
		func : fn()
		\{
			call()
			if r1
				r2 = 0
			elif r2 == 5
				r0 = 2
