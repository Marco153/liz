		}
		f.stack_sz += 8 - (f.stack_sz % 8)
		dyn_clear(&irs)
		ast_to_ir(&lang_stat, f.ast.FUNC.scp_ast, root, &irs)

		gen_imm_to_reg(RSP_REG, 8, bc_type.ADD_I_2_R, cast(s32)f.stack_sz, &f.bcs, cast(u16)token_type.PLUS)
		ir_to_bc(&irs, &f.bcs)
		gen_imm_to_reg(RSP_REG, 8, bc_type.SUB_I_2_R, cast(s32)f.stack_sz, &f.bcs, cast(u16)token_type.MINUS)

		bc.tp = bc_type.RET
		dyn_add(&f.bcs, &bc)
	}



