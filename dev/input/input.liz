import "../glfw"
import "../memory"
import "../os"

TOTAL_KEYS:              const s32 = (GLFW_KEY_LAST + 3);

KEY_HELD:                const s32 = 0x01;
KEY_DOWN:                const s32 = 0x02;
KEY_UP:                  const s32 = 0x04;
KEY_RECENTLY_DOWN:       const s32 = 0x08;
KEY_REPEAT:              const s32 = 0x10;
KEY_DOUBLE_CLICK:        const s32 = 0x20;
DOUBLE_CLICK_MAX_TIME:   const f32 = 0.2;

mouse_enum : enum
{
	LEFT,
	RIGHT
}
key_enum : enum
{
	LEFT,
	RIGHT,
	DOWN,
	UP,
	ACT0,
	ACT1,
	ACT2,
	ACT3,
	JMP,
	DEL,
	SHIFT,
	TAB,
	ALT,
	LCTRL,
	A,
	S,
	D,
	F,
	Q,
	E,
	W,
	I,
	P,
	Z,
	X,
	C,
	V,
	B,
	N,
	M,
	ESCAPE,
	SPACE,
	F1,
	F2,
	F3,
	F4,
	F5,
	F6,
	F7,
	F8,
	F9,
	F10,
	F11,
	F12,
	ENTER,
	K,
	NUM_0,
	NUM_1,
	NUM_2,
	NUM_3,
	NUM_4,
	NUM_5,
	NUM_6,
	NUM_7,
	NUM_8,
	NUM_9,
}

FromGameToGLFWKey::fn(i: s32) ! s32
{
  key: s32;

  a := cast(key_enum)i

  on a
  {
    key_enum.Z        { key = GLFW_KEY_Z; }
    key_enum.X        { key = GLFW_KEY_X; }
    key_enum.C        { key = GLFW_KEY_C; }
    key_enum.V        { key = GLFW_KEY_V; }
    key_enum.B        { key = GLFW_KEY_B; }
    key_enum.N        { key = GLFW_KEY_N; }
    key_enum.M        { key = GLFW_KEY_M; }
    key_enum.P        { key = GLFW_KEY_P; }
    key_enum.I        { key = GLFW_KEY_I; }

    key_enum.UP       { key = GLFW_KEY_W; }
    key_enum.DOWN     { key = GLFW_KEY_S; }
    key_enum.RIGHT    { key = GLFW_KEY_D; }
    key_enum.LEFT     { key = GLFW_KEY_A; }

    key_enum.ACT1     { key = GLFW_KEY_J; }
    key_enum.ACT0     { key = GLFW_KEY_K; }
    key_enum.JMP      { key = GLFW_KEY_SPACE; }
    key_enum.DEL      { key = GLFW_KEY_DELETE; }

    key_enum.F        { key = GLFW_KEY_F; }
    key_enum.K        { key = GLFW_KEY_K; }

    key_enum.ENTER    { key = GLFW_KEY_ENTER; }
    key_enum.ESCAPE  { key = GLFW_KEY_ESCAPE; }
    key_enum.SPACE   { key = GLFW_KEY_SPACE; }
    key_enum.TAB     { key = GLFW_KEY_TAB; }
    key_enum.SHIFT   { key = GLFW_KEY_LEFT_SHIFT; }
    key_enum.LCTRL   { key = GLFW_KEY_LEFT_CONTROL; }
    key_enum.ALT     { key = GLFW_KEY_LEFT_ALT; }

    key_enum.A        { key = GLFW_KEY_A; }
    key_enum.S        { key = GLFW_KEY_S; }
    key_enum.D        { key = GLFW_KEY_D; }
    key_enum.W        { key = GLFW_KEY_W; }
    key_enum.E        { key = GLFW_KEY_E; }
    key_enum.Q        { key = GLFW_KEY_Q; }

    key_enum.NUM_0    { key = GLFW_KEY_0; }
    key_enum.NUM_1    { key = GLFW_KEY_1; }
    key_enum.NUM_2    { key = GLFW_KEY_2; }
    key_enum.NUM_3    { key = GLFW_KEY_3; }
    key_enum.NUM_4    { key = GLFW_KEY_4; }
    key_enum.NUM_5    { key = GLFW_KEY_5; }
    key_enum.NUM_6    { key = GLFW_KEY_6; }
    key_enum.NUM_7    { key = GLFW_KEY_7; }
    key_enum.NUM_8    { key = GLFW_KEY_8; }
    key_enum.NUM_9    { key = GLFW_KEY_9; }

    key_enum.F1       { key = GLFW_KEY_F1; }
    key_enum.F2       { key = GLFW_KEY_F2; }
    key_enum.F3       { key = GLFW_KEY_F3; }
    key_enum.F4       { key = GLFW_KEY_F4; }
    key_enum.F5       { key = GLFW_KEY_F5; }
    key_enum.F6       { key = GLFW_KEY_F6; }
    key_enum.F7       { key = GLFW_KEY_F7; }
    key_enum.F8       { key = GLFW_KEY_F8; }
    key_enum.F9       { key = GLFW_KEY_F9; }
    key_enum.F10      { key = GLFW_KEY_F10; }
    key_enum.F11      { key = GLFW_KEY_F11; }
    key_enum.F12      { key = GLFW_KEY_F12; }

    default
    {
      __dbg_break;
    }
  }

  return key;
}


input_manager:struct
{
  buttons:[TOTAL_KEYS]u32;
  time_pressed:[TOTAL_KEYS]f32;
}
is_key_held::fn(iman : *input_manager, key : key_enum ) ! bool
{
  idx := cast(u64)FromGameToGLFWKey(cast(s32)key);
  //printf("key held {idx}, val {&iman.buttons[idx]}\n")
  if (is_flag_on(iman.buttons[idx], KEY_HELD)) 
  {
    return true;
  }
  return false;
}
