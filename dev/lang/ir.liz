import "../../core";
import "../common";

ir_val_type : etruct
{
	REG(
		r : u8,
	),
	MEM(
		mem_offset : s32,
		r : u8,
	),
	CALL(
		fdecl : *func_decl,
	),
	REG(
		r : u8,
	),
	INT(
		num : s64
	),
}
ir_val : struct
{
	using type : ir_val_type
	ltype : lang_type,
	sz : u8,
	ptr : u8,
	deref : u8,
}

ir_type : etruct
{
	NONE,
	CAST_INT_2_INT(
		lhs : ir_val,
		rhs : ir_val,
	),
	BIN(
		op : u32,
		lhs : ir_val,
		rhs : ir_val,
	),
	BEGIN_STACK(
		fdecl : *func_decl
	),
	END_STACK(
		fdecl : *func_decl
	),
	CALL(
		fdecl : *func_decl
	),
	CALL_OUTSIDER(
		fdecl : *func_decl,
	),
	BEGIN_STMNT(
		line : u32
	),
	END_STMNT,

	RET,

	BEGIN_IF,
	END_IF,

	BEGIN_COND,
	END_COND,

	BEGIN_SUB_IF,
	END_SUB_IF,

	BEGIN_LOOP,
	END_LOOP,

	BEGIN_AND,
	END_AND,

	BEGIN_OR,
	END_OR,
}

ir_rep : struct
{
	using type : ir_type,
	ast : *ast_rep,
	is_and_like_cond : bool,
	end_ir : u32,

}


ast_cond_bin_to_ir::fn(lang_stat: *lang_state, ast : *ast_rep, scp : *scope, out : *dyn_array(ir_rep))
{
	ir : ir_rep
	cond_idx := begin_block(cast(u32)ir_type.BEGIN_COND, out)

	lang_stat.negate_cond_op = true
	val := ast_to_ir(lang_stat, ast, scp, out)
	lang_stat.negate_cond_op = false

	if ast.type == ast_type.WORD
	{
		ir.type = ir_type.BIN
		ir.BIN.op = cast(u32)token_type.COND_NE
		ir.BIN.lhs = val
		ir.BIN.lhs.sz = 8
		ir.BIN.rhs.type = ir_val_type.INT
		ir.BIN.rhs.INT.num = 0
		ir.is_and_like_cond = true
		add_ir(out, &ir, ast)
	}


	end_block(cast(u32)ir_type.END_COND, cond_idx, out)
}

end_block::fn(tp : u32, begin : u32, out : *dyn_array(ir_rep))
{
	ir: ir_rep = ?

	out[cast(u64)begin].end_ir = cast(u32)out.count
	ir.type = cast(ir_type)tp
	ir.end_ir = begin
	dyn_add(out, &ir)
}
begin_block::fn(tp : u32, out : *dyn_array(ir_rep)) !u32
{
	ir: ir_rep = ?

	ret : = out.count
	ir.type = cast(ir_type)tp
	dyn_add(out, &ir)
	return cast(u32)ret
}

type_check::fn(lang_stat : *lang_state, lhs : *lang_type, rhs : *lang_type) !bool
{
	if rhs.type == lang_type_type.INT
	{
		if cast(u32)lhs.type < cast(u32)lang_type_type.INT_TYPES_BEGIN ||
		   cast(u32)lhs.type > cast(u32)lang_type_type.INT_TYPES_END
		{
			return false
		}

	}
	else if lhs.type != rhs.type
	{
		return false
	}
	else
	{
		if lhs.ptr != rhs.ptr
			return false
	}
	return true
}

free_regs::fn(lang_stat: *lang_state)
{
	for r in lang_stat.reg_types
	{
		r.reg_in_use = false
	}
}
alloc_reg::fn(lang_stat: *lang_state) !u8
{
	i:u8 = 0
	for r in lang_stat.reg_types
	{
		if !r.reg_in_use
		{
			r.reg_in_use = true
			return i
		}
		i++
	}
	__dbg_break
	return 0
}
add_ir::fn(out : *dyn_array(ir_rep), ir : *ir_rep, ast: *ast_rep)
{
	ASSERT(ir.type != ir_type.NONE)
	ir.ast = ast
	dyn_add(out, ir)
}
check_decl_in_lhs::fn(lang_stat : *lang_state, val : *ir_val)!bool
{
	if val.type == ir_val_type.MEM
	{
		// move the decl to a reg
		return true
	}
	return false
}
ast_to_ir::fn(lang_stat: *lang_state, ast : *ast_rep, scp : *scope, out : *dyn_array(ir_rep)) !ir_val
{
	ir: ir_rep
	ret : ir_val
	lhs : ir_val
	rhs : ir_val
	ltp : lang_type = ?
	if ast.type == ast_type.BIN
	{
		ir.type = ir_type.BIN
		if ast.BIN.op == cast(u32)token_type.EQUAL
		{
			ASSERT(ast.BIN.expr.count == 2)

			prev_flags := lang_stat.flags
				
			lang_stat.flags = lang_stat.flags | LANG_STAT_FLAGS_IR_IN_EQUAL
			defer lang_stat.flags = prev_flags

			if is_ast_bin(*ast.BIN.expr[0], cast(u32)token_type.COMMA)
			{
				rhs = ast_to_ir(lang_stat, *ast.BIN.expr[1], scp, out)
				ASSERT(rhs.type == ir_val_type.CALL && ast.BIN.op == cast(u32)token_type.EQUAL)

				i := 0
				for e in ast.BIN.expr[0].BIN.expr
				{
					ir.BIN.op = cast(u32)token_type.EQUAL
					ir.BIN.lhs = ast_to_ir(lang_stat, *e, scp, out)
					ir.BIN.rhs.type = ir_val_type.REG
					ir.BIN.rhs.REG.r = cast(u8)i
					ir.BIN.rhs.sz = 8
					add_ir(out, &ir, ast)

					i++
				}
			}
			else
			{

				ir.BIN.op = ast.BIN.op
				ir.BIN.lhs = ast_to_ir(lang_stat, *ast.BIN.expr[0], scp, out)
				ir.BIN.rhs = ast_to_ir(lang_stat, *ast.BIN.expr[1], scp, out)

				if ir.BIN.lhs.type == ir_val_type.REG
				{
					if ir.BIN.lhs.ltype.ptr >= 1
					{
						r := ir.BIN.lhs.REG.r
						ir.BIN.lhs.type = ir_val_type.MEM
						ir.BIN.lhs.MEM.r = r
						ir.BIN.lhs.MEM.mem_offset = 0
					}
					else
					{
						idx: = cast(u64)ir.BIN.lhs.REG.r
						* lang_stat.reg_types[idx] = ir.BIN.rhs.ltype
						ret.ltype = ir.BIN.rhs.ltype
						//ir.BIN.lhs.deref++;

					}
				}
				if ir.BIN.lhs.type == ir_val_type.MEM && ir.BIN.rhs.type == ir_val_type.MEM
				{
					ir2 : ir_rep
					ir2.type = ir_type.BIN
					ir2.BIN.op = cast(u32)token_type.EQUAL
					ir2.BIN.lhs.type = ir_val_type.REG
					ir2.BIN.lhs.REG.r = alloc_reg(lang_stat)
					ir2.BIN.lhs.sz = 8
					ir2.BIN.rhs = ir.BIN.rhs
					add_ir(out, &ir2, ast)

					ir.BIN.rhs = ir2.BIN.lhs
				}

				if ir.BIN.lhs.ltype.ptr > 0
				{
					ir.BIN.lhs.ltype.ptr--
				}

				if !type_check(lang_stat, &ir.BIN.lhs.ltype, &ir.BIN.rhs.ltype)
				{
					__dbg_break
				}

				if ir.BIN.rhs.type == ir_val_type.CALL
				{
					ir.BIN.rhs.type = ir_val_type.REG
					ir.BIN.rhs.REG.r = 0
					ir.BIN.rhs.sz = 8
				}


				add_ir(out, &ir, ast)
			}
		}
		else if ast.BIN.op == cast(u32)token_type.POINT
		{
			lhs = ast_to_ir(lang_stat, *ast.BIN.expr[0], scp, out)

			name := ast.BIN.expr[1].WORD.str
			member :*decl
			if lhs.ltype.tp == lang_type_type.STRUCT
			{
				for m in lhs.ltype.STRUCT.st.vars
				{
					if m.name == name
					{
						member = *m
						break
					}
				}
				ASSERT(member)

				if member.tp.ptr > 0
				{
					__dbg_break
				}
				ret = lhs
				ret.type = ir_val_type.MEM
				ret.ltype = member.tp
				ret.ltype.ptr++
				ret.sz = cast(u8)lget_type_size(&member.tp)
				ret.MEM.mem_offset +=  member.offset
			}
			else
			{
				__dbg_break
			}
			
		}
		else if ast.BIN.op == cast(u32)token_type.AT
		{
			if ast.t.line == 21
			{
				__dbg_break
			}
			ret = ast_to_ir(lang_stat, *ast.BIN.expr[0], scp, out)
			ASSERT(ret.type == ir_val_type.REG)

			ltp = ret.ltype
			descend_find_type(lang_stat, *ast.BIN.expr[1], scp, &ret.ltype)

			ret.sz = cast(u8)lget_type_size(&ret.ltype)

			prev_sz := cast(u8)lget_type_size(&ltp)

			if ret.sz > prev_sz
			{
				ir.type = ir_type.CAST_INT_2_INT
				ir.CAST_INT_2_INT.lhs = ret
				ir.CAST_INT_2_INT.lhs.sz = ret.sz
				ir.CAST_INT_2_INT.rhs = ret
				ir.CAST_INT_2_INT.rhs.sz = prev_sz
				add_ir(out, &ir, ast)
			}


		}
		else if ast.BIN.op == cast(u32)token_type.COLON
		{
			ret = ast_to_ir(lang_stat, *ast.BIN.expr[0], scp, out)
			ast_to_ir(lang_stat, *ast.BIN.expr[1], scp, out)
		}
		else
		{
			ret = ast_to_ir(lang_stat, *ast.BIN.expr[0], scp, out)
			if check_decl_in_lhs(lang_stat, &ret)
			{
				//__dbg_break
			}
			i := 0
			//__dbg_break
			for s in ast.BIN.expr
			{
				if i == 0
				{
					i++
					continue
				}


				rhs = ast_to_ir(lang_stat, *s, scp, out)
				if ast.BIN.op == cast(u32)token_type.NEW_LINE
				{
					continue
				}
				if !type_check(lang_stat, &ret.ltype, &rhs.ltype)
				{
					__dbg_break
				}

				if ret.type == ir_val_type.MEM && rhs.type == ir_val_type.MEM
				{
					__dbg_break
				}

				ir.type = ir_type.BIN

				if lang_stat.negate_cond_op
				{
					if ast.BIN.op == cast(u32)token_type.COND_EQ
						ast.BIN.op = cast(u32)token_type.COND_NE
					else if ast.BIN.op == cast(u32)token_type.COND_NE
						ast.BIN.op = cast(u32)token_type.COND_EQ
					else if ast.BIN.op == cast(u32)token_type.COND_GE
						ast.BIN.op = cast(u32)token_type.COND_LT
					else if ast.BIN.op == cast(u32)token_type.COND_GT
						ast.BIN.op = cast(u32)token_type.COND_LE
					else if ast.BIN.op == cast(u32)token_type.COND_LT
						ast.BIN.op = cast(u32)token_type.COND_GE
					else if ast.BIN.op == cast(u32)token_type.COND_LE
						ast.BIN.op = cast(u32)token_type.COND_GT
					ir.is_and_like_cond = true
				}
				if ret.ptr > 0
				{
					ret.deref = ret.ptr
				}
				ir.BIN.op = ast.BIN.op
				ir.BIN.lhs = ret
				ir.BIN.rhs = rhs

				add_ir(out, &ir, ast)

			}
		}
	}
	else if ast.type == ast_type.RET
	{
		i := 0
		cur_func_ret :*decl

		ASSERT(lang_stat.cur_func.rets.count == ast.RET.rets.count)

		for r in ast.RET.rets
		{
			cur_func_ret = *lang_stat.cur_func.rets[cast(u64)i]
			ret = ast_to_ir(lang_stat, *r, scp, out)

			if !type_check(lang_stat, &cur_func_ret.tp, &ret.ltype)
			{
				__dbg_break
			}

			ir.type = ir_type.BIN
			ir.BIN.op = cast(u32)token_type.EQUAL
			ir.BIN.lhs.type = ir_val_type.REG
			ir.BIN.lhs.REG.r = cast(u8)i
			ir.BIN.lhs.sz = 8
			ir.BIN.rhs = ret

			add_ir(out, &ir, ast)
			i++
		}
		ir.type = ir_type.END_STACK
		ir.END_STACK.fdecl = lang_stat.cur_func
		add_ir(out, &ir, ast)
	}
	else if ast.type == ast_type.CALL
	{
		ASSERT(is_flag_off(lang_stat.flags, LANG_STAT_FLAGS_IR_IN_CALL))
		lang_stat.flags = lang_stat.flags | LANG_STAT_FLAGS_IR_IN_CALL
		
		ASSERT(ast.CALL.fdecl)
		i := 0
		for a in ast.CALL.args
		{
			ret = ast_to_ir(lang_stat, *a, scp, out)
			cur_arg := *ast.CALL.fdecl.args[cast(u64)i]
			ASSERT(ret.type != ir_val_type.MEM)

			if !type_check(lang_stat, &cur_arg.tp, &ret.ltype)
			{
				__dbg_break
			}

			ir.type = ir_type.BIN
			ir.BIN.op = cast(u32)token_type.EQUAL
			ir.BIN.lhs.type = ir_val_type.MEM
			ir.BIN.lhs.MEM.r = RSP_REG
			ir.BIN.lhs.MEM.mem_offset = 16 + (i * 8)
			ir.BIN.lhs.sz = 8
			ir.BIN.rhs = ret

			dyn_add(out, &ir)

			i++
		}

		if is_flag_on(ast.CALL.fdecl.flags, FUNC_DECL_FLAGS_OUTSIDER)
		{
			ir.type = ir_type.CALL_OUTSIDER
			ir.CALL_OUTSIDER.fdecl = ast.CALL.fdecl
		}
		else
		{
			ir.type = ir_type.CALL
			ir.CALL.fdecl = ast.CALL.fdecl
		}


		dyn_add(out, &ir)

		ret.type = ir_val_type.CALL
		ret.CALL.fdecl = ast.CALL.fdecl


		lang_stat.flags = lang_stat.flags & ~LANG_STAT_FLAGS_IR_IN_CALL
	}
	else if ast.type == ast_type.EMPTY_STMNT
	{
		free_regs(lang_stat)
	}
	else if ast.type == ast_type.UNOP
	{
		ret = ast_to_ir(lang_stat, ast.UNOP.un, scp, out)

		if ast.UNOP.op == cast(u32)token_type.EXCLAMATION
		{
			/*
			if ast.t.line == 31
			{
				__dbg_break
			}
			*/

			ret.deref--;
			if ret.ltype.ptr > 0
			{
				ret.ltype.ptr--
			}

			//add_ir(out, &ir, ast)

		}
		else if  ast.UNOP.op == cast(u32)token_type.MUL 
		{
			ret.deref++;
		}
		else if ast.UNOP.op == cast(u32)token_type.DOLAR
		{
			ir.type = ir_type.BIN
			ir.BIN.op = cast(u32)token_type.EQUAL
			ir.BIN.lhs.type = ir_val_type.REG
			ir.BIN.lhs.REG.r = alloc_reg(lang_stat)
			ir.BIN.lhs.sz = 8
			ir.BIN.rhs = ret

			ltp = ret.ltype
			if ltp.tp != lang_type_type.INT
			{
				if ltp.ptr > 0
				{
					ltp.ptr--
				}
			}
			else
			{
				ltp.tp = lang_type_type.S64
			}

			ret = ir.BIN.lhs
			ret.ltype = ltp

			add_ir(out, &ir, ast)

		}
		else
		{
			__dbg_break
		}

	}
	else if ast.type == ast_type.INDEX
	{
		lhs = ast_to_ir(lang_stat, ast.INDEX.lhs, scp, out)

		if lhs.type == ir_val_type.INT
		{
			ir.type = ir_type.BIN
			ir.BIN.op = cast(u32)token_type.EQUAL
			ir.BIN.lhs.type = ir_val_type.REG
			ir.BIN.lhs.REG.r = alloc_reg(lang_stat)
			ir.BIN.lhs.sz = 8
			ir.BIN.rhs = lhs
			add_ir(out, &ir, ast)
			lhs = ir.BIN.lhs
		}

		rhs = ast_to_ir(lang_stat, ast.INDEX.rhs, scp, out)
		ir.type = ir_type.BIN
		ir.BIN.op = cast(u32)token_type.PLUS
		ir.BIN.lhs = lhs
		ir.BIN.rhs = rhs

		ret = ir.BIN.lhs
		ret.deref = 1
		ret.ltype.ptr++

		if ret.ltype.tp == lang_type_type.INT
		{
			ret.ltype.tp = lang_type_type.S64
		}

		add_ir(out, &ir, ast)
	}
	else if ast.type == ast_type.WHILE
	{
		loop_idx := begin_block(cast(u32)ir_type.BEGIN_LOOP, out)

		ast_cond_bin_to_ir(lang_stat, ast.WHILE.cond, scp, out)
		ast_to_ir(lang_stat, ast.WHILE.scp_ast, scp, out)

		end_block(cast(u32)ir_type.END_LOOP, loop_idx, out)
	}
	else if ast.type == ast_type.IF
	{

		if_idx := begin_block(cast(u32)ir_type.BEGIN_IF, out)

		sub_if_idx := begin_block(cast(u32)ir_type.BEGIN_SUB_IF, out)

		ast_cond_bin_to_ir(lang_stat, ast.IF.cond, scp, out)

		ast_to_ir(lang_stat, ast.IF.scp_ast, scp, out)

		end_block(cast(u32)ir_type.END_SUB_IF, sub_if_idx, out)

		for i in ast.IF.others
		{

			cur_sub_if_idx := begin_block(cast(u32)ir_type.BEGIN_SUB_IF, out)

			if i.type == ast_type.ELIF
			{
				ast_cond_bin_to_ir(lang_stat, i.ELIF.cond, scp, out)
				ast_to_ir(lang_stat, i.ELIF.scp_ast, scp, out)
			}
			else if i.type == ast_type.ELSE
			{
				ast_to_ir(lang_stat, i.ELSE.scp_ast, scp, out)
			}

			end_block(cast(u32)ir_type.END_SUB_IF, cur_sub_if_idx, out)
		}

		end_block(cast(u32)ir_type.END_IF, if_idx, out)
		//ir.type = ir_type.END_IF
		//add_ir(out, &ir, ast)
	}
	else if ast.type == ast_type.SCOPE
	{
		for s in ast.SCOPE.stmnts
		{
			st_idx := begin_block(cast(u32)ir_type.BEGIN_STMNT, out)
			out[cast(u64)st_idx].BEGIN_STMNT.line = s.t.line
			if is_ast_bin(*s, cast(u32)token_type.COLON) == false
			{
				ast_to_ir(lang_stat, *s, ast.SCOPE.scp, out)
			}

			end_block(cast(u32)ir_type.END_STMNT, st_idx, out)
		}
	}
	else if ast.type == ast_type.CAST
	{
		ret = ast_to_ir(lang_stat, ast.CAST.rhs, scp, out)
		ret.ltype = ast.CAST.type
		ret.deref = 0;
		ret.ptr = ret.ltype.ptr
	}
	else if ast.type == ast_type.INT
	{
		ret.type = ir_val_type.INT
		ret.INT.num = ast.INT.num
		ret.ltype.tp = lang_type_type.INT
		//if ret.INT.num == 3
			//__dbg_break;
		ret.sz = 4
	}
	else if ast.type == ast_type.FUNC
	{
		ast_to_ir(lang_stat, ast.FUNC.scp_ast, scp, out)
		last := dyn_last(&ast.FUNC.scp_ast.SCOPE.stmnts)
		if last == nil || last.type != ast_type.RET
		{
			ir.type = ir_type.END_STACK
			ir.END_STACK.fdecl = lang_stat.cur_func
			add_ir(out, &ir, ast)
		}

	}
	else if ast.type == ast_type.WORD
	{
		if ast.WORD.str.data.count == 2 && *ast.WORD.str.data[0] == 'r
		{
			r := cast(u8)*ast.WORD.str.data[1] - '0
			if r > 8
				__dbg_break
			ret.type = ir_val_type.REG
			ret.REG.r = r
			ret.sz = 8

		}
		else
		{
			d := find_identifier(&ast.WORD.str, scp)
			ASSERT(d)
			ret.type = ir_val_type.MEM
			ret.MEM.r = RBP_REG
			ret.MEM.mem_offset = d.offset
			ret.ltype = d.tp
			ret.sz = cast(u8)lget_type_size(&d.tp)
			ret.ltype.ptr = 0
		}
	}
	else
	{
		__dbg_break
	}
	return ret
}
