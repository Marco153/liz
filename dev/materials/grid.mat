col:uniform v4 
cam_pos:uniform v4 
sun_dir:uniform v3 
sun_color:uniform v4 
tex:uniform sampler2d 

vertex:fn(pos : v3, uv : v2) ! (tex_coord : v2, frag_pos : v3)
{
    tex_coord = uv
    aux_pos :v4=  MODEL.mod * v4(pos.xyz, 1.0)
    frag_pos = v3(aux_pos.xyz)
    aux_pos = aux_pos
    POSITION = UBO.proj * UBO.view * aux_pos
}
fragment:fn(tex_coord : v2, frag_pos : v3)
{
    dx:v3 = dFdx(frag_pos)
    dy:v3 = dFdy(frag_pos)
    norm:v3= normalize(cross(dx, dy))

    dir_to_frag_world :v3= frag_pos - -cam_pos.xyz
    dir_to_frag :v3= normalize(dir_to_frag_world)

    

    tex_col_vertical_z:v4 =  texture(tex, v2(frag_pos.z , frag_pos.y))
    tex_col_vertical_x:v4 =  texture(tex, v2(frag_pos.x , frag_pos.y))
    tex_col_vertical:v4 =  tex_col_vertical_z
    tex_col_horizontal:v4 =  texture(tex, v2(frag_pos.z , frag_pos.x))


    sum_tex_col:v4= tex_col_horizontal

    sum_tex_col.x = clamp(sum_tex_col.x, 0, 1)
    sum_tex_col.y = clamp(sum_tex_col.y, 0, 1)
    sum_tex_col.z = clamp(sum_tex_col.z, 0, 1)
    sum_tex_col.w = clamp(sum_tex_col.w, 0, 1)

    d:f32 = max(dot(sun_dir, norm), 0.2)


    reflection_dot :f32= 1 - abs(dot(norm, dir_to_frag))
    reflection_dot = reflection_dot 

    col1 :v4= vec4(vec3(1.0, 1.0, 1.0) * d, 1.0) * col * sum_tex_col * sun_color

    fog:f32= length(dir_to_frag_world)

    aux_color :v4= mix(col1, sun_color, smoothstep(0.0, 2.0, reflection_dot))
    aux_color = mix(aux_color, sun_color, smoothstep(10, 300, fog))

    COLOR =  aux_color

}
