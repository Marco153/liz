color:uniform v4
cam_pos:uniform v4
tex:uniform sampler2d
bones:uniform [32]mat4
sun_dir:uniform v4
sun_color:uniform v4
col:uniform v4

vertex:fn(pos : v3, uv : v2, bones_id : iv4, weights : v4) ! (tex_coord : v2, frag_pos : v3)
{
    tex_coord = uv
    aux_pos :v4=  v4(pos.xyz, 1.0)
    id :s32= bones_id[0] - 1 
    mat :mat4= transpose(bones[id]) * weights.x

    id = bones_id[1] - 1
    mat = mat + transpose(bones[id]) * weights.y

    id = bones_id[2] - 1
    mat = mat + transpose(bones[id]) * weights.z

    if id != -1
    {
        id = bones_id[3] - 1
        mat = mat + transpose(bones[id]) * weights.w
    }

    aux_pos = MODEL.mod * mat * aux_pos
    frag_pos = v3(aux_pos.xyz)
    POSITION = UBO.proj * UBO.view * aux_pos
}
fragment:fn(tex_coord : v2, frag_pos : v3)
{
    t :v4=texture(tex, tex_coord)
    COLOR =  t
}
