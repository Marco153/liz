col:uniform v4 
cam_pos:uniform v4 
sun_dir:uniform v3 
sun_color:uniform v4 
terrain_size:uniform v2 
amplitude:uniform f32 
tex:uniform sampler2d 
tex2:uniform sampler2d 
tex3:uniform sampler2d 
tex4:uniform sampler2d 
heightmap:uniform sampler2d 

vertex:fn(pos : v3, normal : v3, vert_col : v4) ! (frag_pos : v3, out_vert_col : v4, fnorm : v3)
{
    aux_pos :v4=  MODEL.mod * v4(pos.xyz, 1.0)
    prev_y :f32=aux_pos.y
    aux_pos.y = texture(heightmap, v2(aux_pos.x/terrain_size.x, aux_pos.z/terrain_size.y)).x * amplitude
    frag_pos = v3(aux_pos.xyz)
    POSITION = UBO.proj * UBO.view * aux_pos
    out_vert_col = vert_col
    fnorm = normal
}
fragment:fn(frag_pos : v3, out_vert_col : v4, fnorm : v3)
{
    dir_to_frag_world :v3= frag_pos - -cam_pos.xyz
    dir_to_frag :v3= normalize(dir_to_frag_world)

    uv_x :v2= frag_pos.zy
    uv_y :v2= frag_pos.xz
    uv_z :v2= frag_pos.xy

    norm:v3 = normalize(fnorm)

    adjusted_normal :v3=abs(norm)
    den:f32=(adjusted_normal.x + adjusted_normal.y + adjusted_normal.z)
    weights:v3=adjusted_normal/den

    tex1_col_x:v4=texture(tex3, uv_x)
    tex1_col_y:v4=texture(tex3, uv_y)
    tex1_col_z:v4=texture(tex3, uv_z)

    tex2_col_x:v4=texture(tex2, uv_x)
    tex2_col_y:v4=texture(tex2, uv_y)
    tex2_col_z:v4=texture(tex2, uv_z)

    sum_tex_col:v4= tex1_col_x * weights.x + tex1_col_y * weights.y + tex1_col_z * weights.z
    sum_tex2col:v4= tex2_col_x * weights.x + tex2_col_y * weights.y + tex2_col_z * weights.z

    up_dot :f32=dot(adjusted_normal, vec3(0, 1, 0))
    sum_tex_col = mix(sum_tex_col, sum_tex2col, 1-up_dot)

    sum_tex_col.x = clamp(sum_tex_col.x, 0, 1)
    sum_tex_col.y = clamp(sum_tex_col.y, 0, 1)
    sum_tex_col.z = clamp(sum_tex_col.z, 0, 1)
    sum_tex_col.w = clamp(sum_tex_col.w, 0, 1)

    d:f32 = max(dot(sun_dir, norm), 0.2)


    reflection_dot :f32= 1 - abs(dot(norm, dir_to_frag))

    col1 :v4= vec4(vec3(1.0, 1.0, 1.0) * d, 1.0) * col * sum_tex_col * sun_color

    fog:f32= length(dir_to_frag_world)

    aux_color :v4= mix(col1, sun_color, smoothstep(0.0, 3.0, reflection_dot))
    aux_color = mix(aux_color, sun_color, smoothstep(10, 300, fog))


    aux_color = mix(aux_color, out_vert_col, out_vert_col.w)

    COLOR =  aux_color
}
