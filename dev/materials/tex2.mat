col:uniform v4 
cam_pos:uniform v4 
sun_dir:uniform v4
sun_color:uniform v4 
tex0:uniform sampler2d 
tex1:uniform sampler2d 
tex2:uniform sampler2d 
tex3:uniform sampler2d 

vertex:fn(pos : v3, uv : v2, vcol : v4, in_texs : v4) ! (tex_coord : v2, frag_pos : v3, px_vcol : v4, out_texs : v4)
{
    tex_coord = uv
    aux_pos :v4=  MODEL.mod * v4(pos.xyz, 1.0)
    frag_pos = v3(aux_pos.xyz)
    px_vcol = vcol
    out_texs = in_texs
    POSITION = UBO.proj * UBO.view * aux_pos
}
fragment:fn(tex_coord : v2, frag_pos : v3, px_vcol: v4, out_texs :v4)
{
    t0 :v4= texture(tex0, tex_coord)
    t1 :v4= texture(tex1, tex_coord)
    t2 :v4= texture(tex2, tex_coord)
    t3 :v4= texture(tex3, tex_coord)
    t :v4= t0*out_texs.x + t1*out_texs.y + t2*out_texs.z + t3*out_texs.w
    t = t * px_vcol
    COLOR =  t
}

