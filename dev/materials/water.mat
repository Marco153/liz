model:uniform mat4 
view:uniform mat4 
projection:uniform mat4 
col: uniform v4 
cam_pos:uniform v4 
tex:uniform sampler2d 
noise:uniform sampler2d 

vertex:fn(pos : v3, uv : v2) ! (tex_coord : v2, frag_pos : v3)
{
    tex_coord = uv
    aux_pos :v4=  model * v4(pos.xyz, 1.0)
    frag_pos = v3(aux_pos.xyz)
    aux_pos = aux_pos + cam_pos
    POSITION = projection * view * aux_pos
}
fragment:fn(tex_coord : v2, frag_pos : v3)
{
    n  :v4=texture(noise, v2(-frag_pos.x + TIME * 0.12, frag_pos.z + TIME * 0.12))

    tex_col:v4 =  texture(tex, v2(frag_pos.x + TIME * 0.1 + n.x, frag_pos.z + TIME * 0.1 + n.z))
    COLOR = col * tex_col
}
