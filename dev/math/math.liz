import "../typedefs/"
import "../memory/"

__sqrt::fn intrinsic(a : f32) !f32;
sqrt::fn x64(a : f32) !f32
{
  return __sqrt(a);
}
sinf::fn outsider(f32) !f32;
cosf::fn outsider(f32) !f32;
tanf::fn outsider(f32) !f32;
asinf::fn outsider(f32) !f32;
acosf::fn outsider(f32) !f32;
atan2f::fn outsider(f32, f32) !f32;

mat4x4 : struct
{
	vals : [4 * 4] f32,
}
build_scale_matrix::fn x64(m: *mat4x4, t: _vec)
{
	m.vals[0] = t.x; m.vals[1] = 0.0; m.vals[2] = 0.0; m.vals[3] = 0.0;
	m.vals[4] = 0.0; m.vals[5] = t.y; m.vals[6] = 0.0; m.vals[7] = 0.0;
	m.vals[8] = 0.0; m.vals[9] = 0.0; m.vals[10] = t.z; m.vals[11] = 0.0;
	m.vals[12] = 0.0; m.vals[13] = 0.0; m.vals[14] = 0.0; m.vals[15] = 1.0;
}
build_translation_matrix::fn x64(m: mat4x4, t: _vec)
{
	m.vals[0] = 1.0; m.vals[1] = 0.0; m.vals[2] = 0.0; m.vals[3] = t.x;
	m.vals[4] = 0.0; m.vals[5] = 1.0; m.vals[6] = 0.0; m.vals[7] = t.y;
	m.vals[8] = 0.0; m.vals[9] = 0.0; m.vals[10] = 1.0; m.vals[11] = t.z;
	m.vals[12] = 0.0; m.vals[13] = 0.0; m.vals[14] = 0.0; m.vals[15] = 1.0;
}
build_rotation_matrix::fn x64(m: *mat4x4, q: _vec)
{
	x := q.x;
	y := q.y;
	z := q.z;
	w := q.w;

	m.vals[0] = 1.0 - 2.0 * (y * y + z * z);
	m.vals[1] = 2.0 * (x * y - z * w);
	m.vals[2] = 2.0 * (x * z + y * w);
	m.vals[3] = 0.0;

	m.vals[4] = 2.0 * (x * y + z * w);
	m.vals[5] = 1.0 - 2.0 * (x * x + z * z);
	m.vals[6] = 2.0 * (y * z - x * w);
	m.vals[7] = 0.0;

	m.vals[8] = 2.0 * (x * z - y * w);
	m.vals[9] = 2.0 * (y * z + x * w);
	m.vals[10] = 1.0 - 2.0 * (x * x + y * y);
	m.vals[11] = 0.0;

	m.vals[12] = 0.0;
	m.vals[13] = 0.0;
	m.vals[14] = 0.0;
	m.vals[15] = 1.0;
}
transpose::fn(out : *f32, m : *f32)
{
	// row, col indexing: out[col * 4 + row] = m[row * 4 + col]
	for row in 0..4
	{
		for col in 0..4
		{
			*ptr_offset(out, col * 4 + row, f32) = *ptr_offset(m, row * 4 + col, f32)
		}
	}
}
build_model_matrix ::fn x64(out_matrix : *f32, position : _vec, q : *f32, scale : _vec) 
{
	// Extract quaternion components using ptr_offset
    x := *ptr_offset(q, 0, f32)
    y := *ptr_offset(q, 1, f32)
    z := *ptr_offset(q, 2, f32)
    w := *ptr_offset(q, 3, f32)
    
    // Calculate quaternion products
    x2 := x + x
    y2 := y + y
    z2 := z + z
    xx := x * x2
    xy := x * y2
    xz := x * z2
    yy := y * y2
    yz := y * z2
    zz := z * z2
    wx := w * x2
    wy := w * y2
    wz := w * z2
    
    // Apply scale
    sx := scale.x
    sy := scale.y
    sz := scale.z
    
    // First column (becomes first row in row-major)
    *ptr_offset(out_matrix, 0, f32) = (1.0 - (yy + zz)) * sx
    *ptr_offset(out_matrix, 1, f32) = (xy - wz) * sy
    *ptr_offset(out_matrix, 2, f32) = (xz + wy) * sz
    *ptr_offset(out_matrix, 3, f32) = position.x
    
    // Second column (becomes second row in row-major)
    *ptr_offset(out_matrix, 4, f32) = (xy + wz) * sx
    *ptr_offset(out_matrix, 5, f32) = (1.0 - (xx + zz)) * sy
    *ptr_offset(out_matrix, 6, f32) = (yz - wx) * sz
    *ptr_offset(out_matrix, 7, f32) = position.y
    
    // Third column (becomes third row in row-major)
    *ptr_offset(out_matrix, 8, f32) = (xz - wy) * sx
    *ptr_offset(out_matrix, 9, f32) = (yz + wx) * sy
    *ptr_offset(out_matrix, 10, f32) = (1.0 - (xx + yy)) * sz
    *ptr_offset(out_matrix, 11, f32) = position.z
    
    // Fourth column (becomes fourth row in row-major)
    *ptr_offset(out_matrix, 12, f32) = 0.0
    *ptr_offset(out_matrix, 13, f32) = 0.0
    *ptr_offset(out_matrix, 14, f32) = 0.0
    *ptr_offset(out_matrix, 15, f32) = 1.0
}

quaternion64 : struct
{
	v : _vec2
}
quaternion : struct
{
	v : _vec
}
normalize_quaternion::fn x64(out : *_vec, q : _vec) {

  val := q.w*q.w + q.x*q.x + q.y*q.y + q.z*q.z
  mag := sqrt(cast(f32)val)
  __dbg_break
  __dbg_break
  __dbg_break
  a := 0
	if a == 0
	{
		out.x = 1.0
		out.y = 0.0
		out.z = 0.0
		out.w = 0.0
	}
	else
	{
		out.x = q.x/mag
		out.y = q.y/mag
		out.z = q.z/mag
		out.w = q.w/mag
	}

	if mag == 0.0
	{
		out.x = 1.0
		out.y = 0.0
		out.z = 0.0
		out.w = 0.0
	}
	else
	{
		out.x = q.x/mag
		out.y = q.y/mag
		out.z = q.z/mag
		out.w = q.w/mag
	}
}
create_from_axis_angle::fn(xx:f32, yy:f32, zz:f32, a:f32) ! quaternion
{
	q : quaternion=?
  // Here we calculate the sinf( theta / 2) once for optimization
  factor: = sinf( cast(f32)a / 2.0 );

  // Calculate the x, y and z of the quaternion
  q.v.x = xx * factor;
  q.v.y = yy * factor;
  q.v.z = zz * factor;

  // Calcualte the w value by cos( theta / 2 )
  q.v.w = cosf( cast(f32)a / 2.0 );
	normalize_quaternion(&q.v, q.v)
  return q
}
multiply_quaternions::fn x64(out : *_vec, q1 : _vec, q2 : _vec) {
	out.x = q1.w*q2.x + q1.x*q2.w + q1.y*q2.z - q1.z*q2.y
	out.y = q1.w*q2.y - q1.x*q2.z + q1.y*q2.w + q1.z*q2.x
	out.z = q1.w*q2.z + q1.x*q2.y - q1.y*q2.x + q1.z*q2.w
	out.w = q1.w*q2.w - q1.x*q2.x - q1.y*q2.y - q1.z*q2.z 
}
quaternion_conjugate::fn x64(out : *_vec, q : _vec) { 
    out.x = -q.x
	out.y = -q.y
	out.z = -q.z
	out.w = q.w
}
rotate_vector::fn x64(out : *_vec, v : _vec, q : _vec) {
	aux : _vec
  normalize_quaternion(&aux, q)
  p :_vec
	p.x = v.x
	p.y = v.y
	p.z = v.z
	p.w = 0.0
  q_conj:_vec
  rotated:_vec
  mul:_vec
	quaternion_conjugate(&q_conj, q);

	multiply_quaternions(&mul, q, p)

  multiply_quaternions(&rotated, mul, q_conj);
  out.x = rotated.x
	out.y = rotated.y
	out.z = rotated.z

}
operator * x64(self : *quaternion, rhs : *quaternion) !quaternion
{
	ret : quaternion = ?

  __dbg_break;
	multiply_quaternions(&ret.v, self.v, rhs.v)
	return ret
}
operator * x64(self : *quaternion, vec : *_vec) !_vec
{
	ret :_vec
	rotate_vector(&ret, *vec, self.v)
	return ret
}
