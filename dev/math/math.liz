import "../typedefs/"
import "../memory/"

__sqrt::fn intrinsic(a : f32) !f32;
__sqrt2::fn intrinsic(a : f64) !f64;

sqrt::fn x64(a : f32) !f32
{
  return __sqrt(a);
}
_dot::fn intrinsic(lhs : _vec2, rhs : _vec2) ! f64;
sinf::fn outsider(f32) !f32;
cosf::fn outsider(f32) !f32;
tanf::fn outsider(f32) !f32;
asinf::fn outsider(f32) !f32;
acosf::fn outsider(f32) !f32;
atan2f::fn outsider(f32, f32) !f32;

sin::fn outsider(f64) !f64;
cos::fn outsider(f64) !f64;
tan::fn outsider(f64) !f64;
asin::fn outsider(f64) !f64;
acos::fn outsider(f64) !f64;
atan2::fn outsider(f64, f64) !f64;
mat4x4_ : struct
{
	vals : [4 * 4] f64,
}
mat4x4 : struct
{
	vals : [4 * 4] f32,
}
build_scale_matrix::fn x64(m: *mat4x4, t: _vec)
{
	m.vals[0] = t.x; m.vals[1] = 0.0; m.vals[2] = 0.0; m.vals[3] = 0.0;
	m.vals[4] = 0.0; m.vals[5] = t.y; m.vals[6] = 0.0; m.vals[7] = 0.0;
	m.vals[8] = 0.0; m.vals[9] = 0.0; m.vals[10] = t.z; m.vals[11] = 0.0;
	m.vals[12] = 0.0; m.vals[13] = 0.0; m.vals[14] = 0.0; m.vals[15] = 1.0;
}
build_translation_matrix::fn x64(m: mat4x4, t: _vec)
{
	m.vals[0] = 1.0; m.vals[1] = 0.0; m.vals[2] = 0.0; m.vals[3] = t.x;
	m.vals[4] = 0.0; m.vals[5] = 1.0; m.vals[6] = 0.0; m.vals[7] = t.y;
	m.vals[8] = 0.0; m.vals[9] = 0.0; m.vals[10] = 1.0; m.vals[11] = t.z;
	m.vals[12] = 0.0; m.vals[13] = 0.0; m.vals[14] = 0.0; m.vals[15] = 1.0;
}
build_rotation_matrix::fn x64(m: *mat4x4, q: _vec)
{
	x := q.x;
	y := q.y;
	z := q.z;
	w := q.w;

	m.vals[0] = 1.0 - 2.0 * (y * y + z * z);
	m.vals[1] = 2.0 * (x * y - z * w);
	m.vals[2] = 2.0 * (x * z + y * w);
	m.vals[3] = 0.0;

	m.vals[4] = 2.0 * (x * y + z * w);
	m.vals[5] = 1.0 - 2.0 * (x * x + z * z);
	m.vals[6] = 2.0 * (y * z - x * w);
	m.vals[7] = 0.0;

	m.vals[8] = 2.0 * (x * z - y * w);
	m.vals[9] = 2.0 * (y * z + x * w);
	m.vals[10] = 1.0 - 2.0 * (x * x + y * y);
	m.vals[11] = 0.0;

	m.vals[12] = 0.0;
	m.vals[13] = 0.0;
	m.vals[14] = 0.0;
	m.vals[15] = 1.0;
}
transpose::fn(out : *f32, m : *f32)
{
	// row, col indexing: out[col * 4 + row] = m[row * 4 + col]
	for row in 0..4
	{
		for col in 0..4
		{
			*ptr_offset(out, col * 4 + row, f32) = *ptr_offset(m, row * 4 + col, f32)
		}
	}
}

build_view_matrix_inverse ::fn x64(out_matrix : *f32,
    cam_pos    : _vec,
    q          : *f32)
{
    // --- extract quaternion
    x := *ptr_offset(q, 0, f32)
    y := *ptr_offset(q, 1, f32)
    z := *ptr_offset(q, 2, f32)
    w := *ptr_offset(q, 3, f32)
    
    // --- quaternion products
    x2 := x + x
    y2 := y + y
    z2 := z + z
    xx := x * x2
    xy := x * y2
    xz := x * z2
    yy := y * y2
    yz := y * z2
    zz := z * z2
    wx := w * x2
    wy := w * y2
    wz := w * z2
    
    // --- build rotation matrix from quaternion (non-transposed)
    m00 := 1.0 - (yy + zz)
    m01 := xy - wz
    m02 := xz + wy
    
    m10 := xy + wz
    m11 := 1.0 - (xx + zz)
    m12 := yz - wx
    
    m20 := xz - wy
    m21 := yz + wx
    m22 := 1.0 - (xx + yy)
    
    // --- build view matrix rotation (transpose for world-to-camera)
    r00 := m00  
    r01 := m10  
    r02 := m20  
    
    r10 := m01  
    r11 := m11  
    r12 := m21  
    
    r20 := m02  
    r21 := m12  
    r22 := m22  
    
    // --- column 0
    *ptr_offset(out_matrix, 0, f32) = r00
    *ptr_offset(out_matrix, 1, f32) = r01
    *ptr_offset(out_matrix, 2, f32) = r02
    *ptr_offset(out_matrix, 3, f32) = 0.0
    
    // --- column 1
    *ptr_offset(out_matrix, 4, f32) = r10
    *ptr_offset(out_matrix, 5, f32) = r11
    *ptr_offset(out_matrix, 6, f32) = r12
    *ptr_offset(out_matrix, 7, f32) = 0.0
    
    // --- column 2
    *ptr_offset(out_matrix, 8,  f32) = r20
    *ptr_offset(out_matrix, 9,  f32) = r21
    *ptr_offset(out_matrix, 10, f32) = r22
    *ptr_offset(out_matrix, 11, f32) = 0.0
    
    // --- translation = -R * cam_pos (use non-transposed rotation)
    tx := -(m00 * cam_pos.x + m01 * cam_pos.y + m02 * cam_pos.z)
    ty := -(m10 * cam_pos.x + m11 * cam_pos.y + m12 * cam_pos.z)
    tz := -(m20 * cam_pos.x + m21 * cam_pos.y + m22 * cam_pos.z)
    
    *ptr_offset(out_matrix, 12, f32) = tx
    *ptr_offset(out_matrix, 13, f32) = ty
    *ptr_offset(out_matrix, 14, f32) = tz
    *ptr_offset(out_matrix, 15, f32) = 1.0
}

mat4_inverse ::fn x64(out : *f32, m : *f32) 
{
    // Load matrix elements (column-major)
    m00 := *ptr_offset(m, 0,  f32);  m10 := *ptr_offset(m, 1,  f32)
    m20 := *ptr_offset(m, 2,  f32);  m30 := *ptr_offset(m, 3,  f32)

    m01 := *ptr_offset(m, 4,  f32);  m11 := *ptr_offset(m, 5,  f32)
    m21 := *ptr_offset(m, 6,  f32);  m31 := *ptr_offset(m, 7,  f32)

    m02 := *ptr_offset(m, 8,  f32);  m12 := *ptr_offset(m, 9,  f32)
    m22 := *ptr_offset(m, 10, f32);  m32 := *ptr_offset(m, 11, f32)

    m03 := *ptr_offset(m, 12, f32);  m13 := *ptr_offset(m, 13, f32)
    m23 := *ptr_offset(m, 14, f32);  m33 := *ptr_offset(m, 15, f32)

    // Cofactors
    c00 :=  m11*(m22*m33 - m23*m32) - m21*(m12*m33 - m13*m32) + m31*(m12*m23 - m13*m22)
    c01 := -m10*(m22*m33 - m23*m32) + m20*(m12*m33 - m13*m32) - m30*(m12*m23 - m13*m22)
    c02 :=  m10*(m21*m33 - m23*m31) - m20*(m11*m33 - m13*m31) + m30*(m11*m23 - m13*m21)
    c03 := -m10*(m21*m32 - m22*m31) + m20*(m11*m32 - m12*m31) - m30*(m11*m22 - m12*m21)

    det := m00*c00 + m01*c01 + m02*c02 + m03*c03

    // (optional) check det != 0
    inv_det := 1.0 / det

    // Adjugate * (1/det)
    *ptr_offset(out, 0,  f32) = c00 * inv_det
    *ptr_offset(out, 1,  f32) = c01 * inv_det
    *ptr_offset(out, 2,  f32) = c02 * inv_det
    *ptr_offset(out, 3,  f32) = c03 * inv_det

    *ptr_offset(out, 4,  f32) =
        -(m01*(m22*m33 - m23*m32) - m21*(m02*m33 - m03*m32) + m31*(m02*m23 - m03*m22)) * inv_det

    *ptr_offset(out, 5,  f32) =
         (m00*(m22*m33 - m23*m32) - m20*(m02*m33 - m03*m32) + m30*(m02*m23 - m03*m22)) * inv_det

    *ptr_offset(out, 6,  f32) =
        -(m00*(m21*m33 - m23*m31) - m20*(m01*m33 - m03*m31) + m30*(m01*m23 - m03*m21)) * inv_det

    *ptr_offset(out, 7,  f32) =
         (m00*(m21*m32 - m22*m31) - m20*(m01*m32 - m02*m31) + m30*(m01*m22 - m02*m21)) * inv_det

    *ptr_offset(out, 8,  f32) =
         (m01*(m12*m33 - m13*m32) - m11*(m02*m33 - m03*m32) + m31*(m02*m13 - m03*m12)) * inv_det

    *ptr_offset(out, 9,  f32) =
        -(m00*(m12*m33 - m13*m32) - m10*(m02*m33 - m03*m32) + m30*(m02*m13 - m03*m12)) * inv_det

    *ptr_offset(out, 10, f32) =
         (m00*(m11*m33 - m13*m31) - m10*(m01*m33 - m03*m31) + m30*(m01*m13 - m03*m11)) * inv_det

    *ptr_offset(out, 11, f32) =
        -(m00*(m11*m32 - m12*m31) - m10*(m01*m32 - m02*m31) + m30*(m01*m12 - m02*m11)) * inv_det

    *ptr_offset(out, 12, f32) =
        -(m01*(m12*m23 - m13*m22) - m11*(m02*m23 - m03*m22) + m21*(m02*m13 - m03*m12)) * inv_det

    *ptr_offset(out, 13, f32) =
         (m00*(m12*m23 - m13*m22) - m10*(m02*m23 - m03*m22) + m20*(m02*m13 - m03*m12)) * inv_det

    *ptr_offset(out, 14, f32) =
        -(m00*(m11*m23 - m13*m21) - m10*(m01*m23 - m03*m21) + m20*(m01*m13 - m03*m11)) * inv_det

    *ptr_offset(out, 15, f32) =
         (m00*(m11*m22 - m12*m21) - m10*(m01*m22 - m02*m21) + m20*(m01*m12 - m02*m11)) * inv_det
}
build_model_matrix ::fn x64(out_matrix : *float, position : vector, q : *float, scale : vector) 
{
    x := *ptr_offset(q, 0, float)
    y := *ptr_offset(q, 1, float)
    z := *ptr_offset(q, 2, float)
    w := *ptr_offset(q, 3, float)

    x2 := x + x
    y2 := y + y
    z2 := z + z

    xx := x * x2
    xy := x * y2
    xz := x * z2
    yy := y * y2
    yz := y * z2
    zz := z * z2
    wx := w * x2
    wy := w * y2
    wz := w * z2

    sx := scale.x
    sy := scale.y
    sz := scale.z

    // -------- column 0 (X axis)
    *ptr_offset(out_matrix, 0,  float) = (cast(f64)1.0 - (yy + zz)) * sx
    *ptr_offset(out_matrix, 1,  float) = (xy + wz) * sx
    *ptr_offset(out_matrix, 2,  float) = (xz - wy) * sx
    *ptr_offset(out_matrix, 3,  float) = 0.0

    // -------- column 1 (Y axis)
    *ptr_offset(out_matrix, 4,  float) = (xy - wz) * sy
    *ptr_offset(out_matrix, 5,  float) = (cast(f64)1.0 - (xx + zz)) * sy
    *ptr_offset(out_matrix, 6,  float) = (yz + wx) * sy
    *ptr_offset(out_matrix, 7,  float) = 0.0

    // -------- column 2 (Z axis)
    *ptr_offset(out_matrix, 8,  float) = (xz + wy) * sz
    *ptr_offset(out_matrix, 9,  float) = (yz - wx) * sz
    *ptr_offset(out_matrix, 10, float) = (cast(f64)1.0 - (xx + yy)) * sz
    *ptr_offset(out_matrix, 11, float) = 0.0

    // -------- column 3 (translation)
    *ptr_offset(out_matrix, 12, float) = position.x
    *ptr_offset(out_matrix, 13, float) = position.y
    *ptr_offset(out_matrix, 14, float) = position.z
    *ptr_offset(out_matrix, 15, float) = 1.0

}
build_model_matrix ::fn x64(out_matrix : *f32, position : _vec, q : *f32, scale : _vec) 
{
    x := *ptr_offset(q, 0, f32)
    y := *ptr_offset(q, 1, f32)
    z := *ptr_offset(q, 2, f32)
    w := *ptr_offset(q, 3, f32)

    x2 := x + x
    y2 := y + y
    z2 := z + z

    xx := x * x2
    xy := x * y2
    xz := x * z2
    yy := y * y2
    yz := y * z2
    zz := z * z2
    wx := w * x2
    wy := w * y2
    wz := w * z2

    sx := scale.x
    sy := scale.y
    sz := scale.z

    // -------- column 0 (X axis)
    *ptr_offset(out_matrix, 0,  f32) = (1.0 - (yy + zz)) * sx
    *ptr_offset(out_matrix, 1,  f32) = (xy + wz) * sx
    *ptr_offset(out_matrix, 2,  f32) = (xz - wy) * sx
    *ptr_offset(out_matrix, 3,  f32) = 0.0

    // -------- column 1 (Y axis)
    *ptr_offset(out_matrix, 4,  f32) = (xy - wz) * sy
    *ptr_offset(out_matrix, 5,  f32) = (1.0 - (xx + zz)) * sy
    *ptr_offset(out_matrix, 6,  f32) = (yz + wx) * sy
    *ptr_offset(out_matrix, 7,  f32) = 0.0

    // -------- column 2 (Z axis)
    *ptr_offset(out_matrix, 8,  f32) = (xz + wy) * sz
    *ptr_offset(out_matrix, 9,  f32) = (yz - wx) * sz
    *ptr_offset(out_matrix, 10, f32) = (1.0 - (xx + yy)) * sz
    *ptr_offset(out_matrix, 11, f32) = 0.0

    // -------- column 3 (translation)
    *ptr_offset(out_matrix, 12, f32) = position.x
    *ptr_offset(out_matrix, 13, f32) = position.y
    *ptr_offset(out_matrix, 14, f32) = position.z
    *ptr_offset(out_matrix, 15, f32) = 1.0

}

quaternion64 : struct
{
	v : _vec2
}
quaternion : struct
{
	v : _vec
}
cross_vec2::fn(a : _vec2, b : _vec2) !_vec2
{

	ret :_vec2= ?
	ret.x = a.y * b.z - a.z * b.y
	ret.y = a.z * b.x - a.x * b.z
	ret.z = a.x * b.y - a.y * b.x
	ret.w = 0.0
	return ret;
}
cross_vec::fn(a : _vec, b : _vec) !_vec
{

	ret :_vec= ?
	ret.x = a.y * b.z - a.z * b.y
	ret.y = a.z * b.x - a.x * b.z
	ret.z = a.x * b.y - a.y * b.x
	ret.w = 0.0
	return ret;
}
normalize_vec2::fn x64(a : _vec2) ! _vec2
{
	dot: = _dot(a, a);
	len: = __sqrt2(dot);
	ret:_vec2 = a / len;
	return ret;
}
dot_vec::fn x64(a : _vec, b : _vec) !f32
{
	ret := a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w;
	return ret;
}
normalize_vec::fn x64(a : _vec) ! _vec
{
	dot: = dot_vec(a, a);
	len: = sqrt(dot);
	//__dbg_break
	ret:_vec = a / len;
	return ret;
}
normalize_quaternion::fn x64(out : *_vec, q : _vec) {
  val := q.w*q.w + q.x*q.x + q.y*q.y + q.z*q.z
  mag := sqrt(cast(f32)val)
	if mag == 0.0
	{
		out.x = 1.0
		out.y = 0.0
		out.z = 0.0
		out.w = 0.0
	}
	else
	{
		out.x = q.x/mag
		out.y = q.y/mag
		out.z = q.z/mag
		out.w = q.w/mag
	}
}
create_from_axis_angle::fn(xx:f32, yy:f32, zz:f32, a:f32) ! quaternion
{
	q : quaternion=?
  // Here we calculate the sinf( theta / 2) once for optimization
  factor: = sinf( cast(f32)a / 2.0 );

  // Calculate the x, y and z of the quaternion
  q.v.x = xx * factor;
  q.v.y = yy * factor;
  q.v.z = zz * factor;

  // Calcualte the w value by cos( theta / 2 )
  q.v.w = cosf( cast(f32)a / 2.0 );
	normalize_quaternion(&q.v, q.v)
  return q
}
multiply_quaternions::fn x64(out : *_vec, q1 : _vec, q2 : _vec) {
	out.x = q1.w*q2.x + q1.x*q2.w + q1.y*q2.z - q1.z*q2.y
	out.y = q1.w*q2.y - q1.x*q2.z + q1.y*q2.w + q1.z*q2.x
	out.z = q1.w*q2.z + q1.x*q2.y - q1.y*q2.x + q1.z*q2.w
	out.w = q1.w*q2.w - q1.x*q2.x - q1.y*q2.y - q1.z*q2.z 
}
quaternion_conjugate::fn x64(out : *_vec, q : _vec) { 
    out.x = -q.x
	out.y = -q.y
	out.z = -q.z
	out.w = q.w
}
rotate_vector::fn(out : *_vec, v : _vec, q : _vec) {
	aux : _vec
  normalize_quaternion(&aux, q)
  p :_vec
	p.x = v.x
	p.y = v.y
	p.z = v.z
	p.w = 0.0
  q_conj:_vec
  rotated:_vec
  mul:_vec
	quaternion_conjugate(&q_conj, q);

	multiply_quaternions(&mul, q, p)

  multiply_quaternions(&rotated, mul, q_conj);
  out.x = rotated.x
	out.y = rotated.y
	out.z = rotated.z

}
operator * x64(self : *quaternion, rhs : *quaternion) !quaternion
{
	ret : quaternion = ?

	multiply_quaternions(&ret.v, self.v, rhs.v)
	return ret
}

quat_to_mat4::fn(out: *mat4x4, q: _vec) ! void
{
    xx: f32 = q.x * q.x;
    yy: f32 = q.y * q.y;
    zz: f32 = q.z * q.z;

    xy: f32 = q.x * q.y;
    xz: f32 = q.x * q.z;
    yz: f32 = q.y * q.z;

    wx: f32 = q.w * q.x;
    wy: f32 = q.w * q.y;
    wz: f32 = q.w * q.z;

    // column 0
    out.vals[0]  = 1.0 - 2.0 * (yy + zz);
    out.vals[1]  = 2.0 * (xy + wz);
    out.vals[2]  = 2.0 * (xz - wy);
    out.vals[3]  = 0.0;

    // column 1
    out.vals[4]  = 2.0 * (xy - wz);
    out.vals[5]  = 1.0 - 2.0 * (xx + zz);
    out.vals[6]  = 2.0 * (yz + wx);
    out.vals[7]  = 0.0;

    // column 2
    out.vals[8]  = 2.0 * (xz + wy);
    out.vals[9]  = 2.0 * (yz - wx);
    out.vals[10] = 1.0 - 2.0 * (xx + yy);
    out.vals[11] = 0.0;

    // column 3
    out.vals[12] = 0.0;
    out.vals[13] = 0.0;
    out.vals[14] = 0.0;
    out.vals[15] = 1.0;
}
floorf64::fn(f : f64) ! f64
{
  trunc := cast(s64)f
  if trunc > cast(s64)f
    return cast(f64)(trunc - 1);
  return cast(f64)trunc
}
floori64::fn(f : f64) ! s64
{
  trunc := cast(s64)f
  if trunc > cast(s64)f
    return trunc - 1;
  return trunc
}
minf::fn(a : f64, b : f64) ! f64
{
	ret: = if a < b a else b;
  return ret
}
maxf::fn(a : f64, b : f64) ! f64
{
	ret: = if a > b a else b;
  return ret
}
minval::fn{T}(a : T, b : T) ! T
{
	ret: = if a < b a else b;
  return ret
}
maxval::fn{T}(a : T, b : T) ! T
{
	ret: = if a > b a else b;
  return ret
}
len_vec::fn(a : vector) !float
{
	return __sqrt2(_dot(a, a));
}
operator * x64(self : *quaternion, vec : *_vec) !_vec
{
	ret :_vec
	rotate_vector(&ret, *vec, self.v)
	return ret
}
identity::fn(m : *mat4x4)
{
  memset(m, 0, sizeof(*m))
  m.vals[0] = 1.0
  m.vals[5] = 1.0
  m.vals[10] = 1.0
  m.vals[15] = 1.0

}

fmix32::fn( h:u32)!u32
{
    aux := h >> 16
    h = h ^ aux

    aux = h * 0x85EBCA6B;
    aux = aux >> 13;
    h = aux ^h

    aux = h * 0xC2B2AE35;
    aux = aux * aux
    aux = aux >> 16;
    h = h ^aux
    return h;
}
hash32_triplet::fn(x:u32,  y:u32, z:u32) !u32
{
    
    h :u32= 0;

    aux := x * 0x9E3779B9;
    h = h ^ aux

    aux = y * 0x85EBCA6B;
    h = h ^ aux

    aux = z * 0xC2B2AE35;
    h = h ^ aux

    return fmix32(h);
}
clamp ::fn{T}(v : T, _min :T, _max : T) ! T
{
	if v <= _min return _min;
	if v >= _max return _max;
	return v;
}

normalize_quaternion64::fn x64(out : *vector, q : vector) {
  val := q.w*q.w + q.x*q.x + q.y*q.y + q.z*q.z
  mag := __sqrt2(val)
	if mag == 0.0
	{
		out.x = 1.0
		out.y = 0.0
		out.z = 0.0
		out.w = 0.0
	}
	else
	{
		out.x = q.x/mag
		out.y = q.y/mag
		out.z = q.z/mag
		out.w = q.w/mag
	}
}
create_from_axis_angle::fn(xx:f64, yy:f64, zz:f64, a:f64) ! quaternion64
{
	q : quaternion64=?
  // Here we calculate the sinf( theta / 2) once for optimization
  factor: = sin( a / 2.0 );

  // Calculate the x, y and z of the quaternion64
  q.v.x = xx * factor;
  q.v.y = yy * factor;
  q.v.z = zz * factor;

  // Calcualte the w value by cos( theta / 2 )
  q.v.w = cos( a / 2.0 );
	normalize_quaternion64(&q.v, q.v)
  return q
}
multiply_quaternion64s::fn x64(out : *vector, q1 : vector, q2 : vector) {
	out.x = q1.w*q2.x + q1.x*q2.w + q1.y*q2.z - q1.z*q2.y
	out.y = q1.w*q2.y - q1.x*q2.z + q1.y*q2.w + q1.z*q2.x
	out.z = q1.w*q2.z + q1.x*q2.y - q1.y*q2.x + q1.z*q2.w
	out.w = q1.w*q2.w - q1.x*q2.x - q1.y*q2.y - q1.z*q2.z 
}
quaternion64_conjugate::fn x64(out : *vector, q : vector) { 
    out.x = -q.x
	out.y = -q.y
	out.z = -q.z
	out.w = q.w
}
rotate_vector64::fn(out : *vector, v : vector, q : vector) {
	aux : vector
  normalize_quaternion64(&aux, q)
  p :vector
	p.x = v.x
	p.y = v.y
	p.z = v.z
	p.w = 0.0
  q_conj:vector
  rotated:vector
  mul:vector
	quaternion64_conjugate(&q_conj, q);

	multiply_quaternion64s(&mul, q, p)

  multiply_quaternion64s(&rotated, mul, q_conj);
  out.x = rotated.x
	out.y = rotated.y
	out.z = rotated.z

}
operator * x64(self : *quaternion64, rhs : *quaternion64) !quaternion64
{
	ret : quaternion64 = ?

	multiply_quaternion64s(&ret.v, self.v, rhs.v)
	return ret
}
operator * x64(self : *quaternion64, vec : *vector) !vector
{
	ret :vector
	rotate_vector64(&ret, *vec, self.v)
	return ret
}

mul_mat_vec::fn x64(self : *mat4x4_, vec : _vec2) !_vec2
{
  ret: _vec2;
	aux := *cast(*_vec2)&self.vals[0]
	ret.x = _dot(vec, aux)

	aux = *cast(*_vec2)&self.vals[4]
	ret.y = _dot(vec, aux)

	aux = *cast(*_vec2)&self.vals[8]
	ret.z = _dot(vec, aux)
			
	aux = *cast(*_vec2)&self.vals[12]
	ret.w = _dot(vec, aux)
	return ret;
}
quat_to_mat4::fn(out: *mat4x4_, q: vector) ! void
{
    xx: f64 = q.x * q.x;
    yy: f64 = q.y * q.y;
    zz: f64 = q.z * q.z;

    xy: f64 = q.x * q.y;
    xz: f64 = q.x * q.z;
    yz: f64 = q.y * q.z;

    wx: f64 = q.w * q.x;
    wy: f64 = q.w * q.y;
    wz: f64 = q.w * q.z;

    // column 0
    out.vals[0]  = cast(f64)1.0 - cast(f64)2.0 * (yy + zz);
    out.vals[1]  = cast(f64)2.0 * (xy + wz);
    out.vals[2]  = cast(f64)2.0 * (xz - wy);
    out.vals[3]  = 0.0;

    // column 1
    out.vals[4]  = cast(f64)2.0 * (xy - wz);
    out.vals[5]  = cast(f64)1.0 - cast(f64)2.0 * (xx + zz);
    out.vals[6]  = cast(f64)2.0 * (yz + wx);
    out.vals[7]  = 0.0;

    // column 2
    out.vals[8]  =cast(f64)2.0 * (xz + wy);
    out.vals[9]  =cast(f64)2.0 * (yz - wx);
    out.vals[10] =cast(f64)1.0 - cast(f64)2.0 * (xx + yy);
    out.vals[11] = 0.0;

    // column 3
    out.vals[12] = 0.0;
    out.vals[13] = 0.0;
    out.vals[14] = 0.0;
    out.vals[15] = 1.0;
}
