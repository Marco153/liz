import "../os"

GetMem::fn outsider(size : u64)! *void;

CHUNK_FREE : const s32 = 1;
CHUNK_ALLOCATED : const s32= 4;

str_ln::fn(str :str_lit) !u64
{
	s: = cast(*u8)str;
	
	i:u64 = 0;
	while *ptr_offset(s, i, u8) != 0
	{
		i++;
	}
	return i;
}
heap_hash : struct
{
	inner :struct
	{
		key : *void,
		value : *u8,
	} 
	data : *inner,
}

mem_chunk : struct
{
    next : *mem_chunk,
    prev : *mem_chunk,
    size : u32,
    flags: u32,
    addr : *u8,
}
mem_alloc : struct
{
  name : str_lit
    buffer : *u8,
    head_free : *mem_chunk,
    in_use : heap_hash,
	id : u32,
    all : *mem_chunk,
    probable_unallocated : **mem_chunk,
	chunks_cap :u32,
	hash_table_size : u32,
  mutex : u32
}

BYTES_PER_CHUNK : const s32= 8;
UNALLOCATED_BUFFER_ITEMS : const s32=  8;

debug_break::fn macro()
{
	#if RELEASE == 1
	{
		*ret = __LINE__;
		return;
	}
	else
		__dbg_break;
}

new_ptr::fn macro(type: _expr)
{
	cast(*type)heap_alloc(globals.alloc, sizeof(type))
}
ptr_offset::fn macro(ptr : _expr, offset : _expr, type : _expr)
{
	(cast(*type)(cast(s64)ptr + cast(s64)offset * sizeof(type)))
}
heap_insert_unallocated::fn(alloc : *mem_alloc, a : *mem_chunk)
{
	if a < alloc.all || a > (ptr_offset(alloc.all, alloc.chunks_cap, mem_chunk)) || is_flag_on(a.flags, CHUNK_ALLOCATED)
		return;

	i:u64 = 0;

	while i < UNALLOCATED_BUFFER_ITEMS
	{
		cur: = cast(**mem_chunk) (ptr_offset(alloc.probable_unallocated, i, *mem_chunk));
		if* cur == nil
		{
			*cur = a;
			break;
		}
		i++;
	}
}

assert::fn(val : bool, str : str_lit="", line :str_lit= __SRC_LINE__)
{
  if !val
  {
    //printf("\nassertion failed: {line}\n{str}\n")
    //PrintCallStack()
    __dbg_break
  }
}
ASSERT::fn macro(exp : _expr)
{
	if !(exp)
  {
		__dbg_break;
  }
}
is_flag_off::fn macro(val : _expr, flag : _expr)
{
	((val & (flag)) == 0)
}
is_flag_on::fn macro(val : _expr, flag : _expr)
{
	((val & (flag)) != 0)
}
_own_memset::fn x64(dst : *void, val : u8, sz : u64) !void
{
	ASSERT(cast(u64)dst > 128);
	i:u64 = 0;
	while i < sz
	{
		*ptr_offset(dst, i, u8) = val;
		i++;
	}
}
