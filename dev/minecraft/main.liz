clear_objects_to_draw::fn(g : *game_info, rman : *render_manager)
{

}
draw_depth_buffer::fn(g : *game_info, rman : *render_manager)
{
  glBindFramebuffer(GL_FRAMEBUFFER, g.depth_fbo.fbo.id);
  glViewport(0, 0, cast(s32)g.wnd_width, cast(s32)g.wnd_height)
  glEnable(GL_DEPTH_TEST);
  glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE); // disable color writes
  glClearDepth(1.0f);          // depth clear value (1.0 = far)
  glClear(GL_DEPTH_BUFFER_BIT);
  draw_objects(g, &g.rman)
  glBindFramebuffer(GL_FRAMEBUFFER, 0);
}
draw_offscreen_buffer::fn(g : *game_info, rman : *render_manager)
{
  glBindFramebuffer(GL_FRAMEBUFFER, g.offscreen_fbo.fbo.id);
  glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
  glViewport(0, 0, cast(s32)g.wnd_width, cast(s32)g.wnd_height)
  glEnable(GL_DEPTH_TEST);
  glClearColor(0.5f, 0.2f, 0.4f, 1.0f); // background color
  glClearDepth(1.0f);

  glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
  draw_objects(g, &g.rman)
  glBindFramebuffer(GL_FRAMEBUFFER, 0);
}
draw_toscreen_buffer::fn(g : *game_info, rman : *render_manager)
{
  to_screen_shader := g.to_screen_shader.shader_id
  glViewport(0, 0, cast(s32)g.wnd_width, cast(s32)g.wnd_height)
  //printf("to screen prog {to_screen_shader}\n")
  glUseProgram(to_screen_shader)

  glActiveTexture(GL_TEXTURE0);
  glBindTexture(GL_TEXTURE_2D, g.offscreen_fbo.color_tex.id);

  glActiveTexture(GL_TEXTURE0 + 1);
  glBindTexture(GL_TEXTURE_2D, g.depth_fbo.color_tex.id);

  glActiveTexture(GL_TEXTURE0 + 2);
  glBindTexture(GL_TEXTURE_2D, g.offscreen_fbo.normal_tex.id);

  // set sampler uniform
  glUniform1i(glGetUniformLocation(to_screen_shader, "uScene"), 0);
  glUniform1i(glGetUniformLocation(to_screen_shader, "uDepth"), 1);
  glUniform1i(glGetUniformLocation(to_screen_shader, "uNormal"), 2);
  glDisable(GL_DEPTH_TEST);
  glDisable(GL_CULL_FACE);

  loc := glGetUniformLocation(to_screen_shader, "uNear");
  glUniform1f(loc, g.near_plane);
  loc = glGetUniformLocation(to_screen_shader, "uFar");
  glUniform1f(loc, g.far_plane);

  loc = glGetUniformLocation(to_screen_shader, "sun_color");
  glUniform4f(loc, rman.sun_color.x, rman.sun_color.y, rman.sun_color.z, rman.sun_color.w);
  loc = glGetUniformLocation(to_screen_shader, "sun_dir");
  glUniform4f(loc, rman.sun_dir.x, rman.sun_dir.y, rman.sun_dir.z, rman.sun_dir.w);


  glBindVertexArray(g.empty_vao);
  // draw fullscreen triangle with vertex IDs
  glDrawArrays(GL_TRIANGLES, 0, 3);
  glEnable(GL_CULL_FACE);

}
render::fn(g : *game_info, rman : *render_manager)
{
  aspect := cast(f32)g.wnd_height / cast(f32)g.wnd_width
  g_ubo:global_ubo_uniform=?

  identity(&g_ubo.view)
  perspective(cast(*f32)&g_ubo.proj, 70.0f * (3.14159f / 180.0f), aspect, g.near_plane, g.far_plane)


  draw_depth_buffer(g, rman)

  draw_offscreen_buffer(g, rman)

  draw_toscreen_buffer(g, rman)
}
swap_buffers::fn(g : *game_info)
{
  glfwSwapBuffers(g.wnd)
}
clear_background_color::fn(gptr : *game_info, r : f32, g : f32, b : f32, a : f32)
{
  glClearColor(r, g, b, a)
  glClear(GL_COLOR_BUFFER_BIT)
}
player_mov::fn(g : *game_info, player : *entity, dt_ : f32)
{
  dt:= cast(f64)dt_
  if is_key_held(&g.iman, key_enum.A)
  {
    player.pos.x += dt
  }
}
run_game::fn(g : *game_info)
{
  prev_time : f64=glfwGetTime()
  while true
  {
    dt := cast(f32)(glfwGetTime() - prev_time)

    prev_time = glfwGetTime()

    glfwPollEvents()

    update_cam_rot(g, 0.0f, 0.0f)

    player_mov(g, g.player, dt)

    print_vec2(g.player.pos)

    add_objects_to_draw(g , &g.rman)
    render(g, &g.rman)
    clear_objects_to_draw(g , &g.rman)

    swap_buffers(g)

    io_globals.linear_cur = 0
  }
}

main::fn()
{
  game : game_info

  init_game(&game)

  run_game(&game)
}
