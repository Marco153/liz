add_read_img::fn(g :*game_info, x : s32, z :s32, mip : u8)
{
  if (g.thread_info.work_to_do.used_chunks + 1) >= g.thread_info.work_to_do.total_chunks
    return
  w : work_to_do_info
  w.type = work_to_do_info.CREATE_TEX
  w.CREATE_TEX.x = x
  w.CREATE_TEX.z = z
  w.CREATE_TEX.mip = mip

  sec := ((cast(*u32)g.thread_info.work_to_do.buffer_data)[1])[1]

  printf("adding CREATE_TEX {cast(u32)w.CREATE_TEX.type}, x {w.CREATE_TEX.x}, z {w.CREATE_TEX.z}, mip {w.CREATE_TEX.mip}, sec val {sec}\n")
  linked_add(&g.thread_info.work_to_do, &w, 0)

}
thread :: fn(arg : *void)
{
  thread_info := cast(*thread_work_info)arg
  first := true
  while true
  {

    lock_mutex(&thread_info.work_to_do.mutex)
    cur := thread_info.work_to_do.start
    unlock_mutex(&thread_info.work_to_do.mutex)

    if !cur continue

    //PrintStr("--THREAD: has data\n")

    data := cast(*work_to_do_info)cur.ptr

    io_globals.linear_cur = 0
    on data.type
    {
    work_to_do_info.CREATE_TEX
    {
      mip := data.CREATE_TEX.mip
      x   := data.CREATE_TEX.x
      z   := data.CREATE_TEX.z

      {
        lock_mutex(&thread_info.working_data_texs.mutex)
        defer unlock_mutex(&thread_info.working_data_texs.mutex)
        used := thread_info.working_data_texs.used_chunks
          if (used + 1) >= (thread_info.working_data_texs.total_chunks )
            break;
      }

      tex_lnk := linked_add(&thread_info.working_data_texs, nil, 0)
      printf("##THREAD: x %, z %, mip %, addr %, tex_lnk addr %, ptr addr %,  ptr end %\n", data.CREATE_TEX.x, data.CREATE_TEX.z, data.CREATE_TEX.mip, cast(u64)data, cast(u64)tex_lnk, cast(u64)tex_lnk.ptr, cast(u64)tex_lnk.ptr + sizeof(aux_tex_struct))

      galloc : generic_allocator
      galloc.type = generic_allocator.ITSELF_IS_ADDRESS
      galloc.ITSELF_IS_ADDRESS.addr = tex_lnk.ptr

      f : file

      buffer :[256]u8
      snprintf(buffer, 256, "/home/marco/terrain/mip%/tile_%_%.data", mip, x, z)
      //printf("--THREAD: will read file\n")
      read_file(cast(str_lit)buffer, &f, &galloc)

      fstart := cast(u64)f.data
      fend   := (cast(u64)f.data + f.sz)
      //printf("--THREAD: file read, file addr %, end %\n", fstart, fend)

/*
      start := cast(u64)thread_info.work_to_do.buffer_data
      end   := cast(u64)thread_info.work_to_do.buffer_data + thread_info.work_to_do.total_chunks * sizeof(work_to_do_info)

      printf("--THREAD: wortodo start %, worktodo end %\n", start, end)

      printf("***THREAD: tex start %, tex end %\n", start, end)

      if start > fstart && start < fend
      {
        printf("--THREAD: overrides work_to_do buffer_data\n")

      }

      start = cast(u64)tex_lnk.ptr
      end   = cast(u64)tex_lnk.ptr + sizeof(aux_tex_struct)

      printf("***THREAD: tex start %, tex end %\n", start, end)

      if start > fstart && start < fend
      {
        printf("--THREAD: overrides work_to_do buffer_data\n")

      }
      */





      done : work_done_info
      done.type = work_done_info.DONE_CREATE_TEX
      done.DONE_CREATE_TEX.x = x
      done.DONE_CREATE_TEX.z = z
      done.DONE_CREATE_TEX.mip = mip
      done.DONE_CREATE_TEX.tex_lnk = tex_lnk

      linked_add(&thread_info.work_done, &done, 0)

      linked_remove(&thread_info.work_to_do, cur)

      printf("--THREAD: work done\n")
    }
    default:
    {
      if first
      {
        printf("THREAD: work not recognized {cast(s32)data.type}, addr {cast(u64)data}\n")
        first = false
      }

      //__dbg_break
    }
    }
  }
}
cursor_position_callback::fn(window:*u8, xpos:f64, ypos:f64) {
  g := cast(*game_info)glfwGetWindowUserPointer(window);
  currentTime := glfwGetTime();

  //double deltaTime = currentTime - g.last_time;
  //g.mouse_vel_x = cast(f32)xpos
  if (g.mouse_last_x != 0.0) 
  {
    g.mouse_vel_x = (cast(f32)xpos - g.mouse_last_x);
    g.mouse_vel_y = (cast(f32)ypos - g.mouse_last_y);
  }

  g.mouse_last_x = cast(f32)xpos;
  g.mouse_last_y = cast(f32)ypos;
}
key_callback::fn(window:*u8, _key : u32, scancode : u32, action : u32, mods:u32)
{
  key:= cast(u64)_key

  g := cast(*game_info)glfwGetWindowUserPointer(window);
  iman := &g.iman
  //printf("game:somthing was pressed\n");
  if (action == GLFW_PRESS) {
    //printf("PRESS event\n");
    //printf("key {key}, prev val {&iman.buttons[key]}\n");
    iman.buttons[key] |= (KEY_HELD | KEY_DOWN | KEY_RECENTLY_DOWN);
    //printf("after val {iman.buttons[key]}\n");

    t := cast(f32)glfwGetTime();

    if ((t - iman.time_pressed[key]) < DOUBLE_CLICK_MAX_TIME)
      iman.buttons[key] |= KEY_DOUBLE_CLICK;

    iman.time_pressed[key] = t;
    //printf("PRESS event ended\n");
  } else if (action == GLFW_RELEASE) {
    //printf("RELEASE event\n");
    iman.buttons[key] &= ~KEY_HELD;
    iman.buttons[key] |= KEY_UP;
    // printf("key release(%d) is %d", key, iman.buttons[key]);
    //printf("RELEASE event ended\n");
  }
  else if (action == GLFW_REPEAT) {
    //printf("REPEAT event\n");
    iman.buttons[key] |= KEY_REPEAT;
    //printf("REPEAT event ended\n");
  }
  //printf("game: end of key_callback\n");
}
get_mesh_asset::fn(g : *game_info, name : str_lit)!u64
{
  ret : u64
  i :u64= 0
  ln := str_ln(name)
  ASSERT(ln < 15)
  while i < TOTAL_ASSETS
  {
    cur := ptr_offset(g.assets, i, asset_info)
    if !cur.in_use 
    {
      memcpy(&cur.name, name, 15)
      cur.in_use = true
      cur.MESH.m.asset_idx = cast(u32)i;
      return i
    }
    i++
  }

  printf("mesh asset not found\n")
  __dbg_break

  return  -1
}
get_model_asset::fn(g : *game_info, name : str_lit)!u64
{
  ret : u64
  i :u64= ASSET_MAT_START
  ln := str_ln(name)
  ASSERT(ln < 15)
  while i < TOTAL_ASSETS
  {
    cur := ptr_offset(g.assets, i, asset_info)
    if !cur.in_use 
    {
      memcpy(&cur.name, name, 15)
      cur.in_use = true
      cur.MODEL.mod.asset_idx = cast(u32)i;
      return i
    }
    i++
  }

  __dbg_break

  return  -1
}
get_image_asset::fn(g : *game_info, name : str_lit)!u64
{
  ret : u64
  i :u64= ASSET_MAT_START
  ln := str_ln(name)
  ASSERT(ln < 15)
  while i < TOTAL_ASSETS
  {
    cur := ptr_offset(g.assets, i, asset_info)
    if !cur.in_use 
    {
      memcpy(&cur.name, name, 16)
      cur.in_use = true
      cur.idx = i
      cur.IMAGE.img.asset_idx = cast(u32)i;
      return i
    }
    i++
  }

  __dbg_break

  return  -1
}
get_material_asset::fn(g : *game_info, name : str_lit)!u64
{
  ret : u64
  i :u64= ASSET_MAT_START
  ln := str_ln(name)
  ASSERT(ln < 15)
  while i < TOTAL_ASSETS
  {
    cur := ptr_offset(g.assets, i, asset_info)
    if !cur.in_use 
    {
      memcpy(&cur.name, name, 16)
      cur.in_use = true
      cur.idx = i
      *cast(*u64)&cur.MATERIAL.mat = i
      cur.MATERIAL.mat.asset_idx = cast(u32)i;
      return i
    }
    i++
  }

  __dbg_break

  return  -1
}
create_image_asset::fn(g : *game_info, name : str_lit, desc : *image_desc) ! *image
{
  img_idx := get_image_asset(g, name)
  mat     := ptr_offset(g.assets, img_idx, asset_info)

  create_image(desc, &mat.IMAGE.img)
  return &mat.IMAGE.img
}
glDebugOutput::fn(source   : u32,
    type     : u32,
    id       : u32,
    severity : u32,
    length   : s32,
    message  : *u8,
    userParam: *void
) ! void
{
    // Ignore non-significant messages
    if id == 131169 || id == 131185 || id == 131218 || id == 131204
    {
        return;
    }

    src_str : str_lit;
    type_str : str_lit;
    severity_str : str_lit;

    // ---- source string ----
    get_source_str::fn(src : u32) ! str_lit
    {
        on cast(u32) src
        {
          GL_DEBUG_SOURCE_API               { return "API"; }
          GL_DEBUG_SOURCE_WINDOW_SYSTEM    { return "Window System"; }
          GL_DEBUG_SOURCE_SHADER_COMPILER  { return "Shader Compiler"; }
          GL_DEBUG_SOURCE_THIRD_PARTY      { return "Third Party"; }
          GL_DEBUG_SOURCE_APPLICATION      { return "Application"; }
          default                          { return "Other"; }
        }
    }

    // ---- type string ----
    get_type_str::fn(tp : u32) ! str_lit
    {
        on cast(u32) tp
        {
            GL_DEBUG_TYPE_ERROR               { return "Error"; }
            GL_DEBUG_TYPE_DEPRECATED_BEHAVIOR { return "Deprecated"; }
            GL_DEBUG_TYPE_UNDEFINED_BEHAVIOR  { return "Undefined Behavior"; }
            GL_DEBUG_TYPE_PORTABILITY         { return "Portability"; }
            GL_DEBUG_TYPE_PERFORMANCE         { return "Performance"; }
            GL_DEBUG_TYPE_MARKER              { return "Marker"; }
            default                           { return "Other"; }
        }
    }

    // ---- severity string ----
    get_severity_str::fn(sev : u32) ! str_lit
    {
        on cast(u32) sev
        {
            GL_DEBUG_SEVERITY_HIGH         { return "High"; }
            GL_DEBUG_SEVERITY_MEDIUM       { return "Medium"; }
            GL_DEBUG_SEVERITY_LOW          { return "Low"; }
            GL_DEBUG_SEVERITY_NOTIFICATION { return "Notification"; }
            default                        { return ""; }
        }
    }

    src_str      = get_source_str(source);
    type_str     = get_type_str(type);
    severity_str = get_severity_str(severity);

    printf("[OpenGL DEBUG] {type_str}: {severity_str} ({id}) - {cast(str_lit)message}\n");

    // Break on high severity
    if severity == GL_DEBUG_SEVERITY_HIGH
    {
        __dbg_break
        __dbg_break
        __dbg_break
    }
}
enable_GL_debugging::fn() 
{
  
  flags:u32;
  glGetIntegerv(GL_CONTEXT_FLAGS, &flags);
  if (is_flag_on(flags, GL_CONTEXT_FLAG_DEBUG_BIT)) {
    glEnable(GL_DEBUG_OUTPUT);
    glEnable(GL_DEBUG_OUTPUT_SYNCHRONOUS);
    glDebugMessageCallback(cast(*u8)glDebugOutput, nil);
    glDebugMessageControl(GL_DONT_CARE, GL_DONT_CARE, GL_DONT_CARE, 0, nil,
                          GL_TRUE);
    printf("gl debug enable\n")
  }
}
create_window::fn(g : *game_info, name : str_lit, w : u32, h : u32) ! *u8
{
  glfwWindowHint(CONTEXT_VERSION_MAJOR, 4);
  glfwWindowHint(CONTEXT_VERSION_MINOR, 3);
  glfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_CORE_PROFILE);
  glfwWindowHint(GLFW_OPENGL_DEBUG_CONTEXT, 1);


  return glfwCreateWindow(w, h, name, nil, nil);
}
init_terrain::fn(g : *game_info, trn : *terrain_info)
{
  trn.mip_page_table = cast(**u32)get_buffer_from_generic_alloc(&g.main_galloc, 8 * 8)

  trn.mip_page_table[0] = cast(*u32)&trn.page_table64
  trn.mip_page_table[1] = cast(*u32)&trn.page_table32
  trn.mip_page_table[2] = cast(*u32)&trn.page_table16
  trn.mip_page_table[3] = cast(*u32)&trn.page_table8
  trn.mip_page_table[4] = cast(*u32)&trn.page_table4
  trn.mip_page_table[5] = cast(*u32)&trn.page_table2
  trn.mip_page_table[6] = cast(*u32)&trn.page_table1

  trn.mip_img_table = cast(**void)get_buffer_from_generic_alloc(&g.main_galloc, 8 * 8)

  trn.mip_img_table[0] = g.page_map_img64;
  trn.mip_img_table[1] = g.page_map_img32;
  trn.mip_img_table[2] = g.page_map_img16;
  trn.mip_img_table[3] = g.page_map_img8;
  trn.mip_img_table[4] = g.page_map_img4;
  trn.mip_img_table[5] = g.page_map_img2;
  trn.mip_img_table[6] = g.page_map_img1;

  memset(trn.page_table64, cast(u8)-1, trn.page_table64.len * sizeof(u32))
  memset(trn.page_table32, cast(u8)-1, trn.page_table32.len * sizeof(u32))
  memset(trn.page_table16, cast(u8)-1, trn.page_table16.len * sizeof(u32))
  memset(trn.page_table8,  cast(u8)-1, trn.page_table8.len * sizeof(u32))
  memset(trn.page_table4,  cast(u8)-1, trn.page_table4.len * sizeof(u32))
  memset(trn.page_table2,  cast(u8)-1, trn.page_table2.len * sizeof(u32))
  memset(trn.page_table1,  cast(u8)-1, trn.page_table1.len * sizeof(u32))
}
create_ents::fn(g : *game_info)
{
  g.player = instantiate_ent(&g.ent_man)
  g.trn    = instantiate_ent(&g.ent_man)

  g.trn.trn = new_ptr(terrain_info)

  printf("ents created\n")

}
create_shader_and_depth_only::fn(g : *game_info, t_vs_file : *file, t_fs_file : *file,mat : *material_info, alloc : *generic_allocator)
{
  empty_frag_str := "#version 330 core \nvoid main()\{\};";
  empty_frag_strln := cast(u32)str_ln(empty_frag_str)

  mat.offscreen_shader = compile_shader_complete(t_vs_file.data, cast(u32)t_vs_file.sz, t_fs_file.data, cast(u32)t_fs_file.sz)
  mat.depth_shader     = compile_shader_complete(t_vs_file.data, cast(u32)t_vs_file.sz, empty_frag_str, empty_frag_strln)

  //printf("offscreen id {mat.offscreen_shader.id}, depth id {mat.depth_shader.id}\n")

  mat.model_uniform = create_uniform_buffer(sizeof(model_ubo))


  mat.total_attrs = 1
  mat.attrs = cast(*attribute_desc_shader)get_buffer_from_generic_alloc(alloc, mat.total_attrs * sizeof(attribute_desc_shader))

  cur := ptr_offset(mat.attrs, 0, attribute_desc_shader)
  cur.desc.sem    = vertex_semantic.POSITION
  cur.desc.format = vertex_format.F32x3

  enable_shader_uniforms(mat, &g.global_ubo)
}
create_trn_mesh::fn(g : *game_info, name : str_lit, mesh : **mesh_info, sh_contract : *shader_mesh_contract)
{
  io_globals.linear_cur = 0

  path := "{to_cstr(&g.work_dir, nil)}/models/{name}"
  idx := get_mesh_asset(g, name)

  printf("test\n")
  asset := ptr_offset(g.assets, idx, asset_info)

  load_model(path, &asset.MESH.m, &g.rman, &g.main_galloc)

  *mesh = &asset.MESH.m

  
  create_shader_mesh_contract(*mesh, g.terrain2_shader, sh_contract)

  printf("model: {name}, vbufid {mesh.attrs[0].buffer.gl.id}, contract {sh_contract.vao}, index sz {mesh.index_buffer.size}, index id {mesh.index_buffer.gl.id}\n")

}
