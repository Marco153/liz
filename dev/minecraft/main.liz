import "../glfw";
import "../opengl";
import "../os";

thread :: fn(arg : *void)
{
  while true
  {
    PrintStr("on thread \n")
  }
}

main::fn()
{
  io_globals.linear_max = 1024
  io_globals.linear_cur = 0
  io_globals.linear_data = cast(*u8)GetMem(io_globals.linear_max)
  
  printf("on main: {io_globals.linear_max}\n")
  PrintStr("mincraft start\n")
  res := glfwInit()
  if res == 0 __dbg_break


  glfwWindowHint(CONTEXT_VERSION_MAJOR, 4);
  glfwWindowHint(CONTEXT_VERSION_MINOR, 3);
  glfwWindowHint(OPENGL_PROFILE, OPENGL_CORE_PROFILE);
  glfwWindowHint(OPENGL_DEBUG_CONTEXT, 1);

  wnd := glfwCreateWindow(1000, 1000, "Hello World", nil, nil);
  if wnd == nil __dbg_break

  glfwMakeContextCurrent(wnd)

  ret := glewInit()

  if ret != 0 __dbg_break

  th := create_thread(thread, nil)

  while true
  {
    glfwSwapBuffers(wnd)
    PrintStr("on loop\n")
  }
}
