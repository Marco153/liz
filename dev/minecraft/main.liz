init_shaders::fn(g : *game_info)
{
#if RENDER_API == OPENGL
{
  glGenVertexArrays(1, &g.empty_vao);
}
  
  galloc :generic_allocator
  galloc.type = generic_allocator.HEAP_ALLOC
  galloc.HEAP_ALLOC.alloc = g.alloc

  t_vs_file:file
  t_fs_file:file

  read_file("{to_cstr(&g.work_dir, nil)}/builtin_materials/chunk_vs.glsl", &t_vs_file, nil)
  read_file("{to_cstr(&g.work_dir, nil)}/builtin_materials/chunk_fs.glsl", &t_fs_file, nil)

  mat_idx := get_material_asset(g, "chunk")
  mat := ptr_offset(g.assets, mat_idx, asset_info)

  create_shader_and_depth_only(g, &t_vs_file, &t_fs_file, &mat.MATERIAL.mat, &g.main_galloc)

  g.terrain_shader = &mat.MATERIAL.mat



  read_file("{to_cstr(&g.work_dir, nil)}/builtin_materials/trn2vs.glsl", &t_vs_file, nil)
  read_file("{to_cstr(&g.work_dir, nil)}/builtin_materials/trn2fs.glsl", &t_fs_file, nil)

  mat_idx = get_material_asset(g, "trn")
  mat = ptr_offset(g.assets, mat_idx, asset_info)




  create_shader_and_depth_only(g, &t_vs_file, &t_fs_file, &mat.MATERIAL.mat, &g.main_galloc)

  g.terrain2_shader = &mat.MATERIAL.mat

  //printf("trn shader addr {cast(u64) g.terrain2_shader}, offscreen id {g.terrain2_shader.offscreen_shader.id}, depth id {g.terrain2_shader.depth_shader.id}\n")

  io_globals.linear_cur = 0

  to_screen_vs:file
  to_screen_fs:file

  read_file("{to_cstr(&g.work_dir, nil)}/builtin_materials/to_screen_vs.glsl", &to_screen_vs, nil)
  read_file("{to_cstr(&g.work_dir, nil)}/builtin_materials/to_screen_fs.glsl", &to_screen_fs, nil)

  mat_idx = get_material_asset(g, "to_screen")
  mat = ptr_offset(g.assets, mat_idx, asset_info)

  mat.MATERIAL.mat.offscreen_shader     = compile_shader_complete(to_screen_vs.data, cast(u32)to_screen_vs.sz, to_screen_fs.data, cast(u32)to_screen_fs.sz)
  g.to_screen_shader = &mat.MATERIAL.mat

  init_terrain_shader(g)

  //printf("to screen prog {g.to_screen_shader.offscreen_shader.id}\n")
}
init_images::fn(g : *game_info)
{
  f : file

  read_file("/home/marco/terrain/empty.data", &f, &g.main_galloc)
  desc:image_desc


  desc.width      = CHUNK_SIZE
  desc.height     = CHUNK_SIZE
  desc.mip_levels = 1
  desc.format     = image_format.R16
  desc.usage      = image_usage.STORAGE
  desc.data       = f.data
  desc.type       = image_type.TEX_2D

  empty_data := f.data;
  g.empty_chunk_img_data = empty_data

  g.empty_chunk_img = create_image_asset(g, "empty_ch", &desc)

  desc.width      = CHUNK_SIZE
  desc.height     = CHUNK_SIZE
  desc.mip_levels = 1
  desc.format     = image_format.R16
  desc.usage      = image_usage.STORAGE
  desc.depth      = TOTAL_TEXS_IN_MAP
  desc.data       = nil
  desc.type       = image_type.TEX_2D_ARRAY
  printf("creating tex map\n")
  g.tex_map_img = create_image_asset(g, "tex_map", &desc)

  aux_buffer := get_buffer_from_generic_alloc(nil, 64 * 64 * 4)

  memset(aux_buffer, cast(u8)-1, 64 * 64 * 4)

  desc.width      = 64
  desc.height     = 64
  desc.mip_levels = 1
  desc.format     = image_format.R32I
  desc.usage      = image_usage.STORAGE
  desc.data       = aux_buffer
  desc.type       = image_type.TEX_2D
  printf("creating page map 64\n")
  g.page_map_img64 = create_image_asset(g, "page_map", &desc)

  desc.width      = 32
  desc.height     = 32
  printf("creating page map\n")
  g.page_map_img32 = create_image_asset(g, "page_map32", &desc)

  desc.width      = 16
  desc.height     = 16
  printf("creating page map\n")
  g.page_map_img16 = create_image_asset(g, "page_map16", &desc)


  desc.width      = 8
  desc.height     = 8
  printf("creating page map\n")
  g.page_map_img8 = create_image_asset(g, "page_map8", &desc)


  desc.width      = 4
  desc.height     = 4
  printf("creating page map\n")
  g.page_map_img4 = create_image_asset(g, "tex_map4", &desc)

  desc.width      = 2
  desc.height     = 2
  printf("creating page map\n")
  g.page_map_img2 = create_image_asset(g, "tex_map2", &desc)

  desc.width      = 1
  desc.height     = 1
  printf("creating page map\n")
  g.page_map_img1 = create_image_asset(g, "tex_map1", &desc)

  update_image_layer(g.tex_map_img, 0, empty_data)

}


init_game::fn(g : *game_info)
{
  g.snap_cam = true
  io_globals.linear_alloc_mutex = create_mutex()
  io_globals.linear_max = 1024 * 32
  io_globals.linear_cur = 0
  io_globals.linear_data = cast(*u8)GetMem(io_globals.linear_max)
  printf("on main: {io_globals.linear_max}\n")
  PrintStr("mincraft start\n")

  InitMemAlloc(&g.main_alloc, 2900000)

  InitMemAlloc(&g.names_alloc, 1000)

  g.alloc = &g.main_alloc

  g.main_galloc.type = generic_allocator.HEAP_ALLOC
  g.main_galloc.HEAP_ALLOC.alloc = &g.main_alloc

  sz_a := cast(u32)sizeof(asset_info) * TOTAL_ASSETS
  g.assets = cast(*asset_info)heap_alloc(g.alloc, sz_a)
  memset(g.assets, 0, sz_a)

  aux := get_cwd() + "/dev"
  build_string(&aux, &g.work_dir, &g.main_galloc)

  printf("work dir is {to_cstr(&g.work_dir, nil)}")


  res := glfwInit()
  if res == 0 __dbg_break

  g.wnd_width  = 1000
  g.wnd_height = 1000
  g.wnd = create_window(g, "minecraft", g.wnd_width, g.wnd_height)

  if g.wnd == nil __dbg_break

  glfwMakeContextCurrent(g.wnd)



  ret := glewInit()

  if ret != 0 __dbg_break

  enable_GL_debugging();

  g.global_ubo = create_uniform_buffer(sizeof(global_ubo_uniform))

  th := create_thread(thread, &g.thread_info)

  init_shaders(g)


  init_ent_man(&g.ent_man, &g.main_galloc)

  create_ents(g)

  init_render_man(&g.rman, &g.main_galloc, 64)

  init_models(g)

  create_framebuffers(&g.depth_fbo.fbo.id, 
    &g.offscreen_fbo.fbo.id, 
    &g.depth_fbo.color_tex.id, 
    &g.offscreen_fbo.normal_tex.id, 
    &g.offscreen_fbo.color_tex.id, cast(s32)g.wnd_width, cast(s32)g.wnd_height)


  g.cam_rot.x = 0.0
  g.cam_rot.y = 0.0
  g.cam_rot.z = 0.0
  g.cam_rot.w = 1.0

  g.up.y = 1.0

  glfwSetWindowUserPointer(g.wnd, g)

  glfwSetKeyCallback(g.wnd, cast(u64)key_callback)
  glfwSetCursorPosCallback(g.wnd, cast(u64)cursor_position_callback)

  g.near_plane = 0.1
  g.far_plane = 16000.0

  g.player.forward.z = -1.0

  g.mouse_sense_x = 2.0
  g.mouse_sense_y = 2.0

  g.cam_pos.x = cast(f64)TERRAIN_SIZE / 2.0
  g.cam_pos.y = 0.2
  g.cam_pos.z = cast(f64)TERRAIN_SIZE / 2.0

  init_thread_work(&g.thread_info, &g.main_galloc)

  
  sdesc :sampler_desc
  sdesc.min_filter = filter.NEAREST;
  sdesc.mag_filter = filter.NEAREST;
  sdesc.wrap_u = wrap.REPEAT;
  sdesc.wrap_v = wrap.REPEAT;

  create_sampler(&sdesc, &g.rman.nearest_sampler)

  sdesc.min_filter = filter.LINEAR;
  sdesc.mag_filter = filter.LINEAR;
  create_sampler(&sdesc, &g.rman.linear_sampler)


  init_images(g)

  g.trn.trn.tex_map_img = g.tex_map_img

  init_terrain(g, g.trn.trn)

  check_and_add_terrain_chunks(g, g.trn.trn, g.cam_pos, 0)
  check_and_add_terrain_chunks(g, g.trn.trn, g.cam_pos, 1)
  check_and_add_terrain_chunks(g, g.trn.trn, g.cam_pos, 2)
  check_and_add_terrain_chunks(g, g.trn.trn, g.cam_pos, 3)
  check_and_add_terrain_chunks(g, g.trn.trn, g.cam_pos, 4)
  check_and_add_terrain_chunks(g, g.trn.trn, g.cam_pos, 5)
  check_and_add_terrain_chunks(g, g.trn.trn, g.cam_pos, 6)

}

update_cam_rot::fn(g : *game_info, rx : f32, ry : f32, rz : f32)
{
  base_fw :_vec = _vec{0.0f, 0.0f, -1.0f}
  base_up :_vec = _vec{0.0f, 1.0f,  0.0f}
  base_rt :_vec = _vec{1.0f, 0.0f,  0.0f}

  crot :quaternion
  crot.v = g.cam_rot

  // --- yaw (world space)
  q_yaw := create_from_axis_angle(0.0f,1.0f,0.0f, rx)
  rot1  := q_yaw

  // --- get camera right after yaw
  cam_fw :_vec
  cam_rt :_vec
  rotate_vector(&cam_fw, base_fw, rot1.v)
  rotate_vector(&cam_rt, base_rt, rot1.v)

  // --- pitch (local space)
  q_pitch := create_from_axis_angle(base_rt.x, base_rt.y, base_rt.z, ry)
  new_rot := q_pitch * rot1

  rotate_vector(&g.cam_fw, cam_fw, q_pitch.v)

  normalize_quaternion(&new_rot.v, new_rot.v)
  g.cam_rot = new_rot.v

  g.cam_fw.x *= -1.0
  g.cam_fw.y *= -1.0
}


draw_objects::fn(g : *game_info, rman : *render_manager, g_ubo : *global_ubo_uniform, depth_only : bool)
{

  for i in 0..cast(s64)rman.cur_draws
  {
    cur := ptr_offset(rman.draws, i, draw_info);

    
    on cur.type
    {
    draw_info.OBJECT
    {
      //printf("2: trn shader addr {cast(u64) g.terrain2_shader}, offscreen id {g.terrain2_shader.offscreen_shader.id}, depth id {g.terrain2_shader.depth_shader.id}\n")
      id := cur.OBJECT.mat.offscreen_shader.id

      asset := ptr_offset(g.assets, cur.OBJECT.mat.asset_idx, asset_info)
      if depth_only
      {
        bind_shader(rman, &cur.OBJECT.mat.depth_shader)
      }
      else
      {
        bind_shader(rman, &cur.OBJECT.mat.offscreen_shader)
      }
      bind_contract(rman, &cur.OBJECT.sh_contract)
      //printf("draw mesh vbufid {cur.OBJECT.mesh.attrs[0].buffer.gl.id}, contract {cur.OBJECT.sh_contract.vao} index {cur.OBJECT.mesh.index_buffer.size}, index id {cur.OBJECT.mesh.index_buffer.gl.id}\n")

        
      m_ubo : model_ubo=?
      m_ubo.chunk_sz = cur.OBJECT.chunk_sz
      m_ubo.trn_sz = cur.OBJECT.trn_sz

      build_model_matrix(cast(*f32)&m_ubo.model_mat, cur.OBJECT.pos, cast(*f32)&cur.OBJECT.rot, cur.OBJECT.sz)
      //identity(&model_mat)

      update_uniform_buffer(&g.global_ubo, g_ubo, sizeof(*g_ubo), 0)

      update_uniform_buffer(&cur.OBJECT.mat.model_uniform, &m_ubo.model_mat, sizeof(model_ubo), 1)

      for t in 0..cast(s64)cur.OBJECT.total_texs
      {
        bind_texture(&g.rman, &cur.OBJECT.texs[cast(u64)t], cast(u32)t)
      }
      
      ASSERT(cur.OBJECT.mesh != nil)
      draw_object_indexed(rman, &cur.OBJECT.mesh.index_buffer)
      
    }
    draw_info.CHUNK
    {

    }
    default
    {
      __dbg_break
    }
    }
  }
}
add_trn_chunk_to_draw::fn(g : *game_info, rman : *render_manager, ch : *chunk_info, ch_sz:f32, mod : *model_info, mip : u8)
{
  cur := ptr_offset(rman.draws, rman.cur_draws, draw_info)
  
  cur.type = draw_info.OBJECT
  cur.OBJECT.pos = cast(_vec)(g.trn.trn.prev_player_pos - g.cam_pos)
  //print_vec2(g.trn.trn.prev_player_pos)
  cur.OBJECT.sz.x = ch_sz
  cur.OBJECT.sz.y = ch_sz
  cur.OBJECT.sz.z = ch_sz

  cur.OBJECT.rot.x = 0.0;
  cur.OBJECT.rot.y = 0.0;
  cur.OBJECT.rot.z = 0.0;
  cur.OBJECT.rot.w = 1.0;

  cur.OBJECT.chunk_sz = cast(u32)cast(s32)(ch_sz * 2.0)
  cur.OBJECT.trn_sz = TERRAIN_SIZE

  cur.OBJECT.sh_contract = mod.contract
  cur.OBJECT.mesh = mod.mesh

  texs := get_textures(&g.rman, 2)

  texs[0].img  = g.tex_map_img
  texs[0].samp = &g.rman.nearest_sampler
  mip_clamp := clamp(mip, 0, 6)
  texs[1].img  = cast(*image)g.trn.trn.mip_img_table[cast(u64)mip_clamp]
  /*
  if mip == 0
    texs[1].img  = g.page_map_img64;
  else if mip == 1
    texs[1].img  = g.page_map_img32;
  else if mip == 2
    texs[1].img  = g.page_map_img16;
  else if mip == 3
    texs[1].img  = g.page_map_img8;
  else
    texs[1].img  = g.page_map_img4;
    */
  texs[1].samp = &g.rman.nearest_sampler

  cur.OBJECT.texs = texs
  cur.OBJECT.total_texs = 2

  asset := ptr_offset(g.assets, g.terrain2_shader.asset_idx, asset_info)
  cur.OBJECT.mat = g.terrain2_shader

  ASSERT(g.terrain2_shader != nil)

  rman.cur_draws++
  ASSERT(rman.cur_draws < rman.max_draws)

}
add_objects_to_draw::fn(g : *game_info, rman : *render_manager)
{
  start_sz := 64.0f
  mod := &g.chunk_128;
  for i in 0..MIP_LEVELS
  {
    if (start_sz * 2.0f) > cast(f32)TERRAIN_SIZE
      return;
    add_trn_chunk_to_draw(g, rman, &g.trn.trn.chunks[0], start_sz, mod, cast(u8)i)
    start_sz *= 2.0
    mod = &g.chunk_128_patched
  }
}
clear_objects_to_draw::fn(g : *game_info, rman : *render_manager)
{
  rman.cur_draws = 0
}
draw_depth_buffer::fn(g : *game_info, rman : *render_manager, g_ubo : *global_ubo_uniform)
{
  glBindFramebuffer(GL_FRAMEBUFFER, g.depth_fbo.fbo.id);
  glViewport(0, 0, cast(s32)g.wnd_width, cast(s32)g.wnd_height)
  glEnable(GL_DEPTH_TEST);
  glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE); // disable color writes
  glClearDepth(1.0f);          // depth clear value (1.0 = far)
  glClear(GL_DEPTH_BUFFER_BIT);
  draw_objects(g, &g.rman, g_ubo, true)
  glBindFramebuffer(GL_FRAMEBUFFER, 0);
}
draw_offscreen_buffer::fn(g : *game_info, rman : *render_manager, g_ubo : *global_ubo_uniform)
{
  glBindFramebuffer(GL_FRAMEBUFFER, g.offscreen_fbo.fbo.id);
  glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
  glViewport(0, 0, cast(s32)g.wnd_width, cast(s32)g.wnd_height)
  glEnable(GL_DEPTH_TEST);
  glClearColor(0.5f, 0.2f, 0.4f, 1.0f); // background color
  glClearDepth(1.0f);

  glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
  draw_objects(g, &g.rman, g_ubo, false)
  glBindFramebuffer(GL_FRAMEBUFFER, 0);
}
draw_toscreen_buffer::fn(g : *game_info, rman : *render_manager)
{
  to_screen_shader := g.to_screen_shader.offscreen_shader.id
  glViewport(0, 0, cast(s32)g.wnd_width, cast(s32)g.wnd_height)
  //printf("to screen prog {to_screen_shader}\n")
  glUseProgram(to_screen_shader)

  glActiveTexture(GL_TEXTURE0);
  glBindTexture(GL_TEXTURE_2D, g.offscreen_fbo.color_tex.id);

  glActiveTexture(GL_TEXTURE0 + 1);
  glBindTexture(GL_TEXTURE_2D, g.depth_fbo.color_tex.id);

  glActiveTexture(GL_TEXTURE0 + 2);
  glBindTexture(GL_TEXTURE_2D, g.offscreen_fbo.normal_tex.id);

  // set sampler uniform
  glUniform1i(glGetUniformLocation(to_screen_shader, "uScene"), 0);
  glUniform1i(glGetUniformLocation(to_screen_shader, "uDepth"), 1);
  glUniform1i(glGetUniformLocation(to_screen_shader, "uNormal"), 2);
  glDisable(GL_DEPTH_TEST);
  glDisable(GL_CULL_FACE);

  loc := glGetUniformLocation(to_screen_shader, "uNear");
  glUniform1f(loc, g.near_plane);
  loc = glGetUniformLocation(to_screen_shader, "uFar");
  glUniform1f(loc, g.far_plane);

  loc = glGetUniformLocation(to_screen_shader, "sun_color");
  glUniform4f(loc, rman.sun_color.x, rman.sun_color.y, rman.sun_color.z, rman.sun_color.w);
  loc = glGetUniformLocation(to_screen_shader, "sun_dir");
  glUniform4f(loc, rman.sun_dir.x, rman.sun_dir.y, rman.sun_dir.z, rman.sun_dir.w);


  glBindVertexArray(g.empty_vao);
  // draw fullscreen triangle with vertex IDs
  glDrawArrays(GL_TRIANGLES, 0, 3);
  glEnable(GL_CULL_FACE);

}
render::fn(g : *game_info, rman : *render_manager)
{
  aspect := cast(f32)g.wnd_height / cast(f32)g.wnd_width
  g_ubo:global_ubo_uniform=?

  identity(&g_ubo.view)
  identity(&g_ubo.proj)
  perspective(cast(*f32)&g_ubo.proj, 40.0f * (3.14159f / 180.0f), aspect, g.near_plane, g.far_plane)

  g_ubo.snap_posx = cast(s32)g.cam_pos.x
  g_ubo.snap_posy = cast(s32)g.cam_pos.y
  g_ubo.snap_posz = cast(s32)g.cam_pos.z
  
  zero:_vec
  //zero.z = -5.0

  build_view_matrix_inverse(cast(*f32)&g_ubo.view, zero, cast(*f32)&g.cam_rot)
  //quat_to_mat4(&g_ubo.view, g.cam_rot)

  draw_depth_buffer(g, rman, &g_ubo)

  draw_offscreen_buffer(g, rman, &g_ubo)

  glPolygonMode(GL_FRONT_AND_BACK, GL_FILL)
  draw_toscreen_buffer(g, rman)
}
swap_buffers::fn(g : *game_info)
{
  glfwSwapBuffers(g.wnd)
}
clear_background_color::fn(gptr : *game_info, r : f32, g : f32, b : f32, a : f32)
{
  glClearColor(r, g, b, a)
  glClear(GL_COLOR_BUFFER_BIT)
}
player_mov::fn(g : *game_info, player : *entity, dt_ : f32)
{
  dt:= cast(f64)dt_
  speed := 5.0

  
  cam_fw := g.cam_fw
  cam_right := cast(vector)cross_vec(g.up, cam_fw)

  if is_key_held(&g.iman, key_enum.SHIFT)
  {
    speed *= 128.0
  }

  if is_key_held(&g.iman, key_enum.E)
  {
    //printf("A\n")
    g.cam_pos.y += dt * speed
  }
  if is_key_held(&g.iman, key_enum.Q)
  {
    //printf("D\n")
    g.cam_pos.y -= dt * speed
  }
  if is_key_held(&g.iman, key_enum.A)
  {
    //printf("A\n")
    g.cam_pos += cam_right * dt * speed
  }
  if is_key_held(&g.iman, key_enum.D)
  {
    //printf("D\n")
    g.cam_pos -= cam_right * dt * speed
  }
  if is_key_held(&g.iman, key_enum.W)
  {
    g.cam_pos += cast(vector)cam_fw * dt * speed

  }
  if is_key_held(&g.iman, key_enum.S)
  {
    g.cam_pos -= cast(vector)cam_fw * dt * speed
  }
}

end_frame::fn(g:*game_info)
{
  g.mouse_last_x = 0.0
  g.mouse_last_y = 0.0
  g.mouse_vel_x = 0.0
  g.mouse_vel_y = 0.0

  g.rman.cur_texs = 0
}
input_logic::fn(g : *game_info)
{

  if is_key_down(&g.iman, key_enum.F1)
  {
    g.rman.wireframe = !g.rman.wireframe
  }
  if is_key_down(&g.iman, key_enum.F3)
  {
    g.snap_cam = !g.snap_cam
  }
  if is_key_down(&g.iman, key_enum.F2)
  {
    if g.cursor_hidden
    {
      show_cursor(g.wnd)
    }
    else
    {
      disable_cursor(g.wnd)
    }
    g.cursor_hidden = !g.cursor_hidden
  }

  if is_key_down(&g.iman, key_enum.F1)
  {
    x := (g.cam_pos.x) / cast(f64)CHUNK_SIZE
    z := (g.cam_pos.z) / cast(f64)CHUNK_SIZE


    w : work_to_do_info
    w.type = work_to_do_info.CREATE_TEX
    w.CREATE_TEX.x = cast(s32)x
    w.CREATE_TEX.z = cast(s32)z
    w.CREATE_TEX.mip = 0

    printf("will add work\n")
    linked_add(&g.thread_info.work_to_do, &w, 0)
    printf("work added\n")
  }
}
check_work_done::fn(g : *game_info)
{
  thread_info := &g.thread_info

  trn := g.trn.trn
  
  while true
  {
    lock_mutex(&thread_info.work_done.mutex)
    cur := thread_info.work_done.start
    unlock_mutex(&thread_info.work_done.mutex)

    if !cur return

    data := cast(*work_done_info)cur.ptr

    on *data
    {
    work_done_info.DONE_CREATE_TEX
    {
      xs := data.DONE_CREATE_TEX.x
      zs := data.DONE_CREATE_TEX.z
      x := cast(f64)data.DONE_CREATE_TEX.x
      z := cast(f64)data.DONE_CREATE_TEX.z
      mip := data.DONE_CREATE_TEX.mip
      tex_lnk := data.DONE_CREATE_TEX.tex_lnk
      mul := 1 << mip
      div := (CHUNK_SIZE * cast(s32)mul)

      cam_idx_x := g.cam_pos.x / cast(f64)div
      cam_idx_z := g.cam_pos.z / cast(f64)div

      diff_x := x - cam_idx_x
      diff_z := z - cam_idx_z

      diff_x += 1.0
      diff_z += 1.0

      diff_x_i := cast(s32)diff_x
      diff_z_i := cast(s32)diff_z

      printf("diffx {diff_x_i}, diffy {diff_z_i}\n")

      defer linked_remove(&thread_info.work_done, cur)
      defer linked_remove(&thread_info.working_data_texs, tex_lnk)
      if (diff_x_i < 0 || diff_z_i < 0 || diff_x_i > 2 || diff_z_i > 2)
      {
        printf("THREAD: chunk lies outside of player pos window\n")
        break;
      }

      
      idx := get_and_assign_image_to_tex_map(g.trn.trn, xs, zs, mip, tex_lnk.ptr)

      pages := &g.trn.trn.page_table64
      mip_clamp := clamp(mip, 0, 6)

      w := TERRAIN_SIZE / div
      page_idx := cast(u64)(xs + zs * w)
      pages[page_idx] = cast(u32)idx
      img := cast(*image)g.trn.trn.mip_img_table[cast(u64)mip_clamp]

      update_image(&g.rman, img, pages);

      printf("&we have done create tex, x {xs}, z {zs}, mip {mip_clamp}, idx {idx}, page_idx {page_idx}\n")
    }
    default
    {
      printf("work done not recognized {data.type}\n")
      __dbg_break
      __dbg_break
      __dbg_break

    }
    }
  }
}
 
check_and_add_terrain_chunks::fn(g : *game_info, trn : *terrain_info, player_pos : vector, mip : u8)
{
  /*
  if mip == 5 {
    __dbg_break
    __dbg_break
    __dbg_break
  }
  */

  mip_clamp := clamp(mip, 0, 6)
  pages := g.trn.trn.mip_page_table[cast(u64)mip_clamp]

  mul := 1 << mip
  div := (CHUNK_SIZE * cast(s32)mul)
  w := TERRAIN_SIZE / div

  pos := player_pos / cast(f64)div
  px := cast(s32)pos.x
  pz := cast(s32)pos.z

  start_x := px - 1
  start_z := pz - 1
  max_x := px + 2
  max_z := pz + 2


  max_ch_sz := TERRAIN_SIZE / CHUNK_SIZE

  start_x = clamp(start_x, 0, w - 1)
  start_z = clamp(start_z, 0, w - 1)
  max_x   = clamp(max_x, 0, w - 1)
  max_z   = clamp(max_z, 0, w - 1)


  printf("start_x {start_x}, start_z {start_z}, max_x {max_x}, max_z {max_z}, w {w}, mul {mul}, div {div}\n")

  if w == 1
  {
    add_read_img(g, cast(s32)0, cast(s32)0, mip);
    return
  }
  if mip == 5
  {
    add_read_img(g, cast(s32)0, cast(s32)0, mip);
    add_read_img(g, cast(s32)1, cast(s32)0, mip);
    add_read_img(g, cast(s32)0, cast(s32)1, mip);
    add_read_img(g, cast(s32)1, cast(s32)1, mip);
    return
  }



  for z in start_z..max_z
  {
    for x in start_x..max_x
    {
      val := pages[cast(u64)(x + z * w)]

      should_add := false
      if val == -1
      {
        should_add = true;
      }
      else
      {
        chunk_val := trn.tex_map[cast(u64)val]
        chunk_val.in_use = false

        if (chunk_val.x == x && chunk_val.z == z && chunk_val.mip == mip) == false
        {
          should_add = true
        }
      }
      if should_add
      {
        add_read_img(g, cast(s32)x, cast(s32)z, mip);
      }
    }
  }
}
update_terrain_chunks::fn(g : *game_info, trn : *terrain_info, player_pos : vector)
{
  if !g.snap_cam return 
  p := trn.prev_player_pos - player_pos
  p.y = 0.0
  l := len_vec(p)
  if l > cast(f64)(CHUNK_SIZE / 4)
  {
    trn.prev_player_pos.x = cast(f64)cast(s64)player_pos.x
    trn.prev_player_pos.z = cast(f64)cast(s64)player_pos.z
    trn.prev_player_pos.y = 0.0

/*
    check_and_add_terrain_chunks(g, g.trn.trn, g.cam_pos, 0)
    check_and_add_terrain_chunks(g, g.trn.trn, g.cam_pos, 1)
    check_and_add_terrain_chunks(g, g.trn.trn, g.cam_pos, 2)
    check_and_add_terrain_chunks(g, g.trn.trn, g.cam_pos, 3)
    check_and_add_terrain_chunks(g, g.trn.trn, g.cam_pos, 4)
    */
  }

}
run_game::fn(g : *game_info)
{
  prev_time : f64=glfwGetTime()
  //disable_cursor(g.wnd)
  //glfwSetInputMode(g.wnd, GLFW_RAW_MOUSE_MOTION, 1);
  //g.cursor_hidden = true

  first_frame := true
  while glfwWindowShouldClose(g.wnd) == 0
  {
    dt := cast(f32)(glfwGetTime() - prev_time)

    check_work_done(g)

    prev_time = glfwGetTime()

    glfwPollEvents()

    input_logic(g)

    
    update_terrain_chunks(g, g.trn.trn, g.cam_pos)

    g.cam_euler_rot.x += g.mouse_vel_x * 0.01 * g.mouse_sense_x
    g.cam_euler_rot.y += g.mouse_vel_y * 0.01 * g.mouse_sense_y

    update_cam_rot(g, g.cam_euler_rot.x, g.cam_euler_rot.y, g.cam_euler_rot.z)

    player_mov(g, g.player, dt)

    print_vec2(g.cam_pos)

    add_objects_to_draw(g , &g.rman)
    render(g, &g.rman)
    clear_objects_to_draw(g , &g.rman)

    swap_buffers(g)

    end_frame(g)
    
    clear_keys(&g.iman)

    io_globals.linear_cur = 0

    first_frame = false

  }
}

main::fn()
{

  test : u64= 6
  expected : u64= 6
  game : game_info

  init_game(&game)

  run_game(&game)
}
