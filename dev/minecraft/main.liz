framebuffer_handle:struct
{
#if RENDER_API == OPENGL
{
  id : u32
}
}
texture_handle:struct
{
#if RENDER_API == OPENGL
{
  id : u32
}
}

framebuffer_info:struct
{
  fbo : framebuffer_handle
  color_tex : texture_handle
  normal_tex : texture_handle
}

game_info:struct
{
  wnd:*u8
  alloc : *mem_alloc
  main_alloc : mem_alloc
  names_alloc : mem_alloc
  work_dir : string

  empty_vao : u32

  main_galloc : generic_allocator

  assets : *asset_info

  ent_man:entity_manager

  rman : render_manager

  cam_pos : vector
  cam_rot : _vec

  up : _vec
  player : *entity
  trn : *entity

  offscreen_fbo : framebuffer_info
  depth_fbo : framebuffer_info

  wnd_width : u32, 
  wnd_height : u32

  terrain_shader   : *material_info
  to_screen_shader : *material_info

  global_ubo : uniform_buffer

  near_plane : f32
  far_plane : f32
  iman : input_manager


  //chunk_128 : 

}
key_callback::fn(window:*u8, _key : u32, scancode : u32, action : u32, mods:u32)
{
  key:= cast(u64)_key

  g := cast(*game_info)glfwGetWindowUserPointer(window);
  iman := &g.iman
  //printf("game:somthing was pressed\n");
  if (action == GLFW_PRESS) {
    //printf("PRESS event\n");
    //printf("key {key}, prev val {&iman.buttons[key]}\n");
    iman.buttons[key] |= (KEY_HELD | KEY_DOWN | KEY_RECENTLY_DOWN);
    //printf("after val {iman.buttons[key]}\n");

    t := cast(f32)glfwGetTime();

    if ((t - iman.time_pressed[key]) < DOUBLE_CLICK_MAX_TIME)
      iman.buttons[key] |= KEY_DOUBLE_CLICK;

    iman.time_pressed[key] = t;
    //printf("PRESS event ended\n");
  } else if (action == GLFW_RELEASE) {
    //printf("RELEASE event\n");
    iman.buttons[key] &= ~KEY_HELD;
    iman.buttons[key] |= KEY_UP;
    // printf("key release(%d) is %d", key, iman.buttons[key]);
    //printf("RELEASE event ended\n");
  }
  else if (action == GLFW_REPEAT) {
    //printf("REPEAT event\n");
    iman.buttons[key] |= KEY_REPEAT;
    //printf("REPEAT event ended\n");
  }
  //printf("game: end of key_callback\n");
}
get_mesh_asset::fn(g : *game_info, name : str_lit)!u64
{
  ret : u64
  i :u64= 0
  ln := str_ln(name)
  ASSERT(ln < 15)
  while i < TOTAL_ASSETS
  {
    cur := ptr_offset(g.assets, i, asset_info)
    if !cur.in_use 
    {
      memcpy(&cur.name, name, 15)
      cur.in_use = true
      cur.MODEL.mod.asset_idx = cast(u32)i;
      return i
    }
    i++
  }

  __dbg_break

  return  -1
}
get_model_asset::fn(g : *game_info, name : str_lit)!u64
{
  ret : u64
  i :u64= ASSET_MAT_START
  ln := str_ln(name)
  ASSERT(ln < 15)
  while i < TOTAL_ASSETS
  {
    cur := ptr_offset(g.assets, i, asset_info)
    if !cur.in_use 
    {
      memcpy(&cur.name, name, 15)
      cur.in_use = true
      cur.MODEL.mod.asset_idx = cast(u32)i;
      return i
    }
    i++
  }

  __dbg_break

  return  -1
}
get_material_asset::fn(g : *game_info, name : str_lit)!u64
{
  ret : u64
  i :u64= ASSET_MAT_START
  ln := str_ln(name)
  ASSERT(ln < 15)
  while i < TOTAL_ASSETS
  {
    cur := ptr_offset(g.assets, i, asset_info)
    if !cur.in_use 
    {
      memcpy(&cur.name, name, 15)
      cur.in_use = true
      cur.MATERIAL.mat.asset_idx = cast(u32)i;
      return i
    }
    i++
  }

  __dbg_break

  return  -1
}

create_window::fn(g : *game_info, name : str_lit, w : u32, h : u32) ! *u8
{
  glfwWindowHint(CONTEXT_VERSION_MAJOR, 4);
  glfwWindowHint(CONTEXT_VERSION_MINOR, 3);
  glfwWindowHint(OPENGL_PROFILE, OPENGL_CORE_PROFILE);
  glfwWindowHint(OPENGL_DEBUG_CONTEXT, 1);

  return glfwCreateWindow(w, h, name, nil, nil);
}
init_terrain::fn(g : *game_info, trn : *terrain_info)
{
  bsz := cast(u32)8 * 6
  trn.ubo = create_storage_buffer(bsz)


  block: [6]u64
  val : u64

  make_face_val(val, 0, 0, 0, FACE_RIGHT, 15, 0, 0)
  block[0] = val

  make_face_val(val, 0, 0, 0, FACE_LEFT, 15, 0, 0)
  block[1] = val

  make_face_val(val, 0, 0, 0, FACE_UP, 15, 0, 0)
  block[2] = val

  make_face_val(val, 0, 0, 0, FACE_DOWN, 15, 0, 0)
  block[3] = val

  make_face_val(val, 0, 0, 0, FACE_FORWARD, 15, 0, 0)
  block[4] = val

  make_face_val(val, 0, 0, 0, FACE_BACK, 15, 0, 0)
  block[5] = val


  create_storage_buffer(bsz)


}
create_ents::fn(g : *game_info)
{
  g.player = instantiate_ent(&g.ent_man)
  g.trn    = instantiate_ent(&g.ent_man)

  g.trn.trn = new_ptr(terrain_info)

  printf("ents created\n")

}
create_shader_and_depth_only::fn(g : *game_info, t_vs_file : *file, t_fs_file : *file,mat : *material_info)
{
  empty_frag_str := "#version 330 core \nvoid main()\{\};";
  empty_frag_strln := cast(u32)str_ln(empty_frag_str)

  mat.shader_id     = compile_shader_complete(t_vs_file.data, cast(u32)t_vs_file.sz, t_fs_file.data, cast(u32)t_fs_file.sz)
  mat.depth_only_id = compile_shader_complete(t_vs_file.data, cast(u32)t_vs_file.sz, empty_frag_str, empty_frag_strln)

  mat.model_uniform = create_uniform_buffer(64)
}
init_models::fn(g : *game_info)
{
  path := "{to_cstr(&g.work_dir, nil)}/models/_128.fbx"
  idx := get_mesh_asset(g, path)

  asset := ptr_offset(g.assets, idx, asset_info)

  load_model(path, &asset.MESH.m, &g.main_galloc)
}
init_shaders::fn(g : *game_info)
{
#if RENDER_API == OPENGL
{
  glGenVertexArrays(1, &g.empty_vao);
}
  
  galloc :generic_allocator
  galloc.type = generic_allocator.HEAP_ALLOC
  galloc.HEAP_ALLOC.alloc = g.alloc

  t_vs_file:file
  t_fs_file:file

  read_file("{to_cstr(&g.work_dir, nil)}/builtin_materials/chunk_vs.glsl", &t_vs_file, nil)
  read_file("{to_cstr(&g.work_dir, nil)}/builtin_materials/chunk_fs.glsl", &t_fs_file, nil)

  mat_idx := get_material_asset(g, "chunk")
  mat := ptr_offset(g.assets, mat_idx, asset_info)

  create_shader_and_depth_only(g, &t_vs_file, &t_fs_file, &mat.MATERIAL.mat)

  g.terrain_shader = &mat.MATERIAL.mat

  io_globals.linear_cur = 0

  to_screen_vs:file
  to_screen_fs:file

  read_file("{to_cstr(&g.work_dir, nil)}/builtin_materials/to_screen_vs.glsl", &to_screen_vs, nil)
  read_file("{to_cstr(&g.work_dir, nil)}/builtin_materials/to_screen_fs.glsl", &to_screen_fs, nil)

  mat_idx = get_material_asset(g, "to_screen")
  mat = ptr_offset(g.assets, mat_idx, asset_info)

  mat.MATERIAL.mat.shader_id     = compile_shader_complete(to_screen_vs.data, cast(u32)to_screen_vs.sz, to_screen_fs.data, cast(u32)to_screen_fs.sz)
  g.to_screen_shader = &mat.MATERIAL.mat

  printf("to screen prog {g.to_screen_shader.shader_id}\n")
}

init_game::fn(g : *game_info)
{
  io_globals.linear_max = 1024 * 32
  io_globals.linear_cur = 0
  io_globals.linear_data = cast(*u8)GetMem(io_globals.linear_max)
  printf("on main: {io_globals.linear_max}\n")
  PrintStr("mincraft start\n")

  InitMemAlloc(&g.main_alloc, 16000)

  InitMemAlloc(&g.names_alloc, 1000)

  g.alloc = &g.main_alloc

  g.main_galloc.type = generic_allocator.HEAP_ALLOC
  g.main_galloc.HEAP_ALLOC.alloc = &g.main_alloc

  g.assets = cast(*asset_info)heap_alloc(g.alloc, sizeof(asset_info) * TOTAL_ASSETS)

  aux := get_cwd() + "/dev"
  build_string(&aux, &g.work_dir, &g.main_galloc)

  printf("work dir is {to_cstr(&g.work_dir, nil)}")


  res := glfwInit()
  if res == 0 __dbg_break

  g.wnd_width  = 1000
  g.wnd_height = 1000
  g.wnd = create_window(g, "minecraft", g.wnd_width, g.wnd_height)

  if g.wnd == nil __dbg_break

  glfwMakeContextCurrent(g.wnd)


  ret := glewInit()

  if ret != 0 __dbg_break

  th := create_thread(thread, nil)

  init_shaders(g)

  //init_models(g)

  init_ent_man(&g.ent_man, &g.main_galloc)

  create_ents(g)

  init_render_man(&g.rman, &g.main_galloc, 64)

  create_framebuffers(&g.depth_fbo.fbo.id, 
    &g.offscreen_fbo.fbo.id, 
    &g.depth_fbo.color_tex.id, 
    &g.offscreen_fbo.normal_tex.id, 
    &g.offscreen_fbo.color_tex.id, cast(s32)g.wnd_width, cast(s32)g.wnd_height)

  g.global_ubo = create_uniform_buffer(sizeof(global_ubo_uniform))

  g.cam_rot.w = 1.0

  g.up.y = 1.0

  glfwSetWindowUserPointer(g.wnd, g)

  glfwSetKeyCallback(g.wnd, cast(u64)key_callback)

  g.near_plane = 0.1
  g.far_plane = 500.0

}
update_cam_rot::fn(g : *game_info, dx : f32, dy : f32)
{
  up := g.up
  right :_vec
  right.x = 1.0
  crot :quaternion
  crot.v = g.cam_rot

  cam_right :_vec
  rotate_vector(&cam_right, crot.v, right)

  yaw := create_from_axis_angle(up.x, up.y, up.z, dx)
  pitch := create_from_axis_angle(cam_right.x, cam_right.y, cam_right.z, dy)

  g.cam_rot = (yaw * pitch * crot).v
}
