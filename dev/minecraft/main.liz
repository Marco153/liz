framebuffer_handle:struct
{
#if RENDER_API == OPENGL
{
  id : u32
}
}
texture_handle:struct
{
#if RENDER_API == OPENGL
{
  id : u32
}
}

framebuffer_info:struct
{
  fbo : framebuffer_handle
  color_tex : texture_handle
  normal_tex : texture_handle
}

game_info:struct
{
  wnd:*u8
  alloc : *mem_alloc
  main_alloc : mem_alloc
  names_alloc : mem_alloc
  work_dir : string

  empty_vao : u32

  main_galloc : generic_allocator

  assets : *asset_info

  ent_man:entity_manager

  rman : render_manager

  cam_pos : vector
  cam_rot : _vec

  up : _vec
  player : *entity
  trn : *entity

  offscreen_fbo : framebuffer_info
  depth_fbo : framebuffer_info

  wnd_width : u32, 
  wnd_height : u32

  terrain_shader   : *material_info
  to_screen_shader : *material_info

  terrain2_shader : *material_info

  global_ubo : uniform_buffer

  near_plane : f32
  far_plane : f32
  iman : input_manager


  chunk_128 : model_info
  chunk_64 : model_info
  chunk_32 : model_info
  chunk_16 : model_info

  mouse_vel_x: f32
  mouse_vel_y: f32
  mouse_last_x: f32
  mouse_last_y: f32

  mouse_sense_x :f32
  mouse_sense_y :f32
}
cursor_position_callback::fn(window:*u8, xpos:f64, ypos:f64) {
  g := cast(*game_info)glfwGetWindowUserPointer(window);
  currentTime := glfwGetTime();

  //double deltaTime = currentTime - g.last_time;
  //g.mouse_vel_x = cast(f32)xpos
  if (g.mouse_last_x != 0.0) 
  {
    g.mouse_vel_x = (cast(f32)xpos - g.mouse_last_x);
    g.mouse_vel_y = (cast(f32)ypos - g.mouse_last_y);
  }

  g.mouse_last_x = cast(f32)xpos;
  g.mouse_last_y = cast(f32)ypos;
}
key_callback::fn(window:*u8, _key : u32, scancode : u32, action : u32, mods:u32)
{
  key:= cast(u64)_key

  g := cast(*game_info)glfwGetWindowUserPointer(window);
  iman := &g.iman
  //printf("game:somthing was pressed\n");
  if (action == GLFW_PRESS) {
    //printf("PRESS event\n");
    //printf("key {key}, prev val {&iman.buttons[key]}\n");
    iman.buttons[key] |= (KEY_HELD | KEY_DOWN | KEY_RECENTLY_DOWN);
    //printf("after val {iman.buttons[key]}\n");

    t := cast(f32)glfwGetTime();

    if ((t - iman.time_pressed[key]) < DOUBLE_CLICK_MAX_TIME)
      iman.buttons[key] |= KEY_DOUBLE_CLICK;

    iman.time_pressed[key] = t;
    //printf("PRESS event ended\n");
  } else if (action == GLFW_RELEASE) {
    //printf("RELEASE event\n");
    iman.buttons[key] &= ~KEY_HELD;
    iman.buttons[key] |= KEY_UP;
    // printf("key release(%d) is %d", key, iman.buttons[key]);
    //printf("RELEASE event ended\n");
  }
  else if (action == GLFW_REPEAT) {
    //printf("REPEAT event\n");
    iman.buttons[key] |= KEY_REPEAT;
    //printf("REPEAT event ended\n");
  }
  //printf("game: end of key_callback\n");
}
get_mesh_asset::fn(g : *game_info, name : str_lit)!u64
{
  ret : u64
  i :u64= 0
  ln := str_ln(name)
  ASSERT(ln < 15)
  while i < TOTAL_ASSETS
  {
    cur := ptr_offset(g.assets, i, asset_info)
    if !cur.in_use 
    {
      memcpy(&cur.name, name, 15)
      cur.in_use = true
      cur.MESH.m.asset_idx = cast(u32)i;
      return i
    }
    i++
  }

  __dbg_break

  return  -1
}
get_model_asset::fn(g : *game_info, name : str_lit)!u64
{
  ret : u64
  i :u64= ASSET_MAT_START
  ln := str_ln(name)
  ASSERT(ln < 15)
  while i < TOTAL_ASSETS
  {
    cur := ptr_offset(g.assets, i, asset_info)
    if !cur.in_use 
    {
      memcpy(&cur.name, name, 15)
      cur.in_use = true
      cur.MODEL.mod.asset_idx = cast(u32)i;
      return i
    }
    i++
  }

  __dbg_break

  return  -1
}
get_material_asset::fn(g : *game_info, name : str_lit)!u64
{
  ret : u64
  i :u64= ASSET_MAT_START
  ln := str_ln(name)
  ASSERT(ln < 15)
  while i < TOTAL_ASSETS
  {
    cur := ptr_offset(g.assets, i, asset_info)
    if !cur.in_use 
    {
      memcpy(&cur.name, name, 16)
      cur.in_use = true
      cur.idx = i
      *cast(*u64)&cur.MATERIAL.mat = i
      cur.MATERIAL.mat.asset_idx = cast(u32)i;
      return i
    }
    i++
  }

  __dbg_break

  return  -1
}
glDebugOutput::fn(source   : u32,
    type     : u32,
    id       : u32,
    severity : u32,
    length   : s32,
    message  : *u8,
    userParam: *void
) ! void
{
    // Ignore non-significant messages
    if id == 131169 || id == 131185 || id == 131218 || id == 131204
    {
        return;
    }

    src_str : str_lit;
    type_str : str_lit;
    severity_str : str_lit;

    // ---- source string ----
    get_source_str::fn(src : u32) ! str_lit
    {
        on cast(u32) src
        {
          GL_DEBUG_SOURCE_API               { return "API"; }
          GL_DEBUG_SOURCE_WINDOW_SYSTEM    { return "Window System"; }
          GL_DEBUG_SOURCE_SHADER_COMPILER  { return "Shader Compiler"; }
          GL_DEBUG_SOURCE_THIRD_PARTY      { return "Third Party"; }
          GL_DEBUG_SOURCE_APPLICATION      { return "Application"; }
          default                          { return "Other"; }
        }
    }

    // ---- type string ----
    get_type_str::fn(tp : u32) ! str_lit
    {
        on cast(u32) tp
        {
            GL_DEBUG_TYPE_ERROR               { return "Error"; }
            GL_DEBUG_TYPE_DEPRECATED_BEHAVIOR { return "Deprecated"; }
            GL_DEBUG_TYPE_UNDEFINED_BEHAVIOR  { return "Undefined Behavior"; }
            GL_DEBUG_TYPE_PORTABILITY         { return "Portability"; }
            GL_DEBUG_TYPE_PERFORMANCE         { return "Performance"; }
            GL_DEBUG_TYPE_MARKER              { return "Marker"; }
            default                           { return "Other"; }
        }
    }

    // ---- severity string ----
    get_severity_str::fn(sev : u32) ! str_lit
    {
        on cast(u32) sev
        {
            GL_DEBUG_SEVERITY_HIGH         { return "High"; }
            GL_DEBUG_SEVERITY_MEDIUM       { return "Medium"; }
            GL_DEBUG_SEVERITY_LOW          { return "Low"; }
            GL_DEBUG_SEVERITY_NOTIFICATION { return "Notification"; }
            default                        { return ""; }
        }
    }

    src_str      = get_source_str(source);
    type_str     = get_type_str(type);
    severity_str = get_severity_str(severity);

    printf("[OpenGL DEBUG] {type_str}: {severity_str} ({id}) - {message}\n",
        type_str,
        severity_str,
        id,
        message);

    // Break on high severity
    if severity == GL_DEBUG_SEVERITY_HIGH
    {
        __dbg_break
    }
}
enable_GL_debugging::fn() 
{
  
  flags:u32;
  glGetIntegerv(GL_CONTEXT_FLAGS, &flags);
  if (is_flag_on(flags, GL_CONTEXT_FLAG_DEBUG_BIT)) {
    glEnable(GL_DEBUG_OUTPUT);
    glEnable(GL_DEBUG_OUTPUT_SYNCHRONOUS);
    glDebugMessageCallback(cast(*u8)glDebugOutput, nil);
    glDebugMessageControl(GL_DONT_CARE, GL_DONT_CARE, GL_DONT_CARE, 0, nil,
                          GL_TRUE);
    printf("gl debug enable\n")
  }
}
create_window::fn(g : *game_info, name : str_lit, w : u32, h : u32) ! *u8
{
  glfwWindowHint(CONTEXT_VERSION_MAJOR, 4);
  glfwWindowHint(CONTEXT_VERSION_MINOR, 3);
  glfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_CORE_PROFILE);
  glfwWindowHint(GLFW_OPENGL_DEBUG_CONTEXT, 1);


  return glfwCreateWindow(w, h, name, nil, nil);
}
init_terrain::fn(g : *game_info, trn : *terrain_info)
{
  bsz := cast(u32)8 * 6
  trn.ubo = create_storage_buffer(bsz)


  block: [6]u64
  val : u64

  make_face_val(val, 0, 0, 0, FACE_RIGHT, 15, 0, 0)
  block[0] = val

  make_face_val(val, 0, 0, 0, FACE_LEFT, 15, 0, 0)
  block[1] = val

  make_face_val(val, 0, 0, 0, FACE_UP, 15, 0, 0)
  block[2] = val

  make_face_val(val, 0, 0, 0, FACE_DOWN, 15, 0, 0)
  block[3] = val

  make_face_val(val, 0, 0, 0, FACE_FORWARD, 15, 0, 0)
  block[4] = val

  make_face_val(val, 0, 0, 0, FACE_BACK, 15, 0, 0)
  block[5] = val


  create_storage_buffer(bsz)


}
create_ents::fn(g : *game_info)
{
  g.player = instantiate_ent(&g.ent_man)
  g.trn    = instantiate_ent(&g.ent_man)

  g.trn.trn = new_ptr(terrain_info)

  printf("ents created\n")

}
create_shader_and_depth_only::fn(g : *game_info, t_vs_file : *file, t_fs_file : *file,mat : *material_info, alloc : *generic_allocator)
{
  empty_frag_str := "#version 330 core \nvoid main()\{\};";
  empty_frag_strln := cast(u32)str_ln(empty_frag_str)

  mat.offscreen_shader = compile_shader_complete(t_vs_file.data, cast(u32)t_vs_file.sz, t_fs_file.data, cast(u32)t_fs_file.sz)
  mat.depth_shader     = compile_shader_complete(t_vs_file.data, cast(u32)t_vs_file.sz, empty_frag_str, empty_frag_strln)

  //printf("offscreen id {mat.offscreen_shader.id}, depth id {mat.depth_shader.id}\n")

  mat.model_uniform = create_uniform_buffer(64)


  mat.total_attrs = 1
  mat.attrs = cast(*attribute_desc_shader)get_buffer_from_generic_alloc(alloc, mat.total_attrs * sizeof(attribute_desc_shader))

  cur := ptr_offset(mat.attrs, 0, attribute_desc_shader)
  cur.desc.sem    = vertex_semantic.POSITION
  cur.desc.format = vertex_format.F32x3

  enable_shader_uniforms(mat, &g.global_ubo)
}
create_trn_mesh::fn(g : *game_info, name : str_lit, mesh : **mesh_info, sh_contract : *shader_mesh_contract)
{
  io_globals.linear_cur = 0

  path := "{to_cstr(&g.work_dir, nil)}/models/{name}"
  idx := get_mesh_asset(g, name)

  asset := ptr_offset(g.assets, idx, asset_info)

  load_model(path, &asset.MESH.m, &g.rman, &g.main_galloc)

  *mesh = &asset.MESH.m

  create_shader_mesh_contract(*mesh, g.terrain2_shader, sh_contract)

  printf("model: {name}, vbufid {mesh.attrs[0].buffer.gl.id}, contract {sh_contract.vao}, index sz {mesh.index_buffer.size}, index id {mesh.index_buffer.gl.id}\n")

}
init_models::fn(g : *game_info)
{
  create_trn_mesh(g, "_128.fbx", &g.chunk_128.mesh, &g.chunk_128.contract)
  create_trn_mesh(g, "_64.fbx", &g.chunk_64.mesh, &g.chunk_64.contract)
  create_trn_mesh(g, "_32.fbx", &g.chunk_32.mesh, &g.chunk_32.contract)
  create_trn_mesh(g, "_16.fbx", &g.chunk_16.mesh, &g.chunk_16.contract)

  verts := &g.chunk_128.mesh.attrs[0].buffer
  //inds := g.chunk_128.mesh.index_buffer.data
}
init_shaders::fn(g : *game_info)
{
#if RENDER_API == OPENGL
{
  glGenVertexArrays(1, &g.empty_vao);
}
  
  galloc :generic_allocator
  galloc.type = generic_allocator.HEAP_ALLOC
  galloc.HEAP_ALLOC.alloc = g.alloc

  t_vs_file:file
  t_fs_file:file

  read_file("{to_cstr(&g.work_dir, nil)}/builtin_materials/chunk_vs.glsl", &t_vs_file, nil)
  read_file("{to_cstr(&g.work_dir, nil)}/builtin_materials/chunk_fs.glsl", &t_fs_file, nil)

  mat_idx := get_material_asset(g, "chunk")
  mat := ptr_offset(g.assets, mat_idx, asset_info)

  create_shader_and_depth_only(g, &t_vs_file, &t_fs_file, &mat.MATERIAL.mat, &g.main_galloc)

  g.terrain_shader = &mat.MATERIAL.mat



  read_file("{to_cstr(&g.work_dir, nil)}/builtin_materials/trn2vs.glsl", &t_vs_file, nil)
  read_file("{to_cstr(&g.work_dir, nil)}/builtin_materials/trn2fs.glsl", &t_fs_file, nil)

  mat_idx = get_material_asset(g, "trn")
  mat = ptr_offset(g.assets, mat_idx, asset_info)


  create_shader_and_depth_only(g, &t_vs_file, &t_fs_file, &mat.MATERIAL.mat, &g.main_galloc)

  g.terrain2_shader = &mat.MATERIAL.mat

  //printf("trn shader addr {cast(u64) g.terrain2_shader}, offscreen id {g.terrain2_shader.offscreen_shader.id}, depth id {g.terrain2_shader.depth_shader.id}\n")

  io_globals.linear_cur = 0

  to_screen_vs:file
  to_screen_fs:file

  read_file("{to_cstr(&g.work_dir, nil)}/builtin_materials/to_screen_vs.glsl", &to_screen_vs, nil)
  read_file("{to_cstr(&g.work_dir, nil)}/builtin_materials/to_screen_fs.glsl", &to_screen_fs, nil)

  mat_idx = get_material_asset(g, "to_screen")
  mat = ptr_offset(g.assets, mat_idx, asset_info)

  mat.MATERIAL.mat.offscreen_shader     = compile_shader_complete(to_screen_vs.data, cast(u32)to_screen_vs.sz, to_screen_fs.data, cast(u32)to_screen_fs.sz)
  g.to_screen_shader = &mat.MATERIAL.mat

  //printf("to screen prog {g.to_screen_shader.offscreen_shader.id}\n")
}

init_game::fn(g : *game_info)
{
  io_globals.linear_max = 1024 * 32
  io_globals.linear_cur = 0
  io_globals.linear_data = cast(*u8)GetMem(io_globals.linear_max)
  printf("on main: {io_globals.linear_max}\n")
  PrintStr("mincraft start\n")

  InitMemAlloc(&g.main_alloc, 1600000)

  InitMemAlloc(&g.names_alloc, 1000)

  g.alloc = &g.main_alloc

  g.main_galloc.type = generic_allocator.HEAP_ALLOC
  g.main_galloc.HEAP_ALLOC.alloc = &g.main_alloc

  sz_a := cast(u32)sizeof(asset_info) * TOTAL_ASSETS
  g.assets = cast(*asset_info)heap_alloc(g.alloc, sz_a)
  memset(g.assets, 0, sz_a)

  aux := get_cwd() + "/dev"
  build_string(&aux, &g.work_dir, &g.main_galloc)

  printf("work dir is {to_cstr(&g.work_dir, nil)}")


  res := glfwInit()
  if res == 0 __dbg_break

  g.wnd_width  = 1000
  g.wnd_height = 1000
  g.wnd = create_window(g, "minecraft", g.wnd_width, g.wnd_height)

  if g.wnd == nil __dbg_break

  glfwMakeContextCurrent(g.wnd)



  ret := glewInit()

  if ret != 0 __dbg_break

  enable_GL_debugging();

  g.global_ubo = create_uniform_buffer(sizeof(global_ubo_uniform))

  th := create_thread(thread, nil)

  init_shaders(g)


  init_ent_man(&g.ent_man, &g.main_galloc)

  create_ents(g)

  init_render_man(&g.rman, &g.main_galloc, 64)

  init_models(g)

  create_framebuffers(&g.depth_fbo.fbo.id, 
    &g.offscreen_fbo.fbo.id, 
    &g.depth_fbo.color_tex.id, 
    &g.offscreen_fbo.normal_tex.id, 
    &g.offscreen_fbo.color_tex.id, cast(s32)g.wnd_width, cast(s32)g.wnd_height)


  g.cam_rot.w = 1.0

  g.up.y = 1.0

  glfwSetWindowUserPointer(g.wnd, g)

  glfwSetKeyCallback(g.wnd, cast(u64)key_callback)
  glfwSetCursorPosCallback(g.wnd, cast(u64)cursor_position_callback)

  g.near_plane = 0.1
  g.far_plane = 500.0

  g.player.forward.z = 1.0

  g.mouse_sense_x = 4.0
  g.mouse_sense_y = 4.0
}
update_cam_rot::fn(g : *game_info, dx : f32, dy : f32)
{
  up := g.up
  right :_vec
  right.x = 1.0
  crot :quaternion
  crot.v = g.cam_rot

  cam_right :_vec
  rotate_vector(&cam_right, right, crot.v)

  yaw := create_from_axis_angle(up.x, up.y, up.z, dx)
  pitch := create_from_axis_angle(cam_right.x, cam_right.y, cam_right.z, dy)

  g.cam_rot = (yaw * pitch * crot).v


	normalize_quaternion(&g.cam_rot, g.cam_rot)
}
draw_objects::fn(g : *game_info, rman : *render_manager, g_ubo : *global_ubo_uniform, depth_only : bool)
{

  for i in 0..cast(s64)rman.cur_draws
  {
    cur := ptr_offset(rman.draws, i, draw_info);

    
    on cur.type
    {
    draw_info.OBJECT
    {
      //printf("2: trn shader addr {cast(u64) g.terrain2_shader}, offscreen id {g.terrain2_shader.offscreen_shader.id}, depth id {g.terrain2_shader.depth_shader.id}\n")
      id := cur.OBJECT.mat.offscreen_shader.id

      asset := ptr_offset(g.assets, cur.OBJECT.mat.asset_idx, asset_info)
      if depth_only
      {
        bind_shader(rman, &cur.OBJECT.mat.depth_shader)
      }
      else
      {
        bind_shader(rman, &cur.OBJECT.mat.offscreen_shader)
      }
      bind_contract(rman, &cur.OBJECT.sh_contract)
      //printf("draw mesh vbufid {cur.OBJECT.mesh.attrs[0].buffer.gl.id}, contract {cur.OBJECT.sh_contract.vao} index {cur.OBJECT.mesh.index_buffer.size}, index id {cur.OBJECT.mesh.index_buffer.gl.id}\n")

      model_mat : mat4x4=?

      build_model_matrix(cast(*f32)&model_mat, cur.OBJECT.pos, cast(*f32)&cur.OBJECT.rot, cur.OBJECT.sz)

      update_uniform_buffer(&g.global_ubo, g_ubo, sizeof(*g_ubo), 0)

      update_uniform_buffer(&cur.OBJECT.mat.model_uniform, &model_mat, sizeof(model_mat), 1)

      
      ASSERT(cur.OBJECT.mesh != nil)
      draw_object_indexed(rman, &cur.OBJECT.mesh.index_buffer)
      
    }
    draw_info.CHUNK
    {

    }
    default
    {
      __dbg_break
    }
    }
  }
}
add_trn_chunk_to_draw::fn(g : *game_info, rman : *render_manager, ch : *chunk_info)
{
  cur := ptr_offset(rman.draws, rman.cur_draws, draw_info)
  
  cur.type = draw_info.OBJECT
  cur.OBJECT.pos = cast(_vec)(ch.pos - g.cam_pos)
  //print_vec2(g.cam_pos)
  //print_vec(cur.OBJECT.pos)
  cur.OBJECT.sz.x = 1.0
  cur.OBJECT.sz.y = 1.0
  cur.OBJECT.sz.z = 1.0

  cur.OBJECT.rot.x = 0.0;
  cur.OBJECT.rot.y = 0.0;
  cur.OBJECT.rot.z = 0.0;
  cur.OBJECT.rot.w = 1.0;

  mod := &g.chunk_64
  if is_key_held(&g.iman, key_enum.A)
  {
    mod = &g.chunk_128
  }

  cur.OBJECT.sh_contract = mod.contract
  cur.OBJECT.mesh = mod.mesh

  asset := ptr_offset(g.assets, g.terrain2_shader.asset_idx, asset_info)
  cur.OBJECT.mat = g.terrain2_shader

  ASSERT(g.terrain2_shader != nil)

  rman.cur_draws++
  ASSERT(rman.cur_draws < rman.max_draws)

}
add_objects_to_draw::fn(g : *game_info, rman : *render_manager)
{
  add_trn_chunk_to_draw(g, rman, &g.trn.trn.chunks[0])
}
clear_objects_to_draw::fn(g : *game_info, rman : *render_manager)
{
  rman.cur_draws = 0
}
draw_depth_buffer::fn(g : *game_info, rman : *render_manager, g_ubo : *global_ubo_uniform)
{
  glBindFramebuffer(GL_FRAMEBUFFER, g.depth_fbo.fbo.id);
  glViewport(0, 0, cast(s32)g.wnd_width, cast(s32)g.wnd_height)
  glEnable(GL_DEPTH_TEST);
  glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE); // disable color writes
  glClearDepth(1.0f);          // depth clear value (1.0 = far)
  glClear(GL_DEPTH_BUFFER_BIT);
  draw_objects(g, &g.rman, g_ubo, true)
  glBindFramebuffer(GL_FRAMEBUFFER, 0);
}
draw_offscreen_buffer::fn(g : *game_info, rman : *render_manager, g_ubo : *global_ubo_uniform)
{
  glBindFramebuffer(GL_FRAMEBUFFER, g.offscreen_fbo.fbo.id);
  glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
  glViewport(0, 0, cast(s32)g.wnd_width, cast(s32)g.wnd_height)
  glEnable(GL_DEPTH_TEST);
  glClearColor(0.5f, 0.2f, 0.4f, 1.0f); // background color
  glClearDepth(1.0f);

  glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
  draw_objects(g, &g.rman, g_ubo, false)
  glBindFramebuffer(GL_FRAMEBUFFER, 0);
}
draw_toscreen_buffer::fn(g : *game_info, rman : *render_manager)
{
  to_screen_shader := g.to_screen_shader.offscreen_shader.id
  glViewport(0, 0, cast(s32)g.wnd_width, cast(s32)g.wnd_height)
  //printf("to screen prog {to_screen_shader}\n")
  glUseProgram(to_screen_shader)

  glActiveTexture(GL_TEXTURE0);
  glBindTexture(GL_TEXTURE_2D, g.offscreen_fbo.color_tex.id);

  glActiveTexture(GL_TEXTURE0 + 1);
  glBindTexture(GL_TEXTURE_2D, g.depth_fbo.color_tex.id);

  glActiveTexture(GL_TEXTURE0 + 2);
  glBindTexture(GL_TEXTURE_2D, g.offscreen_fbo.normal_tex.id);

  // set sampler uniform
  glUniform1i(glGetUniformLocation(to_screen_shader, "uScene"), 0);
  glUniform1i(glGetUniformLocation(to_screen_shader, "uDepth"), 1);
  glUniform1i(glGetUniformLocation(to_screen_shader, "uNormal"), 2);
  glDisable(GL_DEPTH_TEST);
  glDisable(GL_CULL_FACE);

  loc := glGetUniformLocation(to_screen_shader, "uNear");
  glUniform1f(loc, g.near_plane);
  loc = glGetUniformLocation(to_screen_shader, "uFar");
  glUniform1f(loc, g.far_plane);

  loc = glGetUniformLocation(to_screen_shader, "sun_color");
  glUniform4f(loc, rman.sun_color.x, rman.sun_color.y, rman.sun_color.z, rman.sun_color.w);
  loc = glGetUniformLocation(to_screen_shader, "sun_dir");
  glUniform4f(loc, rman.sun_dir.x, rman.sun_dir.y, rman.sun_dir.z, rman.sun_dir.w);


  glBindVertexArray(g.empty_vao);
  // draw fullscreen triangle with vertex IDs
  glDrawArrays(GL_TRIANGLES, 0, 3);
  glEnable(GL_CULL_FACE);

}
render::fn(g : *game_info, rman : *render_manager)
{
  aspect := cast(f32)g.wnd_height / cast(f32)g.wnd_width
  g_ubo:global_ubo_uniform=?

  identity(&g_ubo.view)
  identity(&g_ubo.proj)
  perspective(cast(*f32)&g_ubo.proj, 40.0f * (3.14159f / 180.0f), aspect, g.near_plane, g.far_plane)
  
  quat_to_mat4(&g_ubo.view, g.cam_rot)

  draw_depth_buffer(g, rman, &g_ubo)

  draw_offscreen_buffer(g, rman, &g_ubo)

  draw_toscreen_buffer(g, rman)
}
swap_buffers::fn(g : *game_info)
{
  glfwSwapBuffers(g.wnd)
}
clear_background_color::fn(gptr : *game_info, r : f32, g : f32, b : f32, a : f32)
{
  glClearColor(r, g, b, a)
  glClear(GL_COLOR_BUFFER_BIT)
}
player_mov::fn(g : *game_info, player : *entity, dt_ : f32)
{
  dt:= cast(f64)dt_
  speed := 5.0

  cam_right := cast(vector)cross_vec(g.up, player.forward)
  if is_key_held(&g.iman, key_enum.A)
  {
    g.cam_pos.x -= dt * speed
  }
  if is_key_held(&g.iman, key_enum.D)
  {
    g.cam_pos.x += dt * speed
  }
  if is_key_held(&g.iman, key_enum.W)
  {
    g.cam_pos += cast(vector)player.forward * dt


  }
  if is_key_held(&g.iman, key_enum.S)
  {
    g.cam_pos -= cast(vector)player.forward * dt
  }
}

end_frame::fn(g:*game_info)
{
  g.mouse_last_x = 0.0
  g.mouse_last_y = 0.0
  g.mouse_vel_x = 0.0
  g.mouse_vel_y = 0.0
}
run_game::fn(g : *game_info)
{
  prev_time : f64=glfwGetTime()
  while true
  {
    dt := cast(f32)(glfwGetTime() - prev_time)

    prev_time = glfwGetTime()

    glfwPollEvents()

    update_cam_rot(g, g.mouse_vel_x * 0.01 * g.mouse_sense_x, g.mouse_vel_y * 0.01 * g.mouse_sense_y)

    player_mov(g, g.player, dt)


    print_vec(g.cam_rot)

    add_objects_to_draw(g , &g.rman)
    render(g, &g.rman)
    clear_objects_to_draw(g , &g.rman)

    swap_buffers(g)

    end_frame(g)

    io_globals.linear_cur = 0
  }
}

main::fn()
{
  game : game_info

  init_game(&game)

  run_game(&game)
}
