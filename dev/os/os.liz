PrintStr::fn outsider(str_lit);
ReadEntireFileBuffer::fn outsider(name : str_lit, buffer : *void, bsz : u32);
GetFileSize::fn outsider(name : str_lit, file_sz : *u64)!s32;
lock_cmpxchg::fn intrinsic(obj : *u64, expected : u64, desired:u64) ! u64;
lock_xchg::fn intrinsic(ptr : *u64, val : u64) ! u64;

float_to_str::fn outsider(f : f32, buffer : *u8, sz : u32) ! u32;


file:struct
{
  name : str_lit
  data : *u8
  sz : u64
  add_name : bool
}



#if OS == LINUX
{
  import "../linux"
  FUTEX_WAIT:const s32= 0;
  FUTEX_WAKE:const s32= 1;
  futex::fn syscall 202(addr : *u64, op : s32, val : u32, timespec : *void, uaddr2 : *u32, val3 : u32);
  create_thread::fn(f : fn(*void), arg : *void)!u32
  {
    id : u32
    ret := pthread_create(&id, f, nil, arg)

    return id
  }
  unlock_mutex::fn(m : *mutex_info) ! u32
  {
    old := lock_xchg(&m.val, 0)
    if old == 2
      futex(&m.val, FUTEX_WAKE, 1, nil, nil, 0)
    return 0
  }
  lock_mutex::fn(m : *mutex_info) ! u32
  {
    prev := lock_cmpxchg(&m.val, 0, 1)

    if prev == 0 return 0

    while lock_xchg(&m.val, 2) != 0
    {
      futex(&m.val, FUTEX_WAIT, 2, nil, nil, 0)
    }

    return 0
  }
  create_mutex::fn()!mutex_info
  {
    ret : mutex_info
    return ret
  }
  read_file::fn(file_name : str_lit, out : *file, alloc : *generic_allocator)
  {
    sz :u64
    ret := GetFileSize(file_name, &sz)
    sz += 1

    if ret == -1 {
      PrintStr("file not found\n")
      __dbg_break
      __dbg_break
      __dbg_break
    }

    if sz == 0 {
      printf("file is empty {file_name}\n")
      __dbg_break
      __dbg_break
      __dbg_break
    }


    out.data = cast(*u8)get_buffer_from_generic_alloc(alloc, sz)

    ReadEntireFileBuffer(file_name, out.data, cast(u32)sz)
    if out.add_name
      out.name = new_str_lit(alloc, file_name);
    out.sz = sz
  }
  get_cwd::fn(alloc_type : u32 = 0, alloc : *void = nil) ! string
  {
    ret:string
    buffer : [1024]u8
    len := getcwd(buffer, 1024)

    *ptr_offset(buffer, len, u8) = 0;

    build_string(cast(str_lit)buffer, &ret, nil)

    return ret;
  }

}
