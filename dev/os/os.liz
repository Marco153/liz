rel_string : struct
{
	offset : u32,
	count : u32,
}
operator ==(self: *rel_string, str : *rel_string) !bool
{
	ln := str.count
	if ln != self.count
		return false

	start := cast(*u8)(cast(u64)self + self.offset)
	start2 := cast(*u8)(cast(u64)str + str.offset)

	for i in 0..cast(s64)ln
	{
		lhs := ptr_offset(start, i, u8);
		rhs := ptr_offset(start2, i, u8);
		if *lhs != *rhs
			return false
	}

	return true
}
operator ==(self: *rel_string, str : str_lit) !bool
{
	ln := str_ln(str)
	if ln != self.count
		return false

	start := cast(*u8)(cast(u64)self + self.offset)

	for i in 0..cast(s64)ln
	{
		lhs := ptr_offset(start, i, u8);
		rhs := ptr_offset(str, i, u8);
		if *lhs != *rhs
		{
			return false
		}
	}

	return true
}
type_data:struct
{
	using u::union
	{
		// entries is how many members a strct has
		entries : u32,
		strct : *type_data,
	},
	strct_sz : u64,
	offset : u64,
	ptr : u8,
	ser_func : *void,
	tp : type_enum,
	flags : u32,
	name : rel_string,
	decl_offset_for_ptr_len : u32,

}
var_arg:struct
{
	type : type_enum,
	type_info : *type_data,
	ptr : u8,
	val : *void,
}

num_2_str::fn(num : s64, in_buf : *u8, buffer_sz : u32) ! u64
{
	i :u64= 0;
	written :u64= 0;
	aux_buffer : [64]u8;

	out_buffer :*char= cast(*char)in_buf;

	buffer := cast(*char)aux_buffer;

	if num == 0
	{
		*ptr_offset(out_buffer, 0, u8) = '0;
		return 1;
	}
	negative: = false;
	if num < 0
	{
		negative = true;
		num = num * -1;
	}


	while num != 0
	{
		mod := num % 10;
		*ptr_offset(buffer, written, char) = cast(char)(cast(u8)'0 + cast(u8)mod);
		num = num / 10;
		written += 1;
	}

	aux_written_rev := cast(s64)written - 1;
	aux_written :u64= 0;
	if negative
	{
		*ptr_offset(out_buffer, aux_written, char) = '-;
		aux_written++;
		written++;
	}
	while  aux_written_rev >= 0
	{

		dst :=ptr_offset(out_buffer, aux_written, char)
		*dst = *ptr_offset(buffer, cast(u64)aux_written_rev, char);
		aux_written_rev--;
		aux_written++;
	}
	return written;
}
print_vec2::fn(v : _vec2)
{
	printf("x {cast(f32)v.x}, y {cast(f32)v.y}, z {cast(f32)v.z}, w {cast(f32)v.w}\n")
	//printf("ang %, dt %\n", cast(s32)(ang * 100.0), cast(s32)(dt * 100.0))
}
print_vec::fn(v : _vec)
{
	printf("x {v.x}, y {v.y}, z {v.z}, w {v.w}\n")
	//printf("ang %, dt %\n", cast(s32)(ang * 100.0), cast(s32)(dt * 100.0))
}
sprintf_base::fn(buffer : *u8, bsz : u32, format : str_lit, __var_args : *rel_array(var_arg)) !u64
{

	format_ln: = str_ln(format);
	format_idx:u64 = 0;
	buffer_idx:u64 = 0;
	arg_idx:u64 = 0;
	aux_num_buffer: [64] u8;

	while format_idx < format_ln
	{
		if* ptr_offset(format, format_idx, char) == '%
		{
			cur_arg: = (*__var_args)[arg_idx];
			if* ptr_offset(format, format_idx + 1, char) == '*
			{
				if* ptr_offset(format, format_idx + 2, char) == 's
				{
					len: = cast(u32)cast(u64)cur_arg.val;

					arg_idx++;

					cur_arg = (*__var_args)[arg_idx];

					str_ptr: = cast(*u8)cur_arg.val

					dst : = ptr_offset(buffer, buffer_idx, u8);
					memcpy(dst, cast(*u8)str_ptr, len);
					buffer_idx += len
					//format_idx++;
					format_idx += 2;

				}
				else
					__dbg_break;
			}
			else if cur_arg.type == type_enum.TYPE_STRUCT
			{
				if cur_arg.type_info.name == "rel_string"
				{
					addr := cast(*u8)cur_arg.val

					offset := *cast(*u32)addr
					len := *cast(*u32)ptr_offset(addr, 1, u32)
					
					actual_str := ptr_offset(addr, offset, u8)

					dst : = ptr_offset(buffer, buffer_idx, u8);
					memcpy(dst, cast(*u8)actual_str, len);
					buffer_idx += len
				}
        /*
				else if cur_arg.type_info.name == "string"
				{
					addr := cast(*u8)cur_arg.val

					str := cast(*string)addr;

					len := str.data.count
					
					actual_str := str.data.data

					dst : = ptr_offset(buffer, buffer_idx, u8);
					memcpy(dst, cast(*u8)actual_str, len);
					buffer_idx += len
				}
        */
			}
			else if cur_arg.type == type_enum.TYPE_STR_LIT
			{
				arg_str_ln: = str_ln(cast(str_lit)cur_arg.val);
				dst: = ptr_offset(buffer, buffer_idx, u8);
				ASSERT((buffer_idx + arg_str_ln) < bsz);
				memcpy(dst, cast(*u8)cur_arg.val, arg_str_ln);
				buffer_idx += arg_str_ln;
			}
			else if cur_arg.type == type_enum.TYPE_BOOL

			{
				true_str := "true"
				false_str := "false"
				ln :u64=0
				correct_str :str_lit
				
				val :=cast(u8)cast(u64)cur_arg.val
				if val == 0
				{
					correct_str = false_str
				}
				else if val == 1
				{
					correct_str = true_str
				}
				else
				{
					__dbg_break
				}
				ln = str_ln(correct_str)

				memcpy(ptr_offset(buffer, buffer_idx, u8), correct_str, ln);
				buffer_idx += ln;


			}
			else if cur_arg.type == type_enum.TYPE_F32
			{
				f := *cast(*f32)&cur_arg.val
        len := float_to_str(f, ptr_offset(buffer, buffer_idx, u8), 32)
				buffer_idx += len
			}
			else if cur_arg.type == type_enum.TYPE_U32 || cur_arg.type == type_enum.TYPE_S32 ||
					cur_arg.type == type_enum.TYPE_U8 || cur_arg.type == type_enum.TYPE_S8 ||
					cur_arg.type == type_enum.TYPE_U16 || cur_arg.type == type_enum.TYPE_S16 ||
					cur_arg.type == type_enum.TYPE_U64 || cur_arg.type == type_enum.TYPE_S64 ||
					cur_arg.type == type_enum.TYPE_INT

			{

				//if cast(s64)cur_arg.val == 32
					//__dbg_break
				num_ln: = num_2_str(cast(s64)cur_arg.val, aux_num_buffer, 32);

				memcpy(ptr_offset(buffer, buffer_idx, u8), aux_num_buffer, num_ln);
				buffer_idx += num_ln;


			}
			else
			{
				// type not handled
			}
			arg_idx++;
		}
		else
		{
			ASSERT((buffer_idx + 1) < bsz);
			*ptr_offset(buffer, buffer_idx, u8) = *ptr_offset(format, format_idx, u8);
			buffer_idx++;
		}
		format_idx++;
	}
	ASSERT(buffer_idx < bsz);
	*ptr_offset(buffer, buffer_idx, u8) = 0;
	tast: = 0;
	return buffer_idx;
}
get_linear_ptr::fn(sz : u32) ! *u8
{

  lock_mutex(&io_globals.linear_alloc_mutex)
	ret: = ptr_offset(io_globals.linear_data, io_globals.linear_cur, u8)
  io_globals.linear_cur += sz
  unlock_mutex(&io_globals.linear_alloc_mutex)

  ASSERT(io_globals.linear_cur < io_globals.linear_max)
  return ret
}
sprintf_temp::fn(format : str_lit, ...) !str_lit
{
	buffer: [1024 * 4] char;

	sz: = sprintf_base(buffer, buffer.len, format, &__var_args);
	ret: = get_linear_ptr(cast(u32)sz + 1)
  

	memcpy(ret, buffer, cast(u32)sz + 1);
  *ptr_offset(ret, sz, u8) = 0

	return cast(str_lit)ret;
}
snprintf::fn(buffer : *u8, bsz : u32, format : str_lit, ...)
{
	sprintf_base(buffer, bsz, format, &__var_args);
}
printf::fn(format : str_lit, ...)
{
	prev_sz := io_globals.linear_cur

	buffer : [1024 * 4]u8;
	sprintf_base(buffer, buffer.len, format, &__var_args);
	PrintStr(cast(str_lit)buffer);

	io_globals.linear_cur = prev_sz 
}
