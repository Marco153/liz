render_manager:struct
{
  draws : *draw_info
  cur_draws : u32

  sun_color : _vec
  sun_dir   : _vec
}
shader_type_gl : enum
{
	VERTEX   = 0x8B31, // GL_VERTEX_SHADER
	FRAGMENT = 0x8B30, // GL_FRAGMENT_SHADER
	COMPUTE  = 0x91B9, // GL_COMPUTE_SHADER
}
shader_type : enum
{
	VERTEX,
	FRAGMENT,
	COMPUTE,
}
shader_error : enum
{
	OK = 0,
	CREATE_FAILED,
	COMPILE_FAILED,
	LINK_FAILED,
	LOG_TOO_SMALL,
}
shader : struct
{
	id   : u32,
	type : shader_type,
}
get_shader_log :: fn(sh : u32,
	out_buf : *u8,
	buf_sz : u32
) ! u32
{
	log_len : s32 = 0;
	glGetShaderiv(sh, GL_INFO_LOG_LENGTH, &log_len);

	if log_len <= 0
	{
		return 0;
	}

	if cast(u32)log_len > buf_sz
	{
    __dbg_break
		return -1;
	}

	glGetShaderInfoLog(sh,
		log_len,
		nil,
		cast(*char)out_buf);

	return cast(u32)log_len;
}
get_program_log :: fn(prog : u32,
	out_buf : *u8,
	buf_sz : u32
) ! u32
{
	log_len : s32 = 0;
	glGetProgramiv(prog, GL_INFO_LOG_LENGTH, &log_len);

	if log_len <= 0
	{
		return 0;
	}

	if cast(u32)log_len > buf_sz
	{
		return cast(u32)shader_error.LOG_TOO_SMALL;
	}

	glGetProgramInfoLog(prog,
		log_len,
		nil,
		cast(*char)out_buf);

	return cast(u32)log_len;
}
link_program :: fn(shaders    : **shader,
	shader_cnt : u32,
	out_prog   : *u32,
	log_buf    : *u8,
	log_sz     : u32
) ! shader_error
{
	prog : u32 = glCreateProgram();
	if prog == 0
	{
		return shader_error.CREATE_FAILED;
	}

	i : u32 = 0;
	while i < shader_cnt
	{
		glAttachShader(prog, ptr_offset(shaders, i, *shader).id);
		i += 1;
	}

	glLinkProgram(prog);

	status : s32 = 0;
	glGetProgramiv(prog, GL_LINK_STATUS, &status);

	if status == GL_FALSE
	{
		get_program_log(prog, log_buf, log_sz);
		glDeleteProgram(prog);
		return shader_error.LINK_FAILED;
	}

/*
	// optional: detach after successful link
	i = 0;
	while i < shader_cnt
	{
		glDetachShader(prog, ptr_offset(shaders, i, shader).id);
		i += 1;
	}
  */

	*out_prog = prog;
	return shader_error.OK;
}
compile_shader_complete :: fn(vs : *u8, vs_len : u32, fs : *u8, fs_len :u32) ! u32
{
  log : [1024 * 4]u8
  vs_sh : shader
  fs_sh : shader
  shaders :[2]*shader
  shaders[0] = &vs_sh
  shaders[1] = &fs_sh

  res := compile_shader(vs, vs_len, shader_type.VERTEX, &vs_sh, log, log.len)
  if res != shader_error.OK
  {
    printf("shader vs error \n")
    printf("log: {cast(str_lit)log} \n")
    __dbg_break;
    __dbg_break;
    __dbg_break;
  }

  res = compile_shader(fs, fs_len, shader_type.FRAGMENT, &fs_sh, log, log.len)
  if res != shader_error.OK
  {
    printf("shader fs error \n")
    printf("log: {cast(str_lit)log} \n")
    __dbg_break;
  }

  prog : u32

  res = link_program(cast(**shader)&shaders,
    2,
    &prog,
    log, 
    512)

  if res != shader_error.OK
  {
    printf("shader linx error\n")
    printf("log: {cast(str_lit)log} \n")
  }

  return prog
}
compile_shader :: fn(src : *u8,
	src_len  : u32,
	typ      : shader_type,
	out_sh   : *shader,
	log_buf  : *u8,
	log_sz   : u32
) ! shader_error
{
  ASSERT(src_len != 0)
  gl_sh_type:shader_type_gl

  on typ
  {
  shader_type.VERTEX
  {
    gl_sh_type = shader_type_gl.VERTEX
  }
  shader_type.FRAGMENT
  {
    gl_sh_type = shader_type_gl.FRAGMENT
  }
  }

	sh : u32 = glCreateShader(cast(u32)gl_sh_type);
	if sh == 0
	{
		return shader_error.CREATE_FAILED;
	}

	src_ptr : *char = cast(*char)src;
	len     : s32   = cast(s32)src_len;

	glShaderSource(sh, 1, &src_ptr, &len);
	glCompileShader(sh);

	status : s32 = 0;
	glGetShaderiv(sh, GL_COMPILE_STATUS, &status);

	if status == GL_FALSE
	{
    __dbg_break
    __dbg_break
    __dbg_break
		get_shader_log(sh, log_buf, log_sz);
		glDeleteShader(sh);
		return shader_error.COMPILE_FAILED;
	}

	out_sh.id   = sh;
	out_sh.type = typ;
	return shader_error.OK;
}

storage_buffer:struct
{
#if RENDER_API == OPENGL
{
  id : u32
}
}
uniform_buffer:struct
{
#if RENDER_API == OPENGL
{
  id : u32
}
}

create_uniform_buffer::fn(size : u32)!uniform_buffer
{
#if RENDER_API == OPENGL
{
  ret : uniform_buffer
  glGenBuffers(1, &ret.id);                  // generate buffer
  glBindBuffer(GL_UNIFORM_BUFFER, ret.id);
  glBufferData(GL_UNIFORM_BUFFER, size, nil, GL_DYNAMIC_DRAW); // no data yet
  glBindBuffer(GL_UNIFORM_BUFFER, 0);

  return ret
}
}
create_fbo_args : struct
{
    fbo              : *u32;
    color_texture    : *u32;
    normal_texture   : *u32;

    width            : s32;
    height           : s32;

    internal_format  : s32;
    format           : s32;
    type             : s32;
    attachment_type  : s32;
}
create_framebuffer::fn(args : *create_fbo_args) ! void
{
#if RENDER_API == OPENGL
{
    Buffer   : u32;
    offDepth : u32;

    // Create and bind framebuffer
    glGenFramebuffers(1, args.fbo);
    glBindFramebuffer(GL_FRAMEBUFFER, *args.fbo);

    // Create color texture
    glGenTextures(1, args.color_texture);
    glBindTexture(GL_TEXTURE_2D, *args.color_texture);

    glTexImage2D(GL_TEXTURE_2D,
        0,
        args.internal_format,
        args.width,
        args.height,
        0,
        cast(u32)args.format,
        cast(u32)args.type,
        nil);

    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);

    // Attach color texture
    glFramebufferTexture2D(GL_FRAMEBUFFER,
        cast(u32)args.attachment_type,
        GL_TEXTURE_2D,
        *args.color_texture,
        0);

    // Depth / MRT handling
    glGenRenderbuffers(1, &Buffer);

    if args.attachment_type == GL_DEPTH_ATTACHMENT
    {
        glDrawBuffer(GL_NONE);
        glReadBuffer(GL_NONE);
    }
    else
    {
        // Depth texture
        glGenTextures(1, &offDepth);
        glBindTexture(GL_TEXTURE_2D, offDepth);

        glTexImage2D(GL_TEXTURE_2D,
            0,
            GL_DEPTH_COMPONENT24,
            args.width,
            args.height,
            0,
            GL_DEPTH_COMPONENT,
            GL_FLOAT,
            nil);

        glFramebufferTexture2D(GL_FRAMEBUFFER,
            GL_DEPTH_ATTACHMENT,
            GL_TEXTURE_2D,
            offDepth,
            0);

        // Normal buffer
        glGenTextures(1, args.normal_texture);
        glBindTexture(GL_TEXTURE_2D, *args.normal_texture);

        glTexImage2D(GL_TEXTURE_2D,
            0,
            GL_RGBA16F,
            args.width,
            args.height,
            0,
            GL_RGBA,
            GL_FLOAT,
            nil);

        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);

        glFramebufferTexture2D(GL_FRAMEBUFFER,
            GL_COLOR_ATTACHMENT1,
            GL_TEXTURE_2D,
            *args.normal_texture,
            0);

        bufs : [2]s32
        bufs[0]  = GL_COLOR_ATTACHMENT0
        bufs[1]  = GL_COLOR_ATTACHMENT1
        glDrawBuffers(2, &bufs);
    }

    // Check framebuffer completeness
    fbo_status : s32 = glCheckFramebufferStatus(GL_FRAMEBUFFER);
    if fbo_status != GL_FRAMEBUFFER_COMPLETE
    {
        printf("Error: Framebuffer is not complete!\n");
        ASSERT(false);
    }

    // Unbind framebuffer
    glBindFramebuffer(GL_FRAMEBUFFER, 0);
}
}
create_framebuffers::fn(depth_fbo : *u32, offscreen_fbo: *u32, depth_tex : *u32, normal_tex : *u32, color_tex : *u32, width : s32, height : s32 ) ! void
{
  depth_fbo_args : create_fbo_args;

  depth_fbo_args.fbo             = depth_fbo;
  depth_fbo_args.color_texture   = depth_tex;
  depth_fbo_args.normal_texture  = nil;

  depth_fbo_args.width           = width;
  depth_fbo_args.height          = height;

  depth_fbo_args.internal_format = GL_DEPTH_COMPONENT24;
  depth_fbo_args.format          = GL_DEPTH_COMPONENT;
  depth_fbo_args.type            = GL_FLOAT;
  depth_fbo_args.attachment_type = GL_DEPTH_ATTACHMENT;

  create_framebuffer(&depth_fbo_args);

  offscreen_fbo_args : create_fbo_args;

  offscreen_fbo_args.fbo             = offscreen_fbo;
  offscreen_fbo_args.color_texture   = color_tex;
  offscreen_fbo_args.normal_texture  = normal_tex;

  offscreen_fbo_args.width           = width;
  offscreen_fbo_args.height          = height;

  offscreen_fbo_args.internal_format = GL_RGBA8;
  offscreen_fbo_args.format          = GL_RGBA;
  offscreen_fbo_args.type            = GL_UNSIGNED_BYTE;
  offscreen_fbo_args.attachment_type = GL_COLOR_ATTACHMENT0;

  create_framebuffer(&offscreen_fbo_args);

  printf("frame buffers generated\n")
}
create_storage_buffer::fn(size : u32)!storage_buffer
{
#if RENDER_API == OPENGL
{
  ret : storage_buffer
  glGenBuffers(1, &ret.id);                  // generate buffer
  glBindBuffer(GL_SHADER_STORAGE_BUFFER, ret.id);
  glBufferData(GL_SHADER_STORAGE_BUFFER, size, nil, GL_DYNAMIC_DRAW); // no data yet
  glBindBuffer(GL_SHADER_STORAGE_BUFFER, 0);

  return ret
}
}
update_storage_buffer::fn(storage : *storage_buffer, data : *void, data_size:s64)
{
#if RENDER_API == OPENGL
{
  glBindBuffer(GL_SHADER_STORAGE_BUFFER, storage.id);
  ptr := glMapBufferRange(GL_SHADER_STORAGE_BUFFER,
      0,
      data_size,
      GL_MAP_WRITE_BIT |
      GL_MAP_INVALIDATE_BUFFER_BIT |
      GL_MAP_UNSYNCHRONIZED_BIT);
  memcpy(ptr, data, cast(u64)data_size);
  glUnmapBuffer(GL_SHADER_STORAGE_BUFFER);
  glBindBuffer(GL_SHADER_STORAGE_BUFFER, 0);
}
}
enable_shader_uniform::fn(name          : str_lit,
    binding       : s32,
    shaderProgram : u32,
    ubo           : *uniform_buffer
)
{
    uniformBlockUBO : u32 =
        glGetUniformBlockIndex(shaderProgram, name);

    if glGetError() == GL_INVALID_INDEX
    {
        // keeping semantics; replace with your own logging if needed
        __dbg_break
        __dbg_break
        __dbg_break
    }

    glUniformBlockBinding(shaderProgram,
        uniformBlockUBO,
        cast(u32)binding);

    glBindBufferBase(GL_UNIFORM_BUFFER,
        cast(u32)binding,
        ubo.id);
}
enable_shader_uniforms::fn(mat : *material_info, global_ubo : *uniform_buffer)
{
    enable_shader_uniform("ubo",
        0,
        mat.shader_id,
        global_ubo);

    enable_shader_uniform("_model",
        1,
        mat.shader_id,
        &mat.model_uniform);
}
