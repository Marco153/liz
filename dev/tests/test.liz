  raycast_info :struct
  {
    ray_origin : _vec,
      ray_dir : _vec,
      v0 : _vec,
      v1 : _vec,
      v2 : _vec,
      t_out : f32,
      u_out : f32,
      v_out : f32
  }
  ray_triangle_intersect :: fn x64(rinfo : *raycast_info) ! bool
  {
    ray_origin := rinfo.ray_origin
      ray_dir := rinfo.ray_dir
      v0 := rinfo.v0
      v1 := rinfo.v1
      v2 := rinfo.v2

      epsilon : f32 = 0.000001f;
      
      edge1 := v1 - v0
      edge1.w = 0.0f;

      edge2 := v2 - v0
      edge2.w = 0.0f;
      h : _vec = ?;
      s : _vec = ?;
      q : _vec = ?;

      
      // Calculate triangle edges
      

      // Cross product: h = ray_dir × edge2
      h = cross_vec(&ray_dir, &edge2);
      
      // Determinant: a = edge1 • h
      a : f32 = dot_vec(&edge1, &h);
      
      // Check if ray is parallel to triangle
      if (a > -epsilon && a < epsilon) {
          return false;
      }
      
    //__dbg_break
      f : f32 = 1.0f / a;
      s = ray_origin - v0;
      s.w = 0.0f;
      
      // Barycentric u coordinate
      u : f32 = f * dot_vec(&s, &h);
      if (u < 0.0f || u > 1.0f) {
          return false;
      }
    //__dbg_break
      
      // Cross product: q = s × edge1
      q = cross_vec(&s, &edge1);
      
      // Barycentric v coordinate
      v : f32 = f * dot_vec(&ray_dir, &q);
      if (v < 0.0f || u + v > 1.0f) {
          return false;
      }
      
      // Calculate t parameter (distance along ray)
      t : f32 = f * dot_vec(&edge2, &q);
      
      // Only accept intersections in front of ray
      if (t > epsilon) {
          rinfo.t_out = t;
          rinfo.u_out = u;
          rinfo.v_out = v;
          return true;
      }
      
      return false;
  }
  f32_approximate ::fn macro(f : _expr, val : _expr)
  {
    (f >= (val - 0.1f) && f <= (val + 0.1f))
  }
  ray_triangle_intersect_x64_test :: fn x64(rinfo : *raycast_info) ! u8
  {
    ray_origin := rinfo.ray_origin
      ray_dir := rinfo.ray_dir
      v0 := rinfo.v0
      v1 := rinfo.v1
      v2 := rinfo.v2
      t_out := rinfo.t_out
      u_out := rinfo.u_out
      v_out := rinfo.v_out

      epsilon : f32 = 0.000001f;
      
      edge1 := v1 - v0
      edge1.w = 0.0f;

      edge2 := v2 - v0
      edge2.w = 0.0f;
    if f32_approximate(edge1.x, 1.0f) == false || 
      f32_approximate(edge2.x, 1.0f) == false || 
      f32_approximate(edge2.z, -1.0f) == false

    {
      return 0
    }

      h : _vec = ?;
      s : _vec = ?;
      q : _vec = ?;

      
      // Calculate triangle edges
      

      // Cross product: h = ray_dir × edge2
      h = cross_vec(&ray_dir, &edge2);
    if f32_approximate(h.x, 1.0f) == false || 
      f32_approximate(h.z, 1.0f) == false

    {
      return 1
    }
      
      // Determinant: a = edge1 • h
      a : f32 = dot_vec(&edge1, &h);
    if f32_approximate(a, 1.0f) == false
    {
      return 2
    }
      
      // Check if ray is parallel to triangle
      if (a > -epsilon && a < epsilon) {
          return 3;
      }
      
    //__dbg_break
      f : f32 = 1.0f / a;
      s = ray_origin - v0;
      s.w = 0.0f;
      
    if f32_approximate(f, 1.0f) == false
    {
      return 4
    }
    if f32_approximate(s.x, 0.5f) == false || 
      f32_approximate(s.y, 1.0f) == false || 
      f32_approximate(s.z, -0.5f) == false
    {
      return 5
    }
      
      // Barycentric u coordinate
      u : f32 = f * dot_vec(&s, &h);
    if f32_approximate(u, 0.0f) == false
    {
      return 6
    }
      if (u < 0.0f || u > 1.0f) {
          return 7;
      }
    //__dbg_break
      
      // Cross product: q = s × edge1
      q = cross_vec(&s, &edge1);
    if f32_approximate(q.x, 0.0f) == false || 
      f32_approximate(q.y, -0.5f) == false || 
      f32_approximate(q.z, -1.0f) == false
    {
      return 8
    }
      
      // Barycentric v coordinate
      v : f32 = f * dot_vec(&ray_dir, &q);
    if f32_approximate(v, 0.5f) == false
    {
      return 9
    }
      if (v < 0.0f || u + v > 1.0f) {
          return 10;
      }
      
      // Calculate t parameter (distance along ray)
      t : f32 = f * dot_vec(&edge2, &q);
      
    if f32_approximate(t, 1.0f) == false
    {
      return 11
    }
      // Only accept intersections in front of ray
      if (t > epsilon) {
          //if (t_out != nil) { *t_out = t; }
          //if (u_out != nil) { *u_out = u; }
          //if (v_out != nil) { *v_out = v; }
          return 12;
      }
      
      return 13;
  }
