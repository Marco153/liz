PrintStr::fn outsider(str : str_lit);
GetMem::fn outsider(size : u64) ! *void;
_dot::fn intrinsic(lhs : _vec2, rhs : _vec2) ! f64;
//GetTypeData::fn internal(void *) !*type_data;
ptr_offset::fn macro(ptr : _expr, offset : _expr, type : _expr)
{
	(cast(*type)(cast(s64)ptr + cast(s64)offset * sizeof(type)))
}
_own_memset::fn x64(dst : *void, val : u8, sz : u64) !void
{
	//ASSERT(cast(u64)dst > 128);
	i:u64 = 0;
	while i < sz
	{
		*ptr_offset(dst, i, u8) = val;
		i++;
	}
}
memcpy::fn x64(dst : *void, src : *void, sz : u64) !void
{
	//ASSERT(cast(u64)dst > 128 && cast(u64)src > 128) ;
	i:u64 = 0;
	if (sz % 16) == 0
	{
		total := sz / 16

		while i < total
		{
			*ptr_offset(dst, i, _vec) = *ptr_offset(src, i, _vec);
			i++
		}
	}
	else if (sz % 8) == 0
	{
		total := sz / 8

		while i < total
		{
			*ptr_offset(dst, i, u64) = *ptr_offset(src, i, u64);
			i++
		}

	}
	else
	{
		while i < sz
		{
			*ptr_offset(dst, i, u8) = *ptr_offset(src, i, u8);
			i++;
		}
	}
}

