import "../array/"
import "../memory/"
import "../chunk/"
import "../os/"

work_done_info:etruct
{
  DONE_CREATE_TEX(
    x : s32
    z : s32
    mip:u8
    tex_lnk : *linked_chunk
  ),
}
work_to_do_info:etruct
{
  CREATE_TEX(
    x : s32
    z : s32
    mip:u8
  ),
}
aux_tex_struct :struct
{
  data : [(CHUNK_SIZE + 1) * CHUNK_SIZE * HEIGHTMAP_BYTES_PER_PIXEL]char
}
thread_work_info:struct
{
  work_to_do : linked_list_mutex(work_to_do_info)
  work_done  : linked_list_mutex(work_done_info)

  working_data_texs : linked_list_mutex(aux_tex_struct)

}
init_thread_work::fn(t : *thread_work_info, alloc : *generic_allocator)
{
  init_linked_list_mutex(&t.work_to_do, 64, alloc)
  printf("work buffer start {cast(u64)t.work_to_do.buffer_data}\n")
  init_linked_list_mutex(&t.work_done, 64, alloc)

  init_linked_list_mutex(&t.working_data_texs, TEX_GRID_SIZE * TEX_GRID_SIZE + 16, alloc)
  printf("tex buffer start {cast(u64)t.working_data_texs.buffer_data}\n")
}
